module(
    name = "grafluent",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.0.0")

# apple_support must come BEFORE rules_cc for toolchain resolution.
bazel_dep(name = "apple_support", version = "2.2.0", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_swift", version = "3.5.0")
bazel_dep(name = "rules_apple", version = "4.5.1")

# ── Xcode project generation ─────────────────────────────────────────
# Bazel is the build system, but the package still has to be workable in Xcode (debugger,
# test navigator, Instruments for the benchmarks). `just generate` builds a project from the
# Bazel graph, so the two cannot drift.
bazel_dep(name = "rules_xcodeproj", version = "4.0.0")

# ── Swift Package Manager dependencies ───────────────────────────────
# None yet. If Grafluent takes a dependency (see README open question 4, swift-collections),
# follow the laminar pattern: add rules_swift_package_manager, declare the dependency in a
# Bazel-only //swift:Package.swift, and keep it in step with the root Package.swift.
