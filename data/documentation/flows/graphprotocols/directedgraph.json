VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":"]?","kind":"text"}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumVertexCut(from:to:)","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumvertexcut(from:to:)"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/dinicMaximumFlow(from:to:capacity:)":{"title":"dinicMaximumFlow(from:to:capacity:)","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/dinicMaximumFlow(from:to:capacity:)","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A maximum flow by Dinic’s (Dinitz’s) blocking flows with current-arc pointers (JGraphT"},{"type":"text","text":" "},{"code":"DinicMFImpl","type":"codeVoice"},{"type":"text","text":", petgraph "},{"code":"dinics","type":"codeVoice"},{"type":"text","text":", NetworkX "},{"code":"dinitz","type":"codeVoice"},{"type":"text","text":"). O(n² m); O(m √n) on unit networks"},{"type":"text","text":" "},{"type":"text","text":"(one in- or out-arc of capacity 1 per inner vertex), O(m min(√m, n^(2\/3))) with unit"},{"type":"text","text":" "},{"type":"text","text":"capacities. "},{"code":"maximumFlow(from:to:capacity:)","type":"codeVoice"},{"type":"text","text":" (push–relabel) is the default because"},{"type":"text","text":" "},{"type":"text","text":"Dinic’s phases can be many on long networks: on the DIMACS genrmf-long family (8 × 8 × 256)"},{"type":"text","text":" "},{"type":"text","text":"it took 223 ms here against push–relabel’s 5 ms."}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/dinicmaximumflow(from:to:capacity:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dinicMaximumFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":