\/minimumvertexcut(from:to:)","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumVertexCut(from:to:)"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","title":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols":{"role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/flows\/graphprotocols","type":"topic","title":"GraphProtocols","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph":{"url":"\/documentation\/flows\/graphprotocols\/directedgraph","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"abstract":[],"type":"topic","title":"DirectedGraph","kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumCostFlow(supply:capacity:cost:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCostFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"supply","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cost","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows15MinimumCostFlowV","text":"MinimumCostFlow","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostflow(supply:capacity:cost:)","title":"minimumCostFlow(supply:capacity:cost:)","abstract":[{"type":"text","text":"A least-cost flow meeting every supply (positive: the vertex sends that much more than it"},{"type":"text","text":" "},{"type":"text","text":"receives; negative: a demand), within capacities (LEMON "},{"type":"codeVoice","code":"NetworkSimplex"},{"type":"text","text":", OR-Tools"},{"type":"text","text":" "},{"type":"codeVoice","code":"SimpleMinCostFlow"},{"type":"text","text":", NetworkX "},{"type":"codeVoice","code":"min_cost_flow"},{"type":"text","text":" with the opposite sign), or nil when there is"},{"type":"text","text":" "},{"type":"text","text":"none: the supplies do not sum to zero, or some set of vertices supplies more than its"},{"type":"text","text":" "},{"type":"text","text":"out-edges carry. Costs may be negative; negative cycles are saturated (capacities are"},{"type":"text","text":" "},{"type":"text","text":"finite). A self-loop carries its capacity when its cost is negative and nothing otherwise."},{"type":"text","text":" "},{"type":"text","text":"Network simplex with block-search pivots and strongly feasible trees, LEMON’s layout."},{"type":"text","text":" "},{"type":"codeVoice","code":"supply"},{"type":"text","text":" is called once per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, then, for each edge in position"},{"type":"text","text":" "},{"type":"text","text":"order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":", before any work. Which optimum is returned when several"},{"type":"text","text":" "},{"type":"text","text":"exist is unspecified, but the same input always gives the same result."}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCostFlow(supply:capacity:cost:)","type":"topic"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumCostMaximumFlow(from:to:capacity:cost:)":{"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCostMaximumFlow(from:to:capacity:cost:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCostMaximumFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cost"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"MinimumCostFlow","preciseIdentifier":"s:5Flows15MinimumCostFlowV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The least-cost flow among the maximum flows from "},{"code":"source","type":"codeVoice"},{"type":"text","text":" to "},{"code":"sink","type":"codeVoice"},{"type":"text","text":", circulations"},{"type":"text","text":" "},{"type":"text","text":"included (NetworkX "},{"code":"max_flow_min_cost","type":"codeVoice"},{"type":"text","text":", OR-Tools "},{"code":"SolveMaxFlowWithMinCost","type":"codeVoice"},{"type":"text","text":"): the maximum"},{"type":"text","text":" "},{"type":"text","text":"flow value by push–relabel’s first phase, then "},{"type":"codeVoice","code":"minimumCostFlow"},{"type":"text","text":" with that supply at"},{"type":"text","text":" "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and demand at "},{"type":"codeVoice","code":"sink"},{"type":"text","text":". So a negative cycle away from every source–sink path is"},{"type":"text","text":" "},{"type":"text","text":"still saturated. For each edge in position order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"once each, before any work."}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostmaximumflow(from:to:capacity:cost:)","title":"minimumCostMaximumFlow(from:to:capacity:cost:)"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/dinicMaximumFlow(from:to:capacity:)":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/dinicMaximumFlow(from:to:capacity:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dinicMaximumFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Flows4FlowV","text":"Flow"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"A maximum flow by Dinic’s (Dinitz’s) blocking flows with current-arc pointers (JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"DinicMFImpl"},{"type":"text","text":", petgraph "},{"type":"codeVoice","code":"dinics"},{"type":"text","text":", NetworkX "},{"type":"codeVoice","code":"dinitz"},{"type":"text","text":"). O(n² m); O(m √n) on unit networks"},{"type":"text","text":" "},{"type":"text","text":"(one in- or out-arc of capacity 1 per inner vertex), O(m min(√m, n^(2\/3))) with unit"},{"type":"text","text":" "},{"type":"text","text":"capacities. "},{"type":"codeVoice","code":"maximumFlow(from:to:capacity:)"},{"type":"text","text":" (push–relabel) is the default because"},{"type":"text","text":" "},{"type":"text","text":"Dinic’s phases can be many on long networks: on the DIMACS genrmf-long family (8 × 8 × 256)"},{"type":"text","text":" "},{"type":"text","text":"it took 223 ms here against push–relabel’s 5 ms."}],"type":"topic","title":"dinicMaximumFlow(from: