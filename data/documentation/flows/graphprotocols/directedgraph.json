"edge_disjoint_paths"},{"text":" gives their number): as many as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edgeConnectivity(from:to:)"},{"text":", each a simple path, no edge position in two of them.","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are distinct edges; self-loops are never used. A unit maximum flow by Dinic,","type":"text"},{"text":" ","type":"text"},{"text":"decomposed into paths (flow cycles dropped). Which paths are returned is not specified, but","type":"text"},{"text":" ","type":"text"},{"text":"the same input always gives the same paths. O(m min(√m, n^(2\/3))).","type":"text"}],"type":"topic","title":"edgeDisjointPaths(from:to:)","kind":"symbol","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/edgedisjointpaths(from:to:)"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/maximumFlow(from:to:capacity:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Flow","preciseIdentifier":"s:5Flows4FlowV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/maximumflow(from:to:capacity:)","title":"maximumFlow(from:to:capacity:)","abstract":[{"type":"text","text":"A maximum flow from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"sink"},{"type":"text","text":": highest-label push–relabel with the gap and global"},{"type":"text","text":" "},{"text":"relabelling heuristics (Goldberg–Tarjan; Cherkassky–Goldberg), in two phases as LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Preflow"},{"text":" (NetworkX’s default ","type":"text"},{"type":"codeVoice","code":"preflow_push"},{"text":", Boost ","type":"text"},{"type":"codeVoice","code":"push_relabel_max_flow"},{"text":"). O(n² √m).","type":"text"},{"text":" ","type":"text"},{"text":"Which maximum flow is returned is unspecified; ","type":"text"},{"code":"value","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"minimumCut","type":"codeVoice"},{"text":" are not.","type":"text"}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/maximumFlow(from:to:capacity:)","type":"topic"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumCut(capacity:)":{"title":"minimumCut(capacity:)","abstract":[{"text":"A minimum cut over all nonempty proper vertex sets S, by the capacity of the edges leaving","type":"text"},{"text":" ","type":"text"},{"text":"S (igraph ","type":"text"},{"code":"mincut()","type":"codeVoice"},{"text":" on a directed graph): Hao and Orlin’s algorithm (LEMON ","type":"text"},{"code":"HaoOrlin","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"one push–relabel run that moves the sink through every vertex, then the same on the","type":"text"},{"text":" ","type":"text"},{"text":"reversed graph, so both the cuts with the first vertex on the source side and those with it","type":"text"},{"text":" ","type":"text"},{"text":"on the sink side are seen. Which minimum cut is returned when several exist is not","type":"text"},{"text":" ","type":"text"},{"text":"specified, but the same input always gives the same cut. nil below two vertices.","type":"text"},{"text":" ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order, before any work.","type":"text"},{"text":" ","type":"text"},{"text":"O(n²m) in the worst case.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cut","preciseIdentifier":"s:5Flows3CutV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcut(capacity:)","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCut(capacity:)"},"doc://Flows/documentation/Flows/GraphProtocols/Directed