odeVoice","code":"vertices"},{"text":" order, then, for each edge in position","type":"text"},{"text":" ","type":"text"},{"text":"order, ","type":"text"},{"type":"codeVoice","code":"capacity"},{"text":" and then ","type":"text"},{"type":"codeVoice","code":"cost"},{"text":", before any work. Which optimum is returned when several","type":"text"},{"text":" ","type":"text"},{"text":"exist is unspecified, but the same input always gives the same result.","type":"text"}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostflow(supply:capacity:cost:)","type":"topic","role":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumVertexCut()":{"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumvertexcut()","abstract":[{"text":"A minimum vertex cut, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, by Even’s pair order (the first strict minimum","type":"text"},{"text":" ","type":"text"},{"text":"over the pairs, each the canonical cut nearest its target); the vertices after the first","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for a complete digraph; empty when κ = 0."}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumVertexCut()","kind":"symbol","title":"minimumVertexCut()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumVertexCut","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":"]","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","navi