e":"text","text":" "},{"type":"text","text":"finite). A self-loop carries its capacity when its cost is negative and nothing otherwise."},{"type":"text","text":" "},{"type":"text","text":"Network simplex with block-search pivots and strongly feasible trees, LEMON’s layout."},{"type":"text","text":" "},{"type":"codeVoice","code":"supply"},{"type":"text","text":" is called once per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, then, for each edge in position"},{"type":"text","text":" "},{"type":"text","text":"order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":", before any work. Which optimum is returned when several"},{"type":"text","text":" "},{"type":"text","text":"exist is unspecified, but the same input always gives the same result."}]},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"abstract":[],"url":"\/documentation\/flows\/graphprotocols\/directedgraph","role":"symbol","kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","type":"topic"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumVertexCut()":{"kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumVertexCut()","abstract":[{"type":"text","text":"A minimum vertex cut, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, by Even’s pair order (the first strict minimum"},{"type":"text","text":" "},{"type":"text","text":"over the pairs, each the canonical cut nearest its target); the vertices after the first"},{"type":"text","text":" "},{"type":"text","text":"for a comple