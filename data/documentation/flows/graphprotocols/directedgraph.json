"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/edgeDisjointPaths(from:to:)","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/edgedisjointpaths(from:to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeDisjointPaths","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Path","preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">]","kind":"text"}]},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumCut(capacity:)":{"kind":"symbol","abstract":[{"type":"text","text":"A minimum cut over all nonempty proper vertex sets S, by the capacity of the edges leaving"},{"type":"text","text":" "},{"type":"text","text":"S (igraph "},{"type":"codeVoice","code":"mincut()"},{"type":"text","text":" on a directed graph): Hao and Orlin’s algorithm (LEMON "},{"type":"codeVoice","code":"HaoOrlin"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"one push–relabel run that moves the sink through every vertex, then the same on the"},{"type":"text","text":" "},{"type":"text","text":"reversed graph, so both the cuts with the first vertex on the source side and those with it"},{"type":"text","text":" "},{"type":"text","text":"on the sink side are seen. Which minimum cut is returned when several exist is not"},{"type":"text","text":" "},{"type":"text","text":"specified, but the same input always gives the same cut. nil below two vertices."},{"type":"text","text":" "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once per non-loop edge, in position order, before any work."},{"type":"text","text":" "},{"type":"text","text":"O(n²m) in the worst case."}],"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCut(capacity:)","title":"minimumCut(capacity:)","role":"symbol","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcut(capacity:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows3CutV","text":"Cut","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/