 number): as many as"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexConnectivity(from:to:)"},{"type":"text","text":", each a simple path, no vertex but the two ends in two of"},{"type":"text","text":" "},{"type":"text","text":"them. An edge from "},{"code":"source","type":"codeVoice"},{"type":"text","text":" to "},{"code":"target","type":"codeVoice"},{"type":"text","text":" is one such path, whatever its multiplicity (the"},{"type":"text","text":" "},{"type":"text","text":"first in position order, listed last). A unit flow on the split network (each other vertex"},{"type":"text","text":" "},{"type":"text","text":"an arc of capacity 1), decomposed. Which paths are returned is not specified, but the same"},{"type":"text","text":" "},{"type":"text","text":"input always gives the same paths. O(m √n)."}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/vertexdisjointpaths(from:to:)"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/edgeDisjointPaths(from:to:)":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/edgeDisjointPaths(from:to:)","title":"edgeDisjointPaths(from:to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeDisjointPaths","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Path","kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV"},{"text":"<","kind":"text"},{"