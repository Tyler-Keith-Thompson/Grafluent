xt"},{"type":"codeVoice","code":"source"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"sink"},{"text":": highest-label push–relabel with the gap and global","type":"text"},{"text":" ","type":"text"},{"text":"relabelling heuristics (Goldberg–Tarjan; Cherkassky–Goldberg), in two phases as LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Preflow"},{"text":" (NetworkX’s default ","type":"text"},{"type":"codeVoice","code":"preflow_push"},{"text":", Boost ","type":"text"},{"type":"codeVoice","code":"push_relabel_max_flow"},{"text":"). O(n² √m).","type":"text"},{"text":" ","type":"text"},{"text":"Which maximum flow is returned is unspecified; ","type":"text"},{"type":"codeVoice","code":"value"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"minimumCut"},{"text":" are not.","type":"text"}],"role":"symbol","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/maximumflow(from:to:capacity:)","type":"topic"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph":{"abstract":[],"type":"topic","kind":"symbol","title":"DirectedGraph","role":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/edgeConnectivity(from:to:)":{"kind":"symbol","abstract":[{"type":"text","text":"The most edge-disjoint paths from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":", the fewest edges separating them."}],"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/edgeConnectivity(from:to:)","title":"edgeConnect