m:to:capacity:)":{"title":"edmondsKarpMaximumFlow(from:to:capacity:)","abstract":[{"type":"text","text":"A maximum flow by Edmonds–Karp: shortest augmenting paths by breadth-first search,"},{"type":"text","text":" "},{"type":"text","text":"residual arcs in edge-position order, stopping when the sink is discovered (the algorithm"},{"type":"text","text":" "},{"type":"text","text":"of Boost "},{"type":"codeVoice","code":"edmonds_karp_max_flow"},{"text":" and NetworkX ","type":"text"},{"code":"edmonds_karp","type":"codeVoice"},{"text":"). The flow is pinned by that","type":"text"},{"text":" ","type":"text"},{"text":"procedure. O(n m²).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edmondsKarpMaximumFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Flows4FlowV","text":"Flow"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"