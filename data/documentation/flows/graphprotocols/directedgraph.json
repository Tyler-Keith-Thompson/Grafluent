MaximumFlow(from:to:capacity:)","title":"dinicMaximumFlow(from:to:capacity:)","abstract":[{"text":"A maximum flow by Dinic’s (Dinitz’s) blocking flows with current-arc pointers (JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"DinicMFImpl","type":"codeVoice"},{"text":", petgraph ","type":"text"},{"code":"dinics","type":"codeVoice"},{"text":", NetworkX ","type":"text"},{"code":"dinitz","type":"codeVoice"},{"text":"). O(n² m); O(m √n) on unit networks","type":"text"},{"text":" ","type":"text"},{"text":"(one in- or out-arc of capacity 1 per inner vertex), O(m min(√m, n^(2\/3))) with unit","type":"text"},{"text":" ","type":"text"},{"text":"capacities. ","type":"text"},{"code":"maximumFlow(from:to:capacity:)","type":"codeVoice"},{"text":" (push–relabel) is the default because","type":"text"},{"text":" ","type":"text"},{"text":"Dinic’s phases can be many on long networks: on the DIMACS genrmf-long family (8 × 8 × 256)","type":"text"},{"text":" ","type":"text"},{"text":"it took 223 ms here against push–relabel’s 5 ms.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/dinicmaximumflow(from:to:capacity:)"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/vertexDisjointPaths(from:to:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertexDisjointPaths"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">]"}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/vertexDisjointPaths(from:to:)","abstract":[{"type":"text","text":"A largest set of internally vertex-disjoint paths from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"node_disjoint_paths"},{"type":"text","text":"; igraph "},{"type":"codeVoice","code":"vertex_disjoint_paths"},{"type":"text","text":" gives their number): as many as"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexConnectivity(from:to:)"},{"type":"text","text":", each a simple path, no vertex but the two ends in two of"},{"type":"text","text":" "},{"type":"text","text":"them. An edge from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":" is one such path, whatever its multiplicity (the"},{"type":"text","text":" "},{"type":"text","text":"first in position order, listed last). A unit flow on the split network (each other vertex"},{"type":"text","text":" "},{"type":"text","text":"an arc of capacity 1), decomposed. Which paths are returned is not specified, but the same"},{"type":"text","text":" "},{"type":"text","text":"input always gives the same paths. O(m √n)."}],"title":"vertexDisjointPaths(from:to:)","kind":"symbol","type":"topic","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/vertexdisjointpaths(from:to:)"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumVertexCut()":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumVertexCut()","abstract":[{"type":"text","text":"A minimum vertex cut, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, by Even’s pair order (the first strict minimum"},{"type":"text","text":" "},{"type":"text","text":"over the pairs, each the canonical cut nearest its target); the vertices after the first"},{"type":"text","text":" "},{"type":"text","text":"for a complete digraph; empty when κ = 0."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumVertexCut","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":"]","kind":"text"}],"title":"minimumVertexCut()","type":"topic","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumvertexcut()"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumCostFlow(supply:capacity:cost:)":{"title":"minimumCostFlow(supply:capacity:cost:)","abstract":[{"type":"text","text":"A least-cost flow meeting every supply (positive: the vertex sends that much more than it"},{"type":"text","text":" "},{"type":"text","text":"receives; negative: a demand), within capacities (LEMON "},{"type":"codeVoice","code":"NetworkSimplex"},{"type":"text","text":", OR-Tools"},{"type":"text","text":" "},{"type":"codeVoice","code":"SimpleMinCostFlow"},{"type":"text","text":", NetworkX "},{"type":"codeVoice","code":"min_cost_flow"},{"type":"text","text":" with the opposite sign), or nil when there is"},{"type":"text","text":" "},{"type":"text","text":"none: the supplies do not sum to zero, or some set of vertices supplies more than its"},{"type":"text","text":" "},{"type":"text","text":"out-edges carry. Costs may be negative; negative cycles are saturated (capacities are"},{"type":"text","text":" "},{"type":"text","text":"finite). A self-loop carries its capacity when its cost is negative and nothing otherwise."},{"type":"text","text":" "},{"type":"text","text":"Network simplex with block-search pivots and strongly feasible trees, LEMON’s layout."},{"type":"text","text":" "},{"type":"codeVoice","code":"supply"},{"type":"text","text":" is called once per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, then, for each edge in position"},{"type":"text","text":" "},{"type":"text","text":"order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":", before any work. Which optimum is returned when several"},{"type":"text","text":" "},{"type":"text","text":"exist is unspecified, but the same input always gives the same result."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCostFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"supply"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cost"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"MinimumCostFlow","preciseIdentifier":"s:5Flows15MinimumCostFlowV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">?"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCostFlow(supply:capacity:cost:)","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostflow(supply:capacity:cost:)","role":"symbol"}}}