t"},{"type":"text","text":"): the maximum"},{"type":"text","text":" "},{"type":"text","text":"flow value by push–relabel’s first phase, then "},{"type":"codeVoice","code":"minimumCostFlow"},{"text":" with that supply at","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" and demand at ","type":"text"},{"type":"codeVoice","code":"sink"},{"text":". So a negative cycle away from every source–sink path is","type":"text"},{"text":" ","type":"text"},{"text":"still saturated. For each edge in position order, ","type":"text"},{"type":"codeVoice","code":"capacity"},{"text":" is called and then ","type":"text"},{"type":"codeVoice","code":"cost"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"once each, before any work.","type":"text"}],"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostmaximumflow(from:to:capacity:cost:)"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/dinicMaximumFlow(from:to:capacity:)":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dinicMaximumFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08D