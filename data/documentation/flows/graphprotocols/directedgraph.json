type":"text"},{"text":"order, ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" and then ","type":"text"},{"code":"cost","type":"codeVoice"},{"text":", before any work. Which optimum is returned when several","type":"text"},{"text":" ","type":"text"},{"text":"exist is unspecified, but the same input always gives the same result.","type":"text"}]},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumCut(capacity:)":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCut(capacity:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Flows3CutV","text":"Cut"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">?"}],"kind":"symbol","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcut(capacity:)","type":"topic","role":"symbol","abstract":[{"text":"A minimum cut over all nonempty proper vertex sets S, by the capacity of the edges leaving","type":"text"},{"text":" ","type":"text"},{"text":"S (igraph ","type":"text"},{"type":"codeVoice","code":"mincut()"},{"text":" on a directed graph): Hao and Orlin’s algorithm (LEMON ","type":"text"},{"type":"codeVoice","code":"HaoOrlin"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"one push–relabel run that moves the sink through every vertex, then the same on the","type":"text"},{"text":" ","type":"text"},{"text":"reversed graph, so both the cuts with the first vertex on the source side and those with it","type":"text"},{"text":" ","type":"text"},{"text":"on the sink side are seen. Which minimum cut is returned when several exist is not","type":"text"},{"text":" ","type":"text"},{"text":"specified, but the same input always gives the same cut. nil below two vertices.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"capacity"},{"text":" is called once per non-loop edge, in position order, before any work.","type":"text"},{"text":" ","type":"text"},{"text":"O(n²m) in the worst case.","type":"text"}],"title":"minimumCut(capacity:)"},"doc://Flows/documentation/Flows":{"kind":"symbol","url":"\/documentation\/flows","abstract":[],"title":"Flows","role":"collection","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumVertexCut(from:to:)":{"kind":"symbol","url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumvertexcut(from:to:)","abstract":[{"text":"The minimum source–target vertex cut nearest ","type":"text"},{"type":"codeVoice","code":"target"},{"text":", in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, or nil when an","type":"text"},{"text":" ","type":"text"},{"text":"edge goes from ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"target"},{"text":" (no vertex set separates them).","type":"text"}],"title":"minimumVertexCut(from:to:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCut"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preci