","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows3CutV","text":"Cut","kind":"typeIdentifier","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The cut minimizes the capacity of the edges between a nonempty proper vertex set and the"},{"type":"text","text":" "},{"type":"text","text":"rest. The side holding the first vertex is the source side. Computed by Nagamochi–Ibaraki:"},{"type":"text","text":" "},{"type":"text","text":"maximum adjacency orderings that contract every edge whose scanned connection is at least"},{"type":"text","text":" "},{"type":"text","text":"the best cut so far. Which minimum cut is returned when several exist is unspecified, but"},{"type":"text","text":" "},{"type":"text","text":"the same input always gives the same cut."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the edges of positive capacity do not connect the graph, the result is the cut of"},{"type":"text","text":" "},{"type":"text","text":"value zero whose source side is the first vertex’s component, with every crossing edge."},{"type":"text","text":" "},{"type":"text","text":"Parallel capacities add and self-loops are ignored. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once per non-loop"},{"type":"text","text":" "},{"type":"text","text":"edge, in position order, before any work."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Sums are formed in a wider type than "},{"code":"C","type":"codeVoice"},{"type":"text","text":" where needed ("},{"code":"Int","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Int128","type":"codeVoice"},{"type":"text","text":" for fixed-width"},{"type":"text","text":" "},{"type":"text","text":"integers, "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" for "},{"code":"Float","type":"codeVoice"},{"type":"text","text":"), so a contracted group’s connection may exceed "},{"code":"C","type":"codeVoice"},{"type":"text","text":"’s range."}],"type":"paragraph"},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(nm log n) in the worst case."}],"type":"paragraph"}]},{"name":"Precondition","style":"note","type":"aside","content":[{"inlineContent":[{"text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s","type":"text"},{"text":" ","type":"text"},{"text":"value fits in ","type":"text"},{"code":"C","type":"codeVoice"},{"t