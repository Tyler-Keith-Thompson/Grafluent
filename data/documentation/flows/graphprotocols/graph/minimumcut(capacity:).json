nd":"text"},{"text":"DirectedView","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"code":"{u, v}","type":"codeVoice"},{"type":"text","text":" is the two arcs "},{"code":"u→v","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"v→u","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"successors","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"predecessors","type":"codeVoice"},{"text":" are both ","type":"text"},{"code":"neighbors","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"title":"DirectedView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedView"}],"url":"\/documentation\/graphprotocols\/directedview"},"doc://Flows/documentation/Flows/Cut":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cut","kind":"identifier"}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut","abstract":[{"text":"The vertices split into a source side and a sink side, and the edges from the first to the","type":"text"},{"text":" ","type":"text"},{"text":"second. Returned by ","type":"text"},{"code":"minimumCut(from:to:capacity:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumCut(capacity:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"Flow.minimumCut","type":"codeVoice"},{"text":".","type":"text"}],"title":"Cut","role":"symbol","navigatorTitle":[{"text":"Cut","kind":"identifier"}],"url":"\/documentation\/flows\/cut"},"doc://Flows/documentation/Flows":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows","abstract":[],"title":"Flows","role":"collection","url":"\/docu