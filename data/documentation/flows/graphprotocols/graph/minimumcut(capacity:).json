{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)"},"sections":[],"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"Flows"}],"symbolKind":"method","extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cut","preciseIdentifier":"s:5Flows3CutV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">?"}],"role":"symbol","remoteSource":{"fileName":"GlobalMinimumCut.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/GlobalMinimumCut.swift#L484"},"roleHeading":"Instance Method","title":"minimumCut(capacity:)","externalID":"s:14GraphProtocols0A0P5FlowsE10minimumCut8capacityAD0E0VyAA12DirectedViewVyxGqd__GSgqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut","preciseIdentifier":"s:5Flows3CutV","text":"Cut","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"The cut minimizes the capacity of the edges between a nonempty proper vertex set and the","type":"text"},{"text":" ","type":"text"},{"text":"rest. The side holding the first vertex is the source side. Computed by Nagamochi–Ibaraki:","type":"text"},{"text":" ","type":"text"},{"text":"maximum adjacency orderings that contract every edge whose scanned connection is at least","type":"text"},{"text":" ","type":"text"},{"text":"the best cut so far. Which minimum cut is returned when several exist is unspecified, but","type":"text"},{"text":" ","type":"text"},{"text":"the same input always gives the same cut.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the edges of positive capacity do not connect the graph, the result is the cut of"},{"type":"text","text":" "},{"type":"text","text":"value zero whose source side is the first vertex’s component, with every crossing edge."},{"type":"text","text":" "},{"type":"text","text":"Parallel capacities add and self-loops are ignored. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once per non-loop"},{"type":"text","text":" "},{"type":"text","text":"edge, in position order, before any work."}],"type":"paragraph"},{"inlineContent":[{"text":"Sums are formed in a wider type than ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" where needed (","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Int128","type":"codeVoice"},{"text":" for fixed-width","type":"text"},{"text":" ","type":"text"},{"text":"integers, ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":"), so a contracted group’s connection may exceed ","type":"text"},{"code":"C","type":"codeVoice"},{"text":"’s range.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O(nm log n) in the worst case."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"},{"content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s"},{"type":"text","text":" "},{"type":"text","text":"value fits in "},{"code":"C","type":"codeVoice"},{"type":"text","text":" (it is at most every vertex’s capacity sum)."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Precondition"}]}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"A global minimum cut over "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":", or nil below two vertices."}],"references":{"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumCut(capacity:)":{"kind":"symbol","abstract":[{"type":"text","text":"A global minimum cut over "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":", or nil below two vertices."}],"title":"minimumCut(capacity:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cut","preciseIdentifier":"s:5Flows3CutV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">?"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","url":"\/documentation\/flows\/g