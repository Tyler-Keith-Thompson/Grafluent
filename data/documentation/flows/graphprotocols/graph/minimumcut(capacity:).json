ind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows3CutV","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut","text":"Cut","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cut minimizes the capacity of the edges between a nonempty proper vertex set and the"},{"type":"text","text":" "},{"type":"text","text":"rest. The side holding the first vertex is the source side. Computed by Nagamochi–Ibaraki:"},{"type":"text","text":" "},{"type":"text","text":"maximum adjacency orderings that contract every edge whose scanned connection is at least"},{"type":"text","text":" "},{"type":"text","text":"the best cut so far. Which minimum cut is returned when several exist is unspecified, but"},{"type":"text","text":" "},{"type":"text","text":"the same input always gives the same cut."}]},{"type":"paragraph","inlineContent":[{"text":"When the edges of positive capacity do not connect the graph, the result is the cut of","type":"text"},{"text":" ","type":"text"},{"text":"value zero whose source side is the first vertex’s component, with every crossing edge.","type":"text"},{"text":" ","type":"text"},{"text":"Parallel capacities add and self-loops are ignored. ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is called once per non-loop","type":"text"},{"text":" ","type":"text"},{"text":"edge, in position order, before any work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Sums are formed in a wider type than ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" where needed (","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Int128","type":"codeVoice"},{"text":" for fixed-width","type":"text"},{"text":" ","type":"text"},{"text":"integers, ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":"), so a contracted group’s connection may exceed ","type":"text"},{"code":"C","type":"codeVoice"},{"text":"’s range.","type":"text"}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(nm log n) in the worst case.","type":"text"}]}],"name":"Complexity"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s","type":"text"},{"text":" ","type":"text"},{"text":"value fits in ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" (it is at most every vertex’s capacity sum).","type":"text"}]}],"name":"Precondition"}]}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A global minimum cut over "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":", or nil below two vertices."}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"title":"Edges","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"kind":"symbol"},"doc://Flows/documentation/Flows/Cut":{"abstract":[{"type":"text","text":"The vertices split into a source side and a sink side, and the edges from the first to the"},{"type":"text","text":" "},{"type":"text","text":"second. Returned by "},{"type":"codeVoice","code":"minimumCut(from:to:capacity:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"minimumCut(capacity:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"Flow.minimumCut","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/flows\/cut","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cut"}],"type":"topic","title":"Cut","role":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut","navigatorTitle":[{"kind":"identifier","text":"Cut"}]},"doc://Flows/documentation/Flows/GraphProtocols":{"url":"\/docum