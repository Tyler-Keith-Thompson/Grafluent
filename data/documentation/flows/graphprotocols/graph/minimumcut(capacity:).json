{"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Flows3CutV","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut","text":"Cut"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The cut minimizes the capacity of the edges between a nonempty proper vertex set and the","type":"text"},{"text":" ","type":"text"},{"text":"rest. The side holding the first vertex is the source side. Computed by Nagamochi–Ibaraki:","type":"text"},{"text":" ","type":"text"},{"text":"maximum adjacency orderings that contract every edge whose scanned connection is at least","type":"text"},{"text":" ","type":"text"},{"text":"the best cut so far. Which minimum cut is returned when several exist is unspecified, but","type":"text"},{"text":" ","type":"text"},{"text":"the same input always gives the same cut.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the edges of positive capacity do not connect the graph, the result is the cut of"},{"type":"text","text":" "},{"type":"text","text":"value zero whose source side is the first vertex’s component, with every crossing edge."},{"type":"text","text":" "},{"type":"text","text":"Parallel capacities add and self-loops are ignored. "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" is called once per non-loop"},{"type":"text","text":" "},{"type":"text","text":"edge, in position order, before any work."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sums are formed in a wider type than "},{"type":"codeVoice","code":"C"},{"type":"text","text":" where needed ("},{"type":"codeVoice","code":"Int"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Int128"},{"type":"text","text":" for fixed-width"},{"type":"text","text":" "},{"type":"text","text":"integers, "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" for "},{"type":"codeVoice","code":"Float"},{"type":"text","text":"), so a contracted group’s connection may exceed "},{"type":"codeVoice","code":"C"},{"type":"text","text":"’s range."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(nm log n) in the worst case.","type":"text"}]}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s"},{"type":"text","text":" "},{"type":"text","text":"value fits in "},{"type":"codeVoice","code":"C"},{"type":"text","text":" (it is at most every vertex’s capacity sum)."}],"type":"paragraph"}],"style":"note","name":"Precondition"}]}],"sections":[],"abstract":[{"type":"text","text":"A global minimum cut over "},{"code":"directedView","type":"codeVoice"},{"type":"text","text":", or nil below two vertices."}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"Flows"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Flows3CutV","kind":"typeIdentifier","text":"Cut"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","te