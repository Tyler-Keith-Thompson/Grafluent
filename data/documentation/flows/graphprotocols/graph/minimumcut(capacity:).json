{"sections":[],"metadata":{"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Flows3CutV","kind":"typeIdentifier","text":"Cut"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">?"}],"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/GlobalMinimumCut.swift#L484","fileName":"GlobalMinimumCut.swift"},"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P5FlowsE10minimumCut8capacityAD0E0VyAA12DirectedViewVyxGqd__GSgqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","role":"symbol","modules":[{"name":"Flows","relatedModules":["GraphProtocols"]}],"title":"minimumCut(capacity:)"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)"]}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"A global minimum cut over "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":", or nil below two vertices."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows3CutV","text":"Cut","kind":"typeIdentifier","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The cut minimizes the capacity of the edges between a nonempty proper vertex set and the","type":"text"},{"text":" ","type":"text"},{"text":"rest. The side holding the first vertex is the source side. Computed by Nagamochi–Ibaraki:","type":"text"},{"text":" ","type":"text"},{"text":"maximum adjacency orderings that contract every edge whose scanned connection is at least","type":"text"},{"text":" ","type":"text"},{"text":"the best cut so far. Which minimum cut is returned when several exist is unspecified, but","type":"text"},{"text":" ","type":"text"},{"text":"the same input always gives the same cut.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the edges of positive capacity do not connect the graph, the result is the cut of","type":"text"},{"text":" ","type":"text"},{"text":"value zero whose source side is the first vertex’s component, with every crossing edge.","type":"text"},{"text":" ","type":"text"},{"text":"Parallel capacities add and self-loops are ignored. ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is called once per non-loop","type":"text"},{"text":" ","type":"text"},{"text":"edge, in position order, before any work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sums are formed in a wider type than "},{"code":"C","type":"codeVoice"},{"type":"text","text":" where needed ("},{"code":"Int","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Int128","type":"codeVoice"},{"type":"text","text":" for fixed-width"},{"type":"text","text":" "},{"type":"text","text":"integers, "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" for "},{"code":"Float","type":"codeVoice"},{"type":"text","text":"), so a contracted group’s connection may exceed "},{"code":"C","type":"codeVoice"},{"type":"text","text":"’s range."}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(nm log n) in the worst case."}],"type":"paragraph"}],"style":"note"},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s"},{"type":"text","text":" "},{"type":"text","text":"value fits in "},{"type":"codeVoice","code":"C"},{"type":"text","text":" (it is at most every vertex’s capacity sum)."}],"type":"paragraph"}],"style":"note"}]}],"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","interfaceLanguage":"swift"},"references":{"doc://Flows/documentation/Flows/GraphProtocols/Graph":{"url":"\/documentation\/flows\/graphprotocols\/graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[],"title":"Graph","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumCut(capacity:)":{"kind":"symbol","title":"minimumCut(capacity:)","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","role":"symbol","abstract":[{"type":"text","text":"A global minimum cut over "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":", or nil below two vertices."}],"type":"topic","url":"\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","ki