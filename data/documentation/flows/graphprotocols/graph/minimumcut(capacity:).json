e"},{"text":", or nil below two vertices.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Flows3CutV","text":"Cut","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"The cut minimizes the capacity of the edges between a nonempty proper vertex set and the","type":"text"},{"text":" ","type":"text"},{"text":"rest. The side holding the first vertex is the source side. Computed by Nagamochi–Ibaraki:","type":"text"},{"text":" ","type":"text"},{"text":"maximum adjacency orderings that contract every edge whose scanned connection is at least","type":"text"},{"text":" ","type":"text"},{"text":"the best cut so far. Which minimum cut is returned when several exist is unspecified, but","type":"text"},{"text":" ","type":"text"},{"text":"the same input always gives the same cut.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the edges of positive capacity do not connect the graph, the result is the cut of"},{"type":"text","text":" "},{"type":"text","text":"value zero whose source side is the first vertex’s component, with every crossing edge."},{"type":"text","text":" "},{"type":"text","text":"Parallel capacities add and self-loops are ignored. "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" is called once per non-loop"},{"type":"text","text":" "},{"type":"text","text":"edge, in position order, before any work."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Sums are formed in a wider type than "},{"type":"codeVoice","code":"C"},{"type":"text","text":" where needed ("},{"type":"codeVoice","code":"Int"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Int128"},{"type":"text","text":" for fixed-width"},{"type":"text","text":" "},{"type":"text","text":"integers, "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" for "},{"type":"codeVoice","code":"Float"},{"type":"text","text":"), so a contracted group’s connection may exceed "},{"type":"codeVoice","code":"C"},{"type":"text","text":"’s range."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(nm log n) in the worst case.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s","type":"text"},{"text":" ","type":"text"},{"text":"value fits in ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" (it is at most every vertex’s capacity sum).","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"kind":"symbol","type":"topic","abstract":[],"title":"Edges"},"doc://Flows/documentation/Flows/Cut":{"url":"\/documentation\/flows\/cut","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut","type":"topic","role":"symbol","abstract":[{"text":"The vertices split into a source side and a sink side, and the edges from the first to the","type":"text"},{"text":" ","type":"text"},{"text":"second. Returned by ","type":"text"},{"code":"minimumCut(from:to:capacity:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumCut(capacity:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"Flow.minimumCut","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Cut"}],"title":"Cut","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cut"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView"