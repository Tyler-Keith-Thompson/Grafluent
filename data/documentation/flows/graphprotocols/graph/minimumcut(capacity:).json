ection may pass "},{"type":"codeVoice","code":"C"},{"type":"text","text":"’s range."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s","type":"text"},{"text":" ","type":"text"},{"text":"value fits in ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" (it is at most every vertex’s capacity sum).","type":"text"}]}],"name":"Precondition"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)"]}],"sections":[],"abstract":[{"type":"text","text":"A global minimum cut, over "},{"type":"codeVoice","code":"directed"},{"type":"text","text":": the least capacity of the edges between a nonempty"},{"type":"text","text":" "},{"type":"text","text":"proper vertex set and the rest, the set holding the first vertex as the source side; nil"},{"type":"text","text":" "},{"type":"text","text":"below two vertices. By Nagamochi–Ibaraki (LEMON "},{"type":"codeVoice","code":"NagamochiIbaraki"},{"type":"text","text":"; the same value as"},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"type":"codeVoice","code":"stoer_wagner"},{"type":"text","text":", Boost "},{"type":"codeVoice","code":"stoer_wagner_min_cut"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"stoer_wagner_min_cut"},{"type":"text","text":" "},{"type":"text","text":"and igraph "},{"type":"codeVoice","code":"mincut()"},{"type":"text","text":"): maximum adjacency orderings that contract every edge whose scanned"},{"type":"text","text":" "},{"type":"text","text":"connection is at least the best cut so far, so later phases run on smaller graphs. Which"},{"type":"text","text":" "},{"type":"text","text":"minimum cut is returned when several exist is not