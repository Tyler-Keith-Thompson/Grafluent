w"},{"type":"text","text":", or nil below two vertices."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cut","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut","preciseIdentifier":"s:5Flows3CutV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The cut minimizes the capacity of the edges between a nonempty proper vertex set and the"},{"type":"text","text":" "},{"type":"text","text":"rest. The side holding the first vertex is the source side. Computed by Nagamochi–Ibaraki:"},{"type":"text","text":" "},{"type":"text","text":"maximum adjacency orderings that contract every edge whose scanned connection is at least"},{"type":"text","text":" "},{"type":"text","text":"the best cut so far. Which minimum cut is returned when several exist is unspecified, but"},{"type":"text","text":" "},{"type":"text","text":"the same input always gives the same cut."}],"type":"paragraph"},{"inlineContent":[{"text":"When the edges of positive capacity do not connect the graph, the result is the cut of","type":"text"},{"text":" ","type":"text"},{"text":"value zero whose source side is the first vertex’s component, with every crossing edge.","type":"text"},{"text":" ","type":"text"},{"text":"Parallel capacities add and self-loops are ignored. ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is called once per non-loop","type":"text"},{"text":" ","type":"text"},{"text":"edge, in position order, before any work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Sums are formed in a wider type than ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" where needed (","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Int128","type":"codeVoice"},{"text":" for fixed-width","type":"text"},{"text":" ","type":"text"},{"text":"integers, ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":"), so a contracted group’s connection may exceed ","type":"text"},{"code":"C","type":"codeVoice"},{"text":"’s range.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O(nm log n) in the worst case."}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"Every capacity is at least zero, not NaN and finite, and the minimum cut’s","type":"text"},{"text":" ","type":"text"},{"text":"value fits in ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" (it is at most every vertex’s capacity sum).","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside","style":"note"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Flows/documentation/Flows/Cut":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cut"}],"navigatorTitle":[{"kind":"identifier","text":"Cut"}],"abstract":[{"type":"text","text":"The vertices split into a source side and a sink side, and the edges from the first to the"},{"type":"text","text":" "},{"type":"text","text":"second. Returned by "},{"code":"minimumCut(from:to:capacity:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"minimumCut(capacity:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"Flow.minimumCut"},{"type":"text","text":"."}],"title":"Cut","kind":"symbol","url":"\/documentation\/flows\/cut","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/Cut"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumCut(capacity:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":