:" "},{"type":"text","text":"edges. "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" is called once per non-loop edge, in position order, before any work."}],"type":"paragraph"},{"inlineContent":[{"text":"The flows run in a wider type than ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" where needed (","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Int128"},{"text":" for fixed-width","type":"text"},{"text":" ","type":"text"},{"text":"integers, ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"Float"},{"text":"), so a vertex’s capacity sum may exceed ","type":"text"},{"type":"codeVoice","code":"C"},{"text":"’s range.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every capacity is at least zero, not NaN and finite, and every tree"},{"type":"text","text":" "},{"type":"text","text":"capacity (a minimum cut value) fits in "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}]}],"type":"aside","style":"note","name":"Precondition"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/flows\/graphprotocols\/graph\/gomoryhutree(capacity:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A Gomory–Hu cut tree, or nil for the empty graph.","type":"text"}],"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"type":"topic","title":"Edges","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":