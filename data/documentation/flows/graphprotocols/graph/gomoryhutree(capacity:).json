{"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gomoryHuTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"GomoryHuTree","kind":"typeIdentifier","preciseIdentifier":"s:5Flows12GomoryHuTreeV","identifier":"doc:\/\/Flows\/documentation\/Flows\/GomoryHuTree"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Every pair’s minimum cut value is the least capacity on its tree path, and every tree edge","type":"text"},{"text":" ","type":"text"},{"text":"splits the vertices into a minimum cut between its ends. Computed by Gusfield’s algorithm","type":"text"},{"text":" ","type":"text"},{"text":"with the canonical cut, vertices in order, rooted at the first: n − 1 maximum flows on one","type":"text"},{"text":" ","type":"text"},{"text":"residual network, by push–relabel’s first phase. Disconnected graphs get zero-capacity tree","type":"text"},{"text":" ","type":"text"},{"text":"edges. ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order, before any work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The flows run in a wider type than "},{"code":"C","type":"codeVoice"},{"type":"text","text":" where needed ("},{"code":"Int","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Int128","type":"codeVoice"},{"type":"text","text":" for fixed-width"},{"type":"text","text":" "},{"type":"text","text":"integers, "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" for "},{"code":"Float","type":"codeVoice"},{"type":"text","text":"), so a vertex’s capacity sum may exceed "},{"code":"C","type":"codeVoice"},{"type":"text","text":"’s range."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero, not NaN and finite, and every tree"},{"type":"text","text":" "},{"type":"text","text":"capacity (a minimum cut value) fits in "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"}]}],"abstract":[{"text":"A Gomory–Hu cut tree, or nil for the empty graph.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/gomoryhutree(capacity:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph