{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gomoryHuTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GomoryHuTree","text":"GomoryHuTree","kind":"typeIdentifier","preciseIdentifier":"s:5Flows12GomoryHuTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Every pair’s minimum cut value is the least capacity on its tree path, and every tree edge"},{"type":"text","text":" "},{"type":"text","text":"splits the vertices into a minimum cut between its ends. Computed by Gusfield’s algorithm"},{"type":"text","text":" "},{"type":"text","text":"with the canonical cut, vertices in order, rooted at the first: n − 1 maximum flows on one"},{"type":"text","text":" "},{"type":"text","text":"residual network, by push–relabel’s first phase. Disconnected graphs get zero-capacity tree"},{"type":"text","text":" "},{"type":"text","text":"edges. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once per non-loop edge, in position order, before any work."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The flows run in a wider type than "},{"type":"codeVoice","code":"C"},{"type":"text","text":" where needed ("},{"type":"codeVoice","code":"Int"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Int128"},{"type":"text","text":" for fixed-width"},{"type":"text","text":" "},{"type":"text","text":"integers, "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" for "},{"type":"codeVoice","code":"Float"},{"type":"text","text":"), so a vertex’s capacity sum may exceed "},{"type":"codeVoice","code":"C"},{"type":"text","text":"’s range."}],"type":"paragraph"},{"name":"Precondition","style":"note","type":"aside","content":[{"inlineContent":[{"text":"Every capacity is at least zero, not NaN and finite, and every tree","type":"text"},{"text":" ","type":"text"},{"text":"capacity (a minimum cut value) fits in ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"modules":[{"name":"Flows","relatedModules":["GraphProtocols"]}],"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/GomoryHuTree.swift#L206","fileName":"GomoryHuTree.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gomoryHuTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":":