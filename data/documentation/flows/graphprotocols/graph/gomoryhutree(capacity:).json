{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A Gomory–Hu cut tree, or nil for the empty graph."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gomoryHuTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows12GomoryHuTreeV","text":"GomoryHuTree","kind":"typeIdentifier","identifier":"doc:\/\/Flows\/documentation\/Flows\/GomoryHuTree"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Every pair’s minimum cut value is the least capacity on its tree path, and every tree edge","type":"text"},{"text":" ","type":"text"},{"text":"splits the vertices into a minimum cut between its ends. Computed by Gusfield’s algorithm","type":"text"},{"text":" ","type":"text"},{"text":"with the canonical cut, vertices in order, rooted at the first: n − 1 maximum flows on one","type":"text"},{"text":" ","type":"text"},{"text":"residual network, by push–relabel’s first phase. Disconnected graphs get zero-capacity tree","type":"text"},{"text":" ","type":"text"},{"text":"edges. ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order, before any work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The flows run in a wider type than "},{"type":"codeVoice","code":"C"},{"type":"text","text":" where needed ("},{"type":"codeVoice","code":"Int"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Int128"},{"type":"text","text":" for fixed-width"},{"type":"text","text":" "},{"type":"text","text":"integers, "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" for "},{"type":"codeVoice","code":"Float"},{"type":"text","text":"), so a vertex’s capacity sum may exceed "},{"type":"codeVoice","code":"C"},{"type":"text","text":"’s range."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"Every capacity is at least zero, not NaN and finite, and every tree","type":"text"},{"text":" ","type":"text"},{"text":"capacity (a minimum cut value) fits in ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Precondition"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/graph\/gomoryhutree(capacity:)"]}],"kind":"symbol","metadata":{"roleHeading":"Instance Method","title":"gomoryHuTree(capacity:)","externalID":"s:14GraphProt