xt":"it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Computed by reduction to a maximum flow (push–relabel) from a super source serving each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s imbalance after the lower bounds. Which flow is returned when several exist is"},{"type":"text","text":" "},{"type":"text","text":"unspecified, but the same input always gives the same result."}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n² √m).","type":"text"}]}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"inlineContent":[{"text":"Every lower bound is at most its capacity; no value is NaN or infinite; the","type":"text"},{"text":" ","type":"text"},{"text":"supplies sum to zero; the lower bounds and supplies at a vertex sum without overflow, and","type":"text"},{"text":" ","type":"text"},{"text":"capacity − lower bound does not overflow.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"abstract":[{"text":"A flow that carries between each edge’s lower bound and its capacity and in which every","type":"text"},{"text":" ","type":"text"},{"text":"vertex sends out exactly its supply more than it receives; nil when there is none.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/flows\/graphprotocols\/directedgraph\/feasiblecirculation(supply:lowerbound:capacity:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","abstract":[],"title":"Vertex","role":"symbol","kind":"symbol","type":"topic","url":"\/documentatio