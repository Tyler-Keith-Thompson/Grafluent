demand. The supplies must sum to zero. Lower bounds may be negative (a flow against the","type":"text"},{"text":" ","type":"text"},{"text":"edge, with a signed type). A self-loop carries its lower bound. When there is no such flow,","type":"text"},{"text":" ","type":"text"},{"code":"findCirculationBarrier(supply:lowerBound:capacity:)","type":"codeVoice"},{"text":" gives a set of vertices that proves","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Computed by reduction to a maximum flow (push–relabel) from a super source serving each","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s imbalance after the lower bounds. Which flow is returned when several exist is","type":"text"},{"text":" ","type":"text"},{"text":"unspecified, but the same input always gives the same result.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"O(n² √m).","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every lower bound is at most its capacity; no value is NaN or infinite; the"},{"type":"text","text":" "},{"type":"text","text":"supplies sum to zero; the lower bounds and supplies at a vertex sum without overflow, and"},{"type":"text","text":" "},{"type":"text","text":"capacity − lower bound does not overflow."}],"type":"paragraph"}],"name":"Precondition","style":"note"}],"kind":"content"}],"kind":"symbol","references":{"doc://Flows/documentation/Flows/GraphProtocols":{"title":"GraphProtocols","abstract":[],"url":"\/documentation\/flows\/graphprotocols","kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","type":"topic","role":"collection"},"doc://Flows/documentation/Flows/Circulation":{"title":"Circulation","navigatorTitle":[{"kind":"identifier","text":"Circulation"}],"abstract":[{"type":"text","text":"A feasible flow within lower bounds and capacities that meets every supply, returned by"},{"type":"text","text":" "},{"type":"codeVoice","code":"feasibleCirculation(supply:lowerBound:capacity:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"feasibleCirculation(lowerBound:capacity:)"},{"type":"text","text":"."}],"url":"\/documentation\/flows\/circulation","kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/Circulation","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Circulation"}]},"doc://Flows/documentation/Flows":{"role":"collection","identifier":"doc:\/\/Flows\/documentation\/Flows","abstract":[],"url":"\/documentation\/flows","type":"topic","kind":"symbol","title":"Flows"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","kind":"symbol","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/feasibleCirculation(supply:lowerBound:capacity:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feasibleCirculation"},{"kind":"text","text":"<"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"supply","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"lowerBound"},{"kin