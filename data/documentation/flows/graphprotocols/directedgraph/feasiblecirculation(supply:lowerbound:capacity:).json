,{"type":"text","text":" "},{"type":"codeVoice","code":"findCirculationBarrier(supply:lowerBound:capacity:)"},{"type":"text","text":" gives a set of vertices that proves"},{"type":"text","text":" "},{"type":"text","text":"it."}],"type":"paragraph"},{"inlineContent":[{"text":"Computed by reduction to a maximum flow (push–relabel) from a super source serving each","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s imbalance after the lower bounds. Which flow is returned when several exist is","type":"text"},{"text":" ","type":"text"},{"text":"unspecified, but the same input always gives the same result.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n² √m)."}]}]},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every lower bound is at most its capacity; no value is NaN or infinite; the"},{"type":"text","text":" "},{"type":"text","text":"supplies sum to zero; the lower bounds and supplies at a vertex sum without overflow, and"},{"type":"text","text":" "},{"type":"text","text":"capacity − lower bound does not overflow."}]}]}]}],"abstract":[{"text":"A flow that carries between each edge’s lower bound and its capacity and in which every","type":"text"},{"text":" ","type":"text"},{"text":"vertex sends out exactly its supply more than it receives; nil when there is none.","type":"text"}],"references":{"doc://Flows/documentation/Flows":{"url":"\/documentation\/flows","abstract":[],"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows","title":"Flows","role":"collection","kind":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols":{"url":"\/documentation\/flows\/graphprotocols","type":"topic","abstract":[],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","title":"GraphProtocols","role":"collection","kind":"symbol"},"doc://GraphProtocols/documentati