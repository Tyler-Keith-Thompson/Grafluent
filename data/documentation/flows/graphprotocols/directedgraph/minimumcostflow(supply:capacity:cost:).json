t":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Flows15MinimumCostFlowV","text":"MinimumCostFlow","identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A positive supply is how much more the vertex sends than it receives; a negative one is a","type":"text"},{"text":" ","type":"text"},{"text":"demand. There is no flow when the supplies do not sum to zero or some set of vertices","type":"text"},{"text":" ","type":"text"},{"text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are","type":"text"},{"text":" ","type":"text"},{"text":"saturated. A self-loop carries its capacity when its cost is negative and nothing","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Capacities may be of an unsigned type, up to ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Computed by the network simplex with block-search pivots and strongly feasible trees.","type":"text"},{"text":" ","type":"text"},{"text":"Which optimum is returned when several exist is unspecified, but the same input always","type":"text"},{"text":" ","type":"text"},{"text":"gives the same result. ","type":"text"},{"code":"supply","type":"codeVoice"},{"text":" is called once per vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, then, for","type":"text"},{"text":" ","type":"text"},{"text":"each edge in position order, ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" and then ","type":"text"},{"code":"cost","type":"codeVoice"},{"text":", before any work.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Every capacity is at least zero; capacities, supplies and costs fit in","type":"text"},{"text":" ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; Σ capacity × |cost| fits in ","type":"text"},{"code":"Cost","type":"codeVoice"},{"text":" (checked before solving, since it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (the","type":"text"},{"text":" ","type":"text"},{"text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive","type":"text"},{"text":" ","type":"text"},{"text":"supplies sum within ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Capacity","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"Precondition","style":"note"}],"kind":"content"}],"metadata":{"symbolKind":"method","role":"symbol","extendedModule":"GraphProtocols","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"Flows"}],"title":"minimumCostFlow(supply:capacity:cost:)","externalID":"s:14GraphP