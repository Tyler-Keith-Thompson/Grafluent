ifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow","kind":"typeIdentifier","preciseIdentifier":"s:5Flows15MinimumCostFlowV","text":"MinimumCostFlow"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"A positive supply is how much more the vertex sends than it receives; a negative one is a","type":"text"},{"text":" ","type":"text"},{"text":"demand. There is no flow when the supplies do not sum to zero or some set of vertices","type":"text"},{"text":" ","type":"text"},{"text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are","type":"text"},{"text":" ","type":"text"},{"text":"saturated. A self-loop carries its capacity when its cost is negative and nothing","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Capacities may be of an unsigned type, up to ","type":"text"},{"type":"codeVoice","code":"Int.max"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Computed by the network simplex with block-search pivots and strongly feasible trees."},{"type":"text","text":" "},{"type":"text","text":"Which optimum is returned when several exist is unspecified, but the same input always"},{"type":"text","text":" "},{"type":"text","text":"gives the same result. "},{"type":"codeVoice","code":"supply"},{"type":"text","text":" is called once per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, then, for"},{"type":"text","text":" "},{"type":"text","text":"each edge in position order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":", before any work."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero; capacities, supplies and costs fit in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; Σ capacity × |cost| fits in "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":" (checked before solving, since it bounds the"},{"type":"text","text":" "},{"type":"text","text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive"},{"type":"text","text":" "},{"type":"text","text":"supplies sum within "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Capacity"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"}]}],"abstract":[{"text":"A least-cost flow within capacities that meets every supply, or nil when there is none.","type":"text"}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/