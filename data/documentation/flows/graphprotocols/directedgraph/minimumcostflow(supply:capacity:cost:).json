d costs fit in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":"; Σ capacity × |cost| fits in ","type":"text"},{"type":"codeVoice","code":"Cost"},{"text":" (checked before solving; it bounds the total","type":"text"},{"text":" ","type":"text"},{"text":"cost, so a cost that could not be represented traps here rather than wrapping);","type":"text"},{"text":" ","type":"text"},{"text":"4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" (the solver’s","type":"text"},{"text":" ","type":"text"},{"text":"artificial cost, with room for its potentials and reduced costs; computed in ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"never reported); the positive supplies sum within ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Capacity"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A least-cost flow meeting every supply (positive: the vertex sends that much more than it"},{"type":"text","text":" "},{"type":"text","text":"receives; negative: a demand), within capacities (LEMON "},{"type":"codeVoice","code":"NetworkSimplex"},{"type":"text","text":", OR-Tools"},{"type":"text","text":" "},{"type":"codeVoice","code":"SimpleMinCostFlow"},{"type":"text","text":", NetworkX "},{"type":"codeVoice","code":"min_cost_flow"},{"type":"text","text":" with the opposite sign), or nil when there is"},{"type":"text","text":" "},{"type":"text","text":"none: the supplies do not sum to zero, or some set of vertices supplies more than its"},{"type":"text","text":" "},{"type":"text","text":"out-edges carry. Costs may be negative; negative cycles are saturated (capacities are"},{"type":"text","text":" "},{"type":"text","text":"finite). A self-loop carries its capacity when its cost is negative and nothing otherwise."},{"type":"text","text":" "},{"type":"text","text":"Network simplex with block-search pivots and strongly feasible trees, LEMON’s layout."},{"type":"text","text":" "},{"type":"codeVoice","code":"supply"},{"type":"text","text":" is called once per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, then, for each edge in position"},{"type":"text","text":" "},{"type":"text","text":"order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":", before any work. Which optimum is returned when several"},{"type":"text","text":" "},{"type":"text","text":"exist is unspecified, but the same input always gives the same result."}],"metadata":{"modules":[{"name":"Flows","relatedModules":["GraphProtocols"]}],"role":"symbol","symbolKind":"method","externalID":"s:14GraphProtocols08DirectedA0P5FlowsE15minimumCostFlow6supply8capacity4costAD07MinimumfG0Vyxqd_0_qd_1_GSgqd__6VertexQzXE_qd_0_5Edges_5IndexQZXEqd_1_AQXEtSZRd__SzRd_0_SZRd_1_r1_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCostFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"supply"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:1