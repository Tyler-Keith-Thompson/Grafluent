gnedInteger"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A positive supply is how much more the vertex sends than it receives; a negative one is a","type":"text"},{"text":" ","type":"text"},{"text":"demand. There is no flow when the supplies do not sum to zero or some set of vertices","type":"text"},{"text":" ","type":"text"},{"text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are","type":"text"},{"text":" ","type":"text"},{"text":"saturated. A self-loop carries its capacity when its cost is negative and nothing","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Capacities may be of an unsigned type, up to ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Computed by the network simplex with block-search pivots and strongly feasible trees.","type":"text"},{"text":" ","type":"text"},{"text":"Which optimum is returned when several exist is unspecified, but the same input always","type":"text"},{"text":" ","type":"text"},{"text":"gives the same result. ","type":"text"},{"type":"codeVoice","code":"supply"},{"text":" is called once per vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, then, for","type":"text"},{"text":" ","type":"text"},{"text":"each edge in position order, ","type":"text"},{"type":"codeVoice","code":"capacity"},{"text":" and then ","type":"text"},{"type":"codeVoice","code":"cost"},{"text":", before any work.","type":"text"}]},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Every capacity is at least zero; capacities, supplies and costs fit in","type":"text"},{"text":" ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; Σ capacity × |cost| fits in ","type":"text"},{"code":"Cost","type":"codeVoice"},{"text":" (checked before solving, since it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (the","type":"text"},{"text":" ","type":"text"},{"text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive","type":"text"},{"text":" ","type":"text"},{"text":"supplies sum within ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Capacity","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Flows/documentation/Flows":{"abstract":[],"kind":"symbol","title":"Flows","role":"collection","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows","url":"\/documentation\/flows"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph":{"abstract":[],"kind":"symbol","title":"DirectedGraph","role":"symbol","type":"topic","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph","url":"\/documentation\/flows\/graphprotocols\/directedgraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}]},"doc://Flows/documentation/Flows/MinimumCostFlow":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MinimumCostFlow","kind":"identifier"}],"title":"MinimumCostFlow","navigatorTitle":[{"text":"MinimumCostFlow","kind":"identifier"}],"abstract":[{"type":"text","text":"A minimum-cost flow, returned by "},{"code":"minimumCostFlow(supply:capacity:cost:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"m