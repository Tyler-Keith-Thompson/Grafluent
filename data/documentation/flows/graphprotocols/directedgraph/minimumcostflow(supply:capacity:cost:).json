capacity × |cost| fits in "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":" (checked before solving, since it bounds the"},{"type":"text","text":" "},{"type":"text","text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive"},{"type":"text","text":" "},{"type":"text","text":"supplies sum within "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Capacity"},{"type":"text","text":"."}]}],"style":"note"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"title":"Edges","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","type":"topic","abstract":[]},"doc://Flows/documentation/Flows/MinimumCostFlow":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MinimumCostFlow"}],"title":"MinimumCostFlow","navigatorTitle":[{"kind":"identifier","text":"MinimumCostFlow"}],"kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow","role":"symbol","url":"\/documentation\/flows\/minimumcostflow","abstract":[{"type":"text","text":"A minimum-cost flow, returned by "},{"type":"codeVoice","code":"minimumCostFlow(supply:capacity:cost:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumCostMaximumFlow(from:to:capacity:cost:)"