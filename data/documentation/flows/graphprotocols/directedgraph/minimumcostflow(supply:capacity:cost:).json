level":2},{"inlineContent":[{"text":"A positive supply is how much more the vertex sends than it receives; a negative one is a","type":"text"},{"text":" ","type":"text"},{"text":"demand. There is no flow when the supplies do not sum to zero or some set of vertices","type":"text"},{"text":" ","type":"text"},{"text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are","type":"text"},{"text":" ","type":"text"},{"text":"saturated. A self-loop carries its capacity when its cost is negative and nothing","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Capacities may be of an unsigned type, up to ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Computed by the network simplex with block-search pivots and strongly feasible trees."},{"type":"text","text":" "},{"type":"text","text":"Which optimum is returned when several exist is unspecified, but the same input always"},{"type":"text","text":" "},{"type":"text","text":"gives the same result. "},{"type":"codeVoice","code":"supply"},{"type":"text","text":" is called once per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, then, for"},{"type":"text","text":" "},{"type":"text","text":"each edge in position order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":", before any work."}],"type":"paragraph"},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero; capacities, supplies and costs fit in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; Σ capacity × |cost| fits in "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":" (checked before solving, since it bounds the"},{"type":"text","text":" "},{"type":"text","text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive"},{"type":"text","text":" "},{"type":"text","text":"supplies sum within "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Capacity"},{"type":"text","text":"."}],"type":"paragraph"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCostFlow(supply:capacity:cost:)"},"kind":"symbol","references":{"doc://Flows/documentation/Flows":{"abstract":[],"title":"Flows","url":"\/documentation\/flows","kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows","type":"topic","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"abstract":[],"title":"Vertex","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","type":"topic","role":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols":{"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/flows\/graphprotocols","title":"GraphProtocols","abstract":[],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[],"title":"DirectedGraph","url":"\/documentation\/flows\/graphprotocols\/directedgraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","