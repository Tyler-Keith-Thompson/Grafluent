nd":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cost","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"MinimumCostFlow","preciseIdentifier":"s:5Flows15MinimumCostFlowV","identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","preciseIdentifier":"s:SZ","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","preciseIdentifier":"s:Sz","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","preciseIdentifier":"s:SZ","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A positive supply is how much more the vertex sends than it receives; a negative one is a"},{"type":"text","text":" "},{"type":"text","text":"demand. There is no flow when the supplies do not sum to zero or some set of vertices"},{"type":"text","text":" "},{"type":"text","text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are"},{"type":"text","text":" "},{"type":"text","text":"saturated. A self-loop carries its capacity when its cost is negative and nothing"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Capacities may be of an unsigned type, up to "},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Computed by the network simplex with block-search pivots and strongly feasible trees.","type":"text"},{"text":" ","type":"text"},{"text":"Which optimum is returned when several exist is unspecified, but the same input always","type":"text"},{"text":" ","type":"text"},{"text":"gives the same result. ","type":"text"},{"code":"supply","type":"codeVoice"},{"text":" is called once per vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, then, for","type":"text"},{"text":" ","type":"text"},{"text":"each edge in position order, ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" and then ","type":"text"},{"code":"cost","type":"codeVoice"},{"text":", before any work.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero; capacities, supplies and costs fit in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; Σ capacity × |cost| fits in "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":" (checked before solving, since it bounds the"},{"type":"text","text":" "},{"type":"text","text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive"},{"type":"text","text":" "},{"type":"text","text":"supplies sum within "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Capacity"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Precondition","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","title":"Vertex","type":"topic","role":"symbol","kind":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph/minimumCostFlow(supply:capacity:cost:)":{"url":"\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostflow(supply:capacity:cost:)","abstract":[{"type":"text","text":"A least-cost flow within capacities that meets every supply, or nil when there is none."}],"title":"minimumCostFlow(supply:capacity:cost:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCostFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","k