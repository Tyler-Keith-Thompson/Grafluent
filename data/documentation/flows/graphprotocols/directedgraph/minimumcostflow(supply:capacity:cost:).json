ype":"text","text":" "},{"type":"text","text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are"},{"type":"text","text":" "},{"type":"text","text":"saturated. A self-loop carries its capacity when its cost is negative and nothing"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Capacities may be of an unsigned type, up to "},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Computed by the network simplex with block-search pivots and strongly feasible trees.","type":"text"},{"text":" ","type":"text"},{"text":"Which optimum is returned when several exist is unspecified, but the same input always","type":"text"},{"text":" ","type":"text"},{"text":"gives the same result. ","type":"text"},{"code":"supply","type":"codeVoice"},{"text":" is called once per vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, then, for","type":"text"},{"text":" ","type":"text"},{"text":"each edge in position order, ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" and then ","type":"text"},{"code":"cost","type":"codeVoice"},{"text":", before any work.","type":"text"}]},{"name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every capacity is at least zero; capacities, supplies and costs fit in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; Σ capacity × |cost| fits in "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":" (checked before solving, since it bounds the"},{"type":"text","text":" "},{"type":"text","text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive"},{"type":"text","text":" "},{"type":"text","text":"supplies sum within "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Capacity"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostflow(supply:capacity:cost:)"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCostFlow(supply:capacity:cost:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A least-cost flow within capacities that meets every supply, or nil when there is none."}],"references":{"doc://Flows/documentation/Flows":{"role":"collection","kind":"symbol","title":"Flows","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows","url":"\/documentation\/flows","abstract":[]},"doc://Flows/documentation/Flows/GraphProtocols":{"role":"collection","kind":"symbol","title":"GraphProtocols","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","url":"\/documentation\/flows\/graphprotocols","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","title":"Edges","kind":"symbol"},"doc://Flows/documentation/Flows/MinimumCostFlow":{"abstract":[{"type":"text","text":"A minimum-cost flow, returned by "},{"type":"codeVoice","code":"minimumCostFlow(supply:capacity:cost:)"},{"type":"text","text":" and"},{"type":"te