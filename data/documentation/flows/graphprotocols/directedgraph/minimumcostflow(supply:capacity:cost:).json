{"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCostFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"supply"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cost"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow","kind":"typeIdentifier","text":"MinimumCostFlow","preciseIdentifier":"s:5Flows15MinimumCostFlowV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryInteger","preciseIdentifier":"s:Sz"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Capacities may be of an unsigned type; supplies and costs are signed. Any capacity up to","type":"text"},{"text":" ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":" is fine (it is finite: only the solver’s own artificial arcs are unbounded).","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every capacity is at least zero; capacities, supplies and costs fit in"},{"type":"text","text":" "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"; Σ capacity × |cost| fits in "},{"code":"Cost","type":"codeVoice"},{"type":"text","text":" (checked before solving; it bounds the total"},{"type":"text","text":" "},{"type":"text","text":"cost, so a cost that could not be represented traps here rather than wrapping);"},{"type":"text","text":" "},{"type":"text","text":"4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" (the solver’s"},{"type":"text","text":" "},{"type":"text","text":"artificial cost, with room for its potentials and reduced costs; computed in "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"never reported); the positive supplies sum within "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Capacity","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"aside"}]}],"abstract":[{"text":"A least-cost flow meeting every supply (positive: the vertex sends that much more than it","type":"text"},{"text":" ","type":"text"},{"text":"receives; negative: a demand), within capacities (LEMON ","type":"text"},{"code":"NetworkSimplex","type":"codeVoice"},{"text":", OR-Tools","type":"text"},{"text":" ","type":"text"},{"code":"SimpleMinCostFlow","type":"codeVoice"},{"text":", NetworkX ","type":"text"},{"code":"min_cost_flow","type":"codeVoice"},{"text":" with the opposite sign), or nil when there is","type":"text"},{"text":" ","type":"text"},{"text":"none: the supplies do not sum to zero, or some set of vertices supplies more than its","type":"text"},{"text":" ","type":"text"},{"text":"out-edges carry. Costs may be negative; negative cycles are saturated (capacities are","type":"text"},{"text":" ","type":"text"},{"text":"finite). A self-loop carries its capacity when its cost is negative and nothing otherwise.","type":"text"},{"text":" ","type":"text"},{"text":"Network simplex with block-search pivots and strongly feasible trees, LEMON’s layout.","type":"text"},{"text":" ","type":"text"},{"code":"supply","type":"codeVoice"},{"text":" is called once per vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, then, for each edge in position","type":"text"},{"text":" ","type":"text"},{"text":"order, ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" and then ","type":"text"},{"code":"cost","type":"codeVoice"},{"text":", before any work. Which optimum is returned when several","type":"text"},{"text":" ","type":"text"},{"text":"exist is unspecified, but the same input always gives the same result.","type":"text"}],"variants":[{"paths":["\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostflow(supply:capacity:cost:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"minimumCostFlow(supply:capacity:cost:)","extendedModule":"GraphProtocols","modules":[{"name":"Flows","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols08DirectedA0P5FlowsE15minimumCostFlow6supply8capacity4costAD07MinimumfG0Vyxqd_0_qd_1_GSgqd__6VertexQzXE_qd_0_5Edges_5IndexQZXEqd_1_AQXEtSZRd__SzRd_0_SZRd_1_r1_lF","roleHeading":"Instance Method","symbolKind":"method","role":"symbol","remoteSource":{"fileName":"MinimumCostFlow.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/MinimumCostFlow.swift#L154"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCostFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"text":"supply","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIde