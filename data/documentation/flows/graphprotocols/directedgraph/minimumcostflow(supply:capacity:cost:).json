xQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow","text":"MinimumCostFlow","kind":"typeIdentifier","preciseIdentifier":"s:5Flows15MinimumCostFlowV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Capacities may be of an unsigned type; supplies and costs are signed. Any capacity up to","type":"text"},{"text":" ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":" is fine (it is finite: only the solver’s own artificial arcs are unbounded).","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every capacity is at least zero; capacities, supplies and costs fit in"},{"type":"text","text":" "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"; Σ capacity × |cost| fits in "},{"code":"Cost","type":"codeVoice"},{"type":"text","text":" (checked before solving; it bounds the total"},{"type":"text","text":" "},{"type":"text","text":"cost, so a cost that could not be represented traps here rather than wrapping);"},{"type":"text","text":" "},{"type":"text","text":"4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" (the solver’s"},{"type":"text","text":" "},{"type":"text","text":"artificial cost, with room for its potentials and reduced costs; computed in "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"never reported); the positive supplies sum within "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Capacity","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"Precondition","style":"note","type":"aside"}]}],"abstract":[{"type":"text","text":"A least-cost flow meeting every supply (positive: the vertex sends that much more than it"},{"type":"text","text":" "},{"type":"text","text":"receives; negative: a demand), within capacities (LEMON "},{"type":"codeVoice","code":"NetworkSimplex"},{"type":"text","text":", OR-Tools"},{"type":"text","text":" "},{"type":"codeVoice","code":"SimpleMinCostFlow"},{"type":"text","text":", NetworkX "},{"type":"codeVoice","code":"min_cost_flow"},{"type":"text","text":" with the opposite sign), or nil when there is"},{"type":"text","text":" "},{"type":"text","text":"none: the supplies do not sum to zero, or some set of vertices supplies more than its"},{"type":"text","text":" "},{"type":"text","text":"out-edges carry. Costs may be negative; negative cycles are saturated (capacities are"},{"type":"text","text":" "},{"type":"text","text":"finite). A self-loop carries its capacity when its cost is negative and nothing otherwise."},{"type":"text","text":" "},{"type":"text","text":"Network simplex with block-search pivots and strongly feasible trees, LEMON’s layout."},{"type":"text","text":" "},{"type":"codeVoice","code":"supply"},{"type":"text","text":" is called once per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, then, for each edge in position"},{"type":"text","text":" "},{"type":"text","text":"order, "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" and then "},{"type":"codeVoice","code":"cost"},{"type":"text","text":", before any work. Which optimum is returned when several"},{"type":"text","text":" "},{"type":"text","text":"exist is unspecified, but the same input always gives the same result."}],"variants":[{"paths":["\/documentation\/flows\/graphprotocols\/directedgraph\/minimumcostflow(supply:capacity:cost:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph"]]},"metadata":{"remoteSource":{"fileName":"MinimumCostFlow.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/MinimumCostFlow.swift#L154"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCostFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"supply"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"