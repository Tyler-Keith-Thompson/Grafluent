umCostFlowV","kind":"typeIdentifier","text":"MinimumCostFlow","identifier":"doc:\/\/Flows\/documentation\/Flows\/MinimumCostFlow"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SZ","kind":"typeIdentifier","text":"SignedInteger"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sz","kind":"typeIdentifier","text":"BinaryInteger"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SZ","kind":"typeIdentifier","text":"SignedInteger"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A positive supply is how much more the vertex sends than it receives; a negative one is a","type":"text"},{"text":" ","type":"text"},{"text":"demand. There is no flow when the supplies do not sum to zero or some set of vertices","type":"text"},{"text":" ","type":"text"},{"text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are","type":"text"},{"text":" ","type":"text"},{"text":"saturated. A self-loop carries its capacity when its cost is negative and nothing","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Capacities may be of an unsigned type, up to ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Computed by the network simplex with block-search pivots and strongly feasible trees."},{"type":"text","text":" "},{"type":"text","text":"Which optimum is returned when several exist is unspecified, but the same input always"},{"type":"text","text":" "},{"type":"text","text":"gives the same result. "},{"code":"supply","type":"codeVoice"},{"type":"text","text":" is called once per vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, then, for"},{"type":"text","text":" "},{"type":"text","text":"each edge in position order, "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" and then "},{"code":"cost","type":"codeVoice"},{"type":"text","text":", before any work."}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"text":"Every capacity is at least zero; capacities, supplies and costs fit in","type":"text"},{"text":" ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; Σ capacity × |cost| fits in ","type":"text"},{"code":"Cost","type":"codeVoice"},{"text":" (checked before solving, since it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (the","type":"text"},{"text":" ","type":"text"},{"text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive","type":"text"},{"text":" ","type":"text"},{"text":"supplies sum within ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Capacity","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols","doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/DirectedGraph\/minimumCostFlow(supply:capacity:cost:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/flows\/graphprotocols\/dire