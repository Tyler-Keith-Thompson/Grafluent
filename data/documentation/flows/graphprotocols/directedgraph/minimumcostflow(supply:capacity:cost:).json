:" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A positive supply is how much more the vertex sends than it receives; a negative one is a"},{"type":"text","text":" "},{"type":"text","text":"demand. There is no flow when the supplies do not sum to zero or some set of vertices"},{"type":"text","text":" "},{"type":"text","text":"supplies more than its out-edges carry. Costs may be negative, and negative cycles are"},{"type":"text","text":" "},{"type":"text","text":"saturated. A self-loop carries its capacity when its cost is negative and nothing"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Capacities may be of an unsigned type, up to "},{"type":"codeVoice","code":"Int.max"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Computed by the network simplex with block-search pivots and strongly feasible trees."},{"type":"text","text":" "},{"type":"text","text":"Which optimum is returned when several exist is unspecified, but the same input always"},{"type":"text","text":" "},{"type":"text","text":"gives the same result. "},{"code":"supply","type":"codeVoice"},{"type":"text","text":" is called once per vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, then, for"},{"type":"text","text":" "},{"type":"text","text":"each edge in position order, "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" and then "},{"code":"cost","type":"codeVoice"},{"type":"text","text":", before any work."}]},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Every capacity is at least zero; capacities, supplies and costs fit in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":"; Σ capacity × |cost| fits in ","type":"text"},{"type":"codeVoice","code":"Cost"},{"text":" (checked before solving, since it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" (the","type":"text"},{"text":" ","type":"text"},{"text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive","type":"text"},{"text":" ","type":"text"},{"text":"supplies sum within ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Capacity"},{"text":".","type":"text"}]}],"style":"note"}],"kind":"content"}],"references":{"doc://Flows/documentation/Flows/GraphProtocols":{"kind":"symbol","role":"collection","type":"topic","title":"GraphProtocols","url":"\/documentation\/flows\/graphprotocols","abstract":[],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"type":"topic","abstract":[],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"role":"symbol","title":"Edges"},"doc://Flows/documentation/Flows/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","abstract":[],"url":"\/documentation\/flows\/graphprotocols\/directedgraph","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"identifier":"doc:\/\/Flows\/documentation