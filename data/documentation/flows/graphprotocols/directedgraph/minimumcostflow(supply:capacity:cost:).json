is returned when several exist is unspecified, but the same input always","type":"text"},{"text":" ","type":"text"},{"text":"gives the same result. ","type":"text"},{"code":"supply","type":"codeVoice"},{"text":" is called once per vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, then, for","type":"text"},{"text":" ","type":"text"},{"text":"each edge in position order, ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" and then ","type":"text"},{"code":"cost","type":"codeVoice"},{"text":", before any work.","type":"text"}]},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every capacity is at least zero; capacities, supplies and costs fit in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; Σ capacity × |cost| fits in "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":" (checked before solving, since it bounds the"},{"type":"text","text":" "},{"type":"text","text":"total cost); 4(n + 1)(the greatest |cost| of a non-loop edge + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the"},{"type":"text","text":" "},{"type":"text","text":"solver’s artificial cost, with room for its potentials and reduced costs); the positive"},{"type":"text","text":" "},{"type":"text","text":"supplies sum within "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Capacity"},{"type":"text","text":"."}]}],"style":"note"}],"kind":"content"}],"metadata":{"modules":[{"name":"Flows","relatedModules":["GraphProtocols"]}],"symbolKind":"method","remoteSource":{"fileName":"MinimumCostFlow.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/MinimumCostFlow.swift#L172"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCostFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"generi