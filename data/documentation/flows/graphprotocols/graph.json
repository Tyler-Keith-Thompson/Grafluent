otocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","title":"edgeConnectivity(from:to:)","abstract":[{"type":"text","text":"The most edge-disjoint paths between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}]},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumVertexCut()":{"abstract":[{"type":"text","text":"A minimum vertex cut, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, by Even’s pair order; the vertices after the"},{"type":"text","text":" "},{"type":"text","text":"first for a complete graph; empty when κ = 0."}],"url":"\/documentation\/flows\/graphprotocols\/graph\/minimumvertexcut()","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumVertexCut()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumVertexCut","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"title":"minimumVertexCut()","kind":"symbol","type":"topic"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumCut(capacity:)":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","type":"topic","role":"symbol","url":"\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cut","kind":"typeIdentifier","preciseIdentifier":"s:5Flows3CutV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","title":"minimumCut(capacity:)","abstract":[{"type":"text","text":"A global minimum cut, over "},{"type":"codeVoice","code":"directed"},{"type":"text","text":": the least capacity of the edges between a nonempty"},{"type":"text","text":" "},{"type":"text","text":"proper vertex set and the rest, the set holding the first vertex as the source side; nil"},{"type":"text","text":" "},{"type":"text","text":"below two vertices. By Nagamochi–Ibaraki (LEMON "},{"type":"codeVoice","code":"NagamochiIbaraki"},{"type":"text","text":"; the same value as"},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"type":"codeVoice","code":"stoer_wagner"},{"type":"text","text":", Boost "},{"type":"codeVoice","code":"stoer_wagner_min_cut"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"stoer_wagner_min_cut"},{"type":"text","text":" "},{"type":"text","text":"and igraph "},{"type":"codeVoice","code":"mincut()"},{"type":"text","text":"): maximum adjacency orderings that contract every edge whose scanned"},{"type":"text","text":" "},{"type":"text","text":"connection is at least the best cut so far, so later phases run on smaller graphs. Which"},{"type":"text","text":" "},{"type":"text","text":"minimum cut is returned when several exist is not specified, but the same input always"},{"type":"text","text":" "},{"type":"text","text":"gives the same cut. When the edges of positive capacity do not connect the graph, the cut"},{"type":"text","text":" "},{"type":"text","text":"of value zero whose source side is the first vertex’s component, with every crossing edge"},{"type":"text","text":" "},{"type":"text","text":"(all of capacity zero). Parallel capacities add; self-loops are ignored. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per non-loop edge, in position order, before any work (self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"asked). O(nm log n) in the worst case, far less when contractions are many."}]}}}