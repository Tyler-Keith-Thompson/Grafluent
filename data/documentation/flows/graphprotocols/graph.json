xt":"maximumFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Flow","preciseIdentifier":"s:5Flows4FlowV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/maximumFlow(from:to:capacity:)","type":"topic","abstract":[{"type":"text","text":"A maximum flow from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"sink"},{"type":"text","text":" over "},{"type":"codeVoice","code":"directed"},{"type":"text","text":", by push–relabel (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"DirectedGraph.maximumFlow(from:to:capacity:)"},{"type":"text","text":"). Each edge is one residual pair with its"},{"type":"text","text":" "},{"type":"text","text":"capacity both ways."}],"url":"\/documentation\/flows\/graphprotocols\/graph\/maximumflow(from:to:capacity:)"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumCut(capacity:)":{"kind":"symbol","abstract":[{"text":"A global minimum cut, over ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":": the least capacity of the edges between a nonempty","type":"text"},{"text":" ","type":"text"},{"text":"proper vertex set and the rest, the set holding the first vertex as the source side; nil","type":"text"},{"text":" ","type":"text"},{"text":"below two vertices. By Nagamochi–Ibaraki (LEMON ","type":"text"},{"code":"NagamochiIbaraki","type":"codeVoice"},{"text":"; the same value as","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX ","type":"text"},{"code":"stoer_wagner","type":"codeVoice"},{"text":", Boost ","type":"text"},{"code":"stoer_wagner_min_cut","type":"codeVoice"},{"text":", rustworkx ","type":"text"},{"code":"stoer_wagner_min_cut","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and igraph ","type":"text"},{"code":"mincut()","type":"codeVoice"},{"text":"): maximum adjacency orderings that contract every edge whose scanned","type":"text"},{"text":" ","type":"text"},{"text":"connection is at least the best cut so far, so later phases run on smaller graphs. Which","type":"text"},{"text":" ","type":"text"},{"text":"minimum cut is returned when several exist is not specified, but the same input always","type":"text"},{"text":" ","type":"text"},{"text":"gives the same cut. When the edges of positive capacity do not connect the graph, the cut","type":"text"},{"text":" ","type":"text"},{"text":"of value zero whose source side is the first vertex’s component, with every crossing edge","type":"text"},{"text":" ","type":"text"},{"text":"(all of capacity zero). Parallel capacities add; self-loops are ignored. ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"called once per non-loop edge, in position order, before any work (self-loops are never","type":"text"},{"text":" ","type":"text"},{"text":"asked). O(nm log n) in the worst case, far less when contractions are many.","type":"text"}],"title":"minimumCut(capacity:)","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","type":"topic","url":"\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Flows3CutV","kind":"typeIdentifier","text":"Cut"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">?"}]},"doc://Flows/documentation/Flows/GraphProtocols/Graph/edmondsKarpMaximumFlow(from:to:capacity:)":{"title":"edmondsKarpMaximumFlow(from:to:capacity:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"edmondsKarpMaximumFlow"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kin