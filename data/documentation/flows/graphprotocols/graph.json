","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per non-loop edge, in position order, before any work (self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"asked). O(nm log n) in the worst case, far less when contractions are many."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows3CutV","text":"Cut","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","kind":"symbol","title":"minimumCut(capacity:)"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/edmondsKarpMaximumFlow(from:to:capacity:)":{"title":"edmondsKarpMaximumFlow(from:to:capacity:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edmondsKarpMaximumFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"pre