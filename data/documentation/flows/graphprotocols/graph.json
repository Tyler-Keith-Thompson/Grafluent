rtexCut(from:to:)","abstract":[{"text":"The minimum source–target vertex cut nearest ","type":"text"},{"type":"codeVoice","code":"target"},{"text":", in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, or nil when an","type":"text"},{"text":" ","type":"text"},{"text":"edge joins them.","type":"text"}],"role":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/vertexDisjointPaths(from:to:)":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/vertexDisjointPaths(from:to:)","type":"topic","title":"vertexDisjointPaths(from:to:)","url":"\/documentation\/flows\/graphprotocols\/graph\/vertexdisjointpaths(from:to:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertexDisjointPaths"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> ["},{"preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">."},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV5EdgesV","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV5EdgesV5IndexV","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">]"}],"abstract":[{"type":"text","text":"A largest set of internally vertex-disjoint paths between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":", over"},{"type":"text","text":" "},{"type":"codeVoice","code":"directed"},{"type":"text","text":": as many as "},{"type":"codeVoice","code":"vertexConnectivity(from:to:)"},{"type":"text","text":"; an edge between them is one path."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"codeVoice","code":"DirectedGraph.vertexDisjointPaths(from:to:)"},{"type":"text","text":"."}]},"doc://Flows/documentation/Flows/GraphProtocols/Graph/gomoryHuTree(capacity:)":{"kind":"symbol","title":"gomoryHuTree(capacity:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gomoryHuTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"GomoryHuTree","kind":"typeIdentifier","preciseIdentifier":"s:5Flows12GomoryHuTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/flows\/graphprotocols\/graph\/gomoryhutree(capacity:)","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/gomoryHuTree(capacity:)","abstract":[{"text":"A Gomory–Hu cut tree: every pair’s minimum cut value is the least capacity on its tree","type":"text"},{"text":" ","type":"text"},{"text":"path, and every tree edge splits the vertices into a minimum cut between its ends.","type":"text"},{"text":" ","type":"text"},{"text":"Gusfield’s algorithm with the canonical cut, vertices in order, rooted at the first: the","type":"text"},{"text":" ","type":"text"},{"text":"same tree as NetworkX’s ","type":"text"},{"code":"gomory_hu_tree","type":"codeVoice"},{"text":". Disconnected graphs get zero-capacity tree","type":"text"},{"text":" ","type":"text"},{"text":"edges. nil for the empty graph. n − 1 maximum flows on one residual network, by","type":"text"},{"text":" ","type":"text"},{"text":"push–relabel’s first phase. ","type":"text"},{"code":"capacity","type":"codeVoice"},{"text":" is called once per non-loop edge, in position","type":"text"},{"text":" ","type":"text"},{"text":"order, before any work.","type":"text"}],"role":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumCut(capacity:)":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","type":"topic","url":"\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)","kind":"symbol","title":"minimumCut(capacity:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cut","kind":"typeIdentifier","preciseIdentifier":"s:5Flows3CutV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"abstract":[{"type":"text","text":"A global minimum cut, over "},{"type":"codeVoice","code":"directed"},{"type":"text","text":": the least capacity of the edges between a nonempty"},{"type":"text","text":" "},{"type":"text","text":"proper vertex set and the rest, the set holding the first vertex as the source side; nil"},{"type":"text","text":" "},{"type":"text","text":"below two vertices. By Nagamochi–Ibaraki (LEMON "},{"code":"NagamochiIbaraki","type":"codeVoice"},{"type":"text","text":"; the same value as"},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"code":"stoer_wagner","type":"codeVoice"},{"type":"text","text":", Boost "},{"code":"stoer_wagner_min_cut","type":"codeVoice"},{"type":"text","text":", rustworkx "},{"code":"stoer_wagner_min_cut","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and igraph "},{"code":"mincut()","type":"codeVoice"},{"type":"text","text":"): maximum adjacency orderings that contract every edge whose scanned"},{"type":"text","text":" "},{"type":"text","text":"connection is at least the best cut so far, so later phases run on smaller graphs. Which"},{"type":"text","text":" "},{"type":"text","text":"minimum cut is returned when several exist is not specified, but the same input always"},{"type":"text","text":" "},{"type":"text","text":"gives the same cut. When the edges of positive capacity do not connect the graph, the cut"},{"type":"text","text":" "},{"type":"text","text":"of value zero whose source side is the first vertex’s component, with every crossing edge"},{"type":"text","text":" "},{"type":"text","text":"(all of capacity zero). Parallel capacities add; self-loops are ignored. "},{"code":"capacity","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per non-loop edge, in position order, before any work (self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"asked). O(nm log n) in the worst case, far less when contractions are many."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","title":"Graph","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directed","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/dinicMaximumFlow(from:to:capacity:)":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/dinicMaximumFlow(from:to:capacity:)","type":"topic","kind":"symbol","title":"dinicMaximumFlow(from:to:capacity:)","url":"\/documentation\/flows\/graphprotocols\/graph\/dinicmaximumflow(from:to:capacity:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dinicMaximumFlow","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"f