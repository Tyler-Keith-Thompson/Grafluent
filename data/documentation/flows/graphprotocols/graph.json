":"text"},{"text":"asked). O(nm log n) in the worst case, far less when contractions are many.","type":"text"}],"url":"\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/edgeDisjointPaths(from:to:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeDisjointPaths","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV5EdgesV","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV5EdgesV5IndexV","text":"Index","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/edgeDisjointPaths(from:to:)","kind":"symbol","title":"edgeDisjointPaths(from:to:)","abstract":[{"type":"text","text":"A largest set of edge-disjoint paths between "},{"type":"codeVoice","co