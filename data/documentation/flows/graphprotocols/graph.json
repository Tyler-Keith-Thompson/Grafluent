t"},{"text":"called once per non-loop edge, in position order, before any work (self-loops are never","type":"text"},{"text":" ","type":"text"},{"text":"asked). O(nm log n) in the worst case, far less when contractions are many.","type":"text"}],"title":"minimumCut(capacity:)","role":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCut","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"capacity","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Flows3CutV","text":"Cut","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","type":"topic"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/vertexConnectivity(from:to:)":{"url":"\/documentation\/flows\/graphprotocols\/graph\/vertexconnectivity(from:to:)","type":"topic","abstract":[{"type":"text","text":"The most internally vertex-disjoint paths between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":"; an edge between"},{"type":"text","text":" "},{"type":"text","text":"them counts as one path."}],"title":"vertexConnectivity(from:to:)","kind":"symbol","identifier"