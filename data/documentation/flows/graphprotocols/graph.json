s one residual pair with its"},{"type":"text","text":" "},{"type":"text","text":"capacity both ways."}],"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/maximumFlow(from:to:capacity:)"},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumCut(capacity:)":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumCut(capacity:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumCut"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Flows3CutV","kind":"typeIdentifier","text":"Cut"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">?"}],"type":"topic","url":"\/documentation\/flows\/graphprotocols\/graph\/minimumcut(capacity:)","title":"minimumCut(capacity:)","abstract":[{"type":"text","text":"A global minimum cut, over "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":": the least capacity of the edges between a nonempty"},{"type":"text","text":" "},{"type":"text","text":"proper vertex set and the rest, the set holding the first vertex as the source side; nil"},{"type":"text","text":" "},{"type":"text","text":"below two vertices. By Nagamochi–Ibaraki (LEMON "},{"type":"codeVoice","code":"NagamochiIbaraki"},{"type":"text","text":"; the same value as"},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"type":"codeVoice","code":"stoer_wagner"},{"type":"text","text":", Boost "},{"type":"codeVoice","code":"stoer_wagner_min_cut"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"stoer_wagner_min_cut"},{"type":"text","text":" "},{"type":"text","text":"and igraph "},{"type":"codeVoice","code":"mincut()"},{"type":"text","text":"): maximum adjacency orderings that contract every edge whose scanned"},{"type":"text","text":" "},{"type":"text","text":"connection is at least the best cut so far, so later phases run on smaller graphs. Which"},{"type":"text","text":" "},{"type":"text","text":"minimum cut is returned when several exist is not specified, but the same input always"},{"type":"text","text":" "},{"type":"text","text":"gives the same cut. When the edges of positive capacity do not connect the graph, the cut"},{"type":"text","text":" "},{"type":"text","text":"of value zero whose source side is the first vertex’s component, with every crossing edge"},{"type":"text","text":" "},{"type":"text","text":"(all of capacity zero). Parallel capacities add; self-loops are ignored. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per non-loop edge, in position order, before any work (self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"asked). O(nm log n) in the worst case, far less when contractions are many."}]},"doc://Flows/documentation/Flows/GraphProtocols/Graph/minimumVertexCut()":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/GraphProtocols\/Graph\/minimumVertexCut()","url":"\/documentation\/flows\/graphprotocols\/graph\/minimumvertexcut()","abstract":[{"text":"A minimum vertex cut, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, by Even’s pair order; the vertices after the","type":"text"