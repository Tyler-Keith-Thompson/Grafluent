m","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV5EdgesV","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV5EdgesV5IndexV","text":"Index","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/flows\/graphprotocols\/graph\/vertexdisjointpaths(from:to:)","abstract":[{"text":"A largest set of internally vertex-disjoint paths between ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target"},{"text":", over","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"directed"},{"text":": as many as ","type":"text"},{"type":"codeVoice","code":"vertexConnectivity(from:to:)"},{"text":"; an edge between them is one path.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"codeVoice","code":"DirectedGraph.vertexDisjointPaths(from:to:)"},{"text":".","type":"text