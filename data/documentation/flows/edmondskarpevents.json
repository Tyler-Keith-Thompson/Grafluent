{"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows"]]},"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/makeIterator()"]},{"anchor":"Type-Aliases","title":"Type Aliases","generated":true,"identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Element"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Sequence-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/edmondskarpevents"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Flows\/ST"]}],"sections":[],"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The Edmonds–Karp algorithm as a sequence of "},{"code":"EdmondsKarpEvent","type":"codeVoice"},{"type":"text","text":"s, pulled one at a time."}],"metadata":{"roleHeading":"Structure","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/EdmondsKarpEvents.swift#L50","fileName":"EdmondsKarpEvents.swift"},"externalID":"s:5Flows17EdmondsKarpEventsV","modules":[{"name":"Flows"}],"title":"EdmondsKarpEvents","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvents","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"EdmondsKarpEvents"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Edmonds–Karp, rather than Dinic, because each of its steps is one picture: a shortest path in"},{"type":"text","text":" "},{"type":"text","text":"the residual network and the flow sent along it. Dinic’s blocking flows interleave advancing,"},{"type":"text","text":" "},{"type":"text","text":"retreating and pruning within a level graph, which do not read as separate steps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Making the sequence numbers the vertices and reads the capacities as"},{"type":"text","text":" "},{"type":"codeVoice","code":"edmondsKarpMaximumFlow(from:to:capacity:)"},{"type":"text","text":" does; each iterator builds its own residual"},{"type":"text","text":" "},{"type":"text","text":"network and runs that call’s searches, in the same order, so the flows it sends are that"},{"type":"text","text":" "},{"type":"text","text":"call’s: the pushes less the cancellations on each edge are its "},{"type":"codeVoice","code":"flow(ofEdgeAt:)"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"bottlenecks add up to its "},{"type":"codeVoice","code":"value"},{"type":"text","text":". The sequence holds no copy of the graph; its positions stay"},{"type":"text","text":" "},{"type":"text","text":"valid until the graph is mutated. Stopping the loop stops the algorithm."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://Flows/documentation/Flows/EdmondsKarpEvents/Sequence-Implementations":{"identifier":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Sequence-Implementations","kind":"article","type":"topic","url":"\/documentation\/flows\/edmondskarpevents\/sequence-implementations","abstract":[],"role":"collectionGroup","title":"Sequence Implementations"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"title":"DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"doc://Flows/ST":{"title":"Swift.Sequence","identifier":"doc:\/\/Flows\/ST","type":"unresolvable"},"doc://Flows/documentation/Flows/EdmondsKarpEvents/Iterator":{"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator","title":"EdmondsKarpEvents.Iterator","url":"\/documentation\/flows\/edmondskarpevents\/iterator","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text"