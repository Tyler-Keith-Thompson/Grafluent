{"kind":"symbol","identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"The Edmonds–Karp algorithm as a sequence of "},{"type":"codeVoice","code":"EdmondsKarpEvent"},{"type":"text","text":"s, pulled one at a time."}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows"]]},"metadata":{"roleHeading":"Structure","externalID":"s:5Flows17EdmondsKarpEventsV","remoteSource":{"fileName":"EdmondsKarpEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/EdmondsKarpEvents.swift#L50"},"role":"symbol","modules":[{"name":"Flows"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvents"}],"title":"EdmondsKarpEvents","navigatorTitle":[{"text":"EdmondsKarpEvents","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Edmonds–Karp, rather than Dinic, because each of its steps is one picture: a shortest path in","type":"text"},{"text":" ","type":"text"},{"text":"the residual network and the flow sent along it. Dinic’s blocking flows interleave advancing,","type":"text"},{"text":" ","type":"text"},{"text":"retreating and pruning within a level graph, which do not read as separate steps.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Making the sequence numbers the vertices and reads the capacities as","type":"text"},{"text":" ","type":"text"},{"code":"edmondsKarpMaximumFlow(from:to:capacity:)","type":"codeVoice"},{"text":" does; each iterator builds its own residual","type":"text"},{"text":" ","type":"text"},{"text":"network and runs that call’s searches, in the same order, so the flows it sends are that","type":"text"},{"text":" ","type":"text"},{"text":"call’s: the pushes less the cancellations on each edge are its ","type":"text"},{"code":"flow(ofEdgeAt:)","type":"codeVoice"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"bottlenecks add up to its ","type":"text"},{"code":"value","type":"codeVoice"},{"text":". The sequence holds no copy of the graph; its positions stay","type":"text"},{"text":" ","type":"text"},{"text":"valid until the graph is mutated. Stopping the loop stops the algorithm.","type":"text"}]}]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Flows\/ST"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/edmondskarpevents"]}],"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator"],"anchor"