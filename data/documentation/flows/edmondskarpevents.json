ind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Edmonds–Karp, rather than Dinic, because each of its steps is one picture: a shortest path in"},{"type":"text","text":" "},{"type":"text","text":"the residual network and the flow sent along it. Dinic’s blocking flows interleave advancing,"},{"type":"text","text":" "},{"type":"text","text":"retreating and pruning within a level graph, which do not read as separate steps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Making the sequence numbers the vertices and reads the capacities as"},{"type":"text","text":" "},{"type":"codeVoice","code":"edmondsKarpMaximumFlow(from:to:capacity:)"},{"type":"text","text":" does; each iterator builds its own residual"},{"type":"text","text":" "},{"type":"text","text":"network and runs that call’s searches, in the same order, so the flows it sends are that"},{"type":"text","text":" "},{"type":"text","text":"call’s: the pushes less the cancellations on each edge are its "},{"type":"codeVoice","code":"flow(ofEdgeAt:)"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"bottlenecks add up to its "},{"type":"codeVoice","code":"value"},{"type":"text","text":". The sequence holds no copy of the graph; its positions stay"},{"type":"text","text":" "},{"type":"text","text":"valid until the graph is mutated. Stopping the loop stops the algorithm."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents","interfaceLanguage":"swift"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","title":"DirectedGraph","kind":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"doc://Flows/documentation/Flows/EdmondsKarpEvents/Iterator":{"kind":"symbol","title":"EdmondsKarpEvents.Iterator","identifier":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator","role":"symbol","navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"abstract":[],"type":"topic","url":"\/documentation\/flows\/edmondskarpevents\/iterator","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}]},"doc://Flows/documentation/Flows/EdmondsKarpEvents":{"url":"\/documentation\/flows\/edmondskarpevents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvents","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"The Edmonds–Karp algorithm as a sequence of ","type":"text"},{