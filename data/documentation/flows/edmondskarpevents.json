{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The Edmonds–Karp algorithm as a sequence of "},{"type":"codeVoice","code":"EdmondsKarpEvent"},{"type":"text","text":"s, pulled one at a time."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents"},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edmonds–Karp, rather than Dinic, because each of its steps is one picture: a shortest path in"},{"type":"text","text":" "},{"type":"text","text":"the residual network and the flow sent along it. Dinic’s blocking flows interleave advancing,"},{"type":"text","text":" "},{"type":"text","text":"retreating and pruning within a level graph, which do not read as separate steps."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Making the sequence numbers the vertices and reads the capacities as"},{"type":"text","text":" "},{"type":"codeVoice","code":"edmondsKarpMaximumFlow(from:to:capacity:)"},{"type":"text","text":" does; each iterator builds its own residual"},{"type":"text","text":" "},{"type":"text","text":"network and runs that call’s searches, in the same order, so the flows it sends are that"},{"type":"text","text":" "},{"type":"text","text":"call’s: the pushes less the cancellations on each edge are its "},{"type":"codeVoice","code":"flow(ofEdgeAt:)"},{"type":"text","text":", and the"},{"type":"text","text":" "},{"type":"text","text":"bottlenecks add up to its "},{"type":"codeVoice","code":"value"},{"type":"text","text":". The sequence holds no copy of the graph; its positions stay"},{"type":"text","text":" "},{"type":"text","text":"valid until the graph is mutated. Stopping the loop stops the algorithm."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/edmondskarpevents"]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"EdmondsKarpEvents"}],"modules":[{"name":"Flows"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/EdmondsKarpEvents.swift#L50","fileName":"EdmondsKarpEvents.swift"},"symbolKind":"struct","roleHeading":"Structure","externalID":"s:5Flows17EdmondsKarpEventsV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvents"}],"title":"EdmondsKarpEvents"},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator"],"generated":true,"anchor":"Structures"},{"title":"Instance Methods","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/makeIterator()