{"abstract":[{"text":"The Edmonds–Karp algorithm as a sequence of ","type":"text"},{"code":"EdmondsKarpEvent","type":"codeVoice"},{"text":"s, pulled one at a time.","type":"text"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Flows\/ST"]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:5Flows17EdmondsKarpEventsV","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvents"}],"remoteSource":{"fileName":"EdmondsKarpEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/EdmondsKarpEvents.swift#L50"},"title":"EdmondsKarpEvents","roleHeading":"Structure","modules":[{"name":"Flows"}],"role":"symbol","navigatorTitle":[{"text":"EdmondsKarpEvents","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/edmondskarpevents"]}],"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/makeIterator()"]},{"anchor":"Type-Aliases","generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Element"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Sequence-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvents"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier","text":"DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Edmonds–Karp, rather than Dinic, because each of its steps is one picture: a shortest path in"},{"type":"text","text":" "},{"type":"text","text":"the residual network and the flow sent along it. Dinic’s blocking flows interleave advancing,"},{"type":"text","text":" "},{"type":"text","text":"retreating and pruning within a level graph, which do not read as separate steps."}],"type":"paragraph"},{"inlineContent":[{"text":"Making the sequence numbers the vertices and reads the capacities as","type":"text"},{"text":" ","type":"text"},{"code":"edmondsKarpMaximumFlow(from:to:capacity:)","type":"codeVoice"},{"text":" does; each iterator builds its own residual","type":"text"},{"text":" ","type":"text"},{"text":"network and runs that call’s searches, in the same order, so the flows it sends are that","type":"text"},{"text":" ","type":"text"},{"text":"call’s: the pushes less the cancellations on each edge are its ","type":"text"},{"code":"flow(ofEdgeAt:)","type":"codeVoice"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"bottlenecks add up to its ","type":"text"},{"code":"value","type":"codeVoice"},{"text":". The sequence holds no copy of the graph; its positions stay","type":"text"},{"text":" ","type":"text"},{"text":"valid until the graph is mutated. Stopping the loop stops the algorithm.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents","interfaceLanguage":"swift"},"references":{"doc://Flows/documentation/Flows/EdmondsKarpEvents/Iterator":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"title":"EdmondsKarpEvents.Iterator","navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator","url":"\/documentation\/flows\/edmondskarpevents\/iterator","abstract":[],"kind":"symbol"},"doc://Flows/ST":{"type":"unresolvable","identifier":"doc:\/\/Flows\/ST","title":"Swift.Sequence"},"doc://Flows/documentation/Flows/EdmondsKarpEvents/makeIterator()":{"url":"\/documentation\/flows\/edmondskarpevents\/makeiterator()","type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/makeIterator()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Flows17EdmondsKarpEventsV","text":"EdmondsKarpEvents","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:5Flows17EdmondsKarpEventsV8IteratorV","text":"Iterator","kind":"typeIdentifier"}],"title":"makeIterator()","role":"symbol","abstract":[]},"doc://Flows/documentation/Flows/EdmondsKarpEvents/Element":{"identifier":