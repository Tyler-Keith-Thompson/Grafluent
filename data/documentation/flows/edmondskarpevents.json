{"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows"]]},"abstract":[{"type":"text","text":"The Edmonds–Karp algorithm as a sequence of "},{"type":"codeVoice","code":"EdmondsKarpEvent"},{"type":"text","text":"s, pulled one at a time."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edmonds–Karp, rather than Dinic, because each of its steps is one picture: a shortest path in"},{"type":"text","text":" "},{"type":"text","text":"the residual network and the flow sent along it. Dinic’s blocking flows interleave advancing,"},{"type":"text","text":" "},{"type":"text","text":"retreating and pruning within a level graph, which do not read as separate steps."}]},{"type":"paragraph","inlineContent":[{"text":"Making the sequence numbers the vertices and reads the capacities as","type":"text"},{"text":" ","type":"text"},{"code":"edmondsKarpMaximumFlow(from:to:capacity:)","type":"codeVoice"},{"text":" does; each iterator builds its own residual","type":"text"},{"text":" ","type":"text"},{"text":"network and runs that call’s searches, in the same order, so the flows it sends are that","type":"text"},{"text":" ","type":"text"},{"text":"call’s: the pushes less the cancellations on each edge are its ","type":"text"},{"code":"flow(ofEdgeAt:)","type":"codeVoice"},{"text":", and the","type":"text"},{"text":" ","type":"text"},{"text":"bottlenecks add up to its ","type":"text"},{"code":"value","type":"codeVoice"},{"text":". The sequence holds no copy of the graph; its positions stay","type":"text"},{"text":" ","type":"text"},{"text":"valid until the graph is mutated. Stopping the loop stops the algorithm.","type":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"EdmondsKarpEvents"}],"roleHeading":"Structure","remoteSource":{"fileName":"EdmondsKarpEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/EdmondsKarpEvents.swift#L50"},"modules":[{"name":"Flows"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvents","kind":"identifier"}],"title":"EdmondsKarpEvents","externalID":"s:5Flows17EdmondsKarpEventsV","role":"symbol"},"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Iterator"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/makeIterator()"],"generated":true},{"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Element"],"generated":true},{"title":"Default Implementations",