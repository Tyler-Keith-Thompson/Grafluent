he graph is mutated. Stopping the loop stops the algorithm.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The Edmonds–Karp algorithm as a sequence of "},{"type":"codeVoice","code":"EdmondsKarpEvent"},{"type":"text","text":"s, pulled one at a time."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Flows\/ST"],"title":"Conforms To","type":"conformsTo"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/edmondskarpevents"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol"},"doc://Flows/documentation/Flows/EdmondsKarpEvents/Element":{"navigatorTitle":[{"kind":"identifier","text":"Element"}],"type":"topic","identifier":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvents\/Element","kind":"symbol","abstract":[],"title":"EdmondsKarpEvents.Element","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"role":"symbol","url":"\/documentation\/flows\/edmondskarpevents\/element"},"doc://Flows/documentation/Flows":{"title":"Flows","url":"\/documentation\/flows","type":"topic","kind":"symbol","identifier":"doc:\/\/Flows\/documentation\/Flows","abstract":[],"role":"collection"},"doc://Flows/documentation/Flows/EdmondsKarpEvents/makeIterator()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kin