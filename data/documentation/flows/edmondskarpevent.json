r,"},{"type":"text","text":" "},{"type":"text","text":"finds a shortest augmenting path from the source to the sink, stopping when the sink is"},{"type":"text","text":" "},{"type":"text","text":"discovered. The path is reported with its bottleneck, the smallest residual along it; then the"},{"type":"text","text":" "},{"type":"text","text":"bottleneck is sent along it one edge at a time, from the source end: pushed along an edge with"},{"type":"text","text":" "},{"type":"text","text":"room to spare, or cancelled on an edge whose flow the path runs against. When the sink cannot"},{"type":"text","text":" "},{"type":"text","text":"be reached the flow is maximum and nothing more is reported."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows"]]},"topicSections":[{"identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/augmentingPath(_:bottleneck:)","doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/cancel(_:amount:)","doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/push(_:amount:)"],"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true},{"identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/CustomStringConvertible-Implementations","doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"abstract":[{"text":"What the Edmonds–Karp algorithm reports, in order.","type":"text"}],"references":{"doc://Flows/documentation/Flows/EdmondsKarpEvent/push(_:amount:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"push"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":", "},{"kind":"externalParam","text":"amount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Capacity"},{"kind":"text","text":")"}],"titl