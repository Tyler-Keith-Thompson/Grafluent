"text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Capacity"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each round a breadth-first search over the residual network, its rows in edge-position order,"},{"type":"text","text":" "},{"type":"text","text":"finds a shortest augmenting path from the source to the sink, stopping when the sink is"},{"type":"text","text":" "},{"type":"text","text":"discovered. The path is reported with its bottleneck, the smallest residual along it; then the"},{"type":"text","text":" "},{"type":"text","text":"bottleneck is sent along it one edge at a time, from the source end: pushed along an edge with"},{"type":"text","text":" "},{"type":"text","text":"room to spare, or cancelled on an edge whose flow the path runs against. When the sink cannot"},{"type":"text","text":" "},{"type":"text","text":"be reached the flow is maximum and nothing more is reported."}]}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Flows/s23CustomStringConvertibleP":{"type":"unresolvable","identifier":"doc:\/\/Flows\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible"},"doc://Flows/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Flows\/s16SendableMetatypeP"},"doc://Flows/documentation/Flows":{"title":"Flows","abstract":[],"role":"collection","kind":"symbol","identifier":"doc:\/\/Flow