zen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Capacity","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each round a breadth-first search over the residual network, its rows in edge-position order,"},{"type":"text","text":" "},{"type":"text","text":"finds a shortest augmenting path from the source to the sink, stopping when the sink is"},{"type":"text","text":" "},{"type":"text","text":"discovered. The path is reported with its bottleneck, the smallest residual along it; then the"},{"type":"text","text":" "},{"type":"text","text":"bottleneck is sent along it one edge at a time, from the source end: pushed along an edge with"},{"type":"text","text":" "},{"type":"text","text":"room to spare, or cancelled on an edge whose flow the path runs against. When the sink cannot"},{"type":"text","text":" "},{"type":"text","text":"be reached the flow is maximum and nothing more is reported."}]}]}],"references":{"doc://Flows/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Flows\/s8SendableP"},"doc://Flows/documentation/Flows/EdmondsKarpEvent/cancel(_:amount:)":{"abstract":[{"text":"The edge’s flow falls by ","type":"text"},{"type":"codeVoice","code":"amount"},{"text":": the path runs against it.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/flows\/edmondskarpevent\/cancel(_:amou