{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"What the Edmonds–Karp algorithm reports, in order.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Capacity"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each round a breadth-first search over the residual network, its rows in edge-position order,","type":"text"},{"text":" ","type":"text"},{"text":"finds a shortest augmenting path from the source to the sink, stopping when the sink is","type":"text"},{"text":" ","type":"text"},{"text":"discovered. The path is reported with its bottleneck, the smallest residual along it; then the","type":"text"},{"text":" ","type":"text"},{"text":"bottleneck is sent along it one edge at a time, from the source end: pushed along an edge with","type":"text"},{"text":" ","type":"text"},{"text":"room to spare, or cancelled on an edge whose flow the path runs against. When the sink cannot","type":"text"},{"text":" ","type":"text"},{"text":"be reached the flow is maximum and nothing more is reported.","type":"text"}]}]}],"metadata":{"title":"EdmondsKarpEvent","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvent"}],"remoteSource":{"fileName":"EdmondsKarpEvents.