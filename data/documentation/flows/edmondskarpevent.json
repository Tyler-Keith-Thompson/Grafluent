{"sections":[],"kind":"symbol","relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Flows\/s8CopyableP","doc:\/\/Flows\/s23CustomStringConvertibleP","doc:\/\/Flows\/SQ","doc:\/\/Flows\/s9EscapableP","doc:\/\/Flows\/SH","doc:\/\/Flows\/s8SendableP","doc:\/\/Flows\/s16SendableMetatypeP"],"kind":"relationships"}],"abstract":[{"text":"What the Edmonds–Karp algorithm reports, in order.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/flows\/edmondskarpevent"]}],"metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdmondsKarpEvent"}],"role":"symbol","symbolKind":"enum","roleHeading":"Enumeration","modules":[{"name":"Flows"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Flows\/EdmondsKarpEvents.swift#L12","fileName":"EdmondsKarpEvents.swift"},"navigatorTitle":[{"text":"EdmondsKarpEvent","kind":"identifier"}],"title":"EdmondsKarpEvent","externalID":"s:5Flows16EdmondsKarpEventO"},"topicSections":[{"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/augmentingPath(_:bottleneck:)","doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/cancel(_:amount:)","doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/push(_:amount:)"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/CustomStringConvertible-Implementations","doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/Equatable-Implementations"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdmondsKarpEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Capacity","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each round a breadth-first search over the residual network, its rows in edge-position order,"},{"type":"text","text":" "},{"type":"text","text":"finds a shortest augmenting path from the source to the sink, stopping when the sink is"},{"type":"text","text":" "},{"type":"text","text":"discovered. The path is reported with its bottleneck, the smallest residual along it; then the"},{"type":"text","text":" "},{"type":"text","text":"bottleneck is sent along it one edge at a time, from the source end: pushed along an edge with"},{"type":"text","text":" "},{"type":"text","text":"room to spare, or cancelled on an edge whose flow the path runs against. When the sink cannot"},{"type":"text","text":" "},{"type":"text","text":"be reached the flow is maximum and nothing more is reported."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Flows\/documentation\/Flows"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Flows/documentation/Flows/EdmondsKarpEvent/Equatable-Implementations":{"kind":"article","role":"collectionGroup","url":"\/documentation\/flows\/edmondskarpevent\/equatable-implementations","title":"Equatable Implementations","identifier":"doc:\/\/Flows\/documentation\/Flows\/EdmondsKarpEvent\/Equatable-Implementations","type":"topic","abstract":[]},"doc://Flows/documentation/Flows/EdmondsKarpEvent":{"kind":"symbol","navigat