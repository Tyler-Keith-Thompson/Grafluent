":"text","text":"HyperGraphs.jl’s "},{"code":"−1 + 1","type":"codeVoice"},{"type":"text","text":". "},{"code":"reversed","type":"codeVoice"},{"type":"text","text":" swaps the planes (every entry negated) and "},{"code":"transposed()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"transposes each (the dual), both in O(1)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storage is 4·n·m\/8 bytes, so, as for "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", this is for dense or small incidence;"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":" is the sparse representation. Equality compares both planes cell for cell, with"},{"type":"text","text":" "},{"type":"text","text":"equal shape, and column order counts."}],"type":"paragraph"}]}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Equatable-Implementations":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Equatable-Implementations","role":"collectionGroup","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/equatable-implementations","type":"topic","title":"Equatable Implementations","abstract":[],"kind":"article"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/reserveCapacity(vertexCount:hyperedgeCount:)":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/reserveCapacity(vertexCount:hyperedgeCount:)","title":"reserveCapacity(vertexCount:hyperedgeCount:)","kind":"symbol","role":"symbol","abstract":[{"text":"Reserves storage for ","type":"text"},{"type":"codeVoice","code":"vertexCount"},{"text":" vertices and ","type":"text"},{"type":"codeVoice","code":"hyperedgeCount"},{"text":" columns.","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","k