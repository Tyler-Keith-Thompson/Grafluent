{"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"This is the matrix of Gallo, Longo, Pallottino and Nguyen (1993). A directed graph’s edge is a"},{"type":"text","text":" "},{"type":"text","text":"column with one source and one target, which gives the oriented incidence matrix of spectral"},{"type":"text","text":" "},{"type":"text","text":"graph theory (B·Bᵀ = L). The matrix conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged. It is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Two-bit-planes","type":"heading","text":"Two bit planes"},{"inlineContent":[{"type":"text","text":"The sources and the targets are each stored as an "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", so a vertex can be on both"},{"type":"text","text":" "},{"type":"text","text":"sides of a column. Its entry is then target − source = 0, with both bits kept."},{"type":"text","text":" "},{"type":"codeVoice","code":"sources(ofHyperedgeAt:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"targets(ofHyperedgeAt:)"},{"type":"text","text":", the stars and equality read the planes,"},{"type":"text","text":" "},{"type":"text","text":"so nothing is lost. A directed self-loop is such a column. "},{"type":"codeVoice","code":"reversed"},{"type":"text","text":" swaps the planes, negating"},{"type":"text","text":" "},{"type":"text","text":"every entry, and "},{"type":"codeVoice","code":"transposed()"},{"type":"text","text":" transposes each plane to give the dual. Both are O(1)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storage is 4·n·m\/8 bytes, so the matrix suits dense or small incidence. "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"sparse representation. Equality compares both planes cell for cell, with equal shape, so column"},{"type":"text","text":" "},{"type":"text","text":"order counts."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"remoteSource":{"fileName":"OrientedIncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L25"},"roleHeading":"Structure","externalID":"s:21IncidenceMatrixModule08OrientedaB0V","title":"OrientedIncidenceMatrix","symbolKind":"struct","role":"symbol","modules":[{"name":"IncidenceMatrixModule"}],"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init()","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-1k5cq","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-46tuh","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-6qyfl","doc:\/\/IncidenceMatrixModule\/documentation\/Incid