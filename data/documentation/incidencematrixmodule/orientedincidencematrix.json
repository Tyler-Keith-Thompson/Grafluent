{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"title":"OrientedIncidenceMatrix","modules":[{"name":"IncidenceMatrixModule"}],"role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"remoteSource":{"fileName":"OrientedIncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L25"},"symbolKind":"struct","externalID":"s:21IncidenceMatrixModule08OrientedaB0V"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"]}],"abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Two bit planes.","type":"text"}],"type":"strong"},{"text":" The sources and the targets are each an ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"SimpleDirectedHypergraphs.jl keeps two matrices, so a vertex can be on both sides of a column.","type":"text"},{"text":" ","type":"text"},{"text":"Its entry is then target − source = ","type":"text"},{"inlineContent":[{"text":"0","type":"text"}],"type":"strong"},{"text":", with both bits kept: ","type":"text"},{"type":"codeVoice","code":"sources(ofHyperedgeAt:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"targets(ofHyperedgeAt:)"},{"text":", the stars and equality read the planes, so nothing is lost. A","type":"text"},{"text":" ","type":"text"},{"text":"directed self-loop is such a column, and its zero matches NetworkX’s oriented loop column and","type":"text"},{"text":" ","type":"text"},{"text":"HyperGraphs.jl’s ","type":"text"},{"type":"codeVoice","code":"−1 + 1"},{"text":". ","type":"text"},{"type":"codeVoice","code":"reversed"},{"text":" swaps the planes (every entry negated) and ","type":"text"},{"type":"codeVoice","code":"transposed()"},{"text":" ","type":"text"},{"text":"transposes each (the dual), both in O(1).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storage is 4·n·m\/8 bytes, so, as for "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", this is for dense or small incidence;"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":" is the sparse representation. Equality compares both planes cell for cell, with"},{"type":"text","text":" "},{"type":"text","text":"equal shape, and column order counts."}],"type":"paragraph"}]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"]}],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init()","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-1k5cq","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-46tuh","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-6qyfl","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-y850","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(vertexCount:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(vertexCount:edges:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(vertexCount:hyperedges:)"]},{"anchor":"Instance-Properties","generated":