ion\/GraphProtocols\/DirectedHypergraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L25","fileName":"OrientedIncidenceMatrix.swift"},"title":"OrientedIncidenceMatrix","modules":[{"name":"IncidenceMatrixModule"}],"symbolKind":"struct","externalID":"s:21IncidenceMatrixModule08OrientedaB0V","roleHeading":"Structure","role":"symbol"},"abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Two bit planes."}],"type":"strong"},{"text":" The sources and the targets are each an ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", as","type":"text"},{"text":" ","type":"text"},{"text":"SimpleDirectedHypergraphs.jl keeps two matrices, so a vertex can be on both sides of a column.","type":"text"},{"text":" ","type":"text"},{"text":"Its entry is then target − source = ","type":"text"},{"inlineContent":[{"text":"0","type":"text"}],"type":"strong"},{"text":", with both bits kept: ","type":"text"},{"code":"sources(ofHyperedgeAt:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"targets(ofHyperedgeAt:)","type":"codeVoice"},{"text":", the stars and equality read the planes, so nothing is lost. A","type":"text"},{"text":" ","type":"text"},{"text":"directed self-loop is such a column, and its zero matches NetworkX’s oriented loop column and","type":"text"},{"text":" ","type":"text"},{"text":"HyperGraphs.jl’s ","type":"text"},{"code":"−1 + 1","type":"codeVoice"},{"text":". ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" swaps the planes (every entry negated) and ","type":"text"},{"code":"transposed()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"transposes each (the dual), both in O(1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is 4·n·m\/8 bytes, so, as for "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":", this is for dense or small incidence;"},{"type":"text","text":" "},{"code":"IncidenceList","type":"codeVoice"},{"type":"text","text":" is the sparse representation. Equality compares both planes cell for cell, with"},{"type":"text","text":" "},{"type":"text","text":"equal shape, and column order counts."}]}],"kind":"content"}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/appendVertex()":{"kind":"symbol","title":"appendVertex()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"appendVertex","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/appendvertex()","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/appendVertex()","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Appends a vertex in no column."}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(vertexCount:hyperedges:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"