tions","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/DirectedHypergraph-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Encodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Equatable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hashable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/PropertyGraph-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This is the matrix of Gallo, Longo, Pallottino and Nguyen (1993). A directed graph’s edge is a","type":"text"},{"text":" ","type":"text"},{"text":"column with one source and one target, which gives the oriented incidence matrix of spectral","type":"text"},{"text":" ","type":"text"},{"text":"graph theory (B·Bᵀ = L). The matrix conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged. It is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Two bit planes","anchor":"Two-bit-planes"},{"type":"paragraph","inlineContent":[{"text":"The sources and the targets are each stored as an ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", so a vertex can be on both","type":"text"},{"text":" ","type":"text"},{"text":"sides of a column. Its entry is then target − source = 0, with both bits kept.","type":"text"},{"text":" ","type":"text"},{"code":"sources(ofHyperedgeAt:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"targets(ofHyperedgeAt:)","type":"codeVoice"},{"text":", the stars and equality read the planes,","type":"text"},{"text":" ","type":"text"},{"text":"so nothing is lost. A directed self-loop is such a column. ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" swaps the planes, negating","type":"text"},{"text":" ","type":"text"},{"text":"every entry, and ","type":"text"},{"code":"transposed()","type":"codeVoice"},{"text":" transposes each plane to give the dual. Both are O(1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is 4·n·m\/8 bytes, so the matrix suits dense or small incidence. "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"sparse representation. Equality compares both planes cell for cell, with equal shape, so column"},{"type":"text","text":" "},{"type":"text","text":"order counts."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","symbolKind":"struct","modules":[{"name":"IncidenceMatrixModule"}],"roleHeading":"Structure","title":"OrientedIncidenceMatrix","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L25","fileName":"OrientedIncidenceMatrix.swift"},"externalID":"s:21IncidenceMatrixModule08OrientedaB0V","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"sections":[],"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph. Entry (v, p) is −1 when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise."}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/inHyperedges(checked:)":{"abstract":[{"type":"codeVoice","code":"inHyperedges(of:)"},{"type":"text","text":", throwing instead of trapping when "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" is not in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". O(⌈m\/64⌉)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inHyperedges","kind":"identifier"},{"text":"(","kind