le\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/DirectedHypergraph-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Encodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Equatable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hashable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/PropertyGraph-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"metadata":{"externalID":"s:21IncidenceMatrixModule08OrientedaB0V","modules":[{"name":"IncidenceMatrixModule"}],"role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"title":"OrientedIncidenceMatrix","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"remoteSource":{"fileName":"OrientedIncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L25"}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"]}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph. Entry (v, p) is −1 when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the matrix of Gallo, Longo, Pallottino and Nguyen (1993). A directed graph’s edge is a"},{"type":"text","text":" "},{"type":"text","text":"column with one source and one target, which gives the oriented incidence matrix of spectral"},{"type":"text","text":" "},{"type":"text","text":"graph theory (B·Bᵀ = L). The matrix conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged. It is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}]},{"level":2,"anchor":"Two-bit-planes","type":"heading","text":"Two bit planes"},{"type":"paragraph","inlineContent":[{"text":"The sources and the targets are each stored as an ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":", so a vertex can be on both","type":"text"},{"text":" ","type":"text"},{"text":"sides of a column. Its entry is then target − source = 0, with both bits kept.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sources(ofHyperedgeAt:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"targets(ofHyperedgeAt:)"},{"text":", the stars and equality read the planes,","type":"text"},{"text":" ","type":"text"},{"text":"so nothing is lost. A directed self-loop is such a column. ","type":"text"},{"type":"codeVoice","code":"reversed"},{"text":" swaps the planes, negating","type":"text"},{"text":" ","type":"text"},{"text":"every entry, and ","type":"text"},{"type":"codeVoice","code":"transposed()"},{"text":" transposes each plane to give the dual. Both are O(1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is 4·n·m\/8 bytes, so the matrix suits dense or small incidence. "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"sparse representation. Equality compares both planes cell for cell, with equal shape, so column"},{"type":"text","text":" "},{"type":"text","text":"order counts."}]}]}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/reserveCapacity(vertexCount:hyperedgeCount:)":{"abstract":[{"text":"Reserves storage for ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" vertices and ","type":"text"},{"code":"hyperedgeCount","type":"codeVoice"},{"text":" columns, and room for","type":"text"},{"text":" ","type":"text"},{"text":"their values in every attached map.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","te