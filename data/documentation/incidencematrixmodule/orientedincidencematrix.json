rget, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Two bit planes."}],"type":"strong"},{"type":"text","text":" The sources and the targets are each an "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":", as"},{"type":"text","text":" "},{"type":"text","text":"SimpleDirectedHypergraphs.jl keeps two matrices, so a vertex can be on both sides of a column."},{"type":"text","text":" "},{"type":"text","text":"Its entry is then target − source = "},{"inlineContent":[{"type":"text","text":"0"}],"type":"strong"},{"type":"text","text":", with both bits kept: "},{"code":"sources(ofHyperedgeAt:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"