tsOfHyperedgeAt:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/insert(checked:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/insert(checked:targets:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/insert(edge:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/insert(sources:targets:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/outDegree(checked:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/outHyperedges(checked:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/remove(_:fromSourcesOfHyperedgeAt:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/remove(_:fromTargetsOfHyperedgeAt:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/removeAll(keepingCapacity:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/reserveCapacity(vertexCount:hyperedgeCount:)","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/transposed()","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/vertexIndex(checked:)"]},{"generated":true,"anchor":"Subscripts","title":"Subscripts","identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/subscript(vertex:hyperedge:)"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/CustomStringConvertible-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Decodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/DirectedHypergraph-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Encodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Equatable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hashable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/PropertyGraph-Implementations"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the matrix of Gallo, Longo, Pallottino and Nguyen (1993). A directed graph’s edge is a"},{"type":"text","text":" "},{"type":"text","text":"column with one source and one target, which gives the oriented incidence matrix of spectral"},{"type":"text","text":" "},{"type":"text","text":"graph theory (B·Bᵀ = L). The matrix conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged. It is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}]},{"level":2,"text":"Two bit planes","anchor":"Two-bit-planes","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The sources and the targets are each stored as an ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", so a vertex can be on both","type":"text"},{"text":" ","type":"text"},{"text":"sides of a column. Its entry is then target − source = 0, with both bits kept.","type":"text"},{"text":" ","type":"text"},{"code":"sources(ofHyperedgeAt:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"targets(ofHyperedgeAt:)","type":"codeVoice"},{"text":", the stars and equality read the planes,","type":"text"},{"text":" ","type":"text"},{"text":"so nothing is lost. A directed self-loop is such a column. ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" swaps the planes, negating","type":"text"},{"text":" ","type":"text"},{"text":"every entry, and ","type":"text"},{"code":"transposed()","type":"codeVoice"},{"text":" transposes each plane to give the dual. Both are O(1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Storage is 4·n·m\/8 bytes, so the matrix suits dense or small incidence. ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"sparse representation. Equality compares both planes cell for cell, with equal shape, so column","type":"text"},{"text":" ","type":"text"},{"text":"order counts.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE