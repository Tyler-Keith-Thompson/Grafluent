mentations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Decodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/DirectedHypergraph-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Encodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Equatable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hashable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/PropertyGraph-Implementations"],"generated":true,"title":"Default Implementations"}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"variants":[{"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","role":"symbol","externalID":"s:21IncidenceMatrixModule08OrientedaB0V","roleHeading":"Structure","modules":[{"name":"IncidenceMatrixModule"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"remoteSource":{"fileName":"OrientedIncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L25"}},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"This is the matrix of Gallo, Longo, Pallottino and Nguyen (1993). A directed graph’s edge is a","type":"text"},{"text":" ","type":"text"},{"text":"column with one source and one target, which gives the oriented incidence matrix of spectral","type":"text"},{"text":" ","type":"text"},{"text":"graph theory (B·Bᵀ = L). The matrix conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged. It is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Two bit planes","anchor":"Two-bit-planes"},{"inlineContent":[{"type":"text","text":"The sources and the targets are each stored as an "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":", so a vertex can be on both"},{"type":"text","text":" "},{"type":"text","text":"sides of a column. Its entry is then target − source = 0, with both bits kept."},{"type":"text","text":" "},{"code":"sources(ofHyperedgeAt:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"targets(ofHyperedgeAt:)","type":"codeVoice"},{"type":"text","text":", the stars and equality read the planes,"},{"type":"text","text":" "},{"type":"text","text":"so nothing is lost. A directed self-loop is such a column. "},{"code":"reversed","type":"codeVoice"},{"type":"text","text":" swaps the planes, negating"},{"type":"text","text":" "},{"type":"text","text":"every entry, and "},{"code":"transposed()","type":"codeVoice"},{"type":"text","text":" transposes each plane to give the dual. Both are O(1)."}],"type":"paragraph"},{"inlineContent":[{"text":"Storage is 4·n·m\/8 bytes, so the matrix suits dense or small incidence. ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"sparse representation. Equality compares both planes cell for cell, with equal shape, so column","type":"text"},{"text":" ","type":"text"},{"text":"order counts.","type":"text"}],"type":"paragraph"}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"abstract":[{"text":"The oriented incidence matrix of a directed hypergraph. Entry (v, p) is −1 when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", +1 when it is a target, and 0 otherwise.","type":"text"}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/insert(sources:targets:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sources"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":