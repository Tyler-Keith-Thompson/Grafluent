ns","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/DirectedHypergraph-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Encodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Equatable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hashable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/PropertyGraph-Implementations"],"generated":true,"title":"Default Implementations"}],"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph. Entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise."}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","remoteSource":{"fileName":"OrientedIncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L25"},"symbolKind":"struct","modules":[{"name":"IncidenceMatrixModule"}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","externalID":"s:21IncidenceMatrixModule08OrientedaB0V","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"This is the matrix of Gallo, Longo, Pallottino and Nguyen (1993). A directed graph’s edge is a","type":"text"},{"text":" ","type":"text"},{"text":"column with one source and one target, which gives the oriented incidence matrix of spectral","type":"text"},{"text":" ","type":"text"},{"text":"graph theory (B·Bᵀ = L). The matrix conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged. It is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Two bit planes","anchor":"Two-bit-planes","type":"heading"},{"inlineContent":[{"type":"text","text":"The sources and the targets are each stored as an "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", so a vertex can be on both"},{"type":"text","text":" "},{"type":"text","text":"sides of a column. Its entry is then target − source = 0, with both bits kept."},{"type":"text","text":" "},{"type":"codeVoice","code":"sources(ofHyperedgeAt:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"targets(ofHyperedgeAt:)"},{"type":"text","text":", the stars and equality read the planes,"},{"type":"text","text":" "},{"type":"text","text":"so nothing is lost. A directed self-loop is such a column. "},{"type":"codeVoice","code":"reversed"},{"type":"text","text":" swaps the planes, negating"},{"type":"text","text":" "},{"type":"text","text":"every entry, and "},{"type":"codeVoice","code":"transposed()"},{"type":"text","text":" transposes each plane to give the dual. Both are O(1)."}],"type":"paragraph"},{"inlineContent":[{"text":"Storage is 4·n·m\/8 bytes, so the matrix suits dense or small incidence. ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"sparse representation. Equality compares both planes cell for cell, with equal shape, so column","type":"text"},{"text":" ","type":"text"},{"text":"order counts.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/inDegree(checked:)":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/inDegree(checked:)","abstract":[{"code":"inDegree(of:)","type":"codeVoice"},{"text":", throwing instead of trapping when ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" is not in ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"O(