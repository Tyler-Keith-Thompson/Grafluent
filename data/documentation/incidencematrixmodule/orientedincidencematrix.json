 either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"url":"\/documentation\/graphprotocols\/directedhypergraph"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/remove(_:fromSourcesOfHyperedgeAt:)":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/remove(_:fromSourcesOfHyperedgeAt:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remove","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fromSourcesOfHyperedgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/remove(_:fromsourcesofhyperedgeat:)","title":"remove(_:fromSourcesOfHyperedgeAt:)","kind":"symbol","abstract":[{"text":"Removes ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":" from the sources of the column at ","type":"text"},{"type":"codeVoice","code":"position"},{"text":". O(1).","type":"text"}]},"doc://IncidenceMatrixModule/SE":{"identifier":"doc:\/\/IncidenceMatrixModule\/SE","title":"Swift.Encodable","type":"unresolvable"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidence