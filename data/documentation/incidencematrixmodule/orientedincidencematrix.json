nsposes each (the dual), both in O(1)."}],"type":"paragraph"},{"inlineContent":[{"text":"Storage is 4·n·m\/8 bytes, so, as for ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":", this is for dense or small incidence;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"IncidenceList"},{"text":" is the sparse representation. Equality compares both planes cell for cell, with","type":"text"},{"text":" ","type":"text"},{"text":"equal shape, and column order counts.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","interfaceLanguage":"swift"},"sections":[],"references":{"doc://IncidenceMatrixModule/Se":{"type":"unresolvable","identifier":"doc:\/\/IncidenceMatrixModule\/Se","title":"Swift.Decodable"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init()":{"abstract":[{"text":"The matrix with no vertices and no columns.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","title":"init()","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init()","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/insert(_:intoSourcesOfHyperedgeAt:)":{"title":"insert(_:intoSourcesOfHyperedgeAt:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Makes "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" a source of the column at "},{"type":"codeVoice","code":"position"},{"type":"text","text":". O(1)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text