,{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/defaultMaximumDecodedWordCount","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/maximumDecodedWordCountKey"],"title":"Type Properties"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/CustomStringConvertible-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Decodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Encodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Equatable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Hashable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Hypergraph-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceMatrix"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A column is any set of vertices: empty columns and repeated columns are kept, and a graph’s"},{"type":"text","text":" "},{"type":"text","text":"self-loop is the one bit at its vertex, the hyperedge {v}. (NetworkX’s "},{"type":"codeVoice","code":"incidence_matrix"},{"type":"text","text":" gives a"},{"type":"text","text":" "},{"type":"text","text":"loop a zero column; Godsil–Royle’s entry 2 is not a bit. A zero column would forget the loop.)"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":" is the directed form; "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":" is the sparse"},{"type":"text","text":" "},{"type":"text","text":"representation of the same hypergraphs."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Storage.","type":"text"}]},{"type":"text","text":" Both orientations are stored, as "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":" stores its rows: n rows of"},{"type":"text","text":" "},{"type":"text","text":"⌈m\/64⌉ words and m columns of ⌈n\/64⌉ words, with the row and column popcounts cached. So"},{"type":"text","text":" "},{"type":"codeVoice","code":"members(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" are each one "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":" copy of"},{"type":"text","text":" "},{"type":"text","text":"⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and "},{"type":"codeVoice","code":"transposed()"},{"type":"text","text":", the dual,"},{"type":"text","text":" "},{"type":"text","text":"swaps the two in O(1). The cost is 2·n·m\/8 bytes: "},{"type":"strong","inlineContent":[{"type":"text","text":"the matrix is for dense or small"},{"type":"text","text":" "},{"type":"text","text":"incidence"}]},{"type":"text","text":" (spectral work at n·m up to about 10⁹, hypergraphs with large hyperedges). Sparse"},{"type":"text","text":" "},{"type":"text","text":"incidence belongs in "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Equality compares cell for cell, with equal shape: column order is observable, because a"},{"type":"text","text":" "},{"type":"text","text":"column’s position is what a spectral caller indexes by. ("},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":"’s equality"},{"type":"text","text":" "},{"type":"text","text":"ignores positions; convert to compare that way.)"}]}],"kind":"content"}],"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/incidencematrixmodule\/incidencematrix"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IncidenceMatrixModule/SH":{"identifier":"doc:\/\/IncidenceMatrixModule\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://IncidenceMatrixModule/SE":{"identifier":"doc:\/\/IncidenceMatrixModule\/SE","type":"unresolvable","title":"Swift.Encodable"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"title":"Hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/init(_:)-mnxt":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-mnxt","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"H"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"H"},{"kind":"text","text":")"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The one hypergraph conversion for a type that is both a directed graph and a directed"},{"type":"text","text":" "},{"type":"text","text":"hypergraph: read as a hypergraph."}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-mnxt","role":"symbol","title":"init(_:)"},"doc://IncidenceMatrixModule/s8SendableP":{"identifier":"doc:\/\/IncidenceMatrixModule\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/appendVertex()":{"role":"symbol","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/appendvertex()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"appendVertex"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"title"