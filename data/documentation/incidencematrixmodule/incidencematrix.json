"type":"text","text":"the matrix is for dense or small"},{"type":"text","text":" "},{"type":"text","text":"incidence"}],"type":"strong"},{"text":" (spectral work at n·m up to about 10⁹, hypergraphs with large hyperedges). Sparse","type":"text"},{"text":" ","type":"text"},{"text":"incidence belongs in ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality compares cell for cell, with equal shape: column order is observable, because a"},{"type":"text","text":" "},{"type":"text","text":"column’s position is what a spectral caller indexes by. ("},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":"’s equality"},{"type":"text","text":" "},{"type":"text","text":"ignores positions; convert to compare that way.)"}],"type":"paragraph"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/incidencematrixmodule\/incidencematrix"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"},"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"abstract":[{"text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set","type":"text"},{"text":" ","type":"text"},{"text":"when vertex ","type":"text