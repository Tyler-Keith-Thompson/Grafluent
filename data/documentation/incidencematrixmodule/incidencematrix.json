{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"sections":[],"abstract":[{"text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set","type":"text"},{"text":" ","type":"text"},{"text":"when vertex ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a member of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":". The vertices are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" and the columns,","type":"text"},{"text":" ","type":"text"},{"text":"the hyperedges, are at positions ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"Hypergraph"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" algorithms run on it unchanged; it is not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" even when built from one,","type":"text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceMatrix"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"A column is any set of vertices: empty columns and repeated columns are kept, and a graph’s","type":"text"},{"text":" ","type":"text"},{"text":"self-loop is the one bit at its vertex, the hyperedge {v}. (NetworkX’s ","type":"text"},{"code":"incidence_matrix","type":"codeVoice"},{"text":" gives a","type":"text"},{"text":" ","type":"text"},{"text":"loop a zero column; Godsil–Royle’s entry 2 is not a bit. A zero column would forget the loop.)","type":"text"},{"text":" ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":" is the directed form; ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":" is the sparse","type":"text"},{"text":" ","type":"text"},{"text":"representation of the same hypergraphs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Storage.","type":"text"}],"type":"strong"},{"text":" Both orientations are stored, as ","type":"text"},{"code":"AdjacencyMatrix","type":"codeVoice"},{"text":" stores its rows: n rows of","type":"text"},{"text":" ","type":"text"},{"text":"⌈m\/64⌉ words and m columns of ⌈n\/64⌉ words, with the row and column popcounts cached. So","type":"text"},{"text":" ","type":"text"},{"code":"members(ofHyperedgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"incidentHyperedges(of:)","type":"codeVoice"},{"text":" are each one ","type":"text"},{"code":"BitSet","type":"codeVoice"},{"text":" copy of","type":"text"},{"text":" ","type":"text"},{"text":"⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and ","type":"text"},{"code":"transposed()","type":"codeVoice"},{"text":", the dual,","type":"text"},{"text":" ","type":"text"},{"text":"swaps the two in O(1). The cost is 2·n·m\/8 bytes: ","type":"text"},{"inlineContent":[{"type":"text","text":"the matrix is for dense or small"},{"type":"text","text":" "},{"type":"text","text":"incidence"}],"type":"strong"},{"text":" (spectral work at n·m up to about 10⁹, hypergraphs with large hyperedges). Sparse","type":"text"},{"text":" ","type":"text"},{"text":"incidence belongs in ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality compares cell for cell, with equal shape: column order is observable, because a"},{"type":"text","text":" "},{"type":"text","text":"column’s position is what a spectral caller indexes by. ("},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"’s equality"},{"type":"text","text":" "},{"type":"text","text":"ignores positions; convert to compare that way.)"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"role":"symbol","externalID":"s:21IncidenceMatrixModule0aB0V","symbolKind":"struct","remoteSource":{"fileName":"IncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/IncidenceMatrix.swift#L28"},"modules":[{"name":"IncidenceMatrixModule"}],"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"title":"IncidenceMatrix","roleHeading":"Structure"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/incidencematrix"]}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init()","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixM