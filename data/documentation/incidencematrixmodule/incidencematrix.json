ntentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":", and the columns, the hyperedges, are at positions"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". The matrix conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run"},{"type":"text","text":" "},{"type":"text","text":"on it unchanged. It is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":", even when built from one, because a cell edit can give a"},{"type":"text","text":" "},{"type":"text","text":"column any number of bits."}],"type":"paragraph"},{"inlineContent":[{"text":"A column is any set of vertices. Empty columns and repeated columns are kept. A graph’s","type":"text"},{"text":" ","type":"text"},{"text":"self-loop becomes the one bit at its vertex, the hyperedge {v}. ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"the directed form, and ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":" is the sparse representation of the same","type":"text"},{"text":" ","type":"text"},{"text":"hypergraphs.","type":"text"}],"type":"paragraph"},{"anchor":"Storage","level":2,"text":"Storage","type":"heading"},{"inlineContent":[{"type":"text","text":"Both orientations are stored: n rows of ⌈m\/64⌉ words and m columns of ⌈n\/64⌉ words, with the"},{"type":"text","text":" "},{"type":"text","text":"row and column popcounts cached. "},{"type":"codeVoice","code":"members(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"each one "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":" copy of ⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"transposed()"},{"type":"text","text":", the dual, swaps the two orientations in O(1). The storage is 2·n·m\/8 bytes, so"},{"type":"text","text":" "},{"type":"text","text":"the matrix suits dense or small incidence, such as spectral work or hypergraphs with large"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. Use "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":" for sparse incidence."}],"type":"paragraph"},{"inlineContent":[{"text":"Equality compares cell for cell, with equal shape, so column order counts.","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":"’s equality ignores positions.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/incidencematrix"]}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"schemaVersion