ext"},{"type":"codeVoice","code":"transposed()"},{"text":", the dual,","type":"text"},{"text":" ","type":"text"},{"text":"swaps the two in O(1). The cost is 2·n·m\/8 bytes: ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"the matrix is for dense or small"},{"type":"text","text":" "},{"type":"text","text":"incidence"}]},{"text":" (spectral work at n·m up to about 10⁹, hypergraphs with large hyperedges). Sparse","type":"text"},{"text":" ","type":"text"},{"text":"incidence belongs in ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Equality compares cell for cell, with equal shape: column order is observable, because a","type":"text"},{"text":" ","type":"text"},{"text":"column’s position is what a spectral caller indexes by. (","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":"’s equality","type":"text"},{"text":" ","type":"text"},{"text":"ignores positions; convert to compare that way.)","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"cod