,{"text":" and ","type":"text"},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"each one ","type":"text"},{"type":"codeVoice","code":"BitSet"},{"text":" copy of ⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"transposed()"},{"text":", the dual, swaps the two orientations in O(1). The storage is 2·n·m\/8 bytes, so","type":"text"},{"text":" ","type":"text"},{"text":"the matrix suits dense or small incidence, such as spectral work or hypergraphs with large","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges. Use ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":" for sparse incidence.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Equality compares cell for cell, with equal shape, so column order counts.","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":"’s equality ignores positions.","type":"text"}]}],"kind":"content"}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/removeAll(keepingCapacity:)":{"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/removeall(keepingcapacity:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeAll"},{"kind":"text","text":"("},{"kind":"externalParam","text":"keepingCapacity"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")"}],"title":"removeAll(keepingCapacity:)","abstract":[{"type":"text","text":"Removes every vertex and column. Every attached map stays attached, empty."}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/removeAll(keepingCapacity:)"},"doc://IncidenceMatrixModule/Se":{"