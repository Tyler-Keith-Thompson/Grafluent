"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The vertices are ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":", and the columns, the hyperedges, are at positions","type":"text"},{"text":" ","type":"text"},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"text":". The matrix conforms to ","type":"text"},{"code":"Hypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" algorithms run","type":"text"},{"text":" ","type":"text"},{"text":"on it unchanged. It is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":", even when built from one, because a cell edit can give a","type":"text"},{"text":" ","type":"text"},{"text":"column any number of bits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A column is any set of vertices. Empty columns and repeated columns are kept. A graph’s"},{"type":"text","text":" "},{"type":"text","text":"self-loop becomes the one bit at its vertex, the hyperedge {v}. "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"the directed form, and "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":" is the sparse representation of the same"},{"type":"text","text":" "},{"type":"text","text":"hypergraphs."}]},{"type":"heading","text":"Storage","level":2,"anchor":"Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both orientations are stored: n rows of ⌈m\/64⌉ words and m columns of ⌈n\/64⌉ words, with the"},{"type":"text","text":" "},{"type":"text","text":"row and column popcounts cached. "},{"type":"codeVoice","code":"members(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"each one "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":" copy of ⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"transposed()"},{"type":"text","text":", the dual, swaps the two orientations in O(1). The storage is 2·n·m\/8 bytes, so"},{"type":"text","text":" "},{"type":"text","text":"the matrix suits dense or small incidence, such as spectral work or hypergraphs with large"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. Use "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":" for sparse incidence."}]},{"type":"paragraph","inlineContent":[{"text":"Equality compares cell for cell, with equal shape, so column order counts.","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":"’s equality ignores positions.","type":"text"}]}]}],"sections":[],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/Decodable-Implementations":{"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/decodable-implementations","abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Decodable-Implementations","title":"Decodable Implementations","type":"topic","kind":"article","role":"collectionGroup"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/vertexIndex(checked:)":{"abstract":[{"type":"codeVoice","code":"vertex"},{"type":"text","text":" itself, throwing instead of trapping when it is not in "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". O(1)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexIndex","kind":"identifier"},{"text":"(","k