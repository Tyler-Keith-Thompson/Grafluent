eMatrix","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":", and the columns, the hyperedges, are at positions"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". The matrix conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run"},{"type":"text","text":" "},{"type":"text","text":"on it unchanged. It is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":", even when built from one, because a cell edit can give a"},{"type":"text","text":" "},{"type":"text","text":"column any number of bits."}]},{"type":"paragraph","inlineContent":[{"text":"A column is any set of vertices. Empty columns and repeated columns are kept. A graph’s","type":"text"},{"text":" ","type":"text"},{"text":"self-loop becomes the one bit at its vertex, the hyperedge {v}. ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"the directed form, and ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":" is the sparse representation of the same","type":"text"},{"text":" ","type":"text"},{"text":"hypergraphs.","type":"text"}]},{"level":2,"anchor":"Storage","type":"heading","text":"Storage"},{"type":"paragraph","inlineContent":[{"text":"Both orientations are stored: n rows of ⌈m\/64⌉ words and m columns of ⌈n\/64⌉ words, with the","type":"text"},{"text":" ","type":"text"},{"text":"row and column popcounts cached. ","type":"text"},{"type":"codeVoice","code":"members(ofHyperedgeAt:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"each one ","type":"text"},{"type":"codeVoice","code":"BitSet"},{"text":" copy of ⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"transposed()"},{"text":", the dual, swaps the two orientations in O(1). The storage is 2·n·m\/8 bytes, so","type":"text"},{"text":" ","type":"text"},{"text":"the matrix suits dense or small incidence, such as spectral work or hypergraphs with large","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges. Use ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":" for sparse incidence.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Equality compares cell for cell, with equal shape, so column order counts."},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"’s equality ignores positions."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/init(_:)-5i569":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-5i569","title":"init(_:)","abstract":[{"type":"text","text":"The unoriented incidence matrix of a directed graph. Each edge’s column has both ends, and a"},{"type":"text","text":" "},{"type":"text","text":"self-loop’s column has one bit. Rows are by vertex index and columns in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order."}],"kind":"symbol","role":"symbol","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-5i569","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProto