trix\/CustomStringConvertible-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Decodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Encodable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Equatable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Hashable-Implementations","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Hypergraph-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceMatrix"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A column is any set of vertices: empty columns and repeated columns are kept, and a graph’s"},{"type":"text","text":" "},{"type":"text","text":"self-loop is the one bit at its vertex, the hyperedge {v}. (NetworkX’s "},{"type":"codeVoice","code":"incidence_matrix"},{"type":"text","text":" gives a"},{"type":"text","text":" "},{"type":"text","text":"loop a zero column; Godsil–Royle’s entry 2 is not a bit. A zero column would forget the loop.)"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":" is the directed form; "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":" is the sparse"},{"type":"text","text":" "},{"type":"text","text":"representation of the same hypergraphs."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Storage."}]},{"type":"text","text":" Both orientations are stored, as "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":" stores its rows: n rows of"},{"type":"text","text":" "},{"type":"text","text":"⌈m\/64⌉ words and m columns of ⌈n\/64⌉ words, with the row and column popcounts cached. So"},{"type":"text","text":" "},{"type":"codeVoice","code":"members(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" are each one "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":" copy of"},{"type":"text","text":" "},{"type":"text","text":"⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and "},{"type":"codeVoice","code":"transposed()"},{"type":"text","text":", the dual,"},{"type":"text","text":" "},{"type":"text","text":"swaps the two in O(1). The cost is 2·n·m\/8 bytes: "},{"type":"strong","inlineContent":[{"text":"the matrix is for dense or small","type":"text"},{"text":" ","type":"text"},{"text":"incidence","type":"text"}]},{"type":"text","text":" (spectral work at n·m up to about 10⁹, hypergraphs with large hyperedges). Sparse"},{"type":"text","text":" "},{"type":"text","text":"incidence belongs in "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Equality compares cell for cell, with equal shape: column order is observable, because a"},{"type":"text","text":" "},{"type":"text","text":"column’s position is what a spectral caller indexes by. ("},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":"’s equality"},{"type":"text","text":" "},{"type":"text","text":"ignores positions; convert to compare that way.)"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/incidencematrix"]}],"abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConvertibleP","doc:\/\/IncidenceMatrixModule\/Se","doc:\/\/IncidenceMatrixModule\/SE","doc:\/\/IncidenceMatrixModule\/SQ","doc:\/\/IncidenceMatrixModule\/s9EscapableP","doc:\/\/IncidenceMatrixModule\/SH","doc:\/\/IncidenceMatrixModule\/s8SendableP","doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP"],"kind":"relationships"}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/vertexIndex(checked:)":{"type":"topic","abstract":[{"type":"codeVoice","code":"vertex"},{"type":"text","text":" itself, throwing instead of trapping when it is not in "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". O(1)."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/vertexIndex(checked:)","title":"vertexIndex(checked