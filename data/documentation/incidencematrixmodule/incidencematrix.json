{"abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"]]},"metadata":{"externalID":"s:21IncidenceMatrixModule0aB0V","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"remoteSource":{"fileName":"IncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/IncidenceMatrix.swift#L28"},"symbolKind":"struct","modules":[{"name":"IncidenceMatrixModule"}],"role":"symbol","title":"IncidenceMatrix","roleHeading":"Structure"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/IncidenceMatrixModule\/s8CopyableP","doc:\/\/IncidenceMatrixModule\/s23CustomStringConver