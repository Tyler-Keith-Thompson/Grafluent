{"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/incidencematrix"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceMatrix"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices are "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":", and the columns, the hyperedges, are at positions"},{"type":"text","text":" "},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"type":"text","text":". The matrix conforms to "},{"code":"Hypergraph","type":"codeVoice"},{"type":"text","text":", so the "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms run"},{"type":"text","text":" "},{"type":"text","text":"on it unchanged. It is not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":", even when built from one, because a cell edit can give a"},{"type":"text","text":" "},{"type":"text","text":"column any number of bits."}]},{"type":"paragraph","inlineContent":[{"text":"A column is any set of vertices. Empty columns and repeated columns are kept. A graph’s","type":"text"},{"text":" ","type":"text"},{"text":"self-loop becomes the one bit at its vertex, the hyperedge {v}. ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"the directed form, and ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":" is the sparse representation of the same","type":"text"},{"text":" ","type":"text"},{"text":"hypergraphs.","type":"text"}]},{"anchor":"Storage","type":"heading","level":2,"text":"Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both orientations are stored: n rows of ⌈m\/64⌉ words and m columns of ⌈n\/64⌉ words, with the"},{"type":"text","text":" "},{"type":"text","text":"row and column popcounts cached. "},{"type":"codeVoice","code":"members(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"each one "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":" copy of ⌈n\/64⌉ or ⌈m\/64⌉ words, a cell edit writes two bits in O(1), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"transposed()"},{"type":"text","text":", the dual, swaps the two orientations in O(1). The storage is 2·n·m\/8 bytes, so"},{"type":"text","text":" "},{"type":"text","text":"the matrix suits dense or small incidence, such as spectral work or hypergraphs with large"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. Use "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":" for sparse incidence."}]},{"type":"paragraph","inlineContent":[{"text":"Equality compares cell for cell, with equal shape, so column order counts.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":"’s equality ignores positions.","type":"text"}]}],"kind":"content"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init()","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4158r","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4kjv4","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4zxvg","doc:\/\/IncidenceMatrixModule\/documentat