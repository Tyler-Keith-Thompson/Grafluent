 so","type":"text"},{"text":" ","type":"text"},{"text":"the matrix suits dense or small incidence, such as spectral work or hypergraphs with large","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges. Use ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":" for sparse incidence.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Equality compares cell for cell, with equal shape, so column order counts.","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":"’s equality ignores positions.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"},"abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph, an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":"."}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph":{"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/propertygraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"}],"navigatorTitle":[{"text":"PropertyGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A graph that keeps maps from its vertices and edges to values."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","title":"PropertyGraph"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/Decodable-Implementations":{"type":"topic","role":"collectionGroup","kind":"article","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/Decodable-Implementations","abstract":[],"url":"\