{"type":"text","text":"returned by "},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"type":"text","text":". It is valid on the graph that added it"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":"; on another graph it traps.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeMap","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","role":"symbol","navigatorTitle":[{"text":"EdgeMap","kind":"identifier"}]}}}