phs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceMatrix"}],"type":"topic","title":"IncidenceMatrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"title":"IncidenceMatrix.MemberIndices","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member","type":"text"},{"text":" ","type":"text"},{"text":"indices, or a vertex’s column indices (","type":"text"},{"type":"codeVoice","code":"IncidentHyperedgeIndices"},{"text":"). No copy and no","type":"text"},{"text":" ","type":"text"},{"text":"allocation, unlike a ","type":"text"},{"code":"BitSet","type":"codeVoice"},{"text":". It shares the matrix’s words copy-on-write, so a later","type":"text"},{"text":" ","type":"text"},{"text":"mutation of the matrix leaves it unchanged.","type":"text"}],"navigatorTitle":[{"text":"MemberIndices","kind":"identifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MemberIndices","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"title":"IncidenceMatrixModule","abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","role":"collection"}}}