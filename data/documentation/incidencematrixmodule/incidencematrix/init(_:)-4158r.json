{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4158r"},"kind":"symbol","abstract":[{"text":"The union of the oriented matrix’s planes: each column its sources and targets together.","type":"text"},{"text":" ","type":"text"},{"text":"A new hypergraph: it carries none of ","type":"text"},{"code":"oriented","type":"codeVoice"},{"text":"’s attached maps.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"oriented"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","text":"OrientedIncidenceMatrix"},{"kind":"text","text":")"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"style":"note","content":[{"inlineContent":[{"text":"O(n·⌈m\/64⌉ + m·⌈n\/64⌉): the planes’ words ORed, then the counts recounted.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside"}]}],"metadata":{"title":"init(_:)","externalID":"s:21IncidenceMatrixModule0aB0VyAcA08OrientedaB0Vcfc","roleHeading":"Initializer","extendedModule":"IncidenceMatrixModule","symbolKind":"init","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V","text":"OrientedIncidenceMatrix","kind":"typeIdentifier"},{"text":")","kind":"t