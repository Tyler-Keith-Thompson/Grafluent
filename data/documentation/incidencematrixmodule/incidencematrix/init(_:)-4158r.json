{"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"]]},"sections":[],"abstract":[{"type":"text","text":"The union of the oriented matrix’s planes: each column its sources and targets together."},{"type":"text","text":" "},{"type":"text","text":"A new hypergraph: it carries none of "},{"code":"oriented","type":"codeVoice"},{"type":"text","text":"’s attached maps."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"oriented","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"typeIdentifier","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V"},{"text":")","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n·⌈m\/64⌉ + m·⌈n\/64⌉): the planes’ words ORed, then the counts recounted.","type":"text"}]}],"style":"note"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-4158r"]}],"metadata":{"title":"init(_:)","modules":[{"name":"IncidenceMatrixModule"}],"externalID":"s:21IncidenceMatrixModule0aB0VyAcA08OrientedaB0Vcfc","remoteSource":{"fileName":"IncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/IncidenceMatrix.swift#L206"},"symbolKind":"init","extendedModule":"IncidenceMatrixModule","role":"symbol","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V","text":"OrientedIncidenceMatrix","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4158r"},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"kind":"symbol","abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"type":"topic","title":"IncidenceMatrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"type":"topic","role":"symbol","title":"OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol","abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/init(_:)-4158r":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4158r","type":"topic","kind":"symbol","title":"init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V","text":"OrientedIncidenceMatrix","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"The union of the oriented matrix’s planes: each column its sources and targets together."},{"type":"text","text":" "},{"type":"text","text":"A new hypergraph: it carries none of "},{"type":"codeVoice","code":"oriented"},{"type":"text","text":"’s attached maps."}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-4158r","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"type":"topic","role":"collection","title":"IncidenceMatrixModule","abstract":[],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule"}}}