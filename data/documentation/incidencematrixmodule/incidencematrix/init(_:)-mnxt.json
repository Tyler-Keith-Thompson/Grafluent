irected hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"kind":"symbol","title":"IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","type":"topic","role":"collection","abstract":[]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"kind":"symbol","title":"IncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","type":"topic","role":"symbol","abstract":[{"text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set","type":"text"},{"text":" ","type":"text"},{"text":"when vertex ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a member of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":". The vertices are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" and the columns,","type":"text"},{"text":" ","type":"text"},{"text":"the hyperedges, are at positions ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"Hypergraph"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" algorithms run on it unchanged; it is not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" even when built from one,","type":"text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/init(_:)-mnxt":{"abstract":[{"text":"The one hypergraph conversion for a type that is both a directed graph and a directed","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph: read as a hypergraph.","type":"text"}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-mnxt","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-mnxt","title":"init(_:)","role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"H"},{"kind":"text","text":">("},{"text":"H","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic"}}}