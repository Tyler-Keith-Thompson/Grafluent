":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"title":"DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"}}}