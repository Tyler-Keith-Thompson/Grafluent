text":". The vertices are "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"Hypergraph","type":"codeVoice"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"kind":"symbol","title":"IncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"typ