n ","type":"text"},{"type":"codeVoice","code":"p"},{"text":". The vertices are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" and the columns,","type":"text"},{"text":" ","type":"text"},{"text":"the hyperedges, are at positions ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"Hypergraph"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" algorithms run on it unchanged; it is not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" even when built from one,","type":"text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"type":"topic","title":"DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","title":"DirectedHypergraph","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","type":"topic","kind":"symbol","abstract":[],"title":"IncidenceMatrixModule"}}}