rotocols\/DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"H"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","text":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"}]}],"kind":"declarations"}],"kind":"symbol","variants":[{"paths":["\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-mnxt"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"title":"DirectedHypergraph","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixMod