ceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"]]},"abstract":[{"type":"text","text":"The incidence matrix of a hypergraph: rows by vertex index, a column per hyperedge in"},{"type":"text","text":" "},{"code":"hyperedges","type":"codeVoice"},{"type":"text","text":" order."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-4zxvg"]}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"role":"collection","title":"IncidenceMatrixModule","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","abstract":[],"type":"topic","url":"\/documentation\/incidencematrixmodule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/init(_:)-4zxvg":{"role":"symbol","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-4zxvg","kind":"symbol","title":"init(_:)","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4zxvg","abstract":[{"text":"The incidence matrix of a hypergraph: rows by vertex index, a column per hyperedge in","type":"text"},{"text":" ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" order.","type":"text"}],"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP"},{"kind":"text","text":")"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","title":"IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","title":"Hypergraph","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"code":"incidenceGraph","type":"codeVoice"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}]}}}