e":"v"},{"text":" is a member of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":". The vertices are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" and the columns,","type":"text"},{"text":" ","type":"text"},{"text":"the hyperedges, are at positions ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"Hypergraph"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" algorithms run on it unchanged; it is not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" even when built from one,","type":"text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"type":"topic","title":"Hypergraph","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"url":"\/documentation\/graphprotocols\/hypergraph","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"code":"incidenceGraph","type":"codeVoice"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the