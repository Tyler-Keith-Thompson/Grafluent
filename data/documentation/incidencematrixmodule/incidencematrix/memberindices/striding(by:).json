uenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"variants":[{"paths":["\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices\/striding(by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices/striding(by:)":{"title":"striding(by:)","kind":"symbol","abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices\/striding(by:)","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices\/striding(by:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"striding","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"StridingSequence","preciseIdentifier":"s:10Algorithms16StridingSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"role":"collection","title":"IncidenceMatrixModule","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","abstract":[],"type":"topic","url":"\/documentation\/incidencematrixmodule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"type":"topic","title":"IncidenceMatrix.MemberIndices","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices","abstract":[{"type":"text","text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member"},{"type":"text","text":" "},{"type":"text","text":"indices, or a vertex’s column indices ("},{"type":"codeVoice","code":"IncidentHyperedgeIndices"},{"type":"text","text":"). No copy and no"},{"type":"text","text":" "},{"type":"text","text":"allocation, unlike a "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":". It shares the matrix’s words copy-on-write, so a later"},{"type":"text","text":" "},{"type":"text","text":"mutation of the matrix leaves it unchanged."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MemberIndices","kind":"identifier"}],"navigatorTitle":[{"text":"MemberIndices","kind":"identifier"}],"kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","title":"IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}]}}}