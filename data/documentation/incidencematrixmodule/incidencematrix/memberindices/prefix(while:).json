","text":" "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"role":"symbol","kind":"symbol","type":"topic","title":"IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceMatrix"}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceMatrix"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices/prefix(while:)":{"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices\/prefix(while:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prefix","kind":"identifier"},{"text":"(","kind":"text"},{"text":"while","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices\/prefix(while:)","title":"prefix(while:)","abstract":[]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"title":"IncidenceMatrix.MemberIndices","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member"},{"type":"text","text":" "},{"type":"text","text":"indices, or a vertex’s column indices ("},{"type":"codeVoice","code":"IncidentHyperedgeIndices"},{"type":"text","text":"). No copy and no"},{"type":"text","text":" "},{"type":"text","text":"allocation, unlike a "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":". It shares the matrix’s words copy-on-write, so a later"},{"type":"text","text":" "},{"type":"text","text":"mutation of the matrix leaves it unchanged."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemberIndices"}],"navigatorTitle":[{"kind":"identifier","text":"MemberIndices"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices"}}}