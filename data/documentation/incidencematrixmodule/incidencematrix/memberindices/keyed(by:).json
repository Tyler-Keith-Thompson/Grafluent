ice","code":"p"},{"text":". The vertices are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" and the columns,","type":"text"},{"text":" ","type":"text"},{"text":"the hyperedges, are at positions ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"Hypergraph"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" algorithms run on it unchanged; it is not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" even when built from one,","type":"text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"title":"IncidenceMatrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MemberIndices","kind":"identifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices","role":"symbol","title":"IncidenceMatrix.MemberIndices","navigatorTitle":[{"text":"MemberIndices","kind":"identifier"}],"abstract":[{"text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member","type":"text"},{"text":" ","type":"text"},{"text":"indices, or a vertex’s column indices (","type":"text"},{"code":"IncidentHyperedgeIndices","type":"codeVoice"},{"text":"). No copy and