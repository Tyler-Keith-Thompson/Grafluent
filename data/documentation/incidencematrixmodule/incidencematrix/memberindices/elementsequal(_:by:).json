"text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member","type":"text"},{"text":" ","type":"text"},{"text":"indices, or a vertex’s column indices (","type":"text"},{"type":"codeVoice","code":"IncidentHyperedgeIndices"},{"text":"). No copy and no","type":"text"},{"text":" ","type":"text"},{"text":"allocation, unlike a ","type":"text"},{"code":"BitSet","type":"codeVoice"},{"text":". It shares the matrix’s words copy-on-write, so a later","type":"text"},{"text":" ","type":"text"},{"text":"mutation of the matrix leaves it unchanged.","type":"text"}],"navigatorTitle":[{"text":"MemberIndices","kind":"identifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MemberIndices","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"title":"IncidenceMatrixModule","abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","role":"collection"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices/elementsEqual(_:by:)":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices\/elementsEqual(_:by:)","title":"elementsEqual(_:by:)","abstract":[],"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices\/elementsequal(_:by:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elementsEqual","kind":"identifier"},{"text":"<","kind":"text"},{"text":"OtherSequence","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"OtherSequence","kind":"typeIdentifier"},{"text":", ","kind":"text