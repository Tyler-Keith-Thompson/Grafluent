text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","title":"IncidenceMatrixModule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","abstract":[],"role":"collection","type":"topic","kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","title":"IncidenceMatrix.MemberIndices","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemberIndices"}],"abstract":[{"text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member","type":"text"},{"text":" ","type":"text"},{"text":"indices, or a vertex’s column indices (","type":"text"},{"code":"IncidentHyperedgeIndices","type":"codeVoice"},{"text":"). No copy and no","type":"text"},{"text":" ","type":"text"},{"text":"allocation, unlike a ","type":"text"},{"code":"BitSet","type":"codeVoice"},{"text":". It shares the matrix’s words copy-on-write, so a later","type":"text"},{"text":" ","type":"text"},{"text":"mutation of the matrix leaves it unchanged.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MemberIndices"}],"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices"}}}