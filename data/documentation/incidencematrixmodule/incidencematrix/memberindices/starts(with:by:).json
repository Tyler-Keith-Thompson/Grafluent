text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"starts","kind":"identifier"},{"text":"<","kind":"text"},{"text":"PossiblePrefix","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PossiblePrefix","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":", ","kind":"text"},{"text":"PossiblePrefix","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices\/starts(with:by:)","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices\/starts(with:by:)","kind":"symbol","title":"starts(with:by:)","abstract":[],"type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"role":"symbol","title":"IncidenceMatrix","abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/incidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","title":"IncidenceMatrixModule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"role":"symbol","title":"IncidenceMatrix.MemberIndices","abstract":[{"type":"text","text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member"},{"type":"text","text":" "},{"type":"text","text":"indices, or a vertex’s column indices ("},{"type":"codeVoice","code":"IncidentHyperedgeIndices"},{"type":"text","text":"). No copy and no"},{"type":"text","text":" "},{"type":"text","text":"allocation, unlike a "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":". It shares the matrix’s words copy-on-write, so a later"},{"type":"text","text":" "},{"type":"text","text":"mutation of the matrix leaves it unchanged."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemberIndices"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","navigatorTitle":[{"kind":"identifier","text":"MemberIndices"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices"}}}