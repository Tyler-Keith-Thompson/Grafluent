 column indices ("},{"code":"IncidentHyperedgeIndices","type":"codeVoice"},{"type":"text","text":"). No copy and no"},{"type":"text","text":" "},{"type":"text","text":"allocation, unlike a "},{"code":"BitSet","type":"codeVoice"},{"type":"text","text":". It shares the matrix’s words copy-on-write, so a later"},{"type":"text","text":" "},{"type":"text","text":"mutation of the matrix leaves it unchanged."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemberIndices"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"abstract":[{"text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set","type":"text"},{"text":" ","type":"text"},{"text":"when vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of column ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":". The vertices are "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"Hypergraph","type":"codeVoice"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"kind":"symbol","title":"IncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind