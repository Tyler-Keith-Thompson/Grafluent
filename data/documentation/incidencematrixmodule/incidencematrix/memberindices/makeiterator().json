t":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/incidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","title":"IncidenceMatrixModule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices/makeIterator()":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices\/makeIterator()","title":"makeIterator()","role":"symbol","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices\/makeiterator()","type":"topic","abstract":[],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"IncidenceMatrix","kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule0aB0V"},{"text":".","kind":"text"},{"text":"MemberIndices","kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule0aB0V13MemberIndicesV"},{"text":".","kind":"text"},{"text":"Iterator","kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule0aB0V13MemberIndicesV8IteratorV"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"role":"symbol","title":"IncidenceMatrix.MemberIndices","abstract":[{"type":"text","text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member"},{"type":"text","text":" "},{"type":"text","text":"indices, or a vertex’s column indices ("},{"type":"codeVoice","code":"IncidentHyperedgeIndices"},{"type":"text","text":"). No copy and no"},{"type":"text","text":" "},{"type":"text","text":"allocation, unlike a "},{"type":"codeVoice","code":"BitSet"},{"type":"text","text":". It shares the matrix’s words copy-on-write, so a later"},{"type":"text","text":" "},{"type":"text","text":"mutation of the matrix leaves it unchanged."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemberIndices"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","navigatorTitle":[{"kind":"identifier","text":"MemberIndices"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices"}}}