tex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of column ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":". The vertices are "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"Hypergraph","type":"codeVoice"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"kind":"symbol","title":"IncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices/reductions(into:_:)":{"abstract":[],"title":"reductions(into:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reductions"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Result"},{"kind":"text","text":">("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":", ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"