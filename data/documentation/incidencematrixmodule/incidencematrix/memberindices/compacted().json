le":[{"text":"MemberIndices","kind":"identifier"}],"kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","title":"IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices/compacted()":{"role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices\/compacted()","kind":"symbol","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices\/compacted()","abstract":[],"type":"topi