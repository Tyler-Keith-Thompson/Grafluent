{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/defaultMaximumDecodedWordCount"},"kind":"symbol","abstract":[{"type":"text","text":"The most words (8 bytes each) a decoded matrix may take by default: 2²⁴, 128 MiB. An"},{"type":"text","text":" "},{"type":"text","text":"n × m matrix stores n·⌈m\/64⌉ + m·⌈n\/64⌉ words of bits and n + m counts, and an"},{"type":"text","text":" "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":" twice that. A short payload can name a large shape (43 bytes"},{"type":"text","text":" "},{"type":"text","text":"name 2²⁸ vertices), so decoding refuses one whose storage would pass the limit unless the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"code":"userInfo[maximumDecodedWordCountKey]","type":"codeVoice"},{"type":"text","text":" allows it."}],"variants":[{"paths":["\/documentation\/incidencematrixmodule\/incidencematrix\/defaultmaximumdecodedwordcount"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultMaximumDecodedWordCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"]]},"metadata":{"roleHeading":"Type Property","externalID":"s:21IncidenceMatrixModule0aB0V30defaultMaximumDecodedWordCountSivpZ","modules":[{"name":"IncidenceMatrixModule"}],"remoteSource":{"fileName":"IncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Graflue