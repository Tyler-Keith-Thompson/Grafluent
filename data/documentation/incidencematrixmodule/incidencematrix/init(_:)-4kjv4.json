{"abstract":[{"type":"text","text":"The one hypergraph conversion for a type that is both a graph and a hypergraph: read as a"},{"type":"text","text":" "},{"type":"text","text":"hypergraph."}],"sections":[],"variants":[{"paths":["\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-4kjv4"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"]]},"metadata":{"title":"init(_:)","role":"symbol","externalID":"s:21IncidenceMatrixModule0aB0VyACxc14GraphProtocols0D0RzAD10HypergraphRzlufc","extendedModule":"IncidenceMatrixModule","modules":[{"name":"IncidenceMatrixModule"}],"symbolKind":"init","remoteSource":{"fileName":"IncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/IncidenceMatrix.swift#L225"},"fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":")","kind":"text"}],"roleHeading":"Initializer"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4kjv4"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"init","kind":"keyword"},{"text":"<","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hypergraph","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Graph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"},{"text":", ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hypergraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP"}],"languages":["swift"]}],"kind":"declarations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"kind":"symbol","title":"IncidenceMatrixModule","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","role":"collection","url":"\/documentation\/incidencematrixmodule"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/init(_:)-4kjv4":{"abstract":[{"type":"text","text":"The one hypergraph conversion for a type that is both a graph and a hypergraph: read as a"},{"type":"text","text":" "},{"type":"text","text":"hypergraph."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4kjv4","kind":"symbol","title":"init(_:)","type":"topic","role":"symbol","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-4kjv4"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"role":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"title":"Hypergraph","kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"code":"incidenceGraphView","type":"codeVoice"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"abstract":[{"type":"text","text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set"},{"type":"text","text":" "},{"type":"text","text":"when vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":". The vertices are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"Hypergraph"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"kind":"symbol","title":"IncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol","url":"\/documentation\/incidencematrixmodule\/incidencematrix"}}}