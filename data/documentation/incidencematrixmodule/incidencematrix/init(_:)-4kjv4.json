xt":" "},{"type":"text","text":"how the graph algorithms reach it."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"kind":"symbol","title":"Graph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/init(_:)-4kjv4":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/init(_:)-4kjv4","title":"init(_:)","url":"\/documentation\/incidencematrixmodule\/incidencematrix\/init(_:)-4kjv4","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"The one hypergraph conversion for a type that is both a graph and a hypergraph: read as a","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph.","type":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"abstract":[{"text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set","type":"text"},{"text":" ","type":"text"},{"text":"when vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of column ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":". The vertices are "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" and the columns,"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges, are at positions "},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"Hypergraph","type":"codeVoice"},{"type":"text","text":", so the"},{"type":"text","text":" "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms run on it unchanged; it is not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" even when built from one,"},{"type":"text","text":" "},{"type":"text","text":"because a cell edit can give a column any number of bits."}],"kind":"symbol","title":"IncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"role":"symbol"}}}