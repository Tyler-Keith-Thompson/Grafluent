,{"kind":"text","text":" "},{"kind":"identifier","text":"outDegree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":" "},{"kind":"internalParam","text":"vertex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","text":"VertexNotFound","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"VertexNotFound","type":"codeVoice"},{"type":"text","text":" when "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":" is not in "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":"."}]}],"style":"note","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/outdegree(checked:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"url":"\/documentation\/graphprotocols\/vertexnotfound","title":"VertexNotFound","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","abstract":[{"type":"text","text":"The error a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" call throws when a vertex it was given isn’t in the graph. Named after"},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s "},{"type":"codeVoice","code":"NodeNotFound"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexNotFound","kind":"identifier"}],"navigatorTitle":[{"text":"VertexNotFound","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","title":"IncidenceMatrixModule","role":"collection"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","kind":"symbol","title":"OrientedIncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/outDegree(checked:)":{"title":"outDegree(checked:)","kind":"symbol","type":"topic","abstract":[{"code":"outDegree(of:)","type":"codeVoice"},{"text":", throwing instead of trapping when ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" is not in ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"O(1).","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outDegree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/outDegree(checked:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/outdegree(checked:)"}}}