> "},{"kind":"typeIdentifier","text":"OrientedIncidenceMatrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"IncidentHyperedgeIndices","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/IncidentHyperedgeIndices","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V24IncidentHyperedgeIndicesa"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/outhyperedgeindices(ofindex:)"]}],"abstract":[{"type":"text","text":"The columns with "},{"type":"codeVoice","code":"index"},{"type":"text","text":" among their sources, read in place without a copy."}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/outHyperedgeIndices(ofIndex:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outHyperedgeIndices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"OrientedIncidenceMatrix","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"IncidentHyperedgeIndices","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V24IncidentHyperedgeIndicesa"}],"type":"topic","title":"outHyperedgeIndices(ofIndex:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/outhyperedgeindices(ofindex:)","abstract":[{"type":"text","text":"The columns with "},{"code":"index","type":"codeVoice"},{"type":"text","text":" among their sources, read in place without a copy."}],"role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/outHyperedgeIndices(ofIndex:)"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"DirectedHypergraph","type":"codeVoice"},{"type":"text","text":", so the "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":"."}],"title":"OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/IncidentHyperedgeIndices":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/IncidentHyperedgeIndices","title":"OrientedIncidenceMatrix.IncidentHyperedgeIndices","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidentHyperedgeIndices"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IncidentHyperedgeIndices"}],"abstract":[{"type":"text","text":"The stored row of either plane, read in place."}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/incidenthyperedgeindices"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","type":"topic","kind":"symbol","abstract":[],"title":"IncidenceMatrixModule"}}}