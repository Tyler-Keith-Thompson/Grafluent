,{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/sources(ofHyperedgeAt:)":{"title":"sources(ofHyperedgeAt:)","type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/sources(ofhyperedgeat:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sources"},{"kind":"text","text":"("},{"text":"ofHyperedgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"BitSet","preciseIdentifier":"s:14BitCollections0A3SetV","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/sources(ofHyperedgeAt:)","abstract":[{"type":"text","text":"The sources of the column at "},{"type":"codeVoice","code":"position"},{"type":"text","text":": the source plane’s column. O(⌈n\/64⌉)."}],"role":"symbol"}}}