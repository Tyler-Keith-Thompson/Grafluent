t"}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct/enumerated()":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/enumerated()","type":"topic","title":"enumerated()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enumerated","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EnumeratedSequence","kind":"typeIdentifier","preciseIdentifier":"s:s18EnumeratedSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct\/enumerated()","role":"symbol","abstract":[]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","title":"IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection","kind":"symbol","type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"role":"symbol","title":"OrientedIncidenceMatrix.Hyperedges","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Hyperedges"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hyperedges"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic"}}}