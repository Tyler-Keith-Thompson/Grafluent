xModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/indices(where:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"where","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RangeSet","preciseIdentifier":"s:s8RangeSetV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"navigatorTitle":[{"text":"Hyperedges","kind":"identifier"}],"kind":"symbol","title":"OrientedIncidenceMatrix.Hyperedges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hyperedges","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"kind":"symbol","title":"IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","type":"topic","role":"collection","abstract":[]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"title":"OrientedIncidenceMatrix","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","kind":"symbol"}}}