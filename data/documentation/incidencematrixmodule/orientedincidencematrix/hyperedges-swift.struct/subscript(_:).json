":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/subscript(_:)","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct"]]},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"title":"OrientedIncidenceMatrix.Hyperedges","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hyperedges","kind":"identifier"}],"abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}],"navigatorTitle":[{"text":"Hyperedges","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"type":"topic","title":"IncidenceMatrixModule","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct/subscript(_:)":{"title":"subscript(_:)","role":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/subscript(_:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct\/subscript(_:)","kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> (sources"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14BitCollections0A3SetV","text":"BitSet"},{"kind":"text","text":", targets"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14BitCollections0A3SetV","text":"BitSet"},{"kind":"text","text":")"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"role":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic","kind":"symbol"}}}