tedincidencematrix\/hyperedges-swift.struct\/evenlychunked(in:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct/evenlyChunked(in:)":{"kind":"symbol","title":"evenlyChunked(in:)","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/evenlyChunked(in:)","type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct\/evenlychunked(in:)","abstract":[],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"evenlyChunked","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"EvenlyChunkedCollection","preciseIdentifier":"s:10Algorithms23EvenlyChunkedCollectionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hyperedges"}],"abstract":[{"text":"Every column as its sources and targets, at its position.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Hyperedges"}],"title":"OrientedIncidenceMatrix.Hyperedges","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","type":"topic","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","abstract":[],"title":"IncidenceMatrixModule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","kind":"symbol","type":"topic","role":"collection"}}}