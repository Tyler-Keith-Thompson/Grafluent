ctedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hyperedges"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Hyperedges"}],"title":"OrientedIncidenceMatrix.Hyperedges","kind":"symbol","abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"kind":"symbol","title":"IncidenceMatrixModule","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","role":"collection","url":"\/documentation\/incidencematrixmodule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct/indices":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"indices"},{"kind":"text","text":": "},{"kind"