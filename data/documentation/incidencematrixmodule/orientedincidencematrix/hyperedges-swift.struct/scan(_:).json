:" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct/scan(_:)":{"deprecated":true,"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/scan(_:)","role":"symbol","title":"scan(_:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct\/scan(_:)","kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scan"},{"kin