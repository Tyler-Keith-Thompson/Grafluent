ifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct\/count(where:)"]}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/count(where:)"},"abstract":[{"text":"Inherited from ","type":"text"},{"code":"Sequence.count(where:)","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","type":"topic","abstract":[{"text":"Every column as its sources and targets, at its position.","type":"text"}],"title":"OrientedIncidenceMatrix.Hyperedges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hyperedges"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swi