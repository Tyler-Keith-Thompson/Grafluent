 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"kind":"symbol","title":"IncidenceMatrixModule","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","role":"collection","url":"\/documentation\/incidencematrixmodule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct/randomSample(count:using:)-4n67":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"randomSample"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"externalParam","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using