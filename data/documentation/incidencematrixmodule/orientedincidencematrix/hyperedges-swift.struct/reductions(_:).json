":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"title":"OrientedIncidenceMatrix.Hyperedges","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hyperedges"}],"navigatorTitle":[{"kind":"identifier","text":"Hyperedges"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedInc