aph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"title":"OrientedIncidenceMatrix","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hyperedges"}],"abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}],"title":"OrientedIncidenceMatrix.Hyperedges","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Hyperedges"}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct/endOfPrefix(while:)":{"abstract":[],"kind":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct\/endofprefix(while:)","role":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedge