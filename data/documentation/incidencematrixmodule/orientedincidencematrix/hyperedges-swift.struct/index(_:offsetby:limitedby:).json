ections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"i","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"offsetBy","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"distance","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"limitedBy","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"limit","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/index(_:offsetBy:limitedBy:)"},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"role":"collection","title":"IncidenceMatrixModule","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","abstract":[],"type":"topic","url":"\/documentation\/incidencematrixmodule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.st