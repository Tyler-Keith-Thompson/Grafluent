ypeIdentifier","text":"Subject"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct\/uniqued(on:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct\/uniqued(on:)","type":"topic","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"kind":"symbol","title":"IncidenceMatrixModule","abstract":[],"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"kind":"symbol","title":"OrientedIncidenceMatrix.Hyperedges","navigatorTitle":[{"kind":"identifier","text":"Hyperedges"}],"abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hyperedges"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct","type":"topic","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"title":"OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]}}}