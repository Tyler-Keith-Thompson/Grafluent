:14GraphProtocols18DirectedHypergraphP"},{"kind":"text","text":")"}],"symbolKind":"init","modules":[{"name":"IncidenceMatrixModule"}],"role":"symbol","extendedModule":"IncidenceMatrixModule","externalID":"s:21IncidenceMatrixModule08OrientedaB0VyACxc14GraphProtocols18DirectedHypergraphRzlufc"},"abstract":[{"type":"text","text":"The oriented matrix of a directed hypergraph: rows by vertex index, a column per hyperedge"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" order."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(_:)-6qyfl":{"abstract":[{"type":"text","text":"The oriented matrix of a directed hypergraph: rows by vertex index, a column per hyperedge"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" order."}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-6qyfl","kind":"symbol","type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(_:)-6qyfl","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","text":"DirectedHypergraph","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(_:)","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"type":"topic","role":"symbol","title":"OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol","abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"type":"topic","role":"collection","title":"IncidenceMatrixModule","abstract":[],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"type":"topic","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"title":"DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"}}}