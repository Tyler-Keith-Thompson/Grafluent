e":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/targetIndices(ofHyperedgeAt:)":{"abstract":[{"type":"text","text":"The targets of the column at "},{"type":"codeVoice","code":"position"},{"type":"text","text":", read in place without a copy."}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/targetIndices(ofHyperedgeAt:)","title":"targetIndices(ofHyperedgeAt:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/targetindices(ofhyperedgeat:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"targetIndices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofHyperedgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V","text":"OrientedIncidenceMatrix","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V13MemberIndicesa","text":"MemberIndices","kind":"typeIdentifier"}],"type":"topic"