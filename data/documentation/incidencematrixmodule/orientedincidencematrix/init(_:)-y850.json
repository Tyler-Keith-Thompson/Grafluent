{"kind":"symbol","metadata":{"modules":[{"name":"IncidenceMatrixModule"}],"roleHeading":"Initializer","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L154","fileName":"OrientedIncidenceMatrix.swift"},"extendedModule":"IncidenceMatrixModule","title":"init(_:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":")","kind":"text"}],"externalID":"s:21IncidenceMatrixModule08OrientedaB0VyACxc14GraphProtocols08DirectedE0RzAD0G10HypergraphRzlufc","symbolKind":"init"},"variants":[{"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(_:)-y850"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"<","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hypergraph","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedHypergraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP"}],"platforms":["Linux"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"The one hypergraph conversion for a type that is both a directed graph and a directed"},{"type":"text","text":" "},{"type":"text","text":"hypergraph: read as a hypergraph."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-y850","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"]]},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"type":"topic","title":"IncidenceMatrixModule","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(_:)-y850":{"title":"init(_:)","role":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-y850","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(_:)-y850","kind":"symbol","abstract":[{"type":"text","text":"The one hypergraph conversion for a type that is both a directed graph and a directed"},{"type":"text","text":" "},{"type":"text","text":"hypergraph: read as a hypergraph."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"H"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"H"},{"kind":"text","text":")"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"role":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"type":"topic","title":"DirectedHypergraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}]}}}