ants":[{"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(_:)-y850"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-y850","interfaceLanguage":"swift"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"kind":"symbol","abstract":[],"title":"IncidenceMatrixModule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","type":"topic","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","type":"topic","title":"DirectedHypergraph","kind":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(_:)-y850":{"type":"topic","title":"init(_:)","abstract":[{"type":"text","text":"The one hypergraph conversion for a type that is both a directed graph and a directed"},{"type":"text","text":" "},{"type":"text","text":"hypergraph: read as a hypergraph."}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-y850","role":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(_:)-y850","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"title":"OrientedIncidenceMatrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","role":"symbol"}}}