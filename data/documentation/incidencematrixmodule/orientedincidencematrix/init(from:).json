{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]}]}],"abstract":[{"type":"text","text":"Decodes the form "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" writes, throwing "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for a negative"},{"type":"text","text":" "},{"type":"text","text":"vertex count, storage over "},{"type":"codeVoice","code":"IncidenceMatrix.maximumDecodedWordCountKey"},{"type":"text","text":"‘s limit (two planes’ words), a vertex"},{"type":"text","text":" "},{"type":"text","text":"out of range, a side not strictly ascending, or "},{"type":"codeVoice","code":"sources"},{"type":"text","text":" and "},{"type":"codeVoice","code":"targets"},{"type":"text","text":" of different"},{"type":"text","text":" "},{"type":"text","text":"lengths."}],"metadata":{"title":"init(from:)","externalID":"s:21IncidenceMatrixModule08OrientedaB0V4fromACs7Decoder_p_tKcfc","modules":[{"name":"IncidenceMatrixModule"}],"roleHeading":"Initializer","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L515","fileName":"OrientedIncidenceMatrix.swift"},"extendedModule":"IncidenceMatrixModule","symbolKind":"init","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Decoder","preciseIdentifier":"s:s7DecoderP"},{"kind":"text