text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(from:)":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(from:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"kind":"symbol","role":"symbol","title":"init(from:)","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(from:)","abstract":[{"text":"Decodes the form ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" writes, throwing ","type":"text"},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"text":" for a negative","type":"text"},{"text":" ","type":"text"},{"text":"vertex count, storage over ","type":"text"},{"code":"IncidenceMatrix.maximumDecodedWordCountKey","type":"codeVoice"},{"text":"‘s limit (two planes’ words), a vertex","type":"text"},{"text":" ","type":"text"},{"text":"out of range, a side not strictly ascending, or ","type":"text"},{"code":"sources","