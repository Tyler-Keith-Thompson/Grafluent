type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","title":"IncidenceMatrixModule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(from:)":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(from:)","title":"init(from:)","role":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(from:)","type":"topic","abstract":[{"text":"Decodes the form ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" writes, throwing ","type":"text"},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"text":" for a negative","type":"text"},{"text":" ","type":"text"},{"text":"vertex count, storage over ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix.maximumDecodedWordCountKey"},{"text":"‘s limit (two planes’ words), a vertex","type":"text"},{"text":" ","type":"text"},{"text":"out of range, a side not strictly ascending, or ","type":"text"},{"type":"codeVoice","code":"sources"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"targets"},{"text":" of different","type":"text"},{"text":" ","type":"text"},{"text":"lengths.","type":"text"}],"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam",