mentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","abstract":[],"title":"IncidenceMatrixModule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","kind":"symbol","type":"topic","role":"collection"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","role":"symbol"}}}