":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","title":"IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection","kind":"symbol","type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(from:)":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(from:)","abstract":[{"text":"Decodes the form ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" writes, throwing ","type":"text"},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"text":" for a negative","type":"text"},{"text":" ","type":"text"},{"text":"vertex count, storage over ","type":"text"},{"code":"IncidenceMatrix.maximumDecodedWordCountKey","type":"codeVoice"},{"text":"‘s limit (two planes’ words), a vertex","type":"text"},{"text":" ","type":"text"},{"text":"out of range, a side not strictly ascending, or ","type":"text"},{"code":"sources","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"targets","type":"codeVoice"},{"text":" of different","type":"text"},{"text":" ","type":"text"},{"text":"lengths.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{