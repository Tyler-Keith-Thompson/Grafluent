odeVoice","code":"position"},{"type":"text","text":"): target − source, so −1 for a source, +1 for a target, and 0"},{"type":"text","text":" "},{"type":"text","text":"for neither or both. O(1)."}],"sections":[],"metadata":{"role":"symbol","title":"subscript(vertex:hyperedge:)","modules":[{"name":"IncidenceMatrixModule"}],"externalID":"s:21IncidenceMatrixModule08OrientedaB0V6vertex9hyperedgeS2i_Sitcip","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"vertex","kind":"externalParam"},{"text":" _: ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"hyperedge","kind":"externalParam"},{"text":" _: ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"extendedModule":"IncidenceMatrixModule","remoteSource":{"fileName":"OrientedIncidenceMatrix.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L179"},"roleHeading":"Instance Subscript","symbolKind":"subscript"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","kind":"symbol","title":"OrientedIncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/subscript(vertex:hyperedge:)":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/subscript(vertex:hyperedge:)","title":"subscript(vertex:hyperedge:)","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/subscript(vertex:hyperedge:)","abstract":[{"type":"text","text":"Entry ("},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":"): target − source, so −1 for a source, +1 for a target, and 0"},{"type":"text","text":" "},{"type":"text","text":"for neither or both. O(1)."}],"fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"vertex","kind":"externalParam"},{"text":"