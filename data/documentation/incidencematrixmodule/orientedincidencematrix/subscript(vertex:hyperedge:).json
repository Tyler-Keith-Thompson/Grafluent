:[{"text":"","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"position","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/subscript(vertex:hyperedge:)"},"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"]]},"abstract":[{"text":"Entry (","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":"): target − source, so −1 for a source, +1 for a target, and 0","type":"text"},{"text":" ","type":"text"},{"text":"for neither or both. O(1).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/subscript(vertex:hyperedge:)"]}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"role":"collection","title":"IncidenceMatrixModule","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","abstract":[],"type":"topic","url":"\/documentation\/incidencematrixmodule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeV