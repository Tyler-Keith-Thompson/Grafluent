ole":"symbol","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"vertex","kind":"externalParam"},{"kind":"text","text":" _: "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"hyperedge"},{"kind":"text","text":" _: "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L179","fileName":"OrientedIncidenceMatrix.swift"},"modules":[{"name":"IncidenceMatrixModule"}],"externalID":"s:21IncidenceMatrixModule08OrientedaB0V6vertex9hyperedgeS2i_Sitcip","title":"subscript(vertex:hyperedge:)","extendedModule":"IncidenceMatrixModule"},"kind":"symbol","abstract":[{"text":"Entry (","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", ","type":"text"},{"type":"codeVoice","code":"position"},{"text":"): target − source, so −1 for a source, +1 for a target, and 0","type":"text"},{"text":" ","type":"text"},{"text":"for neither or both. O(1).","type":"text"}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/subscript(vertex:hyperedge:)":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/subscript(vertex:hyperedge:)","title":"subscript(vertex:hyperedge:)","kind":"symbol","role":"symbol","abstract":[{"text":"Entry (","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", ","type":"text"},{"type":"codeVoice","code":"position"},{"text":"): target − source, so −1 for a source, +1 for a target, and 0","type":"text"},{"text":" ","type":"text"},{"text":"for neither or both. O(1).","type":"text"}],"type":"topic","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"