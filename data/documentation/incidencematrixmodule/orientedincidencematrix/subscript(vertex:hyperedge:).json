{"abstract":[{"type":"text","text":"Entry ("},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", "},{"code":"position","type":"codeVoice"},{"type":"text","text":"): target − source, so −1 for a source, +1 for a target, and 0"},{"type":"text","text":" "},{"type":"text","text":"for neither or both. O(1)."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertex"},{"kind":"text","text":" "},{"kind":"internalParam","text":"vertex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"hyperedge"},{"kind":"text","text":" "},{"kind":"internalParam","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":" is in ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"position"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":".","type":"text"}]}],"name":"Precondition","style":"note","type":"aside"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"]]},"metadata":{"roleHeading":"Instance Subscript","extendedModule":"IncidenceMatrixModule","title":"subscript(vertex:hyperedge:)","fragments":