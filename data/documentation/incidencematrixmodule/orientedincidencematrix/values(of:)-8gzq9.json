text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"url":"\/documentation\/graphprotocols\/edgemap","title":"EdgeMap","abstract":[{"text":"A handle to a map from edge positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"ArcMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"returned by "},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"type":"text","text":". It is valid on the graph that added it"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":"; on another graph it traps.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeMap","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","role":"symbol","navigatorTitle":[{"text":"EdgeMap","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"kind":"symbol","title":"IncidenceMatrixModule","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","role":"collection","url":"\/documentation\/incidencematrixmodule"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeValues":{"abstract":[{"text":"A snapshot of an edge map’s values, read by edge position like an array: what","type":"text"},{"text":" ","type":"text"},{"code":"PropertyGraph.values(of:)","type":"codeVoice"},{"text":" returns, after ","type":"text"},{"code":"Dictionary.Values","type":"codeVoice"},{"text":". It holds the map’s storage, not","type":"text"},{"text":" ","type":"text"},{"text":"the graph, so later mutations of the graph or the map do not show through.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeValues"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeValues","kind":"symbol","title":"EdgeValues","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EdgeValues"}],"url":"\/documentation\/graphprotocols\/edgevalues"}}}