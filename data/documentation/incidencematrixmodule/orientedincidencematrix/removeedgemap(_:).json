keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol","abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"kind":"symbol","abstract":[{"text":"A handle to a map from edge positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"ArcMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"returned by ","type":"text"},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"text":". It holds no values: read and write them","type":"text"},{"text":" ","type":"text"},{"text":"through the graph, ","type":"text"},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"text":". It is valid on the graph that added it","type":"text"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":"; on another graph it traps.","type":"text"}],"type":"topic","title":"EdgeMap","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeMap","kind":"identifier"}],"navigatorTitle":[{"text":"EdgeMap","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/edgemap"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"type":"topic","role":"collection","title":"IncidenceMatrixModule","abstract":[],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule"}}}