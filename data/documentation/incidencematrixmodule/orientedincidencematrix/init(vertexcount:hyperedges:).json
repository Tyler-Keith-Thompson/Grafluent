xt":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"vertexCount >= 0"},{"type":"text","text":", and every vertex listed is in "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n·⌈m\/64⌉ + m·⌈n\/64⌉ + p)."}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"title":"init(vertexCount:hyperedges:)","externalID":"s:21IncidenceMatrixModule08OrientedaB0V11vertexCount10hyperedgesACSi_q0_tcSTRzSTR_STR0_Si7ElementRtzSiAFRt_x7sources_q_7targetstAFRt0_r1_lufc","modules":[{"name":"IncidenceMatrixModule"}],"extendedModule":"IncidenceMatrixModule","symbolKind":"init","roleHeading":"Initializer","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"hyperedges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeI