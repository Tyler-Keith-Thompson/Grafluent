hat changes, and "},{"type":"codeVoice","code":"removeAll"},{"type":"text","text":", start a new one. O(1)."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"generation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GraphGeneration","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A10GenerationV"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/generation","kind":"symbol","type":"topic","title":"generation","role":"symbol"}}}