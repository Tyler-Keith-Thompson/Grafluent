allottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"DirectedHypergraph","type":"codeVoice"},{"text":", so the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/generation":{"abstract":[{"text":"The current generation (see ","type":"text"},{"code":"GraphGeneration","type":"codeVoice"},{"text":"): every row or column appended, every cell of","type":"text"},{"text":" ","type":"text"},{"text":"either plane that changes, and ","type":"text"},{"code":"removeAll","type":"codeVoice"},{"text":", start a new one. O(1).","type":"text"}],"kind":"symbol","type":"topic","title":"generation","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"generation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GraphGeneration","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A10GenerationV"}],"i