hs":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/outdegree(of:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","type":"topic","kind":"symbol","abstract":[],"title":"IncidenceMatrixModule"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/outDegree(of:)":{"type":"topic","abstract":[{"text":"The number of columns with ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" among their sources. O(1), cached.","type":"text"}],"kind":"symbol","role":"symbol","title":"outDegree(of:)","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/outDegree(of:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/outdegree(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outDegree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"DirectedHypergraph","type":"codeVoice"},{"type":"text","text":", so the "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":"."}],"title":"OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol"}}}