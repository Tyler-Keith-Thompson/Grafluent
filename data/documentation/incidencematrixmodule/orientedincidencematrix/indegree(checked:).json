lParam","text":"checked"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","kind":"typeIdentifier","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/indegree(checked:)","title":"inDegree(checked:)","abstract":[{"type":"codeVoice","code":"inDegree(of:)"},{"type":"text","text":", throwing instead of trapping when "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" is not in "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"O(1)."}],"kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"url":"\/documentation\/graphprotocols\/vertexnotfound","title":"VertexNotFound","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","abstract":[{"type":"text","text":"The error a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" call throws when a vertex it was given isn’t in the graph. Named after"},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s "},{"type":"codeVoice","code":"NodeNotFound"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexNotFound","kind":"identifier"}],"navigatorTitle":[{"text":"VertexNotFound","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","kind":"symbol","title":"OrientedIncidenceMatrix","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"role":"symbol"}}}