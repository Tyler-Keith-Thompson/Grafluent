kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","kind":"typeIdentifier","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"VertexNotFound","type":"codeVoice"},{"text":" when ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" is not in ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Throws"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/indegree(checked:)"]}],"abstract":[{"code":"inDegree(of:)","type":"codeVoice"},{"type":"text","text":", throwing instead of trapping when "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":" is not in "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"O(1)."}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexNotFound","kind":"identifier"}],"navigatorTitle":[{"text":"VertexNotFound","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","title":"VertexNotFound","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The error a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" call throws when a vertex it was given isn’t in the graph. Named after"},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s "},{"type":"codeVoice","code":"NodeNotFound"},{"type":"text","text":"."}],"url":"\/documentation\/graphprotocols\/vertexnotfound"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"DirectedHypergraph","type":"codeVoice"},{"type":"text","text":", so the "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":"."}],"title":"OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol"},"doc://IncidenceMatrixModu