{"abstract":[{"type":"text","text":"The stored row of either plane, read in place."}],"hierarchy":{"paths":[["doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidentHyperedgeIndices"},{"kind":"text","text":" = "},{"preciseIdentifier":"s:21IncidenceMatrixModule0aB0V","kind":"typeIdentifier","text":"IncidenceMatrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix"},{"kind":"text","text":"."},{"preciseIdentifier":"s:21IncidenceMatrixModule0aB0V13MemberIndicesV","kind":"typeIdentifier","text":"MemberIndices","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices"}],"platforms":["Linux"],"languages":["swift"]}]}],"identifier":{"url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/IncidentHyperedgeIndices","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"IncidenceMatrixModule"}],"symbolKind":"typealias","navigatorTitle":[{"text":"IncidentHyperedgeIndices","kind":"identifier"}],"roleHeading":"Type Alias","role":"symbol","title":"OrientedIncidenceMatrix.IncidentHyperedgeIndices","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L209","fileName":"OrientedIncidenceMatrix.swift"},"externalID":"s:21IncidenceMatrixModule08OrientedaB0V24IncidentHyperedgeIndicesa","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidentHyperedgeIndices","kind":"identifier"}],"extendedModule":"IncidenceMatrixModule"},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/incidenthyperedgeindices"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/IncidentHyperedgeIndices":{"role":"symbol","title":"OrientedIncidenceMatrix.IncidentHyperedgeIndices","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/IncidentHyperedgeIndices","abstract":[{"text":"The stored row of either plane, read in place.","type":"text"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/incidenthyperedgeindices","navigatorTitle":[{"text":"IncidentHyperedgeIndices","kind":"identifier"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidentHyperedgeIndices","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","title":"IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection","kind":"symbol","type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"abstract":[{"text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set","type":"text"},{"text":" ","type":"text"},{"text":"when vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of column ","type":"text"},{"code":"p","type":"codeVoice"},{"text":". The vertices are ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" and the columns,","type":"text"},{"text":" ","type":"text"},{"text":"the hyperedges, are at positions ","type":"text"},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"Hypergraph","type":"codeVoice"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" algorithms run on it unchanged; it is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" even when built from one,","type":"text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}],"navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix","title":"IncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/incidencematrix","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceMatrix","kind":"identifier"}],"type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix/MemberIndices":{"url":"\/documentation\/incidencematrixmodule\/incidencematrix\/memberindices","abstract":[{"text":"The indices of the set bits of one stored row, ascending, read in place: a column’s member","type":"text"},{"text":" ","type":"text"},{"text":"indices, or a vertex’s column indices (","type":"text"},{"code":"IncidentHyperedgeIndices","type":"codeVoice"},{"text":"). No copy and no","type":"text"},{"text":" ","type":"text"},{"text":"allocation, unlike a ","type":"text"},{"code":"BitSet","type":"codeVoice"},{"text":". It shares the matrix’s words copy-on-write, so a later","type":"text"},{"text":" ","type":"text"},{"text":"mutation of the matrix leaves it unchanged.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MemberIndices"}],"title":"IncidenceMatrix.MemberIndices","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemberIndices"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/IncidenceMatrix\/MemberIndices","type":"topic"}}}