EdgeAt:)","interfaceLanguage":"swift"},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","title":"IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection","kind":"symbol","type":"topic"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"role":"symbol","title":"EdgeMap","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","abstract":[{"text":"A handle to a map from edge positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"ArcMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"returned by "},{"type":"codeVoice","code":"PropertyGraph.addEdgeMap(default:)"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"type":"codeVoice","code":"graph[handle, ofEdgeAt: position]"},{"type":"text","text":". It is valid on the graph that added it"},{"type":"text","text":" "},{"type":"text","text":"and on every copy of that graph, until "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":"; on another graph it traps."}],"type":"topic","url":"\/documentation\/graphprotocols\/edgemap","navigatorTitle":[{"kind":"identifier","text":"EdgeMap"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeMap"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/subscript(_:checkedEdgeAt:)":{"kind":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/subscript(_:checkededgeat:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"EdgeMap","preciseIdentifier":"s:14GraphProtocols7EdgeMapV"