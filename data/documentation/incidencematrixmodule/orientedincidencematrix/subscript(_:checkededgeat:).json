or a "},{"code":"checked:","type":"codeVoice"},{"type":"text","text":" call throws when an edge position it was given doesn’t name an edge in"},{"type":"text","text":" "},{"type":"text","text":"the graph, because it is out of range or its edge was removed. The vertex counterpart is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/graphprotocols\/edgenotfound","navigatorTitle":[{"text":"EdgeNotFound","kind":"identifier"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"url":"\/documentation\/graphprotocols\/edgemap","title":"EdgeMap","abstract":[{"text":"A handle to a map from edge positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"ArcMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"returned by "},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"type":"text","text":". It is valid on the graph that added it"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":"; on another graph it traps.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeMap","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","role":"symbol","navigatorTitle":[{"text":"EdgeMap","kind":"identifier"}]}}}