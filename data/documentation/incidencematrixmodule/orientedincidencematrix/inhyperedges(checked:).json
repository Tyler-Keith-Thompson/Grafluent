) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VertexNotFound"}],"url":"\/documentation\/graphprotocols\/vertexnotfound","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","navigatorTitle":[{"kind":"identifier","text":"VertexNotFound"}],"title":"VertexNotFound","kind":"symbol","abstract":[{"text":"The error a ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" call throws when a vertex it was given isn’t in the graph. Named after","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s ","type":"text"},{"type":"codeVoice","code":"NodeNotFound"},{"text":".","type":"text"}]}}}