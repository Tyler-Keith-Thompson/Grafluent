 = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"role":"symbol","title":"VertexNotFound","abstract":[{"text":"The error a ","type":"text"},{"code":"checked:","type":"codeVoice"},{"text":" call throws when a vertex it was given isn’t in the graph. Named after","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s ","type":"text"},{"code":"NodeNotFound","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VertexNotFound"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","navigatorTitle":[{"kind":"identifier","text":"VertexNotFound"}],"type":"topic","url":"\/documentation\/graphprotocols\/vertexnotfound"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","title":"IncidenceMatrixModule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"}}}