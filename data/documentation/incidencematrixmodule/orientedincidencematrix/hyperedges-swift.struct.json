"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/ST":{"identifier":"doc:\/\/IncidenceMatrixModule\/ST","title":"Swift.Sequence","type":"unresolvable"},"doc://IncidenceMatrixModule/s8SendableP":{"identifier":"doc:\/\/IncidenceMatrixModule\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://IncidenceMatrixModule/Sl":{"identifier":"doc:\/\/IncidenceMatrixModule\/Sl","title":"Swift.Collection","type":"unresolvable"},"doc://IncidenceMatrixModule/s16SendableMetatypeP":{"identifier":"doc:\/\/IncidenceMatrixModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"kind":"symbol","title":"IncidenceMatrixModule","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","role":"collection","url":"\/documentation\/incidencematrixmodule"},"doc://IncidenceMatrixModule/SK":{"identifier":"doc:\/\/IncidenceMatrixModule\/SK","title":"Swift.BidirectionalCollection","type":"unresolvable"}}}