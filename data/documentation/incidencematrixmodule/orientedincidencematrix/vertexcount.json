c","role":"collection","abstract":[]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/vertexCount":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/vertexcount","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","abstract":[{"text":"The number of vertices. O(1).","type":"text"}],"title":"vertexCount","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/vertexCount","kind":"symbol","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"abstract":[{"text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a source","type":"text"},{"text":" ","type":"text"},{"text":"of column ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen","type":"text"},{"text":" ","type":"text"},{"text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head","type":"text"},{"text":" ","type":"text"},{"text":"node); a directed graph’s edge is the column with one source and one target, the matrix of","type":"text"},{"text":" ","type":"text"},{"text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"title":"OrientedIncidenceMatrix","navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","kind":"symbol"}}}