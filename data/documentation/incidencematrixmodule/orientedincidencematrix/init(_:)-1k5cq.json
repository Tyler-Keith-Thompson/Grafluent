"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-1k5cq"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"An oriented incidence matrix of an undirected graph: each edge oriented from ","type":"text"},{"type":"codeVoice","code":"edges[p].u"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"edges[p].v"},{"text":" (NetworkX’s ","type":"text"},{"type":"codeVoice","code":"edgelist"},{"text":" tuple order), rows by vertex index.","type":"text"}],"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","url":"\/documentation\/graphprotocols\/graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(_:)-1k5cq":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"An oriented incidence matrix of an undirected graph: each edge oriented from ","type":"text"},{"type":"codeVoice","code":"edges[p].u"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"edges[p].v"},{"text":" (NetworkX’s ","type":"text"},{"type":"codeVoice","code":"edgelist"},{"text":" tuple order), rows by vertex index.","type":"text"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-1k5cq","kind":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(_:)-1k5cq","type":"topic","title":"init(_:)","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","abstract":[],"title":"IncidenceMatrixModule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","kind":"symbol","type":"topic","role":"collection"}}}