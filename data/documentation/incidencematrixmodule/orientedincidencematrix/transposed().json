ifier"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/transposed()":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/transposed()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transposed","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V","text":"OrientedIncidenceMatrix","kind":"typeIdentifier"}],"type":"topic","abstract":[{"text":"The transpose of each plane, which is the dual (","type":"text"},{"type":"codeVoice","code":"IncidenceList.dual()"},{"text":"’s convention): column","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" of the result has sources ","type":"text"},{"code":"outHyperedges(of: v)","type":"codeVoice"},{"type":"text","text":" and targets "},{"code":"inHyperedges(of: v)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"O(1)."}],"title":"transposed()","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/transposed()","kind":"symbol","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"kind":"symbol","title":"IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","type":"topic","role":"collection","abstract":[]}}}