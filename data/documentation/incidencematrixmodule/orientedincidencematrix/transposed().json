rithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/transposed()":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/transposed()","title":"transposed()","kind":"symbol","role":"symbol","abstract":[{"text":"The transpose of each plane, which is the dual (","type":"text"},{"code":"IncidenceList.dual()","type":"codeVoice"},{"text":"’s convention): column","type":"text"},{"text":" ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" of the result has sources ","type":"text"},{"type":"codeVoice","code":"outHyperedges(of: v)"},{"type":"text","text":" and targets "},{"type":"codeVoice","code":"inHyperedges(of: v)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"O(1)."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"transposed","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/transposed()"}}}