"v","type":"codeVoice"},{"text":" of the result has sources ","type":"text"},{"code":"outHyperedges(of: v)","type":"codeVoice"},{"text":" and targets ","type":"text"},{"code":"inHyperedges(of: v)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"O(1).","type":"text"}],"kind":"symbol","references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/transposed()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transposed"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V","kind":"typeIdentifier","text":"OrientedIncidenceMatrix"}],"abstract":[{"text":"The transpose of each plane, which is the dual (","type":"text"},{"type":"codeVoice","code":"IncidenceList.dual()"},{"text":"’s convention): column","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" of the result has sources ","type":"text"},{"type":"codeVoice","code":"outHyperedges(of: v)"},{"text":" and targets ","type":"text"},{"type":"codeVoice","code":"inHyperedges(of: v)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"O(1).","type":"text"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/transposed()","kind":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/transposed()","title":"transposed()","type":"topic","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","abstract":[],"title":"IncidenceMatrixModule","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","kind":"symbol","type":"topic","role":"collection"}}}