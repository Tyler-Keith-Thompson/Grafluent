\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/transposed()"},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","type":"topic","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"code":"p","type":"codeVoice"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"code":"incidence_matrix(oriented=True)","type":"codeVoice"},{"type":"text","text":". It conforms to "},{"code":"DirectedHypergraph","type":"codeVoice"},{"type":"text","text":", so the "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":"."}],"title":"OrientedIncidenceMatrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/transposed()":{"type":"topic","abstract":[{"text":"The transpose of each plane, which is the dual (","type":"text"},{"type":"codeVoice","code":"IncidenceList.dual()"},{"text":"’s convention): column","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" of the result has sources ","type":"text"},{"type":"codeVoice","code":"outHyperedges(of: v)"},{"text":" and targets ","type":"text"},{"type":"codeVoice","code":"inHyperedges(of: v)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"O(1).","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/transposed()","title":"transposed()","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/transposed()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transposed"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"OrientedIncidenceMatrix","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"url":"\/documentation\/incidencematrixmodule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","type":"topic","kind":"symbol","abstract":[],"title":"IncidenceMatrixModule"}}}