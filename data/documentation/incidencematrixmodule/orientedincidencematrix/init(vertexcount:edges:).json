ceMatrix\/init(vertexCount:edges:)","title":"init(vertexCount:edges:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"DirectedEdge","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">>)","kind":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","title":"IncidenceMatrixModule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"abstract":[{"type":"text","text":"An edge of a directed graph: the ordered pair (source, target), directed from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}],"title":"DirectedEdge","type":"topic","navigatorTitle":[{"text":"DirectedEdge","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedEdge","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphprotocols\/directededge"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"title":"OrientedIncidenceMatrix","navigatorTitle":[{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"type":"topic","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrientedIncidenceMatrix"}],"kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol"}}}