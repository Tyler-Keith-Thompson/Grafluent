{"abstract":[{"text":"Reserves storage for ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" vertices and ","type":"text"},{"code":"hyperedgeCount","type":"codeVoice"},{"text":" columns.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"hyperedgeCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/reserveCapacity(vertexCount:hyperedgeCount:)"},"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"name":"IncidenceMatrixModule"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"hyperedgeCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"externalID":"s:21IncidenceMatrixModule08OrientedaB0V15reserveCapacity11vertexCount09hyperedgeH0ySi_SitF","symbolKind":"method","title":"reserveCapacity(vertexCount:hyperedgeCount:)","extendedModule":"IncidenceMatrixModule","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources