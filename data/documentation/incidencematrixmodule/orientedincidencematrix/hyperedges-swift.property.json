text":"OrientedIncidenceMatrix"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V10HyperedgesV","text":"Hyperedges"}],"extendedModule":"IncidenceMatrixModule","title":"hyperedges"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.property"]}],"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","type":"topic","title":"IncidenceMatrixModule","kind":"symbol","role":"collection","abstract":[]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","title":"OrientedIncidenceMatrix","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/Hyperedges-swift.struct":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/Hyperedges-swift.struct","title":"OrientedIncidenceMatrix.Hyperedges","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Every column as its sources and targets, at its position."}],"navigatorTitle":[{"text":"Hyperedges","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hyperedges","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/hyperedges-swift.struct"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/hyperedges-swift.property":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/hyperedges-swift.property","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedges","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:21IncidenceMatrixModule08OrientedaB0V10Hyper