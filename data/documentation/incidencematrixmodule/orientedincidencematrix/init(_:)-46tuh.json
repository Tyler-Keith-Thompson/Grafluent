yword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":")","kind":"text"}],"roleHeading":"Initializer","title":"init(_:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IncidenceMatrixModule\/OrientedIncidenceMatrix.swift#L117","fileName":"OrientedIncidenceMatrix.swift"},"role":"symbol","extendedModule":"IncidenceMatrixModule","externalID":"s:21IncidenceMatrixModule08OrientedaB0VyACxc14GraphProtocols08DirectedE0Rzlufc","symbolKind":"init"},"references":{"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"type":"topic","title":"IncidenceMatrixModule","kind":"symbol","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule","url":"\/documentation\/incidencematrixmodule","role":"collection"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/init(_:)-46tuh":{"title":"init(_:)","role":"symbol","type":"topic","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/init(_:)-46tuh","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/init(_:)-46tuh","kind":"symbol","abstract":[{"text":"The oriented incidence matrix of a directed graph: rows by vertex index, a column per edge","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" order, −1 at the source and +1 at the target.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"kind":"text","text":")"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix":{"abstract":[{"type":"text","text":"The oriented incidence matrix of a directed hypergraph: entry (v, p) is −1 when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a source"},{"type":"text","text":" "},{"type":"text","text":"of column "},{"type":"codeVoice","code":"p"},{"type":"text","text":", +1 when it is a target, and 0 otherwise. Gallo, Longo, Pallottino and Nguyen"},{"type":"text","text":" "},{"type":"text","text":"(1993) define a directed hypergraph’s matrix this way (aᵢⱼ = −1 for a tail node, 1 for a head"},{"type":"text","text":" "},{"type":"text","text":"node); a directed graph’s edge is the column with one source and one target, the matrix of"},{"type":"text","text":" "},{"type":"text","text":"spectral graph theory (B·Bᵀ = L, Godsil–Royle §8.3) and NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidence_matrix(oriented=True)"},{"type":"text","text":". It conforms to "},{"type":"codeVoice","code":"DirectedHypergraph"},{"type":"text","text":", so the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" "},{"type":"text","text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"title":"OrientedIncidenceMatrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"role":"symbol","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix","type":"topic","kind":"symbol"}}}