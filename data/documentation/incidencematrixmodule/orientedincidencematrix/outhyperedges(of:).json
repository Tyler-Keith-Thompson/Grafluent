"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"role":"symbol"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/outHyperedges(of:)":{"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/outHyperedges(of:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/outhyperedges(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outHyperedges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"BitSet","kind":"typeIdentifier","preciseIdentifier":"s:14BitCollections0A3SetV"}],"kind":"symbol","type":"topic","title":"outHyperedges(of:)","role":"symbol","abstract":[{"text":"The columns with ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" among their sources: the source plane’s row. O(⌈m\/64⌉).","type":"text"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule":{"abstract":[],"url":"\/documentation\/incidencematrixmodule","kind":"symbol","type":"topic","title":"IncidenceMatrixModule","role":"collection","identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule"}}}