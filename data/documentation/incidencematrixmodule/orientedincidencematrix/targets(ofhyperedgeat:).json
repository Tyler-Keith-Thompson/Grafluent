algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is"},{"type":"text","text":" "},{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/targets(ofHyperedgeAt:)":{"title":"targets(ofHyperedgeAt:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/targets(ofhyperedgeat:)","role":"symbol","kind":"symbol","abstract":[{"text":"The targets of the column at ","type":"text"},{"code":"position","type":"codeVoice"},{"text":": the target plane’s column. O(⌈n\/64⌉).","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"targets"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofHyperedgeAt"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:14BitCollections0A3SetV","kind":"typeIdentifier","text":"BitSet"}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/targets(ofHyperedgeAt:)"}}}