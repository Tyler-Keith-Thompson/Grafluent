,{"type":"text","text":"not a "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}],"url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix"},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/OrientedIncidenceMatrix/targetSize(ofHyperedgeAt:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"targetSize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofHyperedgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The number of targets of the column at "},{"type":"codeVoice","code":"position"},{"type":"text","text":". O(1), cached."}],"identifier":"doc:\/\/IncidenceMatrixModule\/documentation\/IncidenceMatrixModule\/OrientedIncidenceMatrix\/targetSize(ofHyperedgeAt:)","type":"topic","title":"targetSize(ofHyperedgeAt:)","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix\/targetsize(ofhyperedgeat:)","role":"symbol"}}}