{"abstract":[{"type":"text","text":"A semiring whose ⊕ returns one of its operands (a selective dioid in Gondran–Minoux’s terms),"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"<","type":"codeVoice"},{"type":"text","text":" as its natural order."}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring","doc:\/\/Semirings\/SL","doc:\/\/Semirings\/SQ"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/LexicographicSemiring","doc:\/\/Semirings\/documentation\/Semirings\/MaxPlusSemiring","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring","doc:\/\/Semirings\/documentation\/Semirings\/ViterbiSemiring"]}],"variants":[{"paths":["\/documentation\/semirings\/selectivesemiring"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SelectiveSemiring","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Semiring","kind":"typeIdentifier","identifier":"doc:\/\/Semirings\/documentation\/Semirings\/Semiring","preciseIdentifier":"s:9Semirings8SemiringP"},{"text":", ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a < b"},{"text":" exactly when ","type":"text"},{"type":"codeVoice","code":"a ⊕ b == a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"a != b"},{"text":", read as “a is better than b”. ","type":"text"},{"type":"codeVoi