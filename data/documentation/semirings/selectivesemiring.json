{"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SelectiveSemiring"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:9Semirings8SemiringP","kind":"typeIdentifier","text":"Semiring","identifier":"doc:\/\/Semirings\/documentation\/Semirings\/Semiring"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"code":"a < b","type":"codeVoice"},{"text":" exactly when ","type":"text"},{"code":"a ⊕ b == a","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"a != b","type":"codeVoice"},{"text":", read as “a is better than b”. ","type":"text"},{"code":"a ⊕ b","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"better of the two, ","type":"text"},{"code":"<","type":"codeVoice"},{"text":" is a strict total order, and ","type":"text"},{"code":"zero","type":"codeVoice"},{"text":" is the worst element. ","type":"text"},{"code":"<","type":"codeVoice"},{"text":" is not the","type":"text"},{"text":" ","type":"text"},{"text":"order of the raw values: ","type":"text"},{"code":"BottleneckSemiring(9) < BottleneckSemiring(2)","type":"codeVoice"},{"text":" because wider is","type":"text"},{"text":" ","type":"text"},{"text":"better, and ","type":"text"},{"code":"BooleanSemiring(true) < BooleanSemiring(false)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dijkstra’s algorithm, Bellman–Ford, DAG shortest paths and Floyd–Warshall in ShortestPaths take"},{"type":"text","text":" "},{"type":"text","text":"a selective semiring. Dijkstra’s algorithm also needs every examined weight to be no better than"},{"type":"text","text":" "},{"type":"codeVoice","code":"one"},{"type":"text","text":", so that extending a path never improves it. A negative tropical weight breaks that, and"},{"type":"text","text":" "},{"type":"text","text":"no bottleneck or Boolean weight does."}]}],"kind":"content"}],"abstract":[{"text":"A semiring whose ⊕ returns one of its operands (a selective dioid in Gondran–Minoux’s terms),","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"<"},{"text":" as its natural order.","type":"text"}],"metadata":{"role":"symbol","modules":[{"name":"Semirings"}],"roleHeading":"Protocol","title":"SelectiveSemiring","symbolKind":"protocol","externalID":"s:9Semirings17SelectiveSemiringP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SelectiveSemiring"}],"navigatorTitle":[{"text":"SelectiveSemiring","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/Semiring.swift#L74","fileName":"Semiring.swift"}},"relationshipsSections":[{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring","doc:\/\/Semirings\/SL","doc:\/\/Semirings\/SQ"],"kind":"relationships","type":"inheritsFrom","title":"Inherits From"},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring"],"kind":"relationships","type":"conformingTypes","title":"Conforming Types"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"variants":[{"paths":["\/documentation\/semirings\/selectivesemiring"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Semirings/SL":{"type":"unresolvable","title":"Swift.Compa