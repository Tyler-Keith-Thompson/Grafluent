{"abstract":[{"text":"A semiring whose ⊕ returns one of its operands (a selective dioid in Gondran–Minoux’s terms),","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"<","type":"codeVoice"},{"text":" as its natural order.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"variants":[{"paths":["\/documentation\/semirings\/selectivesemiring"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring","doc:\/\/Semirings\/SL","doc:\/\/Semirings\/SQ"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/LexicographicSemiring","doc:\/\/Semirings\/documentation\/Semirings\/MaxPlusSemiring","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring","doc:\/\/Semirings\/documentation\/Semirings\/ViterbiSemiring"],"type":"conformingTypes","title":"Conforming Types","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SelectiveSemiring","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Semiring","identifier":"doc:\/\/Semirings\/documentation\/Semirings\/Semiring","preciseIdentifier":"s:9Semirings8SemiringP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"a < b","type":"codeVoice"},{"type":"text","text":" exactly when "},{"code":"a ⊕ b == a","type":"codeVoice"},{"type":"text","text":" and "},{"code":"a != b","type":"codeVoice"},{"type":"text","text":", read as “a is better than b”. "},{"code":"a ⊕ b","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"better of the two, "},{"code":"<","type":"codeVoice"},{"type":"text","text":" is a strict total order, and "},{"code":"zero","type":"codeVoice"},{"type":"text","text":" is the worst element. "},{"code":"<","type":"codeVoice"},{"type":"text","text":" is not the"},{"type":"text","text":" "},{"type":"text","text":"order of the raw values: "},{"code":"BottleneckSemiring(9) < BottleneckSemiring(2)","type":"codeVoice"},{"type":"text","text":" because wider is"},{"type":"text","text":" "},{"type":"text","text":"better, and "},{"code":"BooleanSemiring(true) < BooleanSemiring(false)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dijkstra’s algorithm, Bellman–Ford, DAG shortest paths and Floyd–Warshall in ShortestPaths take"},{"type":"text","text":" "},{"type":"text","text":"a selective semiring. Dijkstra’s algorithm also needs every examined weight to be no better than"},{"type":"text","text":" "},{"type":"codeVoice","code":"one"},{"type":"text","text":", so that extending a path never improves it. A negative tropical weight breaks that, and"},{"type":"text","text":" "},{"type":"text","text":"no bottleneck or Boolean weight does."}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/Semiring.swift#L74","fileName":"Semiring.swift"},"symbolKind":"protocol","navigatorTitle":[{"text":"SelectiveSemiring","kind":"identifier"}],"roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SelectiveSemiring"}],"role":"s