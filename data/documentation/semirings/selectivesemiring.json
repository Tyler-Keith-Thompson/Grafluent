{"kind":"symbol","sections":[],"metadata":{"symbolKind":"protocol","title":"SelectiveSemiring","modules":[{"name":"Semirings"}],"roleHeading":"Protocol","role":"symbol","remoteSource":{"fileName":"Semiring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/Semiring.swift#L74"},"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SelectiveSemiring"}],"externalID":"s:9Semirings17SelectiveSemiringP","navigatorTitle":[{"text":"SelectiveSemiring","kind":"identifier"}]},"abstract":[{"text":"A semiring whose ⊕ returns one of its operands (a selective dioid in Gondran–Minoux’s terms),","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"<"},{"text":" as its natural order.","type":"text"}],"identifier":{"url":"doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SelectiveSemiring"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Semiring","identifier":"doc:\/\/Semirings\/documentation\/Semirings\/Semiring","preciseIdentifier":"s:9Semirings8SemiringP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"code":"a < b","type":"codeVoice"},{"text":" exactly when ","type":"text"},{"code":"a ⊕ b == a","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"a != b","type":"codeVoice"},{"text":", read as “a is better than b”. ","type":"text"},{"code":"a ⊕ b","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"better of the two, ","type":"text"},{"code":"<","type":"codeVoice"},{"text":" is a strict total order, and ","type":"text"},{"code":"zero","type":"codeVoice"},{"text":" is the worst element. ","type":"text"},{"code":"<","type":"codeVoice"},{"text":" is not the","type":"text"},{"text":" ","type":"text"},{"text":"order of the raw values: ","type":"text"},{"code":"BottleneckSemiring(9) < BottleneckSemiring(2)","type":"codeVoice"},{"text":" because wider is","type":"text"},{"text":" ","type":"text"},{"text":"better, and ","type":"text"},{"code":"BooleanSemiring(true) < BooleanSemiring(false)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Dijkstra’s algorithm, Bellman–Ford, DAG shortest paths and Floyd–Warshall in ShortestPaths take"},{"type":"text","text":" "},{"type":"text","text":"a selective semiring. Dijkstra’s algorithm also needs every examined weight to be no better than"},{"type":"text","text":" "},{"type":"codeVoice","code":"one"},{"type":"text","text":", so that extending a path never improves it. A negative tropical weight breaks that, and"},{"type":"text","text":" "},{"type":"text","text":"no bottleneck or Boolean weight does."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/semirings\/selectivesemiring"]}],"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"relationshipsSections":[{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring","doc:\/\/Semirings\/SL","doc:\/\/Semirings\/SQ"],"type":"inheritsFrom","kind":"relationships","title":"Inherits From"},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/LexicographicSemiring","doc:\/\/Semirings\/documentation\/Semirings\/MaxPlusSemiring","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring","doc:\/\/Semirings\/docu