ooleanSemiring","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The Boolean semiring (∨, ∧), for reachability. With Floyd–Warshall it computes the reflexive","type":"text"},{"text":" ","type":"text"},{"text":"transitive closure (Warshall’s algorithm).","type":"text"}],"title":"BooleanSemiring","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BooleanSemiring","kind":"identifier"}]},"doc://Semirings/SL":{"title":"Swift.Comparable","type":"unresolvable","identifier":"doc:\/\/Semirings\/SL"},"doc://Semirings/documentation/Semirings/BottleneckSemiring":{"url":"\/documentation\/semirings\/bottlenecksemiring","kind":"symbol","identifier":"doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BottleneckSemiring","kind":"identifier"}],"type":"topic","role":"symbol","title":"BottleneckSemiring","abstract":[{"text":"The bottleneck semiring (max, min) over ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":", for widest paths, also called","type":"text"},{"text":" ","type":"text"},{"text":"maximum-capacity or bottleneck paths (Gondran–Minoux).","type":"text"}],"navigatorTitle":[{"text":"BottleneckSemiring","kind":"identifier"}]},"doc://Semirings/documentation/Semirings":{"kind":"symbol","abstract":[],"url":"\/documentation\/semirings","role":"collection","type":"topic","title":"Semirings","identifier":"doc:\/\/Semirings\/documentation\/Semirings"},"doc://Semirings/SQ":{"type":"unresolvable","identifier":"doc:\/\/Semirings\/SQ","title":"Swift.Equatable"}}}