"},{"type":"text","text":"here computes that product, because each skips a "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" distance and treats a NaN candidate as"},{"type":"text","text":" "},{"type":"text","text":"no improvement. No operation checks for NaN. The ShortestPaths entry points trap on a NaN"},{"type":"text","text":" "},{"type":"text","text":"weight."}]},{"type":"codeListing","code":["graph.dijkstraShortestPaths(from: s) { TropicalSemiring(length[$0]) }"],"syntax":null}],"kind":"content"}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/_(_:_:)"],"anchor":"Operators","title":"Operators","generated":true},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/init(_:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/value"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/plus(_:)","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/times(_:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/one","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/zero"],"anchor":"Type-Properties","title":"Type Properties","generated":true},{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/Comparable-Implementations","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/CustomStringConvertible-Implementations","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/Equatable-Implementations","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring\/Semiring-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"references":{"doc://Semi