{"topicSections":[{"anchor":"Operators","title":"Operators","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/_(_:_:)-2ou28","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/_(_:_:)-93rtg"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/plus(_:)","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/times(_:)"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/one","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/zero"],"generated":true}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Semiring"}],"role":"symbol","title":"Semiring","roleHeading":"Protocol","externalID":"s:9Semirings8SemiringP","remoteSource":{"fileName":"Semiring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/Semiring.swift#L31"},"symbolKind":"protocol","modules":[{"name":"Semirings"}],"navigatorTitle":[{"kind":"identifier","text":"Semiring"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"A semiring (S, ⊕, ⊗, 0̄, 1̄), the algebra of path problems (Mohri 2002; Gondran–Minoux 2008)."}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/Semirings\/SQ"],"type":"inheritsFrom"},{"title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring"],"type":"inheritedBy"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/CountingSemiring