{"sections":[],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Semirings\/SQ"]},{"type":"inheritedBy","kind":"relationships","title":"Inherited By","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/CountingSemiring","doc:\/\/Semirings\/documentation\/Semirings\/LexicographicSemiring","doc:\/\/Semirings\/documentation\/Semirings\/MaxPlusSemiring","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring","doc:\/\/Semirings\/documentation\/Semirings\/ViterbiSemiring"]}],"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"abstract":[{"type":"text","text":"A semiring (S, ⊕, ⊗, 0̄, 1̄), the algebra of path problems (Mohri 2002; Gondran–Minoux 2008)."}],"metadata":{"role":"symbol","roleHeading":"Protocol","title":"Semiring","remoteSource":{"fileName":"Semiring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/Semiring.swift#L31"},"navigatorTitle":[{"kind":"identifier","text":"Semiring"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Semiring","kind":"identifier"}],"symbolKind":"protocol","externalID":"s:9Semirings8SemiringP","modules":[{"name":"Semirings"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/semirings\/semiring"]}],"identifier":{"url":"doc:\/\/Semirings\/documentation\/Semirings\/Semiring","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Semiring","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Equatable","kind":"typeIdentifier","preciseIdentifier":"s:SQ"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"⊗ extends a path by an edge and ⊕ combines alternative paths. The shortest-path entry points in"},{"type":"text","text":" "},{"type":"text","text":"ShortestPaths answer a different question for each conformer. The tropical semiring gives"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, the bottleneck semiring widest paths, the Boolean semiring reachability, and the"},{"type":"text","text":" "},{"type":"text","text":"counting semiring the number of paths."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A conformer implements the four requirements. The type system does not check the laws, and an"},{"type":"text","text":" "},{"type":"text","text":"algorithm’s result is meaningful only when they hold:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"⊕ is associative and commutative, with identity "},{"type":"codeVoice","code":"zero"},{"type":"text","text":";"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"⊗ is associative, with identity "},{"type":"codeVoice","code":"one"},{"type":"text","text":";"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"zero","type":"codeVoice"},{"type":"text","text":" annihilates: "},{"code":"a ⊗ 0̄ == 0̄ ⊗ a == 0̄","type":"codeVoice"},{"type":"text","text":";"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"⊗ distributes over ⊕ from both sides."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"⊗ need not be commutative. Algorithms always compute "},{"type":"codeVoice","code":"distance ⊗ weight"},{"type":"text","text":", in path order."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zero"},{"text":" is not ","type":"text"},{"type":"codeVoice","code":"AdditiveArithmetic.zero"},{"text":". No semiring type here is a number, and a tropical","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"zero"},{"text":" is +∞.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The operators ","type":"text"},{"code":"⊕","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"⊗","type":"codeVoice"},{"text":" call ","type":"text"},{"code":"plus(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"times(_:)","type":"codeVoice"},{"text":", so the two spellings always agree.","type":"text"},{"text":" ","type":"text"},{"text":"Prefer the methods where another module might declare the same operators, and inside","type":"text"},{"text":" ","type":"text"},{"code":"#expect","type":"codeVoice"},{"text":". That macro folds an expression without these operators’ precedences, so","type":"text"},{"text":" ","type":"text"},{"code":"#expect(a ⊕ b == c)","type":"codeVoice"},{"text":" does not type-check, while ","type":"text"},{"code":"#expect(a.plus(b) == c)","type":"codeVoice"},{"text":" does.","type":"text"}]}]}],"kind":"symbol","topicSections":[{"generated":true,"title":"Operators","anchor":"Operators","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/_(_:_:)-2ou28","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/_(_:_:)-93rtg"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/plus(_:)","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/times(_:)"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/one","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/zero"]}],"references":{"doc://Semirings/documentation/Semirings/ViterbiSemiring":{"kind":"symbol","fragments":[{"text"