{"metadata":{"modules":[{"name":"Semirings"}],"navigatorTitle":[{"kind":"identifier","text":"Semiring"}],"title":"Semiring","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Semiring","kind":"identifier"}],"externalID":"s:9Semirings8SemiringP","symbolKind":"protocol","roleHeading":"Protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/Semiring.swift#L31","fileName":"Semiring.swift"},"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/semirings\/semiring"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","topicSections":[{"title":"Operators","generated":true,"anchor":"Operators","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/_(_:_:)-2ou28","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/_(_:_:)-93rtg"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/plus(_:)","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/times(_:)"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/one","doc:\/\/Semirings\/documentation\/Semirings\/Semiring\/zero"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Semiring","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Equatable","kind":"typeIdentifier","preciseIdentifier":"s:SQ"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"⊗ extends a path by an edge and ⊕ combines alternative paths. The shortest-path entry points in"},{"type":"text","text":" "},{"type":"text","text":"ShortestPaths answer a different question for each conformer. The tropical semiring gives"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, the bottleneck semiring widest paths, the Boolean semiring reachability, and the"},{"type":"text","text":" "},{"type":"text","text":"counting semiring the number of paths."}]},{"type":"paragraph","inlineContent":[{"text":"A conformer implements the four requirements. The type system does not check the laws, and an","type":"text"},{"text":" ","type":"text"},{"text":"algorithm’s result is meaningful only when they hold:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"⊕ is associative and commutative, with identity "},{"type":"codeVoice","code":"zero"},{"type":"text","text":";"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"⊗ is associative, with identity ","type":"text"},{"type":"codeVoice","code":"one"},{"text":";","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"zero"},{"type":"text","text":" annihilates: "},{"type":"codeVoice","code":"a ⊗ 0̄ == 0̄ ⊗ a == 0̄"},{"type":"text","text":";"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"⊗ distributes over ⊕ from both sides.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"⊗ need not be commutative. Algorithms always compute "},{"code":"distance ⊗ weight","type":"codeVoice"},{"type":"text","text":", in path order."}]},{"type":"paragraph","inlineContent":[{"code":"zero","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"AdditiveArithmetic.zero","type":"codeVoice"},{"text":". No semiring type here is a number, and a tropical","type":"text"},{"text":" ","type":"text"},{"code":"zero","type":"codeVoice"},{"text":" is +∞.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The operators "},{"code":"⊕","type":"codeVoice"},{"type":"text","text":" and "},{"code":"⊗","type":"codeVoice"},{"type":"text","text":" call "},{"code":"plus(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"times(_:)","type":"codeVoice"},{"type":"text","text":", so the two spellings always agree."},{"type":"text","text":" "},{"type":"text","text":"Prefer the methods where another module might declare the same operators, and inside"},{"type":"text","text":" "},{"code":"#expect","type":"codeVoice"},{"type":"text","text":". That macro folds an expression without these operators’ precedences, so"},{"type":"text","text":" "},{"code":"#expect(a ⊕ b == c)","type":"codeVoice"},{"type":"text","text":" does not type-check, while "},{"code":"#expect(a.plus(b) == c)","type":"codeVoice"},{"type":"text","text":" does."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"identifier":{"url":"doc:\/\/Semirings\/documentation\/Semirings\/Semiring","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A semiring (S, ⊕, ⊗, 0̄, 1̄), the algebra of path problems (Mohri 2002; Gondran–Minoux 2008)."}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/Semirings\/SQ"]},{"title":"Inherited By","type":"inheritedBy","kind":"relationships","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring"]},{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/CountingSemiring","doc:\/\/Semirings\/documentation\/Semirings\/LexicographicSemiring","doc:\/\/Semirings\/documentation\/Semirings\/MaxPlusSemiring","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring","doc:\/\/Semirings\/documentation\/Semirings\/ViterbiSemiring"]}],"references":{"doc://Semirings/documentation/Semirings/Semiring":{"role":"symbol","navigatorTitle":[{"kind":"