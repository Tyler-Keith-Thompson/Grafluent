ntent":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"⊗ extends a path by an edge and ⊕ combines alternative paths. The shortest-path entry points in","type":"text"},{"text":" ","type":"text"},{"text":"ShortestPaths answer a different question for each conformer. The tropical semiring gives","type":"text"},{"text":" ","type":"text"},{"text":"shortest paths, the bottleneck semiring widest paths, the Boolean semiring reachability, and the","type":"text"},{"text":" ","type":"text"},{"text":"counting semiring the number of paths.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A conformer implements the four requirements. The type system does not check the laws, and an"},{"type":"text","text":" "},{"type":"text","text":"algorithm’s result is meaningful only when they hold:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"⊕ is associative and commutative, with identity "},{"type":"codeVoice","code":"zero"},{"type":"text","text":";"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"⊗ is associative, with identity ","type":"text"},{"code":"one","type":"codeVoice"},{"text":";","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zero"},{"type":"text","text":" annihilates: "},{"type":"codeVoice","code":"a ⊗ 0̄ == 0̄ ⊗ a == 0̄"},{"type":"text","text":";"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"⊗ distributes over ⊕ from both sides."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"⊗ need not be commutative. Algorithms always compute ","type":"text"},{"code":"distance ⊗ weight","type":"codeVoice"},{"text":", in path order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zero"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"AdditiveArithmetic.zero"},{"type":"text","text":". No semiring type here is a number, and a tropical"},{"type":"text","text":" "},{"type":"codeVoice","code":"zero"},{"type":"text","text":" is +∞."}]},{"type":"paragraph","inlineContent":[{"text":"The operators ","type":"text"},{"code":"⊕","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"⊗","type":"codeVoice"},{"text":" call ","type":"text"},{"code":"plus(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"times(_:)","type":"codeVoice"},{"text":", so the two spellings always agree.","type":"text"},{"text":" ","type":"text"},{"text":"Prefer the methods where another module might declare the same operators, and inside","type":"text"},{"text":" ","type":"text"},{"code":"#expect","type":"codeVoice"},{"text":". That macro folds an expression without these operators’ precedences, so","type":"text"},{"text":" ","type":"text"},{"code":"#expect(a ⊕ b == c)","type":"codeVoice"},{"text":" does not type-check, while ","type":"text"},{"code":"#expect(a.plus(b) == c)","type":"codeVoice"},{"text":" does.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/Semirings\/SQ"],"type":"inheritsFrom"},{"title":"Inherited By","kind":"relationships","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring"],"type":"inheritedBy"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/BooleanSemiring","doc:\/\/Semirings\/documentation\/Semirings\/BottleneckSemiring","doc:\/\/Semirings\/documentation\/Semirings\/CountingSemiring","doc:\/\/Semirings\/documentation\/Semirings\/LexicographicSemiring","doc:\/\/Semirings\/documentation\/Semirings\/MaxPlusSemiring","doc:\/\/Semirings\/documentation\/Semirings\/TropicalSemiring","doc:\/\/Semirings\/documentation\/Semirings\/ViterbiSemiring"],"type":"conformingTypes"}],"references":{"doc://Semirings/documentation/Semirings/ViterbiSemiring":{"fragments":[{"text":"struct","kind"