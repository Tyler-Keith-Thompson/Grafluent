{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaxPlusSemiring","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"_SemiringScalar","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedNumeric","kind":"typeIdentifier","preciseIdentifier":"s:s13SignedNumericP"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"code":"zero","type":"codeVoice"},{"text":" is −∞ (","type":"text"},{"code":"Int.min","type":"codeVoice"},{"text":", ","type":"text"},{"code":"-.infinity","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"one","type":"codeVoice"},{"text":" is 0, ⊕ is ","type":"text"},{"code":"max","type":"codeVoice"},{"text":" and ⊗ is ","type":"text"},{"code":"+","type":"codeVoice"},{"text":". ","type":"text"},{"code":"<","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"natural order, in which longer is better: ","type":"text"},{"code":"MaxPlusSemiring(9) < MaxPlusSemiring(2)","type":"codeVoice"},{"text":". The order","type":"text"},{"text":" ","type":"text"},{"text":"is the reverse of the values’, so ","type":"text"},{"code":"[a, b].max()","type":"codeVoice"},{"text":" is the shorter and ","type":"text"},{"code":".min()","type":"codeVoice"},{"text":" the longer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"⊗ is a closed sum. −∞ (the zero) absorbs every value, and any other sum traps on integer"},{"type":"text","text":" "},{"type":"text","text":"overflow. A finite integer sum that lands exactly on "},{"type":"codeVoice","code":".min"},{"type":"text","text":" is the zero, so an edge of that"},{"type":"text","text":" "},{"type":"text","text":"weight carries no path. The carrier is ℝ ∪ {−∞}, without +∞. No operation checks for NaN. The"},{"type":"text","text":" "},{"type":"text","text":"ShortestPaths entry points trap on a NaN weight."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Longest paths exist where no cycle has a positive length: "},{"type":"codeVoice","code":"dagShortestPaths"},{"type":"text","text":" gives them in an"},{"type":"text","text":" "},{"type":"text","text":"acyclic graph, and Bellman–Ford returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when a positive cycle is reachable. Dijkstra’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm needs every examined weight to be at most 0."}],"type":"paragraph"},{"type":"codeListing","code":["dag.dagShortestPaths(from: s) { MaxPlusSemiring(duration[$0]) }"],"syntax":null}]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/MaxPlusSemiring.swift#L19","fileName":"MaxPlusSemiring.swift"},"title":"MaxPlusSemiring","role":"symbol","externalID":"s:9Semirings15MaxPlusSemiringV","modules":[{"name":"Semirings"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaxPlusSemiring","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MaxPlusSemiring"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"variants":[{"paths":["\/documentation\/semirings\/maxplussemiring"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Semirings\/documentation\/Semirings\/MaxPlusSemiring","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","relationshipsSectio