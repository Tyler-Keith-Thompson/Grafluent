{"abstract":[{"text":"The max-plus semiring (max, +) over ","type":"text"},{"type":"codeVoice","code":"Value"},{"text":", for longest paths, also called the arctic","type":"text"},{"text":" ","type":"text"},{"text":"semiring.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring","doc:\/\/Semirings\/documentation\/Semirings\/Semiring","doc:\/\/Semirings\/SL","doc:\/\/Semirings\/s8CopyableP","doc:\/\/Semirings\/s23CustomStringConvertibleP","doc:\/\/Semirings\/SQ","doc:\/\/Semirings\/s9EscapableP","doc:\/\/Semirings\/SH","doc:\/\/Semirings\/s8SendableP","doc:\/\/Semirings\/s16SendableMetatypeP"]}],"metadata":{"symbolKind":"struct","externalID":"s:9Semirings15MaxPlusSemiringV","modules":[{"name":"Semirings"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaxPlusSemiring"}],"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/MaxPlusSemiring.swift#L19","fileName":"MaxPlusSemiring.swift"},"role":"symbol","title":"MaxPlusSemiring","navigatorTitle":[{"text":"MaxPlusSemiring","kind":"identifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaxPlusSemiring","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"_SemiringScalar","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedNumeric","preciseIdentifier":"s:s13SignedNumericP","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zero"},{"type":"text","text":" is −∞ ("},{"type":"codeVoice","code":"Int.min"},{"type":"text","text":", "},{"type":"codeVoice","code":"-.infinity"},{"type":"text","text":"), "},{"type":"codeVoice","code":"one"},{"type":"text","text":" is 0, ⊕ is "},{"type":"codeVoice","code":"max"},{"type":"text","text":" and ⊗ is "},{"type":"codeVoice","code":"+"},{"type":"text","text":". "},{"type":"codeVoice","code":"<"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"natural order, in which longer is better: "},{"type":"codeVoice","code":"MaxPlusSemiring(9) < MaxPlusSemiring(2)"},{"type":"text","text":". The order"},{"type":"text","text":" "},{"type":"text","text":"is the reverse of the values’, so "},{"type":"codeVoice","code":"[a, b].max()"},{"type":"text","text":" is the shorter and "},{"type":"codeVoice","code":".min()"},{"type":"text","text":" the longer."}]},{"type":"paragraph","inlineContent":[{"text":"⊗ is a closed sum. −∞ (the zero) absorbs every value, and any other sum traps on integer","type":"text"},{"text":" ","type":"text"},{"text":"overflow. A finite integer sum that lands exactly on ","type":"text"},{"type":"codeVoice","code":".min"},{"text":" is the zero, so an edge of that","type":"text"},{"text":" ","type":"text"},{"text":"weight carries no path. The carrier is ℝ ∪ {−∞}, without +∞. No operation checks for NaN. The","type":"text"},{"text":" ","type":"text"},{"text":"ShortestPaths entry points trap on a NaN weight.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Longest paths exist where no cycle has a positive length: "},{"type":"codeVoice","code":"dagShortestPaths"},{"type":"text","text":" gives them in an"},{"type":"text","text":" "},{"type":