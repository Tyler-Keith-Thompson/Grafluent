{"abstract":[{"text":"The lexicographic product of two selective semirings, for paths best by ","type":"text"},{"code":"First","type":"codeVoice"},{"text":" with ties","type":"text"},{"text":" ","type":"text"},{"text":"broken by ","type":"text"},{"code":"Second","type":"codeVoice"},{"text":" (Mohri’s lexicographic semiring): the shortest among the widest paths, or","type":"text"},{"text":" ","type":"text"},{"text":"the fewest hops among the shortest.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/Semirings\/documentation\/Semirings\/SelectiveSemiring","doc:\/\/Semirings\/documentation\/Semirings\/Semiring","doc:\/\/Semirings\/SL","doc:\/\/Semirings\/s8CopyableP","doc:\/\/Semirings\/s23CustomStringConvertibleP","doc:\/\/Semirings\/SQ","doc:\/\/Semirings\/s9EscapableP","doc:\/\/Semirings\/SH","doc:\/\/Semirings\/s8SendableP","doc:\/\/Semirings\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"metadata":{"symbolKind":"struct","externalID":"s:9Semirings21LexicographicSemiringV","modules":[{"name":"Semirings"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LexicographicSemiring"}],"roleHeading":"Structure","remoteSource":{"fileName":"LexicographicSemiring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/LexicographicSemiring.swift#L22"},"role":"symbol","title":"LexicographicSemiring","navigatorTitle":[{"kind":"identifier","text":"LexicographicSemiring"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LexicographicSemiring"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"