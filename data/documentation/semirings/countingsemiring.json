","type":"codeVoice"},{"text":" and ⊗ is ","type":"text"},{"code":"*","type":"codeVoice"},{"text":". It is not selective, because ⊕ is not","type":"text"},{"text":" ","type":"text"},{"text":"idempotent (","type":"text"},{"code":"a ⊕ a == 2a","type":"codeVoice"},{"text":"), and not ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":", so only ","type":"text"},{"code":"dagShortestDistances","type":"codeVoice"},{"text":" takes it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Over ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" both operations trap on overflow, like every sum in ShortestPaths, because a","type":"text"},{"text":" ","type":"text"},{"text":"saturated or wrapped count would be silently wrong. ","type":"text"},{"code":"Int.max","type":"codeVoice"},{"text":" paths fit: 2⁶³ − 1, or 2³¹ − 1 where","type":"text"},{"text":" ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" is 32 bits. ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" rounds past 2⁵³.","type":"text"},{"text":" ","type":"text"},{"text":"For exact large counts, use any ","type":"text"},{"code":"Numeric & Hashable","type":"codeVoice"},{"text":" big-integer type.","type":"text"}]},{"syntax":null,"type":"codeListing","code":["dag.dagShortestDistances(from: s) { _ in CountingSemiring(1) }"]}]}],"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"variants":[{"paths":["\/documentation\/semirings\/countingsemiring"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Semirings/documentation/Semirings/CountingSemiring/init(_:)":{"kind":"symbol","identifier":"doc:\/\/Semirings\/documentation\/Semirings\/CountingSemiring\/init(_:)","title":"init(_:)","role":"symbol","type":"topic","url":"\/documentation\/semirings\/countingsemiring\/init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":")"}],"abstract":[{"type":"