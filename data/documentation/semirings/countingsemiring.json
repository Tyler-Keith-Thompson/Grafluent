{"kind":"symbol","sections":[],"metadata":{"symbolKind":"struct","title":"CountingSemiring","roleHeading":"Structure","modules":[{"name":"Semirings"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Semirings\/CountingSemiring.swift#L17","fileName":"CountingSemiring.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CountingSemiring","kind":"identifier"}],"externalID":"s:9Semirings16CountingSemiringV","navigatorTitle":[{"kind":"identifier","text":"CountingSemiring"}]},"abstract":[{"text":"The counting semiring (+, ×) over ","type":"text"},{"type":"codeVoice","code":"Value"},{"text":" (Green, Karvounarakis and Tannen’s ℕ).","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Semirings\/documentation\/Semirings\/CountingSemiring"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CountingSemiring"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sj","text":"Numeric"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"With unit weights, "},{"type":"codeVoice","code":"dagShortestDistances"},{"type":"text","text":" counts the paths. With other weights it sums, over"},{"type":"text","text":" "},{"type":"text","text":"every path, the product of the path’s weights, which is the probability semiring when the"},{"type":"text","text":" "},{"type":"text","text":"weights are probabilities."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"zero"},{"type":"text","text":" is 0, "},{"type":"codeVoice","code":"one"},{"type":"text","text":" is 1, ⊕ is "},{"type":"codeVoice","code":"+"},{"type":"text","text":" and ⊗ is "},{"type":"codeVoice","code":"*"},{"type":"text","text":". It is not selective, because ⊕ is not"},{"type":"text","text":" "},{"type":"text","text":"idempotent ("},{"type":"codeVoice","code":"a ⊕ a == 2a"},{"type":"text","text":"), and not "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":", so only "},{"type":"codeVoice","code":"dagShortestDistances"},{"type":"text","text":" takes it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Over "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" both operations trap on overflow, like every sum in ShortestPaths, because a"},{"type":"text","text":" "},{"type":"text","text":"saturated or wrapped count would be silently wrong. "},{"code":"Int.max","type":"codeVoice"},{"type":"text","text":" paths fit: 2⁶³ − 1, or 2³¹ − 1 where"},{"type":"text","text":" "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" is 32 bits. "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" rounds past 2⁵³."},{"type":"text","text":" "},{"type":"text","text":"For exact large counts, use any "},{"code":"Numeric & Hashable","type":"codeVoice"},{"type":"text","text":" big-integer type."}],"type":"paragraph"},{"type":"codeListing","code":["dag.dagShortestDistances(from: s) { _ in CountingSemiring(1) }"],"syntax":null}]}],"variants":[{"paths":["\/documentation\/semirings\/countingsemiring"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Semirings\/documentation\/Semirings"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","