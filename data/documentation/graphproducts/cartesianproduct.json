{"abstract":[{"type":"text","text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view."},{"type":"text","text":" "},{"type":"text","text":"Made by "},{"type":"codeVoice","code":"cartesianProduct(_:_:)"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/graphproducts\/cartesianproduct"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"metadata":{"title":"CartesianProduct","modules":[{"name":"GraphProducts"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProduct","kind":"identifier"}],"externalID":"s:13GraphProducts16CartesianProductV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/CartesianProduct.swift#L49","fileName":"CartesianProduct.swift"},"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"CartesianProduct"}],"role":"symbol"},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"kind":"relationships"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CartesianProduct"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"text":" are the pairs ","type":"text"},{"code":"Pair(g, h)","type":"codeVoice"},{"text":". Vertex (g, h) has index ","type":"text"},{"code":"index(g)·|V(H)| + index(h)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"code":"vertex(atIndex:)","type":"codeVoice"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" one lookup in each factor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Rows"}],"type":"strong"},{"type":"text","text":" list the G-moves first, "},{"code":"(g′, h)","type":"codeVoice"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"code":"(g, h′)","type":"codeVoice"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" law asks."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edges","type":"text"}],"type":"strong"},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"type":"text","text":" is G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at H’s vertex index "},{"type":"codeVoice","code":"h"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"type":"text","text":" is H’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at G’s vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"type":"codeVoice","code":".first"},{"type":"text","text":" edge, G-edge outer, then every "},{"type":"codeVoice","code":".second"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct"},"sections":[],"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/UndirectedEdges"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers