{"abstract":[{"type":"text","text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view."},{"type":"text","text":" "},{"type":"text","text":"Made by "},{"type":"codeVoice","code":"cartesianProduct(_:_:)"},{"type":"text","text":"."}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/UndirectedEdges"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/second"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/Position"],"anchor":"Enumerations","title":"Enumerations"},{"generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/Graph-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"title":"Conforms To"}],"variants":[{"paths":["\/documentation\/graphproducts\/cartesianproduct"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CartesianProduct"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"type":"text","text":" are the pairs "},{"type":"codeVoice","code":"Pair(g, h)"},{"type":"text","text":". Vertex (g, h) has index "},{"type":"codeVoice","code":"index(g)·|V(H)| + index(h)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"row-major, the numbering of NamedGraphs’ grids, so "},{"type":"codeVoice","code":"vertex(atIndex:)"},{"type":"text","text":" costs one division and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" one lookup in each factor."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Rows"}],"type":"strong"},{"type":"text","text":" list the G-moves first, "},{"code":"(g′, h)","type":"codeVoice"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"code":"(g, h′)","type":"codeVoice"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" law asks."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges","type":"text"}]},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"type":"text","text":" is G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at H’s vertex index "},{"type":"codeVoice","code":"h"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"type":"text","text":" is H’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at G’s vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"type":"codeVoice","code":".first"},{"type":"text","text":" edge, G-edge outer, then every "},{"type":"codeVoice","code":".second"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}]},{"type":"paragraph","inlineContent":[{"text":"To materialize it, pass it to a representation’s initializer. Products are ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" when both","type":"text"},{"text":" ","type":"text"},{"text":"factors are.","type":"text"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"metadata":{"externalID":"s:13GraphProducts16CartesianProductV","roleHeading":"Structure","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CartesianProduct"}],"modules":[{"name":"GraphProducts"}],"remoteSource":{"fileName":"CartesianProduct.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/CartesianProduct.swift#L49"},"title":"CartesianProduct","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProduct","kind":"identifier"}]},"references":{"doc://GraphProducts/documentation/GraphProducts/CartesianProduct/DirectedEdges":{"type":"topic","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"First","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Second","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"url":"\/documentation\/graphproducts\/cartesianproduct\/directededges","navigatorTitle":[{"text":"DirectedEdges","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedEdges","kind":"identifier"}],"abstract":[{"type":"text","text":"The edges of a directed Cartesian product, in position order."}],"title":"CartesianProduct.DirectedEdges","kind":"symbol","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/DirectedEdges","role":"symbol"},"doc://GraphProducts/documentation/GraphProducts/CartesianProduct/second":{"role":"symbol","fragments":