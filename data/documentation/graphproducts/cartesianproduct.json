\/documentation\/graphproducts\/cartesianproduct"]}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view."},{"type":"text","text":" "},{"type":"text","text":"Made by "},{"type":"codeVoice","code":"cartesianProduct(_:_:)"},{"type":"text","text":"."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CartesianProduct"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"type":"text","text":" are the pairs "},{"type":"codeVoice","code":"Pair(g, h)"},{"type":"text","text":". Vertex (g, h) has index "},{"type":"codeVoice","code":"index(g)·|V(H)| + index(h)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"row-major, the numbering of NamedGraphs’ grids, so "},{"type":"codeVoice","code":"vertex(atIndex:)"},{"type":"text","text":" costs one division and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" one lookup in each factor."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Rows","type":"text"}],"type":"strong"},{"type":"text","text":" list the G-moves first, "},{"code":"(g′, h)","type":"codeVoice"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"code":"(g, h′)","type":"codeVoice"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" law asks."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges"}]},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"code":".first(edge: e, vertexIndex: h)","type":"codeVoice"},{"type":"text","text":" is G’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" at H’s vertex index "},{"code":"h","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":".second(vertexIndex: g, edge: e)","type":"codeVoice"},{"type":"text","text":" is H’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" at G’s vertex index "},{"code":"g","type":"codeVoice"},{"type":"text","text":". "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"code":".first","type":"codeVoice"},{"type":"text","text":" edge, G-edge outer, then every "},{"code":".second","type":"codeVoice"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"code":"index(e)·|V(H)| + h","type":"codeVoice"},{"type":"text","text":", then "},{"code":"m_G·|V(H)| + g·m_H + index(e)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}]},{"type":"paragraph","inlineContent":[{"text":"To materialize it, pass it to a representation’s initializer. Products are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}]}]}],"references":{"doc://GraphProducts/documentation/GraphProducts/CartesianProduct/DirectedGraph-Implementations":{"kind":"article","type":"topic","title":"DirectedGraph Implementations","abstract":[],"url":"\/documentation\/graphproducts\/cartesianproduct\/directedgraph-implementations","role":"collectionGroup","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/DirectedGraph-Implementations"},"doc://GraphProducts/documentation/GraphProducts/CartesianProduct/Graph-Implementations":{"url":"\/documentation\/graphproducts\/cartesianproduct\/graph-implementations","kind":"article","type":"topic","title":"Graph Implementations","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/Graph-Implementations","role":"collectionGroup","abstract":[]},"doc://GraphProducts/documentation/GraphProducts/CartesianProduct":{"title":"CartesianProduct","abstract":[{"text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view.","type":"text"},{"text":" ","type":"text"},{"text":"Made by ","type":"text"},{"type":"codeVoice","code":"cartesianProduct(_:_:)"},{"text":".","type":"text"}],"fragments":[{"kind":