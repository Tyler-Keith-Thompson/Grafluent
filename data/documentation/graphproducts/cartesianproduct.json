row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex:)"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" one lookup in each factor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rows"}]},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges"}],"type":"strong"},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"code":".first(edge: e, vertexIndex: h)","type":"codeVoice"},{"type":"text","text":" is G’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" at H’s vertex index "},{"code":"h","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":".second(vertexIndex: g, edge: e)","type":"codeVoice"},{"type":"text","text":" is H’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" at G’s vertex index "},{"code":"g","type":"codeVoice"},{"type":"text","text":". "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"code":".first","type":"codeVoice"},{"type":"text","text":" edge, G-edge outer, then every "},{"code":".second","type":"codeVoice"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"code":"index(e)·|V(H)| + h","type":"codeVoice"},{"type":"text","text":", then "},{"code":"m_G·|V(H)| + g·m_H + index(e)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}]}]}],"references":{"doc://GraphProducts/documentation/GraphProducts/CartesianProduct/IndexRow":{"abstract":[{"text":"A row in index space: the G-moves, then the H-moves.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IndexRow","kind":"identifier"}],"navigatorTitle":[{"text":"IndexRow","kind":"identifier"}],"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/IndexRow","title":"CartesianProduct.IndexRow","kind":"symbol","url":"\/documentation\/graphproducts\/cartesianproduct\/indexrow","type":"topic","role":"symbol"},"doc://GraphProducts/s8CopyableP":{"identifier":"doc:\/\/GraphProducts\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://GraphProducts/documentation/GraphProducts/CartesianProduct/Graph-Implementations":{"abstract":[],"type":"topic","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProduct\/Graph-Implementations","role":"collectionGroup","kind":"article","title":"Graph Implementations","url":"\/documentation\/graphproducts\/cartesianproduct\/graph-implementations"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{