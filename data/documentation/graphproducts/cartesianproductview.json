roductView\/Graph-Implementations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertices","type":"text"}]},{"text":" are the pairs ","type":"text"},{"type":"codeVoice","code":"Pair(g, h)"},{"text":". Vertex (g, h) has index ","type":"text"},{"type":"codeVoice","code":"index(g)·|V(H)| + index(h)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex:)"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" one lookup in each factor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Rows","type":"text"}],"type":"strong"},{"text":" list the G-moves first, ","type":"text"},{"code":"(g′, h)","type":"codeVoice"},{"text":" for each entry g′ of G’s row of g, then the H-moves","type":"text"},{"text":" ","type":"text"},{"code":"(g, h′)","type":"codeVoice"},{"text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop","type":"text"},{"text":" ","type":"text"},{"text":"gives a product self-loop, listed twice in an undirected row as the ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" law asks.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edges","type":"text"}],"type":"strong"},{"text":" are named by the factor edge and the factor vertex that generate them:","type":"text"},{"text":" ","type":"text"},{"code":".first(edge: e, vertexIndex: h)","type":"codeVoice"},{"text":" is G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at H’s vertex index ","type":"text"},{"code":"h","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":".second(vertexIndex: g, edge: e)","type":"codeVoice"},{"text":" is H’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at G’s vertex index ","type":"text"},{"code":"g","type":"codeVoice"},{"text":". ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists every","type":"text"},{"text":" ","type":"text"},{"code":".first","type":"codeVoice"},{"text":" edge, G-edge outer, then every ","type":"text"},{"code":".second","type":"codeVoice"},{"text":" edge, G-vertex outer. When both factors have","type":"text"},{"text":" ","type":"text"},{"text":"edge indices, so does the product: ","type":"text"},{"code":"index(e)·|V(H)| + h","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"m_G·|V(H)| + g·m_H + index(e)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Products of multigraphs and pseudographs are defined edge by edge, so ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":", the rows and","type":"text"},{"text":" ","type":"text"},{"text":"the degrees always agree.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/cartesianp