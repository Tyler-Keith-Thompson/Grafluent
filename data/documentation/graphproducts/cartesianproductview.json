"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Position"],"title":"Enumerations","anchor":"Enumerations","generated":true},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Graph-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CartesianProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"type":"text","text":" are the pairs "},{"type":"codeVoice","code":"Pair(g, h)"},{"type":"text","text":". Vertex (g, h) has index "},{"type":"codeVoice","code":"index(g)·|V(H)| + index(h)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"row-major, the numbering of NamedGraphs’ grids, so "},{"type":"codeVoice","code":"vertex(atIndex:)"},{"type":"text","text":" costs one division and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" one lookup in each factor."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Rows"}],"type":"strong"},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges"}]},{"text":" are named by the factor edge and the factor vertex that generate them:","type":"text"},{"text":" ","type":"text"},{"code":".first(edge: e, vertexIndex: h)","type":"codeVoice"},{"text":" is G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at H’s vertex index ","type":"text"},{"code":"h","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":".second(vertexIndex: g, edge: e)","type":"codeVoice"},{"text":" is H’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at G’s vertex index ","type":"text"},{"code":"g","type":"codeVoice"},{"text":". ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists every","type":"text"},{"text":" ","type":"text"},{"code":".first","type":"codeVoice"},{"text":" edge, G-edge outer, then every ","type":"text"},{"code":".second","type":"codeVoice"},{"text":" edge, G-vertex outer. When both factors have","type":"text"},{"text":" ","type":"text"},{"text":"edge indices, so does the product: ","type":"text"},{"code":"index(e)·|V(H)| + h","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"m_G·|V(H)| + g·m_H + index(e)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Products of multigraphs and pseudographs are defined edge by edge, so ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":", the rows and","type":"text"},{"text":" ","type":"text"},{"text":"the degrees always agree.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/cartesianproductview"]}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"abstract":[{"text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view.","type":"text"},{"text":" ","type":"text"},{"text":"Made by ","type":"text"},{"code":"cartesianProductView(_:_:)","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://GraphProducts/documentation/GraphProducts/CartesianProductView/DirectedGraph-Implementations":{"type":"topic","abstract":[],"title":"DirectedGraph Implementations","url":"\/documentation\/graphproducts\/cartesianproductview\/directedgraph-implementations","kind":"article","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedGraph-Implementations","role":"collectionGroup"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directedView"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphPr