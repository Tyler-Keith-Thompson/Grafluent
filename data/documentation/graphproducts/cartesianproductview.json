g)·|V(H)| + index(h)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"code":"vertex(atIndex:)","type":"codeVoice"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" one lookup in each factor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rows"}]},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges"}]},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"type":"text","text":" is G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at H’s vertex index "},{"type":"codeVoice","code":"h"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"type":"text","text":" is H’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at G’s vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"type":"codeVoice","code":".first"},{"type":"text","text":" edge, G-edge outer, then every "},{"type":"codeVoice","code":".second"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}],"type":"paragraph"},{"inlineContent":[{"text":"To materialize it, pass it to a representation’s initializer. Products are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when both","type":"text"},{"text":" ","type":"text"},{"text":"factors are.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view."},{"type":"text","text":" "},{"type":"text","text":"Made by "},{"type":"codeVoice","code":"cartesianProductView(_:_:)"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/cartesianproductview"]}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/UndirectedEdges"]},{"generated":true,"ancho