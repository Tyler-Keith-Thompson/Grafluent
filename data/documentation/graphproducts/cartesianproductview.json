{"abstract":[{"text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view.","type":"text"},{"text":" ","type":"text"},{"text":"Made by ","type":"text"},{"code":"cartesianProductView(_:_:)","type":"codeVoice"},{"text":".","type":"text"}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/UndirectedEdges"],"title":"Structures","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/second"],"title":"Instance Properties","generated":true},{"anchor":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Position"],"title":"Enumerations","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Graph-Implementations"],"title":"Default Implementations","generated":true}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","metadata":{"remoteSource":{"fileName":"CartesianProductView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/CartesianProductView.swift#L48"},"symbolKind":"struct","navigatorTitle":[{"text":"CartesianProductView","kind":"identifier"}],"modules":[{"name":"GraphProducts"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"}],"roleHeading":"Structure","title":"CartesianProductView","externalID":"s:13GraphProducts20CartesianProductViewV"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Vertices"}],"type":"strong"},{"type":"text","text":" are the pairs "},{"type":"codeVoice","code":"Pair(g, h)"},{"type":"text","text":". Vertex (g, h) has index "},{"type":"codeVoice","code":"index(g)·|V(H)| + index(h)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"row-major, the numbering of NamedGraphs’ grids, so "},{"type":"codeVoice","code":"vertex(atIndex:)"},{"type":"text","text":" costs one division and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" one lookup in each factor."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rows"}]},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges"}]},{"text":" are named by the factor edge and the factor vertex that generate them:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"text":" is G’s edge ","type":"text"},{"type":"codeVoice","code":"e"},{"text":" at H’s vertex index ","type":"text"},{"type":"codeVoice","code":"h"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"text":" is H’s edge ","type":"text"},{"type":"codeVoice","code":"e"},{"text":" at G’s vertex index ","type":"text"},{"type":"codeVoice","code":"g"},{"text":". ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists every","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".first"},{"text":" edge, G-edge outer, then every ","type":"text"},{"type":"codeVoice","code":".second"},{"text":" edge, G-vertex outer. When both factors have","type":"text"},{"text":" ","type":"text"},{"text":"edge indices, so does the product: ","type":"text"},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"text":", then ","type":"text"},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Products of multigraphs and pseudographs are defined edge by edge, so ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":", the rows and","type":"text"},{"text":" ","type":"text"},{"text":"the degrees always agree.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To materialize it, pass it to a representation’s initializer. Products are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when both","type":"text"},{"text":" ","type":"text"},{"text":"factors are.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/graphproducts\/cartesianproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView","interfaceLanguage":"swift"},"references":{"doc://GraphProducts/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/GraphProducts\/s9EscapableP","type":"unresolvable"},"doc://GraphProducts/documentation/GraphProducts/CartesianProductView/UndirectedEdges":{"conformance":{"constraints":[{"type":"codeVoice","code":"First"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Second"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdges"}],"url":"\/documentation\/graphproducts\/cartesianproductview\/undirectededges","navigatorTitle":[{"kind":"identifier","text":"UndirectedEdges"}],"role":"symbol","abstract":[{"text":"The edges of an undirected Cartesian product, in position order.","type":"text"}],"type":"topic","identifier":"doc:\/\/GraphProducts\/d