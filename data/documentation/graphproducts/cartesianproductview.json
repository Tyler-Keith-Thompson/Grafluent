{"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/cartesianproductview"]}],"metadata":{"role":"symbol","externalID":"s:13GraphProducts20CartesianProductViewV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CartesianProductView"}],"title":"CartesianProductView","roleHeading":"Structure","remoteSource":{"fileName":"CartesianProductView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/CartesianProductView.swift#L48"},"modules":[{"name":"GraphProducts"}],"navigatorTitle":[{"text":"CartesianProductView","kind":"identifier"}],"symbolKind":"struct"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CartesianProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"inlineContent":[{"text":"Vertices","type":"text"}],"type":"strong"},{"text":" are the pairs ","type":"text"},{"code":"Pair(g, h)","type":"codeVoice"},{"text":". Vertex (g, h) has index ","type":"text"},{"code":"index(g)·|V(H)| + index(h)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"code":"vertex(atIndex:)","type":"codeVoice"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" one lookup in each factor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Rows","type":"text"}]},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Edges","type":"text"}],"type":"strong"},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"code":".first(edge: e, vertexIndex: h)","type":"codeVoice"},{"type":"text","text":" is G’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" at H’s vertex index "},{"code":"h","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":".second(vertexIndex: g, edge: e)","type":"codeVoice"},{"type":"text","text":" is H’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" at G’s vertex index "},{"code":"g","type":"codeVoice"},{"type":"text","text":". "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"code":".first","type":"codeVoice"},{"type":"text","text":" edge, G-edge outer, then every "},{"code":".second","type":"codeVoice"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"code":"index(e)·|V(H)| + h","type":"codeVoice"},{"type":"text","text":", then "},{"code":"m_G·|V(H)| + g·m_H + index(e)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"kind":"symbol","abstract":[{"text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view.","type":"text"},{"text":" ","type":"text"},{"text":"Made by ","type":"text"},{"type":"codeVoice","code":"cartesianProductView(_:_:)"},{"text":".","type":"text"}],"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/UndirectedEdges"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/second"],"generated":true},{"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Position"],"generated":true},{"title":"Default Implementati