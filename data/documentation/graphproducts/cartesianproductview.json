e":"text","text":" one lookup in each factor."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Rows"}],"type":"strong"},{"type":"text","text":" list the G-moves first, "},{"code":"(g′, h)","type":"codeVoice"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"code":"(g, h′)","type":"codeVoice"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" law asks."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Edges"}],"type":"strong"},{"text":" are named by the factor edge and the factor vertex that generate them:","type":"text"},{"text":" ","type":"text"},{"code":".first(edge: e, vertexIndex: h)","type":"codeVoice"},{"text":" is G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at H’s vertex index ","type":"text"},{"code":"h","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":".second(vertexIndex: g, edge: e)","type":"codeVoice"},{"text":" is H’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at G’s vertex index ","type":"text"},{"code":"g","type":"codeVoice"},{"text":". ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists every","type":"text"},{"text":" ","type":"text"},{"code":".first","type":"codeVoice"},{"text":" edge, G-edge outer, then every ","type":"text"},{"code":".second","type":"codeVoice"},{"text":" edge, G-vertex outer. When both factors have","type":"text"},{"text":" ","type":"text"},{"text":"edge indices, so does the product: ","type":"text"},{"code":"index(e)·|V(H)| + h","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"m_G·|V(H)| + g·m_H + index(e)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Products of multigraphs and pseudographs are defined edge by edge, so ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":", the rows and","type":"text"},{"text":" ","type":"text"},{"text":"the degrees always agree.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/graphproducts\/cartesianproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProducts/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/GraphProducts\/s16SendableMetatypeP"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","role":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"title":"Graph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphProducts/documentation/GraphProducts/CartesianProductView":{"abstract":[{"type":"text","text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view."},{"type":"text","text":" "},{"type":"text","text":"Made by "},{"type":"codeVoice","code":"cartesianProductView(_:_:)"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kin