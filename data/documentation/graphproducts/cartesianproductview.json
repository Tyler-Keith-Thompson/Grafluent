grids, so ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex:)"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" one lookup in each factor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Rows","type":"text"}]},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges"}],"type":"strong"},{"text":" are named by the factor edge and the factor vertex that generate them:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"text":" is G’s edge ","type":"text"},{"type":"codeVoice","code":"e"},{"text":" at H’s vertex index ","type":"text"},{"type":"codeVoice","code":"h"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"text":" is H’s edge ","type":"text"},{"type":"codeVoice","code":"e"},{"text":" at G’s vertex index ","type":"text"},{"type":"codeVoice","code":"g"},{"text":". ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists every","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".first"},{"text":" edge, G-edge outer, then every ","type":"text"},{"type":"codeVoice","code":".second"},{"text":" edge, G-vertex outer. When both factors have","type":"text"},{"text":" ","type":"text"},{"text":"edge indices, so does the product: ","type":"text"},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"text":", then ","type":"text"},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Products of multigraphs and pseudographs are defined edge by edge, so ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":", the rows and","type":"text"},{"text":" ","type":"text"},{"text":"the degrees always agree.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView"},"references":{"doc://GraphProducts/documentation/GraphProducts/CartesianProductView/IndexRow":{"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","url":"\/documentation\/graphproducts\/cartesianproductview\/indexrow","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A row in index space: the G-moves, then the H-moves."}],"navigatorTitle":[{"text":"IndexRow","kind":"identifier"}],"title":"CartesianProductView.IndexRow","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IndexRow","kind":"identifier"}]},"doc://GraphProducts/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/GraphProducts\/s16SendableMetatypeP"},"doc://GraphProducts/documentation/GraphProducts":{"kind":"symbol","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts","type":"topic","abstract":[],"url":"\/documentation\/graphproducts","title":"GraphProducts","role":"collection"},"doc://GraphProducts/documentation/GraphProducts/CartesianProductView/first":{"url":"\/do