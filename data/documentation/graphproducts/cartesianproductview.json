e","code":"vertexIndex(of:)"},{"text":" one lookup in each factor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Rows"}],"type":"strong"},{"text":" list the G-moves first, ","type":"text"},{"code":"(g′, h)","type":"codeVoice"},{"text":" for each entry g′ of G’s row of g, then the H-moves","type":"text"},{"text":" ","type":"text"},{"code":"(g, h′)","type":"codeVoice"},{"text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop","type":"text"},{"text":" ","type":"text"},{"text":"gives a product self-loop, listed twice in an undirected row as the ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" law asks.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edges","type":"text"}],"type":"strong"},{"text":" are named by the factor edge and the factor vertex that generate them:","type":"text"},{"text":" ","type":"text"},{"code":".first(edge: e, vertexIndex: h)","type":"codeVoice"},{"text":" is G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at H’s vertex index ","type":"text"},{"code":"h","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":".second(vertexIndex: g, edge: e)","type":"codeVoice"},{"text":" is H’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" at G’s vertex index ","type":"text"},{"code":"g","type":"codeVoice"},{"text":". ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists every","type":"text"},{"text":" ","type":"text"},{"code":".first","type":"codeVoice"},{"text":" edge, G-edge outer, then every ","type":"text"},{"code":".second","type":"codeVoice"},{"text":" edge, G-vertex outer. When both factors have","type":"text"},{"text":" ","type":"text"},{"text":"edge indices, so does the product: ","type":"text"},{"code":"index(e)·|V(H)| + h","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"m_G·|V(H)| + g·m_H + index(e)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Products of multigraphs and pseudographs are defined edge by edge, so ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":", the rows and","type":"text"},{"text":" ","type":"text"},{"text":"the degrees always agree.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To materialize it, pass it to a representation’s initializer. Products are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when both","type":"text"},{"text":" ","type":"text"},{"text":"factors are.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/cartesianproductview"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/UndirectedEdges"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/second"]},{"anchor":"Enumerations","generated":true,"title":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Position"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProd