code":"vertex(atIndex:)","type":"codeVoice"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" one lookup in each factor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rows"}]},{"text":" list the G-moves first, ","type":"text"},{"code":"(g′, h)","type":"codeVoice"},{"text":" for each entry g′ of G’s row of g, then the H-moves","type":"text"},{"text":" ","type":"text"},{"code":"(g, h′)","type":"codeVoice"},{"text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop","type":"text"},{"text":" ","type":"text"},{"text":"gives a product self-loop, listed twice in an undirected row as the ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" law asks.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges","type":"text"}]},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"type":"text","text":" is G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at H’s vertex index "},{"type":"codeVoice","code":"h"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"type":"text","text":" is H’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at G’s vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"type":"codeVoice","code":".first"},{"type":"text","text":" edge, G-edge outer, then every "},{"type":"codeVoice","code":".second"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/cartesianproductview"]}],"sections":[],"references":{"doc://GraphProducts/documentation/GraphProducts/CartesianProductView/first":{"type":"topic","url":"\/documentation\/graphproducts\/cartesianproductview\/first","abstract":[{"text":"G, the first factor.","type":"text"}],"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"first","kind":"identifier"},{"text":": ","kind":"text"},{"text":"First","kind":"typeIdentifier"}],"title":"first","role":"symbol"},"doc://GraphProducts/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/GraphProducts\/s8CopyableP"},"doc://GraphProducts/documentation/GraphProducts/CartesianProductView/Position":{"abstract":[{"text":"The position of an edge of a Cartesian product: the factor edge that generates it, and the","type":"text"},{"text":" ","type":"text"},{"text":"other factor’s vertex index. Ordered as ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists them.","type":"text"}],"type":"topic","url":"\/documentation\/graphpr