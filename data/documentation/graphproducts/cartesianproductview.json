{"variants":[{"paths":["\/documentation\/graphproducts\/cartesianproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","navigatorTitle":[{"text":"CartesianProductView","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/CartesianProductView.swift#L48","fileName":"CartesianProductView.swift"},"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"}],"symbolKind":"struct","title":"CartesianProductView","modules":[{"name":"GraphProducts"}],"externalID":"s:13GraphProducts20CartesianProductViewV"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"text":" are the pairs ","type":"text"},{"code":"Pair(g, h)","type":"codeVoice"},{"text":". Vertex (g, h) has index ","type":"text"},{"code":"index(g)·|V(H)| + index(h)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"code":"vertex(atIndex:)","type":"codeVoice"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" one lookup in each factor.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rows"}]},{"text":" list the G-moves first, ","type":"text"},{"type":"codeVoice","code":"(g′, h)"},{"text":" for each entry g′ of G’s row of g, then the H-moves","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"(g, h′)"},{"text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop","type":"text"},{"text":" ","type":"text"},{"text":"gives a product self-loop, listed twice in an undirected row as the ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" law asks.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges"}]},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"type":"text","text":" is G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at H’s vertex index "},{"type":"codeVoice","code":"h"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"type":"text","text":" is H’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at G’s vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"type":"codeVoice","code":".first"},{"type":"text","text":" edge, G-edge outer, then every "},{"type":"codeVoice","code":".second"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}],"type":"paragraph"}]}],"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/UndirectedEdges"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/second"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Position"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Graph-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDir