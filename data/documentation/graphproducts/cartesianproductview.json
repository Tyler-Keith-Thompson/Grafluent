{"abstract":[{"text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view.","type":"text"},{"text":" ","type":"text"},{"text":"Made by ","type":"text"},{"code":"cartesianProductView(_:_:)","type":"codeVoice"},{"text":".","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/cartesianproductview"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/UndirectedEdges"],"title":"Structures","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/second"],"title":"Instance Properties","generated":true},{"anchor":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Position"],"title":"Enumerations","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Graph-Implementations"],"title":"Default Implementations","generated":true}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Vertices"}],"type":"strong"},{"text":" are the pairs ","type":"text"},{"type":"codeVoice","code":"Pair(g, h)"},{"text":". Vertex (g, h) has index ","type":"text"},{"type":"codeVoice","code":"index(g)·|V(H)| + index(h)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex:)"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" one lookup in each factor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Rows","type":"text"}]},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edges","type":"text"}],"type":"strong"},{"text":" are named by the factor edge and the factor vertex that generate them:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"text":" is G’s edge ","type":"text"},{"type":"codeVoice","code":"e"},{"text":" at H’s vertex index ","type":"text"},{"type":"codeVoice","code":"h"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"text":" is H’s edge ","type":"text"},{"type":"codeVoice","code":"e"},{"text":" at G’s vertex index ","type":"text"},{"type":"codeVoice","code":"g"},{"text":". ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists every","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".first"},{"text":" edge, G-edge outer, then every ","type":"text"},{"type":"codeVoice","code":".second"},{"text":" edge, G-vertex outer. When both factors have","type":"text"},{"text":" ","type":"text"},{"text":"edge indices, so does the product: ","type":"text"},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"text":", then ","type":"text"},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Products of multigraphs and pseudographs are defined edge by edge, so ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":", the rows and","type":"text"},{"text":" ","type":"text"},{"text":"the degrees always agree.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To materialize it, pass it to a representation’s initializer. Products are ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" when both","type":"text"},{"text":" ","type":"text"},{"text":"factors are.","type":"text"}]}]}],"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/CartesianProductView.swift#L48","fileName":"CartesianProductView.swift"},"navigatorTitle":[{"kind":"identifier","text":"CartesianProductView"}],"externalID":"s:13GraphProducts20CartesianProductViewV","modules":[{"name":"GraphProducts"}],"title":"CartesianProductView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"references":{"doc://GraphProducts/documentation/GraphProducts/CartesianProductView/first":{"role":"symbol","type":"topic","title":"first","url":"\/documentation\/graphproducts\/cartesianproductview\/first","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"first"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"First"}],"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","abstract":[{"type":"text","text":"G, the first factor."}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"type":"topic","kind":"symbol","title":"DirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "}