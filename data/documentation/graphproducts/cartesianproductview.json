{"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView"},"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeIndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/UndirectedEdges"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/second"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Position"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/CartesianProductView\/Graph-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CartesianProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertices","type":"text"}]},{"text":" are the pairs ","type":"text"},{"type":"codeVoice","code":"Pair(g, h)"},{"text":". Vertex (g, h) has index ","type":"text"},{"type":"codeVoice","code":"index(g)·|V(H)| + index(h)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"row-major, the numbering of NamedGraphs’ grids, so ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex:)"},{"text":" costs one division and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" one lookup in each factor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rows"}]},{"type":"text","text":" list the G-moves first, "},{"type":"codeVoice","code":"(g′, h)"},{"type":"text","text":" for each entry g′ of G’s row of g, then the H-moves"},{"type":"text","text":" "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":". They are computed from the factors’ index rows and never hash. A factor’s self-loop"},{"type":"text","text":" "},{"type":"text","text":"gives a product self-loop, listed twice in an undirected row as the "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" law asks."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges"}]},{"type":"text","text":" are named by the factor edge and the factor vertex that generate them:"},{"type":"text","text":" "},{"type":"codeVoice","code":".first(edge: e, vertexIndex: h)"},{"type":"text","text":" is G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at H’s vertex index "},{"type":"codeVoice","code":"h"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: e)"},{"type":"text","text":" is H’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" at G’s vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists every"},{"type":"text","text":" "},{"type":"codeVoice","code":".first"},{"type":"text","text":" edge, G-edge outer, then every "},{"type":"codeVoice","code":".second"},{"type":"text","text":" edge, G-vertex outer. When both factors have"},{"type":"text","text":" "},{"type":"text","text":"edge indices, so does the product: "},{"type":"codeVoice","code":"index(e)·|V(H)| + h"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)| + g·m_H + index(e)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Products of multigraphs and pseudographs are defined edge by edge, so "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":", the rows and"},{"type":"text","text":" "},{"type":"text","text":"the degrees always agree."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To materialize it, pass it to a representation’s initializer. Products are "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" when both"},{"type":"text","text":" "},{"type":"text","text":"factors are."}]}]}],"sections":[],"abstract":[{"text":"The Cartesian product G □ H of two graphs, both directed or both undirected, as a lazy view.","type":"text"},{"text":" ","type":"text"},{"text":"Made by ","type":"text"},{"c