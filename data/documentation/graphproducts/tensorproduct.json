{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TensorProduct"}],"title":"TensorProduct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProduct","kind":"identifier"}],"externalID":"s:13GraphProducts13TensorProductV","modules":[{"name":"GraphProducts"}],"roleHeading":"Structure","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProduct.swift#L42","fileName":"TensorProduct.swift"}},"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"abstract":[{"type":"text","text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"tensorProduct(_:_:)"},{"type":"text","text":". Also called the direct, categorical or Kronecker product."}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Position","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedIndexRow"],"anchor":"Structures","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/second"],"anchor":"Instance-Properties","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Graph-Implementations"],"anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProduct"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProduct"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from"},{"type":"text","text":" "},{"type":"text","text":"the factors’ index rows and never hash."}]},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"text":": G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" and H’s edge","type":"text"},{"text":" ","type":"text"},{"code":"f","type":"codeVoice"},{"text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight","type":"text"},{"text":" ","type":"text"},{"text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" ends; when","type":"text"},{"text":" ","type":"text"},{"text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor","type":"text"},{"text":" ","type":"text"},{"text":"self-loop from its first appearance only, so every product edge has each of its ends once in","type":"text"},{"text":" ","type":"text"},{"text":"the rows. Directed, ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" is always false, and the product has edge indices","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"text":" when both factors have them; undirected it has none, because a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop changes how many edges a factor pair gives.","type":"text"}]}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/graphproducts\/tensorproduct"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct","interfaceLanguage":"swift"},"references":{"doc://GraphProducts/documentation/GraphProducts/TensorProduct/DirectedGraph-Implementations":{"kind":"article","url":"\/documentation\/graphproducts\/tensorproduct\/directedgraph-implementations","title":"DirectedGraph Implementations","abstract":[],"type":"topic","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedGraph-Implementations","role":"collectionGroup"},"doc://GraphProtocols/documenta