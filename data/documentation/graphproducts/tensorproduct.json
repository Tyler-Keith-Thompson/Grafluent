{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/tensorproduct"]}],"abstract":[{"type":"text","text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made"},{"type":"text","text":" "},{"type":"text","text":"by "},{"code":"tensorProduct(_:_:)","type":"codeVoice"},{"type":"text","text":". Also called the direct, categorical or Kronecker product."}],"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Position","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedIndexRow"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/second"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Graph-Implementations"],"generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProduct","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProduct"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from"},{"type":"text","text":" "},{"type":"text","text":"the factors’ index rows and never hash."}]},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"text":": G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" and H’s edge","type":"text"},{"text":" ","type":"text"},{"code":"f","type":"codeVoice"},{"text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight","type":"text"},{"text":" ","type":"text"},{"text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" ends; when","type":"text"},{"text":" ","type":"text"},{"text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor","type":"text"},{"text":" ","type":"text"},{"text":"self-loop from its first appearance only, so every product edge has each of its ends once in","type":"text"},{"text":" ","type":"text"},{"text":"the rows. Directed, ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" is always false, and the product has edge indices","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"text":" when both factors have them; undirected it has none, because a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop changes how many edges a factor pair gives.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"navigatorTitle":[{"text":"TensorProduct","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProduct"}],"role":"symbol","symbolKind":"struct","roleHeading":"Structure","title":"TensorProduct","modules":[{"name":"GraphProducts"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProduct.swift#L42","fileName":"TensorProduct.swift"},"externalID":"s:13GraphProducts13TensorProductV"},"references":{"doc://GraphProducts/documentation/GraphProducts/TensorProduct/IndexRow":{"kind":"symbol","type":"topic","title":"TensorProduct.IndexRow","abstract":[{"text":"A directed row in index space: ","type":"text"},{"type":"codeVoice","code":"(g′, h′)"},{"text":" for g′ in G’s row and h′ in H’s row, G outer.","type":"text"}],"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/IndexRow","role":"symbol","url":"\/