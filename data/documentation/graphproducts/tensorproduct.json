rtices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphProducts/s9EscapableP":{"identifier":"doc:\/\/GraphProducts\/s9EscapableP","title":"Swift.Escapable","type":"unresolvable"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"topic","title":"BidirectionalDirectedGraph"},"doc://GraphProducts/documentation/GraphProducts":{"role":"collection","type":"topic","title":"GraphProducts","kind":"symbol","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts","abstract":[],"url":"\/documentation\/gr