{"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"tensorProduct(_:_:)"},{"type":"text","text":". Also called the direct, categorical or Kronecker product."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/tensorproduct"]}],"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Position","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedIndexRow"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/second"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Graph-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProduct","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProduct"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from"},{"type":"text","text":" "},{"type":"text","text":"the factors’ index rows and never hash."}]},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"text":": G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" and H’s edge","type":"text"},{"text":" ","type":"text"},{"code":"f","type":"codeVoice"},{"text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight","type":"text"},{"text":" ","type":"text"},{"text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" ends; when","type":"text"},{"text":" ","type":"text"},{"text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor","type":"text"},{"text":" ","type":"text"},{"text":"self-loop from its first appearance only, so every product edge has each of its ends once in","type":"text"},{"text":" ","type":"text"},{"text":"the rows. Directed, ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" is always false, and the product has edge indices","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"text":" when both factors have them; undirected it has none, because a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop changes how many edges a factor pair gives.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"metadata":{"symbolKind":"struct","title":"TensorProduct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProduct.swift#L42","fileName":"TensorProduct.swift"},"role":"symbol","externalID":"s:13GraphProducts13TensorProductV","modules":[{"name":"GraphProducts"}],"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProduct"}],"navigatorTitle":[{"text":"TensorProduct","kind":"identifier"}]},"references":{"doc://GraphProducts/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/GraphProducts\/s8SendableP"},"doc://GraphProducts/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/GraphProducts\/s9EscapableP","title":"Swift.Escapable"},"doc://GraphProducts/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/GraphProducts\/s8CopyableP"},"doc://GraphProducts/documentation