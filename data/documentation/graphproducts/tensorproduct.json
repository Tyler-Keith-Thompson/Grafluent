{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProduct"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"code":"CartesianProduct","type":"codeVoice"},{"type":"text","text":". The row of (g, h) lists "},{"code":"(g′, h′)","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from"},{"type":"text","text":" "},{"type":"text","text":"the factors’ index rows and never hash."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An edge’s position is "},{"type":"codeVoice","code":"Position(first: e, second: f, reversed:)"},{"type":"text","text":": G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" and H’s edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"f"},{"type":"text","text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight"},{"type":"text","text":" "},{"type":"text","text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ "},{"type":"codeVoice","code":"u"},{"type":"text","text":" ends; when"},{"type":"text","text":" "},{"type":"text","text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor"},{"type":"text","text":" "},{"type":"text","text":"self-loop from its first appearance only, so every product edge has each of its ends once in"},{"type":"text","text":" "},{"type":"text","text":"the rows. Directed, "},{"type":"codeVoice","code":"reversed"},{"type":"text","text":" is always false, and the product has edge indices"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(e)·m_H + index(f)"},{"type":"text","text":" when both factors have them; undirected it has none, because a"},{"type":"text","text":" "},{"type":"text","text":"self-loop changes how many edges a factor pair gives."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"abstract":[{"text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"tensorProduct(_:_:)","type":"codeVoice"},{"text":". Also called the direct, categorical or Kronecker product.","type":"text"}],"kind":"symbol","topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Position","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/UndirectedIndexRow"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/second"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/Graph-Implementations"]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"TensorProduct"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProduct"}],"remoteSource":{"fileName":"TensorProduct.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProduct.swift#L42"},"title":"TensorProduct","symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"GraphProducts"}],"externalID":"s:13GraphProducts13TensorProductV"},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"kind":"relationships"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/tensorproduct"]}],"references":{"doc://GraphProducts/documentation/GraphProducts/TensorProduct/BidirectionalDirectedGraph-Implementations":{"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProduct\/BidirectionalDirectedGraph-Implementations","title":"BidirectionalDirectedGraph Implementations","url":"\/documentation\/graphproducts\/tensorproduct\/bidirectionaldirectedgraph-implementations","role":"collectionGroup","abstract":[],"kind":"arti