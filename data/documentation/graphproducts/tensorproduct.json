ext":"The position of an edge of a tensor product: the G-edge and the H-edge that generate it,"},{"type":"text","text":" "},{"type":"text","text":"and, undirected, whether it is the reversed one of the pair. Ordered by "},{"type":"codeVoice","code":"first"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"second"},{"text":", the straight edge before the reversed one, as ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists them.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Position","kind":"identifier"}]},"doc://GraphProducts/documentation/GraphProducts":{"role":"collection","type":"topic","title":"GraphProducts","kind":"symbol","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts","abstract":[],"url":"\/documentation\/graphproducts"}}}