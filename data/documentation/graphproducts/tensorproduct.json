position is "},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"type":"text","text":": G’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" and H’s edge"},{"type":"text","text":" "},{"code":"f","type":"codeVoice"},{"type":"text","text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight"},{"type":"text","text":" "},{"type":"text","text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ "},{"code":"u","type":"codeVoice"},{"type":"text","text":" ends; when"},{"type":"text","text":" "},{"type":"text","text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor"},{"type":"text","text":" "},{"type":"text","text":"self-loop from its first appearance only, so every product edge has each of its ends once in"},{"type":"text","text":" "},{"type":"text","text":"the rows. Directed, "},{"code":"reversed","type":"codeVoice"},{"type":"text","text":" is always false, and the product has edge indices"},{"type":"text","text":" "},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"type":"text","text":" when both factors have them; undirected it has none, because a"},{"type":"text","text":" "},{"type":"text","text":"self-loop changes how many edges a factor pair gives."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/tensorproduct"]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProduct.swift#L42","fileName":"TensorProduct.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProduct","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"TensorProduct"}],"modules":[{"name":"GraphProducts"}],"roleHeading":"Structure","role":"symbol","externalID":"s:13GraphProducts13TensorProductV","title":"TensorProduct"},"identifier":{"