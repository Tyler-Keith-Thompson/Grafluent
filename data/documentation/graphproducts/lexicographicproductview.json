"},{"text":" ","type":"text"},{"text":"second. Directed, the product has edge indices when both factors do:","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·|V(H)|² + s·|V(H)| + t","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"m_G·|V(H)|² + g·m_H + index(f)","type":"codeVoice"},{"text":". Undirected it has none.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The lexicographic product G ∘ H of two graphs, both directed or both undirected, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view. Made by "},{"type":"codeVoice","code":"lexicographicProductView(_:_:)"},{"type":"text","text":". Also called the composition G[H]."}],"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/lexicographicproductview"]}],"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"GraphProducts"}],"externalID":"s:13GraphProducts24LexicographicProductViewV","role":"symbol","roleHeading":"Structure","title":"LexicographicProductView","navigatorTitle":[{"text":"LexicographicProductView","kind":"identifier"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LexicographicProductView"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/Lexi