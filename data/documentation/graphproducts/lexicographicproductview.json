{"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"sections":[],"kind":"symbol","abstract":[{"text":"The lexicographic product G ∘ H of two graphs, both directed or both undirected, as a lazy","type":"text"},{"text":" ","type":"text"},{"text":"view. Made by ","type":"text"},{"code":"lexicographicProductView(_:_:)","type":"codeVoice"},{"text":". Also called the composition G[H].","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LexicographicProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Vertices and their indices are as in ","type":"text"},{"code":"CartesianProductView","type":"codeVoice"},{"text":". The row of (g, h) lists ","type":"text"},{"code":"(g′, h′)","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"each entry g′ of G’s row and ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"text":" h′ of H, in index order, then the H-moves ","type":"text"},{"code":"(g, h′)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":".first(edge: e, uVertexIndex: s, vVertexIndex: t)","type":"codeVoice"},{"text":", G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"text":"H-vertex index ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" at its ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" end (directed: its source) and ","type":"text"},{"code":"t","type":"codeVoice"},{"text":" at its ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" end (its target), or","type":"text"},{"text":" ","type":"text"},{"code":".second(vertexIndex: g, edge: f)","type":"codeVoice"},{"text":", H’s edge ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" at G-vertex index ","type":"text"},{"code":"g","type":"codeVoice"},{"text":". Over an undirected","type":"text"},{"text":" ","type":"text"},{"text":"self-loop of G only ","type":"text"},{"code":"s ≤ t","type":"codeVoice"},{"text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row","type":"text"},{"text":" ","type":"text"},{"text":"lists such a loop’s edges at its first appearance, and only the product loop again at its","type":"text"},{"text":" ","type":"text"},{"text":"second. Directed, the product has edge indices when both factors do:","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·|V(H)|² + s·|V(H)| + t","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"m_G·|V(H)|² + g·m_H + index(f)","type":"codeVoice"},{"text":". Undirected it has none.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/graphproducts\/lexicographicproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdges","doc:\/\/GraphProd