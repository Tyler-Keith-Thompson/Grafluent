{"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"abstract":[{"type":"text","text":"The lexicographic product G ∘ H of two graphs, both directed or both undirected, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view. Made by "},{"code":"lexicographicProductView(_:_:)","type":"codeVoice"},{"type":"text","text":". Also called the composition G[H]."}],"metadata":{"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LexicographicProductView","kind":"identifier"}],"modules":[{"name":"GraphProducts"}],"symbolKind":"struct","externalID":"s:13GraphProducts24LexicographicProductViewV","navigatorTitle":[{"text":"LexicographicProductView","kind":"identifier"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/LexicographicProductView.swift#L39","fileName":"LexicographicProductView.swift"},"title":"LexicographicProductView"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LexicographicProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProductView"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row and "},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" h′ of H, in index order, then the H-moves "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An edge’s position is "},{"type":"codeVoice","code":".first(edge: e, uVertexIndex: s, vVertexIndex: t)"},{"type":"text","text":", G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"H-vertex index "},{"type":"codeVoice","code":"s"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"u"},{"type":"text","text":" end (directed: its source) and "},{"type":"codeVoice","code":"t"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"v"},{"type":"text","text":" end (its target), or"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: f)"},{"type":"text","text":", H’s edge "},{"type":"codeVoice","code":"f"},{"type":"text","text":" at G-vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". Over an undirected"},{"type":"text","text":" "},{"type":"text","text":"self-loop of G only "},{"type":"codeVoice","code":"s ≤ t"},{"type":"text","text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row"},{"type":"text","text":" "},{"type":"text","text":"lists such a loop’s edges at its first appearance, and only the product loop again at its"},{"type":"text","text":" "},{"type":"text","text":"second. Directed, the product has edge indices when both factors do:"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(e)·|V(H)|² + s·|V(H)| + t"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)|² + g·m_H + index(f)"},{"type":"text","text":". Undirected it has none."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/lexicographicproductview"]}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedIndexRow"],"generated":true,"title":"Structures"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/second"],"generated":true,"title":"Instance Properties"},{"anchor":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/Position"],"generated":true,"title":"Enumerations"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documen