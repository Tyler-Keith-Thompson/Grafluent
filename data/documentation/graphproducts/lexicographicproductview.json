{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LexicographicProductView"}],"navigatorTitle":[{"text":"LexicographicProductView","kind":"identifier"}],"remoteSource":{"fileName":"LexicographicProductView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/LexicographicProductView.swift#L39"},"title":"LexicographicProductView","externalID":"s:13GraphProducts24LexicographicProductViewV","roleHeading":"Structure","modules":[{"name":"GraphProducts"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LexicographicProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProductView"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row and "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" h′ of H, in index order, then the H-moves "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An edge’s position is "},{"type":"codeVoice","code":".first(edge: e, uVertexIndex: s, vVertexIndex: t)"},{"type":"text","text":", G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"H-vertex index "},{"type":"codeVoice","code":"s"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"u"},{"type":"text","text":" end (directed: its source) and "},{"type":"codeVoice","code":"t"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"v"},{"type":"text","text":" end (its target), or"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: f)"},{"type":"text","text":", H’s edge "},{"type":"codeVoice","code":"f"},{"type":"text","text":" at G-vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". Over an undirected"},{"type":"text","text":" "},{"type":"text","text":"self-loop of G only "},{"type":"codeVoice","code":"s ≤ t"},{"type":"text","text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row"},{"type":"text","text":" "},{"type":"text","text":"lists such a loop’s edges at its first appearance, and only the product loop again at its"},{"type":"text","text":" "},{"type":"text","text":"second. Directed, the product has edge indices when both factors do:"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(e)·|V(H)|² + s·|V(H)| + t"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)|² + g·m_H + index(f)"},{"type":"text","text":". Undirected it has none."}],"type":"paragraph"}]}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicP