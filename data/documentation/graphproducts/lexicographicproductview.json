{"text":". Over an undirected","type":"text"},{"text":" ","type":"text"},{"text":"self-loop of G only ","type":"text"},{"type":"codeVoice","code":"s ≤ t"},{"text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row","type":"text"},{"text":" ","type":"text"},{"text":"lists such a loop’s edges at its first appearance, and only the product loop again at its","type":"text"},{"text":" ","type":"text"},{"text":"second. Directed, the product has edge indices when both factors do:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"index(e)·|V(H)|² + s·|V(H)| + t"},{"text":", then ","type":"text"},{"type":"codeVoice","code":"m_G·|V(H)|² + g·m_H + index(f)"},{"text":". Undirected it has none.","type":"text"}]}]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/LexicographicProductView.swift#L39","fileName":"LexicographicProductView.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LexicographicProductView","kind":"identifier"}],"externalID":"s:13GraphProducts24LexicographicProductViewV","modules":[{"name":"GraphProducts"}],"role":"symbol","roleHeading":"Structure","title":"LexicographicProductView","navigatorTitle":[{"text":"LexicographicProductView","kind":"identifier"}],"symbolKind":"struct"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/lexicographicproductview"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"abstract":[{"