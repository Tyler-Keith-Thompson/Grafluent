{"variants":[{"paths":["\/documentation\/graphproducts\/lexicographicproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LexicographicProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"code":"CartesianProductView","type":"codeVoice"},{"type":"text","text":". The row of (g, h) lists "},{"code":"(g′, h′)","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row and "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" h′ of H, in index order, then the H-moves "},{"code":"(g, h′)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An edge’s position is "},{"type":"codeVoice","code":".first(edge: e, uVertexIndex: s, vVertexIndex: t)"},{"type":"text","text":", G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"H-vertex index "},{"type":"codeVoice","code":"s"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"u"},{"type":"text","text":" end (directed: its source) and "},{"type":"codeVoice","code":"t"},{"type":"text","text":" at its "},{"type":"codeV