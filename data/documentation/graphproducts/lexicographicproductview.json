{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView"},"metadata":{"symbolKind":"struct","remoteSource":{"fileName":"LexicographicProductView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/LexicographicProductView.swift#L39"},"externalID":"s:13GraphProducts24LexicographicProductViewV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LexicographicProductView"}],"roleHeading":"Structure","title":"LexicographicProductView","navigatorTitle":[{"text":"LexicographicProductView","kind":"identifier"}],"modules":[{"name":"GraphProducts"}],"role":"symbol"},"variants":[{"paths":["\/documentation\/graphproducts\/lexicographicproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"text":"The lexicographic product G ∘ H of two graphs, both directed or both undirected, as a lazy","type":"text"},{"text":" ","type":"text"},{"text":"view. Made by ","type":"text"},{"code":"lexicographicProductView(_:_:)","type":"codeVoice"},{"text":". Also called the composition G[H].","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LexicographicProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProductView"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row and "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" h′ of H, in index order, then the H-moves "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An edge’s position is "},{"code":".first(edge: e, uVertexIndex: s, vVertexIndex: t)","type":"codeVoice"},{"type":"text","text":", G’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"H-vertex index "},{"code":"s","type":"codeVoice"},{"type":"text","text":" at its "},{"code":"u","type":"codeVoice"},{"type":"text","text":" end (directed: its source) and "},{"code":"t","type":"codeVoice"},{"type":"text","text":" at its "},{"code":"v","type":"codeVoice"},{"type":"text","text":" end (its target), or"},{"type":"text","text":" "},{"code":".second(vertexIndex: g, edge: f)","type":"codeVoice"},{"type":"text","text":", H’s edge "},{"code":"f","type":"codeVoice"},{"type":"text","text":" at G-vertex index "},{"code":"g","type":"codeVoice"},{"type":"text","text":". Over an undirected"},{"type":"text","text":" "},{"type":"text","text":"self-loop of G only "},{"code":"s ≤ t","type":"codeVoice"},{"type":"text","text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row"},{"type":"text","text":" "},{"type":"text","text":"lists such a loop’s edges at its first appearance, and only the product loop again at its"},{"type":"text","text":" "},{"type":"text","text":"second. Directed, the product has edge indices when both factors do:"},{"type":"text","text":" "},{"code":"index(e)·|V(H)|² + s·|V(H)| + t","type":"codeVoice"},{"type":"text","text":", then "},{"code":"m_G·|V(H)|² + g·m_H + index(f)","type":"codeVoice"},{"type":"text","text":". Undirected it has none."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedIndexRow"],"title":"Structures","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/second"],"title":"Instance Properties","generated":true},{"anchor":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/Position"],"title":"Enumerations","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documen