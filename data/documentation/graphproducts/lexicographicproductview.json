{"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/UndirectedIndexRow"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/second"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/Position"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/LexicographicProductView\/Graph-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LexicographicProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProductView"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row and "},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"type":"text","text":" h′ of H, in index order, then the H-moves "},{"type":"codeVoice","code":"(g, h′)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An edge’s position is "},{"type":"codeVoice","code":".first(edge: e, uVertexIndex: s, vVertexIndex: t)"},{"type":"text","text":", G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"H-vertex index "},{"type":"codeVoice","code":"s"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"u"},{"type":"text","text":" end (directed: its source) and "},{"type":"codeVoice","code":"t"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"v"},{"type":"text","text":" end (its target), or"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: f)"},{"type":"text","text":", H’s edge "},{"type":"codeVoice","code":"f"},{"type":"text","text":" at G-vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". Over an undirected"},{"type":"text","text":" "},{"type":"text","text":"self-loop of G only "},{"type":"codeVoice","code":"s ≤ t"},{"type":"text","text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row"},{"type":"text","text":" "},{"type":"text","text":"lists such a loop’s edges at its first appearance, and only the product loop again at its"},{"type":"text","text":" "},{"type":"text","text":"second. Directed, the product has edge indices when both factors do:"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(e)·|V(H)|² + s·|V(H)| + t"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)|² + g·m_H + index(f)"},{"type":"text","text":". Undirected it has none."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/lexicographicproductview"]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/LexicographicProductView.swift#L39","fileName":"LexicographicProductView.swift"},"title":"LexicographicProductView","role":"symbol","modules":[{"name":"GraphProducts"}],"navigatorTitle":[{"kind":"identifier","text":"LexicographicProductView"}],"symbolKind":"struct","externalID":"s:13GraphProducts24LexicographicProductViewV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LexicographicProductView","kind":"identifier"}],"roleHeading":"Structure"},"abstract":[{"type":"text","text":"The lexicographic product G ∘ H of two graphs, both directed or both undirected, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view. Made by "},{"type":"codeVoice","code":"lexicographicProductView(_:_:)"},{"type":"text","text":". Also called the composition G[H]."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"identifier":{"ur