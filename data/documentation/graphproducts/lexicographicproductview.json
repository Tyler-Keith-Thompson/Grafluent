"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"each entry g′ of G’s row and ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"text":" h′ of H, in index order, then the H-moves ","type":"text"},{"code":"(g, h′)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An edge’s position is "},{"type":"codeVoice","code":".first(edge: e, uVertexIndex: s, vVertexIndex: t)"},{"type":"text","text":", G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"H-vertex index "},{"type":"codeVoice","code":"s"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"u"},{"type":"text","text":" end (directed: its source) and "},{"type":"codeVoice","code":"t"},{"type":"text","text":" at its "},{"type":"codeVoice","code":"v"},{"type":"text","text":" end (its target), or"},{"type":"text","text":" "},{"type":"codeVoice","code":".second(vertexIndex: g, edge: f)"},{"type":"text","text":", H’s edge "},{"type":"codeVoice","code":"f"},{"type":"text","text":" at G-vertex index "},{"type":"codeVoice","code":"g"},{"type":"text","text":". Over an undirected"},{"type":"text","text":" "},{"type":"text","text":"self-loop of G only "},{"type":"codeVoice","code":"s ≤ t"},{"type":"text","text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row"},{"type":"text","text":" "},{"type":"text","text":"lists such a loop’s edges at its first appearance, and only the product loop again at its"},{"type":"text","text":" "},{"type":"text","text":"second. Directed, the product has edge indices when both factors do:"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(e)·|V(H)|² + s·|V(H)| + t"},{"type":"text","text":", then "},{"type":"codeVoice","code":"m_G·|V(H)|² + g·m_H + index(f)"},{"type":"text","text":". Undirected it has none."}]}]}],"variants":[{"paths":["\/documentation\/graphproducts\/lexicogr