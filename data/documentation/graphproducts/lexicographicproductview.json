text"},{"code":"s","type":"codeVoice"},{"text":" at its ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" end (directed: its source) and ","type":"text"},{"code":"t","type":"codeVoice"},{"text":" at its ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" end (its target), or","type":"text"},{"text":" ","type":"text"},{"code":".second(vertexIndex: g, edge: f)","type":"codeVoice"},{"text":", H’s edge ","type":"text"},{"code":"f","type":"codeVoice"},{"text":" at G-vertex index ","type":"text"},{"code":"g","type":"codeVoice"},{"text":". Over an undirected","type":"text"},{"text":" ","type":"text"},{"text":"self-loop of G only ","type":"text"},{"code":"s ≤ t","type":"codeVoice"},{"text":" occurs, since (a, s)–(a, t) and (a, t)–(a, s) are one edge; a row","type":"text"},{"text":" ","type":"text"},{"text":"lists such a loop’s edges at its first appearance, and only the product loop again at its","type":"text"},{"text":" ","type":"text"},{"text":"second. Directed, the product has edge indices when both factors do:","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·|V(H)|² + s·|V(H)| + t","type":"codeVoice"},{"text":", then ","type":"text"},{"code":"m_G·|V(H)|² + g·m_H + index(f)","type":"codeVoice"},{"text":". Undirected it has none.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/graphproducts\/lexicographicproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"metadata":{"externalID":"s:13GraphProducts24LexicographicProductViewV","modules":[{"name":"GraphProducts"}],"role":"symbol","title":"LexicographicProductView","navigatorTitle":[{"kind":"identifier","text":"LexicographicProductView"}],"remoteSource":{"fileName":"LexicographicProductView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/LexicographicProductView.swift#L39"},"roleHeading":"Structure","symbolKind":"struct","fragme