{"abstract":[{"text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"tensorProductView(_:_:)","type":"codeVoice"},{"text":". Also called the direct, categorical or Kronecker product.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/tensorproductview"]}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"GraphProducts"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProductView","kind":"identifier"}],"role":"symbol","symbolKind":"struct","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProductView.swift#L42","fileName":"TensorProductView.swift"},"navigatorTitle":[{"text":"TensorProductView","kind":"identifier"}],"title":"TensorProductView","externalID":"s:13GraphProducts17TensorProductViewV"},"topicSections":[{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/Position","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedIndexRow"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/second"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/Graph-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProductView"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from"},{"type":"text","text":" "},{"type":"text","text":"the factors’ index rows and never hash."}],"type":"paragraph"},{"inlineContent":[{"text":"An edge’s position is ","type":"text"},{"type":"codeVoice","code":"Position(first: e, second: f, reversed:)"},{"text":": G’s edge ","type":"text"},{"type":"codeVoice","code":"e"},{"text":" and H’s edge","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"f"},{"text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight","type":"text"},{"text":" ","type":"text"},{"text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ ","type":"text"},{"type":"codeVoice","code":"u"},{"text":" ends; when","type":"text"},{"text":" ","type":"text"},{"text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor","type":"text"},{"text":" ","type":"text"},{"text":"self-loop from its first appearance only, so every product edge has each of its ends once in","type":"text"},{"text":" ","type":"text"},{"text":"the rows. Directed, ","type":"text"},{"type":"codeVoice","code":"reversed"},{"text":" is always false, and the product has edge indices","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"index(e)·m_H + index(f)"},{"text":" when both factors have them; undirected it has none, because a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop changes how many edges a factor pair gives.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GraphProducts/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/GraphProducts\/s8SendableP","type":"unresolvable"},"doc://GraphProducts/documentation/GraphProducts/TensorProductView/EdgeRow":{"title":"TensorProductView.EdgeRow","abstract":[{"text":"A directed row of positions: ","type":"text"},{"code":"(e, f)","type":"codeVo