{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"code":"CartesianProductView","type":"codeVoice"},{"type":"text","text":". The row of (g, h) lists "},{"code":"(g′, h′)","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from"},{"type":"text","text":" "},{"type":"text","text":"the factors’ index rows and never hash."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An edge’s position is "},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"type":"text","text":": G’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" and H’s edge"},{"type":"text","text":" "},{"code":"f","type":"codeVoice"},{"type":"text","text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight"},{"type":"text","text":" "},{"type":"text","text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ "},{"code":"u","type":"codeVoice"},{"type":"text","text":" ends; when"},{"type":"text","text":" "},{"type":"text","text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor"},{"type":"text","text":" "},{"type":"text","text":"self-loop from its first appearance only, so every product edge has each of its ends once in"},{"type":"text","text":" "},{"type":"text","text":"the rows. Directed, "},{"code":"reversed","type":"codeVoice"},{"type":"text","text":" is always false, and the product has edge indices"},{"type":"text","text":" "},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"type":"text","text":" when both factors have them; undirected it has none, because a"},{"type":"text","text":" "},{"type":"text","text":"self-loop changes how many edges a factor pair gives."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/tensorproductview"]}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProductView.swift#L41","fileName":"TensorProductView.swift"},"symbolKind":"struct","modules":[{"name":"GraphProducts"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TensorProductView"}],"roleHeading":"Structure","externalID":"s:13GraphProducts17TensorProductViewV","title":"TensorProductView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProductView","kind":"identifier"}]},"topicSections":[{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/IndexRow","do