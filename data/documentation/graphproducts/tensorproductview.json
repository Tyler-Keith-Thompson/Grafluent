{"identifier":{"url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Vertices and their indices are as in ","type":"text"},{"code":"CartesianProductView","type":"codeVoice"},{"text":". The row of (g, h) lists ","type":"text"},{"code":"(g′, h′)","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from","type":"text"},{"text":" ","type":"text"},{"text":"the factors’ index rows and never hash.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"text":": G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" and H’s edge","type":"text"},{"text":" ","type":"text"},{"code":"f","type":"codeVoice"},{"text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight","type":"text"},{"text":" ","type":"text"},{"text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" ends; when","type":"text"},{"text":" ","type":"text"},{"text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor","type":"text"},{"text":" ","type":"text"},{"text":"self-loop from its first appearance only, so every product edge has each of its ends once in","type":"text"},{"text":" ","type":"text"},{"text":"the rows. Directed, ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" is always false, and the product has edge indices","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"text":" when both factors have them; undirected it has none, because a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop changes how many edges a factor pair gives.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphproducts\/tensorproductview"]}],"sections":[],"abstract":[{"text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"type":"codeVoice","code":"tensorProductView(_:_:)"},{"text":". Also called the direct, categorical or Kronecker product.","type":"text"}],"metadata":{"modules":[{"name":"GraphProducts"}],"symbolKind":"struct","roleHeading":"Structure","externalID":"s:13GraphProducts17TensorProductViewV","role":"symbol","title":"TensorProductView","remoteSource":{"fileName":"TensorProductView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProductView.swift#L42"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProductView","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"TensorProductView"}]},"topicSections":[{"anchor":"Structures","generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphPro