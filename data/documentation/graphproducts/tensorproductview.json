nsorProductView","role":"symbol","navigatorTitle":[{"text":"TensorProductView","kind":"identifier"}],"abstract":[{"text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"tensorProductView(_:_:)","type":"codeVoice"},{"text":". Also called the direct, categorical or Kronecker product.","type":"text"}],"url":"\/documentation\/graphproducts\/tensorproductview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"TensorProductView","kind":"identifier"}]},"doc://GraphProducts/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/GraphProducts\/s9EscapableP","title":"Swift.Escapable"}}}