-edge that generate it,","type":"text"},{"text":" ","type":"text"},{"text":"and, undirected, whether it is the reversed one of the pair. Ordered by ","type":"text"},{"code":"first","type":"codeVoice"},{"text":", then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"second"},{"text":", the straight edge before the reversed one, as ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists them.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Position","kind":"identifier"}],"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/Position","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","type":"topic","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"title":"DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"g