codeVoice"},{"type":"text","text":". Also called the direct, categorical or Kronecker product."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"First"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Second"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"Vertices and their indices are as in ","type":"text"},{"code":"CartesianProductView","type":"codeVoice"},{"text":". The row of (g, h) lists ","type":"text"},{"code":"(g′, h′)","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from","type":"text"},{"text":" ","type":"text"},{"text":"the factors’ index rows and never hash.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An edge’s position is "},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"type":"text","text":": G’s edge "},{"code":"e","type":"codeVoice"},{"type":"text","text":" and H’s edge"},{"type":"text","text":" "},{"code":"f","type":"codeVoice"},{"type":"text","text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight"},{"type":"text","text":" "},{"type":"text","text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ "},{"code":"u","type":"codeVoice"},{"type":"text","text":" ends; when"},{"type":"text","text":" "},{"type":"text","text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor"},{"type":"text","text":" "},{"type":"text","text":"self-loop from its first appearance only, so every product edge has each of its ends once in"},{"type":"text","text":" "},{"type":"text","text":"the rows. Directed, "},{"code":"reversed","type":"codeVoice"},{"type":"text","text":" is always false, and the product has edge indices"},{"type":"text","text":" "},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"type":"text","text":" when both factors have them; undirected it has none, because a"},{"type":"text","text":" "},{"type":"text","text":"self-loop changes how many edges a factor pair gives."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"role":"symbol","title":"TensorProductView","navigatorTitle":[{"text":"TensorProductView","kind":"identifier"}],"modules":[{"name":"GraphProducts"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProductView","kind":"identifier"}],"remoteSource":{"fileName":"TensorProductView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProductView.swift#L41"},"symbolKind":"struct","roleHeading":"Structure","externalID":"s:13GraphProducts17TensorProductViewV"},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"references":{"doc://GraphProducts/documentation/GraphProducts/TensorProductView/IndexRow":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IndexRow"}],"url":"\/documentation\/graphproducts\/tensorproductview\/indexrow","title":"TensorProductView.IndexRow","navigatorTitle":[{"kind":"id