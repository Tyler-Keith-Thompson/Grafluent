graph","inlineContent":[{"text":"Vertices and their indices are as in ","type":"text"},{"code":"CartesianProductView","type":"codeVoice"},{"text":". The row of (g, h) lists ","type":"text"},{"code":"(g′, h′)","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from","type":"text"},{"text":" ","type":"text"},{"text":"the factors’ index rows and never hash.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Position(first: e, second: f, reversed:)","type":"codeVoice"},{"text":": G’s edge ","type":"text"},{"code":"e","type":"codeVoice"},{"text":" and H’s edge","type":"text"},{"text":" ","type":"text"},{"code":"f","type":"codeVoice"},{"text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight","type":"text"},{"text":" ","type":"text"},{"text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" ends; when","type":"text"},{"text":" ","type":"text"},{"text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor","type":"text"},{"text":" ","type":"text"},{"text":"self-loop from its first appearance only, so every product edge has each of its ends once in","type":"text"},{"text":" ","type":"text"},{"text":"the rows. Directed, ","type":"text"},{"code":"reversed","type":"codeVoice"},{"text":" is always false, and the product has edge indices","type":"text"},{"text":" ","type":"text"},{"code":"index(e)·m_H + index(f)","type":"codeVoice"},{"text":" when both factors have them; undirected it has none, because a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop changes how many edges a factor pair gives.","type":"text"}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/Position","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedIndexRow"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/second"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/Graph-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"sections":[],"abstract":[{"text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"tensorProductView(_:_:)","type":"codeVoice"},{"text":". Also called the direct, categorical or Kronecker product.","type":"text"}],"references":{"doc://GraphProducts/documentation/GraphProducts/TensorProductView/first":{"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/first","url":"\/documentation\/graphproducts\/tensorproductview\/first","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","t