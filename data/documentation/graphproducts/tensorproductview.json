{"abstract":[{"text":"The tensor product G × H of two graphs, both directed or both undirected, as a lazy view. Made","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"tensorProductView(_:_:)","type":"codeVoice"},{"text":". Also called the direct, categorical or Kronecker product.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView"},"metadata":{"externalID":"s:13GraphProducts17TensorProductViewV","modules":[{"name":"GraphProducts"}],"symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TensorProductView"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProducts\/TensorProductView.swift#L41","fileName":"TensorProductView.swift"},"navigatorTitle":[{"text":"TensorProductView","kind":"identifier"}],"roleHeading":"Structure","title":"TensorProductView"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProducts\/s8CopyableP","doc:\/\/GraphProducts\/s9EscapableP","doc:\/\/GraphProducts\/s8SendableP","doc:\/\/GraphProducts\/s16SendableMetatypeP"],"type":"conformsTo"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphProducts\/documentation\/GraphProducts"]]},"sections":[],"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/EdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/IndexRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/Position","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedEdgeRow","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedEdges","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/UndirectedIndexRow"],"anchor":"Structures"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/first","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/second"],"anchor":"Instance-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/DirectedGraph-Implementations","doc:\/\/GraphProducts\/documentation\/GraphProducts\/TensorProductView\/Graph-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TensorProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"First","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Second","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices and their indices are as in "},{"type":"codeVoice","code":"CartesianProductView"},{"type":"text","text":". The row of (g, h) lists "},{"type":"codeVoice","code":"(g′, h′)"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"each entry g′ of G’s row of g and each entry h′ of H’s row of h, G outer. Rows are computed from"},{"type":"text","text":" "},{"type":"text","text":"the factors’ index rows and never hash."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An edge’s position is "},{"type":"codeVoice","code":"Position(first: e, second: f, reversed:)"},{"type":"text","text":": G’s edge "},{"type":"codeVoice","code":"e"},{"type":"text","text":" and H’s edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"f"},{"type":"text","text":". In an undirected product two non-loop edges {a, b} and {c, d} give two edges, the straight"},{"type":"text","text":" "},{"type":"text","text":"{(a, c), (b, d)} and the reversed {(a, d), (b, c)}, where a, c are the edges’ "},{"type":"codeVoice","code":"u"},{"type":"text","text":" ends; when"},{"type":"text","text":" "},{"type":"text","text":"either is a self-loop they coincide and there is one, not reversed. A row lists a factor"},{"type":"text","text":" "},{"type":"text","text":"self-loop from its first appearance only, so every product edge has each of its ends once in"},{"type":"text","text":" "},{"type":"text","text":"the rows. Directed, "},{"type":"codeVoice","code":"reversed"},{"type":"text","text":" is always false, and the product has edge indices"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(e)·m_H + index(f)"},{"type":"text","text":" when both factors have them; undirected it has none, because a"},{"type":"text","text":" "},{"type":"text","text":"self-loop changes how many edges a factor pair gives."}]}]}],"variants":[{"paths":["\/documentation\/graphproducts\/tensorproductview"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProducts/documentation/GraphProducts/TensorProductView/DirectedEdges":{"type":"topic","kind":"symbol","url":"\/documentation\/graphproducts\/tensorproductview\/directededges","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"c