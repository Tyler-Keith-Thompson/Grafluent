e":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"KComponents","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations":{"role":"collection","title":"GraphOperations","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/graphoperations"}}}