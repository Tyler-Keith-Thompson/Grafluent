n/GraphOperations/ComplementView/spanningSubgraphView(edges:)-6hwj3":{"title":"spanningSubgraphView(edges:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/spanningSubgraphView(edges:)-6hwj3","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"code":"edges","type":"codeVoice"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view. A position listed twice is kept once. The view has dense edge"},{"type":"text","text":" "},{"type":"text","text":"indices, each edge’s rank among the kept edges in the graph’s order."}],"url":"\/documentation\/graphoperations\/complementview\/spanningsubgraphview(edges:)-6hwj3"},"doc://GraphOperations/documentation/GraphOperations":{"url":"\/documentation\/graphoperations","role":"collection","type":"topic","title":"GraphOperations","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","abstract":[]},"doc://GraphOperations/documentation/GraphOperations/ComplementView/subgraphView(vertices:edges:)-4qyfz":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"subgraphView"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertices"},{"kind":"text","text":": "},{"kind":"keyword",