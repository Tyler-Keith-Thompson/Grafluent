{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView"]]},"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/DirectedGraph-Implementations","interfaceLanguage":"swift"},"metadata":{"title":"DirectedGraph Implementations","role":"collectionGroup","modules":[{"name":"GraphOperations"}],"roleHeading":"API Collection"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/complementview\/directedgraph-implementations"]}],"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complement-3nql3"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/inducedSubgraph(on:)-3hlp","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/spanningSubgraph(edges:)-4t3f5","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraph(vertices:edges:)-9uj9y"],"generated":true}],"references":{"doc://GraphOperations/documentation/GraphOperations/ComplementView/complement-3nql3":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ComplementView","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct","type":"text"},{"text":" ","type":"text"},{"text":"vertices that the graph does not join (NetworkX’s ","type":"text"},{"code":"complement","type":"codeVoice"},{"text":", igraph’s ","type":"text"},{"code":"complementer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"loops=False","type":"codeVoice"},{"text":"). Self-loops and parallel edges of the graph are ignored, so the","type":"text"},{"text":" ","type":"text"},{"text":"complement is simple and loop-free, and the complement of the complement is the graph","type":"text"},{"text":" ","type":"text"},{"text":"made simple and loop-free. O(1); a lazy view.","type":"text"}],"url":"\/documentation\/graphoperations\/complementview\/complement-3nql3","kind":"symbol","title":"complement","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complement-3nql3","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/inducedSubgraph(on:)-3hlp":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"The subgraph induced by ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":": those vertices and every edge between them, as a lazy","type":"text"},{"text":" ","type":"text"},{"text":"view (igraph’s ","type":"text"},{"code":"induced_subgraph","type":"codeVoice"},{"text":", NetworkX’s ","type":"text"},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"text":"). The kept vertices are","type":"text"},{"text":" ","type":"text"},{"text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept","type":"text"},{"text":" ","type":"text"},{"text":"once. The view keeps the graph’s edge positions and has no edge indices.","type":"text"}],"url":"\/documentation\/graphoperations\/complementview\/inducedsubgraph(on:)-3hlp","kind":"symbol","title":"inducedSubgraph(on:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/inducedSubgraph(on:)-3hlp","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ComplementView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView","type":"topic","url":"\/documentation\/graphoperations\/complementview","role":"symbol","navigatorTitle":[{"text":"ComplementView","kind":"identifier"}],"title":"ComplementView","abstract":[{"text":"The complement of a graph, as a lazy view. Made by ","type":"text"},{"code":"complement","type":"codeVoice"},{"text":".","type":"text"}]},"doc://GraphOperations/documentation/GraphOperations/ComplementView/spanningSubgraph(edges:)-4t3f5":{"abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}],"title":"spanningSubgraph(edges:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/spanningSubgraph(edges:)-4t3f5","url":"\/documentation\/graphoperations\/complementview\/spanningsubgraph(edges:)-4t3f5"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/subgraph(vertices:edges:)-9uj9y":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"subgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertices"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"type":"text","text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Mathematica’s "},{"type":"codeVoice","code":"Subgraph"},{"type":"text","text":"): an edge is kept when it is listed and both its ends are kept, so"},{"type":"text","text":" "},{"type":"text","text":"a listed edge with an end outside "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is dropped. Vertices are numbered as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"inducedSubgraph(on:)"},{"type":"text","text":", and edge indices as for "},{"type":"codeVoice","code":"spanningSubgraph(edges:)"},{"type":"text","text":"."}],"url":"\/documentation\/graphoperations\/complementview\/subgraph(vertices:edges:)-9uj9y","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraph(vertices:edges:)-9uj9y","title":"subgraph(vertices:edges:)","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations":{"kind":"symbol","abstract":[],"title":"GraphOperations","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","type":"topic","role":"collection","url":"\/documentation\/graphoperations"}}}