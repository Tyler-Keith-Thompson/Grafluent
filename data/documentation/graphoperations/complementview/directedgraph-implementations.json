rkX’s ","type":"text"},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"text":"). The kept vertices are","type":"text"},{"text":" ","type":"text"},{"text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept","type":"text"},{"text":" ","type":"text"},{"text":"once. The view keeps the graph’s edge positions and has no edge indices.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inducedSubgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"inducedSubgraphView(on:)","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/subgraphView(vertices:edges:)-4qyfz":{"type":"topic","title":"subgraphView(vertices:edges:)","url":"\/documentation\/graphoperations\/complementview\/subgraphview(vertices:edges:)-4qyfz","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">, ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraphView(vertices:edges:)-4qyfz","abstract":[{"text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"AsSubgraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Mathematica’s ","type":"text"},{"type":"codeVoice","code":"Subgraph"},{"text":"): an edge is kept when it is listed and both its ends are kept, so","type":"text"},{"text":" ","type":"text"},{"text":"a listed edge with an end outside ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is dropped. Vertices are numbered as for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"inducedSubgraphView(on:)"},{"text":", and edge indices as for ","type":"text"},{"type":"codeVoice","code":"spanningSubgraphView(edges:)"},{"text":".","type":"text"}],"kind":"symbol"}}}