{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/DirectedGraph-Implementations"},"kind":"article","topicSections":[{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complementView-8wnds"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/inducedSubgraphView(on:)-7fiy3","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/spanningSubgraphView(edges:)-6hwj3","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraphView(vertices:edges:)-4qyfz"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/complementview\/directedgraph-implementations"]}],"metadata":{"modules":[{"name":"GraphOperations"}],"role":"collectionGroup","roleHeading":"API Collection","title":"DirectedGraph Implementations"},"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView"]]},"references":{"doc://GraphOperations/documentation/GraphOperations/ComplementView":{"abstract":[{"text":"The complement of a graph, as a lazy view. Made by ","type":"text"},{"code":"complementView","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"ComplementView","kind":"symbol","navigatorTitle":[{"text":"ComplementView","kind":"identifier"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView","url":"\/documentation\/graphoperations\/complementview","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ComplementView","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","kind":"symbol","url":"\/documentation\/graphoperations","type":"topic","title":"GraphOperations","role":"collection"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/spanningSubgraphView(edges:)-6hwj3":{"role":"symbol","type":"topic","url":"\/documentation\/graphoperations\/complementview\/spanningsubgraphview(edges:)-6hwj3","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spanningSubgraphView"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/spanningSubgraphView(edges:)-6hwj3","title":"spanningSubgraphView(edges:)","abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}],"kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/inducedSubgraphView(on:)-7fiy3":{"title":"inducedSubgraphView(on:)","abstract":[{"type":"text","text":"The subgraph induced by "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view (igraph’s "},{"type":"codeVoice","code":"induced_subgraph"},{"type":"text","text":", NetworkX’s "},{"type":"codeVoice","code":"G.subgraph(nodes)"},{"type":"text","text":"). The kept vertices are"},{"type":"text","text":" "},{"type":"text","text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}],"kind":"symbol","url":"\/documentation\/graphoperations\/complementview\/inducedsubgraphview(on:)-7fiy3","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/inducedSubgraphView(on:)-7fiy3","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraphView"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/complementView-8wnds":{"role":"symbol","type":"topic","url":"\/documentation\/graphoperations\/complementview\/complementview-8wnds","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"complementView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ComplementView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complementView-8wnds","title":"complementView","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"type":"codeVoice","code":"complement"},{"type":"text","text":", igraph’s "},{"type":"codeVoice","code":"complementer"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"loops=False"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/subgraphView(vertices:edges:)-4qyfz":{"title":"subgraphView(vertices:edges:)","role":"symbol","abstract":[{"type":"text","text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Mathematica’s "},{"type":"codeVoice","code":"Subgraph"},{"type":"text","text":"): an edge is kept when it is listed and both its ends are kept, so"},{"type":"text","text":" "},{"type":"text","text":"a listed edge with an end outside "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is dropped. Vertices are numbered as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"inducedSubgraphView(on:)"},{"type":"text","text":", and edge indices as for "},{"type":"codeVoice","code":"spanningSubgraphView(edges:)"},{"type":"text","text":"."}],"url":"\/documentation\/graphoperations\/complementview\/subgraphview(vertices:edges:)-4qyfz","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraphView(vertices:edges:)-4qyfz","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}}}