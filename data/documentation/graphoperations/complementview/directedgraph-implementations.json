:"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept","type":"text"},{"text":" ","type":"text"},{"text":"once. The view keeps the graph’s edge positions and has no edge indices.","type":"text"}],"url":"\/documentation\/graphoperations\/complementview\/inducedsubgraphview(on:)-7fiy3"},"doc://GraphOperations/documentation/GraphOperations/ComplementView":{"abstract":[{"type":"text","text":"The complement of a graph, as a lazy view. Made by "},{"type":"codeVoice","code":"complementView"},{"type":"text","text":"."}],"type":"topic","title":"ComplementView","url":"\/documentation\/graphoperations\/complementview","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ComplementView"}],"navigatorTitle":[{"kind":"identifier","text":"ComplementView"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/subgraphView(vertices:edges:)-4qyfz":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraphView(vertices:edges:)-4qyfz","abstract":[{"type":"text","text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s "},{"code":"AsSubgraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Mathematica’s "},{"code":"Subgraph","type":"codeVoice"},{"type":"text","text":"): an edge is kept when it is listed and both its ends are kept, so"},{"type":"text","text":" "},{"type":"text","text":"a listed edge with an end outside "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is dropped. Vertices are numbered as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"inducedSubgraphView(on:)"},{"type":"text","text":", and edge indices as for "},{"type":"codeVoice","code":"spanningSubgraphView(edges:)"},{"type":"text","text":"."}],"fragments":[{"kind