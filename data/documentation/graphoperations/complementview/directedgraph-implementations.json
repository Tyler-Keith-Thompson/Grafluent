{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/DirectedGraph-Implementations"},"kind":"article","variants":[{"paths":["\/documentation\/graphoperations\/complementview\/directedgraph-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complementView-8wnds"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/inducedSubgraphView(on:)-7fiy3","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/spanningSubgraphView(edges:)-6hwj3","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraphView(vertices:edges:)-4qyfz"],"title":"Instance Methods"}],"metadata":{"modules":[{"name":"GraphOperations"}],"roleHeading":"API Collection","role":"collectionGroup","title":"DirectedGraph Implementations"},"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://GraphOperations/documentation/GraphOperations/ComplementView":{"abstract":[{"type":"text","text":"The complement of a graph, as a lazy view. Made by "},{"type":"codeVoice","code":"complementView"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ComplementView","kind":"identifier"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView","role":"symbol","type":"topic","title":"ComplementView","kind":"symbol","navigatorTitle":[{"text":"ComplementView","kind":"identifier"}],"url":"\/documentation\/graphoperations\/complementview"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/complementView-8wnds":{"type":"topic","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"code":"complement","type":"codeVoice"},{"type":"text","text":", igraph’s "},{"code":"complementer","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"loops=False","type":"codeVoice"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"url":"\/documentation\/graphoperations\/complementview\/complementview-8wnds","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complementView-8wnds","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complementView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ComplementView","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"complementView","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations":{"role":"collection","abstract":[],"type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","title":"GraphOperations","kind":"symbol","url":"\/documentation\/graphoperations"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/spanningSubgraphView(edges:)-6hwj3":{"type":"topic","title":"spanningSubgraphView(edges:)","url":"\/documentation\/graphoperations\/complementview\/spanningsubgraphview(edges:)-6hwj3","role":"symbol","fragments":[{"text":"func","ki