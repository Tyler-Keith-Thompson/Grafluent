phView(on:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inducedSubgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The subgraph induced by "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view. The kept vertices are numbered in the graph’s order, whatever the listed order. A"},{"type":"text","text":" "},{"type":"text","text":"vertex listed twice is kept once. The view keeps the graph’s edge positions and has no edge indices."}],"role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/complementView-8wnds":{"title":"complementView","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complementView-8wnds","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complementView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ComplementView","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","url":"\/documentation\/graphoperations\/complementview\/complementview-8wnds","type":"topic","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join. Self-loops and parallel edges of the graph are"},{"type":"text","text":" "},{"type":"text","text":"ignored. The complement is simple and loop-free, and the complement of the complement is"},{"type":"text","text":" "},{"type":"text","text":"the graph made simple and loop-free. O(1); a lazy view."}]}}}