":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","title":"inducedSubgraph(on:)","abstract":[{"text":"The subgraph induced by ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":": those vertices and every edge between them, as a lazy","type":"text"},{"text":" ","type":"text"},{"text":"view (igraph’s ","type":"text"},{"code":"induced_subgraph","type":"codeVoice"},{"text":", NetworkX’s ","type":"text"},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"text":"). The kept vertices are","type":"text"},{"text":" ","type":"text"},{"text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept","type":"text"},{"text":" ","type":"text"},{"text":"once. The view keeps the graph’s edge positions and has no edge indices.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/graphoperations\/complementview\/inducedsubgraph(on:)-3hlp","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/inducedSubgraph(on:)-3hlp"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/subgraph(vertices:edges:)-9uj9y":{"title":"subgraph(vertices:edges:)","url":"\/documentation\/graphoperations\/complementview\/subgraph(vertices:edges:)-9uj9y","type":"topic","abstract":[{"text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"AsSubgraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Mathematica’s ","type":"text"},{"type":"codeVoice","code":"Subgraph"},{"text":"): an edge is kept when it is listed and both its ends are kept, so","type":"text"},{"text":" ","type":"text"},{"text":"a listed edge with an end outside ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is dropped. Vertices are numbered as for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"inducedSubgraph(on:)"},{"text":", and edge indices as for ","type":"text"},{"type":"codeVoice","code":"spanningSubgraph(edges:)"},{"text":".","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/subgraph(vertices:edges:)-9uj9y","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ComplementView":{"navigatorTitle":[{"kind":"identifier","text":"ComplementView"}],"title":"ComplementView","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ComplementView"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView","kind":"symbol","url":"\/documentation\/graphoperations\/complementview","abstract":[{"text":"The complement of a graph, as a lazy view. Made by ","type":"text"},{"code":"complement","type":"codeVoice"},{"text":".","type":"text"}]},"doc://GraphOperations/documentation/GraphOperations/ComplementView/complement-3nql3":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV","text":"ComplementView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct","type":"text"},{"text":" ","type":"text"},{"text":"vertices that the graph does not join (NetworkX’s ","type":"text"},{"code":"complement","type":"codeVoice"},{"text":", igraph’s ","type":"text"},{"code":"complementer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"loops=False","type":"codeVoice"},{"text":"). Self-loops and parallel edges of the graph are ignored, so the","type":"text"},{"text":" ","type":"text"},{"text":"complement is simple and loop-free, and the complement of the complement is the graph","type":"text"},{"text":" ","type":"text"},{"text":"made simple and loop-free. O(1); a lazy view.","type":"text"}],"title":"complement","kind":"symbol","role":"symbol","url":"\/documentation\/graphoperations\/complementview\/complement-3nql3","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/complement-3nql3"},"doc://GraphOperations/documentation/GraphOperations/ComplementView/spanningSubgraph(edges:)-4t3f5":{"title":"spanningSubgraph(edges:)","url":"\/documentation\/graphoperations\/complementview\/spanningsubgraph(edges:)-4t3f5","type":"topic","abstract":[{"text":"The spanning subgraph with the edges at ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":": every vertex, at its own index, and only","type":"text"},{"text":" ","type":"text"},{"text":"those edges, as a lazy view (igraph’s ","type":"text"},{"code":"subgraph_edges(delete_vertices=False)","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"FilterArcs","type":"codeVoice"},{"text":"). A position listed twice is kept once. The view has dense edge indices, each","type":"text"},{"text":" ","type":"text"},{"text":"edge’s rank among the kept edges in the graph’s order.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/spanningSubgraph(edges:)-4t3f5","role":"symbol"}}}