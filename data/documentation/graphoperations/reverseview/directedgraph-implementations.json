t":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Mathematica’s "},{"type":"codeVoice","code":"Subgraph"},{"type":"text","text":"): an edge is kept when it is listed and both its ends are kept, so"},{"type":"text","text":" "},{"type":"text","text":"a listed edge with an end outside "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is dropped. Vertices are numbered as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"inducedSubgraph(on:)"},{"type":"text","text":", and edge indices as for "},{"type":"codeVoice","code":"spanningSubgraph(edges:)"},{"type":"text","text":"."}],"url":"\/documentation\/graphoperations\/reverseview\/subgraph(vertices:edges:)","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ReverseView/spanningSubgraph(edges:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/graphoperations\/reverseview\/spanningsubgraph(edges:)","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ReverseView\/spanningSubgraph(edges:)","title":"spanningSubgraph(edges:)","abstract":[{"text":"The spanning subgraph with the edges at ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":": every vertex, at its own index, and only","type":"text"},{"text":" ","type":"text"},{"text":"those edges, as a lazy view (igraph’s ","type":"text"},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FilterArcs"},{"text":"). A position listed twice is kept once. The view has dense edge indices, each","type":"text"},{"text":" ","type":"text"},{"text":"edge’s rank among the kept edges in the graph’s order.","type":"text"}],"role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ReverseView/complement":{"title":"complement","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"type":"codeVoice","code":"complement"},{"type":"text","text":", igraph’s "},{"type":"codeVoice","code":"complementer"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"loops=False"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"kind":"symbol","url":"\/documentation\/graphoperations\/reverseview\/complement","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"complement","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ComplementView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ReverseView\/complement"},"doc://GraphOperations/documentation/GraphOperations/ReverseView/inducedSubgraph(on:)":{"role":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ReverseView\/inducedSubgraph(on:)","title":"inducedSubgraph(on:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inducedSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">) -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The subgraph induced by "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view (igraph’s "},{"type":"codeVoice","code":"induced_subgraph"},{"type":"text","text":", NetworkX’s "},{"type":"codeVoice","code":"G.subgraph(nodes)"},{"type":"text","text":"). The kept vertices are"},{"type":"text","text":" "},{"type":"text","text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}],"url":"\/documentation\/graphoperations\/reverseview\/inducedsubgraph(on:)","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/ReverseView":{"abstract":[{"type":"text","text":"A bidirectional directed graph with every edge reversed: the converse (or transpose) of its"},{"type":"text","text":" "},{"type":"text","text":"base. Made by "},{"code":"reverseView","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ReverseView","navigatorTitle":[{"text":"ReverseView","kind":"identifier"}],"title":"ReverseView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ReverseView","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/graphoperations\/reverseview"}}}