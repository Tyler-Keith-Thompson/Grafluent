)","type":"codeVoice"},{"text":"). Its edges are not the base’s, so edge maps don’t read","type":"text"},{"text":" ","type":"text"},{"text":"through.","type":"text"}]}]}],"metadata":{"externalID":"s:15GraphOperations14ComplementViewV","roleHeading":"Structure","modules":[{"name":"GraphOperations"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ComplementView"}],"remoteSource":{"fileName":"ComplementView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/ComplementView.swift#L43"},"role":"symbol","symbolKind":"struct","title":"ComplementView","navigatorTitle":[{"kind":"identifier","text":"ComplementView"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView"},"abstract":[{"type":"text","text":"The complement of a graph, as a lazy view. Made by "},{"code":"complementView","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/Cell","doc:\/\/GraphOperations\/documentation\/GraphOperations\/ComplementView\/CellRow","doc:\/\/GraphOperations\/do