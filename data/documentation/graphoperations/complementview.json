,{"code":"i","type":"codeVoice"},{"text":" lists every index ","type":"text"},{"code":"j ≠ i","type":"codeVoice"},{"text":" that the","type":"text"},{"text":" ","type":"text"},{"text":"base’s row ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" lacks, in ascending order. Producing a row costs O(deg + n\/64 + output) and one","type":"text"},{"text":" ","type":"text"},{"text":"allocation. The complement of a sparse graph has Θ(n²) edges, so a full traversal is Θ(n²).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An edge’s position is its cell of the adjacency matrix, ","type":"text"},{"code":"Cell(source: i, target: j)","type":"codeVoice"},{"text":", ordered","type":"text"},{"text":" ","type":"text"},{"text":"row-major as ","type":"text"},{"code":"AdjacencyMatrix","type":"codeVoice"},{"text":"’s positions are. An undirected edge has ","type":"text"},{"code":"source < target","type":"codeVoice"},{"text":". There","type":"text"},{"text":" ","type":"text"},{"text":"are no edge indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As a ","type":"text"},{"type":"codeVoice","code":"GraphAdaptor"},{"text":", its generation is the base’s, and it reads the base’s attached vertex","type":"text"},{"text":" ","type":"text"},{"text":"maps (","type":"text"},{"type":"codeVoice","code":"[map, of:]"},{"text":", ","type":"text"},{"type":"codeVoice","code":"values(of:)"},{"text":"). Its edges are not the base’s, so edge maps don’t read","type":"text"},{"text":" ","type":"text"},{"text":"through.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"references":{"doc://GraphOperations/documentation/GraphOperations/ComplementView/DirectedEdges":{"url":"\/documentation\/graphoperations\/complementview\/directededges","navigatorTitle":[{"kind":"identifier","text":"DirectedEdges"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text