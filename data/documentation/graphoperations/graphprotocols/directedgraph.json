\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols"]]},"references":{"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"type":"topic","title":"GraphProtocols","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/graphoperations\/graphprotocols","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/spanningSubgraph(edges:)":{"kind":"symbol","abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/spanningSubgraph(edges:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spanningSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"spanningSubgraph(edges:)","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/spanningsubgraph(edges:)"},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"kind":"symbol","title":"GraphOperations","url":"\/documentation\/graphoperations","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","role":"collection"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/complement":{"title":"complement","kind":"symbol","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"code":"complement","type":"codeVoice"},{"type":"text","text":", igraph’s "},{"code":"complementer","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"loops=False","type":"codeVoice"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/complement","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV","text":"ComplementView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/complement"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/inducedSubgraph(on:)":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/inducedSubgraph(on:)","title":"inducedSubgraph(on:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","type":"topic","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/inducedsubgraph(on:)","abstract":[{"type":"text","text":"The subgraph induced by "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view (igraph’s "},{"type":"codeVoice","code":"induced_subgraph"},{"type":"text","text":", NetworkX’s "},{"type":"codeVoice","code":"G.subgraph(nodes)"},{"type":"text","text":"). The kept vertices are"},{"type":"text","text":" "},{"type":"text","text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}],"role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/subgraph(vertices:edges:)":{"title":"subgraph(vertices:edges:)","abstract":[{"type":"text","text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s "},{"code":"AsSubgraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Mathematica’s "},{"code":"Subgraph","type":"codeVoice"},{"type":"text","text":"): an edge is kept when it is listed and both its ends are kept, so"},{"type":"text","text":" "},{"type":"text","text":"a listed edge with an end outside "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" is dropped. Vertices are numbered as for"},{"type":"text","text":" "},{"code":"inducedSubgraph(on:)","type":"codeVoice"},{"type":"text","text":", and edge indices as for "},{"code":"spanningSubgraph(edges:)","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/subgraph(vertices:edges:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"subgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertices"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/subgraph(vertices:edges:)"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph":{"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","abstract":[],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol"}}}