text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}]},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"abstract":[],"kind":"symbol","role":"collection","title":"GraphProtocols","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","url":"\/documentation\/graphoperations\/graphprotocols"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/subgraph(vertices:edges:)":{"kind":"symbol","type":"topic","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/subgraph(vertices:edges:)","role":"symbol","abstract":[{"text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s ","type":"text"},{"code":"AsSubgraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Mathematica’s ","type":"text"},{"code":"Subgraph","type":"codeVoice"},{"text":"): an edge is kept when it is listed and both its ends are kept, so","type":"text"},{"text":" ","type":"text"},{"text":"a listed edge with an end outside ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is dropped. Vertices are numbered as for","type":"text"},{"text":" ","type":"text"},{"code":"inducedSubgraph(on:)","type":"codeVoice"},{"text":", and edge indices as for ","type":"text"},{"code":"spanningSubgraph(edges:)","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"subgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertices"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text"