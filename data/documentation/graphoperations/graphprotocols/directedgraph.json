Voice"},{"type":"text","text":"."}],"title":"subgraph(vertices:edges:)","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/subgraph(vertices:edges:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/subgraph(vertices:edges:)","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"title":"GraphProtocols","url":"\/documentation\/graphoperations\/graphprotocols","role":"collection","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","abstract":[],"kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/spanningSubgraph(edges:)":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/spanningSubgraph(edges:)","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/spanningsubgraph(edges:)","title":"spanningSubgraph(edges:)","role":"symbol","abstract":[{"text":"The spanning subgraph with the edges at ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":": every vertex, at its own index, and only","type":"text"},{"text":" ","type":"text"},{"text":"those edges, as a lazy view (igraph’s ","type":"text"},{"code":"subgraph_edges(delete_vertices=False)","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"FilterArcs","type":"codeVoice"},{"text":"). A position listed twice is kept once. The view has dense edge indices, each","type":"text"},{"text":" ","type":"text"},{"text":"edge’s rank among the kept edges in the graph’s order.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"title":"DirectedGraph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph","role":"symbol","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph","abstract":[],"kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/complement":{"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"complement","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations14ComplementViewV","text":"ComplementView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"type":"codeVoice","code":"complement"},{"type":"text","text":", igraph’s "},{"type":"codeVoice","code":"complementer"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"loops=False"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"title":"complement","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/complement","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/complement","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","url":"\/documentation\/graphoperations","title":"GraphOperations","role":"collection","abstract":[],"type":"topic","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/inducedSubgraph(on:)":{"kind":"symbol","type":"topic","title":"inducedSubgraph(on:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/inducedSubgraph(on:)","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/inducedsubgraph(on:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","abstract":[{"type":"text","text":"The subgraph induced by "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view (igraph’s "},{"type":"codeVoice","code":"induced_subgraph"},{"type":"text","text":", NetworkX’s "},{"type":"codeVoice","code":"G.subgraph(nodes)"},{"type":"text","text":"). The kept vertices are"},{"type":"text","text":" "},{"type":"text","text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}]}}}