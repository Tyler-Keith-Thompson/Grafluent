ith an end outside ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is dropped. Vertices are numbered as for","type":"text"},{"text":" ","type":"text"},{"code":"inducedSubgraphView(on:)","type":"codeVoice"},{"text":", and edge indices as for ","type":"text"},{"code":"spanningSubgraphView(edges:)","type":"codeVoice"},{"text":".","type":"text"}]},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"title":"GraphOperations","type":"topic","url":"\/documentation\/graphoperations","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","role":"collection"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph","abstract":[],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"title":"DirectedGraph"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","title":"GraphProtocols","role":"collection","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","url":"\/documentation\/graphoperations\/graphprotocols"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/inducedSubgraphView(on:)":{"title":"inducedSubgraphView(on:)","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/inducedSubgraphView(on:)","abstract":[{"text":"The subgraph induced by ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":": those vertices and every edge between them, as a lazy","type":"text"},{