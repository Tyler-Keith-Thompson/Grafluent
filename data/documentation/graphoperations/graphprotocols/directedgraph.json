,"type":"text"},{"text":" ","type":"text"},{"text":"listed and both its ends are kept. A listed edge with an end outside ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is dropped. Vertices are numbered as for","type":"text"},{"text":" ","type":"text"},{"code":"inducedSubgraphView(on:)","type":"codeVoice"},{"text":", and edge indices as for ","type":"text"},{"code":"spanningSubgraphView(edges:)","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/subgraphView(vertices:edges:)","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/subgraphview(vertices:edges:)","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","title":"DirectedGraph","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/spanningSubgraphView(edges:)":{"title":"spanningSubgraphView(edges:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spanningSubgraphView"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view. A position listed twice is kept once. The view has dense edge"},{"type":"text","text":" "},{"type":"text","text":"indices, each edge’s rank among the kept edges in the graph’s order."}],"role":"symbol","type":"topic","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/spanningsubgraphview(edges:)","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/spanningSubgraphView(edges:)"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/graphoperations\/graphprotocols","type":"topic","title":"GraphProtocols"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/inducedSubgraphView(on:)":{"url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/inducedsubgraphview(on:)","abstract":[{"text":"The subgraph induced by ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":": those vertices and every edge between them, as a lazy","type":"text"},{"text":" ","type":"text"},{"text":"view. The kept vertices are numbered in the graph’s order, whatever the listed order. A","type":"text"},{"text":" ","type":"text"},{"text":"vertex listed twice is kept once. The view keeps the graph’s edge positions and has no edge indices.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraphView"},{"kind":"text","text"