","kind":"identifier","text":"DirectedGraph"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"type":"topic","title":"DirectedGraph","kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/subgraph(vertices:edges:)":{"type":"topic","role":"symbol","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/subgraph(vertices:edges:)","title":"subgraph(vertices:edges:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">, ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"AsSubgraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Mathematica’s ","type":"text"},{"type":"codeVoice","code":"Subgraph"},{"text":"): an edge is kept when it is listed and both its ends are kept, so","type":"text"},{"text":" ","type":"text"},{"text":"a listed edge with an end outside ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is dropped. Vertices are numbered as for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"inducedSubgraph(on:)"},{"text":", and edge indices as for ","type":"text"},{"type":"codeVoice","code":"spanningSubgraph(edges:)"},{"text":".","type":"text"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/subgraph(vertices:edges:)"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"kind":"symbol","abstract":[],"title":"GraphProtocols","role":"collection","url":"\/documentation\/graphoperations\/graphprotocols","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/inducedSubgraph(on:)":{"type":"topic","role":"symbol","kind":"symbol","title":"inducedSubgraph(on:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inducedSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">) -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The subgraph induced by "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view (igraph’s "},{"code":"induced_subgraph","type":"codeVoice"},{"type":"text","text":", NetworkX’s "},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"type":"text","text":"). The kept vertices are"},{"type":"text","text":" "},{"type":"text","text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/inducedSubgraph(on:)","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/inducedsubgraph(on:)"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph","kind":"symbol","title":"DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"abstract":[],"type":"topic"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/complement":{"type":"topic","role":"symbol","kind":"symbol","title":"complement","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV","text":"ComplementView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"type":"codeVoice","code":"complement"},{"type":"text","text":", igraph’s "},{"type":"codeVoice","code":"complementer"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"loops=False"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/complement","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/complement"},"doc://GraphOperations/documentation/GraphOperations":{"role":"collection","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","url":"\/documentation\/graphoperations","title":"GraphOperations","abstract":[],"type":"topic","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/spanningSubgraph(edges:)":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/spanningSubgraph(edges:)","role":"symbol","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/spanningsubgraph(edges:)","title":"spanningSubgraph(edges:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}],"type":"topic"}}}