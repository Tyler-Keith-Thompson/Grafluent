umentation\/GraphOperations\/GraphProtocols"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph","abstract":[],"type":"topic","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","role":"symbol","title":"DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}]},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/graphoperations\/graphprotocols","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","title":"GraphProtocols","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/inducedSubgraph(on:)":{"title":"inducedSubgraph(on:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The subgraph induced by "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view (igraph’s "},{"code":"induced_subgraph","type":"codeVoice"},{"type":"text","text":", NetworkX’s "},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"type":"text","text":"). The kept vertices are"},{"type":"text","text":" "},{"type":"text","text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}],"kind":"symbol","role":"symbol","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/inducedsubgraph(on:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/inducedSubgraph(on:)"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/complement":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/complement","abstract":[{"text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct","type":"text"},{"text":" ","type":"text"},{"text":"vertices that the graph does not join (NetworkX’s ","type":"text"},{"code":"complement","type":"codeVoice"},{"text":", igraph’s ","type":"text"},{"code":"complementer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"loops=False","type":"codeVoice"},{"text":"). Self-loops and parallel edges of the graph are ignored, so the","type":"text"},{"text":" ","type":"text"},{"text":"complement is simple and loop-free, and the complement of the complement is the graph","type":"text"},{"text":" ","type":"text"},{"text":"made simple and loop-free. O(1); a lazy view.","type":"text"}],"url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/complement","type":"topic","kind":"symbol","role":"symbol","title":"complement","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ComplementView","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/subgraph(vertices:edges:)":{"title":"subgraph(vertices:edges:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Mathematica’s "},{"type":"codeVoice","code":"Subgraph"},{"type":"text","text":"): an edge is kept when it is listed and both its ends are kept, so"},{"type":"text","text":" "},{"type":"text","text":"a listed edge with an end outside "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is dropped. Vertices are numbered as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"inducedSubgraph(on:)"},{"type":"text","text":", and edge indices as for "},{"type":"codeVoice","code":"spanningSubgraph(edges:)"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/subgraph(vertices:edges:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/subgraph(vertices:edges:)"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/DirectedGraph/spanningSubgraph(edges:)":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/DirectedGraph\/spanningSubgraph(edges:)","abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}],"type":"topic","url":"\/documentation\/graphoperations\/graphprotocols\/directedgraph\/spanningsubgraph(edges:)","kind":"symbol","role":"symbol","title":"spanningSubgraph(edges:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spanningSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"type":"topic","role":"collection","url":"\/documentation\/graphoperations","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","title":"GraphOperations","kind":"symbol"}}}