{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","abstract":[{"type":"text","text":"A copy of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":" with every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" renamed "},{"type":"codeVoice","code":"transform(v)"},{"type":"text","text":", as NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"relabel_nodes"},{"type":"text","text":" makes. The map need not be one-to-one: vertices with equal names merge into"},{"type":"text","text":" "},{"type":"text","text":"one vertex, which takes all their edges, so an edge between two of them becomes a"},{"type":"text","text":" "},{"type":"text","text":"self-loop."}],"metadata":{"extendedModule":"GraphProtocols","title":"relabeled(_:by:)","modules":[{"name":"GraphOperations","relatedModules":["GraphProtocols"]}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"relabeled"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"}],"role":"symbol","externalID":"s:14GraphProtocols015MutableDirectedA0P0A10OperationsE9relabeled_2byxqd___6VertexQzAGQyd__XEtAA0dA0Rd__lFZ","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/Relabeling.swift#L63","fileName":"Relabeling.swift"},"roleHeading":"Type Method"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"relabeled"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"graph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"transform"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"graph","content":[{"type":"paragraph","inlineContent":[{"text":"The graph to copy.","type":"text"}]}]},{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"text":"The new name of each vertex, called once per vertex in vertex order.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The renamed copy."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The vertices are the distinct names in "},{"type":"codeVoice","code":"graph"},{"type":"text","text":"’s vertex order, each at its first"},{"type":"text","text":" "},{"type":"text","text":"occurrence. Each edge of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":", in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, is inserted with its ends renamed:"},{"type":"text","text":" "},{"type":"text","text":"a simple target ("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":") keeps the first of any edges that coincide, and a"},{"type":"text","text":" "},{"type":"text","text":"pseudograph keeps them all. Under a one-to-one map into a target that keeps every edge,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th edge of "},{"type":"codeVoice","code":"graph.edges"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th inserted. Attached maps are not carried; a"},{"type":"text","text":" "},{"type":"text","text":"value moves over by its renamed vertex."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"O(n + m), with one hash per vertex here and the target’s insertions.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"The graph has vertex indices."}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOp