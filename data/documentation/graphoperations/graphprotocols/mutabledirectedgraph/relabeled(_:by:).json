amed ","type":"text"},{"code":"transform(v)","type":"codeVoice"},{"text":", as NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"relabel_nodes","type":"codeVoice"},{"text":" makes. The map need not be one-to-one: vertices with equal names merge into","type":"text"},{"text":" ","type":"text"},{"text":"one vertex, which takes all their edges, so an edge between two of them becomes a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop.","type":"text"}],"references":{"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"title":"GraphProtocols","abstract":[],"role":"collection","url":"\/documentation\/graphoperations\/graphprotocols","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","title":"Vertex","role":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}]},"doc://GraphOperatio