xt"},{"text":"graph","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"transform","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The graph to copy."}],"type":"paragraph"}],"name":"graph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new name of each vertex, called once per vertex in vertex order."}]}],"name":"transform"}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"inlineContent":[{"text":"The renamed copy.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices are the distinct names in "},{"type":"codeVoice","code":"graph"},{"type":"text","text":"’s vertex order, each at its first"},{"type":"text","text":" "},{"type":"text","text":"occurrence. Each edge of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":", in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, is inserted with its ends renamed:"},{"type":"text","text":" "},{"type":"text","text":"a simple target ("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":") keeps the first of any edges that coincide, and a"},{"type":"text","text":" "},{"type":"text","text":"pseudograph keeps them all. Under a one-to-one map into a target that keeps every edge,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th edge of "},{"type":"codeVoice","code":"graph.edges"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th inserted. Attached maps are not carried; a"},{"type":"text","text":" "},{"type":"text","text":"value moves over by its renamed vertex."}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n + m), with one hash per vertex here and the target’s insertions."}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"Precondition","content":[{"inlineContent":[{"text":"The graph has vertex indices.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph\/relabeled(_:by:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph"]]},"abstract":[{"type":"text","text":"A copy of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":" with every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" renamed "},{"type":"codeVoice","code":"transform(v)"},{"type":"text","text":", as NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"relabel_nodes"},{"type":"text","text":" makes. The map need not be one-to-one: vertices with equal names merge into"},{"type":"text","text":" "},{"type":"text","text":"one vertex, which takes all their edges, so an edge between two of them becomes a"},{"type":"text","text":" "},{"type":"text","text":"self-loop."}],"references":{"doc://GraphOperations/documentation/GraphOperations":{"type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","url":"\/documentation\/graphoperations","role":"collection","title":"GraphOperations","kind":"symbol","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","title":"DirectedGraph","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"type":"topic"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/MutableDirectedGraph":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph","url":"\/documentation\/graphoperations\/graphprotocols\/mutabledirectedgraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols015MutableDirectedA0P"}],"navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"type":"topic","kind":"symbol","title":"MutableDirect