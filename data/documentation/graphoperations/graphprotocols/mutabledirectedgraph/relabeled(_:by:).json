" renamed "},{"type":"codeVoice","code":"transform(v)"},{"type":"text","text":", as NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"relabel_nodes"},{"type":"text","text":" makes. The map need not be one-to-one: vertices with equal names merge into"},{"type":"text","text":" "},{"type":"text","text":"one vertex, which takes all their edges, so an edge between two of them becomes a"},{"type":"text","text":" "},{"type":"text","text":"self-loop."}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relabeled","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"graph","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"transform","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"graph","content":[{"inlineContent":[{"text":"The graph to copy.","type":"text"}],"type":"paragraph"}]},{"name":"transform","content":[{"inlineContent":[{"type":"text","text":"The new name of each vertex, called once per vertex in vertex order."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The renamed copy."}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The vertices are the distinct names in "},{"type":"codeVoice","code":"graph"},{"type":"text","text":"’s vertex order, each at its first"},{"type":"text","text":" "},{"type":"text","text":"occurrence. Each edge of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":", in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, is inserted with its ends renamed:"},{"type":"text","text":" "},{"type":"text","text":"a simple target ("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":") keeps the first of any edges that coincide, and a"},{"type":"text","text":" "},{"type":"text","text":"pseudograph keeps them all. Under a one-to-one map into a target that keeps every edge,"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th edge of "},{"type":"codeVoice","code":"graph.edges"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th inserted. Attached maps are not carried; a"},{"type":"text","text":" "},{"type":"text","text":"value moves over by its renamed vertex."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n + m), with one hash per vertex here and the target’s insertions.","type":"text"}]}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"The graph has vertex indices."}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/graphprotocols\/mutabledirectedgraph\/relabeled(_:by:)"]}],"kind":"symbol","references":{"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/MutableDirectedGraph/relabeled(_:by:)":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A copy of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":" with every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" renamed "},{"type":"codeVoice","code":"transform(v)"},{"type":"text","text":", as NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"relabel_nodes"},{"type":"text","text":" makes. The map need not be one-to-one: vertices with equal names merge into"},{"type":"text","text":" "},{"type":"text","text":"one vertex, which takes all their edges, so an edge between two of them becomes a"},{"type":"text","text":" "},{"type":"text","text":"self-loop."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"relabeled"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14G