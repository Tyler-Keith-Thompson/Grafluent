" ","type":"text"},{"text":"occurrence. Each edge of ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":", in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" order, is inserted with its ends renamed:","type":"text"},{"text":" ","type":"text"},{"text":"a simple target (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":") keeps the first of any edges that coincide, and a","type":"text"},{"text":" ","type":"text"},{"text":"pseudograph keeps them all. Under a one-to-one map into a target that keeps every edge,","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th edge of ","type":"text"},{"code":"graph.edges","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th inserted. Attached maps are not carried; a","type":"text"},{"text":" ","type":"text"},{"text":"value moves over by its renamed vertex.","type":"text"}]},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m), with one hash per vertex here and the target’s insertions."}]}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"The graph has vertex indices.","type":"text"}]}],"type":"aside","style":"note"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph\/relabeled(_:by:)"},"abstract":[{"type":"text","text":"A copy of "},{"code":"graph","type":"codeVoice"},{"type":"text","text":" with every vertex "},{"code":"v","type":"codeVoice"},{"type":"text","text":" renamed "},{"code":"transform(v)","type":"codeVoice"},{"type":"text","text":", as NetworkX’s"},{"type":"text","text":" "},{"code":"relabel_nodes","type":"codeVoice"},{"type":"text","text":" makes. The map need not be one-to-one: vertices with equal names merge into"},{"type":"text","text":" "},{"type":"text","text":"one vertex, which takes all their edges, so an edge between two of them becomes a"},{"type":"text","text":" "},{"type":"text","text":"self-loop."}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph"]]},"references":{"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"kind":"symbol","url":"\/documentation\/graphoperations\/graphprotocols","type":"topic","title":"GraphProtocols","role":"collection","abstract":[],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/MutableDirectedGraph":{"role":"symbol","title":"MutableDirectedGraph","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphoperations\/graphprotocols\/mutabledirectedgraph","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols015MutableDirectedA0P"}],"abstract":[],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","type":"topic","title":"Vertex","role":"symbol","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},"doc://GraphProtocols/documentation/Gr