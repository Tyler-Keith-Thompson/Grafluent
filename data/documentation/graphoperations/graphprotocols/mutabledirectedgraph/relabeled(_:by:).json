x in vertex order."}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The renamed copy.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The vertices are the distinct names in ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":"’s vertex order, each at its first","type":"text"},{"text":" ","type":"text"},{"text":"occurrence. Each edge of ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":", in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" order, is inserted with its ends renamed:","type":"text"},{"text":" ","type":"text"},{"text":"a simple target (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":") keeps the first of any edges that coincide, and a","type":"text"},{"text":" ","type":"text"},{"text":"pseudograph keeps them all. Under a one-to-one map into a target that keeps every edge,","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th edge of ","type":"text"},{"code":"graph.edges","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th inserted. Attached maps are not carried; a","type":"text"},{"text":" ","type":"text"},{"text":"value moves over by its renamed vertex.","type":"text"}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n + m), with one hash per vertex here and the target’s insertions."}],"type":"paragraph"}],"style":"note"},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph has vertex indices."}]}],"style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph"]]},"sections":[],"abstract":[{"type":"text","text":"A copy of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":" with every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" renamed "},{"type":"codeVoice","code":"transform(v)"},{"type":"text","text":", as NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"relabel_nodes"},{"type":"text","text":" makes. The map need not be one-to-one: vertices with equal names merge into"},{"type":"text","text":" "},{"type":"text","text":"one vertex, which takes all their edges, so an edge between two of them becomes a"},{"type":"text","text":" "},{"type":"text","text":"self-loop."}],"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph\/relabeled(_:by:)","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"GraphOperations","relatedModules":["GraphProtocols"]}],"role":"symbol","externalID":"s:14GraphProtocols015MutableDirectedA0P0A10OperationsE9relabeled_2byxqd___6VertexQzAGQyd__XEtAA0dA0Rd__lFZ","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/Relabeling.swift#L63","fileName":"Relabeling.swift"},"roleHeading":"Type Method","symbolKind":"method","title":"relabeled(_:by:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relabeled","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text