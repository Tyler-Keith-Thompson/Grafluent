 insertions.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"The graph has vertex indices.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph\/relabeled(_:by:)","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://GraphOperations/documentation/GraphOperations":{"role":"collection","title":"GraphOperations","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/graphoperations"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/MutableDirectedGraph":{"url":"\/documentation\/graphoperations\/graphprotocols\/mutabledirectedgraph","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableDirectedGraph","kind":"symbol","title":"MutableDirectedGraph","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"abstract":[],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols015MutableDirectedA0P","kind":"identifier","text":"MutableDirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","title":"Vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"Directed