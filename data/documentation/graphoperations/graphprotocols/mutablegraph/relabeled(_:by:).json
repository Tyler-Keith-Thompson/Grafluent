der, is inserted with its ends renamed in","type":"text"},{"text":" ","type":"text"},{"text":"its own orientation (","type":"text"},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"text":"): a simple target","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"text":") keeps the first of any edges that coincide, and a pseudograph","type":"text"},{"text":" ","type":"text"},{"text":"keeps them all. Attached maps are not carried; a value moves over by its renamed vertex.","type":"text"}],"type":"paragraph"},{"name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m), with one hash per vertex here and the target’s insertions."}]}],"style":"note"},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The graph has vertex indices.","type":"text"}]}],"style":"note"}]}],"variants":[{"paths":["\/documentation\/graphoperations\/graphprotocols\/mutablegraph\/relabeled(_:by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableGraph"]]},"abstract":[{"text":"A copy of ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":" with every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" renamed ","type":"text"},{"code":"transform(v)","type":"codeVoice"},{"text":". The map need not be","type":"text"},{"text":" ","type":"text"},{"text":"one-to-one: vertices with equal names merge into one vertex, which takes all their edges,","type":"text"},{"text":" ","type":"text"},{"text":"so an edge between two of them becomes a self-loop.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols