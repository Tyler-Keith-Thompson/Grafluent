"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The renamed copy.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices are the distinct names in "},{"type":"codeVoice","code":"graph"},{"type":"text","text":"’s vertex order, each at its first"},{"type":"text","text":" "},{"type":"text","text":"occurrence. Each edge of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":", in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, is inserted with its ends renamed in"},{"type":"text","text":" "},{"type":"text","text":"its own orientation ("},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"type":"text","text":"): a simple target"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":") keeps the first of any edges that coincide, and a pseudograph"},{"type":"text","text":" "},{"type":"text","text":"keeps them all. Attached maps are not carried; a value moves over by its renamed vertex."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m), with one hash per vertex here and the target’s insertions."}]}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph has vertex indices."}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableGraph"]]},"abstract":[{"text":"A copy of ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":" with every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" renamed ","type":"text"},{"code":"transform(v)","type":"codeVoice"},{"text":". The map need not be","type":"text"},{"text":" ","type":"text"},{"text":"one-to-one: vertices with equal names merge into one vertex, which takes all their edges,","type":"text"},{"text":" ","type":"text"},{"text":"so an edge between two of them becomes a self-loop.","type":"text"}],"sections":[],"metadata":{"externalID":"s:14GraphProtocols07MutableA0P0A10OperationsE9relabeled_2byxqd___6VertexQzAGQyd__XEtAA0A0Rd__lFZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relabeled","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}],"role":"symbol","title":"relabeled(_:by:)","modules":[{"name":"GraphOperations","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","symbolKind":"method","remoteSource":{"fileName":"Relabeling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/Relabeling.swift#L95"},"roleHeading":"Type Method"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/graphprotocols\/mutablegraph\/relabeled(_:by:)"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols