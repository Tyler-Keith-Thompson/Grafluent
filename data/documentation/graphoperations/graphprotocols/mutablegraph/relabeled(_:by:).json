es a self-loop."}],"kind":"symbol","references":{"doc://GraphOperations/documentation/GraphOperations/GraphProtocols":{"role":"collection","title":"GraphProtocols","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/graphoperations\/graphprotocols"},"doc://GraphOperations/documentation/GraphOperations/GraphProtocols/MutableGraph/relabeled(_:by:)":{"url":"\/documentation\/graphoperations\/graphprotocols\/mutablegraph\/relabeled(_:by:)","title":"relabeled(_:by:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableGraph\/relabeled(_:by:)","kind":"symbol","abstract":[{"type":"text","text":"A copy of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":" with every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" renamed "},{"type":"codeVoice","code":"transform(v)"},{"type":"text","text":". The map need not be"},{"type":"text","text":" "},{"type":"text","text":"one-to-one: vertices with equal names merge into one vertex, which takes all their edges,"},{"type":"text","text":" "},{"type":"text","text":"so an edge between two of them becomes a self-loop."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"relabeled"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6Ver