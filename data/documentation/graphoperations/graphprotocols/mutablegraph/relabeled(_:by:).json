"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"text":"The renamed copy.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"The vertices are the distinct names in ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":"’s vertex order, each at its first","type":"text"},{"text":" ","type":"text"},{"text":"occurrence. Each edge of ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":", in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" order, is inserted with its ends renamed in","type":"text"},{"text":" ","type":"text"},{"text":"its own orientation (","type":"text"},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"text":"): a simple target","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"UndirectedAdjacencyList","type":"codeVoice"},{"text":") keeps the first of any edges that coincide, and a pseudograph","type":"text"},{"text":" ","type":"text"},{"text":"keeps them all. Attached maps are not carried; a value moves over by its renamed vertex.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"O(n + m), with one hash per vertex here and the target’s insertions.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"The graph has vertex indices.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols","doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableGraph"]]},"sections":[],"abstract":[{"type":"text","text":"A copy of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":" with every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" renamed "},{"type":"codeVoice","code":"transform(v)"},{"type":"text","text":". The map need not be"},{"type":"text","text":" "},{"type":"text","text":"one-to-one: vertices with equal names merge into one vertex, which takes all their edges,"},{"type":"text","text":" "},{"type":"text","text":"so an edge between two of them becomes a self-loop."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/GraphProtocols\/MutableGraph\/relabeled(_:by:)"},"metadata":{"modules":[{"name":"GraphOperations","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols07MutableA0P0A10OperationsE9relabeled_2byxqd___6VertexQzAGQyd__XEtAA0A0Rd__lFZ","remoteSource":{"fileName":"Relabeling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/Relabeling.swift#L95"},"roleHeading":"Type Method","symbolKind":"method","title":"relabeled(_:by:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relabeled","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}],"role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/graphoperations\/graphprotocols\/mutablegraph\/relabeled(_:by:)"],"traits"