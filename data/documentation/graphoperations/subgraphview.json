": the kept edges of the base, in its order, at its","type":"text"},{"text":" ","type":"text"},{"text":"positions. Stepping from one to the next skips the dropped ones.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedEdges","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedEdges","kind":"identifier"}],"kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}]},"role":"symbol","url":"\/documentation\/graphoperations\/subgraphview\/directededges","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeRow":{"abstract":[{"text":"A row of positions (out-, in- or incident edges): the base’s, with the dropped edges","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The index row is stepped in step only when the view drops vertices.","type":"text"}],"role":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","navigatorTitle":[{"kind":"identifier","text":"EdgeRow"}],"title":"SubgraphView.EdgeRow","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeRow"}],"type":"topic","kind":"symbol","url":"\/documentation\/graphoperations\/subgraphview\/edgerow"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"url":"\/documentation\/graphprotocols\/graph","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/UndirectedEdges":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdges","kind":"identifier"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}]},"kind":"symbol","abstract":[{"text":"The edges of an undirected ","type":"text"},{"type":"codeVoice","code":"SubgraphView"},{"text":": the kept edges of the base, in its order, at","type":"text"},{"text":" ","type":"text"},{"text":"its positions.","type":"text"}],"type":"topic","url":"\/documentation\/graphoperations\/subgraphview\/undirectededges","title":"SubgraphView.UndirectedEdges","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges","role":"symbol","navigatorTitle":[{"text":"UndirectedEdges","kind":"identifier"}]},"doc://GraphOperations/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/GraphOperations\/s16SendableMetatypeP"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/Graph-Implementations":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","title":"Graph Implementations","role":"collectionGroup","kind":"article","url":"\/documentation\/graphoperations\/subgraphview\/graph-implementations","type":"topic","abstract":[]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/IndexRow":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IndexRow"}],"abstract":[{"text":"A row in index space (successors, predecessors or neighbors): the base’s row with the","type":"text"},{"text":" ","type":"text"},{"text":"dropped entries skipped and the rest renumbered. One array load per entry, no hashing. The","type":"text"},{"text":" ","type":"text"},{"text":"row holds one reference to the view’s renumbering and edge set (none when the view keeps","type":"text"},{"text":" ","type":"text"},{"text":"everything), and walks the base’s position row only under an edge set.","type":"text"}],"kind":"symbol","title":"SubgraphView.IndexRow","url":"\/documentation\/graphoperations\/subgraphview\/indexrow","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IndexRow"}]},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"kind":"symbol","title":"GraphOperations","url":"\/documentation\/graphoperations","ty