{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges"],"anchor":"Structures"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base"],"anchor":"Instance-Properties"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo"}],"abstract":[{"text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered","type":"text"},{"text":" ","type":"text"},{"text":"densely. Made by ","type":"text"},{"code":"inducedSubgraph(on:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"spanningSubgraph(edges:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"subgraph(vertices:edges:)","type":"codeVoice"},{"text":" (NetworkX’s ","type":"text"},{"code":"subgraph_view","type":"codeVoice"},{"text":", JGraphT’s ","type":"text"},{"code":"AsSubgraph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"SubDigraph","type":"codeVoice"},{"text":", Boost’s ","type":"text"},{"code":"filtered_graph","type":"codeVoice"},{"text":").","type":"text"}],"variants":[{"paths":["\/documentation\/graphoperations\/subgraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Vertices"}],"type":"strong"},{"text":" are the kept vertices in the base’s order, at view indices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"view keeps two arrays, base index to view index and back, so a row is the base’s row filtered","type":"text"},{"text":" ","type":"text"},{"text":"and renumbered with one array load per entry and no hashing. A spanning subgraph keeps every","type":"text"},{"text":" ","type":"text"},{"text":"vertex at its base index.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Edges","type":"text"}],"type":"strong"},{"text":" keep the base’s positions, so a weight closure keyed by the base’s positions works","type":"text"},{"text":" ","type":"text"},{"text":"on the view. An edge is in the view when both its ends are, and, if an edge set was given,","type":"text"},{"text":" ","type":"text"},{"text":"when it is in the set. With an edge set the view has dense edge indices: an edge’s index is its","type":"text"},{"text":" ","type":"text"},{"text":"rank among the kept edges in base order. Over a base with edge indices the set is a bit mask","type":"text"},{"text":" ","type":"text"},{"text":"with a count per 64-bit word, so the rank costs one popcount. Over a base without them (an","type":"text"},{"text":" ","type":"text"},{"code":"AdjacencyMatrix","type":"codeVoice"},{"text":", a complement, an induced subgraph) the set is the sorted kept positions, and","type":"text"},{"text":" ","type":"text"},{"text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices: building","type":"text"},{"text":" ","type":"text"},{"text":"its edge mask would cost O(m).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view holds a copy of the base (value semantics), so mutating the original never shows"},{"type":"text","text":" "},{"type":"text","text":"through. Phase 1 needs a base with vertex indices; a "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" with vertex holes"},{"type":"text","text":" "},{"type":"text","text":"traps at construction."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" "