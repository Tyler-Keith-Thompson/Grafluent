{"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checked:)-2n5fj","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checked:)-34kf9","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checkedEdgeAt:)-40a5z","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checkedEdgeAt:)-7lnri","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:of:)-16yvl","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:of:)-3uhp3","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:ofEdgeAt:)-1tfjm","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:ofEdgeAt:)-8bx4q"],"generated":true,"title":"Subscripts","anchor":"Subscripts"},{"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/GraphAdaptor-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"metadata":{"modules":[{"name":"GraphOperations"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/SubgraphView.swift#L31","fileName":"SubgraphView.swift"},"roleHeading":"Structure","title":"SubgraphView","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SubgraphView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubgraphView"}],"role":"symbol","externalID":"s:15GraphOperations12SubgraphViewV"},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The kept vertices appear in the base’s order at view indices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". The view keeps"},{"type":"text","text":" "},{"type":"text","text":"two arrays, base index to view index and back, so a row is the base’s row filtered and"},{"type":"text","text":" "},{"type":"text","text":"renumbered with one array load per entry. A spanning subgraph keeps every vertex at its base"},{"type":"text","text":" "},{"type":"text","text":"index."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Edges keep the base’s positions, so a weight closure keyed by the base’s positions works on"},{"type":"text","text":" "},{"type":"text","text":"the view. An edge is in the view when both its ends are and, if an edge set was given, when it"},{"type":"text","text":" "},{"type":"text","text":"is in the set. With an edge set the view has dense edge indices, an edge’s index being its rank"},{"type":"text","text":" "},{"type":"text","text":"among the kept edges in base order. Over a base with edge indices the set is a bit mask with a"},{"type":"text","text":" "},{"type":"text","text":"count per 64-bit word, and a rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"code":"AdjacencyMatrix","type":"codeVoice"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices, except one"},{"type":"text","text":" "},{"type":"text","text":"that keeps every vertex, which keeps the base’s rows and edge indices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view holds a copy of the base, so mutating the original doesn’t show through. The base"},{"type":"text","text":" "},{"type":"text","text":"must have vertex indices; construction traps when "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"As a ","type":"text"},{"type":"codeVoice","code":"GraphAdaptor"},{"text":", its generation is the base’s, and it reads the base’s attached maps.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"[map, of: vertex]"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"[map, ofEdgeAt: position]"},{"text":" trap for a vertex or an edge the view drops,","type":"text"},{"text":" ","type":"text"},{"text":"and their ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" forms throw. ","type":"text"},{"type":"codeVoice","code":"values(of:)"},{"text":" is the base’s, by the base’s positions. An","type":"text"},{"text":" ","type":"text"},{"text":"algorithm on the view reads it only at the kept edges.","type":"text"}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/subgraphview"]}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"abstract":[{"type":"text","text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered"},{"type":"text","text":" "},{"type":"text","text":"densely. Made by "},{"code":"inducedSubgraphView(on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"spanningSubgraphView(edges:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"subgraphView(vertices:edges:)","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://GraphOperations/documentation/GraphOperations/SubgraphView/subscript(_:checkedEdgeAt:)-7lnri":{"type":"topic","identifier":"doc:\/\/GraphO