mentations"],"generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"The kept vertices appear in the base’s order at view indices ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":". The view keeps","type":"text"},{"text":" ","type":"text"},{"text":"two arrays, base index to view index and back, so a row is the base’s row filtered and","type":"text"},{"text":" ","type":"text"},{"text":"renumbered with one array load per entry. A spanning subgraph keeps every vertex at its base","type":"text"},{"text":" ","type":"text"},{"text":"index.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Edges keep the base’s positions, so a weight closure keyed by the base’s positions works on"},{"type":"text","text":" "},{"type":"text","text":"the view. An edge is in the view when both its ends are and, if an edge set was given, when it"},{"type":"text","text":" "},{"type":"text","text":"is in the set. With an edge set the view has dense edge indices, an edge’s index being its rank"},{"type":"text","text":" "},{"type":"text","text":"among the kept edges in base order. Over a base with edge indices the set is a bit mask with a"},{"type":"text","text":" "},{"type":"text","text":"count per 64-bit word, and a rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices, except one"},{"type":"text","text":" "},{"type":"text","text":"that keeps every vertex, which keeps the base’s rows and edge indices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view holds a copy of the base, so mutating the original doesn’t show through. The base"},{"type":"text","text":" "},{"type":"text","text":"must have vertex indices; construction traps when "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"As a ","type":"text"},{"code":"GraphAdaptor","type":"codeVoice"},{"text":", its generation is the base’s, and it reads the base’s attached maps.","type":"text"},{"text":" ","type":"text"},{"code":"[map, of: vertex]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"[map, ofEdgeAt: position]","type":"codeVoice"},{"text":" trap for a vertex or an edge the view drops,","type":"text"},{"text":" ","type":"text"},{"text":"and their ","type":"text"},{"code":"checked:","type":"codeVoice"},{"text":" forms throw. ","type":"text"},{"code":"values(of:)","type":"codeVoice"},{"text":" is the base’s, by the base’s positions. An","type":"text"},{"text":" ","type":"text"},{"text":"algorithm on the view reads it only at the kept edges.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/graphoperations\/subgraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"sections":[],"references":{"doc://GraphOperations/documentation/GraphOperations/SubgraphView/GraphAdaptor-Implementations":{"type":"topic","identifier":"doc:\/\/GraphOperat