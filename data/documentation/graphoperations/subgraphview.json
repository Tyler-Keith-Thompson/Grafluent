tation\/GraphOperations\/SubgraphView\/subscript(_:checkedEdgeAt:)-40a5z","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checkedEdgeAt:)-7lnri","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:of:)-16yvl","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:of:)-3uhp3","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:ofEdgeAt:)-1tfjm","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:ofEdgeAt:)-8bx4q"],"generated":true,"anchor":"Subscripts"},{"title":"Default Implementations","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/GraphAdaptor-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView"},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/subgraphview"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The kept vertices appear in the base’s order at view indices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":". The view keeps"},{"type":"text","text":" "},{"type":"text","text":"two arrays, base index to view index and back, so a row is the base’s row filtered and"},{"type":"text","text":" "},{"type":"text","text":"renumbered with one array load per entry. A spanning subgraph keeps every vertex at its base"},{"type":"text","text":" "},{"type":"text","text":"index."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edges keep the base’s positions, so a weight closure keyed by the base’s positions works on"},{"type":"text","text":" "},{"type":"text","text":"the view. An edge is in the view when both its ends are and, if an edge set was given, when it"},{"type":"text","text":" "},{"type":"text","text":"is in the set. With an edge set the view has dense edge indices, an edge’s index being its rank"},{"type":"text","text":" "},{"type":"text","text":"among the kept edges in base order. Over a base with edge indices the set is a bit mask with a"},{"type":"text","text":" "},{"type":"text","text":"count per 64-bit word, and a rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices, except one"},{"type":"text","text":" "},{"type":"text","text":"that keeps every vertex, which keeps the base’s rows and edge indices."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view holds a copy of the base, so mutating the original doesn’t show through. The base"},{"type":"text","text":" "},{"type":"text","text":"must have vertex indices; construction traps when "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"As a ","type":"text"},{"code":"GraphAdaptor","type":"codeVoice"},{"text":", its generation is the base’s, and it reads the base’s attached maps.","type":"text"},{"text":" ","type":"text"},{"code":"[map, of: vertex]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"[map, ofEdgeAt: position]","type":"codeVoice"},{"text":" trap for a vertex or an edge the view drops,","type":"text"},{"text":" ","type":"text"},{"text":"and their ","type":"text"},{"code":"checked:","type":"codeVoice"},{"text":" forms throw. ","type":"text"},{"code":"values(of:)","type":"codeVoice"},{"text":" is the base’s, by the base’s positions. An","type":"text"},{"text":" ","type":"text"},{"text":"algorithm on the view reads it only at the kept edges.","type":"text"}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods. In-adjacency usually costs extra"},{"type":"text","text":" "},{"type":"text","text":"storage, so representations that store only out-adjacency conform to "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" alone."}],"navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"title":"BidirectionalDirectedGraph","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"type":"topic","title":"Graph","url":"\/documentation\/graphprotocols\/graph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/BidirectionalDirectedGraph-Implementations":{"abstract":[],"kind":"article","url":"\/documentation\/graphoperations\/subgraphview\/bidirectionaldirectedgraph-implementations","role":"collectionGroup","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","title":"BidirectionalDirectedGraph Implementations"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeIndexRow":{"type":"topic","navigatorTitle":[{"text":"EdgeIndexRow","kind":"identifier"}],"role":"symbol","title":"SubgraphView.EdgeInd