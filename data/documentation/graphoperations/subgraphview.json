t also answers in-neighborhoods: Boost’s ","type":"text"},{"code":"BidirectionalGraph","type":"codeVoice"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" because in-adjacency usually costs extra storage, and many algorithms only","type":"text"},{"text":" ","type":"text"},{"text":"go forward.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}]},"doc://GraphOperations/documentation/GraphOperations":{"role":"collection","kind":"symbol","abstract":[],"title":"GraphOperations","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","type":"topic","url":"\/documentation\/graphoperations"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/UndirectedEdges":{"conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges","title":"SubgraphView.UndirectedEdges","url":"\/documentation\/graphoperations\/subgraphview\/undirectededges","abstract":[{"type":"text","text":"The edges of an undirected "},{"code":"SubgraphView","type":"codeVoice"},{"type":"text","text":": the kept edges of the base, in its order, at"},{"type":"text","text":" "},{"type":"text","text":"its positions."}],"type":"topic","navigatorTitle":[{"text":"UndirectedEdges","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdges","kind":"identifier"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","type":"topic","kind":"symbol","title":"DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeIndexRow":{"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","title":"SubgraphView.EdgeIndexRow","type":"topic","url":"\/documentation\/graphoperations\/subgraphview\/edgeindexrow","abstract":[{"type":"text","text":"The view’s edge indices of a row of positions: each kept position’s rank, or the base’s"},{"type":"text","text":" "},{"type":"text","text":"own edge-index row when the view keeps every vertex and every edge."}],"navigatorTitle":[{"text":"EdgeIndexRow","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeIndexRow","kind":"identifier"}],"role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeRow":{"url":"\/documentation\/graphoperations\/subgraphview\/edgerow","role":"symbol","kind":"symbol","type":"topic","title":"SubgraphView.EdgeRow","navigatorTitle":[{"text":"EdgeRow","kind":"identifier"}],"abstract":[{"text":"A row of positions (out-, in- or incident edges): the base’s, with the dropped edges","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The index row is stepped in step only when the view drops vertices.","type":"text"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeRow","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView":{"url":"\/documentation\/graphoperations\/subgraphview","role":"symbol","type":"topic","kind":"symbol","title":"SubgraphView","navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}],"abstract":[{"type":"text","text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered"},{"type":"text","text":" "},{"type":"text","text":"densely. Made by "},{"code":"inducedSubgraph(on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"spanningSubgraph(edges:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"subgraph(vertices:edges:)","type":"codeVoice"},{"type":"text","text":" (NetworkX’s "},{"code":"subgraph_view","type":"codeVoice"},{"type":"text","text":", JGraphT’s "},{"code":"AsSubgraph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"SubDigraph","type":"codeVoice"},{"type":"text","text":", Boost’s "},{"code":"filtered_graph","type":"codeVoice"},{"type":"text","text":")."}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/IndexRow":{"role":"symbol","navigatorTitle":[{"text":"IndexRow","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IndexRow","kind":"identifier"}],"abstract":[{"text":"A row in index space (successors, predecessors or neighbors): the base’s row with the","type":"text"},{"text":" ","type":"text"},{"text":"dropped entries skipped and the rest renumbered. One array load per entry, no hashing. The","type":"text"},{"text":" ","type":"text"},{"text":"row holds one reference to the view’s renumbering and edge set (none when the view keeps","type":"text"},{"text":" ","type":"text"},{"text":"everything), and walks the base’s position row only under an edge set.","type":"text"}],"title":"SubgraphView.IndexRow","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","type":"topic","url":"\/documentation\/graphoperations\/subgraphview\/indexrow"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/Graph-Implementations":{"title":"Graph Implementations","role":"collectionGroup","kind":"article","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","type":"topic","abstract":[],"url":"\/documentation\/graphoperations\/subgraphview\/graph-implementations"},"doc://GraphOperations/s8CopyableP":{"identifier":"doc:\/\/GraphOperations\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://GraphOperations/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/GraphOperations\/s8SendableP","title":"Swift.Sendable"}}}