{"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered"},{"type":"text","text":" "},{"type":"text","text":"densely. Made by "},{"type":"codeVoice","code":"inducedSubgraphView(on:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"spanningSubgraphView(edges:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraphView(vertices:edges:)"},{"type":"text","text":" (NetworkX’s "},{"type":"codeVoice","code":"subgraph_view"},{"type":"text","text":", JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"SubDigraph"},{"type":"text","text":", Boost’s "},{"type":"codeVoice","code":"filtered_graph"},{"type":"text","text":")."}],"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges"],"title":"Structures"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base"],"title":"Instance Properties"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"type":"text","text":" are the kept vertices in the base’s order, at view indices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"view keeps two arrays, base index to view index and back, so a row is the base’s row filtered"},{"type":"text","text":" "},{"type":"text","text":"and renumbered with one array load per entry and no hashing. A spanning subgraph keeps every"},{"type":"text","text":" "},{"type":"text","text":"vertex at its base index."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges","type":"text"}]},{"type":"text","text":" keep the base’s positions, so a weight closure keyed by the base’s positions works"},{"type":"text","text":" "},{"type":"text","text":"on the view. An edge is in the view when both its ends are, and, if an edge set was given,"},{"type":"text","text":" "},{"type":"text","text":"when it is in the set. With an edge set the view has dense edge indices: an edge’s index is its"},{"type":"text","text":" "},{"type":"text","text":"rank among the kept edges in base order. Over a base with edge indices the set is a bit mask"},{"type":"text","text":" "},{"type":"text","text":"with a count per 64-bit word, so the rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices: building"},{"type":"text","text":" "},{"type":"text","text":"its edge mask would cost O(m). One on every vertex keeps the base’s rows, edge indices and flat"},{"type":"text","text":" "},{"type":"text","text":"rows."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view holds a copy of the base (value semantics), so mutating the original never shows"},{"type":"text","text":" "},{"type":"text","text":"through. Phase 1 needs a base with vertex indices; a "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" with vertex holes"},{"type":"text","text":" "},{"type":"text","text":"traps at construction."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/subgraphview"]}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"GraphOperations"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/SubgraphView.swift#L29","fileName":"SubgraphView.swift"},"title":"SubgraphView","symbolKind":"struct","role":"symbol","navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:15GraphOperations12SubgraphViewV"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeIndexRow":{"abstract":[{"type":"text","text":"The view’s edge indices of a row of positions: each kept position’s rank, or the base’s"},{"type":"text","text":" "},{"type":"text","text":"own edge-index row when the view keeps every vertex and every edge."}],"kind":"symbol","type":"topic","title":"SubgraphView.EdgeIndexRow","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EdgeIndexRow"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeIndexRow"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","url":"\/documentation\/graphoperations\/subgraphview\/edgeindexrow"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/IndexRow":{"navigatorTitle":[{"text":"IndexRow","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"SubgraphView.IndexRow","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","url":"\/documentation\/graphoperations\/subgraphview\/indexrow","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IndexRow","kind":"identifier"}],"type":"topic","abstract":[{"text":"A row in index space (successors, predecessors or neighbors): the base’s row with the","type":"text"},{"text":" ","type":"text"},{"text":"dropped entries skipped and the rest renumbered. One array load per entry, no hashing. The","type":"text"},{"text":" ","type":"text"},{"text":"row holds one reference to the view’s renumbering and edge set (none when the view keeps","type":"text"},{"text":" ","type":"text"},{"text":"everything), and walks the base’s position row only under an edge set.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","title":"BidirectionalDirectedGraph","type":"topic","role":"symbol","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/DirectedEdges":{"abstract":[{"type":"text","text":"The edges of a directed "},{"type":"codeVoice","code":"SubgraphView"},{"type":"text","text":": the kept edges of the base, in its order, at its"},{"type":"text","text":" "},{"type":"text","text":"positions. Stepping from one to the next skips the dropped ones."}],"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedEdges"}],"url":"\/documentation\/graphoperations\/subgraphview\/directededges","title":"SubgraphView.DirectedEdges","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedEdges"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/Graph-Implementations":{"url":"\/documentation\/graphoperations\/subgraphview\/graph-implementations","abstract":[],"title":"Graph Implementations","role":"collectionGroup","kind":"article","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeRow":{"abstract":[{"type":"text","text":"A row of positions (out-, in- or incident edges): the base’s, with the dropped edges"},{"type":"text","text":" "},{"type":"text","text":"skipped. The index row is stepped in step only when the view drops vertices."}],"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeRow","kind":"identifier"}],"url":"\/documentation\/graphoperations\/subgraphview\/edgerow","title":"SubgraphView.EdgeRow","type":"topic","navigatorTitle":[{"text":"EdgeRow","kind":"identifier"}]},"doc://GraphOperations/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/GraphOperations\/s8CopyableP"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/base":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base","title":"base","url":"\/documentation\/graphoperations\/subgraphview\/base","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"base","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier"}],"type":"topic","abstract":[{"text":"The graph the view filters.","type":"text"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/BidirectionalDirectedGraph-Implementations":{"role":"collectionGroup","title":"BidirectionalDirectedGraph Implementations","url":"\/documentation\/graphoperations\/subgraphview\/bidirectionaldirectedgraph-implementations","kind":"article","type":"topic","abstract":[],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/DirectedGraph-Implementations":{"url":"\/documentation\/graphoperations\/subgraphview\/directedgraph-implementations","abstract":[],"title":"DirectedGraph Implementations","role":"collectionGroup","kind":"article","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations"},"doc://GraphOperations/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/GraphOperations\/s9EscapableP"},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"title":"GraphOperations","type":"topic","url":"\/documentation\/graphoperations","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","role":"collection"},"doc://GraphOperations/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/GraphOperations\/s8SendableP"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView":{"navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"SubgraphView","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","url":"\/documentation\/graphoperations\/subgraphview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered"},{"type":"text","text":" "},{"type":"text","text":"densely. Made by "},{"code":"inducedSubgraphView(on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"spanningSubgraphView(edges:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"subgraphView(vertices:edges:)","type":"codeVoice"},{"type":"text","text":" (NetworkX’s "},{"code":"subgraph_view","type":"codeVoice"},{"type":"text","text":", JGraphT’s "},{"code":"AsSubgraph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"SubDigraph","type":"codeVoice"},{"type":"text","text":", Boost’s "},{"code":"filtered_graph","type":"codeVoice"},{"type":"text","text":")."}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/UndirectedEdges":{"abstract":[{"type":"text","text":"The edges of an undirected "},{"type":"codeVoice","code":"SubgraphView"},{"type":"text","text":": the kept edges of the base, in its order, at"},{"type":"text","text":" "},{"type":"text","text":"its positions."}],"kind":"symbol","i