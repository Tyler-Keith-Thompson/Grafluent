{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView"},"kind":"symbol","abstract":[{"text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered","type":"text"},{"text":" ","type":"text"},{"text":"densely. Made by ","type":"text"},{"code":"inducedSubgraph(on:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"spanningSubgraph(edges:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"subgraph(vertices:edges:)","type":"codeVoice"},{"text":" (NetworkX’s ","type":"text"},{"code":"subgraph_view","type":"codeVoice"},{"text":", JGraphT’s ","type":"text"},{"code":"AsSubgraph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"SubDigraph","type":"codeVoice"},{"text":", Boost’s ","type":"text"},{"code":"filtered_graph","type":"codeVoice"},{"text":").","type":"text"}],"metadata":{"navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}],"roleHeading":"Structure","remoteSource":{"fileName":"SubgraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/SubgraphView.swift#L29"},"modules":[{"name":"GraphOperations"}],"title":"SubgraphView","role":"symbol","externalID":"s:15GraphOperations12SubgraphViewV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}]},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"topicSections":[{"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"type":"text","text":" are the kept vertices in the base’s order, at view indices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"view keeps two arrays, base index to view index and back, so a row is the base’s row filtered"},{"type":"text","text":" "},{"type":"text","text":"and renumbered with one array load per entry and no hashing. A spanning subgraph keeps every"},{"type":"text","text":" "},{"type":"text","text":"vertex at its base index."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges"}]},{"type":"text","text":" keep the base’s positions, so a weight closure keyed by the base’s positions works"},{"type":"text","text":" "},{"type":"text","text":"on the view. An edge is in the view when both its ends are, and, if an edge set was given,"},{"type":"text","text":" "},{"type":"text","text":"when it is in the set. With an edge set the view has dense edge indices: an edge’s index is its"},{"type":"text","text":" "},{"type":"text","text":"rank among the kept edges in base order. Over a base with edge indices the set is a bit mask"},{"type":"text","text":" "},{"type":"text","text":"with a count per 64-bit word, so the rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices: building"},{"type":"text","text":" "},{"type":"text","text":"its edge mask would cost O(m). One on every vertex keeps the base’s rows, edge indices and flat"},{"type":"text","text":" "},{"type":"text","text":"rows."}]},{"type":"paragraph","inlineContent":[{"text":"The view holds a copy of the base (value semantics), so mutating the original never shows","type":"text"},{"text":" ","type":"text"},{"text":"through. Phase 1 needs a base with vertex indices; a ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" with vertex holes","type":"text"},{"text":" ","type":"text"},{"text":"traps at construction.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/subgraphview"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","title":"DirectedGraph"},"doc://GraphOperations/s9EscapableP":{"identifier":"doc:\/\/GraphOperations\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeRow":{"title":"SubgraphView.EdgeRow","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeRow","kind":"identifier"}],"url":"\/documentation\/graphoperations\/subgraphview\/edgerow","navigatorTitle":[{"text":"EdgeRow","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A row of positions (out-, in- or incident edges): the base’s, with the dropped edges"},{"type":"text","text":" "},{"type":"text","text":"skipped. The index row is stepped in step only when the view drops vertices."}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeIndexRow":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","type":"topic","title":"SubgraphView.EdgeIndexRow","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeIndexRow"}],"url":"\/documentation\/graphoperations\/subgraphview\/edgeindexrow","abstract":[{"type":"text","text":"The view’s edge indices of a row of positions: each kept position’s rank, or the base’s"},{"type":"text","text":" "},{"type":"text","text":"own edge-index row when the view keeps every vertex and every edge."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EdgeIndexRow"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/DirectedEdges":{"title":"SubgraphView.DirectedEdges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedEdges"}],"url":"\/documentation\/graphoperations\/subgraphview\/directededges","navigatorTitle":[{"kind":"identifier","text":"DirectedEdges"}],"role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Base","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}]},"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","kind":"symbol","type":"topic","abstract":[{"text":"The edges of a directed ","type":"text"},{"code":"SubgraphView","type":"codeVoice"},{"text":": the kept edges of the base, in its order, at its","type":"text"},{"text":" ","type":"text"},{"text":"positions. Stepping from one to the next skips the dropped ones.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","title":"Graph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/BidirectionalDirectedGraph-Implementations":{"kind":"article","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","role":"collectionGroup","abstract":[],"title":"BidirectionalDirectedGraph Implementations","url":"\/documentation\/graphoperations\/subgraphview\/bidirectionaldirectedgraph-implementations","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"topic","title":"BidirectionalDirectedGraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"code":"BidirectionalGraph","type":"codeVoice"},{