raph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/GraphAdaptor-Implementations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/subgraphview"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","modules":[{"name":"GraphOperations"}],"roleHeading":"Structure","externalID":"s:15GraphOperations12SubgraphViewV","title":"SubgraphView","navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/SubgraphView.swift#L34","fileName":"SubgraphView.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubgraphView"}],"symbolKind":"struct"},"sections":[],"abstract":[{"type":"text","text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered"},{"type":"text","text":" "},{"type":"text","text":"densely. Made by "},{"code":"inducedSubgraphView(on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"spanningSubgraphView(edges:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"subgraphView(vertices:edges:)","type":"codeVoice"},{"type":"text","text":" (NetworkX’s "},{"code":"subgraph_view","type":"codeVoice"},{"type":"text","text":", JGraphT’s "},{"code":"AsSubgraph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"SubDigraph","type":"codeVoice"},{"type":"text","text":", Boost’s "},{"code":"filtered_graph","type":"codeVoice"},{"type":"text","text":")."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"text":" are the kept vertices in the base’s order, at view indices ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"view keeps two arrays, base index to view index and back, so a row is the base’s row filtered","type":"text"},{"text":" ","type":"text"},{"text":"and renumbered with one array load per entry and no hashing. A spanning subgraph keeps every","type":"text"},{"text":" ","type":"text"},{"text":"vertex at its base index.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges","type":"text"}]},{"type":"text","text":" keep the base’s positions, so a weight closure keyed by the base’s positions works"},{"type":"text","text":" "},{"type":"text","text":"on the view. An edge is in the view when both its ends are, and, if an edge set was given,"},{"type":"text","text":" "},{"type":"text","text":"when it is in the set. With an edge set the view has dense edge indices: an edge’s index is its"},{"type":"text","text":" "},{"type":"text","text":"rank among the kept edges in base order. Over a base with edge indices the set is a bit mask"},{"type":"text","text":" "},{"type":"text","text":"with a count per 64-bit word, so the rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices: building"},{"type":"text","text":" "},{"type":"text","text":"its edge mask would cost O(m). One on every vertex keeps the base’s rows, edge indices and flat"},{"type":"text","text":" "},{"type":"text","text":"rows."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view holds a copy of the base (value semantics), so mutating the original never shows"},{"type":"text","text":" "},{"type":"text","text":"through. Phase 1 needs a base with vertex indices; a "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" with vertex holes"},{"type":"text","text":" "},{"type":"text","text":"traps at construction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":", its generation is the base’s, and it reads the base’s attached maps."},{"type":"text","text":" "},{"type":"codeVoice","code":"[map, of: vertex]"},{"type":"text","text":" and "},{"type":"codeVoice","code":"[map, ofEdgeAt: position]"},{"type":"text","text":" trap for a vertex or an edge the view drops,"},{"type":"text","text":" "},{"type":"text","text":"and their "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" forms throw. "},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" is the base’s, by the base’s positions; an"},{"type":"text","text":" "},{"type":"text","text":"algorithm on the view reads it only at the kept edges."}]}]}],"references":{"doc://GraphOperations/documentation/GraphOperations/SubgraphView/DirectedEdges":{"type":"topic","abstract":[{"text":"The edges of a directed ","type":"text"},{"code":"SubgraphView","type":"codeVoice"},{"text":": the kept edges of the base, in its order, at its","type":"text"},{"text":" ","type":"text"},{"text":"positions. Stepping from one to the next skips the dropped ones.","type":"text"}],"title":"SubgraphView.DirectedEdges","url":"\/documentation\/graphoperations\/subgraphview\/directededges","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedEdges","kind":"identifier"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","role":"symbol","navigatorTitle":[{"text":"DirectedEdges","kind":"identifier"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]}},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/UndirectedEdges":{"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges","role":"symbol","title":"SubgraphView.UndirectedEdges","url":"\/documentation\/graphoperations\/subgraphview\/undirectededges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "