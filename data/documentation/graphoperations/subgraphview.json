{"metadata":{"roleHeading":"Structure","modules":[{"name":"GraphOperations"}],"navigatorTitle":[{"kind":"identifier","text":"SubgraphView"}],"remoteSource":{"fileName":"SubgraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/SubgraphView.swift#L29"},"symbolKind":"struct","role":"symbol","title":"SubgraphView","externalID":"s:15GraphOperations12SubgraphViewV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered"},{"type":"text","text":" "},{"type":"text","text":"densely. Made by "},{"code":"inducedSubgraphView(on:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"spanningSubgraphView(edges:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"subgraphView(vertices:edges:)","type":"codeVoice"},{"type":"text","text":" (NetworkX’s "},{"code":"subgraph_view","type":"codeVoice"},{"type":"text","text":", JGraphT’s "},{"code":"AsSubgraph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"SubDigraph","type":"codeVoice"},{"type":"text","text":", Boost’s "},{"code":"filtered_graph","type":"codeVoice"},{"type":"text","text":")."}],"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/BidirectionalDirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedGraph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"type":"text","text":" are the kept vertices in the base’s order, at view indices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"view keeps two arrays, base index to view index and back, so a row is the base’s row filtered"},{"type":"text","text":" "},{"type":"text","text":"and renumbered with one array load per entry and no hashing. A spanning subgraph keeps every"},{"type":"text","text":" "},{"type":"text","text":"vertex at its base index."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edges","type":"text"}],"type":"strong"},{"type":"text","text":" keep the base’s positions, so a weight closure keyed by the base’s positions works"},{"type":"text","text":" "},{"type":"text","text":"on the view. An edge is in the view when both its ends are, and, if an edge set was given,"},{"type":"text","text":" "},{"type":"text","text":"when it is in the set. With an edge set the view has dense edge indices: an edge’s index is its"},{"type":"text","text":" "},{"type":"text","text":"rank among the kept edges in base order. Over a base with edge indices the set is a bit mask"},{"type":"text","text":" "},{"type":"text","text":"with a count per 64-bit word, so the rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices: building"},{"type":"text","text":" "},{"type":"text","text":"its edge mask would cost O(m). One on every vertex keeps the base’s rows, edge indices and flat"},{"type":"text","text":" "},{"type":"text","text":"rows."}]},{"type":"paragraph","inlineContent":[{"text":"The view holds a copy of the base (value semantics), so mutating the original never shows","type":"text"},{"text":" ","type":"text"},{"text":"through. Phase 1 needs a base with vertex indices; a ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" with vertex holes","type":"text"},{"text":" ","type":"text"},{"text":"traps at construction.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphoperations\/subgraphview"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView"},"references":{"doc://GraphOperations/documentation/GraphOperations/SubgraphView/EdgeRow":{"abstract":[{"text":"A row of positions (out-, in- or incident edges): the base’s, with the dropped edges","type":"text"},{"text":" ","type":"text"},{"text":"skipped. The index row is stepped in step only when the view drops vertices.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","url":"\/documentation\/graphoperations\/subgraphview\/edgerow","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeRow"}],"type":"topic","title":"SubgraphView.EdgeRow","navigatorTitle":[{"kind":"identifier","text":"EdgeRow"}],"role":"symbol"},"doc://GraphOperations/s16SendableMetatypeP":{"identifier":"doc:\/\/GraphOperations\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://GraphOperations/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/GraphOperations\/s9EscapableP"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directedView"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"kind":"symbol","title":"Graph"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/UndirectedEdges":{"abstract":[{"type":"text","text":"The edges of an undirected "},{"type":"codeVoice","code":"SubgraphView"},{"type":"text","text":": the kept edges of the base, in its order, at"},{"type":"text","text":" "},{"type":"text","text":"its positions."}],"type":"topic","title":"SubgraphView.UndirectedEdges","kind":"symbol","navigatorTitle":[{"text":"UndirectedEdges","kind":"identifier"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges","conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"url":"\/documentation\/graphoperations\/subgraphview\/undirectededges","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdges","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","title":"DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","type":"topic","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/DirectedEdges":{"abstract":[{"type":"text","text":"The edges of a directed "},{"type":"codeVoice","code":"SubgraphView"},{"type":"text","text":": the kept edges of the base, in its order, at its"},{"type":"text","text":" "},{"type":"text","text":"positions. Stepping from one to the next skips the dropped ones."}],"type":"topic","kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}]},"url":"\/documentation\/graphoperations\/subgraphview\/directededges","navigatorTitle":[{"kind":"identifier","text":"DirectedEdges"}],"role":"symbol","title":"SubgraphView.DirectedEdges","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DirectedEdges"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/base":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"base"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Base"}],"type":"topic","role":"symbol","url":"\/documentation\/graphoperations\/subgraphview\/base","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base","abstract":[{"text":"The graph the view filters.","type":"text"}],"kind":"symbol","title":"base"},"doc://GraphOperations/s8SendableP":{"i