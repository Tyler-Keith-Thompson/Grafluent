phOperations/documentation/GraphOperations/SubgraphView/IndexRow":{"abstract":[{"type":"text","text":"A row in index space (successors, predecessors or neighbors): the base’s row with the"},{"type":"text","text":" "},{"type":"text","text":"dropped entries skipped and the rest renumbered. One array load per entry, no hashing."}],"type":"topic","role":"symbol","url":"\/documentation\/graphoperations\/subgraphview\/indexrow","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","navigatorTitle":[{"kind":"identifier","text":"IndexRow"}],"title":"SubgraphView.IndexRow","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IndexRow"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/base":{"title":"base","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"base"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Base"}],"abstract":[{"type":"text","text":"The graph the view filters."}],"kind":"symbol","role":"symbol","url":"\/documentation\/graphoperations\/subgraphview\/base","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base"}}}