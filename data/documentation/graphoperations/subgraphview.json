ype":"text","text":" "},{"type":"text","text":"everything), and walks the base’s position row only under an edge set."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"IndexRow","kind":"identifier"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","url":"\/documentation\/graphoperations\/subgraphview\/indexrow","title":"SubgraphView.IndexRow","type":"topic"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/DirectedEdges":{"abstract":[{"text":"The edges of a directed ","type":"text"},{"type":"codeVoice","code":"SubgraphView"},{"text":": the kept edges of the base, in its order, at its","type":"text"},{"text":" ","type":"text"},{"text":"positions. Stepping from one to the next skips the dropped ones.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedEdges","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedEdges","kind":"identifier"}],"title":"SubgraphView.DirectedEdges","kind":"symbol","type":"topic","url":"\/documentation\/graphoperations\/subgraphview\/directededges","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Base","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":".","type":"text"}]},"role":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges"},"doc://GraphOperations/documentation/GraphOperations":{"type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","title":"GraphOperations","role":"collection","url":"\/documentation\/graphoperations","abstract":[],"kind":"symbol"}}}