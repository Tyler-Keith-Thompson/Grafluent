forward.","type":"text"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"title":"BidirectionalDirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/Graph-Implementations":{"abstract":[],"role":"collectionGroup","kind":"article","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/Graph-Implementations","url":"\/documentation\/graphoperations\/subgraphview\/graph-implementations","title":"Graph Implementations","type":"topic"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/UndirectedEdges":{"navigatorTitle":[{"text":"UndirectedEdges","kind":"identifier"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"UndirectedEdges","kind":"identifier"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges","title":"SubgraphView.UndirectedEdges","role":"symbol","url":"\/documentation\/graphoperations\/subgraphview\/undirectededges","abstract":[{"text":"The edges of an undirected ","type":"text"},{"code":"SubgraphView","type":"codeVoice"},{"text":": the kept edges of the base, in its order, at","type":"text"},{"text":" ","type":"text"},{"text":"its positions.","type":"text"}],"kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/Sub