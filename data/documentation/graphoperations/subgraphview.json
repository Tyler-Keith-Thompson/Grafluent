View","externalID":"s:15GraphOperations12SubgraphViewV"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered","type":"text"},{"text":" ","type":"text"},{"text":"densely. Made by ","type":"text"},{"code":"inducedSubgraph(on:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"spanningSubgraph(edges:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"subgraph(vertices:edges:)","type":"codeVoice"},{"text":" (NetworkX’s ","type":"text"},{"code":"subgraph_view","type":"codeVoice"},{"text":", JGraphT’s ","type":"text"},{"code":"AsSubgraph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"SubDigraph","type":"codeVoice"},{"text":", Boost’s ","type":"text"},{"code":"filtered_graph","type":"codeVoice"},{"text":").","type":"text"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphOperations\/s8CopyableP","doc:\/\/GraphOperations\/s9EscapableP","doc:\/\/GraphOperations\/s8SendableP","doc:\/\/GraphOperations\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/graphoperations\/subgraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertices"}]},{"type":"text","text":" are the kept vertices in the base’s order, at view indices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"view keeps two arrays, base index to view index and back, so a row is the base’s row filtered"},{"type":"text","text":" "},{"type":"text","text":"and renumbered with one array load per entry and no hashing. A spanning subgraph keeps every"},{"type":"text","text":" "},{"type":"text","text":"vertex at its base index."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges"}],"type":"strong"},{"type":"text","text":" keep the base’s positions, so a weight closure keyed by the base’s positions works"},{"type":"text","text":" "},{"type":"text","text":"on the view. An edge is in the view when both its ends are, and, if an edge set was given,"},{"type":"text","text":" "},{"type":"text","text":"when it is in the set. With an edge set the view has dense edge indices: an edge’s index is its"},{"type":"text","text":" "},{"type":"text","text":"rank among the kept edges in base order. Over a base with edge indices the set is a bit mask"},{"type":"text","text":" "},{"type":"text","text":"with a count per 64-bit word, so the rank costs one popcount. Over a base without them (an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyMatrix"},{"type":"text","text":", a complement, an induced subgraph) the set is the sorted kept positions, and"},{"type":"text","text":" "},{"type":"text","text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices: building"},{"type":"text","text":" "},{"type":"text","text":"its edge mask would cost O(m). One on every vertex keeps the base’s rows, edge indices and flat"},{"type":"text","text":" "},{"type":"text","text":"rows."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view holds a copy of the base (value semantics), so mutating the original never shows"},{"type":"text","text":" "},{"type":"text","text":"through. Phase 1 needs a base with vertex indices; a "},{"code":"StableDirectedGraph","type":"codeVoice"},{"type":"text","text":" with vertex holes"},{"type":"text","text":" "},{"type":"text","text":"traps at construction."}]}]}],"references":{"doc://GraphOperations/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/GraphOperations\/s8SendableP"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/DirectedEdges":{"url":"\/documentation\/graphoperations\/subgraphview\/directededges","kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"."}]},"abstract":[{"text":"The edges of a directed ","type":"text"},{"type":"codeVoice","code":"SubgraphView"},{"text":": the kept edges of the base, in its order, at its","type":"text"},{"text":" ","type":"text"},{"text":"positions. Stepping from one to the next skips the dropped ones.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedEdges"}],"role":"symbol","title":"SubgraphView.DirectedEdges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DirectedEdges"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtoco