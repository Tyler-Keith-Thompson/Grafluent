{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations"]]},"identifier":{"url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","interfaceLanguage":"swift"},"sections":[],"metadata":{"title":"SubgraphView","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubgraphView"}],"symbolKind":"struct","externalID":"s:15GraphOperations12SubgraphViewV","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphOperations\/SubgraphView.swift#L31","fileName":"SubgraphView.swift"},"modules":[{"name":"GraphOperations"}],"navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The kept vertices appear in the base’s order at view indices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":". The view keeps","type":"text"},{"text":" ","type":"text"},{"text":"two arrays, base index to view index and back, so a row is the base’s row filtered and","type":"text"},{"text":" ","type":"text"},{"text":"renumbered with one array load per entry. A spanning subgraph keeps every vertex at its base","type":"text"},{"text":" ","type":"text"},{"text":"index.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Edges keep the base’s positions, so a weight closure keyed by the base’s positions works on","type":"text"},{"text":" ","type":"text"},{"text":"the view. An edge is in the view when both its ends are and, if an edge set was given, when it","type":"text"},{"text":" ","type":"text"},{"text":"is in the set. With an edge set the view has dense edge indices, an edge’s index being its rank","type":"text"},{"text":" ","type":"text"},{"text":"among the kept edges in base order. Over a base with edge indices the set is a bit mask with a","type":"text"},{"text":" ","type":"text"},{"text":"count per 64-bit word, and a rank costs one popcount. Over a base without them (an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AdjacencyMatrix"},{"text":", a complement, an induced subgraph) the set is the sorted kept positions, and","type":"text"},{"text":" ","type":"text"},{"text":"a row entry or a rank costs a binary search. An induced subgraph has no edge indices, except one","type":"text"},{"text":" ","type":"text"},{"text":"that keeps every vertex, which keeps the base’s rows and edge indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view holds a copy of the base, so mutating the original doesn’t show through. The base"},{"type":"text","text":" "},{"type":"text","text":"must have vertex indices; construction traps when "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":", its generation is the base’s, and it reads the base’s attached maps."},{"type":"text","text":" "},{"type":"codeVoice","code":"[map, of: vertex]"},{"type":"text","text":" and "},{"type":"codeVoice","code":"[map, ofEdgeAt: position]"},{"type":"text","text":" trap for a vertex or an edge the view drops,"},{"type":"text","text":" "},{"type":"text","text":"and their "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" forms throw. "},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" is the base’s, by the base’s positions. An"},{"type":"text","text":" "},{"type":"text","text":"algorithm on the view reads it only at the kept edges."}]}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/graphoperations\/subgraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered","type":"text"},{"text":" ","type":"text"},{"text":"densely. Made by ","type":"text"},{"type":"codeVoice","code":"inducedSubgraphView(on:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"spanningSubgraphView(edges:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"subgraphView(vertices:edges:)"},{"text":".","type":"text"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/DirectedEdges","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeIndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/EdgeRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/IndexRow","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/UndirectedEdges"],"anchor":"Structures","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/base"],"anchor":"Instance-Properties","generated":true},{"title":"Subscripts","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checked:)-2n5fj","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checked:)-34kf9","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checkedEdgeAt:)-40a5z","doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subscript(_:checkedEdgeAt:)-7