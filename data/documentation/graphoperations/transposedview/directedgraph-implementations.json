{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"collectionGroup","title":"DirectedGraph Implementations","modules":[{"name":"GraphOperations"}],"roleHeading":"API Collection"},"sections":[],"topicSections":[{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/complementView"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/inducedSubgraphView(on:)","doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/spanningSubgraphView(edges:)","doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/subgraphView(vertices:edges:)"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/GraphOperations\/documentation\/GraphOperations","doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView"]]},"variants":[{"paths":["\/documentation\/graphoperations\/transposedview\/directedgraph-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/DirectedGraph-Implementations"},"references":{"doc://GraphOperations/documentation/GraphOperations/TransposedView/complementView":{"role":"symbol","title":"complementView","url":"\/documentation\/graphoperations\/transposedview\/complementview","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complementView"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15GraphOperations14ComplementViewV","kind":"typeIdentifier","text":"ComplementView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"type":"codeVoice","code":"complement"},{"type":"text","text":", igraph’s "},{"type":"codeVoice","code":"complementer"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"loops=False"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/complementView"},"doc://GraphOperations/documentation/GraphOperations/TransposedView/subgraphView(vertices:edges:)":{"abstract":[{"type":"text","text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s "},{"code":"AsSubgraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Mathematica’s "},{"code":"Subgraph","type":"codeVoice"},{"type":"text","text":"): an edge is kept when it is listed and both its ends are kept, so"},{"type":"text","text":" "},{"type":"text","text":"a listed edge with an end outside "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" is dropped. Vertices are numbered as for"},{"type":"text","text":" "},{"code":"inducedSubgraphView(on:)","type":"codeVoice"},{"type":"text","text":", and edge indices as for "},{"code":"spanningSubgraphView(edges:)","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/graphoperations\/transposedview\/subgraphview(vertices:edges:)","role":"symbol","title":"subgraphView(vertices:edges:)","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/subgraphView(vertices:edges:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/TransposedView/inducedSubgraphView(on:)":{"role":"symbol","title":"inducedSubgraphView(on:)","url":"\/documentation\/graphoperations\/transposedview\/inducedsubgraphview(on:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inducedSubgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">) -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The subgraph induced by "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":": those vertices and every edge between them, as a lazy"},{"type":"text","text":" "},{"type":"text","text":"view (igraph’s "},{"code":"induced_subgraph","type":"codeVoice"},{"type":"text","text":", NetworkX’s "},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"type":"text","text":"). The kept vertices are"},{"type":"text","text":" "},{"type":"text","text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept"},{"type":"text","text":" "},{"type":"text","text":"once. The view keeps the graph’s edge positions and has no edge indices."}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/inducedSubgraphView(on:)"},"doc://GraphOperations/documentation/GraphOperations/TransposedView/spanningSubgraphView(edges:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/graphoperations\/transposedview\/spanningsubgraphview(edges:)","abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}],"title":"spanningSubgraphView(edges:)","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/spanningSubgraphView(edges:)"},"doc://GraphOperations/documentation/GraphOperations/TransposedView":{"abstract":[{"type":"text","text":"A bidirectional directed graph with every edge reversed: the converse (or transpose) of its"},{"type":"text","text":" "},{"type":"text","text":"base. Made by "},{"type":"codeVoice","code":"transposedView"},{"type":"text","text":"."}],"title":"TransposedView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransposedView","kind":"identifier"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView","kind":"symbol","type":"topic","url":"\/documentation\/graphoperations\/transposedview","role":"symbol","navigatorTitle":[{"text":"TransposedView","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"title":"GraphOperations","type":"topic","url":"\/documentation\/graphoperations","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","role":"collection"}}}