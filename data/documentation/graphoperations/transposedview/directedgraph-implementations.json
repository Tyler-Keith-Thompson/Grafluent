ViewV","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://GraphOperations/documentation/GraphOperations/TransposedView/complementView":{"role":"symbol","type":"topic","url":"\/documentation\/graphoperations\/transposedview\/complementview","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"complementView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV","text":"ComplementView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/complementView","title":"complementView","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"type":"codeVoice","code":"complement"},{"type":"text","text":", igraph’s "},{"type":"codeVoice","code":"complementer"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"loops=False"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/TransposedView/inducedSubgraphView(on:)":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView\/inducedSubgraphView(on:)","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraphView"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"text":"The subgraph induced by ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":": those vertices and every edge between them, as a lazy","type":"text"},{"text":" ","type":"text"},{"text":"view (igraph’s ","type":"text"},{"code":"induced_subgraph","type":"codeVoice"},{"text":", NetworkX’s ","type":"text"},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"text":"). The kept vertices are","type":"text"},{"text":" ","type":"text"},{"text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept","type":"text"},{"text":" ","type":"text"},{"text":"once. The view keeps the graph’s edge positions and has no edge indices.","type":"text"}],"url":"\/documentation\/graphoperations\/transposedview\/inducedsubgraphview(on:)","role":"symbol","title":"inducedSubgraphView(on:)"}}}