loops=False","type":"codeVoice"},{"text":"). Self-loops and parallel edges of the graph are ignored, so the","type":"text"},{"text":" ","type":"text"},{"text":"complement is simple and loop-free, and the complement of the complement is the graph","type":"text"},{"text":" ","type":"text"},{"text":"made simple and loop-free. O(1); a lazy view.","type":"text"}],"url":"\/documentation\/graphoperations\/transposedview\/complementview"},"doc://GraphOperations/documentation/GraphOperations":{"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","role":"collection","title":"GraphOperations","url":"\/documentation\/graphoperations","abstract":[]},"doc://GraphOperations/documentation/GraphOperations/TransposedView":{"title":"TransposedView","navigatorTitle":[{"text":"TransposedView","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/TransposedView","role":"symbol","abstract":[{"type":"text","text":"A bidirectional directed graph with every edge reversed: the converse (or transpose) of its"},{"type":"text","text":" "},{"type":"text","text":"base. Made by "},{"type":"codeVoice","code":"transposedView"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransposedView","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphoperations\/transposedview"}}}