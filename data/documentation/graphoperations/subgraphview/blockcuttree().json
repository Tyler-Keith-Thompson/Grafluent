"},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraph(vertices:edges:)"},{"type":"text","text":" (NetworkX’s "},{"type":"codeVoice","code":"subgraph_view"},{"type":"text","text":", JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"SubDigraph"},{"type":"text","text":", Boost’s "},{"type":"codeVoice","code":"filtered_graph"},{"type":"text","text":")."}],"title":"SubgraphView","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}],"navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}],"role":"symbol"},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"kind":"symbol","title":"GraphOperations","url":"\/documentation\/graphoperations","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","role":"collection"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/blockCutTree()":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/blockCutTree()","title":"blockCutTree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","url":"\/documentation\/graphoperations\/subgraphview\/blockcuttree()","abstract":[],"type":"topic","role":"symbol"}}}