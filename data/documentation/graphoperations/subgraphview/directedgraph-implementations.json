ypeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"text":"The subgraph induced by ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":": those vertices and every edge between them, as a lazy","type":"text"},{"text":" ","type":"text"},{"text":"view (igraph’s ","type":"text"},{"code":"induced_subgraph","type":"codeVoice"},{"text":", NetworkX’s ","type":"text"},{"code":"G.subgraph(nodes)","type":"codeVoice"},{"text":"). The kept vertices are","type":"text"},{"text":" ","type":"text"},{"text":"numbered in the graph’s order, whatever the listed order; a vertex listed twice is kept","type":"text"},{"text":" ","type":"text"},{"text":"once. The view keeps the graph’s edge positions and has no edge indices.","type":"text"}],"url":"\/documentation\/graphoperations\/subgraphview\/inducedsubgraph(on:)-625bu","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/inducedSubgraph(on:)-625bu","title":"inducedSubgraph(on:)","type":"topic","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/subgraph(vertices:edges:)-68784":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/subgraph(vertices:edges:)-68784","title":"subgraph(vertices:edges:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">, ","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/graphoperations\/subgraphview\/subgraph(vertices:edges:)-68784","abstract":[{"text":"The subgraph with the given vertices and edges, as a lazy view (JGraphT’s ","type":"text"},{"code":"AsSubgraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Mathematica’s ","type":"text"},{"code":"Subgraph","type":"codeVoice"},{"text":"): an edge is kept when it is listed and both its ends are kept, so","type":"text"},{"text":" ","type":"text"},{"text":"a listed edge with an end outside ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is dropped. Vertices are numbered as for","type":"text"},{"text":" ","type":"text"},{"code":"inducedSubgraph(on:)","type":"codeVoice"},{"text":", and edge indices as for ","type":"text"},{"code":"spanningSubgraph(edges:)","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView":{"type":"topic","url":"\/documentation\/graphoperations\/subgraphview","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView","abstract":[{"type":"text","text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered"},{"type":"text","text":" "},{"type":"text","text":"densely. Made by "},{"type":"codeVoice","code":"inducedSubgraph(on:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"spanningSubgraph(edges:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraph(vertices:edges:)"},{"type":"text","text":" (NetworkX’s "},{"type":"codeVoice","code":"subgraph_view"},{"type":"text","text":", JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"SubDigraph"},{"type":"text","text":", Boost’s "},{"type":"codeVoice","code":"filtered_graph"},{"type":"text","text":")."}],"title":"SubgraphView","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}],"navigatorTitle":[{"text":"SubgraphView","kind":"identifier"}],"role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/spanningSubgraph(edges:)-1vjcu":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/spanningSubgraph(edges:)-1vjcu","title":"spanningSubgraph(edges:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spanningSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edges"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","kind":"typeIdentifier","text":"SubgraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/graphoperations\/subgraphview\/spanningsubgraph(edges:)-1vjcu","type":"topic","abstract":[{"type":"text","text":"The spanning subgraph with the edges at "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/complement-7cltx":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/complement-7cltx","title":"complement","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"complement","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ComplementView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"type":"codeVoice","code":"complement"},{"type":"text","text":", igraph’s "},{"type":"codeVoice","code":"complementer"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"loops=False"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"url":"\/documentation\/graphoperations\/subgraphview\/complement-7cltx","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations":{"abstract":[],"kind":"symbol","title":"GraphOperations","url":"\/documentation\/graphoperations","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","role":"collection"}}}