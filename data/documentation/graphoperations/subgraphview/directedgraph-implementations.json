raph(on:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"spanningSubgraph(edges:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraph(vertices:edges:)"},{"type":"text","text":" (NetworkX’s "},{"type":"codeVoice","code":"subgraph_view"},{"type":"text","text":", JGraphT’s "},{"type":"codeVoice","code":"AsSubgraph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"SubDigraph"},{"type":"text","text":", Boost’s "},{"type":"codeVoice","code":"filtered_graph"},{"type":"text","text":")."}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/spanningSubgraph(edges:)-1vjcu":{"title":"spanningSubgraph(edges:)","url":"\/documentation\/graphoperations\/subgraphview\/spanningsubgraph(edges:)-1vjcu","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:15GraphOperations12SubgraphViewV","text":"SubgraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/spanningSubgraph(edges:)-1vjcu","type":"topic","abstract":[{"text":"The spanning subgraph with the edges at ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":": every vertex, at its own index, and only","type":"text"},{"text":" ","type":"text"},{"text":"those edges, as a lazy view (igraph’s ","type":"text"},{"code":"subgraph_edges(delete_vertices=False)","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"FilterArcs","type":"codeVoice"},{"text":"). A position listed twice is kept once. The view has dense edge indices, each","type":"text"},{"text":" ","type":"text"},{"text":"edge’s rank among the kept edges in the graph’s order.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/complement-7cltx":{"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/complement-7cltx","url":"\/documentation\/graphoperations\/subgraphview\/complement-7cltx","kind":"symbol","role":"symbol","title":"complement","abstract":[{"type":"text","text":"The complement: the same vertices, and an edge u→v for every ordered pair of distinct"},{"type":"text","text":" "},{"type":"text","text":"vertices that the graph does not join (NetworkX’s "},{"code":"complement","type":"codeVoice"},{"type":"text","text":", igraph’s "},{"code":"complementer","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"with "},{"code":"loops=False","type":"codeVoice"},{"type":"text","text":"). Self-loops and parallel edges of the graph are ignored, so the"},{"type":"text","text":" "},{"type":"text","text":"complement is simple and loop-free, and the complement of the complement is the graph"},{"type":"text","text":" "},{"type":"text","text":"made simple and loop-free. O(1); a lazy view."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"complement","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ComplementView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations14ComplementViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/inducedSubgraph(on:)-625bu":{"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inducedSubgraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","tex