":"text","text":": every vertex, at its own index, and only"},{"type":"text","text":" "},{"type":"text","text":"those edges, as a lazy view (igraph’s "},{"type":"codeVoice","code":"subgraph_edges(delete_vertices=False)"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"FilterArcs"},{"type":"text","text":"). A position listed twice is kept once. The view has dense edge indices, each"},{"type":"text","text":" "},{"type":"text","text":"edge’s rank among the kept edges in the graph’s order."}],"type":"topic","title":"spanningSubgraphView(edges:)","kind":"symbol","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/spanningSubgraphView(edges:)-1j3ea","url":"\/documentation\/graphoperations\/subgraphview\/spanningsubgraphview(edges:)-1j3ea","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningSubgraphView","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"SubgraphView","kind":"typeIdentifier","preciseIdentifier":"s:15GraphOperations12SubgraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView":{"abstract":[{"text":"A subgraph of a graph, as a lazy view: some of its vertices and some of its edges, renumbered","type":"text"},{"text":" ","type":"text"},{"text":"densely. Made by ","type":"text"},{"type":"codeVoice","code":"inducedSubgraphView(on:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"spanningSubgraphView(edges:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraphView(vertices:edges:)"},{"type":"text","text":" (NetworkX’s "},{"type":"codeVoi