d":"identifier"}],"abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations":{"type":"topic","abstract":[],"title":"GraphOperations","role":"collection","kind":"symbol","url":"\/documentation\/graphoperations","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations"}}}