phView"]]},"kind":"symbol","references":{"doc://GraphOperations/documentation/GraphOperations/SubgraphView/kComponents()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/kComponents()","title":"kComponents()","abstract":[],"role":"symbol","type":"topic","url":"\/documentation\/graphoperations\/subgraphview\/kcomponents()","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations":{"title":"GraphOperations","role":"collection","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","abstract":[],"kind":"symbol","url":"\/documentation\/graphoperations","type":"topic"},"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"type":"topic","abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"navigatorTitle":[{"kind":"identifier","text"