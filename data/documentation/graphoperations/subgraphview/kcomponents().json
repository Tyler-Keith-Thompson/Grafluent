(on:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"spanningSubgraphView(edges:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraphView(vertices:edges:)"},{"type":"text","text":"."}],"title":"SubgraphView","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubgraphView","kind":"identifier"}],"url":"\/documentation\/graphoperations\/subgraphview","kind":"symbol"},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/kComponents()":{"title":"kComponents()","type":"topic","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/kComponents()","abstract":[],"url":"\/documentation\/graphoperations\/subgraphview\/kcomponents()","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]}}}