omponents are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"KComponents","kind":"identifier"}]},"doc://GraphOperations/documentation/GraphOperations/SubgraphView/kComponents()":{"url":"\/documentation\/graphoperations\/subgraphview\/kcomponents()","title":"kComponents()","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/kComponents()","kind":"symbol","type":"topic","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]}}}