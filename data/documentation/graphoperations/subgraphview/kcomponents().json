rfaceLanguage":"swift"}]}],"references":{"doc://GraphOperations/documentation/GraphOperations/SubgraphView/kComponents()":{"abstract":[],"identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations\/SubgraphView\/kComponents()","type":"topic","url":"\/documentation\/graphoperations\/subgraphview\/kcomponents()","role":"symbol","title":"kComponents()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://GraphOperations/documentation/GraphOperations":{"role":"collection","kind":"symbol","title":"GraphOperations","url":"\/documentation\/graphoperations","identifier":"doc:\/\/GraphOperations\/documentation\/GraphOperations","type":"topic","abstract":[]},"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"url":"\/documentation\/connectivity\/kcomponents","type":"topic","title":"KComponents","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"tex