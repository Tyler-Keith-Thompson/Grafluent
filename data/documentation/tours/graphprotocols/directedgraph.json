ype":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"code":"Circuit","type":"codeVoice"},{"text":" has at least one). Pinned: from the current vertex the first unused edge in","type":"text"},{"text":" ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" order, in the stack form igraph’s ","type":"text"},{"code":"igraph_eulerian_cycle","type":"codeVoice"},{"text":" runs; the circuit is","type":"text"},{"text":" ","type":"text"},{"text":"listed forward from that vertex. On a compressed sparse row the graph’s own rows are read.","type":"text"}]},"doc://Tours/documentation/Tours":{"url":"\/documentation\/tours","type":"topic","role":"collection","abstract":[],"title":"Tours","identifier":"doc:\/\/Tours\/documentation\/Tours","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols":{"role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","kind":"symbol","type":"topic","abstract":[]}}}