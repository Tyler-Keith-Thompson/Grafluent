e":"text"},{"text":" ","type":"text"},{"text":"True for every edgeless graph.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit()":{"title":"eulerianCircuit()","role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks7CircuitV","kind":"typeIdentifier","text":"Circuit"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first"},{"type":"text","tex