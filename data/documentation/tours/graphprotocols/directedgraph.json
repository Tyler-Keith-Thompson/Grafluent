rom the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, in the stack form igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is"},{"type":"text","text":" "},{"type":"text","text":"listed forward from that vertex. On a compressed sparse row the graph’s own rows are read."}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"role":"symbol","abstract":[{"type":"text","text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same"},{"type":"text","text":" "},{"type":"text","text":"Held–Karp program as "},{"code":"Graph.shortestTour(weight:)","type":"codeVoice"},{"type":"text","text":" (JGraphT "},{"code":"HeldKarpTSP","type":"codeVoice"},{"text":" on a directed","type":"text"},{"text":" ","type":"text"},{"text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc","type":"text"},{"text":" ","type":"text"},{"text":"from one vertex to the next, or nil when there is none; among the optimal ones, the","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically least by vertex number listed from the first vertex. Self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on","type":"text"},{"text":" ","type":"text"},{"text":"ties), which is the edge the returned ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" uses, so ","type":"text"},{"code":"cycle.weight(weight)","type":"codeVoice"},{"text":" is the tour’s","type":"text"},{"text":" ","type":"text"},{"text":"length. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order. nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices, as on ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" (an antiparallel pair is a ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":", but not a tour here).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"title":"shortestTour(weight:)","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","abstract":[{"text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first","type":"text"},{"text":" ","type":"text"},{"text":"backtracking search finds, from each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, extending through each","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" in order to an unvisited vertex (Mathematica ","type":"text"},{"code":"FindHamiltonianPath","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no","type":"text"},{"text":" ","type":"text"},{"text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or","type":"text"},{"text":" ","type":"text"},{"text":"successor), so it keeps the order. Without a start the search is run again from each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches.","type":"text"}],"kind":"symbol","role":"symbol","title":"hamiltonianPath()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianCycle()":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianCycle()","title":"hamiltonianCycle()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"A Hamiltonian cycle, or nil (Mathematica "},{"code":"FindHamiltonianCycle","type":"codeVoice"},{"type":"text","text":"): the search from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, closed by the first edge of the last vertex’s row back to it. A self-loop is the"},{"type":"text","text":" "},{"type":"text","text":"cycle of a one-vertex graph and an antiparallel pair the cycle of a two-vertex one (the"},{"type":"text","text":" "},{"code":"Cycle","type":"codeVoice"},{"type":"text","text":" type’s rules)."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltoniancycle()","kind":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"url":"\/documentation\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges betwe