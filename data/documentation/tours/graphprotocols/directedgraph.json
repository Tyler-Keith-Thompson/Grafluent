es","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","title":"hamiltonianPath()","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","type":"topic","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"text":"vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" in order to an unvisited vertex (Mathematica ","type":"text"},{"code":"FindHamiltonianPath","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no","type":"text"},{"text":" ","type":"text"},{"text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or","type":"text"},{"text":" ","type":"text"},{"text":"successor), so it keeps the order. Without a start the search is run again from each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail()":{"abstract":[{"text":"An Eulerian trail (NetworkX ","type":"text"},{"code":"eulerian_path","type":"codeVoice"},{"text":", igraph ","type":"text"},{"code":"igraph_eulerian_path","type":"codeVoice"},{"text":"), or nil when","type":"text"},{"text":" ","type":"text"},{"text":"there is none or the graph has no vertex. It starts at the vertex with out − in = 1, or,","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is Eulerian, at the first vertex with an edge (the circuit as a closed","type":"text"},{"text":" ","type":"text"},{"text":"trail); it is the trivial trail at the first vertex when there are no edges. Hierholzer’s","type":"text"},{"text":" ","type":"text"},{"text":"walk, as ","type":"text"},{"code":"eulerianCircuit()","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5TrailV","text":"Trail","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail()","title":"eulerianTrail()","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit(from:)":{"abstract":[{"text":"The Eulerian circuit from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" (NetworkX ","type":"text"},{"code":"eulerian_circuit(G, source=)","type":"codeVoice"},{"text":"): the same","type":"text"},{"text":" ","type":"text"},{"text":"walk; nil also when ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" has no edges.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":