mentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail()","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail(from:)","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianCycle()","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:)","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:to:)","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)"]}],"references":{"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","title":"shortestTour(weight:)","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same"},{"type":"text","text":" "},{"type":"text","text":"Held–Karp program as "},{"type":"codeVoice","code":"Graph.shortestTour(weight:)"},{"type":"text","text":" (JGraphT "},{"type":"codeVoice","code":"HeldKarpTSP"},{"type":"text","text":" on a directed"},{"type":"text","text":" "},{"type":"text","text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc"},{"type":"text","text":" "},{"type":"text","text":"from one vertex to the next, or nil when there is none; among the optimal ones, the"},{"type":"text","text":" "},{"type":"text","text":"lexicographically least by vertex number listed from the first vertex. Self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on"},{"type":"text","text":" "},{"type":"text","text":"ties), which is the edge the returned "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" uses, so "},{"type":"codeVoice","code":"cycle.weight(weight)"},{"type":"text","text":" is the tour’s"},{"type":"text","text":" "},{"type":"text","text":"length. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per non-loop edge, in position order. nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices, as on "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" (an antiparallel pair is a "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":", but not a tour here)."}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit(from:)":{"url":"\/documentation\/tours\/graphprotocols\/