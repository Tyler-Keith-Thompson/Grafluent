"code":"eulerian_path"},{"text":", igraph ","type":"text"},{"type":"codeVoice","code":"igraph_eulerian_path"},{"text":"), or nil when","type":"text"},{"text":" ","type":"text"},{"text":"there is none or the graph has no vertex. It starts at the vertex with out − in = 1, or,","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is Eulerian, at the first vertex with an edge (the circuit as a closed","type":"text"},{"text":" ","type":"text"},{"text":"trail); it is the trivial trail at the first vertex when there are no edges. Hierholzer’s","type":"text"},{"text":" ","type":"text"},{"text":"walk, as ","type":"text"},{"type":"codeVoice","code":"eulerianCircuit()"},{"text":".","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Trail","preciseIdentifier":"s:5Walks5TrailV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail()","role":"symbol","title":"eulerianTrail()"},"doc://Tours/documentation/Tours/GraphProtocols":{"abstract":[],"role":"collection","type":"topic","title":"GraphProtocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","url":"\/documentation\/tours\/graphprotocols","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","abstract":[{"text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same","type":"text"},{"text":" ","type":"text"},{"text":"Held–Karp program as ","type":"text"},{"code":"Graph.shortestTour(weight:)","type":"codeVoice"},{"text":" (JGraphT ","type":"text"},{"code":"HeldKarpTSP","type":"codeVoice"},{"text":" on a directed","type":"text"},{"text":" ","type":"text"},{"text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc","type":"text"},{"text":" ","type":"text"},{"text":"from one vertex to the next, or nil when there is none; among the optimal ones, the","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically least by vertex number listed from the first vertex. Self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on","type":"text"},{"text":" ","type":"text"},{"text":"ties), which is the edge the returned ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" uses, so ","type":"text"},{"code":"cycle.weight(weight)","type":"codeVoice"},{"text":" is the tour’s","type":"text"},{"text":" ","type":"text"},{"text":"length. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order. nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices, as on ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" (an antiparallel pair is a ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":", but not a tour here).","type":"text"}],"title":"shortestTour(weight:)","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","kind":"symbol"}}}