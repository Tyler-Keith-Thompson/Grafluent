alk takes the first unused","type":"text"},{"text":" ","type":"text"},{"text":"edge in ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" order, in the stack form of the algorithm; the circuit is listed forward","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex. On a compressed sparse row the graph’s own rows are read.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks7CircuitV","kind":"typeIdentifier","text":"Circuit"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()","kind":"symbol","title":"eulerianCircuit()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"abstract":[{"text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same","type":"text"},{"text":" ","type":"text"},{"text":"Held–Karp program as ","type":"text"},{"code":"Graph.shortestTour(weight:)","type":"codeVoice"},{"text":": the least-weight Hamiltonian cycle of the simple digraph, each step along an arc","type":"text"},{"text":" ","type":"text"},{"text":"from one vertex to the next, or nil when there is none; among the optimal ones, the","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically least by vertex number listed from the first vertex. Self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on","type":"text"},{"text":" ","type":"text"},{"text":"ties), which is the edge the returned ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" uses, so ","type":"text"},{"code":"cycle.weight(weight)","type":"codeVoice"},{"text":" is the tour’s","type":"text"},{"text":" ","type":"text"},{"text":"length. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order. nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices, as on ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" (an antiparallel pair is a ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":", but not a tour here).","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","type":"topic","title":"shortestTour(weight:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentif