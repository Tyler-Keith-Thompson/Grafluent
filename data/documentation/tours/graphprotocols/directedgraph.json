xt":"edge in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, in the stack form of the algorithm; the circuit is listed forward"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex. On a compressed sparse row the graph’s own rows are read."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()","title":"eulerianCircuit()","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","abstract":[{"type":"text","text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same"},{"type":"text","text":" "},{"type":"text","text":"Held–Karp program as "},{"code":"Graph.shortestTour(weight:)","type":"codeVoice"},{"type":"text","text":": the least-weight Hamiltonian cycle of the simple digraph, each step along an arc"},{"type":"text","text"