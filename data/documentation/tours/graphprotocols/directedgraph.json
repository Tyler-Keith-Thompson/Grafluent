","text":" "},{"type":"text","text":"when the graph is Eulerian, at the first vertex with an edge (the circuit as a closed"},{"type":"text","text":" "},{"type":"text","text":"trail); it is the trivial trail at the first vertex when there are no edges. Hierholzer’s"},{"type":"text","text":" "},{"type":"text","text":"walk, as "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":"."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail()","kind":"symbol","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph","role":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph","abstract":[],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"title":"DirectedGraph"},"doc://Tours/documentation/Tours":{"url":"\/documentation\/tours","identifier":"doc:\/\/Tours\/documentation\/Tours","role":"collection","abstract":[],"type":"topic","title":"Tours","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"url":"\/documentation\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","title":"DirectedGraph","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Path","kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:)","role":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:)","type":"topic","abstract":[{"type":"text","text":"The first Hamiltonian path from "},{"type":"codeVoice","code":"start"},{"type":"text","text":", in the same search order."}],"title":"hamiltonianPath(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","role":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","abstract":[{"text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first","type":"text"},{"text":" ","type":"text"},{"text":"backtracking search finds, from each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, extending through each","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" in order to an unvisited vertex (Mathematica ","type":"text"},{"code":"FindHamiltonianPath","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no","type":"text"},{"text":" ","type":"text"},{"text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or","type":"text"},{"text":" ","type":"text"},{"text":"successor), so it keeps the order. Without a start the search is run again from each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches.","type":"text"}],"type":"topic","title":"hamiltonianPath()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hasEulerianTrail":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hasEulerianTrail","role":"symbol","abstract":[{"type":"text","text":"Whether some trail uses every edge exactly once (NetworkX "},{"code":"has_eulerian_path","type":"codeVoice"},{"type":"text","text":", igraph’s"},{"type":"text","text":" "},{"code":"has_path","type":"codeVoice"},{"type":"text","text":"): the graph is Eulerian, or exactly one vertex has out − in = 1, one has"},{"type":"text","text":" "},{"type":"text","text":"in − out = 1, the rest are balanced, and the vertices with edges are weakly connected."},{"type":"text","text":" "},{"type":"text","text":"True for every edgeless graph."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","title":"hasEulerianTrail","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/haseuleriantrail"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","title":"isEulerian","abstract":[{"type":"text","text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in"},{"type":"text","text":" "},{"type":"text","text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected"},{"type":"text","text":" "},{"type":"text","text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored (igraph’s"},{"type":"text","text":" "},{"type":"text","text":"and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty graph"},{"type":"text","text":" "},{"type":"text","text":"included, is Eulerian (igraph "},{"type":"codeVoice","code":"igraph_is_eulerian"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"has_cycle"},{"type":"text","text":")."}],"kind":"symbol","u