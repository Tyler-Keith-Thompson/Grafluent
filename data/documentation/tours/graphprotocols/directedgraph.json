ectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"abstract":[{"text":"A Hamiltonian cycle, or nil: the search from the first vertex, closed by the first edge of","type":"text"},{"text":" ","type":"text"},{"text":"the last vertex’s row back to it. A self-loop is the","type":"text"},{"text":" ","type":"text"},{"text":"cycle of a one-vertex graph and an antiparallel pair the cycle of a two-vertex one (the","type":"text"},{"text":" ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" type’s rules).","type":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph":{"abstract":[],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph","kind":"symbol","title":"DirectedGraph"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:to:)":{"abstract":[{"type":"text","text":"The first Hamiltonian path from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" that ends at "},{"type":"codeVoice","code":"end"},{"type":"text","text":"; nil when "},{"type":"codeVoice","code":"start == end"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"there is more than one vertex."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:to:)","role":"symbol","fragments":[{"kind":"keyw