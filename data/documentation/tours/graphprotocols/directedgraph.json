"},{"text":" ","type":"text"},{"text":"from one vertex to the next, or nil when there is none; among the optimal ones, the","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically least by vertex number listed from the first vertex. Self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on","type":"text"},{"text":" ","type":"text"},{"text":"ties), which is the edge the returned ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" uses, so ","type":"text"},{"code":"cycle.weight(weight)","type":"codeVoice"},{"text":" is the tour’s","type":"text"},{"text":" ","type":"text"},{"text":"length. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order. nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices, as on ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" (an antiparallel pair is a ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":", but not a tour here).","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","role":"symbol","title":"shortestTour(weight:)","type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"