ertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, in the stack form igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is"},{"type":"text","text":" "},{"type":"text","text":"listed forward from that vertex. On a compressed sparse row the graph’s own rows are read."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()","type":"topic","title":"eulerianCircuit()","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"text":"vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" in order to an unvisited vertex (Mathematica ","type":"text"},{"code":"FindHamiltonianPath","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no","type":"text"},{"text":" ","type":"text"},{"text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or","type":"text"},{"text":" ","type":"text"},{"text":"successor), so it keeps the order. Without a start the search is run again from each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches.","type":"text"}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","title":"hamiltonianPath()","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in"},{"type":"text","text":" "},{"type":"text","text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected"},{"type":"text","text":" "},{"type":"text","text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored (igraph’s"},{"type":"text","text":" "},{"type":"text","text":"and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty graph"},{"type":"text","text":" "},{"type":"text","text":"included, is Eulerian (igraph "},{"code":"igraph_is_eulerian","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"has_cycle","type":"codeVoice"},{"type":"text","text":")."}],"type":"topic","identifier":"doc:\/\/Tours\/documentatio