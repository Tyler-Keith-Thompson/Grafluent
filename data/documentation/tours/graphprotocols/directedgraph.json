ges"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, in the stack form igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is"},{"type":"text","text":" "},{"type":"text","text":"listed forward from that vertex. On a compressed sparse row the graph’s own rows are read."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()"}}}