 "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","abstract":[],"type":"topic","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEulerian","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in","type":"text"},{"text":" ","type":"text"},{"text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected","type":"text"},{"text":" ","type":"text"},{"text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored (igraph’s","type":"text"},{"text":" ","type":"text"},{"text":"and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty graph","type":"text"},{"text":" ","type":"text"},{"text":"included, is Eulerian (igraph ","type":"text"},{"code":"igraph_is_eulerian","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"has_cycle","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","title":"isEulerian"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol","title":"DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hasEulerianTrail":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hasEulerianTrail","kind":"symbol","title":"hasEulerianTrail","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/haseuleriantrail","abstract":[{"text":"Whether some trail uses every edge exactly once (NetworkX ","type":"text"},{"type":"codeVoice","code":"has_eulerian_path"},{"text":", igraph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"has_path"},{"text":"): the graph is Eulerian, or exactly one vertex has out − in = 1, one has","type":"text"},{"text":" ","type":"text"},{"text":"in − out = 1, the rest are balanced, and the vertices with edges are weakly connected.","type":"text"},{"text":" ","type":"text"},{"text":"True for every edgeless graph.","type":"text"}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit(from:)":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit(from:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Circuit","preciseIdentifier":"s:5Walks7CircuitV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"title":"eulerianCircuit(from:)","abstract":[{"text":"The Eulerian circuit from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" (NetworkX ","type":"text"},{"code":"eulerian_circuit(G, source=)","type":"codeVoice"},{"text":"): the same","type":"text"},{"text":" ","type":"text"},{"text":"walk; nil also when ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" has no edges.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit(from:)","role":"symbol","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"abstract":[{"text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same","type":"text"},{"text":" ","type":"text"},{"text":"Held–Karp program as ","type":"text"},{"code":"Graph.shortestTour(weight:)","type":"codeVoice"},{"text":" (JGraphT ","type":"text"},{"code":"HeldKarpTSP","type":"codeVoice"},{"text":" on a directed","type":"text"},{"text":" ","type":"text"},{"text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc","type":"text"},{"text":" ","type":"text"},{"text":"from one vertex to the next, or nil when there is none; among the optimal ones, the","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically least by vertex number listed from the first vertex. Self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on","type":"text"},{"text":" ","type":"text"},{"text":"ties), which is the edge the returned ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" uses, so ","type":"text"},{"code":"cycle.weight(weight)","type":"codeVoice"},{"text":" is the tour’s","type":"text"},{"text":" ","type":"text"},{"text":"length. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order. nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices, as on ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" (an antiparallel pair is a ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":", but not a tour here).","type":"text"}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","title":"shortestTour(weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail(from:)":{"abstract":[{"type":"text","text":"An Eulerian trail from "},{"type":"codeVoice","code":"start"},{"type":"text","text":", or nil when none starts there (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"has_eulerian_path(G, source)"},{"type":"text","text":"): "},{"code":"start","type":"codeVoice"},{"type":"text","text":" must be the vertex with out − in = 1, or, in an"},{"type":"text","text":" "},{"type":"text","text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail(from:)","type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail(from:)","title":"eulerianTrail(from:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Trail","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5