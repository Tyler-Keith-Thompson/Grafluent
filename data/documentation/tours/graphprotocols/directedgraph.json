\/Tours\/GraphProtocols\/DirectedGraph","type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph","title":"DirectedGraph","kind":"symbol","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianCycle()":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltoniancycle()","type":"topic","role":"symbol","abstract":[{"text":"A Hamiltonian cycle, or nil (Mathematica ","type":"text"},{"type":"codeVoice","code":"FindHamiltonianCycle"},{"text":"): the search from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex, closed by the first edge of the last vertex’s row back to it. A self-loop is the","type":"text"},{"text":" ","type":"text"},{"text":"cycle of a one-vertex graph and an antiparallel pair the cycle of a two-vertex one (the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Cycle"},{"text":" type’s rules).","type":"text"}],"title":"hamiltonianCycle()","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianCycle()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"abstract":[{"type":"text","text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in"},{"type":"text","text":" "},{"type":"text","text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected"},{"type":"text","text":" "},{"type":"text","text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored (igraph’s"},{"type":"text","text":" "},{"type":"text","text":"and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty graph"},{"type":"text","text":" "},{"type":"text","text":"included, is Eulerian (igraph "},{"type":"codeVoice","code":"igraph_is_eulerian"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"has_cycle"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","title":"isEulerian","kind":"symbol","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:)":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:)","type":"topic","role":"symbol","abstract":[{"text":"The first Hamiltonian path from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":", in the same search order.","type":"text"}],"title":"hamiltonianPath(from:)","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no"},{"type":"text","text":" "},{"type":"text","text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or"},{"type":"text","text":" "},{"type":"text","text":"successor), so it keeps the order. Without a start the search is run again from each"},{"type":"text","text":" "},{"type":"text","text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","title":"hamiltonianPath()","kind":"symbol","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail(from:)":{"abstract":[{"text":"An Eulerian trail from ","type":"text"},{"type":"codeVoice","code":"start"},{"text":", or nil when none starts there (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"has_eulerian_path(G, source)"},{"text":"): ","type":"text"},{"type":"codeVoice","code":"start"},{"text":" must be the vertex with out − in = 1, or, in an","type":"text"},{"text":" ","type":"text"},{"text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5TrailV","kind":"typeIdentifi