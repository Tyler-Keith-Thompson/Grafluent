ole":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"hasEulerianTrail","abstract":[{"type":"text","text":"Whether some trail uses every edge exactly once (NetworkX "},{"code":"has_eulerian_path","type":"codeVoice"},{"type":"text","text":", igraph’s"},{"type":"text","text":" "},{"code":"has_path","type":"codeVoice"},{"type":"text","text":"): the graph is Eulerian, or exactly one vertex has out − in = 1, one has"},{"type":"text","text":" "},{"type":"text","text":"in − out = 1, the rest are balanced, and the vertices with edges are weakly connected."},{"type":"text","text":" "},{"type":"text","text":"True for every edgeless graph."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/haseuleriantrail","type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hasEulerianTrail"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:)":{"abstract":[{"text":"The first Hamiltonian path from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":", in the same search order.","type":"text"}],"title":"hamiltonianPath(from:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"