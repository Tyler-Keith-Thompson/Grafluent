phProtocols/DirectedGraph":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","kind":"symbol","role":"symbol","abstract":[{"text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in","type":"text"},{"text":" ","type":"text"},{"text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected","type":"text"},{"text":" ","type":"text"},{"text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored, and an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless graph, the empty graph included, is Eulerian.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","type":"topic","title":"isEulerian"}}}