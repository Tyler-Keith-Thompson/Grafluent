de":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no"},{"type":"text","text":" "},{"type":"text","text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or"},{"type":"text","text":" "},{"type":"text","text":"successor), so it keeps the order. Without a start the search is run again from each"},{"type":"text","text":" "},{"type":"text","text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches."}],"role":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","title":"hamiltonianPath()","type":"topic","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"title":"shortestTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","role":"symbol","type":"topic","abstract":[{"text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same","type":"text"},{"text":" ","type":"text"},{"text":"Held–Karp program as ","type":"text"},{"type":"codeVoice","code":"Graph.shortestTour(weight:)"},{"text":" (JGraphT ","type":"text"},{"type":"codeVoice","code":"HeldKarpTSP"},{"text":" on a directed","type":"text"},{"text":" ","type":"text"},{"text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc","type":"text"},{"text":" ","type":"text"},{"text":"from one vertex to the next, or nil when there is none; among the optimal ones, the","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically least by vertex number listed from the first vertex. Self-loops are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on"},{"type":"text","text":" "},{"type":"text","text":"ties), which is the edge the returned "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" uses, so "},{"type":"codeVoice","code":"cycle.weight(weight)"},{"text":" is the tour’s","type":"text"},{"text":" ","type":"text"},{"text":"length. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order. nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices, as on ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" (an antiparallel pair is a ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":", but not a tour here).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","kind":"symbol"}}}