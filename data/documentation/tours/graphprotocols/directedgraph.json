oc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","title":"DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"url":"\/documentation\/graphprotocols\/directedgraph"},"doc://Tours/documentation/Tours/GraphProtocols":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","type":"topic","kind":"symbol","title":"GraphProtocols","role":"collection","abstract":[],"url":"\/documentation\/tours\/graphprotocols"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianCycle()":{"title":"hamiltonianCycle()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltoniancycle()","kind":"symbol","abstract":[{"text":"A Hamiltonian cycle, or nil: the search from the first vertex, closed by the first edge of","type":"text"},{"text":" ","type":"text"},{"text":"the last vertex’s row back to it. A self-loop is the","type":"text"},{"text":" ","type":"text"},{"text":"cycle of a one-vertex graph and an antiparallel pair the cycle of a two-vertex one (the","type":"text"},{"text":" ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" type’s rules).","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianCycle()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"kind":"symbol","title":"hamiltonianPath()","role":"symbol","abstract":[{"text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first","type":"text"},{"text":" ","type":"text"},{"text":"backtracking search finds, from each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, extending through each","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" in order to an unvisited vertex. Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no","type":"text"},{"text":" ","type":"text"},{"text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or","type":"text"},{"text":" ","type":"text"},{"text":"successor), so it keeps the order. Without a start the search is run again from each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"kind":"symbol","title":"DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol","abstract":[],"url":"\/documentation\/tours\/graphprotocols\/directedgraph"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail()":{"title":"eulerianTrail()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Trail","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5TrailV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail()","kind":"symbol","abstract":[{"type":"text","text":"An Eulerian trail, or nil when there is none or the graph has no vertex. It starts at the"},{"type":"text","text":" "},{"type":"text","text":"vertex with out − in = 1, or, when the graph is Eulerian, at the first vertex with an edge"},{"type":"text","text":" "},{"type":"text","text":"(the circuit as a closed trail); it is the trivial trail at the first vertex when there are"},{"type":"text","text":" "},{"type":"text","text":"no edges. Hierholzer’s walk, as "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":"."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit()":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"kind":"symbol","title":"eulerianCircuit()","role":"symbol","abstract":[{"text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order with an edge; nil when the graph is not Eulerian or has no edges","type":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"code":"Circuit","type":"codeVoice"},{"text":" has at least one). From the current vertex the walk takes the first unused","type":"text"},{"text":" ","type":"text"},{"text":"edge in ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" order, in the stack form of the algorithm; the circuit is listed forward","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex. On a compressed sparse row the graph’s own rows are read.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit(from:)":{"title":"eulerianCircuit(from:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"eulerianCircuit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Circuit","kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit(from:)","kind":"symbol","abstract":[{"type":"text","text":"The Eulerian circuit from "},{"code":"start","type":"codeVoice"},{"type":"text","text":": the same walk; nil also when "},{"code":"start","type":"codeVoice"},{"type":"text","text":" has no edges."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"kind":"symbol","role":"symbol","title":"isEulerian","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","abstract":[{"text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in","type":"text"},{"text":" ","type":"text"},{"text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected","type":"text"},{"text":" ","type":"text"},{"text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored, and an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless graph, the empty graph included, is Eulerian.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]}}}