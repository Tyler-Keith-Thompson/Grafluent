hable, or left without a usable predecessor or","type":"text"},{"text":" ","type":"text"},{"text":"successor), so it keeps the order. Without a start the search is run again from each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches.","type":"text"}],"title":"hamiltonianPath()","role":"symbol","type":"topic"},"doc://Tours/documentation/Tours":{"abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours","url":"\/documentation\/tours","role":"collection","title":"Tours"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","kind":"symbol","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"url":"\/documentation\/graphprotocols\/directedgraph"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail()":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5TrailV","text":"Trail","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","abstract":[{"text":"An Eulerian trail (NetworkX ","type":"text"},{"type":"codeVoice","code":"eulerian_path"},{"text":", igraph ","type":"text"},{"type":"codeVoice","code":"igraph_eulerian_path"},{"text":"), or nil when","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"there is none or the graph has no vertex. It starts at the vertex with out − in = 1, or,"},{"type":"text","text":" "},{"type":"text","text":"when the graph is Eulerian, at the first vertex with an edge (the circuit as a closed"},{"type":"text","text":" "},{"type":"text","text":"trail); it is the trivial trail at the first vertex when there are no edges. Hierholzer’s"},{"type":"text","text":" "},{"type":"text","text":"walk, as "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":"."}],"title":"eulerianTrail()","role":"symbol","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"abstract":[{"text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same","type":"text"},{"text":" ","type":"text"},{"text":"Held–Karp program as ","type":"text"},{"type":"codeVoice","code":"Graph.shortestTour(weight:)"},{"text":" (JGraphT ","type":"text"},{"type":"codeVoice","code":"HeldKarpTSP"},{"type":"text","text":" on a directed"},{"type":"text","text":" "},{"type":"text","text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc"},{"type":"text","text":" "},{"type":"text","text":"from one vertex to the next, or nil when there is none; among the optimal ones, the"},{"type":"text","text":" "},{"type":"text","text":"lexicographically least by vertex number listed from the first vertex. Self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on"},{"type":"text","text":" "},{"type":"text","text":"ties), which is the edge the returned "},{"code":"Cycle","type":"codeVoice"},{"type":"text","text":" uses, so "},{"code":"cycle.weight(weight)","type":"codeVoice"},{"type":"text","text":" is the tour’s"},{"type":"text","text":" "},{"type":"text","text":"length. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per non-loop edge, in position order. nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices, as on "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" (an antiparallel pair is a "},{"code":"Cycle","type":"codeVoice"},{"type":"text","text":", but not a tour here)."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex