ce)"},{"text":"): ","type":"text"},{"type":"codeVoice","code":"start"},{"text":" must be the vertex with out − in = 1, or, in an","type":"text"},{"text":" ","type":"text"},{"text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges.","type":"text"}],"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail(from:)","title":"eulerianTrail(from:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail(from:)","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"title":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/graphprotocols\/directedgraph"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEulerian","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","abstract":[{"type":"text","text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in"},{"type":"text","text":" "},{"type":"text","text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected"},{"type":"text","text":" "},{"type":"text","text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored (igraph’s"},{"type":"text","text":" "},{"type":"text","text":"and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty graph"},{"type":"text","text":" "},{"type":"text","text":"included, is Eulerian (igraph "},{"code":"igraph_is_eulerian","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"has_cycle","type":"codeVoice"},{"type":"text","text":")."}],"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","title":"isEulerian","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"abstract":[{"type":"text","text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same"},{"type":"text","text":" "},{"type":"text","text":"Held–Karp program as "},{"type":"codeVoice","code":"Graph.shortestTour(weight:)"},{"type":"text","text":" (JGraphT "},{"type":"codeVoice","code":"HeldKarpTSP"},{"type":"text","text":" on a directed"},{"type":"text","text":" "},{"type":"text","text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc"},{"type":"text","text":" "},{"type":"text","text":"from one vertex to the next, or nil when there is none; among the optimal ones, the"},{"type":"text","text":" "},{"type":"text","text":"lexicographically least by vertex number listed from the first vertex. Self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on"},{"type":"text","text":" "},{"type":"text","text":"ties), which is the edge the returned "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" uses, so "},{"type":"codeVoice","code":"cycle.weight(weight)"},{"type":"text","text":" is the tour’s"},{"type":"text","text":" "},{"type":"text","text":"length. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per non-loop edge, in position order. nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices, as on "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" (an antiparallel pair is a "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":", but not a tour here)."}],"title":"shortestTour(weight:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit()":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()","abstract":[{"text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order with an edge; nil when the graph is not Eulerian or has no edges","type":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"type":"codeVoice","code":"Circuit"},{"text":" has at least one). Pinned: from the current vertex the first unused edge in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"outEdges"},{"text":" order, in the stack form igraph’s ","type":"text"},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"text":" runs; the circuit is","type":"text"},{"text":" ","type":"text"},{"text":"listed forward from that vertex. On a compressed sparse row the graph’s own rows are read.","type":"text"}],"title":"eulerianCircuit()","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks7CircuitV","kind":"typeIdentifier","text":"Circuit"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:to:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"role":"symbol","abstract":[{"text":"The first Hamiltonian path from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" that ends at ","type":"text"},{"code":"end","type":"codeVoice"},{"text":" (Mathematica","type":"text"},{"text":" ","type":"text"},{"code":"FindHamiltonianPath[g, s, t]","type":"codeVoice"},{"text":"); nil when ","type":"text"},{"code":"start == end","type":"codeVoice"},{"text":" and there is more than one vertex.","type":"text"}],"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:to:)","title":"hamiltonianPath(from:to:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:to:)","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianCycle()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"title":"hamiltonianCycle()","abstract":[{"text":"A Hamiltonian cycle, or nil (Mathematica ","type":"text"},{"type":"codeVoice","code":"FindHamiltonianCycle"},{"text":"): the search from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex, closed by the first edge of the last vertex’s row back to it. A self-loop is the","type":"text"},{"text":" ","type":"text"},{"text":"cycle of a one-vertex graph and an antiparallel pair the cycle of a two-vertex one (the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Cycle"},{"text":" type’s rules).","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltoniancycle()","type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianCycle()"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"role":"symbol","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no"},{"type":"text","text":" "},{"type":"text","text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or"},{"type":"text","text":" "},{"type":"text","text":"successor), so it keeps the order. Without a start the search is run again from each"},{"type":"text","text":" "},{"type":"text","text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches."}],"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","title":"hamiltonianPath()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks