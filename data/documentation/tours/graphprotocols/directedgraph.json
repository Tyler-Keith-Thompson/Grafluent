 out − in = 1, or,","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is Eulerian, at the first vertex with an edge (the circuit as a closed","type":"text"},{"text":" ","type":"text"},{"text":"trail); it is the trivial trail at the first vertex when there are no edges. Hierholzer’s","type":"text"},{"text":" ","type":"text"},{"text":"walk, as ","type":"text"},{"type":"codeVoice","code":"eulerianCircuit()"},{"text":".","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail()","title":"eulerianTrail()","role":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5TrailV","text":"Trail","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hasEulerianTrail":{"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hasEulerianTrail","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/haseuleriantrail","title":"hasEulerianTrail","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasEulerianTrail"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentif