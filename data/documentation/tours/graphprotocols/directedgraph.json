type":"codeVoice","code":"start"},{"text":" must be the vertex with out − in = 1, or, in an","type":"text"},{"text":" ","type":"text"},{"text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail(from:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail(from:)","kind":"symbol","title":"eulerianTrail(from:)","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:to:)":{"title":"hamiltonianPath(from:to:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:to:)","role":"symbol","kind":"symbol","abstract":[{"text":"The first Hamiltonian path from ","type":"text"},{"type":"codeVoice","code":"start"},{"text":" that ends at ","type":"text"},{"type":"codeVoice","code":"end"},{"text":" (Mathematica","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FindHamiltonianPath[g, s, t]"},{"text":"); nil when ","type":"text"},{"type":"codeVoice","code":"start == end"},{"text":" and there is more than one vertex.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Path"