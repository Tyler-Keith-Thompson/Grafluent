"},{"text":"; nil when ","type":"text"},{"code":"start == end","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"there is more than one vertex."}],"role":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:to:)","kind":"symbol","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","type":"topic","abstract":[{"text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in","type":"text"},{"text":" ","type":"text"},{"text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected","type":"text"},{"text":" ","type":"text"},{"text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored, and an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless graph, the empty graph included, is Eulerian.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEulerian","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","title":"isEulerian"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","t