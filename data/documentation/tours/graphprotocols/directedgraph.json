n\/Tours\/GraphProtocols"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hasEulerianTrail":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","title":"hasEulerianTrail","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hasEulerianTrail","abstract":[{"text":"Whether some trail uses every edge exactly once (NetworkX ","type":"text"},{"code":"has_eulerian_path","type":"codeVoice"},{"text":", igraph’s","type":"text"},{"text":" ","type":"text"},{"code":"has_path","type":"codeVoice"},{"text":"): the graph is Eulerian, or exactly one vertex has out − in = 1, one has","type":"text"},{"text":" ","type":"text"},{"text":"in − out = 1, the rest are balanced, and the vertices with edges are weakly connected.","type":"text"},{"text":" ","type":"text"},{"text":"True for every edgeless graph.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/haseuleriantrail","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail(from:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5TrailV","kind":"typeIdentifier","text":"Trail"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind"