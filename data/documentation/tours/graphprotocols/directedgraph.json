dgeless graph."}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hasEulerianTrail","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail()":{"abstract":[{"text":"An Eulerian trail (NetworkX ","type":"text"},{"code":"eulerian_path","type":"codeVoice"},{"text":", igraph ","type":"text"},{"code":"igraph_eulerian_path","type":"codeVoice"},{"text":"), or nil when","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"there is none or the graph has no vertex. It starts at the vertex with out − in = 1, or,"},{"type":"text","text":" "},{"type":"text","text":"when the graph is Eulerian, at the first vertex with an edge (the circuit as a closed"},{"type":"text","text":" "},{"type":"text","text":"trail); it is the trivial trail at the first vertex when there are no edges. Hierholzer’s"},{"type":"text","text":" "},{"type":"text","text":"walk, as "},{"code":"eulerianCircuit()","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Trail","preciseIdentifier":"s:5Walks5TrailV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"role":"