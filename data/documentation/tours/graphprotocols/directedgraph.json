 none or the graph has no vertex. It starts at the vertex with out − in = 1, or,"},{"type":"text","text":" "},{"type":"text","text":"when the graph is Eulerian, at the first vertex with an edge (the circuit as a closed"},{"type":"text","text":" "},{"type":"text","text":"trail); it is the trivial trail at the first vertex when there are no edges. Hierholzer’s"},{"type":"text","text":" "},{"type":"text","text":"walk, as "},{"code":"eulerianCircuit()","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianCycle()":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltoniancycle()","abstract":[{"text":"A Hamiltonian cycle, or nil (Mathematica ","type":"text"},{"code":"FindHamiltonianCycle","type":"codeVoice"},{"text":"): the search from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex, closed by the first edge of the last vertex’s row back to it. A self-loop is the","type":"text"},{"text":" ","type":"text"},{"text":"cycle of a one-vertex graph and an antiparallel pair the cycle of a two-vertex one (the","type":"text"},{"text":" ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" type’s rules).","type":"text"}],"title":"hamiltonianCycle()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianCycle()","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:to:)":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:to:)","title":"hamiltonianPath(from:to:)","abstract":[{"type":"text","text":"The first Hamiltonian path from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" that ends at "},{"type":"codeVoice","code":"end"},{"type":"text","text":" (Mathematica"},{"type":"text","text":" "},{"type":"codeVoice","code":"FindHamiltonianPath[g, s, t]"},{"type":"text","text":"); nil when "},{"type":"codeVoice","code":"start == end"},{"type":"text","text":" and there is more than one vertex."}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Path","kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath(from:)":{"abstract":[{"type":"text","text":"The first Hamiltonian path from "},{"type":"codeVoice","code":"start"},{"type":"text","text":", in the same search order."}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath(from:)","title":"hamiltonianPath(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Path","preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath(from:)","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hasEulerianTrail":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/haseuleriantrail","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Whether some trail uses every edge exactly once (NetworkX "},{"type":"codeVoice","code":"has_eulerian_path"},{"type":"text","text":", igraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"has_path"},{"type":"text","text":"): the graph is Eulerian, or exactly one vertex has out − in = 1, one has"},{"type":"text","text":" "},{"type":"text","text":"in − out = 1, the rest are balanced, and the vertices with edges are weakly connected."},{"type":"text","text":" "},{"type":"text","text":"True for every edgeless graph."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hasEulerianTrail","title":"hasEulerianTrail"},"doc://Tours/documentation/Tours":{"abstract":[],"kind":"symbol","title":"Tours","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","role":"collection","url":"\/documentation\/tours"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph":{"kind":"symbol","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph","abstract":[],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit(from:)":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit(from:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The Eulerian circuit from "},{"code":"start","type":"codeVoice"},{"type":"text","text":" (NetworkX "},{"code":"eulerian_circuit(G, source=)","type":"codeVoice"},{"type":"text","text":"): the same"},{"type":"text","text":" "},{"type":"text","text":"walk; nil also when "},{"code":"start","type":"codeVoice"},{"type":"text","text":" has no edges."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit(from:)","title":"eulerianCircuit(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/shortestTour(weight:)":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/shortesttour(weight:)","abstract":[{"type":"text","text":"The shortest directed tour (the asymmetric travelling salesman problem), by the same"},{"type":"text","text":" "},{"type":"text","text":"Held–Karp program as "},{"type":"codeVoice","code":"Graph.shortestTour(weight:)"},{"type":"text","text":" (JGraphT "},{"type":"codeVoice","code":"HeldKarpTSP"},{"type":"text","text":" on a directed"},{"type":"text","text":" "},{"type":"text","text":"graph): the least-weight Hamiltonian cycle of the simple digraph, each step along an arc"},{"type":"text","text":" "},{"type":"text","text":"from one vertex to the next, or nil when there is none; among the optimal ones, the"},{"type":"text","text":" "},{"type":"text","text":"lexicographically least by vertex number listed from the first vertex. Self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored and each ordered pair is joined by its lightest arc (the earliest position on"},{"type":"text","text":" "},{"type":"text","text":"ties), which is the edge the returned "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" uses, so "},{"type":"codeVoice","code":"cycle.weight(weight)"},{"type":"text","text":" is the tour’s"},{"type":"text","text":" "},{"type":"text","text":"length. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per non-loop edge, in position order. nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices, as on "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" (an antiparallel pair is a "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":", but not a tour here)."}],"title":"shortestTour(weight:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/shortestTour(weight:)","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianTrail(from:)":{"kind":"symbol","abstract":[{"type":"text","text":"An Eulerian trail from "},{"code":"start","type":"codeVoice"},{"type":"text","text":", or nil when none starts there (NetworkX"},{"type":"text","text":" "},{"code":"has_eulerian_path(G, source)","type":"codeVoice"},{"type":"text","text":"): "},{"code":"start","type":"codeVoice"},{"type":"text","text":" must be the vertex with out − in = 1, or, in an"},{"type":"text","text":" "},{"type":"text","text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriantrail(from:)","title":"eulerianTrail(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5TrailV","text":"Trail","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianTrail(from:)","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/eulerianCircuit()":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/euleriancircuit()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order with an edge; nil when the graph is not Eulerian or has no edges"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, in the stack form igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is"},{"type":"text","text":" "},{"type":"text","text":"listed forward from that vertex. On a compressed sparse row the graph’s own rows are read."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/eulerianCircuit()","title":"eulerianCircuit()"},"doc://Tours/documentation/Tours/GraphProtocols":{"url":"\/documentation\/tours\/graphprotocols","type":"topic","kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"kind":"symbol","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no"},{"type":"text","text":" "},{"type":"text","text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or"},{"type":"text","text":" "},{"type":"text","text":"successor), so it keeps the order. Without a start the search is run again from each"},{"type":"text","text":" "},{"type":"text","text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches."}],"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","title":"hamiltonianPath()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in"},{"type":"text","text":" "},{"type":"text","text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected"},{"type":"text","text":" "},{"type":"text","text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored (igraph’s"},{"type":"text","text":" "},{"type":"text","text":"and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty graph"},{"type":"text","text":" "},{"type":"text","text":"included, is Eulerian (igraph "},{"type":"codeVoice","code":"igraph_is_eulerian"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"has_cycle"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/isEulerian","title":"isEulerian"}}}