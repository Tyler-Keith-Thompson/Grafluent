arches.","type":"text"}],"kind":"symbol","title":"hamiltonianPath()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Path","preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/isEulerian":{"type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/iseulerian","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Whether some closed trail uses every edge exactly once: every vertex has as many edges in"},{"type":"text","text":" "},{"type":"text","text":"as out (a self-loop is one of each), and the vertices with edges are weakly connected"},{"type":"text","text":" "},{"type":"text","text":"(which, balanced, makes them strongly connected). Isolated vertices are ignored (igraph’s"},{"type":"text","text":" "},{"type":"text","text":"and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty graph"},{"type":"text","text":" "},{"type":"text","text":"included, is Eulerian (igraph "},{"code":"igraph_is_eulerian","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"has_cycle","type":"codeVoice"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":