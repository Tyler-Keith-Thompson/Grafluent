preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianCycle()":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A Hamiltonian cycle, or nil (Mathematica "},{"type":"codeVoice","code":"FindHamiltonianCycle"},{"type":"text","text":"): the search from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, closed by the first unused edge of the last vertex’s row back to it. It leaves the"},{"type":"text","text":" "},{"type":"text","text":"first vertex through the lesser of its two edges in that vertex’s row (the search meets"},{"type":"text","text":" "},{"type":"text","text":"that orientation first), as Cycles’ canonical form does. A self-loop is the cycle of a"},{"type":"text","text":" "},{"type":"text","text":"one-vertex graph and two parallel edges the cycle of a two-vertex one (the "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" type’s"},{"type":"text","text":" "},{"type":"text","text":"rules)."}],"kind":"symbol","title":"hamiltonianCycle()","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltoniancycle()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianCycle()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/isEulerian":{"url":"\/documentation\/tours\/graphprotocols\/graph\/iseulerian","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEulerian","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether some closed trail uses every edge exactly once: every degree is even (a self-loop"},{"type":"text","text":" "},{"type":"text","text":"counts 2) and the vertices with edges are connected. Isolated vertices are ignored"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty"},{"type":"text","text":" "},{"type":"text","text":"graph included, is Eulerian (igraph "},{"type":"codeVoice","code":"igraph_is_eulerian"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"has_cycle"},{"type":"text","text":")."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/isEulerian","type":"topic","title":"isEulerian","role":"symbol","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"role":"symbol","title":"hamiltonianPath()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"code":"FindHamiltonianPath","type":"codeVoice"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order. Without a start the search is run again from"},{"type":"text","text":" "},{"type":"text","text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n"},{"type":"text","text":" "},{"type":"text","text":"searches."}],"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","title":"Graph","url":"\/documentation\/tours\/graphprotocols\/graph","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hasEulerianTrail":{"abstract":[{"text":"Whether some trail uses every edge exactly once (NetworkX ","type":"text"},{"type":"codeVoice","