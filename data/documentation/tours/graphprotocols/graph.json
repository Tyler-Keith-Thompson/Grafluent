rkX counts them), and an edgeless graph, the empty","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"graph included, is Eulerian (igraph "},{"type":"codeVoice","code":"igraph_is_eulerian"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"has_cycle"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEulerian"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/isEulerian","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit()":{"type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit()","abstract":[{"text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order with an edge; nil when the graph is not Eulerian or has no edges","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop, twice in its row, is taken once), in the stack form"},{"type":"text","text":" "},{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is listed forward from that vertex."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()","title":"eulerianCircuit()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text