nd tour.","type":"text"}],"title":"nearestNeighborTour(weight:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail(from:)":{"type":"topic","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail(from:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail(from:)","title":"eulerianTrail(from:)","abstract":[{"type":"text","text":"An Eulerian trail from "},{"type":"codeVoice","code":"start"},{"type":"text","text":", or nil when none starts there (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"has_eulerian_path(G, source)"},{"type":"text","text":"): "},{"type":"codeVoice","code":"start"},{"type":"text","text":" must be one of the two odd vertices, or, in an"},{"type":"text","text":" "},{"type":"text","text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5TrailV","text":"Trail"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"kind":"symbol","title":"hamiltonianPath()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","type":"topic","role":"symbol","abstract":[{"text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first","type":"text"},{"text":" ","type":"text"},{"text":"backtracking search finds, from each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, extending through each","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order. Without a start the search is run again from"},{"type":"text","text":" "},{"type":"text","text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n"},{"type":"text","text":" "},{"type":"text","text":"searches."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hasEulerianTrail":{"type":"topic","title":"hasEulerianTrail","abstract":[{"type":"text","text":"Whether some trail uses every edge exactly once (NetworkX "},{"type":"codeVoice","code":"has_eulerian_path"},{"type":"text","text":", igraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"has_path"},{"type":"text","text":"): no or exactly two odd vertices, and the vertices with edges connected. True"},{"text":" ","type":"text"},{"text":"for every edgeless graph.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/haseuleriantrail","role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hasEulerianTrail","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit()":{"kind":"symbol","title":"eulerianCircuit()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit()","role":"symbol","abstract":[{"text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order with an edge; nil when the graph is not Eulerian or has no edges","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop, twice in its row, is taken once), in the stack form"},{"type":"text","text":" "},{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is listed forward from that vertex."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Circuit","preciseIdentifier":"s:5Walks7CircuitV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","te