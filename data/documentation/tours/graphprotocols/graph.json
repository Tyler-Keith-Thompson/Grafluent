","text":" "},{"type":"text","text":"the nearest unvisited vertex, the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/isEulerian":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/isEulerian","title":"isEulerian","url":"\/documentation\/tours\/graphprotocols\/graph\/iseulerian","abstract":[{"text":"Whether some closed trail uses every edge exactly once: every degree is even (a self-loop","type":"text"},{"text":" ","type":"text"},{"text":"counts 2) and the vertices with edges are connected. Isolated vertices are ignored","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s and JGraphT’s rule; NetworkX counts them), and an edgeless graph, the empty","type":"text"},{"text":" ","type":"text"},{"text":"graph included, is Eulerian (igraph ","type":"text"},{"code":"igraph_is_eulerian","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"has_cycle","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEulerian","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit()":{"type":"topic","abstract":[{"type":"text","text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order with an edge; nil when the graph is not Eulerian or has no edges"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop, twice in its row, is taken once), in the stack form"},{"type":"text","text":" "},{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is listed forward from that vertex."}],"kind":"symbol","title":"eulerianCircuit()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit()","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","abstract":[],"type":"topic","role":"collection"},"doc://Tours/documentation/Tours":{"url":"\/documentation\/tours","role":"collection","type":"topic","title":"Tours","abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"kind":"symbol","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order. Without a start the search is run again from"},{"type":"text","text":" "},{"type":"text","text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n"},{"type":"text","text":" "},{"type":"text","text":"searches."}],"type":"topic","title":"hamiltonianPath()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"title":"christofidesTour(weight:)","abstract":[{"text":"Christofides’ tour (Christofides, “Worst-case analysis of a new heuristic for the","type":"text"},{"text":" ","type":"text"},{"text":"travelling salesman problem”, Report 388, Carnegie Mellon University, 1976; found","type":"text"},{"text":" ","type":"text"},{"text":"independently by Serdyukov, 1978): the canonical minimum spanning tree (weight, then","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"position: SpanningTrees’ "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", by Prim on the dense matrix), a"},{"type":"text","text":" "},{"type":"text","text":"minimum-weight perfect matching on its odd-degree vertices (MatchingModule’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":", Galil’s blossom), an Eulerian circuit of their union by Hierholzer"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex, shortcut to the first visit of each vertex (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"christofides"},{"type":"text","text":", JGraphT "},{"type":"codeVoice","code":"ChristofidesThreeHalvesApproxMetricTSP"},{"type":"text","text":", LEMON "},{"type":"codeVoice","code":"ChristofidesTsp"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Each piece is pinned, so the tour is: the matching is on the complete graph of the odd"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (pairs i < j lexicographic), and the circuit’s multigraph"},{"type":"text","text":" "},{"type":"text","text":"lists the tree edges by position, then the matched pairs in that order. At most 3\/2 × the"},{"type":"text","text":" "},{"type":"text","text":"shortest tour when the weights satisfy the triangle inequality (not checked)."}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail()":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail()","title":"eulerianTrail()","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail()","abstract":[{"type":"text","text":"An Eulerian trail (NetworkX "},{"code":"eulerian_path","type":"codeVoice"},{"type":"text","text":", igraph "},{"code":"igraph_eulerian_path","type":"codeVoice"},{"type":"text","text":"), or nil when"},{"type":"text","text":" "},{"type":"text","text":"there is none or the graph has no vertex. It starts at the first odd vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order, or, when the graph is Eulerian, at the first vertex with an edge (the circuit as a"},{"type":"text","text":" "},{"type":"text","text":"closed trail); it is the trivial trail at the first vertex when there are no edges."},{"type":"text","text":" "},{"text":"Hierholzer’s walk, as ","type":"text"},{"code":"eulerianCircuit()","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Trail","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5TrailV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"type":"topic","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/twoOptTour(weight:)":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(weight:)","title":"twoOptTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/graph\/twoopttour(weight:)","abstract":[{"text":"2-opt (Croes, “A method for solving traveling-salesman problems”, Operations Research 6,","type":"text"},{"text":" ","type":"text"},{"text":"1958) from ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":": ","type":"text"},{"code":"twoOptTour(improving:weight:)","type":"codeVoice"},{"text":" of that tour, so","type":"text"},{"text":" ","type":"text"},{"text":"the tour starts at the first vertex. Tours read the simple graph, as","type":"text"},{"text":" ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three vertices.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"twoOptTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hasEulerianTrail":{"kind":"symbol","type":"topic","abstract":[{"text":"Whether some trail uses every edge exactly once (NetworkX ","type":"text"},{"type":"codeVoice","code":"has_eulerian_path"},{"text":", igraph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"has_path"},{"text":"): no or exactly two odd vertices, and the vertices with edges connected. True","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for every edgeless graph."}],"title":"hasEulerianTrail","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hasEulerianTrail","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasEulerianTrail"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/haseuleriantrail","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianCycle()":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianCycle()","title":"hamiltonianCycle()","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltoniancycle()","abstract":[{"text":"A Hamiltonian cycle, or nil (Mathematica ","type":"text"},{"code":"FindHamiltonianCycle","type":"codeVoice"},{"text":"): the search from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex, closed by the first unused edge of the last vertex’s row back to it. It leaves the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"first vertex through the lesser of its two edges in that vertex’s row (the search meets"},{"type":"text","text":" "},{"type":"text","text":"that orientation first), as Cycles’ canonical form does. A self-loop is the cycle of a"},{"type":"text","text":" "},{"type":"text","text":"one-vertex graph and two parallel edges the cycle of a two-vertex one (the "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" type’s"},{"type":"text","text":" "},{"type":"text","text":"rules)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit(from:)":{"url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit(from:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Circuit","preciseIdentifier":"s:5Walks7CircuitV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"type":"topic","title":"eulerianCircuit(from:)","abstract":[{"type":"text","text":"The Eulerian circuit from "},{"code":"start","type":"codeVoice"},{"type":"text","text":" (NetworkX "},{"code":"eulerian_circuit(G, source=)","type":"codeVoice"},{"type":"text","text":"): the same"},{"type":"text","text":" "},{"text":"walk; nil also when ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" has no edges.","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit(from:)","kind":"symbol"}}}