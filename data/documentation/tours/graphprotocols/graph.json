olzer and Wiener 1873), from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order with an edge; nil when the graph is not Eulerian or has no edges"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop, twice in its row, is taken once), in the stack form"},{"type":"text","text":" "},{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is listed forward from that vertex."}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","title":"hamiltonianPath()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"code":"FindHamiltonianPath","type":"codeVoice"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order."}],"role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail(from:)":{"title":"eulerianTrail(from:)","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail(from:)","kind":"symbol","abstract":[{"text":"An Eulerian trail from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":", or nil when none starts there (NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"has_eulerian_path(G, source)","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" must be one of the two odd vertices, or, in an","type":"text"},{"text":" ","type":"text"},{"text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5TrailV","text":"Trail","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/tours\/graphprotocols\/graph","kind":"symbol","abstract":[],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","kind":"symbol","title":"christofidesTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"abstract":[{"type":"text","text":"Christofides’ tour (Christofides, “Worst-case analysis of a new heuristic for the"},{"type":"text","text":" "},{"type":"text","text":"travelling salesman problem”, Report 388, Carnegie Mellon University, 1976; found"},{"type":"text","text":" "},{"type":"text","text":"independently by Serdyukov, 1978): the canonical minimum spanning tree (weight, then"},{"type":"text","text":" "},{"text":"position: SpanningTrees’ ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":", by Prim on the dense matrix), a","type":"text"},{"text":" ","type":"text"},{"text":"minimum-weight perfect matching on its odd-degree vertices (MatchingModule’s","type":"text"},{"text":" ","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":", Galil’s blossom), an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex (NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"christofides","type":"codeVoice"},{"text":", JGraphT ","type":"text"},{"code":"ChristofidesThreeHalvesApproxMetricTSP","type":"codeVoice"},{"text":", LEMON ","type":"text"},{"code":"ChristofidesTsp","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Each piece is pinned, so the tour is: the matching is on the complete graph of the odd","type":"text"},{"text":" ","type":"text"},{"text":"vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (pairs i < j lexicographic), and the circuit’s multigraph","type":"text"},{"text":" ","type":"text"},{"text":"lists the tree edges by position, then the matched pairs in that order. At most 3\/2 × the","type":"text"},{"text":" ","type":"text"},{"text":"shortest tour when the weights satisfy the triangle inequality (not checked).","type":"text"}],"role":"symbol"},"doc://Tours/documentation/Tours":{"title":"Tours","url":"\/documentation\/tours","kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols":{"title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hasEulerianTrail":