"symbol","abstract":[{"text":"An Eulerian trail (NetworkX ","type":"text"},{"code":"eulerian_path","type":"codeVoice"},{"text":", igraph ","type":"text"},{"code":"igraph_eulerian_path","type":"codeVoice"},{"text":"), or nil when","type":"text"},{"text":" ","type":"text"},{"text":"there is none or the graph has no vertex. It starts at the first odd vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order, or, when the graph is Eulerian, at the first vertex with an edge (the circuit as a","type":"text"},{"text":" ","type":"text"},{"text":"closed trail); it is the trivial trail at the first vertex when there are no edges.","type":"text"},{"text":" ","type":"text"},{"text":"Hierholzer’s walk, as ","type":"text"},{"code":"eulerianCircuit()","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit()":{"role":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit()","kind":"symbol","type":"topic","title":"eulerianCircuit()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Circuit","preciseIdentifier":"s:5Walks7CircuitV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"abstract":[{"text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order with an edge; nil when the graph is not Eulerian or has no edges","type":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"code":"Circuit","type":"codeVoice"},{"text":" has at least one). Pinned: from the current vertex the first unused edge in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order (a self-loop, twice in its row, is taken once), in the stack form","type":"text"},{"text":" ","type":"text"},{"text":"igraph’s ","type":"text"},{"code":"igraph_eulerian_cycle","type":"codeVoice"},{"text":" runs; the circuit is listed forward from that vertex.","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","title":"hamiltonianPath()","kind":"symbol","role":"symbol","abstract":[{"text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first","type":"text"},{"text":" ","type":"text"},{"text":"backtracking search finds, from each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, extending through each","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"vertex’s "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"code":"FindHamiltonianPath","type":"codeVoice"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order. Without a start the search is run again from"},{"type":"text","text":" "},{"type":"text","text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n"},{"type":"text","text":" "},{"type":"text","text":"searches."}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/shortestTour(weight:)":{"abstract":[{"text":"The shortest tour, by Held–Karp dynamic programming (Bellman, “Dynamic programming","type":"text"},{"text":" ","type":"text"},{"text":"treatment of the travelling salesman problem”, Journal of the ACM 9, 1962; Held and Karp,","type":"text"},{"text":" ","type":"text"},{"text":"“A dynamic programming approach to sequencing problems”, Journal of SIAM 10, 1962): the","type":"text"},{"text":" ","type":"text"},{"text":"least-weight Hamiltonian cycle of the simple graph, or nil when there is none; among the","type":"text"},{"text":" ","type":"text"},{"text":"optimal ones, the lexicographically least by vertex number listed from the first vertex","type":"text"},{"text":" ","type":"text"},{"text":"(JGraphT ","type":"text"},{"type":"codeVoice","code":"HeldKarpTSP"},{"text":"’s tour). The graph need not be complete: a missing pair is an absent","type":"text"},{"text":" ","type":"text"},{"text":"edge. Tours read the simple graph, as ","type":"text"},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"text":" documents; nil below","type":"text"},{"text":" ","type":"text"},{"text":"three vertices.","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","role":"symbol","title":"shortestTour(weight:)","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-81xql":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-81xql","url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weigh