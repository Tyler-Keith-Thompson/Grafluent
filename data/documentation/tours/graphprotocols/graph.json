xt"},{"text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n","type":"text"},{"text":" ","type":"text"},{"text":"searches.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/nearestNeighborTour(weight:)":{"abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex (NetworkX "},{"code":"greedy_tsp","type":"codeVoice"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"code":"NearestNeighborHeuristicTSP(first)","type":"codeVoice"},{"type":"text","text":", whose default starts at a random vertex): repeatedly"},{"type":"text","text":" "},{"type":"text","text":"the nearest unvisited vertex, the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"role":"symbol","url":"\/documenta