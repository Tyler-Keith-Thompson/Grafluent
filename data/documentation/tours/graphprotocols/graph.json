lerian","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"has_cycle","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hasEulerianTrail":{"url":"\/documentation\/tours\/graphprotocols\/graph\/haseuleriantrail","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hasEulerianTrail","title":"hasEulerianTrail","kind":"symbol","role":"symbol","abstract":[{"text":"Whether some trail uses every edge exactly once (NetworkX ","type":"text"},{"code":"has_eulerian_path","type":"codeVoice"},{"text":", igraph’s","type":"text"},{"text":" ","type":"text"},{"code":"has_path","type":"codeVoice"},{"text":"): no or exactly two odd vertices, and the vertices with edges connected. True","type":"text"},{"text":" ","type":"text"},{"text":"for every edgeless graph.","type":"text"}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":