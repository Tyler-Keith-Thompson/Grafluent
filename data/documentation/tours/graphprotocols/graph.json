oice","code":"vertices"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","title":"nearestNeighborTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail(from:)":{"abstract":[{"text":"An Eulerian trail from ","type":"text"},{"type":"codeVoice","code":"start"},{"text":", or nil when none starts there (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"has_eulerian_path(G, source)"},{"text":"): ","type":"text"},{"code":"start","type":"codeVoice"},{"type":"text","text":" must be one of the two odd vertices, or, in an"},{"type":"text","text":" "},{"type":"text","text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges."}],"url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail(from:)","role":"symbol","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail(from:)","kind":"symbol","title":"eulerianTrail(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Trail","preciseIdentifier":"s:5Walks5TrailV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directedView","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"url":"\/documentation\/graphprotocols\/graph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"symbol","title":"Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/shortestTour(weight:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The shortest tour, by Held–Karp dynamic programming (Bellman, “Dynamic programming"},{"type":"text","text":" "},{"type":"text","text":"treatment of the travelling salesman problem”, Journal of the ACM 9, 1962; Held and Karp,"},{"type":"text","text":" "},{"type":"text","text":"“A dynamic programming approach to sequencing problems”, Journal of SIAM 10, 1962): the"},{"type":"text","text":" "},{"type":"text","text":"least-weight Hamiltonian cycle of the simple graph, or nil when there is none; among the"},{"type":"text","text":" "},{"type":"text","text":"optimal ones, the lexicographically least by vertex number listed from the first vertex"},{"type":"text","text":" "},{"type":"text","text":"(JGraphT "},{"type":"codeVoice","code":"HeldKarpTSP"},{"type":"text","text":"’s tour). The graph need not be complete: a missing pair is an absent"},{"type":"text","text":" "},{"type":"text","text":"edge. Tours read the simple graph, as "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" documents; nil below"},{"type":"text","text":" "},{"type":"text","text":"three vertices."}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","title":"shortestTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath(from:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath(from:)","abstract":[{"type":"text","text":"The first Hamiltonian path from "},{"type":"codeVoice","code":"start"},{"type":"text","text":", in the same search order."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Path","kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"kind":"symbol","title":"hamiltonianPath(from:)","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"role":"symbol","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","abstract":[{"text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first","type":"text"},{"text":" ","type":"text"},{"text":"backtracking search finds, from each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, extending through each","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" in order to an unvisited vertex (Mathematica","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FindHamiltonianPath"},{"text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts","type":"text"},{"text":" ","type":"text"},{"text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few","type":"text"},{"text":" ","type":"text"},{"text":"usable neighbours), so it keeps the order. Without a start the search is run again from","type":"text"},{"text":" ","type":"text"},{"text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n","type":"text"},{"text":" ","type":"text"},{"text":"searches.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"kind":"symbol","title":"hamiltonianPath()","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit()":{"url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit()","abstract":[{"type":"text","text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order with an edge; nil when the graph is not Eulerian or has no edges"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop, twice in its row, is taken once), in the stack form"},{"type":"text","text":" "},{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is listed forward from that vertex."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()","kind":"symbol","title":"eulerianCircuit()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianCircuit"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","abstract":[{"text":"Christofides’ tour (Christofides, “Worst-case analysis of a new heuristic for the","type":"text"},{"text":" ","type":"text"},{"text":"travelling salesman problem”, Report 388, Carnegie Mellon University, 1976; found","type":"text"},{"text":" ","type":"text"},{"text":"independently by Serdyukov, 1978): the canonical minimum spanning tree (weight, then","type":"text"},{"text":" ","type":"text"},{"text":"position: SpanningTrees’ ","type":"text"},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"text":", by Prim on the dense matrix), a","type":"text"},{"text":" ","type":"text"},{"text":"minimum-weight perfect matching on its odd-degree vertices (MatchingModule’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"minimumWeightMatching"},{"text":", Galil’s blossom), an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"christofides"},{"text":", JGraphT ","type":"text"},{"type":"codeVoice","code":"ChristofidesThreeHalvesApproxMetricTSP"},{"text":", LEMON ","type":"text"},{"type":"codeVoice","code":"ChristofidesTsp"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Each piece is pinned, so the tour is: the matching is on the complete graph of the odd","type":"text"},{"text":" ","type":"text"},{"text":"vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (pairs i < j lexicographic), and the circuit’s multigraph","type":"text"},{"text":" ","type":"text"},{"text":"lists the tree edges by position, then the matched pairs in that order. At most 3\/2 × the","type":"text"},{"text":" ","type":"text"},{"text":"shortest tour when the weights satisfy the triangle inequality (not checked).","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","title":"christofidesTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/twoOptTour(improving:weight:)":{"abstract":[{"code":"tour","type":"codeVoice"},{"text":" improved by 2-opt to a 2-optimal tour, by JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"TwoOptHeuristicTSP.improveTour","type":"codeVoice"},{"text":"‘s procedure: best improvement, the first move (i, j) in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains."},{"type":"text","text":" "},{"type":"text","text":"LEMON’s "},{"type":"codeVoice","code":"Opt2Tsp"},{"type":"text","text":" shares the name only: it takes the first improving move and restarts the"},{"type":"text","text":" "},{"type":"text","text":"scan, which ends at a different tour. The first vertex of "},{"type":"codeVoice","code":"tour"},{"type":"text","text":" stays first. Only"},{"type":"text","text":" "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" is read: the result uses the lightest edge of each pair, as every tour"},{"type":"text","text":" "},{"type":"text","text":"does. nil below three vertices."}],"url":"\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)","role":"symbol","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)","kind":"symbol","title":"twoOptTour(improving:weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"twoOptTour"},{"