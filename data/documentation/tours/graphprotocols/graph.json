text":"for every edgeless graph.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","abstract":[{"text":"Christofides’ tour (Christofides, “Worst-case analysis of a new heuristic for the","type":"text"},{"text":" ","type":"text"},{"text":"travelling salesman problem”, Report 388, Carnegie Mellon University, 1976; found","type":"text"},{"text":" ","type":"text"},{"text":"independently by Serdyukov, 1978): the canonical minimum spanning tree (weight, then","type":"text"},{"text":" ","type":"text"},{"text":"position: SpanningTrees’ ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":", by Prim on the dense matrix), a","type":"text"},{"text":" ","type":"text"},{"text":"minimum-weight perfect matching on its odd-degree vertices (MatchingModule’s","type":"text"},{"text":" ","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":", Galil’s blossom), an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex (NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"christofides","type":"codeVoice"},{"text":", JGraphT ","type":"text"},{"code":"ChristofidesThreeHalvesApproxMetricTSP","type":"codeVoice"},{"text":", LEMON ","type":"text"},{"code":"ChristofidesTsp","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Each piece is pinned, so the tour is: the matching is on the complete graph of the odd","type":"text"},{"text":" ","type":"text"},{"text":"vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (pairs i < j lexicographic), and the circuit’s multigraph","type":"text"},{"text":" ","type":"text"},{"text":"lists the tree edges by position, then the matched pairs in that order. At most 3\/2 × the","type":"text"},{"text":" ","type":"text"},{"text":"shortest tour when the weights satisfy the triangle inequality (not checked).","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","title":"christofidesTour(weight:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath(from:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"(","kind":"text