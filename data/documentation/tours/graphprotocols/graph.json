":"text"},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"text":" documents; nil below","type":"text"},{"text":" ","type":"text"},{"text":"three vertices.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/nearestNeighborTour(weight:)":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","kind":"symbol","title":"nearestNeighborTour(weight:)","url":"\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex (NetworkX "},{"type":"codeVoice","code":"greedy_tsp"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"NearestNeighborHeuristicTSP(first)"},{"type":"text","text":", whose default starts at a random vertex): repeatedly"},{"type":"text","text":" "},{"type":"text","text":"the nearest unvisited vertex, the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nearestNeighborTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentif