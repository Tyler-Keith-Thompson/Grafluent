ind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(from:weight:)","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit(from:)":{"abstract":[{"type":"text","text":"The Eulerian circuit from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" (NetworkX "},{"type":"codeVoice","code":"eulerian_circuit(G, source=)"},{"type":"text","text":"): the same"},{"type":"text","text":" "},{"text":"walk; nil also when ","type":"text"},{"type":"codeVoice","code":"start"},{"text":" has no edges.","type":"text"}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit(from:)","title":"eulerianCircuit(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Circuit","preciseIdentifier":"s:5Walks7CircuitV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit(from:)","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail()":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail()","title":"eulerianTrail()","abstract":[{"type":"text","text":"An Eulerian trail (NetworkX "},{"type":"codeVoice","code":"eulerian_path"},{"type":"text","text":", igraph "},{"type":"codeVoice","code":"igraph_eulerian_path"},{"type":"text","text":"), or nil when"},{"type":"text","text":" "},{"type":"text","text":"there is none or the graph has no vertex. It starts at the first odd vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order, or, when the graph is Eulerian, at the first vertex with an edge (the circuit as a"},{"type":"text","text":" "},{"type":"text","text":"closed trail); it is the trivial trail at the first vertex when there are no edges."},{"type":"text","text":" "},{"type":"text","text":"Hierholzer’s walk, as "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Trail","preciseIdentifier":"s:5Walks5TrailV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianCycle()":{"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltoniancycle()","type":"topic","kind":"symbol","abstract":[{"text":"A Hamiltonian cycle, or nil (Mathematica ","type":"text"},{"type":"codeVoice","code":"FindHamiltonianCycle"},{"text":"): the search from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex, closed by the first unused edge of the last vertex’s row back to it. It leaves the","type":"text"},{"text":" ","type":"text"},{"text":"first vertex through the lesser of its two edges in that vertex’s row (the search meets","type":"text"},{"text":" ","type":"text"},{"text":"that orientation first), as Cycles’ canonical form does. A self-loop is the cycle of a","type":"text"},{"text":" ","type":"text"},{"text":"one-vertex graph and two parallel edges the cycle of a two-vertex one (the ","type":"text"},{"type":"codeVoice","code":"Cycle"},{"text":" type’s","type":"text"},{"text":" ","type":"text"},{"text":"rules).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianCycle"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianCycle()","title":"hamiltonianCycle()"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","title":"hamiltonianPath()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order. Without a start the search is run again from"},{"type":"text","text":" "},{"type":"text","text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n"},{"type":"text","text":" "},{"type":"text","text":"searches."}],"type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"kind":"symbol","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","role":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hasEulerianTrail":{"url":"\/documentation\/tours\/graphprotocols\/graph\/haseuleriantrail","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Whether some trail uses every edge exactly once (NetworkX "},{"type":"codeVoice","code":"has_eulerian_path"},{"type":"text","text":", igraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"has_path"},{"type":"text","text":"): no or exactly two odd vertices, and the vertices with edges connected. True"},{"text":" ","type":"text"},{"text":"for every edgeless graph.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hasEulerianTrail","title":"hasEulerianTrail"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath(from:)":{"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath(from:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The first Hamiltonian path from "},{"code":"start","type":"codeVoice"},{"type":"text","text":", in the same search order."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath(from:)","title":"hamiltonianPath(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"abstract":[{"type":"text","text":"Christofides’ tour (Christofides, “Worst-case analysis of a new heuristic for the"},{"type":"text","text":" "},{"type":"text","text":"travelling salesman problem”, Report 388, Carnegie Mellon University, 1976; found"},{"type":"text","text":" "},{"type":"text","text":"independently by Serdyukov, 1978): the canonical minimum spanning tree (weight, then"},{"type":"text","text":" "},{"type":"text","text":"position: SpanningTrees’ "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", by Prim on the dense matrix), a"},{"type":"text","text":" "},{"type":"text","text":"minimum-weight perfect matching on its odd-degree vertices (MatchingModule’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":", Galil’s blossom), an Eulerian circuit of their union by Hierholzer"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex, shortcut to the first visit of each vertex (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"christofides"},{"type":"text","text":", JGraphT "},{"type":"codeVoice","code":"ChristofidesThreeHalvesApproxMetricTSP"},{"type":"text","text":", LEMON "},{"type":"codeVoice","code":"ChristofidesTsp"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Each piece is pinned, so the tour is: the matching is on the complete graph of the odd"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (pairs i < j lexicographic), and the circuit’s multigraph"},{"type":"text","text":" "},{"type":"text","text":"lists the tree edges by position, then the matched pairs in that order. At most 3\/2 × the"},{"type":"text","text":" "},{"type":"text","text":"shortest tour when the weights satisfy the triangle inequality (not checked)."}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","title":"christofidesTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","type":"topic"}}}