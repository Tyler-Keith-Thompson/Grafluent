ments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks4PathV","text":"Path","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","kind":"symbol","role":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","abstract":[{"text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first","type":"text"},{"text":" ","type":"text"},{"text":"backtracking search finds, from each vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, extending through each","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" in order to an unvisited vertex. Self-loops never help; one vertex is the trivial path. Pruning cuts","type":"text"},{"text":" ","type":"text"},{"text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few","type":"text"},{"text":" ","type":"text"},{"text":"usable neighbours), so it keeps the order. Without a start the search is run again from","type":"text"},{"text":" ","type":"text"},{"text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n","type":"text"},{"text":" ","type":"text"},{"text":"searches.","type":"text"}],"type":"topic","title":"hamiltonian