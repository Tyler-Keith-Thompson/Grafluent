/eulerianTrail()":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail()","title":"eulerianTrail()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianTrail","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Trail","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5TrailV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"An Eulerian trail (NetworkX "},{"type":"codeVoice","code":"eulerian_path"},{"type":"text","text":", igraph "},{"type":"codeVoice","code":"igraph_eulerian_path"},{"type":"text","text":"), or nil when"},{"type":"text","text":" "},{"type":"text","text":"there is none or the graph has no vertex. It starts at the first odd vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order, or, when the graph is Eulerian, at the first vertex with an edge (the circuit as a"},{"type":"text","text":" "},{"type":"text","text":"closed trail); it is the trivial trail at the first vertex when there are no edges."},{"type":"text","text":" "},{"type":"text","text":"Hierholzer’s walk, as "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":"."}],"url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail()","kind":"symbol","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/shortestTour(weight:)":{"kind":"symbol","title":"shortestTour(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","abstract":[{"type":"text","text":"The shortest tour, by Held–Karp dynamic programming (Bellman, “Dynamic programming"},{"type":"text","text":" "},{"type":"text","text":"treatment of the travelling salesman problem”, Journal of the ACM 9, 1962; Held and Karp,"},{"type":"text","text":" "},{"type":"text","text":"“A dynamic programming approach to sequencing problems”, Journal of SIAM 10, 1962): the"},{"type":"text","text":" "},{"type":"text","text":"least-weight Hamiltonian cycle of the simple graph, or nil when there is none; among the"},{"type":"text","text":" "},{"type":"text","text":"optimal ones, the lexicographically least by vertex number listed from the first vertex"},{"type":"text","text":" "},{"type":"text","text":"(JGraphT "},{"code":"HeldKarpTSP","type":"codeVoice"},{"type":"text","text":"’s tour). The graph need not be complete: a missing pair is an absent"},{"type":"text","text":" "},{"type":"text","text":"edge. Tours read the simple graph, as "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" documents; nil below"},{"type":"text","text":" "},{"type":"text","text":"three vertices."}],"role":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-81xql":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-81xql","title":"christofidesTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"role":"symbol","abstract":[{"text":"Christofides’ tour with floating-point weights, as the integer overload, on the matching’s","type":"text"},{"text":" ","type":"text"},{"text":"floating-point path.","type":"text"}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-81xql","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols":{"role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","abstract":[],"title":"GraphProtocols","kind":"symbol","type":"topic","url":"\/documentation\/tours\/graphprotocols"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/twoOptTour(improving:weight:)":{"kind":"symbol","title":"twoOptTour(improving:weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"twoOptTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"improving","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)","abstract":[{"code":"tour","type":"codeVoice"},{"text":" improved by 2-opt to a 2-optimal tour, by JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"TwoOptHeuristicTSP.improveTour","type":"codeVoice"},{"text":"‘s procedure: best improvement, the first move (i, j) in","type":"text"},{"text":" ","type":"text"},{"text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains.","type":"text"},{"text":" ","type":"text"},{"text":"LEMON’s ","type":"text"},{"code":"Opt2Tsp","type":"codeVoice"},{"text":" shares the name only: it takes the first improving move and restarts the","type":"text"},{"text":" ","type":"text"},{"text":"scan, which ends at a different tour. The first vertex of ","type":"text"},{"code":"tour","type":"codeVoice"},{"text":" stays first. Only","type":"text"},{"text":" ","type":"text"},{"code":"tour.vertices","type":"codeVoice"},{"text":" is read: the result uses the lightest edge of each pair, as every tour","type":"text"},{"text":" ","type":"text"},{"text":"does. nil below three vertices.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"role":"symbol","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order. Without a start the search is run again from"},{"type":"text","text":" "},{"type":"text","text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n"},{"type":"text","text":" "},{"type":"text","text":"searches."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"title":"hamiltonianPath()","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianCycle()":{"kind":"symbol","title":"hamiltonianCycle()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"A Hamiltonian cycle, or nil (Mathematica "},{"type":"codeVoice","code":"FindHamiltonianCycle"},{"type":"text","text":"): the search from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, closed by the first unused edge of the last vertex’s row back to it. It leaves the"},{"type":"text","text":" "},{"type":"text","text":"first vertex through the lesser of its two edges in that vertex’s row (the search meets"},{"type":"text","text":" "},{"type":"text","text":"that orientation first), as Cycles’ canonical form does. A self-loop is the cycle of a"},{"type":"text","text":" "},{"type":"text","text":"one-vertex graph and two parallel edges the cycle of a two-vertex one (the "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" type’s"},{"type":"text","text":" "},{"type":"text","text":"rules)."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianCycle()","role":"symbol","url":"\/document