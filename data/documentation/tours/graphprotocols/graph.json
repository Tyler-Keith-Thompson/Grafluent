VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"abstract":[{"text":"Christofides’ tour with floating-point weights, as the integer overload, on the matching’s","type":"text"},{"text":" ","type":"text"},{"text":"floating-point path.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-81xql","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-81xql","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","title":"Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","abstract":[{"type":"text","text":"Christofides’ tour (Christofides, “Worst-case analysis of a new heuristic for the"},{"type":"text","text":" "},{"type":"text","text":"travelling salesman problem”, Report 388, Carnegie Mellon University, 1976; found"},{"type":"text","text":" "},{"type":"text","text":"independently by Serdyukov, 1978): the canonical minimum spanning tree (weight, then"},{"type":"text","text":" "},{"type":"text","text":"position: SpanningTrees’ "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", by Prim on the dense matrix), a"},{"type":"text","text":" "},{"type":"text","text":"minimum-weight perfect matching on its odd-degree vertices (MatchingModule’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":", Galil’s blossom), an Eulerian circuit of their union by Hierholzer"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex, shortcut to the first visit of each vertex (NetworkX"},{"type":"text","text":" "},{"code":"christofides","type":"codeVoice"},{"type":"text","text":", JGraphT "},{"code":"ChristofidesThreeHalvesApproxMetricTSP","type":"codeVoice"},{"type":"text","text":", LEMON "},{"code":"ChristofidesTsp","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Each piece is pinned, so the tour is: the matching is on the complete graph of the odd"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (pairs i < j lexicographic), and the circuit’s multigraph"},{"type":"text","text":" "},{"type":"text","text":"lists the tree edges by position, then the matched pairs in that order. At most 3\/2 × the"},{"type":"text","text":" "},{"type":"text","text":"shortest tour when the weights satisfy the triangle inequality (not checked)."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","title":"christofidesTour(weight:)","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit(from:)":{"url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit(from:)","type":"topic","abstract":[{"type":"text","text":"The Eulerian circuit from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" (NetworkX "},{"type":"codeVoice","code":"eulerian_circuit(G, source=)"},{"type":"text","text":"): the same"},{"type":"text","text":" "},{"type":"text","text":"walk; nil also when "},{"type":"codeVoice","code":"start"},{"type":"text","text":" has no edges."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Circuit","kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit(from:)","title":"eulerianCircuit(from:)","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/nearestNeighborTour(weight:)":{"title":"nearestNeighborTour(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nearestNeighborTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex (NetworkX "},{"type":"codeVoice","code":"greedy_tsp"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"NearestNeighborHeuristicTSP(first)"},{"type":"text","text":", whose default starts at a random vertex): repeatedly"},{"type":"text","text":" "},{"type":"text","text":"the nearest unvisited vertex, the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)","kind":"symbol"},"doc://Tours/documentation/Tours":{"url":"\/documentation\/tours","title":"Tours","identifier":"doc:\/\/Tours\/documentation\/Tours","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"title":"hamiltonianPath()","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"text":"vertex’s ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" in order to an unvisited vertex (Mathematica","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FindHamiltonianPath"},{"text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts","type":"text"},{"text":" ","type":"text"},{"text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few","type":"text"},{"text":" ","type":"text"},{"text":"usable neighbours), so it keeps the order. Without a start the search is run again from","type":"text"},{"text":" ","type":"text"},{"text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n","type":"text"},{"text":" ","type":"text"},{"text":"searches.","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","kind":"symbol","type":"topic","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols":{"title":"GraphProtocols","url":"\/doc