,"text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"title":"nearestNeighborTour(weight:)","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit()":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()","title":"eulerianCircuit()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks7CircuitV","text":"Circuit","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order with an edge; nil when the graph is not Eulerian or has no edges"},{"type":"text","text":" "},{"type":"text","text":"(a "},{"type":"codeVoice","code":"Circuit"},{"type":"text","text":" has at least one). Pinned: from the current vertex the first unused edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop, twice in its row, is taken once), in the stack form"},{"type":"text","text":" "},{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"igraph_eulerian_cycle"},{"type":"text","text":" runs; the circuit is listed forward from that vertex."}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit()","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","title":"Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hasEulerianTrail":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hasEulerianTrail","title":"hasEulerianTrail","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasEulerianTrail","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","abstract":[{"text":"Whether some trail uses every edge exactly once (NetworkX ","type":"text"},{"type":"codeVoice","code":"has_eulerian_path"},{"text":", igraph’