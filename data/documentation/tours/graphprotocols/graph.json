e first Hamiltonian path from ","type":"text"},{"type":"codeVoice","code":"start"},{"text":", in the same search order.","type":"text"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath(from:)","role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail(from:)":{"abstract":[{"type":"text","text":"An Eulerian trail from "},{"type":"codeVoice","code":"start"},{"type":"text","text":", or nil when none starts there (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"has_eulerian_path(G, source)"},{"type":"text","text":"): "},{"type":"codeVoice","code":"start"},{"type":"text","text":" must be one of the two odd vertices, or, in an"},{"type":"text","text":" "},{"type":"text","text":"Eulerian graph, any vertex with an edge, or any vertex at all when there are no edges."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail(from:)","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail(from:)","title":"eulerianTrail(from:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5TrailV","kind":"typeIdentifier","text":"Trail"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"title":"hamiltonianPath()","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" in order to an unvisited vertex (Mathematica"},{"type":"text","text":" "},{"type":"codeVoice","code":"FindHamiltonianPath"},{"type":"text","text":"). Self-loops never help; one vertex is the trivial path. Pruning cuts"},{"type":"text","text":" "},{"type":"text","text":"only subtrees with no solution (an unvisited vertex unreachable, or left with too few"},{"type":"text","text":" "},{"type":"text","text":"usable neighbours), so it keeps the order. Without a start the search is run again from"},{"type":"text","text":" "},{"type":"text","text":"each vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n"},{"type":"text","text":" "},{"type":"text","text":"searches."}],"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()","role":"symbol","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail()":{"abstract":[{"type":"text","text":"An Eulerian trail (NetworkX "},{"type":"codeVoice","code":"eulerian_path"},{"type":"text","text":", igraph "},{"type":"codeVoice","code":"igraph_eulerian_path"},{"type":"text","text":"), or nil when"},{"type":"text","text":" "},{"type":"text","text":"there is none or the graph has no vertex. It starts at the first odd vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order, or, when the graph is Eulerian, at the first vertex with an edge (the circuit as a"},{"type":"text","text":" "},{"type":"text","text":"closed trail); it is the trivial trail at the first vertex when there are no edges."},{"type":"text","text":" "},{"type":"text","text":"Hierholzer’s walk, as "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":"."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianTrail()","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriantrail()","title":"eulerianTrail()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianTrail"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5TrailV","text":"Trail"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit(from:)":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Circuit","kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"title":"eulerianCircuit(from:)","abstract":[{"type":"text","text":"The Eulerian circuit from "},{"code":"start","type":"codeVoice"},{"type":"text","text":" (NetworkX "},{"code":"eulerian_circuit(G, source=)","type":"codeVoice"},{"type":"text","text":"): the same"},{"type":"text","text":" "},{"type":"text","text":"walk; nil also when "},{"code":"start","type":"codeVoice"},{"type":"text","text":" has no edges."}],"url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit(from:)","role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"abstract":[{"text":"Christofides’ tour (Christofides, “Worst-case analysis of a new heuristic for the","type":"text"},{"text":" ","type":"text"},{"text":"travelling salesman problem”, Report 388, Carnegie Mellon University, 1976; found","type":"text"},{"text":" ","type":"text"},{"text":"independently by Serdyukov, 1978): the canonical minimum spanning tree (weight, then","type":"text"},{"text":" ","type":"text"},{"text":"position: SpanningTrees’ ","type":"text"},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"text":", by Prim on the dense matrix), a","type":"text"},{"text":" ","type":"text"},{"text":"minimum-weight perfect matching on its odd-degree vertices (MatchingModule’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"minimumWeightMatching"},{"text":", Galil’s blossom), an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"christofides"},{"text":", JGraphT ","type":"text"},{"type":"codeVoice","code":"ChristofidesThreeHalvesApproxMetricTSP"},{"text":", LEMON ","type":"text"},{"type":"codeVoice","code":"ChristofidesTsp"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Each piece is pinned, so the tour is: the matching is on the complete graph of the odd","type":"text"},{"text":" ","type":"text"},{"text":"vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (pairs i < j lexicographic), and the circuit’s multigraph","type":"text"},{"text":" ","type":"text"},{"text":"lists the tree edges by position, then the matched pairs in that order. At most 3\/2 × the","type":"text"},{"text":" ","type":"text"},{"text":"shortest tour when the weights satisfy the triangle inequality (not checked).","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","title":"christofidesTour(weight:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/shortestTour(weight:)":{"abstract":[{"text":"The shortest tour, by Held–Karp dynamic programming (Bellman, “Dynamic programming","type":"text"},{"text":" ","type":"text"},{"text":"treatment of the travelling salesman problem”, Journal of the ACM 9, 1962; Held and Karp,","type":"text"},{"text":" ","type":"text"},{"text":"“A dynamic programming approach to sequencing problems”, Journal of SIAM 10, 1962): the","type":"text"},{"text":" ","type":"text"},{"text":"least-weight Hamiltonian cycle of the simple graph, or nil when there is none; among the","type":"text"},{"text":" ","type":"text"},{"text":"optimal ones, the lexicographically least by vertex number listed from the first vertex","type":"text"},{"text":" ","type":"text"},{"text":"(JGraphT ","type":"text"},{"type":"codeVoice","code":"HeldKarpTSP"},{"text":"’s tour). The graph need not be complete: a missing pair is an absent","type":"text"},{"text":" ","type":"text"},{"text":"edge. Tours read the simple graph, as ","type":"text"},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"text":" documents; nil below","type":"text"},{"text":" ","type":"text"},{"text":"three vertices.","type":"text"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)","title":"shortestTour(weight:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}]},"doc://Tours/documentation/Tours/GraphProtocols":{"kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","abstract":[],"type":"topic","role":"collection"}}}