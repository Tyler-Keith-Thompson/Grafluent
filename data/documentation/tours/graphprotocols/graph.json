:".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"abstract":[{"type":"text","text":"The Eulerian circuit from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" (NetworkX "},{"type":"codeVoice","code":"eulerian_circuit(G, source=)"},{"type":"text","text":"): the same"},{"type":"text","text":" "},{"type":"text","text":"walk; nil also when "},{"type":"codeVoice","code":"start"},{"type":"text","text":" has no edges."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit(from:)","type":"topic","title":"eulerianCircuit(from:)","role":"symbol","kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit()":{"role":"symbol","type":"topic","abstract":[{"text":"An Eulerian circuit by Hierholzer’s algorithm (Hierholzer and Wiener 1873), from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order with an edge; nil when the graph is not Eulerian or has no edges","type":"text"},{"text":" ","type":"text"},{"text":"(a ","type":"text"},{"code":"Circuit","type":"codeVoice"},{"text":" has at least one). Pinned: from the current vertex the first unused edge in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order (a self-loop, twice in its row, is taken once), in the stack form","type":"text"},{"text":" ","type":"text"},{"text":"igraph’s ","type":"text"},{"code":"igraph_eulerian_cycle","type":"codeVoice"},{"text":" runs; the circuit is listed forward from that vertex.","type":"text"}],"kind":"symbol","title":"eulerianCircuit()","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerianC