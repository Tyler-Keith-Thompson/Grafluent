"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hamiltonianPath"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV","text":"Path"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianPath()","url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltonianpath()"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/twoOptTour(improving:weight:)":{"title":"twoOptTour(improving:weight:)","type":"topic","abstract":[{"type":"codeVoice","code":"tour"},{"type":"text","text":" improved by 2-opt to a 2-optimal tour, by JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"TwoOptHeuristicTSP.improveTour"},{"type":"text","text":"‘s procedure: best improvement, the first move (i, j) in"},{"type":"text","text":" "},{"type":"text","text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains."},{"type":"text","text":" "},{"type":"text","text":"LEMON’s "},{"code":"Opt2Tsp","type":"codeVoice"},{"type":"text","text":" shares the name only: it takes the first improving move and restarts the"},{"type":"text","text":" "},{"type":"text","text":"scan, which ends at a different tour. The first vertex of "},{"code":"tour","type":"codeVoice"},{"type":"text","text":" stays first. Only"},{"type":"text","text":" "},{"code":"tour.vertices","type":"codeVoice"},{"type":"text","text":" is read: the result uses the lightest edge of each pair, as every tour"},{"type":"text","text":" "},{"type":"text","text":"does. nil below three vertices."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"twoOptTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"improving"},{"kind":"text","text":": "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)","url":"\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianCircuit(from:)":{"abstract":[{"type":"text","text":"The Eulerian circuit from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" (NetworkX "},{"type":"codeVoice","code":"eulerian_circuit(G, source=)"},{"type":"text","text":"): the same"},{"type":"text","text":" "},{"type":"text","text":"walk; nil also when "},{"type":"codeVoice","code":"start"},{"type":"text","text":" has no edges."}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/eulerianCircuit(from:)","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/euleriancircuit(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerianCircuit","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Circuit","kind":"typeIdentifier","preciseIdentifier":"s:5Walks7CircuitV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"role":"symbol","title":"eulerianCircuit(from:)"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianCycle()":{"title":"hamiltonianCycle()","abstract":[{"type":"text","text":"A Hamiltonian cycle, or nil (Mathematica "},{"type":"codeVoice","code":"FindHamiltonianCycle"},{"type":"text","text":"): the search from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, closed by the first unused edge of the last vertex’s row back to it. It leaves the"},{"type":"text","text":" "},{"type":"text","text":"first vertex through the lesser of its two edges in that vertex’s row (the search meets"},{"type":"text","text":" "},{"type":"text","text":"that orientation first), as Cycles’ canonical form does. A self-loop is the cycle of a"},{"type":"text","text":" "},{"type":"text","text":"one-vertex graph and two parallel edges the cycle of a two-vertex one (the "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" type’s"},{"type":"text","text":" "},{"type":"text","text":"rules)."}],"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"url":"\/documentation\/tours\/graphprotocols\/graph\/hamiltoniancycle()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/hamiltonianCycle()","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/eulerianTrail()":{"identifier":"doc:\/\/Tours\/