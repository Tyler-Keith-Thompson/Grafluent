es"},{"text":" in order to an unvisited vertex. Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no","type":"text"},{"text":" ","type":"text"},{"text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or","type":"text"},{"text":" ","type":"text"},{"text":"successor), so it keeps the order. Without a start the search is run again from each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Path","identifier":"doc:\/\/Walks\/documentation\/Walks\/Path","kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"Exponential in the worst case (n! paths); O(degree) per step of the search,","type":"text"},{"text":" ","type":"text"},{"text":"plus O(n + m) for the reachability test where it can fail (not after a step from a","type":"text"},{"text":" ","type":"text"},{"text":"vertex with no other unvisited successor, so a path or cycle graph takes O(n + m)).","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph":{"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/directedgraph","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","title":"DirectedGraph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}]},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/hamiltonianPath()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hamiltonianPath","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Path","preciseIdentifier":"s:5Walks4PathV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"title":"hamiltonianPath()","abstract":[{"type":"text","text":"A Hamiltonian path, or nil when there is none (or no vertex): the first one a depth-first"},{"type":"text","text":" "},{"type":"text","text":"backtracking search finds, from each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, extending through each"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"code":"outEdges","type":"codeVoice"},{"type":"text","text":" in order to an unvisited vertex. Self-loops never help; one vertex is the trivial path. Pruning cuts only subtrees with no"},{"type":"text","text":" "},{"type":"text","text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or"},{"type":"text","text":" "},{"type":"text","text":"successor), so it keeps the order. Without a start the search is run again from each"},{"type":"text","text":" "},{"type":"text","text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches."}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/tours\/graphprotocols\/directedgraph\/hamiltonianpath()","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/hamiltonianPath()"},"doc://Tours/documentation/Tours":{"role":"collection","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","abstract":[],"kind":"symbol","url":"\/documentation\/tours","title":"Tours"},"doc://Tours/documentation/Tours/GraphProtocols":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","abstract":[],"role":"collection","kind":"symbol"},"doc://Walks/documentation/Walks/Path":{"role":"symbol","type":"topic","identifier":"doc:\/\/Walks\/documentation\/Walks\/Path","abstract":[{"text":"A path: a walk that repeats no vertex, and so no edge.","type":"text"}],"kind":"symbol","url":"\/documentation\/walks\/path","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}],"navigatorTitle":[{"kind":"identifier","text":"P