ertex is the trivial path. Pruning cuts only subtrees with no"},{"type":"text","text":" "},{"type":"text","text":"solution (an unvisited vertex unreachable, or left without a usable predecessor or"},{"type":"text","text":" "},{"type":"text","text":"successor), so it keeps the order. Without a start the search is run again from each"},{"type":"text","text":" "},{"type":"text","text":"vertex in turn until one succeeds, so a graph with no Hamiltonian path costs n searches."}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"kind":"symbol","title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"kind":"symbol","abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","title":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols":{"type":"topic","kind":"symbol","title":"GraphProtocols","abstract":[],"url":"\/documentation\/tours\/graphprotocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph","abstra