ype":"codeVoice","code":"Int"},{"text":"; the total imbalance","type":"text"},{"text":" ","type":"text"},{"text":"times the sum of the weights fits in ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" (the flow’s cost bound); the tour’s weight","type":"text"},{"text":" ","type":"text"},{"text":"fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The network simplex on n vertices and m edges, plus O(n + m + the"},{"type":"text","text":" "},{"type":"text","text":"duplicates) for the walk."}]}],"name":"Complexity","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/directedgraph\/chinesepostmantour(weight:)"]}],"abstract":[{"text":"The shortest closed walk along every edge at least once, in its direction (the directed","type":"text"},{"text":" ","type":"text"},{"text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the","type":"text"},{"text":" ","type":"text"},{"text":"graph has no edge or the vertices with edges are not strongly connected. Isolated vertices","type":"text"},{"text":" ","type":"text"},{"text":"are ignored.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph"]]},"sections":[],"metadata":{"roleHeading":"Instance Method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols08DirectedA0P5ToursE18chinesePostmanTour6weightAD0fG0Vy6VertexQz5Edges_5IndexQZqd__GSgqd__AMXE_tSZRd__lF","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":