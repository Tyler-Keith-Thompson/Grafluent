gative, and every weight fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; the total imbalance","type":"text"},{"text":" ","type":"text"},{"text":"times the sum of the weights fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (the flow’s cost bound); the tour’s weight","type":"text"},{"text":" ","type":"text"},{"text":"fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The network simplex on n vertices and m edges, plus O(n + m + the"},{"type":"text","text":" "},{"type":"text","text":"duplicates) for the walk."}]}],"name":"Complexity","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph"]]},"abstract":[{"text":"The shortest closed walk along every edge at least once, in its direction (the directed","type":"text"},{"text":" ","type":"text"},{"text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the","type":"text"},{"text":" ","type":"text"},{"text":"graph has no edge or the vertices with edges are not strongly connected. Isolated vertices","type":"text"},{"text":" ","type":"text"},{"text":"are ignored.","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"kind":"symbol","title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","role":"symbol"},"doc://GraphP