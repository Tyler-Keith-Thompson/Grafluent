:"Int"},{"type":"text","text":"; the total imbalance"},{"type":"text","text":" "},{"type":"text","text":"times the sum of the weights fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the flow’s cost bound); the tour’s weight"},{"type":"text","text":" "},{"type":"text","text":"fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The network simplex on n vertices and m edges, plus O(n + m + the","type":"text"},{"text":" ","type":"text"},{"text":"duplicates) for the walk.","type":"text"}]}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/chinesePostmanTour(weight:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"The shortest closed walk along every edge at least once, in its direction (the directed","type":"text"},{"text":" ","type":"text"},{"text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the","type":"text"},{"text":" ","type":"text"},{"text":"graph has no edge or the vertices with edges are not strongly connected. Isolated vertices","type":"text"},{"text":" ","type":"text"},{"text":"are ignored.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdent