","text":"Index","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV","text":"PostmanTour","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SZ","text":"SignedInteger","kind":"typeIdentifier"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour, the edges it duplicates (each once per extra copy) and its weight; nil"},{"type":"text","text":" "},{"type":"text","text":"when there is none."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Each vertex with more edges in than out sends the difference, at each edge’s weight per"},{"type":"text","text":" "},{"type":"text","text":"copy, to the vertices with more out than in: "},{"type":"codeVoice","code":"minimumCostFlow(supply:capacity:cost:)"},{"type":"text","text":" "},{"type":"text","text":"(the network simplex) on the graph, every edge’s capacity the total imbalance. An edge’s"},{"type":"text","text":" "},{"type":"text","text":"flow is the number of times it is duplicated. The walk is Hierholzer’s on the out-rows,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out-edges in position order followed by their copies in position order, from"},{"type":"text","text":" "},{"type":"text","text":"the first vertex with an edge. Self-loops are walked once and never duplicated. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per edge, in position order, before any work."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"No weight is negative, and every weight fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; the total imbalance"},{"type":"text","text":" "},{"type":"text","text":"times the sum of the weights fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the flow’s cost bound); the tour’s weight"},{"type":"text","text":" "},{"type":"text","text":"fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"The network simplex on n vertices and m edges, plus O(n + m + the"},{"type":"text","text":" "},{"type":"text","text":"duplicates) for the walk."}],"type":"paragraph"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The shortest closed walk along every edge at least once, in its direction (the directed"},{"type":"text","text":" "},{"type":"text","text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the"},{"type":"text","text":" "},{"type":"text","text":"graph has no edge or the vertices with edges are not strongly connected. Isolated vertices"},{"type":"text","text":" "},{"type":"text","text":"are ignored."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/directedgraph\/chinesepostmantour(weight:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/chinesePostmanTour(weight:)"},"references":{"doc://Tours/documentation/Tours/PostmanTour":{"abstract":[{"text":"A shortest closed walk through every edge at least once: the answer to the Chinese postman","type":"text"},{"text":" ","type":"text"},{"text":"problem, returned by ","type":"text"},{"code":"chinesePostmanTour(weight:)","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostmanTour","kind":"identifier"}],"url":"\/documentation\/tours\/postmantour","kind":"symbol","type":"topic","identifier":"