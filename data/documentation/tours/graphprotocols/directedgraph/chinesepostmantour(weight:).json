:"codeVoice","code":"Int"},{"text":" (the flow’s cost bound); the tour’s weight","type":"text"},{"text":" ","type":"text"},{"text":"fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":".","type":"text"}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"inlineContent":[{"text":"The network simplex on n vertices and m edges, plus O(n + m + the","type":"text"},{"text":" ","type":"text"},{"text":"duplicates) for the walk.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Complexity"}]}],"metadata":{"modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/ChinesePostman.swift#L288","fileName":"ChinesePostman.swift"},"symbolKind":"method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Tours11PostmanTourV","text":"PostmanTour","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"tex