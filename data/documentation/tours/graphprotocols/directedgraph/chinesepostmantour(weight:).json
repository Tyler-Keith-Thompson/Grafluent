{"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph"]]},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The shortest closed walk along every edge at least once, in its direction (the directed","type":"text"},{"text":" ","type":"text"},{"text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the","type":"text"},{"text":" ","type":"text"},{"text":"graph has no edge or the vertices with edges are not strongly connected. Isolated vertices","type":"text"},{"text":" ","type":"text"},{"text":"are ignored.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","text":"PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"}]}]},{"kind":"parameters","parameters":[{"name":"weight","content":[{"inlineContent":[{"text":"The length of the edge at a position.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The tour, the edges it duplicates (each once per extra copy) and its weight; nil","type":"text"},{"text":" ","type":"text"},{"text":"when there is none.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Each vertex with more edges in than out sends the difference, at each edge’s weight per"},{"type":"text","text":" "},{"type":"text","text":"copy, to the vertices with more out than in: "},{"code":"minimumCostFlow(supply:capacity:cost:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(the network simplex) on the graph, every edge’s capacity the total imbalance. An edge’s"},{"type":"text","text":" "},{"type":"text","text":"flow is the number of times it is duplicated. The walk is Hierholzer’s on the out-rows,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out-edges in position order followed by their copies in position order, from"},{"type":"text","text":" "},{"type":"text","text":"the first vertex with an edge. Self-loops are walked once and never duplicated. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per edge, in position order, before any work."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"No weight is negative, and every weight fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; the total imbalance","type":"text"},{"text":" ","type":"text"},{"text":"times the sum of the weights fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (the flow’s cost bound); the tour’s weight","type":"text"},{"text":" ","type":"text"},{"text":"fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"note","type":"aside"},{"name":"Complexity","content":[{"inlineContent":[{"text":"The network simplex on n vertices and m edges, plus O(n + m + the","type":"text"},{"text":" ","type":"text"},{"text":"duplicates) for the walk.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/chinesePostmanTour(weight:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/directedgraph\/chinesepostmantour(weight:)"]}],"metadata":{"extendedModule":"GraphProtocols","role":"symbol","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/ChinesePostman.swift#L288","fileName":"ChinesePostman.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"text":"<","kind":"text"},{"text":"W","kin