xt":" "},{"type":"text","text":"flow is the number of times it is duplicated. The walk is Hierholzer’s on the out-rows,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out-edges in position order followed by their copies in position order, from"},{"type":"text","text":" "},{"type":"text","text":"the first vertex with an edge. Self-loops are walked once and never duplicated. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per edge, in position order, before any work."}],"type":"paragraph"},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"No weight is negative, and every weight fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; the total imbalance","type":"text"},{"text":" ","type":"text"},{"text":"times the sum of the weights fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (the flow’s cost bound); the tour’s weight","type":"text"},{"text":" ","type":"text"},{"text":"fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"note"},{"name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The network simplex on n vertices and m edges, plus O(n + m + the"},{"type":"text","text":" "},{"type":"text","text":"duplicates) for the walk."}]}],"style":"note"}]}],"references":{"doc://Tours/documentation/Tours/PostmanTour":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","abstract":[{"text":"A shortest closed walk through every edge at least once: the answer to the Chinese postman","type":"text"},{"text":" ","type":"text"},{"text":"problem, returned by ","type":"text"},{"code":"chinesePostmanTour(weight:)","type":"codeVoice"},{"text":".","type":"text"}],"title":"PostmanTour","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Postma