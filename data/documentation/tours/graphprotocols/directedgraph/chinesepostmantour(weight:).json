er":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}],"platforms":["Linux"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}],"name":"weight"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The tour, the edges it duplicates (each once per extra copy) and its weight; nil","type":"text"},{"text":" ","type":"text"},{"text":"when there is none.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each vertex with more edges in than out sends the difference, at each edge’s weight per"},{"type":"text","text":" "},{"type":"text","text":"copy, to the vertices with more out than in: "},{"type":"codeVoice","code":"minimumCostFlow(supply:capacity:cost:)"},{"type":"text","text":" "},{"type":"text","text":"(the network simplex) on the graph, every edge’s capacity the total imbalance. An edge’s"},{"type":"text","text":" "},{"type":"text","text":"flow is the number of times it is duplicated. The walk is Hierholzer’s on the out-rows,"},{"type":"t