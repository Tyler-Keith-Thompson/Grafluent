de":"Int","type":"codeVoice"},{"type":"text","text":"; the total imbalance"},{"type":"text","text":" "},{"type":"text","text":"times the sum of the weights fits in "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" (the flow’s cost bound); the tour’s weight"},{"type":"text","text":" "},{"type":"text","text":"fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The network simplex on n vertices and m edges, plus O(n + m + the","type":"text"},{"text":" ","type":"text"},{"text":"duplicates) for the walk.","type":"text"}]}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"abstract":[{"type":"text","text":"The shortest closed walk along every edge at least once, in its direction (the directed"},{"type":"text","text":" "},{"type":"text","text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the"},{"type":"text","text":" "},{"type":"text","text":"graph has no edge or the vertices with edges are not strongly connected. Isolated vertices"},{"type":"text","text":" "},{"type":"text","text":"are ignored."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/chinesePostmanTour(weight:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/chinesePostmanTour(weight:)":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/chinesepostmantour(weight:)","kind":"symbol","title":"chinesePostmanTour(weight:)","abstract":[{"text":"The shortest closed walk along every edge at least once, in its direction (the directed","type":"text"},{"text":" ","type":"text"},{"text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the","type":"text"},{"text":" ","type":"text"},{"text":"gr