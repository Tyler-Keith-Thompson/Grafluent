documentation\/tours\/graphprotocols\/directedgraph\/chinesepostmantour(weight:)"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV","kind":"typeIdentifier","text":"PostmanTour"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SZ","kind":"typeIdentifier","text":"SignedInteger"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The length of the edge at a position.","type":"text"}]}],"name":"weight"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour, the edges it duplicates (each once per extra copy) and its weight; nil"},{"type":"text","text":" "},{"type":"text","text":"when there is none."}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Each vertex with more edges in than out sends the difference, at each edge’s weight per","type":"text"},{"text":" ","type":"text"},{"text":"copy, to the vertices with more out than in: ","type":"text"},{"type":"codeVoice","code":"minimumCostFlow(supply:capacity:cost:)"},{"text":" ","type":"text"},{"text":"(the network simplex) on the graph, every edge’s capacity the total imbalance. An edge’s","type":"text"},{"text":" ","type":"text"},{"text":"flow is the number of times it is duplicated. The walk is Hierholzer’s on the out-rows,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s out-edges in position order followed by their copies in position order, from","type":"text"},{"text":" ","type":"text"},{"text":"the first vertex with an edge. Self-loops are walked once and never duplicated. ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"called once per edge, in position order, before any work.","type":"text"}]},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"text":"No weight is negative, and every weight fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; the total imbalance","type":"text"},{"text":" ","type":"text"},{"text":"times the sum of the weights fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (the flow’s cost bound); the tour’s weight","type":"text"},{"text":" ","type":"text"},{"text":"fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"The network simplex on n vertices and m edges, plus O(n + m + the","type":"text"},{"text":" ","type":"text"},{"text":"duplicates) for the walk.","type":"text"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"abstract":[{"text":"The shortest closed walk along every edge at least once, in its direction (the directed","type":"text"},{"text":" ","type":"text"},{"text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the","type":"text"},{"text":" ","type":"text"},{"text":"graph has no edge or the vertices with edges are not strongly connected. Isolated vertices","type":"text"},{"text":" ","type":"text"},{"text":"are ignored.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/chinesePostmanTour(weight:)"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph"]]},"references":{"doc://Tours/documentation/Tours":{"role":"collection","abstract":[],"url":"\/documentation\/tours","identifier":"doc:\/\/Tours\/documentation\/Tours","type":"topic","kind":"symbol","title":"Tours"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"title":"Vertex","role":"symbol","type":"topic",