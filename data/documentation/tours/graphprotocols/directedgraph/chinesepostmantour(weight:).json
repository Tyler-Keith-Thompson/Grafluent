a","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","preciseIdentifier":"s:SZ","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"text":"The tour, the edges it duplicates (each once per extra copy) and its weight; nil","type":"text"},{"text":" ","type":"text"},{"text":"when there is none.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Each vertex with more edges in than out sends the difference, at each edge’s weight per","type":"text"},{"text":" ","type":"text"},{"text":"copy, to the vertices with more out than in: ","type":"text"},{"type":"codeVoice","code":"minimumCostFlow(supply:capacity:cost:)"},{"text":" ","type":"text"},{"text":"(the network simplex) on the graph, every edge’s capacity the total imbalance. An edge’s","type":"text"},{"text":" ","type":"text"},{"text":"flow is the number of times it is duplicated. The walk is Hierholzer’s on the out-rows,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s out-edges in position order followed by their copies in position order, from","type":"text"},{"text":" ","type":"text"},{"text":"the first vertex with an edge. Self-loops are walked once and never duplicated. ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"called once per edge, in position order, before any work.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is negative, and every weight fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; the total imbalance"},{"type":"text","text":" "},{"type":"text","text":"times the sum of the weights fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the flow’s cost bound); the tour’s weight"},{"type":"text","text":" "},{"type":"text","text":"fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The network simplex on n vertices and m edges, plus O(n + m + the"},{"type":"text","text":" "},{"type":"text","text":"duplicates) for the walk."}]}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/directedgraph\/chinesepostmantour(weight:)"]}],"sections":[],"references":{"doc://Tours/documentation/Tours/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/tours\/graphprotocols","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"title":"Vertex","role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","abstract":[],"kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"tex