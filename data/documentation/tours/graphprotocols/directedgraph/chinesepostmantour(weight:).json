tocols\/DirectedGraph\/Vertex"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The length of the edge at a position.","type":"text"}],"type":"paragraph"}],"name":"weight"}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The tour, the edges it duplicates (each once per extra copy) and its weight; nil"},{"type":"text","text":" "},{"type":"text","text":"when there is none."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each vertex with more edges in than out sends the difference, at each edge’s weight per"},{"type":"text","text":" "},{"type":"text","text":"copy, to the vertices with more out than in: "},{"type":"codeVoice","code":"minimumCostFlow(supply:capacity:cost:)"},{"type":"text","text":" "},{"type":"text","text":"(the network simplex) on the graph, every edge’s capacity the total imbalance. An edge’s"},{"type":"text","text":" "},{"type":"text","text":"flow is the number of times it is duplicated. The walk is Hierholzer’s on the out-rows,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out-edges in position order followed by their copies in position order, from"},{"type":"text","text":" "},{"type":"text","text":"the first vertex with an edge. Self-loops are walked once and never duplicated. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per edge, in position order, before any work."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is negative, and every weight fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; the total imbalance"},{"type":"text","text":" "},{"type":"text","text":"times the sum of the weights fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" (the flow’s cost bound); the tour’s weight"},{"type":"text","text":" "},{"type":"text","text":"fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"name":"Precondition","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The network simplex on n vertices and m edges, plus O(n + m + the"},{"type":"text","text":" "},{"type":"text","text":"duplicates) for the walk."}]}],"name":"Complexity","style":"note","type":"aside"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/DirectedGraph\/chinesePostmanTour(weight:)"},"references":{"doc://Tours/documentation/Tours/GraphProtocols/DirectedGraph/chinesePostmanTour(weight:)":{"url":"\/documentation\/tours\/graphprotocols\/directedgraph\/chinesepostmantour(weight:)","title":"chinesePostmanTour(weight:)","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The shortest closed walk along every edge at least once, in its direction (the directed"},{"type":"text","text":" "},{"type":"text","text":"Chinese postman problem), by minimum-cost flow (Edmonds and Johnson 1973), or nil when the"},{"type"