{"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/chinesePostmanTour(weight:)-2g97x","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/chinesepostmantour(weight:)-2g97x"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"PostmanTour","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour, the edges it duplicates and its weight; nil when there is none."}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest"},{"type":"text","text":" "},{"type":"text","text":"distances (Dijkstra, then "},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":"‘s blossom algorithm on their complete"},{"type":"text","text":" "},{"type":"text","text":"graph, pairs i < j lexicographic in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order), and each matched pair’s shortest"},{"type":"text","text":" "},{"type":"text","text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":" takes it, from the first vertex with an edge, on the multigraph of the"},{"type":"text","text":" "},{"type":"text","text":"edges in position order followed by the duplicated ones in position order, each vertex’s"},{"type":"text","text":" "},{"type":"text","text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order, before any work."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}]}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the","type":"text"},{"text":" ","type":"text"},{"text":"number of odd-degree vertices; O(n + m + k²) memory.","type":"text"}]}]}]}],"kind":"symbol","sections":[],"metadata":{"role":"symbol","externalID":"s:14GraphProtocols0A0P5ToursE18chinesePostmanTour6weightAD0eF0Vy6VertexQz5Edges_5IndexQZqd__GSgqd__AMXE_tSZRd__lF","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/ChinesePostman.swift#L239","fileName":"ChinesePostman.swift"},"title":"chinesePostmanTour(weight:)","symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":