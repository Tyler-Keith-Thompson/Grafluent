eight","type":"codeVoice"},{"text":" is called once per edge, in position order, before any work.","type":"text"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":". When "},{"code":"W","type":"codeVoice"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"code":"FixedWidthInteger","type":"codeVoice"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"code":"W.max \/ 8","type":"codeVoice"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the"},{"type":"text","text":" "},{"type":"text","text":"number of odd-degree vertices; O(n + m + k²) memory."}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"metadata":{"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind