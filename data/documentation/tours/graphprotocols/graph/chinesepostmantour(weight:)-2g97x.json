{"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","preciseIdentifier":"s:SZ","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The length of the edge at a position.","type":"text"}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour, the edges it duplicates and its weight; nil when there is none."}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest"},{"type":"text","text":" "},{"type":"text","text":"distances (Dijkstra, then "},{"code":"minimumWeightMatching","type":"codeVoice"},{"type":"text","text":"‘s blossom algorithm on their complete"},{"type":"text","text":" "},{"type":"text","text":"graph, pairs i < j lexicographic in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order), and each matched pair’s shortest"},{"type":"text","text":" "},{"type":"text","text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as"},{"type":"text","text":" "},{"code":"eulerianCircuit()","type":"codeVoice"},{"type":"text","text":" takes it, from the first vertex with an edge, on the multigraph of the"},{"type":"text","text":" "},{"type":"text","text":"edges in position order followed by the duplicated ones in position order, each vertex’s"},{"type":"text","text":" "},{"type":"text","text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per edge, in position order, before any work."}],"type":"paragraph"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}]}],"name":"Precondition"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the"},{"type":"text","text":" "},{"type":"text","text":"number of odd-degree vertices; O(n + m + k²) memory."}],"type":"paragraph"}],"name":"Complexity"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The shortest closed walk through every edge at least once (the Chinese postman problem),","type":"text"},{"text":" ","type":"text"},{"text":"by Edmonds and Johnson’s algorithm, or nil when the graph has no edge or its edges are not","type":"text"},{"text":" ","type":"text"},{"text":"all connected. Isolated vertices are ignored.","type":"text"}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/chinesePostmanTour(weight:)-2g97x","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/chinesepostmantour(weight:)-2g97x"]}],"metadata":{"externalID":"s:14GraphProtocols0A0P5ToursE18chinesePostmanTour6weightAD0eF0Vy6VertexQz5Edges_5IndexQZqd__GSgqd__AMXE_tSZRd__lF","role":"symbol","remoteSource":{"fileName":"ChinesePostman.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/