{"metadata":{"externalID":"s:14GraphProtocols0A0P5ToursE18chinesePostmanTour6weightAD0eF0Vy6VertexQz5Edges_5IndexQZqd__GSgqd__AMXE_tSZRd__lF","title":"chinesePostmanTour(weight:)","role":"symbol","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/ChinesePostman.swift#L239","fileName":"ChinesePostman.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">?"}],"modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","extendedModule":"GraphProtocols"},"abstract":[{"text":"The shortest closed walk through every edge at least once (the Chinese postman problem),","type":"text"},{"text":" ","type":"text"},{"text":"by Edmonds and Johnson’s algorithm, or nil when the graph has no edge or its edges are not","type":"text"},{"text":" ","type":"text"},{"text":"all connected. Isolated vertices are ignored.","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","text":"PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}],"name":"weight"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour, the edges it duplicates and its weight; nil when there is none."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest","type":"text"},{"text":" ","type":"text"},{"text":"distances (Dijkstra, then ","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":"‘s blossom algorithm on their complete","type":"text"},{"text":" ","type":"text"},{"text":"graph, pairs i < j lexicographic in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order), and each matched pair’s shortest","type":"text"},{"text":" ","type":"text"},{"text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as","type":"text"},{"text":" ","type":"text"},{"code":"eulerianCircuit()","type":"codeVoice"},{"text":" takes it, from the first vertex with an edge, on the multigraph of the","type":"text"},{"text":" ","type":"text"},{"text":"edges in position order followed by the duplicated ones in position order, each vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge, in position order, before any work.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}]}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the"},{"type":"text","text":" "},{"type":"text","text":"number of odd-degree vertices; O(n + m + k²) memory."}]}],"type":"aside"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/chinesepostmantour(weight:)-2g97x"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/chinesePostmanTour(weight:)-2g97x","interfaceLanguage":"swift"},"references":{"doc://Tours/documentation/Tours":{"abstract":[],"url":"\/documentation\/tours","title":"Tours","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours","type":"topic","role":"collection"},"doc://Tours/documentation/Tours/PostmanTour":{"type":"topic","role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","abstract":[{"text":"A shortest closed walk through every edge at least once: the ans