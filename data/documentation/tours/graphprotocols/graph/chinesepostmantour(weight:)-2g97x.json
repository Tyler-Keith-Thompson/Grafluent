meters","parameters":[{"name":"weight","content":[{"inlineContent":[{"text":"The length of the edge at a position.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The tour, the edges it duplicates and its weight; nil when there is none."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest"},{"type":"text","text":" "},{"type":"text","text":"distances (Dijkstra, then "},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":"‘s blossom algorithm on their complete"},{"type":"text","text":" "},{"type":"text","text":"graph, pairs i < j lexicographic in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order), and each matched pair’s shortest"},{"type":"text","text":" "},{"type":"text","text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":" takes it, from the first vertex with an edge, on the multigraph of the"},{"type":"text","text":" "},{"type":"text","text":"edges in position order followed by the duplicated ones in position order, each vertex’s"},{"type":"text","text":" "},{"type":"text","text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order, before any work."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}],"type":"paragraph"}],"name":"Precondition","style":"note","type":"aside"},{"content":[{"inlineContent":[{"text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the","type":"text"},{"text":" ","type":"text"},{"text":"number of odd-degree vertices; O(n + m + k²) memory.","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note","type":"aside"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/chinesePostmanTour(weight:)-2g97x"},"abstract":[{"type":"text","text":"The shortest closed walk through every edge at least once (the Chinese postman problem),"},{"type":"text","text":" "},{"type":"text","text":"by Edmonds and Johnson’s algorithm, or nil when the graph has no edge or its edges are not"},{"type":"text","text":" "},{"type":"text","text":"all connected. Isolated vertices are ignored."}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"references":{"doc://Tours/documentation/Tours/PostmanTour":{"title":"PostmanTour","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","abstract":[{"text":"A shortest closed walk through every edge at least once: the answer to the Chinese postman","type":"text"},{"text":" ","type":"text"},{"text":"problem, returned by ","type":"text"},{"code":"chinesePostmanTour(weight:)","type":"codeVoice"},{"text":".","type":"text"}],"role