{"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"PostmanTour","kind":"typeIdentifier","preciseIdentifier":"s:5Tours11PostmanTourV","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour, the edges it duplicates and its weight; nil when there is none."}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest","type":"text"},{"text":" ","type":"text"},{"text":"distances (Dijkstra, then ","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":"‘s blossom algorithm on their complete","type":"text"},{"text":" ","type":"text"},{"text":"graph, pairs i < j lexicographic in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order), and each matched pair’s shortest","type":"text"},{"text":" ","type":"text"},{"text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as","type":"text"},{"text":" ","type":"text"},{"code":"eulerianCircuit()","type":"codeVoice"},{"text":" takes it, from the first vertex with an edge, on the multigraph of the","type":"text"},{"text":" ","type":"text"},{"text":"edges in position order followed by the duplicated ones in position order, each vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge, in position order, before any work.","type":"text"}]},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":". When "},{"code":"W","type":"codeVoice"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"code":"FixedWidthInteger","type":"codeVoice"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"code":"W.max \/ 8","type":"codeVoice"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the"},{"type":"text","text":" "},{"type":"text","text":"number of odd-degree vertices; O(n + m + k²) memory."}],"type":"paragraph"}],"type":"aside"}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/chinesePostmanTour(weight:)-2g97x","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The shortest closed walk through every edge at least once (the Chinese postman problem),","type":"text"},{"text":" ","type":"text"},{"text":"by Edmonds and Johnson’s algorithm, or nil when the graph has no edge or its edges are not","type":"text"},{"text":" ","type":"text"},{"text":"all connected. Isolated vertices are ignored.","type":"text"}],"metadata":{"externalID":"s:14GraphProtocols0A0P5ToursE18chinesePostmanTour6weightAD0eF0Vy6VertexQz5Edges_5IndexQZqd__GSgqd__AMXE_tSZRd__lF","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"title":"chinesePostmanTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"