h\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The tour, the edges it duplicates and its weight; nil when there is none.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest"},{"type":"text","text":" "},{"type":"text","text":"distances (Dijkstra, then "},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":"‘s blossom algorithm on their complete"},{"type":"text","text":" "},{"type":"text","text":"graph, pairs i < j lexicographic in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order), and each matched pair’s shortest"},{"type":"text","text":" "},{"type":"text","text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":" takes it, from the first vertex with an edge, on the multigraph of the"},{"type":"text","text":" "},{"type":"text","text":"edges in position order followed by the duplicated ones in position order, each vertex’s"},{"type":"text","text":" "},{"type":"text","text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order, before any work."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}],"type":"paragraph"}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the","type":"text"},{"text":" ","type":"text"},{"text":"number of odd-degree vertices; O(n + m + k²) memory.","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/chinesepostmantour(weight:)-2g97x"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","kind":"symbol","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"title":"E