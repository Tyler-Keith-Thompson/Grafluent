tocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The length of the edge at a position.","type":"text"}],"type":"paragraph"}],"name":"weight"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"text":"The tour, the edges it duplicates and its weight; nil when there is none.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest","type":"text"},{"text":" ","type":"text"},{"text":"distances (Dijkstra, then ","type":"text"},{"type":"codeVoice","code":"minimumWeightMatching"},{"text":"‘s blossom algorithm on their complete","type":"text"},{"text":" ","type":"text"},{"text":"graph, pairs i < j lexicographic in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order), and each matched pair’s shortest","type":"text"},{"text":" ","type":"text"},{"text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"eulerianCircuit()"},{"text":" takes it, from the first vertex with an edge, on the multigraph of the","type":"text"},{"text":" ","type":"text"},{"text":"edges in position order followed by the duplicated ones in position order, each vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is called once per edge, in position order, before any work.","type":"text"}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}],"type":"paragraph"}],"name":"Precondition"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the","type":"text"},{"text":" ","type":"text"},{"text":"number of odd-degree vertices; O(n + m + k²) memory.","type":"text"}]}],"name":"Complexity"}]}],"references":{"doc://Tours/documentation/Tours/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/tours\/graphprotocols","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text"