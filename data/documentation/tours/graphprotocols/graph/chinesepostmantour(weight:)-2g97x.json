{"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chinesePostmanTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"PostmanTour","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","kind":"typeIdentifier","preciseIdentifier":"s:5Tours11PostmanTourV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}],"name":"weight"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The tour, the edges it duplicates and its weight; nil when there is none."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest","type":"text"},{"text":" ","type":"text"},{"text":"distances (Dijkstra, then ","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":"‘s blossom algorithm on their complete","type":"text"},{"text":" ","type":"text"},{"text":"graph, pairs i < j lexicographic in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order), and each matched pair’s shortest","type":"text"},{"text":" ","type":"text"},{"text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as","type":"text"},{"text":" ","type":"text"},{"code":"eulerianCircuit()","type":"codeVoice"},{"text":" takes it, from the first vertex with an edge, on the multigraph of the","type":"text"},{"text":" ","type":"text"},{"text":"edges in position order followed by the duplicated ones in position order, each vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge, in position order, before any work.","type":"text"}]},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"No weight is negative; the tour’s weight fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"W","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":", with k odd-degree vertices, every distance d between two of them","type":"text"},{"text":" ","type":"text"},{"text":"satisfies k · (2 · d + 1) ≤ ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (the matching’s bound), checked as each distance is","type":"text"},{"text":" ","type":"text"},{"text":"found.","type":"text"}]}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the","type":"text"},{"text":" ","type":"text"},{"text":"number of odd-degree vertices; O(n + m + k²) memory.","type":"text"}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"The shortest closed walk through every edge at least once (the Chinese postman problem),"},{"type":"text","text":" "},{"type":"text","text":"by Edmonds and Johnson’s algorithm, or nil when the graph has no edge or its edges are not"},{"type":"text","text":" "},{"type":"text","text":"all connected. Isolated vertices are ignored."}],"kind":"symbol","identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/chinesePostmanTour(weight:)-2g97x","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/chinesepostmantour(weight:)-2g97x"]}],"metadata":{"role":"symbol","extendedModule":"GraphProtocols","symbolKind":"method","roleHeading":"Instance Method","remoteSource":{"fileName":"ChinesePostman.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/ChinesePostman.swift#L239"},"title":"chinesePostmanTour(weight:)","externalID":"s