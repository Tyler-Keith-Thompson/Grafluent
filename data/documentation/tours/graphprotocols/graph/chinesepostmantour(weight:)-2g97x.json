\/Sources\/Tours\/ChinesePostman.swift#L239"},"externalID":"s:14GraphProtocols0A0P5ToursE18chinesePostmanTour6weightAD0eF0Vy6VertexQz5Edges_5IndexQZqd__GSgqd__AMXE_tSZRd__lF"},"abstract":[{"text":"The shortest closed walk through every edge at least once (the Chinese postman problem),","type":"text"},{"text":" ","type":"text"},{"text":"by Edmonds and Johnson’s algorithm, or nil when the graph has no edge or its edges are not","type":"text"},{"text":" ","type":"text"},{"text":"all connected. Isolated vertices are ignored.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chinesePostmanTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"PostmanTour","identifier":"doc:\/\/Tours\/documentation\/Tours\/PostmanTour","preciseIdentifier":"s:5Tours11PostmanTourV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedInteger","preciseIdentifier":"s:SZ"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The length of the edge at a position.","type":"text"}]}],"name":"weight"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The tour, the edges it duplicates and its weight; nil when there is none.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest"},{"type":"text","text":" "},{"type":"text","text":"distances (Dijkstra, then "},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":"‘s blossom algorithm on their complete"},{"type":"text","text":" "},{"type":"text","text":"graph, pairs i < j lexicographic in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order), and each matched pair’s shortest"},{"type":"text","text":" "},{"type":"text","text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"eulerianCircuit()"},{"type":"text","text":" takes it, from the first vertex with an edge, on the multigraph of the"},{"type":"text","text":" "},{"type":"text","text":"edges in position order followed by the duplicated ones in position order, each vertex’s"},{"type":"text","text":" "},{"type":"text","text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order, before any work."}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"text":"No weight is negative; the tour’s weight fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"W"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FixedWidthInteger"},{"text":", with k odd-degree vertices, every distance d between two of them","type":"text"},{"text":" ","type":"text"},{"text":"satisfies k · (2 · d + 1) ≤ ","type":"text"},{"type":"codeVoice","code":"W.max \/ 8"},{"text":" (the matching’s bound), checked as each distance is","type":"text"},{"text":" ","type":"text"},{"text":"found.","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the","type":"text"},{"text":" ","type":"text"},{"text":"number of odd-degree vertices; O(n + m + k²) memory.","type":"text"}]}]}]}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/chinesepostmantour(weight:)-2g97x"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://Tours/documentation/Tours":{"role":"collection","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","abstract":[],"kind":"symbol","url":"\/documentation\/tours","title":"Tours"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","fragments":[{"kind":"