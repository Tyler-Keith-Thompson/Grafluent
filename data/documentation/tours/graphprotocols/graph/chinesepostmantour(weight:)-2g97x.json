":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","preciseIdentifier":"s:SZ","kind":"typeIdentifier"}]}]},{"parameters":[{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"inlineContent":[{"text":"The tour, the edges it duplicates and its weight; nil when there is none.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The odd-degree vertices are paired by a minimum-weight perfect matching on their shortest","type":"text"},{"text":" ","type":"text"},{"text":"distances (Dijkstra, then ","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":"‘s blossom algorithm on their complete","type":"text"},{"text":" ","type":"text"},{"text":"graph, pairs i < j lexicographic in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order), and each matched pair’s shortest","type":"text"},{"text":" ","type":"text"},{"text":"path is duplicated, except an edge on two of the paths. The walk is Hierholzer’s, as","type":"text"},{"text":" ","type":"text"},{"code":"eulerianCircuit()","type":"codeVoice"},{"text":" takes it, from the first vertex with an edge, on the multigraph of the","type":"text"},{"text":" ","type":"text"},{"text":"edges in position order followed by the duplicated ones in position order, each vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"row in that order (a self-loop twice). Parallel edges and self-loops are edges to walk. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge, in position order, before any work.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"No weight is negative; the tour’s weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", with k odd-degree vertices, every distance d between two of them"},{"type":"text","text":" "},{"type":"text","text":"satisfies k · (2 · d + 1) ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each distance is"},{"type":"text","text":" "},{"type":"text","text":"found."}],"type":"paragraph"}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(k (n + m) log n) for the searches and O(k³) for the matching, with k the"},{"type":"text","text":" "},{"type":"text","text":"number of odd-degree vertices; O(n + m + k²) memory."}],"type":"paragraph"}],"style":"note","name":"Complexity"}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/chinesePostmanTour(weight:)-2g97x","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/chinesepostmantour(weight:)-2g97x"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Tours/documentation/Tours/GraphProtocols":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","type":"topic","url":"\/documentation\/tours\/graphprotocols","title":"GraphProtocols","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swi