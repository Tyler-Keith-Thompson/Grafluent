ds at a different tour. The first vertex of "},{"type":"codeVoice","code":"tour"},{"type":"text","text":" stays first. Only"},{"type":"text","text":" "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" is read: the result uses the lightest edge of each pair, as every tour"},{"type":"text","text":" "},{"type":"text","text":"does. nil below three vertices."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)"},"references":{"doc://Tours/documentation/Tours/GraphProtocols":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","abstract":[],"type":"topic","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols"},"doc://Tours/documentation/Tours":{"kind":"symbol","url":"\/documentation\/tours","abstract":[],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","role":"collection","title":"Tours"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"abstract":[],"title":"Graph","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"},"doc://Walks/documentation/Walks/Cycle":{"navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/walks\/cycle","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph).