","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A move’s gain is formed as (d(a, b) + d(c, e)) − (d(a, c) + d(b, e)), and the scan stops"},{"type":"text","text":" "},{"type":"text","text":"when no move gains anything; JGraphT forms d(a, c) + d(b, e) − d(a, b) − d(c, e) and stops"},{"type":"text","text":" "},{"type":"text","text":"when no change is below −1e-8. The tour is JGraphT’s exactly on integers, and on floating"},{"type":"text","text":" "},{"type":"text","text":"weights whose sums are exactly representable (dyadic values of moderate size); otherwise"},{"type":"text","text":" "},{"type":"text","text":"rounding and the threshold can pick other moves, so the tours may differ."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" lists every vertex of the graph"},{"type":"text","text":" "},{"type":"text","text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}]},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n²) per improving move."}]}]}],"kind":"content"}],"abstract":[{"code":"tour","type":"codeVoice"},{"type":"text","text":" improved by 2-opt to a 2-optimal tour, by JGraphT"},{"type":"text","text":" "},{"code":"TwoOptHeuristicTSP.improveTour","type":"codeVoice"},{"type":"text","text":"‘s procedure: best improvement, the first move (i, j) in"},{"type":"text","text":" "},{"type":"text","text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains."},{"type":"text","text":" "},{"type":"text","text":"LEMON’s "},{"code":"Opt2Tsp","type":"codeVoice"},{"type":"text","text":" shares the name only: it takes the first improving move and restarts the"},{"type":"text","text":" "},{"type":"text","text":"scan, which ends at a different tour. The first vertex of "},{"code":"tour","type":"codeVoice"},{"type":"text","text":" stays first. Only"},{"type":"text","text":" "},{"code":"tour.vertices","type":"codeVoice"},{"type":"text","text":" is read: the result uses the lightest edge of each pair, as every tour"},{"type":"text","text":" "},{"type":"text","text":"does. nil below three vertices."}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"]}],"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Neighbors","preciseIdentifier":"s:14GraphProtocols0A0P9NeighborsQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"}],"abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Tours/documentation/Tours/GraphProtocols":{"abstract":[],"role":"collection","type":"topic","title":"GraphProtocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","url":"\/documentation\/tours\/graphprotocols","kind":"symbol"},"doc://Tours/documentation/Tours":{"abstract":[],"role":"collection","type":"topic","title":"Tours","identifier":"doc:\/\/Tours\/documentation\/Tour