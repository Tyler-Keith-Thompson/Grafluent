ve gains anything. With floating-point weights, rounding decides which moves"},{"type":"text","text":" "},{"type":"text","text":"gain."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" lists every vertex of the graph"},{"type":"text","text":" "},{"type":"text","text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"inlineContent":[{"text":"O(n²) per improving move.","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note"}]}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"code":"tour","type":"codeVoice"},{"text":" improved by 2-opt to a 2-optimal tour.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)"},"metadata":{"title":"twoOptTour(improving:weight:)","externalID":"s:14GraphProtocols0A0P5ToursE10twoOptTour9improving6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgAP_qd__AOXEts18AdditiveArithmeticRd__SLRd__lF","extendedModule":"GraphProtocols","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"twoOptTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"improving","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Cycle","kin