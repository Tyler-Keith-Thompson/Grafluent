r.vertices","type":"codeVoice"},{"type":"text","text":" lists every vertex of the graph"},{"type":"text","text":" "},{"type":"text","text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"aside","style":"note"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n²) per improving move."}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"code":"tour","type":"codeVoice"},{"text":" improved by 2-opt to a 2-optimal tour, by JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"TwoOptHeuristicTSP.improveTour","type":"codeVoice"},{"text":"‘s procedure: best improvement, the first move (i, j) in","type":"text"},{"text":" ","type":"text"},{"text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains.","type":"text"},{"text":" ","type":"text"},{"text":"LEMON’s ","type":"text"},{"code":"Opt2Tsp","type":"codeVoice"},{"text":" shares the name only: it takes the first improving move and restarts the","type":"text"},{"text":" ","type":"text"},{"text":"scan, which ends at a different tour. The first vertex of ","type":"text"},{"code":"tour","type":"codeVoice"},{"text":" stays first. Only","type":"text"},{"text":" ","type":"text"},{"code":"tour.vertices","type":"codeVoice"},{"text":" is read: the result uses the lightest edge of each pair, as every tour","type":"text"},{"text":" ","type":"text"},{"text":"does. nil below three vertices.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"metadata":{"modules":[{"name":"Tours","relatedMo