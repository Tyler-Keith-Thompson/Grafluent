xt":"when no move gains anything. With floating-point weights, rounding decides which moves","type":"text"},{"text":" ","type":"text"},{"text":"gain.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" lists every vertex of the graph"},{"type":"text","text":" "},{"type":"text","text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"type":"aside","name":"Precondition"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(n²) per improving move.","type":"text"}]}],"type":"aside","name":"Complexity"}]}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"abstract":[{"type":"codeVoice","code":"tour"},{"text":" improved by 2-opt to a 2-optimal tour.","type":"text"}],"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}],"externalID":"s:14GraphProtocols0A0P5ToursE10twoOptTour9improving6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgAP_qd__AOXEts18AdditiveArithmeticRd__SLRd__lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"twoOptTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"improving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex",