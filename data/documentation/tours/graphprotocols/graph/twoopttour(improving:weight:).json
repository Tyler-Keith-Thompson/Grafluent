nd":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Each round makes the best improving move, the first move (i, j) in row-major order on"},{"type":"text","text":" "},{"type":"text","text":"ties, until no exchange of two tour edges for two lighter ones remains. The first vertex of"},{"type":"text","text":" "},{"type":"codeVoice","code":"tour"},{"type":"text","text":" stays first. Only "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" is read: the result uses the lightest edge of each"},{"type":"text","text":" "},{"type":"text","text":"pair, as every tour does. nil below three vertices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A move’s gain is formed as (d(a, b) + d(c, e)) − (d(a, c) + d(b, e)), and the scan stops"},{"type":"text","text":" "},{"type":"text","text":"when no move gains anything. With floating-point weights, rounding decides which moves"},{"type":"text","text":" "},{"type":"text","text":"gain."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" lists every vertex of the graph"},{"type":"text","text":" "},{"type":"text","text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":"O(n²) per improving move."}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/