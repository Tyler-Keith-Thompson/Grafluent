oving:weight:)","role":"symbol"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"twoOptTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"improving"},{"kind":"text","text":" "},{"kind":"internalParam","text":"tour"},{"kind":"text","text":": "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A move’s gain is formed as (d(a, b) + d(c, e)) − (d(a, c) + d(b, e)), and the scan stops"},{"type":"text","text":" "},{"type":"text","text":"when no move gains anything; JGraphT forms d(a, c) + d(b, e) − d(a, b) − d(c, e) and stops"},{"type":"text","text":" "},{"type":"text","text":"when no change is below −1e-8. The tour is JGraphT’s exactly on integers, and on floating"},{"type":"text","text":" "},{"type":"text","text":"weights whose sums are exactly representable (dyadic values of moderate size); otherwise"},{"type":"text","text":" "},{"type":"text","text":"rounding and the threshold can pick other moves, so the tours may differ."}]},{"style":"note","type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete; ","type":"text"},{"type":"codeVoice","code":"tour.vertices"},{"text":" lists every vertex of the graph","type":"text"},{"text":" ","type":"text"},{"text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":".","type":"text"}]}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n²) per improving move."}]}]}],"kind":"content"}],"references":{"doc://Tours/documentation/Tours/GraphProtocols/Graph/twoOptTour(improving:weight:)":{"url":"\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)","type":"topic","role":"symbol","abstract":[{"type":"codeVoice","code":"tour"},{"type":"text","text":" improved by 2-opt to a 2-optimal tour, by JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"TwoOptHeuristicTSP.improveTour"},{"type":"text","text":"‘s procedure: best improvement, the first move (i, j) in"},{"type":"text","text":" "},{"type":"text","text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains."},{"type":"text","text":" "},{"type":"text","text":"LEMON’s "},{"type":"codeVoice","code":"Opt2Tsp"},{"type":"text","text":" shares the name only: it takes the first improving move and restarts the"},{"type":"text","text":" "},{"type":"text","text":"scan, which ends at a different tour. The first vertex of "},{"type":"codeVoice","code":"tour"},{"type":"text","text":" stays first. Only"},{"type":"text","text":" "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" is read: the result uses the lightest edge of each pair, as every tour"},{"type":"text","text":" "},{"type":"text","text":"does. nil below three vertices."}],"title":"twoOptTour(improving:weight:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)","kind":"symbol","fragments":[{"text":"func