type":"text"},{"code":"tour.vertices","type":"codeVoice"},{"text":" lists every vertex of the graph","type":"text"},{"text":" ","type":"text"},{"text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"inlineContent":[{"text":"O(n²) per improving move.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}]}],"references":{"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"url":"\/documentation\/tours\/graphprotocols\/graph","title":"Graph","abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","type":"topic","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Walks/documentation/Walks/Cycle":{"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"type":"topic","url":"\/documentation\/walks\/cycle","title":"Cycle","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier