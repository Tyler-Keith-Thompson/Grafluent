plete; "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" lists every vertex of the graph"},{"type":"text","text":" "},{"type":"text","text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Precondition"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O(n²) per improving move."}],"type":"paragraph"}],"type":"aside","name":"Complexity"}]}],"references":{"doc://Tours/documentation/Tours/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/twoOptTour(improving:weight:)":{"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)","url":"\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)","title":"twoOptTour(improving:weight:)","abstract":[{"type":"codeVoice","code":"tour"},{"type":"text","text":" improved by 2-opt to a 2-optimal tour, by JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"TwoOptHeuristicTSP.improveTour"},{"type":"text","text":"‘s procedure: best improvement, the first move (i, j) in"},{"type":"text","text":" "},{"type":"text","text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains."},{"type":"text","text":" "},{"type":"text","text":"LEMON’s "},{"type":"codeVoice","code":"Opt2Tsp"},{"type":"text","text":" shares the name only: it takes the first improving move and restarts the"},{"type":"text","text":" "},{"type":"text","text":"scan, which ends at a different tour. The first vertex of "},{"type":"codeVoice","code":"tour"},{"type":"text","text":" stays first. Only"},{"type":"text","text":" "},{"type":"codeVoice","code":"tour.vertices"},