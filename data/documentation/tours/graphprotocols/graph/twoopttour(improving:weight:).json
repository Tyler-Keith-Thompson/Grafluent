ur.vertices","type":"codeVoice"},{"type":"text","text":" is read: the result uses the lightest edge of each"},{"type":"text","text":" "},{"type":"text","text":"pair, as every tour does. nil below three vertices."}]},{"type":"paragraph","inlineContent":[{"text":"A move’s gain is formed as (d(a, b) + d(c, e)) − (d(a, c) + d(b, e)), and the scan stops","type":"text"},{"text":" ","type":"text"},{"text":"when no move gains anything. With floating-point weights, rounding decides which moves","type":"text"},{"text":" ","type":"text"},{"text":"gain.","type":"text"}]},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" lists every vertex of the graph"},{"type":"text","text":" "},{"type":"text","text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(n²) per improving move.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"code":"tour","type":"codeVoice"},{"type":"text","text":" improved by 2-opt to a 2-optimal tour."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Grap