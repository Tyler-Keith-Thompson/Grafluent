pe":"text","text":"when no move gains anything. With floating-point weights, rounding decides which moves"},{"type":"text","text":" "},{"type":"text","text":"gain."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete; ","type":"text"},{"code":"tour.vertices","type":"codeVoice"},{"text":" lists every vertex of the graph","type":"text"},{"text":" ","type":"text"},{"text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}]}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(n²) per improving move.","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/twoopttour(improving:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"extendedModule":"GraphProtocols","remoteSource":{"fileName":"TwoOpt.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/TwoOpt.swift#L135"},"title":"twoOptTour(improving:weight:)","externalID":"s:14GraphProtocols0A0P5ToursE10twoOptTour9improving6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgAP_qd__AOXEts18AdditiveArithmeticRd__SLRd__lF","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"twoOptTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"improving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIde