kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each round makes the best improving move, the first move (i, j) in row-major order on"},{"type":"text","text":" "},{"type":"text","text":"ties, until no exchange of two tour edges for two lighter ones remains. The first vertex of"},{"type":"text","text":" "},{"type":"codeVoice","code":"tour"},{"type":"text","text":" stays first. Only "},{"type":"codeVoice","code":"tour.vertices"},{"type":"text","text":" is read: the result uses the lightest edge of each"},{"type":"text","text":" "},{"type":"text","text":"pair, as every tour does. nil below three vertices."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A move’s gain is formed as (d(a, b) + d(c, e)) − (d(a, c) + d(b, e)), and the scan stops"},{"type":"text","text":" "},{"type":"text","text":"when no move gains anything. With floating-point weights, rounding decides which moves"},{"type":"text","text":" "},{"type":"text","text":"gain."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete; ","type":"text"},{"type":"codeVoice","code":"tour.vertices"},{"text":" lists every vertex of the graph","type":"text"},{"text":" ","type":"text"},{"text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":".","type":"text"}]}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n²) per improving move."}],"type":"paragraph"}],"name":"Complexity","style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Tours/documentation/Tours":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","title":"Tours","abstract":[],"kind":"symbol","url":"\/doc