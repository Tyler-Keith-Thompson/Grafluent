ve gains anything. With floating-point weights, rounding decides which moves"},{"type":"text","text":" "},{"type":"text","text":"gain."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"The graph is complete; ","type":"text"},{"type":"codeVoice","code":"tour.vertices"},{"text":" lists every vertex of the graph","type":"text"},{"text":" ","type":"text"},{"text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Precondition"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(n²) per improving move."}],"type":"paragraph"}],"name":"Complexity"}]}],"abstract":[{"type":"codeVoice","code":"tour"},{"type":"text","text":" improved by 2-opt to a 2-optimal tour."}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/twoOptTour(improving:weight:)"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"metadata":{"title":"twoOptTour(improving:weight:)","modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}],"extendedModule":"GraphProtocols","remoteSource":{"fileName":"TwoOpt.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/TwoOpt.swift#L135"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"twoOptTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"improving","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifi