dex","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A move’s gain is formed as (d(a, b) + d(c, e)) − (d(a, c) + d(b, e)), and the scan stops","type":"text"},{"text":" ","type":"text"},{"text":"when no move gains anything; JGraphT forms d(a, c) + d(b, e) − d(a, b) − d(c, e) and stops","type":"text"},{"text":" ","type":"text"},{"text":"when no change is below −1e-8. The tour is JGraphT’s exactly on integers, and on floating","type":"text"},{"text":" ","type":"text"},{"text":"weights whose sums are exactly representable (dyadic values of moderate size); otherwise","type":"text"},{"text":" ","type":"text"},{"text":"rounding and the threshold can pick other moves, so the tours may differ.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"The graph is complete; ","type":"text"},{"code":"tour.vertices","type":"codeVoice"},{"text":" lists every vertex of the graph","type":"text"},{"text":" ","type":"text"},{"text":"exactly once; no weight is NaN or infinite; the sum of any two weights fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(n²) per improving move.","type":"text"}]}],"type":"aside"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"code":"tour","type":"codeVoice"},{"text":" improved by 2-opt to a 2-optimal tour, by JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"TwoOptHeuristicTSP.improveTour","type":"codeVoice"},{"text":"‘s procedure: best improvement, the first move (i, j) in","type":"text"},{"text":" ","type":"text"},{"text":"row-major order on ties, until no exchange of two tour edges for two lighter ones remains.","type":"text"},{"text":" ","type":"text"},{"text":"LEMON’s ","type":"text"},{"code":"Opt2Tsp","type":"codeVoice"},{"text":" shares the name only: it takes the first improving move and restarts the","type":"text"},{"text":" ","type":"text"},{"text":"scan, which ends at a different tour. The first vertex of ","type":"text"},{"code":"tour","type":"codeVoice"},{"text":" stays first. Only","type":"text"},{"text":" ","type":"text"},{"code":"tour.vertices","type":"codeVoice"},{"text":" is read: the result uses the lightest edge of each pair, as every tour","type":"text"},{"text":" ","type":"text"},{"text":"does. nil below three vertices.","type":"text"}],"metadata":{"symbolKind":"method","externalID":"s:14GraphProtocols0A0