"},{"type":"text","text":" "},{"type":"text","text":"vertex with no other unvisited neighbour, so a path or cycle graph takes O(n + m))."}]}],"type":"aside","style":"note","name":"Complexity"}]}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","references":{"doc://Tours/documentation/Tours/GraphProtocols":{"type":"topic","role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","url":"\/documentation\/tours\/graphprotocols","kind":"symbol","title":"GraphProtocols","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"kind":"symbol","type":"topic"},"doc://Tours/documentation/Tours":{"title":"Tours","identifier":"doc:\/\/Tours\/documentation\/Tours","abstract":[],"role":"collection","url":"\/documentation\/tours","type":"topic","kind":"symbol"},"doc://Walks/documentation/Walks/Path":{"navigatorTitle":[{"kind":"identifier","text":"Path"}],"kind":"symbol","url":"\/documentation\/walks\/path","title":"Path","role":"symbol","identifier":"doc:\/\/Walks\/documentation\/Walks\/Path","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}],"abstract":[{"type":"text","text":"A path: a walk that repeats no vertex, and so no edge."}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/hamiltonianPath()":{"title":"hamiltonianPath()","kind":"symbol","identifier"