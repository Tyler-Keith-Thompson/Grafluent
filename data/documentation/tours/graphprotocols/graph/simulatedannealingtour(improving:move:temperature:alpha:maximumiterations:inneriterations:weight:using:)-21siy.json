 it by Δ is taken with probability","type":"text"},{"text":" ","type":"text"},{"text":"exp(−Δ \/ T). The temperature T starts at ","type":"text"},{"code":"temperature","type":"codeVoice"},{"text":" and loses ","type":"text"},{"code":"alpha","type":"codeVoice"},{"text":" × T after each","type":"text"},{"text":" ","type":"text"},{"text":"round. The search returns the shortest tour it met once ","type":"text"},{"code":"maximumIterations","type":"codeVoice"},{"text":" + 1 rounds in","type":"text"},{"text":" ","type":"text"},{"text":"a row found no shorter one. Each step draws two positions from ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":", the first in","type":"text"},{"text":" ","type":"text"},{"text":"1 ..< n and the second among the others, then a ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" in [0, 1) when the move lengthens","type":"text"},{"text":" ","type":"text"},{"text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple","type":"text"},{"text":" ","type":"text"},{"text":"graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three vertices.","type":"text"}]},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"text":"The graph is complete; ","type":"text"},{"code":"tour","type":"codeVoice"},{"text":", when given, lists every vertex exactly","type":"text"},{"text":" ","type":"text"},{"text":"once; ","type":"text"},{"code":"temperature","type":"codeVoice"},{"text":" is finite and at least zero; 0 < ","type":"text"},{"code":"alpha","type":"codeVoice"},{"text":" ≤ 1; ","type":"text"},{"code":"maximumIterations","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"innerIterations","type":"codeVoice"},{"text":" are at least zero; the tour’s length fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each","type":"text"},{"text":" ","type":"text"},{"text":"relocation taken and each new shortest tour.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/simulatedAnnealingTour(improving:move:temperature:alpha:maximumIterations:innerIterations:weight:using:)-21siy","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/simulatedannealingtour(improving:move:temperature:alpha:maximumiterations:inneriterations:weight:using:)-21siy"]}],"abstract":[{"text":"A tour by simulated annealing (Kirkpatrick, Gelatt and Vecchi, “Optimization by simulated","type":"text"},{"text":" ","type":"text"},{"text":"annealing”, Science 220, 1983), as NetworkX’s ","type":"text"},{"code":"simulated_annealing_tsp","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://Tours/documentation/Tours/GraphProtocols":{"url":"\/documentation\/tours\/graphprotocols","type":"topic","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","role":"collection","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"role":"symbol","title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"kind":"symbol"