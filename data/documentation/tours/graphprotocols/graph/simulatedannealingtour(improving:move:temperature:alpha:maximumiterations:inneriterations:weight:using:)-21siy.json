"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sz","text":"BinaryInteger","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"tour","content":[{"type":"paragraph","inlineContent":[{"text":"The tour to start from; nil starts from the nearest-neighbour tour.","type":"text"}]}]},{"name":"move","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kind of move tried."}]}]},{"name":"temperature","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The starting temperature."}]}]},{"name":"alpha","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The fraction of the temperature lost after each round."}]}]},{"name":"maximumIterations","content":[{"inlineContent":[{"text":"The rounds without a new shortest tour, less one, before stopping.","type":"text"}],"type":"paragraph"}]},{"name":"innerIterations","content":[{"inlineContent":[{"text":"The moves tried in each round.","type":"text"}],"type":"paragraph"}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}]},{"name":"generator","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}]}]},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The shortest tour met, from the first vertex of the starting tour."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"From "},{"type":"codeVoice","code":"tour"},{"type":"text","text":", or from "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" when it is nil, each round tries"},{"type":"text","text":" "},{"type":"codeVoice","code":"innerIterations"},{"type":"text","text":" random moves of the given kind, the first vertex fixed: a move that does"},{"type":"text","text":" "},{"type":"text","text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability"},{"type":"text","text":" "},{"type":"text","text":"exp(−Δ \/ T). The temperature T starts at "},{"type":"codeVoice","code":"temperature"},{"type":"text","text":" and loses "},{"type":"codeVoice","code":"alpha"},{"type":"text","text":" × T after each"},{"type":"text","text":" "},{"type":"text","text":"round. The search returns the shortest tour it met once "},{"type":"codeVoice","code":"maximumIterations"},{"type":"text","text":" + 1 rounds in"},{"type":"text","text":" "},{"type":"text","text":"a row found no shorter one. Each step draws two positions from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":", the first in"},{"type":"text","text":" "},{"type":"text","text":"1 ..< n and the second among the others, then a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" in [0, 1) when the move lengthens"},{"type":"text","text":" "},{"type":"text","text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple"},{"type":"text","text":" "},{"type":"text","text":"graph, as "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" documents; nil below three vertices."}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"The graph is complete; "},{"code":"tour","type":"codeVoice"},{"type":"text","text":", when given, lists every vertex exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"code":"temperature","type":"codeVoice"},{"type":"text","text":" is finite and at least zero; 0 < "},{"code":"alpha","type":"codeVoice"},{"type":"text","text":" ≤ 1; "},{"code":"maximumIterations","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"innerIterations","type":"codeVoice"},{"type":"text","text":" are at least zero; the tour’s length fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each"},{"type":"text","text":" "},{"type":"text","text":"relocation taken and each new shortest tour."}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"A tour by simulated annealing (Kirkpatrick, Gelatt and Vecchi, “Optimization by simulated"},{"type":"text","text":" "},{"type":"text","text":"annealing”, Science 220, 1983), as NetworkX’s "},{"type":"codeVoice","code":"simulated_annealing_tsp"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/simulatedAnnealingTour(improving:move:temperature:alpha:maximumIterations:innerIterations:weight:using:)-21siy","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"references":{"doc://Tours/documentation/Tours/TourMove":{"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/tours\/tourmove","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TourMove","kind":"identifier"}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/TourMove","abstract":[{"type":"text","text":"The neighbouring tours a metaheuristic tries: "},{"code":"simulatedAnnealingTour","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"thresholdAcceptingTour","type":"codeVoice"},{"type":"text","text":" draw one at random each step. The first vertex never moves."}],"navigatorTitle":[{"text":"TourMove","kind":"ide