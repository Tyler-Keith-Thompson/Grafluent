{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The shortest tour, by Held–Karp dynamic programming (Bellman 1962; Held and Karp 1962)."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns the least-weight Hamiltonian cycle of the simple graph, or nil when there is none;"},{"type":"text","text":" "},{"type":"text","text":"among the optimal ones, the lexicographically least by vertex number listed from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex. The graph need not be complete: a missing pair is an absent edge. Tours read the"},{"type":"text","text":" "},{"type":"text","text":"simple graph, as "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" documents; nil below three vertices."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour is determined for integer weights. With floating-point weights it is optimal for the"},{"type":"text","text":" "},{"type":"text","text":"sums as computed, and chosen by the same rule on them, so which of several equal tours"},{"type":"text","text":" "},{"type":"text","text":"comes out, and its orientation, can depend on rounding."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The table, 2ⁿ⁻¹ · (n − 1) weights and as many validity bytes, fits in"},{"type":"text","text":" "},{"type":"text","text":"4 GiB: at most 25 vertices with 8-byte weights, 26 with 4-byte ones; no weight is NaN or"},{"type":"text","text":" "},{"type":"text","text":"infinite; the sum along any path fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte"},{"type":"text","text":" "},{"type":"text","text":"weights on a complete graph, and 90 MB on another (the validity flags)."}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)"]}],"metadata":{"title":"shortestTour(weight:)","roleHeading":"Instance Method","extendedModule":"GraphProtocols","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier