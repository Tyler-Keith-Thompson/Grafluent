ype":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"type":"aside","style":"note","name":"Precondition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte"},{"type":"text","text":" "},{"type":"text","text":"weights on a complete graph, and 90 MB on another (the validity flags)."}]}],"type":"aside","style":"note","name":"Complexity"}]}],"kind":"symbol","references":{"doc://Tours/documentation/Tours":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","title":"Tours","abstract":[],"kind":"symbol","url":"\/documentation\/tours","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","title":"Graph","type":"topic","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/shortestTour(weight:)":{"url":"\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)","role":"symbol","abstract":[{"text":"The shortest tour, by Held–Karp dynamic programming (Bellman 1962; Held and Karp 1962).","type":"text"}],"title":"shortestTour(weight:)","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphP