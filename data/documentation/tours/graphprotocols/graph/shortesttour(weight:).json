e and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte"},{"type":"text","text":" "},{"type":"text","text":"weights on a complete graph, and 90 MB on another (the validity flags)."}],"type":"paragraph"}],"style":"note"}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The shortest tour, by Held–Karp dynamic programming (Bellman 1962; Held and Karp 1962)."}],"sections":[],"metadata":{"externalID":"s:14GraphProtocols0A0P5ToursE12shortestTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"title":"shortestTour(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","te