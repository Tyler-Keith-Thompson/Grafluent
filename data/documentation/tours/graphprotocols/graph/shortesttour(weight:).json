typeIdentifier","text":"Comparable"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The tour is pinned for integer weights. With floating-point weights it is optimal for the"},{"type":"text","text":" "},{"type":"text","text":"sums as computed, and chosen by the same rule on them, so which of several equal tours"},{"type":"text","text":" "},{"type":"text","text":"comes out, and its orientation, can depend on rounding."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The table, 2ⁿ⁻¹ · (n − 1) weights and as many validity bytes, fits in"},{"type":"text","text":" "},{"type":"text","text":"4 GiB: at most 25 vertices with 8-byte weights, 26 with 4-byte ones (JGraphT allows 31,"},{"type":"text","text":" "},{"type":"text","text":"the width of its "},{"type":"codeVoice","code":"int"},{"type":"text","text":" bitmask, not a memory bound); no weight is NaN or infinite; the"},{"type":"text","text":" "},{"type":"text","text":"sum along any path fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"style":"note","type":"aside"},{"name":"Complexity","content":[{"inlineContent":[{"text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 is practical, with 80 MB of table","type":"text"},{"text":" ","type":"text"},{"text":"for 8-byte weights on a complete graph and 90 MB on another (the validity flags).","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"metadata":{"symbolKind":"method","externalID":"s:14GraphProtocols0A0P5ToursE12shortestTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","title":"shortestTour(weight:)","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"role":"symbol","remoteSource":{"fileName":"HeldKarp.swift","url":"https:\/\/github.com\/Tyler-Kei