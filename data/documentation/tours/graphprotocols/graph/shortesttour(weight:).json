xt":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Returns the least-weight Hamiltonian cycle of the simple graph, or nil when there is none;","type":"text"},{"text":" ","type":"text"},{"text":"among the optimal ones, the lexicographically least by vertex number listed from the first","type":"text"},{"text":" ","type":"text"},{"text":"vertex. The graph need not be complete: a missing pair is an absent edge. Tours read the","type":"text"},{"text":" ","type":"text"},{"text":"simple graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three vertices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The tour is determined for integer weights. With floating-point weights it is optimal for the","type":"text"},{"text":" ","type":"text"},{"text":"sums as computed, and chosen by the same rule on them, so which of several equal tours","type":"text"},{"text":" ","type":"text"},{"text":"comes out, and its orientation, can depend on rounding.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The table, 2ⁿ⁻¹ · (n − 1) weights and as many validity bytes, fits in"},{"type":"text","text":" "},{"type":"text","text":"4 GiB: at most 25 vertices with 8-byte weights, 26 with 4-byte ones; no weight is NaN or"},{"type":"text","text":" "},{"type":"text","text":"infinite; the sum along any path fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Precondition","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte","type":"text"},{"text":" ","type":"text"},{"text":"weights on a complete graph, and 90 MB on another (the validity flags).","type":"text"}]}],"name":"Complexity","style":"note","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"The shortest tour, by Held–Karp dynamic programming (Bellman 1962; Held and Karp 1962)."}],"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}],"externalID":"s:14GraphProtocols0A0P5ToursE12shortestTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier