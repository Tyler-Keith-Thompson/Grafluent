th fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte"},{"type":"text","text":" "},{"type":"text","text":"weights on a complete graph, and 90 MB on another (the validity flags)."}],"type":"paragraph"}],"name":"Complexity","style":"note"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"title":"Edges","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","type":"topic","abstract":[]},"doc://Walks/documentation/Walks/Cycle":{"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start."}],"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"url":"\/documentation\/walks\/cycle","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"type":"topic","title":"Cycle","role":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/tours\/graphprotocols\/graph","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","title":"Graph","role":"sy