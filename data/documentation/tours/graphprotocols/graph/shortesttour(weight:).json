xt":"infinite; the sum along any path fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte","type":"text"},{"text":" ","type":"text"},{"text":"weights on a complete graph, and 90 MB on another (the validity flags).","type":"text"}]}],"style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/shortestTour(weight:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"shortestTour(weight:)","roleHeading":"Instance Method","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","role":"symbol","remoteSource":{"fileName":"HeldKarp.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/HeldKarp.swift#L184"},"symbolKind":"method","externalID":"s:14GraphProtocols0A0P5ToursE12shortestTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"tex