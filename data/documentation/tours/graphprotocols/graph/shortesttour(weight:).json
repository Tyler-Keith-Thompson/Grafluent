 2ⁿ⁻¹ · (n − 1) weights and as many validity bytes, fits in","type":"text"},{"text":" ","type":"text"},{"text":"4 GiB: at most 25 vertices with 8-byte weights, 26 with 4-byte ones; no weight is NaN or","type":"text"},{"text":" ","type":"text"},{"text":"infinite; the sum along any path fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":".","type":"text"}]}]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte"},{"type":"text","text":" "},{"type":"text","text":"weights on a complete graph, and 90 MB on another (the validity flags)."}],"type":"paragraph"}]}]}],"metadata":{"modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P5ToursE12shortestTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/HeldKarp.swift#L184","fileName":"HeldKarp.swift"},"title":"shortestTour(weight:)","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shortestTour"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"tex