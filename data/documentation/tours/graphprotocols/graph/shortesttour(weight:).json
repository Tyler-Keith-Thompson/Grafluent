,"text":"Θ(2ⁿ n²) time and Θ(2ⁿ n) memory: n = 20 takes 80 MB of table for 8-byte"},{"type":"text","text":" "},{"type":"text","text":"weights on a complete graph, and 90 MB on another (the validity flags)."}]}],"style":"note"}]}],"sections":[],"metadata":{"title":"shortestTour(weight:)","symbolKind":"method","role":"symbol","extendedModule":"GraphProtocols","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shortestTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"externalID":"s:14GraphProtocols0A0P5ToursE12shortestTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}]},"kind":"symbol","variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/shortesttour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hier