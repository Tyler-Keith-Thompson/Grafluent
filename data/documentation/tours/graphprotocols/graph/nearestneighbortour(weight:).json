dditiveArithmeticRd__SLRd__lF"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"]}],"abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex (NetworkX "},{"type":"codeVoice","code":"greedy_tsp"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"NearestNeighborHeuristicTSP(first)"},{"type":"text","text":", whose default starts at a random vertex): repeatedly"},{"type":"text","text":" "},{"type":"text","text":"the nearest unvisited vertex, the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Tours read the simple graph: self-loops are ignored, and each pair of vertices is joined by","type":"text"},{"text":" ","type":"text"},{"text":"its lightest edge (the earliest position on ties), which is the edge the returned ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"uses, so ","type":"text"},{"code":"cycle.weight(weight)","type":"codeVoice"},{"text":" is the tour’s length. nil below three vertices, before any","type":"text"},{"text":" ","type":"text"},{"text":"other check. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order, before any work.","type":"text"},{"text":" ","type":"text"},{"text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when","type":"text"},{"text":" ","type":"text"},{"text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis","type":"text"},{"text":" ","type":"text"},{"text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,","type":"text"},{"text":" ","type":"text"},{"text":"1977).","type":"text"}]},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete (every pair of distinct vertices joined); no weight"},{"type":"text","text":" "},{"type":"text","text":"is NaN or infinite."}]}],"style":"note"},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n²) after O(n + m) to read the edges and weights."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)"},"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","title":"Edges","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"abstract":[]},"doc://Tours/documentation/Tours/GraphProtocols":{"kind":"symbol","type":"topic","url":"\/documentation\/tours\/graphprotocols","abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","title":"GraphProtocols","role":"collection"},"doc://Tours/documentation/Tours":{"type":"topic","url":"\/documentation\/tours","role":"collection","identifier":"doc:\