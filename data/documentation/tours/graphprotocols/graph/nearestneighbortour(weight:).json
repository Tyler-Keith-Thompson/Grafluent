" ","type":"text"},{"text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"one of length 2. It is the witness cycle detection returns.","type":"text"}],"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cycle"}],"navigatorTitle":[{"kind":"identifier","text":"Cycle"}],"kind":"symbol"}}}