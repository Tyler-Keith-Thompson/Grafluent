":"text"}],"type":"paragraph"},{"name":"Precondition","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete (every pair of distinct vertices joined); no weight"},{"type":"text","text":" "},{"type":"text","text":"is NaN or infinite."}]}]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"text":"O(n²) after O(n + m) to read the edges and weights.","type":"text"}],"type":"paragraph"}]}]}],"references":{"doc://Tours/documentation/Tours":{"abstract":[],"title":"Tours","url":"\/documentation\/tours","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","abstract":[],"title":"Edges","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols":{"kind":"symbol","title":"GraphProtocols","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","abstract":[],"url":"\/documentation\/tours\/graphprotocols","role":"collection"},"doc://Walks/documentation/Walks/Cycle":{"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start."}],"title":"Cycle","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"url":"\/documentation\/walks\/cycle","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":