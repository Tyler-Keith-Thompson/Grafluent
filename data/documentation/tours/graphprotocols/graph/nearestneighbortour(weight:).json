{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The nearest-neighbour tour from the first vertex (NetworkX ","type":"text"},{"code":"greedy_tsp","type":"codeVoice"},{"text":", JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"NearestNeighborHeuristicTSP(first)","type":"codeVoice"},{"text":", whose default starts at a random vertex): repeatedly","type":"text"},{"text":" ","type":"text"},{"text":"the nearest unvisited vertex, the first in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order on ties, then back to the","type":"text"},{"text":" ","type":"text"},{"text":"start. LEMON’s ","type":"text"},{"code":"NearestNeighborTsp","type":"codeVoice"},{"text":" shares the name only: it starts from the lightest edge","type":"text"},{"text":" ","type":"text"},{"text":"and grows the path at both ends, a different procedure and tour.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nearestNeighborTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tours read the simple graph: self-loops are ignored, and each pair of vertices is joined by"},{"type":"text","text":" "},{"type":"text","text":"its lightest edge (the earliest position on ties), which is the edge the returned "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" "},{"type":"text","text":"uses, so "},{"type":"codeVoice","code":"cycle.weight(weight)"},{"type":"text","text":" is the tour’s length. nil below three vertices, before any"},{"type":"text","text":" "},{"type":"text","text":"other check. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per non-loop edge, in position order, before any work."},{"type":"text","text":" "},{"type":"text","text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when"},{"type":"text","text":" "},{"type":"text","text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis"},{"type":"text","text":" "},{"type":"text","text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,"},{"type":"text","text":" "},{"type":"text","text":"1977)."}]},{"type":"aside","content":[{"inlineContent":[{"text":"The graph is complete (every pair of distinct vertices joined); no weight","type":"text"},{"text":" ","type":"text"},{"text":"is NaN or infinite.","type":"text"}],"type":"paragraph"}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n²) after O(n + m) to read the edges and weights."}]}],"name":"Complexity","style":"note"}],"kind":"content"}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/NearestNeighbor.swift#L70","fileName":"NearestNeighbor.swift"},"modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P5ToursE19nearestNeighborTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","symbolKind":"method","title":"nearestNeighborTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","