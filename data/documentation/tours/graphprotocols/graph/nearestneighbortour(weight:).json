Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","interfaceLanguage":"swift"},"abstract":[{"text":"The nearest-neighbour tour from the first vertex (NetworkX ","type":"text"},{"code":"greedy_tsp","type":"codeVoice"},{"text":", JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"NearestNeighborHeuristicTSP(first)","type":"codeVoice"},{"text":", whose default starts at a random vertex): repeatedly","type":"text"},{"text":" ","type":"text"},{"text":"the nearest unvisited vertex, the first in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order on ties, then back to the","type":"text"},{"text":" ","type":"text"},{"text":"start. LEMON’s ","type":"text"},{"code":"NearestNeighborTsp","type":"codeVoice"},{"text":" shares the name only: it starts from the lightest edge","type":"text"},{"text":" ","type":"text"},{"text":"and grows the path at both ends, a different procedure and tour.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nearestNeighborTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","