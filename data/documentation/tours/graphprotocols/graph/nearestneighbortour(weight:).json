ion"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(n²) after O(n + m) to read the edges and weights.","type":"text"}]}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","interfaceLanguage":"swift"},"references":{"doc://Tours/documentation/Tours/GraphProtocols/Graph/nearestNeighborTour(weight:)":{"url":"\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)","abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex: repeatedly the nearest unvisited vertex,"},{"type":"text","text":" "},{"type":"text","text":"the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the start."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","type":"topic","title":"nearestNeighborTour(weight:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"nearestNeighborTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Verte