,{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"url":"\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","title":"nearestNeighborTour(weight:)","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","kind":"symbol","abstract":[],"title":"Vertex","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Walks/documentation/Walks/Cycle":{"url":"\/documentation\/walks\/cycle","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","title":"Cycle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witne