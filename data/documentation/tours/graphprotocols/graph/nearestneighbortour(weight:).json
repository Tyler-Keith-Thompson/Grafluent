,"text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when"},{"type":"text","text":" "},{"type":"text","text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis"},{"type":"text","text":" "},{"type":"text","text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,"},{"type":"text","text":" "},{"type":"text","text":"1977)."}]},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"The graph is complete (every pair of distinct vertices joined); no weight"},{"type":"text","text":" "},{"type":"text","text":"is NaN or infinite."}],"type":"paragraph"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(n²) after O(n + m) to read the edges and weights."}],"type":"paragraph"}]}]}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Tours/documentation/Tours/GraphProtocols":{"type":"topic","abstract":[],"kind":"symbol","title":"GraphProtocols","url":"\/documentation\/tours\/graphprotocols","role":"collection","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","kind":"symbol","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"title":"Vertex"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ed