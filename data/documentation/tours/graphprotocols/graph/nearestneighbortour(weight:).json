"text","text":"the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the start."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Tours read the simple graph: self-loops are ignored, and each pair of vertices is joined by","type":"text"},{"text":" ","type":"text"},{"text":"its lightest edge (the earliest position on ties), which is the edge the returned ","type":"text"},{"type":"codeVoice","code":"Cycle"},{"text":" ","type":"text"},{"text":"uses, so ","type":"text"},{"type":"codeVoice","code":"cycle.weight(weight)"},{"text":" is the tour’s length. nil below three vertices, before any","type":"text"},{"text":" ","type":"text"},{"text":"other check. ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is called once per non-loop edge, in position order, before any work.","type":"text"},{"text":" ","type":"text"},{"text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when","type":"text"},{"text":" ","type":"text"},{"text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis","type":"text"},{"text":" ","type":"text"},{"text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,","type":"text"},{"text":" ","type":"text"},{"text":"1977).","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete (every pair of distinct vertices joined); no weight"},{"type":"text","text":" "},{"type":"text","text":"is NaN or infinite."}]}],"type":"aside","style":"note","name":"Precondition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n²) after O(n + m) to read the edges and weights."}]}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","abstract":[]},"doc://Tours/documentation/Tours/GraphProtocols":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","type":"topic","url":"\/documentation\/tours\/graphprotocols","title":"GraphProtocols","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"type":"topic","kind":"symbol","abstract":[],"title":"Edges"},"doc://Tours/documentation/Tours":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours","url":"\/documentation\/tours","type":"topic","