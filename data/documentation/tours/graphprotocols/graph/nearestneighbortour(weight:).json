ent":[{"text":"Tours read the simple graph: self-loops are ignored, and each pair of vertices is joined by","type":"text"},{"text":" ","type":"text"},{"text":"its lightest edge (the earliest position on ties), which is the edge the returned ","type":"text"},{"code":"Cycle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"uses, so ","type":"text"},{"code":"cycle.weight(weight)","type":"codeVoice"},{"text":" is the tour’s length. nil below three vertices, before any","type":"text"},{"text":" ","type":"text"},{"text":"other check. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per non-loop edge, in position order, before any work.","type":"text"},{"text":" ","type":"text"},{"text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when","type":"text"},{"text":" ","type":"text"},{"text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis","type":"text"},{"text":" ","type":"text"},{"text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,","type":"text"},{"text":" ","type":"text"},{"text":"1977).","type":"text"}]},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete (every pair of distinct vertices joined); no weight","type":"text"},{"text":" ","type":"text"},{"text":"is NaN or infinite.","type":"text"}]}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(n²) after O(n + m) to read the edges and weights.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"a