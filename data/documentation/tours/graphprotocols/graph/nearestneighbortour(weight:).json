xt"},{"text":" ","type":"text"},{"text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when","type":"text"},{"text":" ","type":"text"},{"text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis","type":"text"},{"text":" ","type":"text"},{"text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,","type":"text"},{"text":" ","type":"text"},{"text":"1977).","type":"text"}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"The graph is complete (every pair of distinct vertices joined); no weight"},{"type":"text","text":" "},{"type":"text","text":"is NaN or infinite."}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n²) after O(n + m) to read the edges and weights."}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"abstract":[],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","title":"Edges","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sl","kind":"typeIdentifier","text":"Collection"}]},"doc://Tours/documentation/Tours":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","kind":"symbol","title":"Tours","abstract":[],"role":"collection","url":"\/documentation\/tours"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/d