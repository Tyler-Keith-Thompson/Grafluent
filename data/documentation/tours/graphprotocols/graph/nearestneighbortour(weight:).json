{"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tours read the simple graph: self-loops are ignored, and each pair of vertices is joined by"},{"type":"text","text":" "},{"type":"text","text":"its lightest edge (the earliest position on ties), which is the edge the returned "},{"code":"Cycle","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"uses, so "},{"code":"cycle.weight(weight)","type":"codeVoice"},{"type":"text","text":" is the tour’s length. nil below three vertices, before any"},{"type":"text","text":" "},{"type":"text","text":"other check. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per non-loop edge, in position order, before any work."},{"type":"text","text":" "},{"type":"text","text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when"},{"type":"text","text":" "},{"type":"text","text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis"},{"type":"text","text":" "},{"type":"text","text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,"},{"type":"text","text":" "},{"type":"text","text":"1977)."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete (every pair of distinct vertices joined); no weight","type":"text"},{"text":" ","type":"text"},{"text":"is NaN or infinite.","type":"text"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(n²) after O(n + m) to read the edges and weights.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","metadata":{"role":"symbol","remoteSource":{"fileName":"NearestNeighbor.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/NearestNeighbor.swift#L70"},"title":"nearestNeighborTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"externalID":"s:14GraphProtocols0A0P5ToursE19nearestNeighborTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_ts18AdditiveArithmeticRd__SLRd__lF","extendedModule":"GraphProtocols","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex (NetworkX "},{"type":"codeVoice","code":"greedy_tsp"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"NearestNeighborHeuristicTSP(first)"},{"type":"text","text":", whose default starts at a random vertex): repeatedly"},{"type":"text","text":" "},{"type":"text","text":"the nearest unvisited vertex, the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"type":"codeVoice","code":"NearestNeighborTsp"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)"},"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"role":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph","kind":"symbol","type":"topic","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Tours/documentation/Tours/GraphProtocols":{"role":"collection","url":"\/documentation\/tours\/graphprotocols","kind":"symbol","type":"topic","title":"GraphProtocols","abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols"},"doc://Tours/documentation/Tours":{"identifier":"doc:\/\/Tours\/documentation\/Tours","url":"\/documentation\/tours","type":"topic","kind":"symbol","abstract":[],"title":"Tours","role":"collection"},"doc://G