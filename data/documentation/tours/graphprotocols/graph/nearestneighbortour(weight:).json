mation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when"},{"type":"text","text":" "},{"type":"text","text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis"},{"type":"text","text":" "},{"type":"text","text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,"},{"type":"text","text":" "},{"type":"text","text":"1977)."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"The graph is complete (every pair of distinct vertices joined); no weight"},{"type":"text","text":" "},{"type":"text","text":"is NaN or infinite."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n²) after O(n + m) to read the edges and weights."}]}]}]}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","type":"topic","abstract":[],"role":"symbol","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph/nearestNeighborTour(weight:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex (NetworkX "},{"code":"greedy_tsp","type":"codeVoice"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"code":"NearestNeighborHeuristicTSP(first)","type":"codeVoice"},{"type":"text","text":", whose default starts at a random vertex): repeatedly"},{"type":"text","text":" "},{"type":"text","text":"the nearest unvisited vertex, the first in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order on ties, then back to the"},{"type":"text","text":" "},{"type":"text","text":"start. LEMON’s "},{"code":"NearestNeighborTsp","type":"codeVoice"},{"type":"text","text":" shares the name only: it starts from the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"and grows the path at both ends, a different procedure and tour."}],"title":"nearestNeighborTour(weight:)","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/nearestNeighborTour(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">