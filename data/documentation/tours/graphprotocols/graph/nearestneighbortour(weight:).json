"kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"]}],"abstract":[{"text":"The nearest-neighbour tour from the first vertex (NetworkX ","type":"text"},{"type":"codeVoice","code":"greedy_tsp"},{"text":", JGraphT","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NearestNeighborHeuristicTSP(first)"},{"text":", whose default starts at a random vertex): repeatedly","type":"text"},{"text":" ","type":"text"},{"text":"the nearest unvisited vertex, the first in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order on ties, then back to the","type":"text"},{"text":" ","type":"text"},{"text":"start. LEMON’s ","type":"text"},{"type":"codeVoice","code":"NearestNeighborTsp"},{"text":" shares the name only: it starts from the lightest edge","type":"text"},{"text":" ","type":"text"},{"text":"and grows the path at both ends, a different procedure and tour.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"ty