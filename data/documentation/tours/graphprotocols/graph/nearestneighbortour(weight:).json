{"abstract":[{"type":"text","text":"The nearest-neighbour tour from the first vertex: repeatedly the nearest unvisited vertex,"},{"type":"text","text":" "},{"type":"text","text":"the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order on ties, then back to the start."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Tours read the simple graph: self-loops are ignored, and each pair of vertices is joined by"},{"type":"text","text":" "},{"type":"text","text":"its lightest edge (the earliest position on ties), which is the edge the returned "},{"type":"codeVoice","code":"Cycle"},{"type":"text","text":" "},{"type":"text","text":"uses, so "},{"type":"codeVoice","code":"cycle.weight(weight)"},{"type":"text","text":" is the tour’s length. nil below three vertices, before any"},{"type":"text","text":" "},{"type":"text","text":"other check. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per non-loop edge, in position order, before any work."},{"type":"text","text":" "},{"type":"text","text":"No approximation guarantee in general; within ½(⌈log₂ n⌉ + 1) of the shortest tour when"},{"type":"text","text":" "},{"type":"text","text":"the weights satisfy the triangle inequality (Rosenkrantz, Stearns and Lewis, “An analysis"},{"type":"text","text":" "},{"type":"text","text":"of several heuristics for the traveling salesman problem”, SIAM Journal on Computing 6,"},{"type":"text","text":" "},{"type":"text","text":"1977)."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete (every pair of distinct vertices joined); no weight","type":"text"},{"text":" ","type":"text"},{"text":"is NaN or infinite.","type":"text"}]}]},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n²) after O(n + m) to read the edges and weights."}]}]}]}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/nearestneighbortour(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"extendedModule":"GraphProtocols","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nearestNeighborTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"roleHeading":"Instance Method","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"symbolKind":"method","externalID":"s:14GraphProtocols0A0P5ToursE19n