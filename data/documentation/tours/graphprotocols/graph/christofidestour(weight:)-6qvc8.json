\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/Christofides.swift#L140"}},"abstract":[{"type":"text","text":"Christofides’ tour (Christofides 1976; Serdyukov 1978)."}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SZ","kind":"typeIdentifier","text":"SignedInteger"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the canonical minimum spanning tree (weight, then position, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"text":"), a minimum-weight perfect matching on its odd-degree","type":"text"},{"text":" ","type":"text"},{"text":"vertices (","type":"text"},{"type":"codeVoice","code":"minimumWeightMatching"},{"text":"), and an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the","type":"text"},{"text":" ","type":"text"},{"text":"complete graph of the odd vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (pairs i < j lexicographic), and the","type":"text"},{"text":" ","type":"text"},{"text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,","type":"text"},{"text":" ","type":"text"},{"text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the","type":"text"},{"text":" ","type":"text"},{"text":"triangle inequality (not checked).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Tours read the simple graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}]},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; the sum along a tour fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":". When "},{"code":"W","type":"codeVoice"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"code":"FixedWidthInteger","type":"codeVoice"},{"type":"text","text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤"},{"type":"text","text":" "},{"code":"W.max \/ 8","type":"codeVoice"},{"type":"text","text":" (the matching’s bound), checked as each weight is read, so a weight beyond it"},{"type":"text","text":" "},{"type":"text","text":"traps even on an edge the matching never sees; so n ≤ "},{"code":"W.max \/ 8","type":"codeVoice"},{"type":"text","text":" (15 vertices for"},{"type":"text","text":" "},{"code":"Int8","type":"codeVoice"},{"type":"text","text":"), whatever the weights. An arbitrary-precision integer has no bound."}]}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}]}]}]}],"kind":"symbol","references":{"doc://Tours/documentation/Tours":{"type":"topic","title":"Tours","identifier":"doc:\/\/Tours\/documentation\/Tours","abstract":[],"url":"\/documentation\/tours","role":"collection","kind":"symbol"},"doc://Walks/documentation/Walks/Cycle":{"url":"\/documentation\/walks\/cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cycle"}],"title":"Cycle","navigatorTitle":[{"kind":"identifier","text":"Cycle"}],"type":"topic","abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start."}],"kind":"symbol"},"doc://Tours/documentation/Tours/GraphProtocols":{"kind":"symbol","abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","url":"\/documentation\/tours\/graphprotocols","role":"collection