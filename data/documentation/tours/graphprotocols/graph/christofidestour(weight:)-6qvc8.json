text","text":">?"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SZ","kind":"typeIdentifier","text":"SignedInteger"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the canonical minimum spanning tree (weight, then position, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"text":"), a minimum-weight perfect matching on its odd-degree","type":"text"},{"text":" ","type":"text"},{"text":"vertices (","type":"text"},{"type":"codeVoice","code":"minimumWeightMatching"},{"text":"), and an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the","type":"text"},{"text":" ","type":"text"},{"text":"complete graph of the odd vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (pairs i < j lexicographic), and the","type":"text"},{"text":" ","type":"text"},{"text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,","type":"text"},{"text":" ","type":"text"},{"text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the","type":"text"},{"text":" ","type":"text"},{"text":"triangle inequality (not checked).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Tours read the simple graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete; the sum along a tour fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"W","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}]}],"type":"aside","style":"note","name":"Precondition"},{"content":[{"inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"abstract":[{"text":"Christofides’ tour (Christofides 1976; Serdyukov 1978).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":