ft"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Takes the canonical minimum spanning tree (weight, then position, as","type":"text"},{"text":" ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":"), a minimum-weight perfect matching on its odd-degree","type":"text"},{"text":" ","type":"text"},{"text":"vertices (","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":"), and an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the","type":"text"},{"text":" ","type":"text"},{"text":"complete graph of the odd vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (pairs i < j lexicographic), and the","type":"text"},{"text":" ","type":"text"},{"text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,","type":"text"},{"text":" ","type":"text"},{"text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the","type":"text"},{"text":" ","type":"text"},{"text":"triangle inequality (not checked).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tours read the simple graph, as "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" documents; nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"The graph is complete; the sum along a tour fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"W","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}],"type":"paragraph"}]}]}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Christofides’ tour (Christofides 1976; Serdyukov 1978)."}],"references":{"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"abstract":[{"type":"text","text":"Christofides’ tour (Christofides 1976; Serdyukov 1978)."}],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","type":"topic","url":"\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:S