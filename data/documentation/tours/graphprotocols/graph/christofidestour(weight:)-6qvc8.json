{"kind":"symbol","abstract":[{"text":"Christofides’ tour (Christofides 1976; Serdyukov 1978).","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Takes the canonical minimum spanning tree (weight, then position, as","type":"text"},{"text":" ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":"), a minimum-weight perfect matching on its odd-degree","type":"text"},{"text":" ","type":"text"},{"text":"vertices (","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":"), and an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the","type":"text"},{"text":" ","type":"text"},{"text":"complete graph of the odd vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (pairs i < j lexicographic), and the","type":"text"},{"text":" ","type":"text"},{"text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,","type":"text"},{"text":" ","type":"text"},{"text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the","type":"text"},{"text":" ","type":"text"},{"text":"triangle inequality (not checked).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Tours read the simple graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"The graph is complete; the sum along a tour fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"W","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}]}],"name":"Complexity","type":"aside"}],"kind":"content"}],"sections":[],"metadata":{"externalID":"s:14GraphProtocols0A0P5ToursE16christofidesTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_tSZRd__lF","extendedModule":"GraphProtocols","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Tours","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtoc