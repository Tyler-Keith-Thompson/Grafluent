forms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Takes the canonical minimum spanning tree (weight, then position, as"},{"type":"text","text":" "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":"), a minimum-weight perfect matching on its odd-degree"},{"type":"text","text":" "},{"type":"text","text":"vertices ("},{"code":"minimumWeightMatching","type":"codeVoice"},{"type":"text","text":"), and an Eulerian circuit of their union by Hierholzer"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the"},{"type":"text","text":" "},{"type":"text","text":"complete graph of the odd vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (pairs i < j lexicographic), and the"},{"type":"text","text":" "},{"type":"text","text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,"},{"type":"text","text":" "},{"type":"text","text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the"},{"type":"text","text":" "},{"type":"text","text":"triangle inequality (not checked)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tours read the simple graph, as "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" documents; nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; the sum along a tour fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤"},{"type":"text","text":" "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each weight is read, so a weight beyond it"},{"type":"text","text":" "},{"type":"text","text":"traps even on an edge the matching never sees; so n ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (15 vertices for"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":"), whatever the weights. An arbitrary-precision integer has no bound."}]}]},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}]}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8"]}],"abstract":[{"type":"text","text":"Christofides’ tour (Christofides 1976; Serdyukov 1978)."}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"kind":"symbol","references":{"doc://Tours/documentation/Tours":{"role":"collection","type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","abstract":[],"kind":"symbol","url":"\/documentation\/tours","title":"Tours"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":")