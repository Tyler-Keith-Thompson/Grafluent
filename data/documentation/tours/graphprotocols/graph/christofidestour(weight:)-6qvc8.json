entifier","preciseIdentifier":"s:SZ"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the canonical minimum spanning tree (weight, then position, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"text":"), a minimum-weight perfect matching on its odd-degree","type":"text"},{"text":" ","type":"text"},{"text":"vertices (","type":"text"},{"type":"codeVoice","code":"minimumWeightMatching"},{"text":"), and an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the","type":"text"},{"text":" ","type":"text"},{"text":"complete graph of the odd vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (pairs i < j lexicographic), and the","type":"text"},{"text":" ","type":"text"},{"text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,","type":"text"},{"text":" ","type":"text"},{"text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the","type":"text"},{"text":" ","type":"text"},{"text":"triangle inequality (not checked).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tours read the simple graph, as "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" documents; nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices."}]},{"content":[{"inlineContent":[{"text":"The graph is complete; the sum along a tour fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"W","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"inlineContent":[{"text":"O(n³): the matching on up to n vertices; the tree O(n²).","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Complexity"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://Tours/documentation/Tours/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/tours\/graphprotocols","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/tours\/graphprotocols\/graph","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","kind":"symbol","type":"topic"},"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"title":"christofidesTour(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" 