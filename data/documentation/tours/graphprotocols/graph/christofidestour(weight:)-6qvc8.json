ord"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the canonical minimum spanning tree (weight, then position, as","type":"text"},{"text":" ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":"), a minimum-weight perfect matching on its odd-degree","type":"text"},{"text":" ","type":"text"},{"text":"vertices (","type":"text"},{"code":"minimumWeightMatching","type":"codeVoice"},{"text":"), and an Eulerian circuit of their union by Hierholzer","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the","type":"text"},{"text":" ","type":"text"},{"text":"complete graph of the odd vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (pairs i < j lexicographic), and the","type":"text"},{"text":" ","type":"text"},{"text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,","type":"text"},{"text":" ","type":"text"},{"text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the","type":"text"},{"text":" ","type":"text"},{"text":"triangle inequality (not checked).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Tours read the simple graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}]},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"text":"The graph is complete; the sum along a tour fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"W"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FixedWidthInteger"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"W.max \/ 8"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"type":"codeVoice","code":"W.max \/ 8"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Int8"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}],"type":"paragraph"}],"style":"note"},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Tours/documentation/Tours":{"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tours","title":"Tours","abstract":[],"kind":"symbol","url":"\/documentation\/tours","role":"collection"},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph","title":"Graph","type":"topic","kind":"symbol","url":"\/documentation\/tours\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","abstract":[],"title":"Edges","type":"topic","kind":"symbol"