{"abstract":[{"type":"text","text":"Christofides’ tour (Christofides 1976; Serdyukov 1978)."}],"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}],"extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/Christofides.swift#L140","fileName":"Christofides.swift"},"roleHeading":"Instance Method","role":"symbol","title":"christofidesTour(weight:)","externalID":"s:14GraphProtocols0A0P5ToursE16christofidesTour6weight5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgqd__ANXE_tSZRd__lF","symbolKind":"method"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8"]}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"christofidesTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedInteger","kind":"typeIdentifier","preciseIdentifier":"s:SZ"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes the canonical minimum spanning tree (weight, then position, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":"), a minimum-weight perfect matching on its odd-degree"},{"type":"text","text":" "},{"type":"text","text":"vertices ("},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":"), and an Eulerian circuit of their union by Hierholzer"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the"},{"type":"text","text":" "},{"type":"text","text":"complete graph of the odd vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (pairs i < j lexicographic), and the"},{"type":"text","text":" "},{"type":"text","text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,"},{"type":"text","text":" "},{"type":"text","text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the"},{"type":"text","text":" "},{"type":"text","text":"triangle inequality (not checked)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tours read the simple graph, as "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" documents; nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices."}]},{"style":"note","type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; the sum along a tour fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤"},{"type":"text","text":" "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each weight is read, so a weight beyond it"},{"type":"text","text":" "},{"type":"text","text":"traps even on an edge the matching never sees; so n ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (15 vertices for"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":"), whatever the weights. An arbitrary-precision integer has no bound."}]}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n³): the matching on up to n vertices; the tree O(n²).","type":"text"}]}]}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"title":"Edges","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","type":"topic","abstract":[]},"doc://Tours/documentation/Tours/GraphProtocols":{"title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","url":"\/documentation\/tours\/graphprotocols","role":"collection","type":"topic","abstract":[]},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/Tours\/document