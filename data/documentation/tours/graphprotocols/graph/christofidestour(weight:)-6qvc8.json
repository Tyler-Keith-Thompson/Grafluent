s in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":". When ","type":"text"},{"type":"codeVoice","code":"W"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FixedWidthInteger"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"W.max \/ 8"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"type":"codeVoice","code":"W.max \/ 8"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Int8"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}]}],"style":"note","type":"aside"},{"name":"Complexity","content":[{"inlineContent":[{"text":"O(n³): the matching on up to n vertices; the tree O(n²).","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"references":{"doc://Tours/documentation/Tours/GraphProtocols/Graph/christofidesTour(weight:)-6qvc8":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8","type":"topic","title":"christofidesTour(weight:)","abstract":[{"text":"Christofides’ tour (Christofides 1976; Serdyukov 1978).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind"