xt":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Takes the canonical minimum spanning tree (weight, then position, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":"), a minimum-weight perfect matching on its odd-degree"},{"type":"text","text":" "},{"type":"text","text":"vertices ("},{"type":"codeVoice","code":"minimumWeightMatching"},{"type":"text","text":"), and an Eulerian circuit of their union by Hierholzer"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex, shortcut to the first visit of each vertex. The matching is on the"},{"type":"text","text":" "},{"type":"text","text":"complete graph of the odd vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (pairs i < j lexicographic), and the"},{"type":"text","text":" "},{"type":"text","text":"circuit’s multigraph lists the tree edges by position, then the matched pairs in that order,"},{"type":"text","text":" "},{"type":"text","text":"so the tour is determined. At most 3\/2 × the shortest tour when the weights satisfy the"},{"type":"text","text":" "},{"type":"text","text":"triangle inequality (not checked)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tours read the simple graph, as "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" documents; nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"The graph is complete; the sum along 