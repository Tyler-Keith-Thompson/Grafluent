ing","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tours read the simple graph, as "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" documents; nil below three"},{"type":"text","text":" "},{"type":"text","text":"vertices."}]},{"content":[{"inlineContent":[{"type":"text","text":"The graph is complete; the sum along a tour fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". When "},{"type":"codeVoice","code":"W"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FixedWidthInteger"},{"type":"text","text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤"},{"type":"text","text":" "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (the matching’s bound), checked as each weight is read, so a weight beyond it"},{"type":"text","text":" "},{"type":"text","text":"traps even on an edge the matching never sees; so n ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" (15 vertices for"},{"type":"text","text":" "},{"type":"codeVoice","code":"Int8"},{"type":"text","text":"), whatever the weights. An arbitrary-precision integer has no bound."}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/christofidesTour(weight:)-6qvc8"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8"]}],"metadata"