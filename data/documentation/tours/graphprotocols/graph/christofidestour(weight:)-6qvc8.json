pe":"text"},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n³): the matching on up to n vertices; the tree O(n²)."}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tours\/graphprotocols\/graph\/christofidestour(weight:)-6qvc8"]}],"sections":[],"abstract":[{"type":"text","text":"Christofides’ tour (Christofides 1976; Serdyukov 1978)."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"christofidesTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"k