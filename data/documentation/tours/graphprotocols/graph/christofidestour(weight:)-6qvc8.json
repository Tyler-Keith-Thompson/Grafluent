lete; the sum along a tour fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"W","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"code":"FixedWidthInteger","type":"codeVoice"},{"text":", every non-loop edge’s weight satisfies n · (2 · |weight| + 1) ≤","type":"text"},{"text":" ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (the matching’s bound), checked as each weight is read, so a weight beyond it","type":"text"},{"text":" ","type":"text"},{"text":"traps even on an edge the matching never sees; so n ≤ ","type":"text"},{"code":"W.max \/ 8","type":"codeVoice"},{"text":" (15 vertices for","type":"text"},{"text":" ","type":"text"},{"code":"Int8","type":"codeVoice"},{"text":"), whatever the weights. An arbitrary-precision integer has no bound.","type":"text"}]}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n³): the matching on up to n vertices; the tree O(n²).","type":"text"}]}]}]}],"references":{"doc://Walks/documentation/Walks/Cycle":{"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start."}],"title":"Cycle","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"url":"\/documentation\/walks\/cycle","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}]},"doc://Tours/documentation/Tours/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/tours\/graphprotocols\/graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"abstract":[],"kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Tours\/documentation\/Tour