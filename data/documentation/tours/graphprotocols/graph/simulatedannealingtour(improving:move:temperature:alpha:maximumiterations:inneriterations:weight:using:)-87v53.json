ntation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"tour","content":[{"type":"paragraph","inlineContent":[{"text":"The tour to start from; nil starts from the nearest-neighbour tour.","type":"text"}]}]},{"name":"move","content":[{"inlineContent":[{"type":"text","text":"The kind of move tried."}],"type":"paragraph"}]},{"name":"temperature","content":[{"inlineContent":[{"text":"The starting temperature; nil is a third of the starting tour’s mean edge","type":"text"},{"text":" ","type":"text"},{"text":"weight.","type":"text"}],"type":"paragraph"}]},{"name":"alpha","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The fraction of the temperature lost after each round."}]}]},{"name":"maximumIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rounds without a new shortest tour, less one, before stopping."}]}]},{"name":"innerIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The moves tried in each round; nil is ten per vertex."}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}]},{"name":"generator","content":[{"type":"paragraph","inlineContent":[{"text":"The source of randomn