,{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 0.01, "},{"kind":"externalParam","text":"maximumIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"innerIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"tour","content":[{"inlineContent":[{"text":"The tour to start from; nil starts from the nearest-neighbour tour.","type":"text"}],"type":"paragraph"}]},{"name":"move","content":[{"type":"paragraph","inlineContent":[{"text":"The kind of move tried.","type":"text"}]}]},{"name":"temperature","content":[{"type":"paragraph","inlineContent":[{"text":"The starting temperature; nil is a third of the starting tour’s mean edge","type":"text"},{"text":" ","type":"text"},{"text":"weight.","type":"text"}]}]},{"name":"alpha","content":[{"inlineContent":[{"type":"text","text":"The fraction of the temperature lost after each round."}],"type":"paragraph"}]},{"name":"maximumIterations","content":[{"type":"paragraph","inlineContent":[{"text":"The rounds without a new shortest tour, less one, before stopping.","type":"text"}]}]},{"name":"innerIterations","content":[{"type":"paragraph","inlineContent":[{"text":"The moves tried in each round; nil is ten per vertex.","type":"text"}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"text":"The length of the edge at a position.","type":"text"}]}]},{"name":"generator","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}]}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"text":"The shortest tour met, from the first vertex of the starting tour.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"type":"codeVoice","code":"tour"},{"text":", or from ","type":"text"},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"text":" when it is nil, each round tries","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"innerIterations"},{"text":" random moves of the given kind, the first vertex fixed: a move that does","type":"text"},{"text":" ","type":"text"},{"text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability","type":"text"},{"text":" ","type":"text"},{"text":"exp(−Δ \/ T). The temperature T starts at ","type":"text"},{"type":"codeVoice","code":"temperature"},{"text":" and loses ","type":"text"},{"type":"codeVoice","code":"alpha"},{"text":" × T after each","type":"text"},{"text":" ","type":"text"},{"text":"round. The search returns the shortest tour it met once ","type":"text"},{"type":"codeVoice","code":"maximumIterations"},{"text":" + 1 rounds in","type":"text"},{"text":" ","type":"text"},{"text":"a row found no shorter one. Each step draws two positions from ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":", the first in","type":"text"},{"text":" ","type":"text"},{"text":"1 ..< n and the second among the others, then a ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" in [0, 1) when the move lengthens","type":"text"},{"text":" ","type":"text"},{"text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple","type":"text"},{"text":" ","type":"text"},{"text":"graph, as ","type":"text"},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"text":" documents; nil below three vertices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The defaults scale with the input: the temperature starts at a third of the starting","type":"text"},{"text":" ","type":"text"},{"text":"tour’s mean edge weight, so a move adding one typical edge’s weight is taken about once in","type":"text"},{"text":" ","type":"text"},{"text":"twenty at first and ever more rarely as the temperature falls, and a round tries ten moves","type":"text"},{"text":" ","type":"text"},{"text":"per vertex. Starting from a ","type":"text"},{"code":"twoOptTour(improving:weight:)","type":"codeVoice"},{"text":" rather than the nearest-neighbour","type":"text"},{"text":" ","type":"text"},{"text":"tour gives the search a shorter tour to improve on.","type":"text"}]},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour"},{"type":"text","text":", when given, lists every vertex exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"temperature"},{"type":"text","text":", when given, is finite and at least zero; 0 < "},{"type":"codeVoice","code":"alpha"},{"type":"text","text":" ≤ 1;"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIterations"},{"type":"text","text":" and "},{"type":"codeVoice","code":"innerIterations"},{"type":"text","text":" are at least zero; the tour’s length fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each","type":"text"},{"text":" ","type":"text"},{"text":"relocation taken and each new shortest tour.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tours\/graphprotocols\/graph\/simulatedannealingtour(improving:move:temperature:alpha:maximumiterations:inneriterations:weight:using:)-87v53"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A tour by simulated annealing (Kirkpatrick, Gel