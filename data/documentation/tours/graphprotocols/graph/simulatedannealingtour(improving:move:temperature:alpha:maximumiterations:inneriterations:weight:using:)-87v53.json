ours\/TourMove","text":"TourMove","preciseIdentifier":"s:5Tours8TourMoveO","kind":"typeIdentifier"},{"text":" = .relocate, ","kind":"text"},{"text":"temperature","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"alpha","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.01, ","kind":"text"},{"text":"maximumIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 50, ","kind":"text"},{"text":"innerIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SG","text":"RandomNumberGenerator","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sz","text":"BinaryInteger","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"tour","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour to start from; nil starts from the nearest-neighbour tour."}]}]},{"name":"move","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The kind of move tried."}]}]},{"name":"temperature","content":[{"inlineContent":[{"type":"text","text":"The starting temperature; nil is a third of the starting tour’s mean edge"},{"type":"text","text":" "},{"type":"text","text":"weight."}],"type":"paragraph"}]},{"name":"alpha","content":[{"inlineContent":[{"type":"text","text":"The fraction of the temperature lost after each round."}],"type":"paragraph"}]},{"name":"maximumIterations","content":[{"inlineContent":[{"type":"text","text":"The rounds without a new shortest tour, less one, before stopping."}],"type":"paragraph"}]},{"name":"innerIterations","content":[{"inlineContent":[{"type":"text","text":"The moves tried in each round; nil is ten per vertex."}],"type":"paragraph"}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}]},{"name":"generator","content":[{"inlineContent":[{"type":"text","text":"The source of randomness."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The shortest tour met, from the first vertex of the starting tour."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"From "},{"code":"tour","type":"codeVoice"},{"type":"text","text":", or from "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" when it is nil, each round tries"},{"type":"text","text":" "},{"code":"innerIterations","type":"codeVoice"},{"type":"text","text":" random moves of the given kind, the first vertex fixed: a move that does"},{"type":"text","text":" "},{"type":"text","text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability"},{"type":"text","text":" "},{"type":"text","text":"exp(−Δ \/ T). The temperature T starts at "},{"code":"temperature","type":"codeVoice"},{"type":"text","text":" and loses "},{"code":"alpha","type":"codeVoice"},{"type":"text","text":" × T after each"},{"type":"text","text":" "},{"type":"text","text":"round. The search returns the shortest tour it met once "},{"code":"maximumIterations","type":"codeVoice"},{"type":"text","text":" + 1 rounds in"},{"type":"text","text":" "},{"type":"text","text":"a row found no shorter one. Each step draws two positions from "},{"code":"generator","type":"codeVoice"},{"type":"text","text":", the first in"},{"type":"text","text":" "},{"type":"text","text":"1 ..< n and the second among the others, then a "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" in [0, 1) when the move lengthens"},{"type":"text","text":" "},{"type":"text","text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple"},{"type":"text","text":" "},{"type":"text","text":"graph, as "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" documents; nil below three vertices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The defaults scale with the input: the temperature starts at a third of the starting"},{"type":"text","text":" "},{"type":"text","text":"tour’s mean edge weight, so a move adding one typical edge’s weight is taken about once in"},{"type":"text","text":" "},{"type":"text","text":"twenty at first and ever more rarely as the temperature falls, and a round tries ten moves"},{"type":"text","text":" "},{"type":"text","text":"per vertex. Starting from a "},{"type":"codeVoice","code":"twoOptTour(improving:weight:)"},{"type":"text","text":" rather than the nearest-neighbour"},{"type":"text","text":" "},{"type":"text","text":"tour gives the search a shorter tour to improve on."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour"},{"type":"text","text":", when given, lists every vertex exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"temperature"},{"type":"text","text":", when given, is finite and at least zero; 0 < "},{"type":"codeVoice","code":"alpha"},{"type":"text","text":" ≤ 1;"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIterations"},{"type":"text","text":" and "},{"type":"codeVoice","code":"innerIterations"},{"type":"text","text":" are at least zero; the tour’s length fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each","type":"text"},{"text":" ","type":"text"},{"text":"relocation taken and each new shortest tou