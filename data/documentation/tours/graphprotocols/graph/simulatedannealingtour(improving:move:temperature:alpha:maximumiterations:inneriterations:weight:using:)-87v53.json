xt","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"}],"platforms":["Linux"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The tour to start from; nil starts from the nearest-neighbour tour.","type":"text"}]}],"name":"tour"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The kind of move tried.","type":"text"}]}],"name":"move"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The starting temperature; nil is a third of the starting tour’s mean edge","type":"text"},{"text":" ","type":"text"},{"text":"weight.","type":"text"}]}],"name":"temperature"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The fraction of the temperature lost after each round.","type":"text"}]}],"name":"alpha"},{"content":[{"inlineContent":[{"text":"The rounds without a new shortest tour, less one, before stopping.","type":"text"}],"type":"paragraph"}],"name":"maximumIterations"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The moves tried in each round; nil is ten per vertex.","type":"text"}]}],"name":"innerIterations"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The length of the edge at a position.","type":"text"}]}],"name":"weight"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}],"name":"generator"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"text":"The shortest tour met, from the first vertex of the starting tour.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"code":"tour","type":"codeVoice"},{"text":", or from ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" when it is nil, each round tries","type":"text"},{"text":" ","type":"text"},{"code":"innerIterations","type":"codeVoice"},{"text":" random moves of the given kind, the first vertex fixed: a move that does","type":"text"},{"text":" ","type":"text"},{"text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability","type":"text"},{"text":" ","type":"text"},{"text":"exp(−Δ \/ T). The temperature T starts at ","type":"text"},{"code":"temperature","type":"codeVoice"},{"text":" and loses ","type":"text"},{"code":"alpha","type":"codeVoice"},{"text":" × T after each","type":"text"},{"text":" ","type":"text"},{"text":"round. The search returns the shortest tour it met once ","type":"text"},{"code":"maximumIterations","type":"codeVoice"},{"text":" + 1 rounds in","type":"text"},{"text":" ","type":"text"},{"text":"a row found no shorter one. Each step draws two positions from ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":", the first in","type":"text"},{"text":" ","type":"text"},{"text":"1 ..< n and the second among the others, then a ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" in [0, 1) when the move lengthens","type":"text"},{"text":" ","type":"text"},{"text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple","type":"text"},{"text":" ","type":"text"},{"text":"graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three vertices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The defaults scale with the in