mentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">? = nil, ","kind":"text"},{"text":"move","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TourMove","identifier":"doc:\/\/Tours\/documentation\/Tours\/TourMove","kind":"typeIdentifier","preciseIdentifier":"s:5Tours8TourMoveO"},{"text":" = .relocate, ","kind":"text"},{"text":"temperature","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? = nil, ","kind":"text"},{"text":"alpha","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.01, ","kind":"text"},{"text":"maximumIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 50, ","kind":"text"},{"text":"innerIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}],"languages":["swift"],"platforms":["Linux"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The tour to start from; nil starts from the nearest-neighbour tour.","type":"text"}],"type":"paragraph"}],"name":"tour"},{"content":[{"inlineContent":[{"type":"text","text":"The kind of move tried."}],"type":"paragraph"}],"name":"move"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The starting temperature; nil is a third of the starting tour’s mean edge","type":"text"},{"text":" ","type":"text"},{"text":"weight.","type":"text"}]}],"name":"temperature"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The fraction of the temperature lost after each round.","type":"text"}]}],"name":"alpha"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rounds without a new shortest tour, less one, before stopping."}]}],"name":"maximumIterations"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The moves tried in each round; nil is ten per vertex.","type":"text"}]}],"name":"innerIterations"},{"content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}],"name":"weight"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The source of randomness.","type":"text"}]}],"name":"generator"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The shortest tour met, from the first vertex of the starting tour."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"From ","type":"text"},{"code":"tour","type":"codeVoice"},{"text":", or from ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" when it is nil, each round tries","type":"text"},{"text":" ","type":"text"},{"code":"innerIterations","type":"codeVoice"},{"text":" random moves of the given kind, the first vertex fixed: a move that does","type":"text"},{"text":" ","type":"text"},{"text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability","type":"text"},{"text":" ","type":"text"},{"text":"exp(−Δ \/ T). The temperature T starts at ","type":"text"},{"code":"temperature","type":"codeVoice"},{"text":" and loses ","type":"text"},{"code":"alpha","type":"codeVoice"},{"text":" × T after each","type":"text"},{"text":" ","type":"text"},{"text":"round. The search returns the shortest tour it met once ","type":"text"},{"code":"maximumIterations","type":"codeVoice"},{"text":" + 1 rounds in","type":"text"},{"text":" ","type":"text"},{"text":"a row found no shorter one. Each step draws two positions from ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":", the first in","type":"text"},{"text":" ","type":"text"},{"text":"1 ..< n and the second among the others, then a ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" in [0, 1) when the move lengthens","type":"text"},{"text":" ","type":"text"},{"text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple","type":"text"},{"text":" ","type":"text"},{"text":"graph, as ","type":"text"},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"text":" documents; nil below three vertices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The defaults scale with the input: the temperature starts at a third of the starting","type":"text"},{"text":" ","type":"text"},{"text":"tour’s mean edge weight, so a move adding one typical edge’s weight is taken about once in","type":"text"},{"text":" ","type":"text"},{"text":"twenty at first and ever more rarely as the temperature falls, and a round tries ten moves","type":"text"},{"text":" ","type":"text"},{"text":"per vertex. Starting from a ","type":"text"},{"code":"twoOptTour(improving:weight:)","type":"codeVoice"},{"text":" rather than the nearest-neighbour","type":"text"},{"text":" ","type":"text"},{"text":"tour gives the search a shorter tour to improve on.","type":"text"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"The graph is complete; ","type":"text"},{"code":"tour","type":"codeVoice"},{"text":", when given, lists every vertex exactly","type":"text"},{"text":" ","type":"text"},{"text":"once; ","type":"text"},{"code":"temperature","type":"codeVoice"},{"text":", when given, is finite and at least zero; 0 < ","type":"text"},{"code":"alpha","type":"codeVoice"},{"text":" ≤ 1;","type":"text"},{"text":" ","type":"text"},{"code":"maximumIterations","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"innerIterations","type":"codeVoice"},{"text":" are at least zero; the tour’s length fits in","type":"text"},{"text":" ","type":"text"},{"code":"W","type":"codeVoice"},{"text":".","type":"text"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each","type":"text"},{"text":" ","type":"text"},{"text":"relocation taken and each new shortest tour.","type":"text"}]}]}]}],"metadata":{"role":"symbol","title":"simulatedAnnealingTour(improving:move:temperature:alpha:maximumIterations:innerIterations:weight:using:)","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"Tours"}],"remoteSource":{"fileName":"SimulatedAnnealing.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Tours\/SimulatedAnnealing.swift#L262"},"extendedModule":"GraphProtocols","symbolKind":"method","externalID":"s:14GraphProtocols0A0P5ToursE22simulatedAnnealingTour9improving4move11temperature5alpha17maximumIterations05innerL06weight5using5Walks5CycleVy6VertexQz5Edges_5IndexQZGSgAW_AD0F4MoveOSdSgSdS2iSgqd__AUXEqd_0_ztSzRd__SGRd_0_r0_lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simulatedAnnealingTour","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"improving","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"}