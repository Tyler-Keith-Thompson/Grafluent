eciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","preciseIdentifier":"s:Sz","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour to start from; nil starts from the nearest-neighbour tour."}]}],"name":"tour"},{"content":[{"inlineContent":[{"text":"The kind of move tried.","type":"text"}],"type":"paragraph"}],"name":"move"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The starting temperature; nil is a third of the starting tour’s mean edge","type":"text"},{"text":" ","type":"text"},{"text":"weight.","type":"text"}]}],"name":"temperature"},{"content":[{"inlineContent":[{"text":"The fraction of the temperature lost after each round.","type":"text"}],"type":"paragraph"}],"name":"alpha"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rounds without a new shortest tour, less one, before stopping."}]}],"name":"maximumIterations"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The moves tried in each round; nil is ten per vertex."}]}],"name":"innerIterations"},{"content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}],"name":"weight"},{"content":[{"inlineContent":[{"text":"The source of randomness.","type":"text"}],"type":"paragraph"}],"name":"generator"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The shortest tour met, from the first vertex of the starting tour.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"From "},{"code":"tour","type":"codeVoice"},{"type":"text","text":", or from "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" when it is nil, each round tries"},{"type":"text","text":" "},{"code":"innerIterations","type":"codeVoice"},{"type":"text","text":" random moves of the given kind, the first vertex fixed: a move that does"},{"type":"text","text":" "},{"type":"text","text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability"},{"type":"text","text":" "},{"type":"text","text":"exp(−Δ \/ T). The temperature T starts at "},{"code":"temperature","type":"codeVoice"},{"type":"text","text":" and loses "},{"code":"alpha","type":"codeVoice"},{"type":"text","text":" × T after each"},{"type":"text","text":" "},{"type":"text","text":"round. The search returns the shortest tour it met once "},{"code":"maximumIterations","type":"codeVoice"},{"type":"text","text":" + 1 rounds in"},{"type":"text","text":" "},{"type":"text","text":"a row found no shorter one. Each step draws two positions from "},{"code":"generator","type":"codeVoice"},{"type":"text","text":", the first in"},{"type":"text","text":" "},{"type":"text","text":"1 ..< n and the second among the others, then a "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" in [0, 1) when the move lengthens"},{"type":"text","text":" "},{"type":"text","text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple"},{"type":"text","text":" "},{"type":"text","text":"graph, as "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" documents; nil below three vertices."}],"type":"paragraph"},{"inlineContent":[{"text":"The defaults scale with the input: the temperature starts at a third of the starting","type":"text"},{"text":" ","type":"text"},{"text":"tour’s mean edge weight, so a move adding one typical edge’s weight is taken about once in","type":"text"},{"text":" ","type":"text"},{"text":"twenty at first and ever more rarely as the temperature falls, and a round tries ten moves","type":"text"},{"text":" ","type":"text"},{"text":"per vertex. Starting from a ","type":"text"},{"type":"codeVoice","code":"twoOptTour(improving:weight:)"},{"text":" rather than the nearest-neighbour","type":"text"},{"text":" ","type":"text"},{"text":"tour gives the search a shorter tour to improve on.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"code":"tour","type":"codeVoice"},{"type":"text","text":", when given, lists every vertex exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"code":"temperature","type":"codeVoice"},{"type":"text","text":", when given, is finite and at least zero; 0 < "},{"code":"alpha","type":"codeVoice"},{"type":"text","text":" ≤ 1;"},{"type":"text","text":" "},{"code":"maximumIterations","type":"codeVoice"},{"type":"text","text":" and "},{"code":"innerIterations","type":"codeVoice"},{"type":"text","text":" are at least zero; the tour’s length fits in"},{"type":"text","text":" "},{"code":"W","type":"codeVoice"},{"type":"text","text":"."}]}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each"},{"type":"text","text":" "},{"type":"text","text":"relocation taken and each new shortest tour."}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}]}],"sections":[],"abstract":[{"text":"A tour by simulated annealing (Kirkpatrick, Gelatt and Vecchi, “Optimization by simulated","type":"text"},{"text":" ","type":"text"},{"text":"annealing”, Science 220, 1983), as NetworkX’s ","type":"text"},{"code":"simulated_annealing_tsp","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/simulatedAnnealingTour(improving:move:temperature:alpha:maximumIterations:innerIterations:weight:using:)-87v53","interfaceLanguage":"swift"},"varia