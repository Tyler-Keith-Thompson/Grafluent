{"hierarchy":{"paths":[["doc:\/\/Tours\/documentation\/Tours","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols","doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph"]]},"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A tour by simulated annealing (Kirkpatrick, Gelatt and Vecchi, “Optimization by simulated"},{"type":"text","text":" "},{"type":"text","text":"annealing”, Science 220, 1983), as NetworkX’s "},{"code":"simulated_annealing_tsp","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simulatedAnnealingTour"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"improving"},{"kind":"text","text":" "},{"kind":"internalParam","text":"tour"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"move"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Tours\/documentation\/Tours\/TourMove","text":"TourMove","preciseIdentifier":"s:5Tours8TourMoveO"},{"kind":"text","text":" = .relocate, "},{"kind":"externalParam","text":"temperature"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"alpha"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 0.01, "},{"kind":"externalParam","text":"maximumIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"innerIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryInteger","preciseIdentifier":"s:Sz"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"tour","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tour to start from; nil starts from the nearest-neighbour tour."}]}]},{"name":"move","content":[{"inlineContent":[{"type":"text","text":"The kind of move tried."}],"type":"paragraph"}]},{"name":"temperature","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The starting temperature; nil is a third of the starting tour’s mean edge"},{"type":"text","text":" "},{"type":"text","text":"weight."}]}]},{"name":"alpha","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The fraction of the temperature lost after each round."}]}]},{"name":"maximumIterations","content":[{"inlineContent":[{"text":"The rounds without a new shortest tour, less one, before stopping.","type":"text"}],"type":"paragraph"}]},{"name":"innerIterations","content":[{"inlineContent":[{"type":"text","text":"The moves tried in each round; nil is ten per vertex."}],"type":"paragraph"}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}]},{"name":"generator","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The shortest tour met, from the first vertex of the starting tour."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"From "},{"type":"codeVoice","code":"tour"},{"type":"text","text":", or from "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" when it is nil, each round tries"},{"type":"text","text":" "},{"type":"codeVoice","code":"innerIterations"},{"type":"text","text":" random moves of the given kind, the first vertex fixed: a move that does"},{"type":"text","text":" "},{"type":"text","text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability"},{"type":"text","text":" "},{"type":"text","text":"exp(−Δ \/ T). The temperature T starts at "},{"type":"codeVoice","code":"temperature"},{"type":"text","text":" and loses "},{"type":"codeVoice","code":"alpha"},{"type":"text","text":" × T after each"},{"type":"text","text":" "},{"type":"text","text":"round. The search returns the shortest tour it met once "},{"type":"codeVoice","code":"maximumIterations"},{"type":"text","text":" + 1 rounds in"},{"type":"text","text":" "},{"type":"text","text":"a row found no shorter one. Each step draws two positions from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":", the first in"},{"type":"text","text":" "},{"type":"text","text":"1 ..< n and the second among the others, then a "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" in [0, 1) when the move lengthens"},{"type":"text","text":" "},{"type":"text","text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple"},{"type":"text","text":" "},{"type":"text","text":"graph, as "},{"type":"codeVoice","code":"nearestNeighborTour(weight:)"},{"type":"text","text":" documents; nil below three vertices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The defaults scale with the input: the temperature starts at a third of the starting"},{"type":"text","text":" "},{"type":"text","text":"tour’s mean edge weight, so a move adding one typical edge’s weight is taken about once in"},{"type":"text","text":" "},{"type":"text","text":"twenty at first and ever more rarely as the temperature falls, and a round tries ten moves"},{"type":"text","text":" "},{"type":"text","text":"per vertex. Starting from a "},{"type":"codeVoice","code":"twoOptTour(improving:weight:)"},{"type":"text","text":" rather than the nearest-neighbour"},{"type":"text","text":" "},{"type":"text","text":"tour gives the search a shorter tour to improve on."}],"type":"paragraph"},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour"},{"type":"text","text":", when given, lists every vertex exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"temperature"},{"type":"text","text":", when given, is finite and at least zero; 0 < "},{"type":"codeVoice","code":"alpha"},{"type":"text","text":" ≤ 1;"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIterations"},{"type":"text","text":" and "},{"type":"codeVoice","code":"innerIterations"},{"type":"text","text":" are at least zero; the tour’s length fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"style":"note"},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each","type":"text"},{"text":" ","type":"text"},{"text":"relocation taken and each new shortest tour.","type":"text"}]}],"style":"note"}]}],"identifier":{"