nd":"text","text":"? = nil, "},{"kind":"externalParam","text":"alpha"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 0.01, "},{"kind":"externalParam","text":"maximumIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"innerIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryInteger","preciseIdentifier":"s:Sz"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The tour to start from; nil starts from the nearest-neighbour tour."}],"type":"paragraph"}],"name":"tour"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The kind of move tried.","type":"text"}]}],"name":"move"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The starting temperature; nil is a third of the starting tour’s mean edge"},{"type":"text","text":" "},{"type":"text","text":"weight."}]}],"name":"temperature"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The fraction of the temperature lost after each round.","type":"text"}]}],"name":"alpha"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The rounds without a new shortest tour, less one, before stopping.","type":"text"}]}],"name":"maximumIterations"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The moves tried in each round; nil is ten per vertex."}]}],"name":"innerIterations"},{"content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}],"name":"weight"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}],"name":"generator"}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The shortest tour met, from the first vertex of the starting tour."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"From "},{"code":"tour","type":"codeVoice"},{"type":"text","text":", or from "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" when it is nil, each round tries"},{"type":"text","text":" "},{"code":"innerIterations","type":"codeVoice"},{"type":"text","text":" random moves of the given kind, the first vertex fixed: a move that does"},{"type":"text","text":" "},{"type":"text","text":"not lengthen the tour is taken, and one that lengthens it by Δ is taken with probability"},{"type":"text","text":" "},{"type":"text","text":"exp(−Δ \/ T). The temperature T starts at "},{"code":"temperature","type":"codeVoice"},{"type":"text","text":" and loses "},{"code":"alpha","type":"codeVoice"},{"type":"text","text":" × T after each"},{"type":"text","text":" "},{"type":"text","text":"round. The search returns the shortest tour it met once "},{"code":"maximumIterations","type":"codeVoice"},{"type":"text","text":" + 1 rounds in"},{"type":"text","text":" "},{"type":"text","text":"a row found no shorter one. Each step draws two positions from "},{"code":"generator","type":"codeVoice"},{"type":"text","text":", the first in"},{"type":"text","text":" "},{"type":"text","text":"1 ..< n and the second among the others, then a "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" in [0, 1) when the move lengthens"},{"type":"text","text":" "},{"type":"text","text":"the tour, so a seeded generator gives the same tour every time. Tours read the simple"},{"type":"text","text":" "},{"type":"text","text":"graph, as "},{"code":"nearestNeighborTour(weight:)","type":"codeVoice"},{"type":"text","text":" documents; nil below three vertices."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The defaults scale with the input: the temperature starts at a third of the starting"},{"type":"text","text":" "},{"type":"text","text":"tour’s mean edge weight, so a move adding one typical edge’s weight is taken about once in"},{"type":"text","text":" "},{"type":"text","text":"twenty at first and ever more rarely as the temperature falls, and a round tries ten moves"},{"type":"text","text":" "},{"type":"text","text":"per vertex. Starting from a "},{"type":"codeVoice","code":"twoOptTour(improving:weight:)"},{"type":"text","text":" rather than the nearest-neighbour"},{"type":"text","text":" "},{"type":"text","text":"tour gives the search a shorter tour to improve on."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is complete; "},{"type":"codeVoice","code":"tour"},{"type":"text","text":", when given, lists every vertex exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"temperature"},{"type":"text","text":", when given, is finite and at least zero; 0 < "},{"type":"codeVoice","code":"alpha"},{"type":"text","text":" ≤ 1;"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIterations"},{"type":"text","text":" and "},{"type":"codeVoice","code":"innerIterations"},{"type":"text","text":" are at least zero; the tour’s length fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n²) to read the weights, then O(1) per move tried, plus O(n) for each"},{"type":"text","text":" "},{"type":"text","text":"relocation taken and each new shortest tour."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Tours\/documentation\/Tours\/GraphProtocols\/Graph\/simulatedAnnealingTour(improving:move:temperature:alpha:maximumIterations:innerIterations:weight:using:)-87v53"},"sections":[],"varia