"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph","type":"topic","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","abstract":[]},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols":{"kind":"symbol","url":"\/documentation\/bipartitegraphs\/graphprotocols","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols","type":"topic","title":"GraphProtocols","role":"collection","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"url":"\/documentation\/graphprotocols\/graph","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/isBipartite":{"title":"isBipartite","kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"Whether the vertices split into two sides with every edge across: no odd cycle, so no","type":"text"},{"text":" ","type":"text"},{"text":"self-loop. Parallel edges do not matter. One breadth-first search, O(n + m).","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBipartite"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/isbipartite","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/isBipartite"},"doc://BipartiteGraphs/documentation/BipartiteGraphs":{"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/bipartitegraphs","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs","abstract":[],"title":"BipartiteGraphs"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/bipartition()":{"title":"bipartition()","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The two sides, or nil when the graph is not bipartite ("},{"type":"codeVoice","code":"findOddCycle()"},{"type":"text","text":" is then the witness)."},{"type":"text","text":" "},{"type":"text","text":"In each connected component the least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) is left and the rest"},{"type":"text","text":" "},{"type":"text","text":"alternate, so isolated vertices are left; each side lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s assignment). O(n + m)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bipartition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","text":"Bipartition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/bipartition()","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraph