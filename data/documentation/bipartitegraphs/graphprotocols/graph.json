/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/bipartition()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bipartition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","text":"Bipartition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/bipartition()","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The two sides, or nil when the graph is not bipartite ("},{"type":"codeVoice","code":"findOddCycle()"},{"type":"text","text":" is then the witness)."},{"type":"text","text":" "},{"type":"text","text":"In each connected component the least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) is left and the rest"},{"type":"text","text":" "},{"type":"text","text":"alternate, so isolated vertices are left; each side lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s assignment). O(n + m)."}],"type":"topic"},"doc://BipartiteGraphs/documentation/BipartiteGraphs":{"title":"BipartiteGraphs","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs","url":"\/documentation\/bipartitegraphs","kind":"symbol","role":"collection","abstract":[],"type":"topic"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols":{"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/bipartitegraphs\/graphprotocols","kind":"symbol","role":"collection","abstract":[],"type":"topic"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph":{"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph","abstract":[],"title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"type":"topic","kind":"symbol","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/findOddCycle()":{"title":"findOddCycle()","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/findOddCycle()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findOddCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":