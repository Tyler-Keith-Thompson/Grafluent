 ("},{"code":"findOddCycle()","type":"codeVoice"},{"type":"text","text":" is then the witness)."},{"type":"text","text":" "},{"type":"text","text":"In each connected component the least vertex (in "},{"code":"vertices","type":"codeVoice"},{"text":" order) is left and the rest","type":"text"},{"text":" ","type":"text"},{"text":"alternate, so isolated vertices are left; each side lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s assignment). O(n + m).","type":"text"}],"type":"topic","url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/bipartition()"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols":{"title":"GraphProtocols","abstract":[],"role":"collection","kind":"symbol","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols","type":"topic","url":"\/documentation\/bipartitegraphs\/graphprotocols"},"doc://BipartiteGraphs/documentation/BipartiteGraphs":{"title":"BipartiteGraphs","kind":"symbol","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs","role":"collection","abstract":[],"type":"topic","url":"\/documentation\/bipartitegraphs"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/isBipartite":{"title":"isBipartite","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBipartite","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/isBipartite","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether the vertices split into two sides with every edge across: no odd cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"self-loop. Parallel edges do not matter. One breadth-first search, O(n + m)."}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/isbipartite"}}}