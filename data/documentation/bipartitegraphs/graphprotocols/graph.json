type":"text","text":" "},{"type":"text","text":"least vertex and leaves through the lesser of its two edges. Not necessarily a shortest odd"},{"type":"text","text":" "},{"type":"text","text":"cycle. O(n + m)."}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/findOddCycle()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findOddCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/findoddcycle()","title":"findOddCycle()","kind":"symbol","role":"symbol"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph","title":"Graph","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph","type":"topic","role":"symbol","kind":"symbol"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/bipartition()":{"abstract":[{"type":"text","text":"The two sides, or nil when the graph is not bipartite ("},{"code":"findOddCycle()","type":"codeVoice"},{"type":"text","text":" is then the witness)."},{"type":"text","text":" "},{"type":"text","text":"In each connected component the least vertex (in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) is left and the rest"},{"type":"text","text":" "},{"type":"text","text":"alternate, so isolated vertices are left; each side lists its vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s assignment). O(n + m)."}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/bipartition()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bipartition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/bipartition()","title":"bipartition()","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","t