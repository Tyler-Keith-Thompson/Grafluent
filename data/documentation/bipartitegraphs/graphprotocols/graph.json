,"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/bipartition()":{"title":"bipartition()","abstract":[{"type":"text","text":"The two sides, or nil when the graph is not bipartite ("},{"type":"codeVoice","code":"findOddCycle()"},{"type":"text","text":" is then the witness)."},{"type":"text","text":" "},{"type":"text","text":"In each connected component the least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) is left and the rest"},{"type":"text","text":" "},{"type":"text","text":"alternate, so isolated vertices are left; each side lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s assignment). O(n + m)."}],"role":"symbol","type":"topic","url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/bipartition()","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/bipartition()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bipartition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/isBipartite":{"type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBipartite","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"text":"Whether the vertices split into two sides with every edge across: no odd cycle, so no","type":"text"},{"text":" ","type":"text"},{"text":"self-loop. Parallel edges do not matter. One breadth-first search, O(n + m).","type":"text"}],"title":"isBipartite","url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/isbipartite","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/isBipartite"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph/findOddCycle()":{"url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph\/findoddcycle()","type":"topic","role":"symbol","title":"findOddCycle()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findOddCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","abstract":[{"text":"An odd cycle, or nil when the graph is bipartite (Boost ","type":"text"},{"code":"find_odd_cycle","type":"codeVoice"},{"text":"): the first one a","type":"text"},{"text":" ","type":"text"},{"text":"breadth-first two-colouring meets (roots in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, rows in ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order), closed through the conflicting edge’s ends’ lowest common ancestor in the search","type":"text"},{"text":" ","type":"text"},{"text":"tree. A self-loop is an odd cycle of length 1. In Cycles’ canonical form: it starts at its","type":"text"},{"text":" ","type":"text"},{"text":"least vertex and leaves through the lesser of its two edges. Not necessarily a shortest odd","type":"text"},{"text":" ","type":"text"},{"text":"cycle. O(n + m).","type":"text"}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph\/findOddCycle()"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols":{"title":"GraphProtocols","abstract":[],"role":"collection","type":"topic","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols","url":"\/documentation\/bipartitegraphs\/graphprotocols","kind":"symbol"},"doc://BipartiteGraphs/documentation/BipartiteGraphs":{"type":"topic","title":"BipartiteGraphs","role":"collection","url":"\/documentation\/bipartitegraphs","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs","abstract":[],"kind":"symbol"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/GraphProtocols/Graph":{"title":"Graph","abstract":[],"role":"symbol","type":"topic","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/GraphProtocols\/Graph","url":"\/documentation\/bipartitegraphs\/graphprotocols\/graph","kind":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"navigatorTitle