aphs\/bipartitegraph"},"doc://Walks/documentation/Walks/Cycle":{"title":"Cycle","type":"topic","abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"url":"\/documentation\/walks\/cycle","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"}}}