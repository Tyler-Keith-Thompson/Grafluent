ap’s storage, not","type":"text"},{"text":" ","type":"text"},{"text":"the graph, so later mutations of the graph or the map do not show through.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeValues","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeValues","kind":"identifier"}],"title":"EdgeValues"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeMap","kind":"identifier"}],"navigatorTitle":[{"text":"EdgeMap","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A handle to a map from edge positions to "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" attached to a graph (LEMON’s "},{"type":"codeVoice","code":"ArcMap"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"returned by "},{"type":"codeVoice","code":"PropertyGraph.addEdgeMap(default:)"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"type":"codeVoice","code":"graph[handle, ofEdgeAt: position]"},{"type":"text","text":". It is valid on the graph that added it"},{"type":"text","text":" "},{"type":"text","text":"and on every copy of that graph, until "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":"; on another graph it traps."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","url":"\/documentation\/graphprotocols\/edgemap","type":"topic","title":"EdgeMap","role":"symbol"}}}