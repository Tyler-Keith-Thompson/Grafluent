/BipartiteGraph":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"abstract":[{"type":"text","text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so"},{"type":"text","text":" "},{"type":"text","text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left"},{"type":"text","text":" "},{"type":"text","text":"endpoint first, so "},{"type":"codeVoice","code":"edges[e].u"},{"type":"text","text":" is its left end."}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"kind":"symbol","title":"BipartiteGraph","type":"topic","url":"\/documentation\/bipartitegraphs\/bipartitegraph"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/SideVertices":{"navigatorTitle":[{"text":"SideVertices","kind":"identifier"}],"title":"BipartiteGraph.SideVertices","role":"symbol","kind":"symbol","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/sidevertices","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SideVertices","kind":"identifier"}],"abstract":[{"type":"text","text":"A side’s vertices: a value, unaffected by later changes to the graph. It holds a copy of the"},{"type":"text","text":" "},{"type":"text","text":"graph’s storage (copy-on-write), so mutating the graph while one is alive copies the graph."}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/SideVertices","type":"topic"}}}