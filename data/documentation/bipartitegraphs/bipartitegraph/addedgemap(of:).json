titeGraph":{"title":"BipartiteGraph","abstract":[{"text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left","type":"text"},{"text":" ","type":"text"},{"text":"endpoint first, so ","type":"text"},{"code":"edges[e].u","type":"codeVoice"},{"text":" is its left end.","type":"text"}],"url":"\/documentation\/bipartitegraphs\/bipartitegraph","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeMap","kind":"identifier"}],"navigatorTitle":[{"text":"EdgeMap","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A handle to a map from edge positions to "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" attached to a graph (LEMON’s "},{"type":"codeVoice","code":"ArcMap"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"returned by "},{"type":"codeVoice","code":"PropertyGraph.addEdgeMap(default:)"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"type":"codeVoice","code":"graph[handle, ofEdgeAt: position]"},{"type":"text","text":". It is valid on the graph that added it"},{"type":"text","text":" "},{"type":"text","text":"and on every copy of that graph, until "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":"; on another graph it traps."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtoco