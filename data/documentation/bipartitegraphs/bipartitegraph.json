t","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"The graph is simple and has no self-loop. An edge is inserted once, in either orientation, and","type":"text"},{"text":" ","type":"text"},{"text":"is stored left endpoint first, so ","type":"text"},{"type":"codeVoice","code":"edges[e].u"},{"text":" is its left end.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every initializer from unchecked input is failable, and a mutation that would break the","type":"text"},{"text":" ","type":"text"},{"text":"bipartition throws ","type":"text"},{"code":"BipartitionError","type":"codeVoice"},{"text":" and changes nothing. Whether an edge may be inserted is an","type":"text"},{"text":" ","type":"text"},{"text":"O(1) test with ","type":"text"},{"code":"side(of:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"BipartiteGraph"},{"type":"text","text":" wraps an "},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":" ("},{"type":"codeVoice","code":"base"},{"type":"text","text":" reads it), and"},{"type":"text","text":" "},{"type":"text","text":"storage and mutation costs are the list’s. Vertex indices are slots ("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) and edge"},{"type":"text","text":" "},{"type":"text","text":"indices are positions. A removal moves the last slot or edge into the hole, so orders and"},{"type":"text","text":" "},{"type":"text","text":"positions change after a removal. Every read is the base’s, and so are attached maps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":", which follow those moves) and "},{"type":"codeVoice","code":"generation"},{"type":"text","text":". Equality compares vertex sets,"},{"type":"text","text":" "},{"type":"text","text":"edge sets and each vertex’s side, not orders, and ignores maps."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/GraphAdaptor-Implementations":{"type":"topic","abstract":[],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/GraphAdaptor-Implementations","role":"collectionGroup","kind":"article","title":"GraphAdaptor Implementations","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/graphadaptor-implementations"},"doc://BipartiteGraphs/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/BipartiteGraphs\/s8CopyableP"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/remove(_:)":{"abstract":[{"type":"text","text":"Removes "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" and its edges. O(degree), plus the degree of the vertex that moves into its"},{"type":"text","text":" "},{"type":"text","text":"slot."}],"kind":"symbol","title":"remove(_:)","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/remove(_:)","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/remove(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"?"}]},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/PropertyGraph-Implementations":{