iteGraphs/documentation/BipartiteGraphs/BipartiteGraph/init(_:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">)"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/init(_:)","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/init(_:)","abstract":[{"type":"text","text":"The graph’s vertices (in order), edges (in position order, so at their positions when the"},{"type":"text","text":" "},{"type":"text","text":"graph has no parallel edges; repeats dropped), and the canonical sides of "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"nil when the graph is not bipartite: "},{"type":"codeVoice","code":"graph.findOddCycle()"},{"type":"text","text":" is then the witness. O(n + m)."}],"title":"init(_:)"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"url":"\/documentation\/graphprotocols\/graph","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/