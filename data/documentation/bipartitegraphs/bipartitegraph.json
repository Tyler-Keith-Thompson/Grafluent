fier":"s:SH"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"text":"The graph is simple and has no self-loop. An edge is inserted once, in either orientation, and","type":"text"},{"text":" ","type":"text"},{"text":"is stored left endpoint first, so ","type":"text"},{"code":"edges[e].u","type":"codeVoice"},{"text":" is its left end.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every initializer from unchecked input is failable, and a mutation that would break the","type":"text"},{"text":" ","type":"text"},{"text":"bipartition throws ","type":"text"},{"type":"codeVoice","code":"BipartitionError"},{"text":" and changes nothing. Whether an edge may be inserted is an","type":"text"},{"text":" ","type":"text"},{"text":"O(1) test with ","type":"text"},{"type":"codeVoice","code":"side(of:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"BipartiteGraph","type":"codeVoice"},{"type":"text","text":" wraps an "},{"code":"UndirectedAdjacencyList","type":"codeVoice"},{"type":"text","text":" as a "},{"code":"GraphDelegator","type":"codeVoice"},{"type":"text","text":" ("},{"code":"base","type":"codeVoice"},{"type":"text","text":" reads it), and"},{"type":"text","text":" "},{"type":"text","text":"storage and mutation costs are the list’s. Vertex indices are slots ("},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) and edge"},{"type":"text","text":" "},{"type":"text","text":"indices are positions. A removal moves the last slot or edge into the hole, so orders and"},{"type":"text","text":" "},{"type":"text","text":"positions change after a removal. Every read is the base’s, and so are attached maps"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"PropertyGraph","type":"codeVoice"},{"type":"text","text":", which follow those moves) and "},{"code":"generation","type":"codeVoice"},{"type":"text","text":". Equality compares vertex sets,"},{"type":"text","text":" "},{"type":"text","text":"edge sets and each vertex’s side, not orders, and ignores maps."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs"]]},"variants":[{"paths":["\/documentation\/bipartitegraphs\/bipartitegraph"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","interfaceLanguage":"swift"},"references":{"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/right":{"kind":"symbol","title":"right","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/right","role":"symbol","abstract":[{"type":"text","text":"The right vertices, in insertion order (a removal moves the side’s last vertex into the hole)."}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/right","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"right"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BipartiteGraph","preciseIdentifier":"s:15BipartiteGraphs0A5GraphV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"SideVertices","preciseIdentifier":"s:15BipartiteGraphs0A5GraphV12SideVerticesV"}],"type":"topic"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/Encodable-Implementations":{"kind":"article","type":"topic","abstract":[],"url":"\/documentation\/bipartitegraphs\/bipartitegraph\/encodable-implementations","title":"Encodable Implementations","role":"collectionGroup","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/Encodable-Implementations"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/Decodable-Implementations":{"kind":"article","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/decodable-implementations","title":"Decod