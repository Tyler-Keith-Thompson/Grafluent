t":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is simple and has no self-loop. An edge is inserted once, in either orientation, and"},{"type":"text","text":" "},{"type":"text","text":"is stored left endpoint first, so "},{"code":"edges[e].u","type":"codeVoice"},{"type":"text","text":" is its left end."}]},{"type":"paragraph","inlineContent":[{"text":"Every initializer from unchecked input is failable, and a mutation that would break the","type":"text"},{"text":" ","type":"text"},{"text":"bipartition throws ","type":"text"},{"code":"BipartitionError","type":"codeVoice"},{"text":" and changes nothing. Whether an edge may be inserted is an","type":"text"},{"text":" ","type":"text"},{"text":"O(1) test with ","type":"text"},{"code":"side(of:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"BipartiteGraph","type":"codeVoice"},{"text":" wraps an ","type":"text"},{"code":"UndirectedAdjacencyList","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"GraphDelegator","type":"codeVoice"},{"text":" (","type":"text"},{"code":"base","type":"codeVoice"},{"text":" reads it), and","type":"text"},{"text":" ","type":"text"},{"text":"storage and mutation costs are the list’s. Vertex indices are slots (","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) and edge","type":"text"},{"text":" ","type":"text"},{"text":"indices are positions. A removal moves the last slot or edge into the hole, so orders and","type":"text"},{"text":" ","type":"text"},{"text":"positions change after a removal. Every read is the base’s, and so are attached maps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":", which follow those moves) and ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":". Equality compares vertex sets,","type":"text"},{"text":" ","type":"text"},{"text":"edge sets and each vertex’s side, not orders, and ignores maps.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex.","type":"text"}],"identifier":{"url":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/bipartitegraphs\/bipartitegraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/Encodable-Implementations":{"role":"collectionGroup","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/encodable-implementations","abstract":[],"type":"topic","kind":"article","title":"Encodable Implementations","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/Encodable-Implementations"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/init(_:)":{"url":"\/documentation\/bipartitegraphs\/bipartitegraph\/init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">)"}],"type":"topic","title":"init(_:)","kind":"symbol","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/init(_:)","abstract":[{"type":"text","text":"The graph’s vertices (in order), edges (in position order, so at their positions when the"},{"type":"text","text":" "},{"type":"text","text":"graph has no parallel edges; repeats dropped), and the canonical sides of "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"nil when the graph is not bipartite: "},{"type":"codeVoice","code":"graph.findOddCycle()"},{"type":"tex