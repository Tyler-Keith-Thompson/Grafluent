 type: every initializer from unchecked input is failable, and a mutation"},{"type":"text","text":" "},{"type":"text","text":"that would break it throws "},{"type":"codeVoice","code":"BipartitionError"},{"type":"text","text":" and changes nothing (whether an edge may be"},{"type":"text","text":" "},{"type":"text","text":"inserted is an O(1) test with "},{"type":"codeVoice","code":"side(of:)"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Storage and mutation costs are "},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":"‘s, which it wraps as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":" ("},{"type":"codeVoice","code":"base"},{"type":"text","text":" reads it): vertex indices are slots ("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order), edge indices"},{"type":"text","text":" "},{"type":"text","text":"are positions, and a removal moves the last slot or edge into the hole, so orders and positions"},{"type":"text","text":" "},{"type":"text","text":"change after a removal. Every read is the base’s, at the base’s speed, and so are attached maps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":", which follow those moves) and "},{"type":"codeVoice","code":"generation"},{"type":"text","text":". Equality compares vertex sets,"},{"type":"text","text":" "},{"type":"text","text":"edge sets and each vertex’s side, not orders, and ignores maps."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/bipartitegraphs\/bipartitegraph"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"BipartiteGraph","modules":[{"name":"BipartiteGraphs"}],"navigatorTitle":[{"text":"BipartiteGraph","kind":"identif