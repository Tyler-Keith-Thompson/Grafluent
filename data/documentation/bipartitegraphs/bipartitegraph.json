{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is simple and has no self-loop. An edge is inserted once, in either orientation, and"},{"type":"text","text":" "},{"type":"text","text":"is stored left endpoint first, so "},{"code":"edges[e].u","type":"codeVoice"},{"type":"text","text":" is its left end."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every initializer from unchecked input is failable, and a mutation that would break the"},{"type":"text","text":" "},{"type":"text","text":"bipartition throws "},{"type":"codeVoice","code":"BipartitionError"},{"type":"text","text":" and changes nothing. Whether an edge may be inserted is an"},{"type":"text","text":" "},{"type":"text","text":"O(1) test with "},{"type":"codeVoice","code":"side(of:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BipartiteGraph"},{"type":"text","text":" wraps an "},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":" as a "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":" ("},{"type":"codeVoice","code":"base"},{"type":"text","text":" reads it), and"},{"type":"text","text":" "},{"type":"text","text":"storage and mutation costs are the list’s. Vertex indices are slots ("},{"type":