ents":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"projectedGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"onto","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BipartiteSide","preciseIdentifier":"s:15BipartiteGraphs0A4SideO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"UndirectedAdjacencyList","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"projectedGraph(onto:)","kind":"symbol","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/projectedgraph(onto:)","type":"topic","abstract":[{"text":"The graph on one side’s vertices (in ","type":"text"},{"type":"codeVoice","code":"left"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"right"},{"text":" order, isolated ones included), with an","type":"text"},{"text":" ","type":"text"},{"text":"edge between two vertices that share a neighbor, once however many they share (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"projected_graph"},{"text":"). Edges are inserted as found: for each vertex u in side order, each","type":"text"},{"text":" ","type":"text"},{"text":"neighbor w in u’s row, each x ≠ u in w’s row. O(Σ_{u ∈ side} Σ_{w ∈ N(u)} deg(w)).","type":"text"}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/projectedGraph(onto:)","role":"symbol"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/CustomReflectable-Implementations":{"url":"\/documentation\/bipartitegraphs\/bipartitegraph\/customreflectable-implementations","title":"CustomReflectable Implementations","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/CustomReflectable-Implementations","role":"collectionGroup","abstract":[],"kind":"article","type":"topic"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph/init(_:)":{"title":"init(_:)","url":"\/documentation\/bipartitegraphs\/bipartitegraph\/init(_:)","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph\/init(_:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The graph’s vertices (in order), edges (in position order, so at their positions when the"},{"type":"text","text":" "},{"type":"text","text":"graph has no parallel edges; repeats dropped), and the canonical sides of "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"nil when the graph is not bipartite: "},{"type":"codeVoice","code":"graph.findOddCycle()"},{"type":"text","text":" is then the witness. O(n + m)."}],"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}]},"doc://BipartiteGraphs/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/BipartiteGraphs\/s8SendableP","title":"Swift.Sendable"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"abstract":[{"type":"text","text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so"},{"type":"text","text":" "},{"type":"text","text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left"},{"type":"text","text":" "},{"type":"text","text":"endpoint first, so "},{"code":"edges[e].u","type":"codeVoice"},{"type":"text","text":" is its left end."}],"navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"title":"BipartiteGraph","url":"\/documentation\/bipartitegraphs\/