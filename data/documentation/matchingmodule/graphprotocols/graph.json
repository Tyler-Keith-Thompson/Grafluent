text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumBipartiteMatching(bipartition:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumBipartiteMatching(bipartition:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumBipartiteMatching"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"A maximum-cardinality matching of a bipartite graph by Hopcroft–Karp (NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"hopcroft_karp_matching","type":"codeVoice"},{"text":", the same matching), left vertices in ","type":"text"},{"code":"bipartition.left","type":"codeVoice"},{"text":" order.","type":"text"},{"text":" ","type":"text"},{"text":"O(m √n).","type":"text"}],"title":"maximumBipartiteMatching(bipartition:)","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumbipartitematching(bipartition:)"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumWeightMatching(weight:maximumCardinality:)-6l4u0":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maximumCardinality","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Matching","kind":"typeIdentifier","preciseIdentifier":"s:14MatchingModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","title":"maximumWeightMatching(weight:maximumCardinality:)","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightmatching(weight:maximumcardinality:)-6l4u0","role":"symbol","kind":"symbol","abstract":[{"text":"A maximum-weight matching (NetworkX ","type":"text"},{"code":"max_weight_matching","type":"codeVoice"},{"text":", the same matching): Galil’s","type":"text"},{"text":" ","type":"text"},{"text":"primal–dual blossom algorithm in Van Rantwijk’s formulation, with NetworkX’s iteration","type":"text"},{"text":" ","type":"text"},{"text":"orders. With ","type":"text"},{"code":"maximumCardinality","type":"codeVoice"},{"text":", the heaviest among the maximum-cardinality matchings;","type":"text"},{"text":" ","type":"text"},{"text":"without it, a negative edge is never taken and a zero-weight one may be. Parallel edges: the","type":"text"},{"text":" ","type":"text"},{"text":"heaviest copy (the earliest on ties). Self-loops are never weighed; ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once","type":"text"},{"text":" ","type":"text"},{"text":"per other edge, in position order. Exact. O(n³).","type":"text"}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumWeightMatching(weight:maximumCardinality:)-6l4u0"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightMatching(weight:)-1lg3b":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-1lg3b","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"type":"text","text":"The least weight among the maximum-cardinality matchings (NetworkX "},{"type":"codeVoice","code":"min_weight_matching"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumWeightMatching"},{"type":"text","text":" with "},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":" on (1 + the greatest weight) − w, reporting"},{"type":"text","text":" "},{"type":"text","text":"the original weights’ sum. Parallel edges: the lightest copy (the earliest on ties)."},{"type":"text","text":" "},{"type":"text","text":"Self-loops are never weighed and the vertex order is kept (NetworkX weighs loops for the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight and rebuilds the graph from its edges). O(n³)."}],"title":"minimumWeightMatching(weight:)","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightmatching(weight:)-1lg3b"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightFullMatching(bipartition:weight:)":{"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightfullmatching(bipartition:weight:)","title":"minimumWeightFullMatching(bipartition:weight:)","type":"topic","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightFullMatching(bipartition:weight:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A least-weight matching covering the smaller side of a bipartite graph, or nil when none"},{"type":"text","text":" "},{"type":"text","text":"exists (NetworkX "},{"type":"codeVoice","code":"minimum_weight_full_matching"},{"type":"text","text":"): scipy’s assignment on the biadjacency"},{"type":"text","text":" "},{"text":"matrix, rows ","type":"text"},{"code":"bipartition.left","type":"codeVoice"},{"text":", columns ","type":"text"},{"code":"bipartition.right","type":"codeVoice"},{"text":" in these orders (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"text":"columns follow set iteration, so its matching can differ among equal-weight ones), missing","type":"text"},{"text":" ","type":"text"},{"text":"edges forbidden, each pair’s lightest copy (NetworkX keeps the last copy on a multigraph). The matrix is never built: memory O(n + m). An empty","type":"text"},{"text":" ","type":"text"},{"text":"side gives the empty matching. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge, in position order.","type":"text"},{"text":" ","type":"text"},{"text":"O(s² t), s ≤ t the side sizes.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumWeightFullMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"bipartition","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","text":"Bipartition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumWeightMatching(weight:maximumCardinality:)-8dxpn":{"title":"maximumWeightMatching(weight:maximumCardinality:)","kind":"symbol","role":"symbol","abstract":[{"text":"A maximum-weight matching (NetworkX ","type":"text"},{"code":"max_weight_matching","type":"codeVoice"},{"text":", the same matching): as the","type":"text"},{"text":" ","type":"text"},{"text":"integer overload, following NetworkX’s floating-point path (","type":"text"},{"code":"\/ 2.0","type":"codeVoice"},{"text":") operation for","type":"text"},{"text":" ","type":"text"},{"text":"operation, so the same doubles give the same matching. O(n³).","type":"text"}],"type":"topic","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumWeightMatching(weight:maximumCardinality:)-8dxpn","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightmatching(weight:maximumcardinality:)-8dxpn","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maximumCardinality","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://MatchingModule/documentation/MatchingModule":{"type":"topic","title":"MatchingModule","url":"\/documentation\/matchingmodule","role":"collection","kind":"symbol","abstract