ching(_:)":{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isMaximalMatching(_:)","title":"isMaximalMatching(_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isMaximalMatching","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"kind":"symbol","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is a matching with no edge (other than a self-loop) between two free vertices"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"type":"codeVoice","code":"is_maximal_matching"},{"type":"text","text":"). O(n + m)."}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/ismaximalmatching(_:)","role":"symbol"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumWeightMatching(weight:maximumCardinality:)-6l4u0":{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumWeightMatching(weight:maximumCardinality:)-6l4u0","title":"maximumWeightMatching(weight:maximumCardinality:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","