pe":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"url":"\/documentation\/graphprotocols\/graph","role":"symbol","type":"topic"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightMatching(weight:)-4rzlr":{"title":"minimumWeightMatching(weight:)","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-4rzlr","type":"topic","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightmatching(weight:)-4rzlr","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The least weight among the maximum-cardinality matchings (NetworkX "},{"type":"codeVoice","code":"min_weight_matching"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"text","text":"as the integer overload, on NetworkX’s floating-point path. O(n³)."}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/isPerfectMatching(_:)":{"k