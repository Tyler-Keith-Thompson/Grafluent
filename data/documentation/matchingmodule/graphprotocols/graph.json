ismaximalmatching(_:)","title":"isMaximalMatching(_:)","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isMaximalMatching(_:)"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximalMatching()":{"kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximalMatching()","type":"topic","role":"symbol","title":"maximalMatching()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalMatching"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximalmatching()","abstract":[{"text":"A maximal matching (NetworkX ","type":"text"},{"type":"codeVoice","code":"maximal_matching"},{"text":"): each edge in position order joins when","type":"text"},{"text":" ","type":"text"},{"text":"neither end is matched yet; self-loops are skipped. Maximal, not necessarily maximum.","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumWeightMatching(weight:maximumCardinality:)-6l4u0":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maximumCardinality","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumWeightMatching(weight:maximumCardinality:)-6l4u0","title":"maximumWeightMatching(weight:maximumCardinality:)","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightmatching(weight:maximumcardinality:)-6l4u0","role":"symbol","abstract":[{"type":"text","text":"A maximum-weight matching (NetworkX "},{"code":"max_weight_matching","type":"codeVoice"},{"type":"text","text":", the same matching): Galil’s"},{"type":"text","text":" "},{"type":"text","text":"primal–dual blossom algorithm in Van Rantwijk’s formulation, with NetworkX’s iteration"},{"type":"text","text":" "},{"type":"text","text":"orders. With "},{"code":"maximumCardinality","type":"codeVoice"},{"type":"text","text":", the heaviest among the maximum-cardinality matchings;"},{"type":"text","text":" "},{"type":"text","text":"without it, a negative edge is never taken and a zero-weight one may be. Parallel edges: the"},{"type":"text","text":" "},{"type":"text","text":"heaviest copy (the earliest on ties). Self-loops are never weighed; "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once"},{"type":"text","text":" "},{"type":"text","text":"per other edge, in position order. Exact. O(n³)."}],"type":"topic"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumMatching()":{"kind":"symbol","type":"topic","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumMatching()","role":"symbol","title":"maximumMatching()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumMatching"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximummatching()","abstract":[{"text":"A maximum-cardinality matching by Edmonds’ blossom algorithm: for each still-free vertex in","type":"text"},{"text":" ","type":"text"},{"text":"vertex order, a breadth-first alternating search (rows in ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order) that","type":"text"},{"text":" ","type":"text"},{"text":"contracts blossoms and augments along the first free vertex found, skipping the vertices of","type":"text"},{"text":" ","type":"text"},{"text":"earlier failed searches. The matching returned is","type":"text"},{"text":" ","type":"text"},{"text":"this procedure’s, a documented function of the vertex order and rows. Parallel edges: the","type":"text"},{"text":" ","type":"text"},{"text":"copy met first. Vertices of a search that fails are skipped by later searches. O(n · m · log n).","type":"text"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols":{"url":"\/documentation\/matchingmodule\/graphprotocols","type":"topic","abstract":[],"role":"collection","title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightMatching(weight:)-4rzlr":{"kind":"symbol","identifier":"doc:\/\/MatchingMod