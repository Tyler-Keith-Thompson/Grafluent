,"text":"A maximum-weight matching (NetworkX "},{"type":"codeVoice","code":"max_weight_matching"},{"type":"text","text":", the same matching): as the"},{"type":"text","text":" "},{"type":"text","text":"integer overload, following NetworkX’s floating-point path ("},{"type":"codeVoice","code":"\/ 2.0"},{"type":"text","text":") operation for"},{"type":"text","text":" "},{"type":"text","text":"operation, so the same doubles give the same matching. O(n³)."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumWeightMatching(weight:maximumCardinality:)-8dxpn","type":"topic","title":"maximumWeightMatching(weight:maximumCardinality:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maximumCardinality"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightFullMatching(bipartition:weight:)":{"abstract":[{"type":"text","text":"A least-weight matching covering the smaller side of a bipartite graph, or nil when none"},{"type":"text","text":" "},{"type":"text","text":"exists (NetworkX "},{"type":"codeVoice","code":"minimum_weight_full_matching"},{"type":"text","text":"): scipy’s assignment on the biadjacency"},{"type":"text","text":" "},{"type":"text","text":"matrix, rows "},{"type":"codeVoice","code":"bipartition.left"},{"type":"text","text":", columns "},{"type":"codeVoice","code":"bipartition.right"},{"type":"text","text":" in these orders (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"columns follow set iteration, so its matching can differ among equal-weight ones), missing"},{"type":"text","text":" "},{"type":"text","text":"edges forbidden, each pair’s lightest copy (NetworkX keeps the last copy on a multigraph). The matrix is never built: memory O(n + m). An empty"},{"type":"text","text":" "},{"type":"text","text":"side gives the empty matching. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order."},{"type":"text","text":" "},{"type":"text","text":"O(s² t), s ≤ t the side sizes."}],"kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightFullMatching(bipartition:weight:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumWeightFullMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"bipartition","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bipartition","kind":"typeIdentifier","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kin