text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightmatching(weight:)-1lg3b","role":"symbol","title":"minimumWeightMatching(weight:)","kind":"symbol","abstract":[{"type":"text","text":"The least weight among the maximum-cardinality matchings (NetworkX "},{"code":"min_weight_matching","type":"codeVoice"},{"type":"text","text":"):"},{"type":"text","text":" "},{"code":"maximumWeightMatching","type":"codeVoice"},{"type":"text","text":" with "},{"code":"maximumCardinality","type":"codeVoice"},{"type":"text","text":" on (1 + the greatest weight) − w, reporting"},{"type":"text","text":" "},{"type":"text","text":"the original weights’ sum. Parallel edges: the lightest copy (the earliest on ties)."},{"type":"text","text":" "},{"type":"text","text":"Self-loops are never weighed and the vertex order is kept (NetworkX weighs loops for the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight and rebuilds the graph from its edges). O(n³)."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-1lg3b"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumWeightMatching(weight:maximumCardinality:)-6l4u0":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeI