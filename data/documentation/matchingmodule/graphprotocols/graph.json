fier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"minimumWeightMatching(weight:)","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-4rzlr","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightmatching(weight:)-4rzlr","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The least weight among the maximum-cardinality matchings (NetworkX "},{"type":"codeVoice","code":"min_weight_matching"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"text","text":"as the integer overload, on NetworkX’s floating-point path. O(n³)."}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumMatching()":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumMatching","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Matching","kind":"typeIdentifier","preciseIdentifier":"s:14MatchingModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"type":"topic","title":"maximumMatching()","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximummatching()","abstract":[{"type":"text","text":"A maximum-cardinality matching by Edmonds’ blossom algorithm: for each still-free vertex in"},{"type":"text","text":" "},{"type":"text","text":"vertex order, a breadth-first alternating search (rows in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order) that"},{"type":"text","text":" "},{"type":"text","text":"contracts blossoms and augments along the first free vertex found, skipping the vertices of"},{"type":"text","text":" "},{"type":"text","text":"earlier failed searches. The matching returned is"},{"type":"text","text":" "},{"type":"text","text":"this procedure’s, a documented function of the vertex order and rows. Parallel edges: the"},{"type":"text","text":" "},{"type":"text","text":"copy met first. Vertices of a search that fails are skipped by later searches. O(n · m · log n)."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumMatching()"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightMatching(weight:)-1lg3b":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumWeightMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","title":"minimumWeightMatching(weight:)","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightmatching(weight:)-1lg3b","abstract":[{"text":"The least weight among the maximum-cardinality matchings (NetworkX ","type":"text"},{"type":"codeVoice","code":"min_weight_matching"},{"text":"):","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maximumWeightMatching"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":" on (1 + the greatest weight) − w, reporting"},{"type":"text","text":" "},{"type":"text","text":"the original weights’ sum. Parallel edges: the lightest copy (the earliest on ties)."},{"type":"text","text":" "},{"type":"text","text":"Self-loops are never weighed and the vertex order is kept (NetworkX weighs loops for the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight and rebuilds the graph from its edges). O(n³)."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-1lg3b"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/isPerfectMatching(_:)":{"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/isperfectmatching(_:)","kind":"symbol","type":"topic","title":"isPerfectMatching(_:)","role":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isPerfectMatching(_:)","abstract":[{"text":"Whether ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is a matching that covers every vertex (NetworkX ","type":"text"},{"code":"is_perfect_matching","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isPerfectMatching"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightFullMatching(bipartition:weight:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumWeightFullMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"bipartition","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic","title":"minimumWeightFullMatching(bipartition:weight:)","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightfullmatching(bipartition:weight:)","abstract":[{"type":"text","text":"A least-weight matching covering the smaller side of a bipartite graph, or nil when none"},{"type":"text","text":" "},{"type":"text","text":"exists (NetworkX "},{"code":"minimum_weight_full_matching","type":"codeVoice"},{"type":"text","text":"): scipy’s assignment on the biadjacency"},{"type":"text","text":" "},{"type":"text","text":"matrix, rows "},{"code":"bipartition.left","type":"codeVoice"},{"type":"text","text":", columns "},{"code":"bipartition.right","type":"codeVoice"},{"type":"text","text":" in these orders (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"columns follow set iteration, so its matching can differ among equal-weight ones), missing"},{"type":"text","text":" "},{"type":"text","text":"edges forbidden, each pair’s lightest copy (NetworkX keeps the last copy on a multigraph). The matrix is never built: memory O(n + m). An empty"},{"type":"text","text":" "},{"type":"text","text":"side gives the empty matching. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per edge, in position order."},{"type":"text","text":" "},{"type":"text","text":"O(s² t), s ≤ t the side sizes."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightFullMatching(bipartition:weight:)"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/isMaximalMatching(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isMaximalMatching","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isMaximalMatching(_:)","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/ismaximalmatching(_:)","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isMaximalMatching(_:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is a matching with no edge (other than a self-loop) between two free vertices"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"type":"codeVoice","code":"is_maximal_matching"},{"type":"text","text":"). O(n + m)."}],"kind":"symbol"}}}