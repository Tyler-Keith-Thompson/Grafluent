rting"},{"type":"text","text":" "},{"type":"text","text":"the original weights’ sum. Parallel edges: the lightest copy (the earliest on ties)."},{"type":"text","text":" "},{"type":"text","text":"Self-loops are never weighed and the vertex order is kept (NetworkX weighs loops for the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight and rebuilds the graph from its edges). O(n³)."}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximalMatching()":{"abstract":[{"type":"text","text":"A maximal matching (NetworkX "},{"type":"codeVoice","code":"maximal_matching"},{"type":"text","text":"): each edge in position order joins when"},{"type":"text","text":" "},{"type":"text","text":"neither end is matched yet; self-loops are skipped. Maximal, not necessarily maximum."},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximalMatching()","type":"topic","role":"symbol","kind":"symbol","title":"maximalMatching()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalMatching","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximalmatching()"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/isPerfectMatching(_:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isPerfectMatching(_:)","title":"isPerfectMatching(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPerfectMatching","kind":"identifier"},{"text":"(","kind":"text"},