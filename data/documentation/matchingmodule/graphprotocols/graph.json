" "},{"kind":"identifier","text":"maximumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maximumCardinality"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumWeightMatching(weight:maximumCardinality:)-6l4u0","abstract":[{"type":"text","text":"A maximum-weight matching (NetworkX "},{"type":"codeVoice","code":"max_weight_matching"},{"type":"text","text":", the same matching): Galil’s"},{"type":"text","text":" "},{"type":"text","text":"primal–dual blossom algorithm in Van Rantwijk’s formulation, with NetworkX’s iteration"},{"type":"text","text":" "},{"type":"text","text":"orders. With "},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":", the heaviest among the maximum-cardinality matchings;"},{"type":"text","text":" "},{"type":"text","text":"without it, a negative edge is never taken and a zero-weight one may be. Parallel edges: the"},{"type":"text","text":" "},{"type":"text","text":"heaviest copy (the earliest on ties). Self-loops are never weighed; "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once"},{"type":"text","text":" "},{"type":"text","text":"per other edge, in position order. Exact. O(n³)."}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightmatching(weight:maximumcardinality:)-6l4u0","role":"symbol","type":"topic"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximalMatching()":{"role":"symbol","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximalmatching()","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximalMatching()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalMatching","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"A maximal matching (NetworkX "},{"type":"codeVoice","code":"maximal_matching"},{"type":"text","text":"): each edge in position order joins when"},{"type":"text","text":" "},{"type":"text","text":"neither end is matched yet; self-loops are skipped. Maximal, not necessarily maximum."},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"title":"maximalMatching()","kind":"symbol"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumMatching()":{"kind":"symbol","title":"maximumMatching()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumMatching"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumMatching()","abstract":[{"type":"text","text":"A maximum-cardinality matching by Edmonds’ blossom algorithm: for each still-free vertex in"},{"type":"text","text":" "},{"type":"text","text":"vertex order, a breadth-first alternating search (rows in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order) that"},{"type":"text","text":" "},{"type":"text","text":"contracts blossoms and augments along the first free vertex found, skipping the vertices of"},{"type":"text","text":" "},{"type":"text","text":"earlier failed searches. The matching returned is"},{"type":"text","text":" "},{"type":"text","text":"this procedure’s, a documented function of the vertex order and rows. Parallel edges: the"},{"type":"text","text":" "},{"type":"text","text":"copy met first. Vertices of a search that fails are skipped by later searches. O(n · m · log n)."}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximummatching()","role":"symbol","type":"topic"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightMatching(weight:)-1lg3b":{"title":"minimumWeightMatching(weight:)","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-1lg3b","type":"topic","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightmatching(weight:)-1lg3b","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","tex