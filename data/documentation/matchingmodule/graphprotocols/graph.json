ents along the first free vertex found, skipping the vertices of","type":"text"},{"text":" ","type":"text"},{"text":"earlier failed searches. The matching returned is","type":"text"},{"text":" ","type":"text"},{"text":"this procedure’s, a documented function of the vertex order and rows. Parallel edges: the","type":"text"},{"text":" ","type":"text"},{"text":"copy met first. Vertices of a search that fails are skipped by later searches. O(n · m · log n).","type":"text"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightMatching(weight:)-1lg3b":{"kind":"symbol","abstract":[{"type":"text","text":"The least weight among the maximum-cardinality matchings (NetworkX "},{"type":"codeVoice","code":"min_weight_matching"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumWeightMatching"},{"type":"text","text":" with "},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":" on (1 + the greatest weight) − w, reporting"},{"type":"text","text":" "},{"type":"text","text":"the original weights’ sum. Parallel edges: the lightest copy (the earliest on ties)."},{"type":"text","text":" "},{"type":"text","text":"Self-loops are never weighed and the vertex order is kept (NetworkX weighs loops for the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight and rebuilds the graph from its edges). O(n³)."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-1lg3b","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumWeightMatching","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5Edg