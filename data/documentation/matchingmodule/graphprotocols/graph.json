oc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/isMatching(_:)":{"title":"isMatching(_:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isMatching(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isMatching"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/ismatching(_:)","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" (positions) is a matching (NetworkX "},{"type":"codeVoice","code":"is_matching"},{"type":"text","text":"): no position twice, no"},{"type":"text","text":" "},{"type":"text","text":"self-loop, no two edges sharing an end. O(n + |edges|) with edge indices, O(n + m) without."}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumWeightMatching(weight:maximumCardinality:)-6l4u0":{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumWeightMatching(weight:maximumCardinality:)-6l4u0","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maximumCardinality"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"role":"symbol","abstract":[{"type":"text","text":"A maximum-weight matching (NetworkX "},{"type":"codeVoice","code":"max_weight_matching"},{"type":"text","text":", the same matching): Galil’s"},{"type":"text","text":" "},{"type":"text","text":"primal–dual blossom algorithm in Van Rantwijk’s formulation, with NetworkX’s iteration"},{"type":"text","text":" "},{"type":"text","text":"orders. With "},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":", the heaviest among the maximum-cardinality matchings;"},{"type":"text","text":" "},{"type":"text","text":"without it, a negative edge is never taken and a zero-weight one may be. Parallel edges: the"},{"type":"text","text":" "},{"type":"text","text":"heaviest copy (the earliest on ties). Self-loops are never weighed; "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once"},{"type":"text","text":" "},{"type":"text","text":"per other edge, in position order. Exact. O(n³)."}],"type":"topic","kind":"symbol","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightmatching(weight:maximumcardinality:)-6l4u0","title":"maximumWeightMatching(weight:maximumCardinality:)"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightFullMatching(bipartition:weight:)":{"kind":"symbol","title":"minimumWeightFullMatching(bipartition:weight:)","role":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightFullMatching(bipartition:weight:)","fra