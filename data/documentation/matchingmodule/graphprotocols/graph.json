ght:maximumCardinality:)","type":"topic"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/minimumWeightMatching(weight:)-1lg3b":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumWeightMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/minimumWeightMatching(weight:)-1lg3b","role":"symbol","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/minimumweightmatching(weight:)-1lg3b","type":"topic","kind":"symbol","title":"minimumWeightMatching(weight:)","abstract":[{"type":"text","text":"The least weight among the maximum-cardinality matchings (NetworkX "},{"type":"codeVoice","code":"min_weight_matching"},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumWeightMatching"},{"type":"text","text":" with "},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":" on (1 + the greatest weight) − w, reporting"},{"type":"text","text":" "},{"type":"text","text":"the original weights’ sum. Parallel edges: the lightest copy (the earliest on ties)."},{"type":"text","text":" "},{"type":"text","text":"Self-loops are never weighed and the vertex order is kept (NetworkX weighs loops for the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight and rebuilds the graph from its edges). O(n³)."}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumBipartiteMatching(bipartition:)":{"role":"symbol","abstract":[{"type":"text","text":"A maximum-cardinality matching of a bipartite graph by Hopcroft–Karp (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"hopcroft_karp_matching"},{"type":"text","text":", the same matching), left vertices in "},{"type":"codeVoice","code":"bipartition.left"},{"type":"text","text":" order."},{"text":" ","type":"text"},{"text":"O(m √n).","type":"text"}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumBipartiteMatching(bipartition:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumBipartiteMatching","kind":"identifier"},{"text":"(","kind":"text"},{"text":"bipartition","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bipartition","kind":"typeIdentifier","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Matching","kind":"typeIdentifier","preciseIdentifier":"s:14MatchingModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"kind":"symbol","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumbipartitematching(bipartition:)","title":"maximumBipartiteMatching(bipartition:)","type":"topic"},"doc://MatchingModule/documentation/MatchingModule":{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/matchingmodule","type":"topic","title":"MatchingModule"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumMatching()":{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumMatching()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumMatching"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"role":"symbol","abstract":[{"type":"text","text":"A maximum-cardinality matching by Edmonds’ blossom algorithm: for each still-free vertex in"},{"type":"text","text":" "},{"type":"text","text":"vertex order, a breadth-first alternating search (rows in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order) that"},{"type":"text","text":" "},{"text":"contracts blossoms and augments along the first free vertex found, skipping the vertices of","type":"text"},{"text":" ","type":"text"},{"text":"earlier failed searches. The matching returned is","type":"text"},{"text":" ","type":"text"},{"text":"this procedure’s, a documented function of the vertex order and rows. Parallel edges: the","type":"text"},{"text":" ","type":"text"},{"text":"copy met first. Vertices of a search that fails are skipped by later searches. O(n · m · log n).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximummatching()","title":"maximumMatching()"}}}