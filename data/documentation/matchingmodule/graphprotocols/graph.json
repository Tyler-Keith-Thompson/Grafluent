reciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">?"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A least-weight matching covering the smaller side of a bipartite graph, or nil when none"},{"type":"text","text":" "},{"type":"text","text":"exists (NetworkX "},{"type":"codeVoice","code":"minimum_weight_full_matching"},{"type":"text","text":"): scipy’s assignment on the biadjacency"},{"type":"text","text":" "},{"type":"text","text":"matrix, rows "},{"type":"codeVoice","code":"bipartition.left"},{"type":"text","text":", columns "},{"type":"codeVoice","code":"bipartition.right"},{"type":"text","text":" in these orders (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"columns follow set iteration, so its matching can differ among equal-weight ones), missing"},{"type":"text","text":" "},{"type":"text","text":"edges forbidden, each pair’s lightest copy (NetworkX keeps the last copy on a multigraph). The matrix is never built: memory O(n + m). An empty"},{"type":"text","text":" "},{"type":"text","text":"side gives the empty matching. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order."},{"type":"text","text":" "},{"type":"text","text":"O(s² t), s ≤ t the side sizes."}]}}}