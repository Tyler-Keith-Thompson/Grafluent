 "},{"code":"is_maximal_matching","type":"codeVoice"},{"type":"text","text":"). O(n + m)."}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isMaximalMatching(_:)","title":"isMaximalMatching(_:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isMaximalMatching","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/isPerfectMatching(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPerfectMatching","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"isPerfectMatching(_:)","abstract":[{"text":"Whether ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" is a matching that covers every vertex (NetworkX ","type":"text"},{"type":"codeVoice","code":"is_perfect_matching"},{"text":").","type":"text"}],"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/isperfectmatching(_:)","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/isPerfectMatching(_:)","kind":"symbol","type":"topic"}}}