"},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":", the heaviest among the maximum-cardinality matchings; without"},{"type":"text","text":" "},{"type":"text","text":"it, a negative edge is never taken and a zero-weight one may be. Among parallel edges, the"},{"type":"text","text":" "},{"type":"text","text":"heaviest copy is used (the earliest on ties). Self-loops are never weighed; "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"called once per other edge, in position order. Integer arithmetic is exact."}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n³)."}],"type":"paragraph"}]},{"style":"note","name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every |weight| ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":", and n · |weight| ≤ "},{"type":"codeVoice","code":"W.max \/ 8"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumCardinality"},{"type":"text","text":" (its duals go negative, by up to about n times the greatest weight);"},{"type":"text","text":" "},{"type":"text","text":"the total weight fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":". Beyond that, arithmetic may overflow, which traps."}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph"]]},"sections":[],"references":{"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumWeightMatching(weight:maximumCardinality:)-6l4u0":{"url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightmatching(weight:maximumcardinality:)-6l4u0","kind":"symbol","role":"symbol","title":"maximumWeightMatc