{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumMatching","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/Matching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"For each still-free vertex in vertex order, a breadth-first alternating search (rows in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order) contracts blossoms and augments along the first free vertex found."},{"type":"text","text":" "},{"type":"text","text":"Vertices of a search that fails are skipped by later searches. The result is determined by"},{"type":"text","text":" "},{"type":"text","text":"the vertex order and the rows; among parallel edges, the copy met first is used."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O(n · m · log n)."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Complexity"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumMatching()"},"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumma