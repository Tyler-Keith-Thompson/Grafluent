. Never contains a self-loop."}],"role":"symbol","url":"\/documentation\/matchingmodule\/matching"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph":{"type":"topic","abstract":[],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph","url":"\/documentation\/matchingmodule\/graphprotocols\/graph"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols":{"title":"GraphProtocols","type":"topic","kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols","abstract":[],"role":"collection","url":"\/documentation\/matchingmodule\/graphprotocols"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols/Graph/maximumMatching()":{"kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph\/maximumMatching()","role":"symbol","abstract":[{"text":"A maximum-cardinality matching by Edmonds’ blossom algorithm.","type":"text"}],"type":"topic","url":"\/documentation\/matchingmodule\/graphprotocols\/graph\/maximummatching()","title":"maximumMatching()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumMatching","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}]}}}