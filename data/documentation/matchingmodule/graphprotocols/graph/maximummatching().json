{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"A maximum-cardinality matching by Edmonds’ blossom algorithm."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matchingmodule\/graphprotocols\/graph\/maximummatching()"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumMatching"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"For each still-free vertex in vertex order, a breadth-first alternating search (rows in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order) contracts blossoms and augments along the first free vertex found."},{"type":"text","text":" "},{"type":"text","text":"Vertices of a search that fails are skipped by later searches. The result is determined by"},{"type":"text","text":" "},{"type":"text","text":"the vertex order and the rows; among parallel edges, the copy met first is used."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(n · m · log n).","type":"text"}]}],"name":"Complexity","style":"note","type":"aside"}],"kind":"content"}],"sections":[],"metadata":{"title":"maximumMatching()","remoteSource":{"fileName":"CardinalityMatching.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/CardinalityMatching.swift#L344"},"