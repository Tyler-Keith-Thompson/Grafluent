\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/BMatching","preciseIdentifier":"s:14MatchingModule9BMatchingV","text":"BMatching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SZ","text":"SignedInteger","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph’s two sides."}]}],"name":"bipartition"},{"content":[{"type":"paragraph","inlineContent":[{"text":"How many matched edges each vertex may have, at least zero.","type":"text"}]}],"name":"capacity"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each edge’s weight by position.","type":"text"}]}],"name":"weight"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A minimum-cost circulation (the network simplex): a source feeds each left vertex up to its"},{"type":"text","text":" "},{"type":"text","text":"capacity, each edge of positive weight carries one unit at the cost of minus its weight,"},{"type":"text","text":" "},{"type":"text","text":"each right vertex drains into a sink up to its capacity, and the sink returns to the"},{"type":"text","text":" "},{"type":"text","text":"source. Edges of weight zero or less are never taken. Parallel edges are distinct and may"},{"type":"text","text":" "},{"type":"text","text":"both be taken. Which optimum is returned when several exist is"},{"type":"text","text":" "},{"type":"text","text":"unspecified, but the same input always gives the same result. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once"},{"type":"text","text":" "},{"type":"text","text":"per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" once per edge in position order."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"That of the network simplex on n + 2 vertices and n + m + 1 arcs; polynomial","type":"text"},{"text":" ","type":"text"},{"text":"in practice, O(n² m) in the worst case of its pivots.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"bipartition"},{"type":"text","text":" is this graph’s; every capacity is at least zero and the"},{"type":"text","text":" "},{"type":"text","text":"capacities fit in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; |weight| fits the network simplex’s cost bound (4(n + 3)(the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":")."}]}],"name":"Precondition","type":"aside"}]}],"references":{"d