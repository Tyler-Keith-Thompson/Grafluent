","text":"both be taken. Which optimum is returned when several exist is"},{"type":"text","text":" "},{"type":"text","text":"unspecified, but the same input always gives the same result. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once"},{"type":"text","text":" "},{"type":"text","text":"per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" once per edge in position order."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"That of the network simplex on n + 2 vertices and n + m + 1 arcs; polynomial","type":"text"},{"text":" ","type":"text"},{"text":"in practice, O(n² m) in the worst case of its pivots.","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"bipartition"},{"type":"text","text":" is this graph’s; every capacity is at least zero and the"},{"type":"text","text":" "},{"type":"text","text":"capacities fit in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; |weight| fits the network simplex’s cost bound (4(n + 3)(the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":")."}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"MatchingModule"}],"externalID":"s:14GraphProtocols0A0P14MatchingModuleE22maximumWeightBMatching11bipartition8capacity6weightAD0G0Vyxqd__G15BipartiteGraphs11BipartitionVyxG_Si6VertexQzXEqd__5Edges_5IndexQZXEtSZRd__lF","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","remoteSource":{"fileName":"BMatching.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/BMatching.swift#L147"},"fragments":[{"text":"fu