:"text"},{"text":"per vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" once per edge in position order.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"That of the network simplex on n + 2 vertices and n + m + 1 arcs; polynomial"},{"type":"text","text":" "},{"type":"text","text":"in practice, O(n² m) in the worst case of its pivots."}],"type":"paragraph"}],"type":"aside","name":"Complexity","style":"note"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"bipartition","type":"codeVoice"},{"text":" is this graph’s; every capacity is at least zero and the","type":"text"},{"text":" ","type":"text"},{"text":"capacities fit in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"; |weight| fits the network simplex’s cost bound (4(n + 3)(the","type":"text"},{"text":" ","type":"text"},{"text":"greatest weight + 1) fits in ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Precondition","style":"note"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","abstract":[{"text":"The maximum-weight b-matching of a bipartite graph: the edges of greatest total weight,","type":"text"},{"text":" ","type":"text"},{"text":"each taken at most once, meeting each vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" at most ","type":"text"},{"code":"capacity(v)","type":"codeVoice"},{"text":" times.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightbmatching(bipartition:capacity:weight:)"]}],"references":{"d