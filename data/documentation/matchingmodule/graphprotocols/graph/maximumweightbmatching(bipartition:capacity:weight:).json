fier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MatchingModule9BMatchingV","text":"BMatching","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/BMatching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SZ","text":"SignedInteger"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"bipartition","content":[{"type":"paragraph","inlineContent":[{"text":"The graph’s two sides.","type":"text"}]}]},{"name":"capacity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many matched edges each vertex may have, at least zero."}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"text":"Each edge’s weight by position.","type":"text"}]}]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A minimum-cost circulation (the network simplex): a source feeds each left vertex up to its"},{"type":"text","text":" "},{"type":"text","text":"capacity, each edge of positive weight carries one unit at the cost of minus its weight,"},{"type":"text","text":" "},{"type":"text","text":"each right vertex drains into a sink up to its capacity, and the sink returns to the"},{"type":"text","text":" "},{"type":"text","text":"source. Edges of weight zero or less are never taken. Parallel edges are distinct and may"},{"type":"text","text":" "},{"type":"text","text":"both be taken. Which optimum is returned when several exist is"},{"type":"text","text":" "},{"type":"text","text":"unspecified, but the same input always gives the same result. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once"},{"type":"text","text":" "},{"type":"text","text":"per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" once per edge in position order."}]},{"name":"Complexity","content":[{"inlineContent":[{"text":"That of the network simplex on n + 2 vertices and n + m + 1 arcs; polynomial","type":"text"},{"text":" ","type":"text"},{"text":"in practice, O(n² m) in the worst case of its pivots.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"bipartition","type":"codeVoice"},{"type":"text","text":" is this graph’s; every capacity is at least zero and the"},{"type":"text","text":" "},{"type":"text","text":"capacities fit in "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"; |weight| fits the network simplex’s cost bound (4(n + 3)(the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight + 1) fits in "},{"code":"Int","type":"codeVoice"},{"type":"text","text":")."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"d