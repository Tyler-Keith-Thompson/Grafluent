:"s:14GraphProtocols0A0P14MatchingModuleE22maximumWeightBMatching11bipartition8capacity6weightAD0G0Vyxqd__G15BipartiteGraphs11BipartitionVyxG_Si6VertexQzXEqd__5Edges_5IndexQZXEtSZRd__lF","roleHeading":"Instance Method","role":"symbol","extendedModule":"GraphProtocols","symbolKind":"method","title":"maximumWeightBMatching(bipartition:capacity:weight:)","remoteSource":{"fileName":"BMatching.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/BMatching.swift#L147"},"modules":[{"relatedModules":["GraphProtocols"],"name":"MatchingModule"}]},"abstract":[{"type":"text","text":"The maximum-weight b-matching of a bipartite graph: the edges of greatest total weight,"},{"type":"text","text":" "},{"type":"text","text":"each taken at most once, meeting each vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" at most "},{"type":"codeVoice","code":"capacity(v)"},{"type":"text","text":" times."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matchingmodule\/graphprotocols\/graph\/maximumweightbmatching(bipartition:capacity:weight:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightBMatching"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","kind":"typeIdentifier","text":"Bipartition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"capacity"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/BMatching","preciseIdentifier":"s:14MatchingModule9BMatchingV","kind":"typeIdentifier","text":"BMatching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SZ","kind":"typeIdentifier","text":"SignedInteger"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"bipartition","content":[{"inlineContent":[{"text":"The graph’s two sides.","type":"text"}],"type":"paragraph"}]},{"name":"capacity","content":[{"inlineContent":[{"type":"text","text":"How many matched edges each vertex may have, at least zero."}],"type":"paragraph"}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each edge’s weight by position."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A minimum-cost circulation (the network simplex): a source feeds each left vertex up to its"},{"type":"text","text":" "},{"type":"text","text":"capacity, each edge of positive weight carries one unit at the cost of minus its weight,"},{"type":"text","text":" "},{"type":"text","text":"each right vertex drains into a sink up to its capacity, and the sink returns to the"},{"type":"text","text":" "},{"type":"text","text":"source. Edges of weight zero or less are never taken. Parallel edges are distinct and may"},{"type":"text","text":" "},{"type":"text","text":"both be taken. Which optimum is returned when several exist is"},{"type":"text","text":" "},{"type":"text","text":"unspecified, but the same input always gives the same result. "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":" is called once"},{"type":"text","text":" "},{"type":"text","text":"per vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" once per edge in position order."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"That of the network simplex on n + 2 vertices and n + m + 1 arcs; polynomial","type":"text"},{"text":" ","type":"text"},{"text":"in practice, O(n² m) in the worst case of its pivots.","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"bipartition"},{"type":"text","text":" is this graph’s; every capacity is at least zero and the"},{"type":"text","text":" "},{"type":"text","text":"capacities fit in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"; |weight| fits the network simplex’s cost bound (4(n + 3)(the"},{"type":"text","text":" "},{"type":"text","text":"greatest weight + 1) fits in "},{"type":"codeVoice","code":"Int"},{"type":"text","text":")."}]}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"d