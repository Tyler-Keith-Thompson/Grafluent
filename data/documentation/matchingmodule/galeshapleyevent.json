{"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GaleShapleyEvent","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Free proposers are taken from a stack, lowest index first at the start. A free proposer"},{"type":"text","text":" "},{"type":"text","text":"proposes to the next reviewer on its list. The reviewer rejects a proposer it does not list or"},{"type":"text","text":" "},{"type":"text","text":"ranks below the one it holds, accepts when it holds no one, and otherwise trades up, freeing"},{"type":"text","text":" "},{"type":"text","text":"the proposer it held, who goes on top of the stack. A rejected proposer proposes again; an"},{"type":"text","text":" "},{"type":"text","text":"accepted one waits. A proposer whose list runs out stays unmatched. The pairs held at the end"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"codeVoice","code":"stableMatching"},{"type":"text","text":"’s matching."}]}]}],"abstract":[{"type":"text","text":"What Gale and Shapley’s deferred acceptance reports, in order, as "},{"code":"stableMatching","type":"codeVoice"},{"type":"text","text":" runs it."}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/accept(proposer:reviewer:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/exhausted(proposer:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/propose(proposer:reviewer:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/reject(proposer:reviewer:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/tradeUp(reviewer:from:to:)"],"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"generated":true,"identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/CustomStringConvertible-Implementations","doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent"},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/MatchingModule\/s15BitwiseCopyableP","doc:\/\/MatchingModule\/s8CopyableP","doc:\/\/MatchingModule\/s23CustomStringConvertibleP","doc:\/\/MatchingModule\/SQ","doc:\/\/MatchingModule\/s9EscapableP","doc:\/\/MatchingModule\/SH","doc:\/\/MatchingModule\/s8SendableP","doc:\/\/MatchingModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/matchingmodule\/galeshapleyevent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"GaleShapleyEvent"}],"externalID":"s:14MatchingModule16GaleShapleyEventO","symbolKind":"enum","title":"GaleShapleyEvent","roleHeading":"Enumeration","role":"symbol","modules":[{"name":"MatchingModule"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GaleShapleyEvent"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/GaleShapleyEvents.swift#L10","fileName":"GaleShapleyEvents.swift"}},"kind":"symbol","references":{"doc://MatchingModule/documentation/MatchingModule/GaleShapleyEvent/Equatable-Implementations":{"abstract":[],"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GaleShapleyEvent\/Equ