{"abstract":[{"text":"What the Hopcroft–Karp algorithm reports, in order.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule"]]},"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/augmentingPath(_:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/phase(length:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/CustomStringConvertible-Implementations","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/Equatable-Implementations"]}],"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/MatchingModule\/s8CopyableP","doc:\/\/MatchingModule\/s23CustomStringConvertibleP","doc:\/\/MatchingModule\/SQ","doc:\/\/MatchingModule\/s9EscapableP","doc:\/\/MatchingModule\/SH","doc:\/\/MatchingModule\/s8SendableP","doc:\/\/MatchingModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"identifier":{"url":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HopcroftKarpEvent"}],"roleHeading":"Enumeration","title":"HopcroftKarpEvent","externalID":"s:14MatchingModule17HopcroftKarpEventO","navigatorTitle":[{"text":"HopcroftKarpEvent","kind":"identifier"}],"symbolKind":"enum","modules":[{"name":"MatchingModule"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/HopcroftKarpEvents.swift#L14","fileName":"HopcroftKarpEvents.swift"}},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HopcroftKarpEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each phase starts with a breadth-first search from the free left vertices, alternating"},{"type":"text","text":" "},{"type":"text","text":"unmatched and matched edges, that finds the length of the shortest augmenting paths; it is"},{"type":"text","text":" "},{"type":"text","text":"reported with that length. Then depth-first searches from each free left vertex, in left"},{"type":"text","text":" "},{"type":"text","text":"order, find a maximal set of vertex-disjoint shortest augmenting paths, each reported as it is"},{"type":"text","text":" "},{"type":"text","text":"found and applied: its edges, from the free left vertex to a free right vertex, alternate"},{"type":"text","text":" "},{"type":"text","text":"between unmatched ones, which join the matching, and matched ones, which leave it. The"},{"type":"text","text":" "},{"type":"text","text":"algorithm ends when a search finds no augmenting path."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/matchingmodule\/hopcroftkarpevent"]}],"references":{"doc://MatchingModule/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/MatchingModule\/s8CopyableP"},"doc://MatchingModule/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/MatchingModule\/s8SendableP","title":"S