ht vertex, alternate"},{"type":"text","text":" "},{"type":"text","text":"between unmatched ones, which join the matching, and matched ones, which leave it. The"},{"type":"text","text":" "},{"type":"text","text":"algorithm ends when a search finds no augmenting path."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent"},"sections":[],"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/augmentingPath(_:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/phase(length:)"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Default Implementations","identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/CustomStringConvertible-Implementations","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule"]]},"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HopcroftKarpEvent","kind":"identifier"}],"title":"HopcroftKarpEvent","externalID":"s:14MatchingModule17HopcroftKarpEventO","remoteSource":{"fileName":"HopcroftKarpEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/HopcroftKarpEvents.swift#L14"},"role":"symbol","navigatorTitle":[{"text":"HopcroftKarpEvent","kind":"identifier"}],"symbolKind":"enum","modules":[{"name":"MatchingModule"}],"roleHeading":"Enumeration"},"references":{"doc://MatchingModule/s16SendableMetatypeP":{"identifier":"doc:\/\/MatchingModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://MatchingModule/s23CustomStringConvertibleP":{"identifier":"doc:\/\/MatchingModule\/s23