{"abstract":[{"text":"What the Hopcroft–Karp algorithm reports, in order.","type":"text"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MatchingModule\/s8CopyableP","doc:\/\/MatchingModule\/s23CustomStringConvertibleP","doc:\/\/MatchingModule\/SQ","doc:\/\/MatchingModule\/s9EscapableP","doc:\/\/MatchingModule\/SH","doc:\/\/MatchingModule\/s8SendableP","doc:\/\/MatchingModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent"},"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/augmentingPath(_:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/phase(length:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/CustomStringConvertible-Implementations","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/Equatable-Implementations"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/matchingmodule\/hopcroftkarpevent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"text":"HopcroftKarpEvent","kind":"identifier"}],"title":"HopcroftKarpEvent","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HopcroftKarpEvent","kind":"identifier"}],"remoteSource":{"fileName":"HopcroftKarpEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/HopcroftKarpEvents.swift#L14"},"externalID":"s:14MatchingModule17HopcroftKarpEventO","symbolKind":"enum","roleHeading":"Enumeration","role":"symbol","modules":[{"name":"MatchingModule"}]},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HopcroftKarpEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each phase starts with a breadth-first search from the free left vertices, alternating"},{"type":"text","text":" "},{"type":"text","text":"unmatched and matched edges, that finds the length of the shortest augmenting paths; it is"},{"type":"text","text":" "},{"type":"text","text":"reported with that length. Then depth-first searches from each free left vertex, in left"},{"type":"text","text":" "},{"type":"text","text":"order, find a maximal set of vertex-disjoint shortest augmenting paths, each reported as it is"},{"type":"text","text":" "},{"type":"text","text":"found and applied: its edges, from the free left vertex to a free right vertex, alternate"},{"type":"text","text":" "},{"type":"text","text":"between unmatched ones, which join the matching, and matched ones, which leave it. The"},{"type":"text","text":" "},{"type":"text","text":"algorithm ends when a search finds no augmenting path."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MatchingModule/documentation/MatchingModule/HopcroftKarpEvent/phase(length:)":{"type":"topic","role":"symbol","title":"HopcroftKarpEvent.phase(length:)","url":"\/documentation\/matchingmodule\/hopcroftkarpevent\/phase(length:)","abstract":[{"text"