{"hierarchy":{"paths":[["doc:\/\/MatchingModule\/documentation\/MatchingModule"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"url":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HopcroftKarpEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Each phase starts with a breadth-first search from the free left vertices, alternating"},{"type":"text","text":" "},{"type":"text","text":"unmatched and matched edges, that finds the length of the shortest augmenting paths; it is"},{"type":"text","text":" "},{"type":"text","text":"reported with that length. Then depth-first searches from each free left vertex, in left"},{"type":"text","text":" "},{"type":"text","text":"order, find a maximal set of vertex-disjoint shortest augmenting paths, each reported as it is"},{"type":"text","text":" "},{"type":"text","text":"found and applied: its edges, from the free left vertex to a free right vertex, alternate"},{"type":"text","text":" "},{"type":"text","text":"between unmatched ones, which join the matching, and matched ones, which leave it. The"},{"type":"text","text":" "},{"type":"text","text":"algorithm ends when a search finds no augmenting path."}],"type":"paragraph"}]}],"metadata":{"navigatorTitle":[{"text":"HopcroftKarpEvent","kind":"identifier"}],"roleHeading":"Enumeration","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/MatchingModule\/HopcroftKarpEvents.swift#L14","fileName":"HopcroftKarpEvents.swift"},"role":"symbol","symbolKind":"enum","modules":[{"name":"MatchingModule"}],"externalID":"s:14MatchingModule17HopcroftKarpEventO","title":"HopcroftKarpEvent","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HopcroftKarpEvent","kind":"identifier"}]},"abstract":[{"type":"text","text":"What the Hopcroft–Karp algorithm reports, in order."}],"kind":"symbol","topicSections":[{"title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/augmentingPath(_:)","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/phase(length:)"],"anchor":"Enumeration-Cases"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/CustomStringConvertible-Implementations","doc:\/\/MatchingModule\/documentation\/MatchingModule\/HopcroftKarpEvent\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/MatchingModule\/s8CopyableP","doc:\/\/MatchingModule\/s23CustomStringConvertibleP","doc:\/\/MatchingModule\/SQ","doc:\/\/MatchingModule\/s9EscapableP","doc:\/\/MatchingModule\/SH","doc:\/\/MatchingModule\/s8SendableP","doc:\/\/MatchingModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/matchingmodule\/hopcroftkarpevent"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MatchingModule/SH":{"identifier":"doc:\/\/MatchingModule\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://MatchingModule/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/MatchingModule\/s9EscapableP","title":"Swift.Escapable"}