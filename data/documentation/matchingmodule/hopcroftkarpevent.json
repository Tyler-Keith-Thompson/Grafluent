xt","text":"What the Hopcroft–Karp algorithm reports, in order."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HopcroftKarpEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Each phase starts with a breadth-first search from the free left vertices, alternating"},{"type":"text","text":" "},{"type":"text","text":"unmatched and matched edges, that finds the length of the shortest augmenting paths; it is"},{"type":"text","text":" "},{"type":"text","text":"reported with that length. Then depth-first searches from each free left vertex, in left"},{"type":"text","text":" "},{"type":"text","text":"order, find a maximal set of vertex-disjoint shortest augmenting paths, each reported as it is"},{"type":"text","text":" "},{"type":"text","text":"found and applied: its edges, from the free left vertex to a free right vertex, alternate"},{"type":"text","text":" "},{"type":"text","text":"between unmatched ones, which join the matching, and matched ones, which leave it. The"},{"type":"text","text":" "},{"type":"text","text":"algorithm ends when a search finds no augmenting path."}],"type":"paragraph"}]}],"references":{"doc://MatchingModule/documentation/MatchingModule/HopcroftKarpEvent/phase(length:)":{"url":"\/documentation\/matchingmodule\/hopcroftkarpevent\/phase(length:)","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/MatchingModule\/document