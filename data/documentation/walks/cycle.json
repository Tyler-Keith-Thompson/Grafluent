{"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Walks\/documentation\/Walks"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Vertex i goes to vertex (i + 1) mod ","type":"text"},{"type":"codeVoice","code":"count"},{"text":" through edge i, and no vertex or edge position","type":"text"},{"text":" ","type":"text"},{"text":"appears twice. A self-loop is a cycle of length 1, and two parallel edges form a cycle of","type":"text"},{"text":" ","type":"text"},{"text":"length 2. Cycle detection returns a ","type":"text"},{"type":"codeVoice","code":"Cycle"},{"text":" as its witness.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two cycles are equal when one is a rotation of the other or of its ","type":"text"},{"type":"codeVoice","code":"reversed()"},{"text":", so the two","type":"text"},{"text":" ","type":"text"},{"text":"directions around an undirected cycle are one value. In a directed graph a cycle’s reversal is