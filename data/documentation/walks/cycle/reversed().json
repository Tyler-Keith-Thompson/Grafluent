","text":"joined to the next by the edge it was reached through. Over an undirected graph it is a"},{"type":"text","text":" "},{"type":"text","text":"cycle of the same graph; over a directed one, of the converse graph (every edge turned"},{"type":"text","text":" "},{"type":"text","text":"around), not of the graph itself."}],"sections":[],"references":{"doc://Walks/documentation/Walks/Cycle/reversed()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reversed","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","url":"\/documentation\/walks\/cycle\/reversed()","title":"reversed()","role":"symbol","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle\/reversed()","type":"topic","abstract":[{"type":"text","text":"The same cycle traversed the other way: its vertices in reverse order, exactly as"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalCollection.reversed()"},{"type":"text","text":" lists them (so generic code sees the same order), each"},{"type":"text","text":" "},{"type":"text","text":"joined to the next by the edge it was reached through. Over an undirected graph it is a"},{"type":"text","text":" "},{"type":"text","text":"cycle of the same graph; over a directed one, of the converse graph (every edge turned"},{"type":"text","text":" "},{"type":"text","text":"around), not of the graph itself."}]},"doc://Walks/documentation/Walks/Cycle":{"kind":"symbol","url":"\/documentation\/walks\/cycle","type":"topic","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","title":"Cycle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"abst