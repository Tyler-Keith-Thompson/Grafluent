{"abstract":[{"text":"A monotone min-priority queue of values with nonnegative integer keys, where no key inserted","type":"text"},{"text":" ","type":"text"},{"text":"is below the last key removed.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/PriorityQueueModule\/s8SendableP","doc:\/\/PriorityQueueModule\/s16SendableMetatypeP"]}],"sections":[],"variants":[{"paths":["\/documentation\/priorityqueuemodule\/radixheap"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixHeap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The radix heap of Ahuja, Mehlhorn, Orlin and Tarjan, in the form with one bucket per bit:","type":"text"},{"text":" ","type":"text"},{"text":"bucket ","type":"text"},{"code":"b","type":"codeVoice"},{"text":" holds the keys whose highest bit differing from the last key removed is bit","type":"text"},{"text":" ","type":"text"},{"code":"b - 1","type":"codeVoice"},{"text":", and bucket 0 the keys equal to it. ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":" is O(1). ","type":"text"},{"code":"popMin()","type":"codeVoice"},{"text":" is O(1) when bucket 0","type":"text"},{"text":" ","type":"text"},{"text":"holds a pair; otherwise it empties the lowest nonempty bucket into lower ones. A pair moves","type":"text"},{"text":" ","type":"text"},{"text":"only to lower buckets, so it moves at most ","type":"text"},{"code":"UInt.bitWidth","type":"codeVoice"},{"text":" times, and for keys spread over a","type":"text"},{"text":" ","type":"text"},{"text":"range of ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" at most log₂ C + 1 times: amortized O(log C) a pop.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use it where keys never go below the last one removed, as in Dijkstra’s algorithm with","type":"text"},{"text":" ","type":"text"},{"text":"integer weights. It has no decrease-key: insert the value again with the lower key and skip","type":"text"},{"text":" ","type":"text"},{"text":"the stale pair when it comes out. Values with equal keys leave in an unspecified order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The queue is not a "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":". Storage is an array of bucket arrays, copied on write."}],"type":"paragraph"}]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/init()"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/count","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/isEmpty","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/lastRemovedKey"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/insert(_:key:)","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/popMin()","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/removeMin()"]},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/Element"]}],"kind":"symbol","metadata":{"modules":[{"name":"PriorityQueueModule"}],"roleHeading":"Structure","rol