{"kind":"symbol","metadata":{"externalID":"s:19PriorityQueueModule9RadixHeapV","roleHeading":"Structure","role":"symbol","title":"RadixHeap","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/PriorityQueueModule\/RadixHeap.swift#L17","fileName":"RadixHeap.swift"},"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixHeap"}],"modules":[{"name":"PriorityQueueModule"}],"navigatorTitle":[{"kind":"identifier","text":"RadixHeap"}]},"sections":[],"identifier":{"url":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule"]]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/PriorityQueueModule\/s8SendableP","doc:\/\/PriorityQueueModule\/s16SendableMetatypeP"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A monotone min-priority queue of values with nonnegative integer keys, where no key inserted"},{"type":"text","text":" "},{"type":"text","text":"is below the last key removed."}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/init()"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/count","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/isEmpty","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/lastRemovedKey"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/insert(_:key:)","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/popMin()","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/removeMin()"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/Element"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixHeap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The radix heap of Ahuja, Mehlhorn, Orlin and Tarjan, in the form with one bucket per bit:"},{"type":"text","text":" "},{"type":"text","text":"bucket "},{"code":"b","type":"codeVoice"},{"type":"text","text":" holds the keys whose highest bit differing from the last key removed is bit"},{"type":"text","text":" "},{"code":"b - 1","type":"codeVoice"},{"type":"text","text":", and bucket 0 the keys equal to it. "},{"code":"insert","type":"codeVoice"},{"type":"text","text":" is O(1). "},{"code":"popMin()","type":"codeVoice"},{"type":"text","text":" is O(1) when bucket 0"},{"type":"text","text":" "},{"type":"text","text":"holds a pair; otherwise it empties the lowest nonempty bucket into lower ones. A pair moves"},{"type":"text","text":" "},{"type":"text","text":"only to lower buckets, so it moves at most "},{"code":"UInt.bitWidth","type":"codeVoice"},{"type":"text","text":" times, and for keys spread over a"},{"type":"text","text":" "},{"type":"text","text":"range of "},{"code":"C","type":"codeVoice"},{"type":"text","text":" at most log₂ C + 1 times: amortized O(log C) a pop."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use it where keys never go below the last one removed, as in Dijkstra’s algorithm with"},{"type":"text","text":" "},{"type":"text","text":"integer weights. It has no decrease-key: insert the value again with the lower key and skip"},{"type":"text","text":" "},{"type":"text","text":"the stale pair when it comes out. Values with equal keys leave in an unspecified order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The queue is not a "},{"code":"Sequence","type":"codeVoice"},{"type":"text","text":". Storage is an array of bucket arrays, copied on write."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/priorityqueuemodule\/radixheap"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap/count":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"count"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"abstract":[{"type":"text","text":"The number of queued pairs."}],"kind":"symbol","identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/count","role":"symbol","url":"\/documentation\/priorityqueuemodule\/radixheap\/count","title":"count","type":"topic"},"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap":{"identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap","navigatorTitle":[{"kind":"identifier","text":"RadixHeap"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A monotone min-priority queue of values with nonnegative integer keys, where no key inserted","type":"text"},{"text":" ","type":"text"},{"text":"is below the last key removed.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixHeap"}],"url":"\/documentation\/priorityqueuemodule\/radixheap","title":"RadixHeap","type":"topic"},"doc://PriorityQ