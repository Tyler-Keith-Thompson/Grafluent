east this."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lastRemovedKey","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UInt","preciseIdentifier":"s:Su","kind":"typeIdentifier"}]},"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap/popMin()":{"identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/popMin()","url":"\/documentation\/priorityqueuemodule\/radixheap\/popmin()","kind":"symbol","title":"popMin()","type":"topic","abstract":[{"text":"Removes and returns a pair with the lowest key, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the queue is empty. O(log C)","type":"text"},{"text":" ","type":"text"},{"text":"amortized, where C bounds the difference between any queued key and the last key removed.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"popMin"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"RadixHeap","preciseIdentifier":"s:19PriorityQueueModule9RadixHeapV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:19PriorityQueueModule9RadixHeapV7Elementa"},{"kind":"text","text":"?"}]},"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap/Element":{"kind":"symbol","url":"\/documentation\/priorityqueuemodule\/radixheap\/element","title":"RadixHeap.Element","role":"symbol","type":"topic","identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/Element","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"navigatorTitle":[{"kind":"identifier","text":"Element"}],"abstract":[]},"doc://PriorityQueueModule/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/PriorityQueueModule\/s8SendableP","title":"Swift.Sendabl