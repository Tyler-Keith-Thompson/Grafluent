nd":"text"},{"text":"UInt","preciseIdentifier":"s:Su","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/priorityqueuemodule\/radixheap\/insert(_:key:)","title":"insert(_:key:)","type":"topic"},"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap/popMin()":{"kind":"symbol","type":"topic","url":"\/documentation\/priorityqueuemodule\/radixheap\/popmin()","identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/popMin()","role":"symbol","title":"popMin()","abstract":[{"type":"text","text":"Removes and returns a pair with the lowest key, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the queue is empty. O(log C)"},{"type":"text","text":" "},{"type":"text","text":"amortized, where C bounds the difference between any queued key and the last key removed."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"popMin","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"RadixHeap","preciseIdentifier":"s:19PriorityQueueModule9RadixHeapV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Element","preciseIdentifier":"s:19PriorityQueueModule9RadixHeapV7Elementa","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap/lastRemovedKey":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastRemovedKey"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Su","kind":"typeIdentifier","text":"UInt"}],"abstract":[{"type":"text","text":"The key of the last pair removed, or 0 before the first removal. Every key inserted must be"},{"type":"text","text":" "},{"type":"text","text":"at least this."}],"identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/lastRemovedKey","kind":"symbol","role":"symbol","url":"\/documentation\/