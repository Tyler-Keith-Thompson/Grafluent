{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","externalID":"s:19PriorityQueueModule9RadixHeapV","modules":[{"name":"PriorityQueueModule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadixHeap"}],"title":"RadixHeap","navigatorTitle":[{"kind":"identifier","text":"RadixHeap"}],"remoteSource":{"fileName":"RadixHeap.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/PriorityQueueModule\/RadixHeap.swift#L17"}},"abstract":[{"text":"A monotone min-priority queue of values with nonnegative integer keys, where no key inserted","type":"text"},{"text":" ","type":"text"},{"text":"is below the last key removed.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap"},"topicSections":[{"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/init()"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/count","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/isEmpty","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/lastRemovedKey"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/insert(_:key:)","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/popMin()","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/removeMin()"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/Element"],"generated":true,"title":"Type Aliases","anchor":"Type-Aliases"}],"relationshipsSections":[{"identifiers":["doc:\/\/PriorityQueueModule\/s8SendableP","doc:\/\/PriorityQueueModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RadixHeap","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The radix heap of Ahuja, Mehlhorn, Orlin and Tarjan, in the form with one bucket per bit:"},{"type":"text","text":" "},{"type":"text","text":"bucket "},{"code":"b","type":"codeVoice"},{"type":"text","text":" holds the keys whose highest bit differing from the last key removed is bit"},{"type":"text","text":" "},{"code":"b - 1","type":"codeVoice"},{"type":"text","text":", and bucket 0 the keys equal to it. "},{"code":"insert","type":"codeVoice"},{"type":"text","text":" is O(1). "},{"code":"popMin()","type":"codeVoice"},{"type":"text","text":" is O(1) when bucket 0"},{"type":"text","text":" "},{"type":"text","text":"holds a pair; otherwise it empties the lowest nonempty bucket into lower ones. A pair moves"},{"type":"text","text":" "},{"type":"text","text":"only to lower buckets, so it moves at most "},{"code":"UInt.bitWidth","type":"codeVoice"},{"type":"text","text":" times, and for keys spread over a"},{"type":"text","text":" "},{"type":"text","text":"range of "},{"code":"C","type":"codeVoice"},{"type":"text","text":" at most log₂ C + 1 times: amortized O(log C) a pop."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it where keys never go below the last one removed, as in Dijkstra’s algorithm with"},{"type":"text","text":" "},{"type":"text","text":"integer weights. It has no decrease-key: insert the value again with the lower key and skip"},{"type":"text","text":" "},{"type":"text","text":"the stale pair when it comes out. Values with equal keys leave in an unspecified order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The queue is not a "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":". Storage is an array of bucket arrays, copied on write."}]}],"kind":"content"}],"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/priorityqueuemodule\/radixheap"]}],"references":{"doc://PriorityQueueModule/documentation/PriorityQueueModule":{"abstract":[],"type":"topic","identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule","role":"collection","title":"PriorityQueueModule","kind":"symbol","url":"\/documentation\/priorityqueuemodule"},"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap/lastRemovedKey":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastRemovedKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt","preciseIdentifier":"s:Su"}],"type":"topic","url":"\/documentation\/priorityqueuemodule\/radixheap\/lastremovedkey","title":"lastRemovedKey","abstract":[{"type":"text","text":"The key of the last pair removed, or 0 before the first removal. Every key inserted must be"},{"type":"text","text":" "},{"type":"text","text":"at least this."}],"identifier":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/RadixHeap\/lastRemovedKey"},"doc://PriorityQueueModule/documentation/PriorityQueueModule/RadixHeap/insert(_:key:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"t