pe":"text","text":" "},{"type":"codeVoice","code":"QuadHeap"},{"type":"text","text":", Sedgewick’s "},{"type":"codeVoice","code":"IndexMinPQ"},{"type":"text","text":"). "},{"type":"codeVoice","code":"insert"},{"type":"text","text":", "},{"type":"codeVoice","code":"popMin()"},{"type":"text","text":", "},{"type":"codeVoice","code":"decreasePriority(of:to:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"updatePriority(of:to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"remove(_:)"},{"type":"text","text":" are O(log count); "},{"type":"codeVoice","code":"min"},{"type":"text","text":", "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"priority(of:)"},{"type":"text","text":" are O(1)."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IndexedPriorityQueue"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Priority"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Priority"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Indices with equal priorities leave in an unspecified order. ","type":"text"},{"code":"min","type":"codeVoice"},{"text":" changes only when a","type":"text"},{"text":" ","type":"text"},{"text":"strictly smaller priority arrives, or when the minimum leaves or its priority increases. To","type":"text"},{"text":" ","type":"text"},{"text":"break ties a particular way, put the rule in ","type":"text"},{"code":"Priority","type":"codeVoice"},{"text":", for example ","type":"text"},{"code":"(distance, index)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Priorities must not be NaN. Not a "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":", as swift-collections’ "},{"type":"codeVoice","code":"Heap"},{"type":"text","text":" is not:"},{"type":"text","text":" "},{"type":"codeVoice","code":"unordered"},{"type":"text","text":" lists the contents. Storage is two arrays, copied on write."}]},{"type":"paragraph","inlineContent":[{"text":"Use it when items are dense indices whose priorities must be lowered in place (Dijkstra, Prim,","type":"text"},{"text":" ","type":"text"},{"text":"A*). ","type":"text"},{"code":"Heap","type":"codeVoice"},{"text":" has no way to find or change a queued element, so it can only stand in by pushing","type":"text"},{"text":" ","type":"text"},{"text":"duplicates and skipping stale ones: in Dijkstra that costs 1.1–1.4× (the gap narrows as graphs","type":"text"},{"text":" ","type":"text"},{"text":"grow, and with few distinct weights), and about 2.6× when every item is decreased once. For pushes and pops alone, ","type":"text"},{"code":"Heap","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"better structure: it stores bare elements, and sorts 10⁶ ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s in about 0.7× the time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An index that has left the queue is indistinguishable from one never queued. Dijkstra needs"},{"type":"text","text":" "},{"type":"text","text":"nothing more, since a settled vertex is never relaxed again; Prim must keep its own set of tree"},{"type":"text","text":" "},{"type":"text","text":"vertices, or "},{"code":"insertOrDecreasePriority(of:to:)","type":"codeVoice"},{"type":"text","text":" would queue them again."}]}],"kind":"content"}],"relationshipsSec