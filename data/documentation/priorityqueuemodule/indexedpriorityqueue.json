{"hierarchy":{"paths":[["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"A min-priority queue of the indices ","type":"text"},{"code":"0..<indexBound","type":"codeVoice"},{"text":", each queued at most once with a","type":"text"},{"text":" ","type":"text"},{"text":"priority: a 4-ary heap with a position array (Boost’s ","type":"text"},{"code":"d_ary_heap_indirect","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"QuadHeap","type":"codeVoice"},{"text":", Sedgewick’s ","type":"text"},{"code":"IndexMinPQ","type":"codeVoice"},{"text":"). ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":", ","type":"text"},{"code":"popMin()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"decreasePriority(of:to:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"updatePriority(of:to:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"remove(_:)","type":"codeVoice"},{"text":" are O(log count); ","type":"text"},{"code":"min","type":"codeVoice"},{"text":", ","type":"text"},{"code":"contains(_:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"priority(of:)","type":"codeVoice"},{"text":" are O(1).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IndexedPriorityQueue","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Priority","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Priority","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Indices with equal priorities leave in an unspecified order. ","type":"text"},{"type":"codeVoice","code":"min"},{"text":" changes only when a","type":"text"},{"text":" ","type":"text"},{"text":"strictly smaller priority arrives, or when the minimum leaves or its priority increases. To","type":"text"},{"text":" ","type":"text"},{"text":"break ties a particular way, put the rule in ","type":"text"},{"type":"codeVoice","code":"Priority"},{"text":", for example ","type":"text"},{"type":"codeVoice","code":"(distance, index)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Priorities must not be NaN. Not a "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":", as swift-collections’ "},{"type":"codeVoice","code":"Heap"},{"type":"text","text":" is not:"},{"type":"text","text":" "},{"type":"codeVoice","code":"unordered"},{"type":"text","text":" lists the contents. Storage is two arrays, copied on write."}],"type":"paragraph"},{"inlineContent":[{"text":"Use it when items are dense indices whose priorities must be lowered in place (Dijkstra, Prim,","type":"text"},{"text":" ","type":"text"},{"text":"A*). ","type":"text"},{"code":"Heap","type":"codeVoice"},{"text":" has no way to find or change a queued element, so it can only stand in by pushing","type":"text"},{"text":" ","type":"text"},{"text":"duplicates and skipping stale ones: in Dijkstra that costs 1.1–1.4× (the gap narrows as graphs","type":"text"},{"text":" ","type":"text"},{"text":"grow, and with few distinct weights), and about 2.6× when every item is decreased once. For pushes and pops alone, ","type":"text"},{"code":"Heap","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"better structure: it stores bare elements, and sorts 10⁶ ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s in about 0.7× the time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An index that has left the queue is indistinguishable from one never queued. Dijkstra needs"},{"type":"text","text":" "},{"type":"text","text":"nothing more, since a settled vertex is never relaxed again; Prim must keep its own set of tree"},{"type":"text","text":" "},{"type":"text","text":"vertices, or "},{"type":"codeVoice","code":"insertOrDecreasePriority(of:to:)"},{"type":"text","text":" would queue them again."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue","interfaceLanguage":"swift"},"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/PriorityQueueModule\/s8CopyableP","doc:\/\/PriorityQueueModule\/s28CustomDebugStringConvertibleP","doc:\/\/PriorityQueueModule\/s23CustomStringConvertibleP","doc:\/\/PriorityQueueModule\/s8SendableP","doc:\/\/PriorityQueueModule\/s16SendableMetatypeP"]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue\/init(indexBound:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue\/count","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue\/indexBound","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue\/isEmpty","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue\/min","doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue\/unordered"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue\/contains(_:)","doc:\/\/Priority