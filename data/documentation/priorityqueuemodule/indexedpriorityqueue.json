{"identifier":{"url":"doc:\/\/PriorityQueueModule\/documentation\/PriorityQueueModule\/IndexedPriorityQueue","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IndexedPriorityQueue","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Priority","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Priority","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The queue is a 4-ary heap with a position array. ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":", ","type":"text"},{"code":"popMin()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"decreasePriority(of:to:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"updatePriority(of:to:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"remove(_:)","type":"codeVoice"},{"text":" are O(log count). ","type":"text"},{"code":"min","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"contains(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"priority(of:)","type":"codeVoice"},{"text":" are O(1).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use it when items are dense indices whose priorities must be changed in place, as in Dijkstra’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithm, Prim’s algorithm and A*. For pushes and pops without priority changes, ","type":"text"},{"code":"Heap","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"text":"swift-collections stores bare elements and is the better fit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Indices with equal priorities leave in an unspecified order. "},{"type":"codeVoice","code":"min"},{"type":"text","text":" changes only when a"},{"type":"text","text":" "},{"type":"text","text":"strictly smaller priority arrives, or when the minimum leaves or its priority increases. To"},{"type":"text","text":" "},{"type":"text","text":"break ties a particular way, put the rule in "},{"type":"codeVoice","code":"Priority"},{"type":"text","text":", for example "},{"type":"codeVoice","code":"(distance, index)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Priorities must not be NaN. The queue is not a "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":"; "},{"type":"codeVoice","code":"unordered"},{"type":"text","text":" lists the contents."},{"type":"text","text":" "},{"type":"text","text":"Storage is two arrays, copied on write."}],"type":"paragraph"},{"inlineContent":[{"text":"An index that has left the queue is indistinguishable from one never queued. Dijkstra’s","type":"text"},{"text":" ","type":"text"},{"text":"algorithm needs nothing more, since a settled vertex is never relaxed again. Prim’s algorithm","type":"text"},{"text":" ","type":"text"},{"text":"must keep its own set of tree vertices, or ","type":"text"},{"type":"codeVoice","code":"insertOrDecreasePriority(of:to:)"},{"text":" would queue them","type":"text"},{"text":" ","type":"text"},{"text":"again.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A min-priority queue of the indices "},{"code":"0..<indexBound","type":"codeVoice"},{"type":"text","text":", each queued at most once with a"},{"type":"text","text":" "},{"type":"text","text":"priority."}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/PriorityQueueModule\