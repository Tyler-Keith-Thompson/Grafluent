,"languages":["swift"]}],"kind":"declarations"}],"references":{"doc://Trees/documentation/Trees/OrderedTree":{"title":"OrderedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","kind":"symbol","url":"\/documentation\/trees\/orderedtree"},"doc://Trees/documentation/Trees/BinaryTree":{"title":"BinaryTree","url":"\/documentation\/trees\/binarytree","role":"symbol","abstract":[{"type":"text","text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,"},{"type":"text","text":" "},{"type":"text","text":"by position. A vertex with only a left child is a different tree from one with only a right"},{"type":"text","text":" "},{"type":"text","text":"child. Two binary trees are equal when they have the same root and every vertex has the same"},{"type":"text","text":" "},{"text":"left and right children.","type":"text"}],"navigatorTitle":[{"text":"BinaryTree","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryTree","kind":"identifier"}]},"doc://Trees/documentation/Trees":{"title":"Trees","kind":"symbol","type":"topic","url":"\/documentation\/tre