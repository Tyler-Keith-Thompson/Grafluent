tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"role":"symbol"},"doc://Trees/documentation/Trees/BinaryTree":{"type":"topic","url":"\/documentation\/trees\/binarytree","navigatorTitle":[{"text":"BinaryTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,"},{"type":"text","text":" "},{"type":"text","text":"by position. A vertex with only a left child is a different tree from one with only a right"},{"type":"text","text":" "},{"type":"text","text":"child. Two binary trees are equal when they have the same root and every vertex has the same"},{"type":"text","text":" "},{"type":"text","text":"left and right children."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","title":"BinaryTree","kind":"symbol","role":"symbol"}}}