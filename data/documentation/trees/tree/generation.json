},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"role":"symbol","url":"\/documentation\/trees\/tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","title":"Tree"}}}