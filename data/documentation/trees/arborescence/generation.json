cture derived"},{"type":"text","text":" "},{"type":"text","text":"from it is current for it and its copies, and for no other graph, a conversion of it"},{"type":"text","text":" "},{"type":"text","text":"included."}],"title":"generation","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"generation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14GraphProtocols0A10GenerationV","kind":"typeIdentifier","text":"GraphGeneration"}]},"doc://Trees/documentation/Trees":{"kind":"symbol","type":"topic","url":"\/documentation\/trees","abstract":[],"title":"Trees","role":"collection","identifier":"doc:\/\/Trees\/documentation\/Trees"},"doc://Trees/documentation/Trees/Arborescence":{"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/arborescence","title":"Arborescence","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"}}}