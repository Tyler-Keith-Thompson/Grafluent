 are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence","type":"topic","role":"symbol","url":"\/documentation\/trees\/arborescence","kind":"symbol"},"doc://Trees/documentation/Trees":{"abstract":[],"identifier":"doc:\/\/Trees\/documentation\/Trees","title":"Trees","type":"topic","role":"collection","url":"\/documentation\/trees","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration":{"navigatorTitle":[{"kind":"identifier","text":"GraphGeneration"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphGeneration"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration","abstract":[{"type":"text","text":"A graph’s generation: which state of which graph it is. Every structural mutation (an"},{"type":"text","text":" "},{"type":"text","text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and"},{"type":"text","text":" "},{"type":"text","text":"writing attached map values do not. A structure derived from a graph stores the graph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"generation"},{"type":"text","text":" and asks "},{"type":"codeVoice","code":"isCurrent(for:)"},{"type":"text","text":" before it relies on the graph again."}],"role":"symbol","type":"topic","title":"GraphGeneration","url":"\/documentation\/graphprotocols\/graphgeneration","kind":"symbol"}}}