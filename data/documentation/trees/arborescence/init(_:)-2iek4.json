m parent to child, with","type":"text"},{"text":" ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" in its order. O(1). A new graph, with its own generation and no maps.","type":"text"}],"kind":"symbol","references":{"doc://Trees/documentation/Trees/Arborescence/init(_:)-2iek4":{"abstract":[{"text":"The arborescence an ordered tree is, every edge from parent to child, with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" in its order. O(1). A new graph, with its own generation and no maps.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/trees\/arborescence\/init(_:)-2iek4","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:5Trees11OrderedTreeV","text":"OrderedTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"title":"init(_:)","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence\/init(_:)-2iek4","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]}},"doc://Trees/documentation/Trees":{"role":"collection","abstract":[],"url":"\/documentation\/trees","type":"topic","title":"Trees","identifier":"doc:\/\/Trees\/documentation\/Trees","kind":"symbol"},"doc://Trees/documentation/Trees/Arborescence":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"title":"Arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"An arborescence: