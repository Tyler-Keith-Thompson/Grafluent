c:\/\/Trees\/documentation\/Trees\/Arborescence","type":"topic","title":"Arborescence","role":"symbol","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/arborescence","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}]},"doc://Trees/documentation/Trees/Arborescence/InEdges":{"abstract":[{"type":"text","text":"One "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" or none: the edge from the parent, or (as "},{"type":"codeVoice","code":"PredecessorIndices"},{"type":"text","text":") the parent’s"},{"type":"text","text":" "},{"type":"text","text":"index; empty at the root."}],"title":"Arborescence.InEdges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InEdges"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"url":"\/documentation\/trees\/arb