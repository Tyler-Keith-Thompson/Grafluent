,"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent. As a ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Trees/documentation/Trees/Arborescence/InEdges":{"title":"Arborescence.InEdges","kind":"symbol","url":"\/documentation\/trees\/arborescence\/inedges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InEdges","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence\/InEdges","navigatorTitle":[{"text":"InEdges","kind":"identifier"}],"type":"topic","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"role":"symbol","abstract":[{"type":"text","text":"One "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" or none: the edge from the parent, or (as "},{"code":"PredecessorIndices","type":"codeVoice"},{"type":"text","text":") the parent’s"},{"type":"text","text":" "},{"text":"index; empty at the root.","type":"text"}]}}}