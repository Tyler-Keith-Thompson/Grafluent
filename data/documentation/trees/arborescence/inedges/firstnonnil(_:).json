,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","role":"symbol"},"doc://Trees/documentation/Trees/Arborescence/InEdges":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InEdges"}],"navigatorTitle":[{"kind":"identifier","text":"InEdges"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence\/InEdges","kind":"symbol","title":"Arborescence.InEdges","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"url":"\/documentation\/trees\/arborescence\/inedges","abstract":[{"type":"text","text":"One "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" or none: the edge from the parent, or (as "},{"type":"codeVoice","code":"PredecessorIndices"},{"type":"text","text":") the parent’s"},{"type":"text","text":" "},{"type":"text","text":"index; empty at the root."}],"type":"topic","role":"symbol"}}}