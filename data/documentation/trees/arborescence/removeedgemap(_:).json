pe":"codeVoice"},{"type":"text","text":" attached to a graph (LEMON’s "},{"code":"ArcMap","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"returned by "},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"type":"text","text":". It is valid on the graph that added it"},{"type":"text","text":" "},{"type":"text","text":"and on every copy of that graph, until "},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"type":"text","text":"; on another graph it traps."}]}}}