/documentation\/trees\/arborescence\/rootindex","type":"topic","title":"rootIndex"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","role":"symbol","title":"Arborescence"}}}