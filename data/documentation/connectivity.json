ion\/connectivity\/blockcuttree","navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"type":"codeVoice","code":"blocks"},{"type":"text","text":", articulation points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"text":"self-loop; isolated vertices are no node.","type":"text"}],"title":"BlockCutTree","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree"},"doc://Connectivity/documentation/Connectivity/BiconnectedComponents":{"type":"topic","abstract":[{"text":"The biconnected components (blocks) of an undirected graph: a collection of blocks, each the","type":"text"},{"text":" ","type":"text"},{"text":"positions of its edges in ascending order; blocks are ordered by their smallest edge position.","type":"text"},{"text":" ","type":"text"},{"text":"The blocks partition the edges that are not self-loops.","type":"text"}],"url":"\/documentation\/connectivity\/biconnectedcomponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BiconnectedComponents","title":"BiconnectedComponents","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BiconnectedComponents"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BiconnectedComponents"}]},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/KComponents":{"url":"\/documentation\/connectivity\/kcomponents","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","title":"KComponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},"doc://Connectivity/documentation/Connectivity/DominatorTree":{"title":"DominatorTree","type":"topic","url":"\/documentation\/connectivity\/dominatortree","navigatorTitle":[{"text":"DominatorTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DominatorTree","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/DominatorTree","role":"symbol","abstract":[{"type":"text","text":"The dominator tree of the vertices reachable from a root: "},{"type":"codeVoice","code":"a"},{"type":"text","text":" dominates "},{"type":"codeVoice","code":"b"},{"type":"text","text":" when every path"},{"type":"text","text":" "},{"type":"text","text":"from the root to "},{"type":"codeVoice","code":"b"},{"type":"text","text":" passes through "},{"type":"codeVoice","code":"a"},{"type":"text","text":". Each reachable vertex but the root has an immediate"},{"type":"text","text":" "},{"type":"text","text":"dominator, its closest strict dominator, which is its parent in the tree."}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","title":"GraphProtocols","kind":"symbol","abstract":[],"url":"\/documentation\/connectivity\/graphprotocols","type":"topic"}}}