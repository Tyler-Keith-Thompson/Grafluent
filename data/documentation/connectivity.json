nectedComponents":{"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BiconnectedComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BiconnectedComponents","kind":"identifier"}],"navigatorTitle":[{"text":"BiconnectedComponents","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/connectivity\/biconnectedcomponents","abstract":[{"type":"text","text":"The biconnected components (blocks) of an undirected graph: a collection of blocks, each the"},{"type":"text","text":" "},{"type":"text","text":"positions of its edges in ascending order; blocks are ordered by their smallest edge position."},{"type":"text","text":" "},{"type":"text","text":"The blocks partition the edges that are not self-loops."}],"title":"BiconnectedComponents"},"doc://Connectivity/documentation/Connectivity/Condensation":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Condensation"}],"type":"topic","url":"\/documentation\/connectivity\/condensation","title":"Condensation","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Condensation","abstract":[{"type":"text","text":"A graph’s strongly connected components and the acyclic graph between them."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Condensation"}]},"doc://Connectivity/documentation/Connectivity/DominanceFrontiers":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DominanceFrontiers"}],"type":"topic","url":"\/documentation\/connectivity\/dominancefrontiers","title":"DominanceFrontiers","abstract":[{"type":"text","text":"The dominance frontier of each vertex reachable from a root: the vertices "},{"code":"y","type":"codeVoice"},{"type":"text","text":" such that the"},{"type":"text","text":" "},{"type":"text","text":"vertex dominates a predecessor of "},{"code":"y","type":"codeVoice"},{"text":" but does not strictly dominate ","type":"text"},{"type":"codeVoice","code":"y"},{"text":" (Cytron et al.), where","type":"text"},{"text":" ","type":"text"},{"text":"SSA construction places φ-functions.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/DominanceFrontiers","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DominanceFrontiers"}]},"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"type":"topic","url":"\/documentation\/connectivity\/kcomponents","title":"KComponents","abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}]},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"title":"BlockCutTree","url":"\/documentation\/connectivity\/blockcuttree","abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"code":"blocks","type":"codeVoice"},{"type":"text","text":", articulation points by their place in "},{"code":"articulationPoints","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlockCutTree"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"kind":"symbol","type":"topic"}}}