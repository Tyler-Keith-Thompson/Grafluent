r","text":"Condensation"}],"title":"Condensation"},"doc://Connectivity/documentation/Connectivity/KComponents":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"type":"topic","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","url":"\/documentation\/connectivity\/kcomponents","title":"KComponents","role":"symbol"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","url":"\/documentation\/connectivity","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/DominanceFrontiers":{"title":"DominanceFrontiers","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DominanceFrontiers"}],"url":"\/documentation\/connectivity\/dominancefrontiers","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/DominanceFrontiers","abstract":[{"type":"text","text":"The dominance frontier of each vertex reachable from a root: the vertices "},{"code":"y","type":"codeVoice"},{"type":"text","text":" such that the"},{"type":"text","text":" "},{"type":"text","text":"vertex dominates a predecessor of "},{"code":"y","type":"codeVoice"},{"type":"text","text":" but does not strictly dominate "},{"code":"y","type":"codeVoice"},{"type":"text","text":" (Cytron et al.), where"},{"type":"text","text":" "},{"type":"text","text":"SSA construction places φ-functions."}],"role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DominanceFrontiers"}]},"doc://Connectivity/documentation/Connectivity/Components":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Components"}],"abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"url":"\/documentation\/connectivity\/components","title":"Components","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"}]},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlockCutTree"}],"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/blockcuttree","navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","abstract":[{"text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and","type":"text"},{"text":" ","type":"text"},{"text":"per articulation point, and an edge joining each block to each articulation point it contains.","type":"text"},{"text":" ","type":"text"},{"text":"Blocks are numbered as in ","type":"text"},{"type":"codeVoice","code":"blocks"},{"text":", articulation points by their place in ","type":"text"},{"type":"codeVoice","code":"articulationPoints"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order). It is a forest: one tree per connected component with an edge that is not a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop; isolated vertices are no node.","type":"text"}],"role":"symbol","title":"BlockCutTree"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"role":"collection","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","type":"topic","url":"\/documentation\/connectivity\/graphprotocols"}}}