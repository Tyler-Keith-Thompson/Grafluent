":"text"},{"type":"text","text":"from the root to "},{"code":"b","type":"codeVoice"},{"type":"text","text":" passes through "},{"code":"a","type":"codeVoice"},{"type":"text","text":". Each reachable vertex but the root has an immediate"},{"type":"text","text":" "},{"type":"text","text":"dominator, its closest strict dominator, which is its parent in the tree."}],"url":"\/documentation\/connectivity\/dominatortree"},"doc://Connectivity/documentation/Connectivity/BiconnectedComponents":{"title":"BiconnectedComponents","navigatorTitle":[{"text":"BiconnectedComponents","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BiconnectedComponents","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BiconnectedComponents","kind":"identifier"}],"abstract":[{"text":"The biconnected components (blocks) of an undirected graph: a collection of blocks, each the","type":"text"},{"text":" ","type":"text"},{"text":"positions of its edges in ascending order; blocks are ordered by their smallest edge position.","type":"text"},{"text":" ","type":"text"},{"text":"The blocks partition the edges that are not self-loops.","type":"text"}],"url":"\/documentation\/connectivity\/biconnectedcomponents"},"doc://Connectivity/documentation/Connectivity/KComponents":{"title":"KComponents","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"url":"\/documentation\/connectivity\/kcomponents"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","abstract":[],"url":"\/documentation\/connectivity"},"doc://Connectivity/documentation/Connectivity/Components":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","navigatorTitle":[{"text":"Components","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A partition of a graph’s vertices into components, in a documented order: a collection of","type":"text"},{"text":" ","type":"text"},{"text":"components, each a slice of vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, with an O(1) ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/connectivity\/components","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"title":"Components","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"title":"GraphProtocols","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","abstract":[],"url":"\/documentation\/connectivity\/graphprotocols"},"doc://Connectivity/documentation/Connectivity/DominanceFrontiers":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivi