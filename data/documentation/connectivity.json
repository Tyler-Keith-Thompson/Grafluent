e joining each block to each articulation point it contains.","type":"text"},{"text":" ","type":"text"},{"text":"Blocks are numbered as in ","type":"text"},{"type":"codeVoice","code":"blocks"},{"text":", articulation points by their place in ","type":"text"},{"type":"codeVoice","code":"articulationPoints"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order). It is a forest: one tree per connected component with an edge that is not a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop; isolated vertices are no node.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"title":"BlockCutTree","url":"\/documentation\/connectivity\/blockcuttree","kind":"symbol","role":"symbol"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"type":"topic","title":"Connectivity","url":"\/documentation\/connectivity","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","abstract":[],"role":"collection","kind":"symbol","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/Trees":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Trees","type":"topic","title":"Trees","url":"\/documentation\/connectivity\/trees","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/DominatorTree":{"navigatorTitle":[{"text":"DominatorTree","kind":"identifier"}],"type":"topic","url":"\/documentation\/connectivity\/dominatortree","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/DominatorTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DominatorTree","kind":"identifier"}],"abstract":[{"type":"text",