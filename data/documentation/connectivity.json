t":"from the root to "},{"type":"codeVoice","code":"b"},{"type":"text","text":" passes through "},{"type":"codeVoice","code":"a"},{"type":"text","text":". Each reachable vertex but the root has an immediate"},{"type":"text","text":" "},{"type":"text","text":"dominator, its closest strict dominator, which is its parent in the tree."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/DominatorTree","navigatorTitle":[{"text":"DominatorTree","kind":"identifier"}],"title":"DominatorTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DominatorTree","kind":"identifier"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"role":"symbol","url":"\/documentation\/connectivity\/blockcuttree","abstract":[{"text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and","type":"text"},{"text":" ","type":"text"},{"text":"per articulation point, and an edge joining each block to each articulation point it contains.","type":"text"},{"text":" ","type":"text"},{"text":"Blocks are numbered as in ","type":"text"},{"type":"codeVoice","code":"blocks"},{"text":", articulation points by their place in ","type":"text"},{"code":"articulationPoints","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order). It is a forest: one tree per connected component with an edge that is not a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop; isolated vertices are no node.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlockCutTree"}],"navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"title":"BlockCutTree","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstrac