bstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"type":"codeVoice","code":"blocks"},{"type":"text","text":", articulation points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"url":"\/documentation\/connectivity\/blockcuttree"},"doc://Connectivity/documentation/Connectivity/BlockCutTree/edgeCount":{"title":"edgeCount","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree\/edgeCount","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"edgeCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"text":"The number of tree edges: one per (block, articulation point in it).","type":"text"}],"url":"\/documentation\/connectivity\/blockcuttree\/edgecount"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","abstract":[],"url":"\/documentation\/connectivity"}}}