omponents":{"abstract":[{"type":"text","text":"The biconnected components (blocks) of an undirected graph: a collection of blocks, each the"},{"type":"text","text":" "},{"type":"text","text":"positions of its edges in ascending order; blocks are ordered by their smallest edge position."},{"type":"text","text":" "},{"type":"text","text":"The blocks partition the edges that are not self-loops."}],"role":"symbol","navigatorTitle":[{"text":"BiconnectedComponents","kind":"identifier"}],"type":"topic","kind":"symbol","title":"BiconnectedComponents","url":"\/documentation\/connectivity\/biconnectedcomponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BiconnectedComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BiconnectedComponents","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity":{"kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/connectivity","title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"url":"\/documentation\/connectivity\/blockcuttree","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree, JGraphT’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"BlockCutpointGraph"},{"type":"text","text":"): a node per block and per articulation point, and an edge joining each"},{"type":"text","text":" "},{"type":"text","text":"block to each articulation point it contains. Blocks are numbered as in "},{"code":"blocks","type":"codeVoice"},{"text":", articulation","type":"text"},{"text":" ","type":"text"},{"text":"points by their place in ","type":"text"},{"code":"arti