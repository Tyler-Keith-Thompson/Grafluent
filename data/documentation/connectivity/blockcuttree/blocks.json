xt"},{"text":" ","type":"text"},{"text":"positions of its edges in ascending order; blocks are ordered by their smallest edge position.","type":"text"},{"text":" ","type":"text"},{"text":"The blocks partition the edges that are not self-loops.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BiconnectedComponents","url":"\/documentation\/connectivity\/biconnectedcomponents"},"doc://Connectivity/documentation/Connectivity/BlockCutTree/blocks":{"type":"topic","title":"blocks","kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blocks","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree\/blocks","url":"\/documentation\/connectivity\/blockcuttree\/blocks","abstract":[{"type":"text","text":"The blocks, as "},{"code":"biconnectedComponents()","type":"codeVoice"},{"type":"text","text":" gives them."}]}}}