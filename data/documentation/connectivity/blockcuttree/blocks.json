ints"},{"type":"text","text":" ("},{"type":"codeVoice","code":"vertices"},{"text":" order). It is a forest: one tree per","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge that is not a self-loop; isolated vertices are no node.","type":"text"}],"url":"\/documentation\/connectivity\/blockcuttree","navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/BlockCutTree/blocks":{"kind":"symbol","abstract":[{"text":"The blocks, as ","type":"text"},{"code":"biconnectedComponents()","type":"codeVoice"},{"text":" gives them.","type":"text"}],"url":"\/documentation\/connectivity\/blockcuttree\/blocks","role":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree\/blocks","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blocks","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BiconnectedComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"blocks"}}}