level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"It keeps a copy of the graph to look vertices up through the graph’s own vertex indices, so","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" hashes nothing on a graph whose indices are its vertices. The copy shares","type":"text"},{"text":" ","type":"text"},{"text":"storage (copy-on-write), so making it is O(1), and later changes to the original do not affect","type":"text"},{"text":" ","type":"text"},{"text":"the result. The cost comes later: while the result is alive, the next mutation of the original","type":"text"},{"text":" ","type":"text"},{"text":"copies the whole graph, as it would with any other copy. Drop the result, or keep only what","type":"text"},{"text":" ","type":"text"},{"text":"you need from it (","type":"text"},{"code":"Array(components)","type":"codeVoice"},{"text":"), before mutating the graph.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A component’s slice keeps the indices of the flat storage it is cut from, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"CompressedSparseRow.successors(of:)"},{"type":"text","text":" does: use "},{"type":"codeVoice","code":"first"},{"type":"text","text":", iteration or "},{"type":"codeVoice","code":"Array(_:)"},{"type":"text","text":", not "},{"type":"codeVoice","code":"[0]"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because its type names the graph’s type, a result cannot be returned through an existential"},{"type":"text","text":" "},{"type":"codeVoice","code":"any DirectedGraph"},{"type":"text","text":": call it from a generic function ("},{"type":"codeVoice","code":"some DirectedGraph"},{"type":"text","text":") instead."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/components"]}],"schemaVersion":{"major":0,"patch":0,"minor"