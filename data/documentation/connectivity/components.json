ext":"DirectedGraph"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"It keeps a copy of the graph to look vertices up through the graph’s own vertex indices, so","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" hashes nothing on a graph whose indices are its vertices. The copy shares","type":"text"},{"text":" ","type":"text"},{"text":"storage (copy-on-write), so making it is O(1), and later changes to the original do not affect","type":"text"},{"text":" ","type":"text"},{"text":"the result. The cost comes later: while the result is alive, the next mutation of the original","type":"text"},{"text":" ","type":"text"},{"text":"copies the whole graph, as it would with any other copy. Drop the result, or keep only what","type":"text"},{"text":" ","type":"text"},{"text":"you need from it (","type":"text"},{"code":"Array(components)","type":"codeVoice"},{"text":"), before mutating the graph.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A component’s slice keeps the indices of the flat storage it is cut from, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CompressedSparseRow.successors(of:)"},{"text":" does: use ","type":"text"},{"type":"codeVoice","code":"first"},{"text":", iteration or ","type":"text"},{"type":"codeVoice","code":"Array(_:)"},{"text":", not ","type":"text"},{"type":"codeVoice","code":"[0]"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because its type names the graph’s type, a result cannot be returned through an existential","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"any DirectedGraph"},{"text":": call it from a generic function (","type":"text"},{"type":"codeVoice","code":"some DirectedGraph"},{"text":") instead.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","re