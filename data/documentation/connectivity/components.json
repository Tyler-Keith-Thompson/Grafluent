{"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"Components","kind":"identifier"}],"remoteSource":{"fileName":"Components.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/Components.swift#L19"},"modules":[{"name":"Connectivity"}],"title":"Components","externalID":"s:12Connectivity10ComponentsV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"roleHeading":"Structure","role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier","text":"DirectedGraph"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"It keeps a copy of the graph to look vertices up through the graph’s own vertex indices, so"},{"type":"text","text":" "},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":" hashes nothing on a graph whose indices are its vertices. The copy shares"},{"type":"text","text":" "},{"type":"text","text":"storage (copy-on-write), so making it is O(1), and later changes to the original do not affect"},{"type":"text","text":" "},{"type":"text","text":"the result. The cost comes later: while the result is alive, the next mutation of the original"},{"type":"text","text":" "},{"type":"text","text":"copies the whole graph, as it would with any other copy. Drop the result, or keep only what"},{"type":"text","text":" "},{"type":"text","text":"you need from it ("},{"code":"Array(components)","type":"codeVoice"},{"type":"text","text":"), before mutating the graph."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A component’s slice keeps the indices of the flat storage it is cut from, as"},{"type":"text","text":" "},{"code":"CompressedSparseRow.successors(of:)","type":"codeVoice"},{"type":"text","text":" does: use "},{"code":"first","type":"codeVoice"},{"type":"text","text":", iteration or "},{"code":"Array(_:)","type":"codeVoice"},{"type":"text","text":", not "},{"code":"[0]","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Because its type names the graph’s type, a result cannot be returned through an existential","type":"text"},{"text":" ","type":"text"},{"code":"any DirectedGraph","type":"codeVoice"},{"text":": call it from a generic function (","type":"text"},{"code":"some DirectedGraph","type":"codeVoice"},{"text":") instead.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/connectivity\/components"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/endIndex","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/startIndex"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/component(of:)","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/component(ofIndex:)"],"title":"Instance Methods","generated":true,"anchor":