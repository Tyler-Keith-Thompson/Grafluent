{"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Connectivity\/SK","doc:\/\/Connectivity\/Sl","doc:\/\/Connectivity\/s8CopyableP","doc:\/\/Connectivity\/s23CustomStringConvertibleP","doc:\/\/Connectivity\/SQ","doc:\/\/Connectivity\/Sk","doc:\/\/Connectivity\/s8SendableP","doc:\/\/Connectivity\/s16SendableMetatypeP","doc:\/\/Connectivity\/ST"],"title":"Conforms To"}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"It keeps a copy of the graph to look vertices up through the graph’s own vertex indices, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" hashes nothing on a graph whose indices are its vertices. The copy shares"},{"type":"text","text":" "},{"type":"text","text":"storage (copy-on-write), so making it is O(1), and later changes to the original do not affect"},{"type":"text","text":" "},{"type":"text","text":"the result. The cost comes later: while the result is alive, the next mutation of the original"},{"type":"text","text":" "},{"type":"text","text":"copies the whole graph, as it would with any other copy. Drop the result, or keep only what"},{"type":"text","text":" "},{"type":"text","text":"you need from it ("},{"type":"codeVoice","code":"Array(components)"},{"type":"text","text":"), before mutating the graph."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A component’s slice keeps the indices of the flat storage it is cut from, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"CompressedSparseRow.successors(of:)"},{"type":"text","text":" does: use "},{"type":"codeVoice","code":"first"},{"type":"text","text":", iteration or "},{"type":"codeVoice","code":"Array(_:)"},{"type":"text","text":", not "},{"type":"codeVoice","code":"[0]"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Because its type names the graph’s type, a result cannot be returned through an existential","type":"text"},{"text":" ","type":"text"},{"code":"any DirectedGraph","type":"codeVoice"},{"text":": call it from a generic function (","type":"text"},{"code":"some DirectedGraph","type":"codeVoice"},{"text":") instead.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/components"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:12Connectivity10ComponentsV","remoteSource":{"fileName":"Components.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/Components.swift#L19"},"title":"Components","role":"symbol","symbolKind":"struct","modules":[{"name":"Connectivity"}],"navigatorTitle":[{"kind":"identifier","text":"Components"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity"]]},"abstract":[{"type":"text","text":"A partition of a graph’s vertices into components,