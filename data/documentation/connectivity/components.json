{"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity"]]},"metadata":{"symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"Connectivity"}],"remoteSource":{"fileName":"Components.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/Components.swift#L19"},"role":"symbol","title":"Components","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"}],"externalID":"s:12Connectivity10ComponentsV","navigatorTitle":[{"kind":"identifier","text":"Components"}]},"kind":"symbol","topicSections":[{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/endIndex","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/startIndex"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/component(checked:)","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/component(of:)","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/component(ofIndex:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Subscripts","identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/subscript(_:)"],"anchor":"Subscripts"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/Element","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/Index","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/Indices"],"anchor":"Type-Aliases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/BidirectionalCollection-Implementations","doc:\/\/Connectivity\/documentation\/Connectivity\/Components\/Collection-Implementations","doc:\/\/Connectivity\/documentation\/Connectivity\/Compon