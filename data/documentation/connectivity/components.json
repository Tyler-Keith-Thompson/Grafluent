{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Connectivity\/SK","doc:\/\/Connectivity\/Sl","doc:\/\/Connectivity\/s8CopyableP","doc:\/\/Connectivity\/s23CustomStringConvertibleP","doc:\/\/Connectivity\/SQ","doc:\/\/Connectivity\/s9EscapableP","doc:\/\/Connectivity\/Sk","doc:\/\/Connectivity\/s8SendableP","doc:\/\/Connectivity\/s16SendableMetatypeP","doc:\/\/Connectivity\/ST"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"text":"It keeps a copy of the graph to look vertices up through the graph’s own vertex indices, so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":" hashes nothing on a graph whose indices are its vertices. The copy shares","type":"text"},{"tex