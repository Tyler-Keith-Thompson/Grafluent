{"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Level 1 is the connected components with an edge and level 2 the blocks of three or more","type":"text"},{"text":" ","type":"text"},{"text":"vertices. Each higher level refines each component of the level below: vertices of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k neighbors are peeled off, and each piece left is either k-connected or split by a","type":"text"},{"text":" ","type":"text"},{"text":"vertex cut X of fewer than k vertices into parts D, each searched again as D ∪ X. A cut is","type":"text"},{"text":" ","type":"text"},{"text":"found by Even’s method, unit-capacity flows on the split network between each of k","type":"text"},{"text":" ","type":"text"},{"text":"vertices and every later one it is not adjacent to, each stopped after k augmenting paths.","type":"text"}]},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(n + m) for levels 1 and 2; each refinement at level k makes at most k n","type":"text"},{"text":" ","type":"text"},{"text":"flows of O(k (n + m)) each.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","role":"symbol","symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"kComponents()","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80","fileName":"KComponents.swift"},"extendedModule":"GraphProtocols"},"abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","title":"kComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","title":"GraphProtocols","kind":"symbol","abstract":[],"url":"\/documentation\/connectivity\/graphprotocols","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/KComponents":{"url":"\/documentation\/connectivity\/kcomponents","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","title":"KComponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"}}}