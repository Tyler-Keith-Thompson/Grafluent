{"metadata":{"role":"symbol","externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80","fileName":"KComponents.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"roleHeading":"Instance Method","title":"kComponents()","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"symbolKind":"method"},"abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Level 1 is the connected components with an edge and level 2 the blocks of three or more","type":"text"},{"text":" ","type":"text"},{"text":"vertices. Each higher level refines each component of the level below: vertices of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k neighbors are peeled off, and each piece left is either k-connected or split by a","type":"text"},{"text":" ","type":"text"},{"text":"vertex cut X of fewer than k vertices into parts D, each searched again as D ∪ X. A cut is","type":"text"},{"text":" ","type":"text"},{"text":"found by Even’s method, unit-capacity flows on the split network between each of k","type":"text"},{"text":" ","type":"text"},{"text":"vertices and every later one it is not adjacent to, each stopped after k augmenting paths.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(n + m) for levels 1 and 2; each refinement at level k makes at most k n"},{"type":"text","text":" "},{"type":"text","text":"flows of O(k (n + m)) each."}],"type":"paragraph"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"url":"\/documentation\/connectivity\/kcomponents","title":"KComponents","kind":"symbol","type":"topic","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","type":"topic","title":"kComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"title":"Graph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","role":"symbol","type":"topic","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","abstract":[],"role":"collection","type":"topic","title":"GraphProtocols","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/connectivity","kind":"symbol"}}}