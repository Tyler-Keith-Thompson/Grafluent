{"sections":[],"abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","title":"kComponents()","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80","fileName":"KComponents.swift"},"extendedModule":"GraphProtocols","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents","kind":"typeIdentifier","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Level 1 is the connected components with an edge and level 2 the blocks of three or more"},{"type":"text","text":" "},{"type":"text","text":"vertices. Each higher level refines each component of the level below: vertices of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k neighbors are peeled off, and each piece left is either k-connected or split by a"},{"type":"text","text":" "},{"type":"text","text":"vertex cut X of fewer than k vertices into parts D, each searched again as D ∪ X. A cut is"},{"type":"text","text":" "},{"type":"text","text":"found by Even’s method, unit-capacity flows on the split network between each of k"},{"type":"text","text":" "},{"type":"text","text":"vertices and every later one it is not adjacent to, each stopped after k augmenting paths."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m) for levels 1 and 2; each refinement at level k makes at most k n"},{"type":"text","text":" "},{"type":"text","text":"flows of O(k (n + m)) each."}]}],"name":"Complexity","type":"aside"}]}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","type":"topic","role":"symbol","abstract":[],"title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph","kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity":{"role":"collection","type":"topic","url":"\/documentation\/connectivity","abstract":[],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"type":"topic","title":"kComponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","abstract":[],"role":"collection","type":"topic","url":"\/documentation\/connectivity\/graphprotocols","kind":"symbol","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"role":"symbol","type":"topic","url":"\/documentation\/connectivity\/kcomponents","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","title":"KComponents"}}}