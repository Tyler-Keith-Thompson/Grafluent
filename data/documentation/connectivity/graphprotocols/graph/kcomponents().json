{"sections":[],"metadata":{"symbolKind":"method","title":"kComponents()","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"remoteSource":{"fileName":"KComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80"},"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}]},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity11KComponentsV","kind":"typeIdentifier","text":"KComponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Level 1 is the connected components with an edge and level 2 the blocks of three or more"},{"type":"text","text":" "},{"type":"text","text":"vertices. Each higher level refines each component of the level below: vertices of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k neighbors are peeled off, and each piece left is either k-connected or split by a"},{"type":"text","text":" "},{"type":"text","text":"vertex cut X of fewer than k vertices into parts D, each searched again as D ∪ X. A cut is"},{"type":"text","text":" "},{"type":"text","text":"found by Even’s method, unit-capacity flows on the split network between each of k"},{"type":"text","text":" "},{"type":"text","text":"vertices and every later one it is not adjacent to, each stopped after k augmenting paths."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m) for levels 1 and 2; each refinement at level k makes at most k n"},{"type":"text","text":" "},{"type":"text","text":"flows of O(k (n + m)) each."}]}],"name":"Complexity","type":"aside"}]}],"abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"kind":"symbol","references":{"doc://Connectivity/documentation/Connectivity/KComponents":{"role":"symbol","abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","url":"\/documentation\/connectivity\/kcomponents","title":"KComponents"},"doc://Connectivity/documentation/Connectivity":{"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","abstract":[],"url":"\/documentation\/connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","title":"kComponents()","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph","abstract":[],"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"title":"Graph","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"role":"collection","title":"GraphProtocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols"}}}