{"metadata":{"symbolKind":"method","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"remoteSource":{"fileName":"KComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80"},"role":"symbol","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","title":"kComponents()","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()"},"abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"Level 1 is the connected components with an edge and level 2 the blocks of three or more","type":"text"},{"text":" ","type":"text"},{"text":"vertices. Each higher level refines each component of the level below: vertices of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k neighbors are peeled off, and each piece left is either k-connected or split by a","type":"text"},{"text":" ","type":"text"},{"text":"vertex cut X of fewer than k vertices into parts D, each searched again as D ∪ X. A cut is","type":"text"},{"text":" ","type":"text"},{"text":"found by Even’s method, unit-capacity flows on the split network between each of k","type":"text"},{"text":" ","type":"text"},{"text":"vertices and every later one it is not adjacent to, each stopped after k augmenting paths.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n + m) for levels 1 and 2; each refinement at level k makes at most k n"},{"type":"text","text":" "},{"type":"text","text":"flows of O(k (n + m)) each."}],"type":"paragraph"}],"name":"Complexity","style":"note"}]}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","title":"kComponents()","abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic","url":"\/documentation\/connectivity","role":"collection","title":"Connectivity","kind":"symbol","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","title":"Graph","abstract":[],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","abstract":[],"role":"collection"},"doc://Connectivity/documentation/Connectivity/KComponents":{"url":"\/documentation\/connectivity\/kcomponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","title":"KComponents","type":"topic","abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}]}}}