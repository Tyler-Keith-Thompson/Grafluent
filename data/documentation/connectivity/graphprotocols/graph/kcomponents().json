{"metadata":{"extendedModule":"GraphProtocols","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80","fileName":"KComponents.swift"},"title":"kComponents()","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"symbolKind":"method","role":"symbol"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Level 1 is the connected components with an edge and level 2 the blocks of three or more","type":"text"},{"text":" ","type":"text"},{"text":"vertices. Each higher level refines each component of the level below: vertices of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k neighbors are peeled off, and each piece left is either k-connected or split by a","type":"text"},{"text":" ","type":"text"},{"text":"vertex cut X of fewer than k vertices into parts D, each searched again as D ∪ X. A cut is","type":"text"},{"text":" ","type":"text"},{"text":"found by Even’s method, unit-capacity flows on the split network between each of k","type":"text"},{"text":" ","type":"text"},{"text":"vertices and every later one it is not adjacent to, each stopped after k augmenting paths.","type":"text"}],"type":"paragraph"},{"name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(n + m) for levels 1 and 2; each refinement at level k makes at most k n","type":"text"},{"text":" ","type":"text"},{"text":"flows of O(k (n + m)) each.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"references":{"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","url":"\/documentation\/connectivity","type":"topic","abstract":[],"kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"title":"GraphProtocols","type":"topic"},"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"title":"KComponents","url":"\/documentation\/connectivity\/kcomponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","kind":"symbol","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"kComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","kind":"symbol","abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"type":"topic","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","type":"topic"}}}