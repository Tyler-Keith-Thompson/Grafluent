{"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()"},"metadata":{"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"symbolKind":"method","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"stronglyConnectedComponents()","extendedModule":"GraphProtocols","remoteSource":{"fileName":"StronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148"}},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search","type":"text"},{"text":" ","type":"text"},{"text":"with roots in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and successors in ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" order. That is a reverse","type":"text"},{"text":" ","type":"text"},{"text":"topological order of the condensation: every edge between components goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"component to an earlier one, so ","type":"text"},{"code":"reversed()","type":"codeVoice"},{"text":" lists the components with every edge going","type":"text"},{"text":" ","type":"text"},{"text":"forward. Each component lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":"), one sort by that vertex’s position"},{"type":"text","text":" "},{"type":"text","text":"puts the components in insertion order, O(C log C) for C components:"}]},{"code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On any graph, one pass over "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists them in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(V):"}]},{"code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"style":"note","name":"Complexity"}],"kind":"content"}],"references":{"doc://Connectivity/documentation/Connectivity/Components":{"title":"Components","navigatorTitle":[{"text":"Components","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","role":"symbol","url":"\/documentation\/connectivity\/components","type":"topic","abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity":{"abstract":[],"type":"topic","title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","kind":"symbol","url":"\/documentation\/connectivity","role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","type":"topic","title":"DirectedGraph","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"title":"stronglyConnectedComponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]}}}