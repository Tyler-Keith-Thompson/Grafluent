ocols\/directedgraph\/stronglyconnectedcomponents()","abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other.","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm, iterative, O(V + E).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","title":"stronglyConnectedComponents()"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","role":"collection","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic","url":"\/documentation\/connectivity","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols"}}}