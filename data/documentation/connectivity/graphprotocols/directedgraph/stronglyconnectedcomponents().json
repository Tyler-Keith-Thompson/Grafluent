{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"metadata":{"extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L131","fileName":"StronglyConnectedComponents.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"stronglyConnectedComponents()"},"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other."},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm, iterative, O(V + E)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Components","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and successors in "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" order (the order of"},{"type":"text","text":" "},{"type":"text","text":"NetworkX, petgraph and Boost). That is a reverse topological order of the condensation:"},{"type":"text","text":" "},{"type":"text","text":"every edge between components goes from a later component to an earlier one, so"},{"type":"text","text":" "},{"code":"reversed()","type":"codeVoice"},{"type":"text","text":" lists the components with every edge going forward. Each component lists its"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."}]},{"type":"paragraph","inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":", so on a graph whose vertex","type":"text"},{"text":" ","type":"text"},{"text":"positions are insertion order (","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":"), one sort puts the components in","type":"text"},{"text":" ","type":"text"},{"text":"insertion order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let inInsertionOrder = graph.stronglyConnectedComponents().sorted { graph.vertices.firstIndex(of: $0.first!)! < graph.vertices.firstIndex(of: $1.first!)! }"]}],"kind":"content"}],"kind":"symbol","references":{"doc://Connectivity/documentation/Connectivity/Components":{"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"Components","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"title":"Components","url":"\/documentation\/connectivity\/components"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","kind":"symbol","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/connectivity","title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","kind":"symbol","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other."},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm, iterative, O(V + E)."}],"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","type":"topic","title":"strong