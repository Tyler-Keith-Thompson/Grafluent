tedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Connectivity/documentation/Connectivity/Components":{"type":"topic","url":"\/documentation\/connectivity\/components","abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"}],"title":"Components","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Components"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"title":"GraphProtocols","abstract":[],"role":"collection","url":"\/documentation\/connectivity\/graphprotocols","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","kind":"symbol"}}}