components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/connectivity\/components","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Components"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","title":"Components","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols","role":"collection","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols"}}}