omponents in insertion order, O(C log C) for C components:"}]},{"type":"codeListing","syntax":"swift","code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"type":"paragraph","inlineContent":[{"text":"On any graph, one pass over ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" lists them in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(V):","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"]},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"type":"aside","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"metadata":{"extendedModule":"GraphProtocols","role":"symbol","symbolKind":"method","title":"stronglyConnectedComponents()","roleHeading":"Instance Method","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148","fileName":"StronglyConnectedComponents.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<",