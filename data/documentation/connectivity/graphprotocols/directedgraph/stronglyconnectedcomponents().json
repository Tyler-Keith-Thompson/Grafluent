{"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and successors in "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" order (the order of"},{"type":"text","text":" "},{"type":"text","text":"NetworkX, petgraph and Boost). That is a reverse topological order of the condensation:"},{"type":"text","text":" "},{"type":"text","text":"every edge between components goes from a later component to an earlier one, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"reversed()"},{"type":"text","text":" lists the components with every edge going forward. Each component lists its"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":"), one sort puts the components in"},{"type":"text","text":" "},{"type":"text","text":"insertion order:"}]},{"type":"codeListing","code":["let inInsertionOrder = graph.stronglyConnectedComponents().sorted { graph.vertices.firstIndex(of: $0.first!)! < graph.vertices.firstIndex(of: $1.first!)! }"],"syntax":"swift"}],"kind":"content"}],"metadata":{"role":"symbol","title":"stronglyConnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","symbolKind":"method","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","remoteSource":{"fileName":"StronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L131"},"extendedModule":"GraphProtocols"},"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other."},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm, iterative, O(V + E)."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Direc