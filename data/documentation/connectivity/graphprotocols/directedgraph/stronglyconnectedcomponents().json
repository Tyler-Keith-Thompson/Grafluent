{"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and successors in "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" order. That is a reverse"},{"type":"text","text":" "},{"type":"text","text":"topological order of the condensation: every edge between components goes from a later"},{"type":"text","text":" "},{"type":"text","text":"component to an earlier one, so "},{"type":"codeVoice","code":"reversed()"},{"type":"text","text":" lists the components with every edge going"},{"type":"text","text":" "},{"type":"text","text":"forward. Each component lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":"), one sort by that vertex’s position"},{"type":"text","text":" "},{"type":"text","text":"puts the components in insertion order, O(C log C) for C components:"}],"type":"paragraph"},{"syntax":"swift","code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"type":"codeListing"},{"inlineContent":[{"text":"On any graph, one pass over ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" lists them in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(V):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"name":"Complexity","style":"note","type":"aside"}]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148","fileName":"StronglyConnectedComponents.swift"},"title":"stronglyConnectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","roleHeading":"Instance Method","extendedModule":"GraphProtocols","symbolKind":"method","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"]}],"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","interfaceLanguage":"swift"},"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","abstract":[],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/Components":{"navigatorTitle":[{"text":"Components","kind":"identifier"}],"abstract":[{"text":"A partition of a graph’s vertices into components, in a documented order: a collection of","type":"text"},{"text":" ","type":"text"},{"text":"components, each a slice of vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, with an O(1) ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":".","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"url":"\/documentation\/connectivity\/components","kind":"symbol","title":"Components"},"doc://Connectivity/documentation/Connectivity":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","url":"\/documentation\/connectivity","type":"topic","kind":"symbol","role":"collection","title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other, by","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","type":"topic","kind":"symbol","role":"symbol","title":"stronglyConnectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]}}}