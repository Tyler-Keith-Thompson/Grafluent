{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search","type":"text"},{"text":" ","type":"text"},{"text":"with roots in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and successors in ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" order. That is a reverse","type":"text"},{"text":" ","type":"text"},{"text":"topological order of the condensation: every edge between components goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"component to an earlier one, so ","type":"text"},{"code":"reversed()","type":"codeVoice"},{"text":" lists the components with every edge going","type":"text"},{"text":" ","type":"text"},{"text":"forward. Each component lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":"), one sort by that vertex’s position"},{"type":"text","text":" "},{"type":"text","text":"puts the components in insertion order, O(C log C) for C components:"}]},{"code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"On any graph, one pass over ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" lists them in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, O(V):","type":"text"}]},{"code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"syntax":"swift","type":"codeListing"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"style":"note","type":"aside"}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other, by","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"title":"stronglyConnectedComponents()","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","roleHeading":"Instance Method","remoteSource":{"fileName":"StronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148"},"modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","symbolKind":"method","role":"symb