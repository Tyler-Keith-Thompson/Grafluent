{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()"},"kind":"symbol","metadata":{"modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148","fileName":"StronglyConnectedComponents.swift"},"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","role":"symbol","title":"stronglyConnectedComponents()"},"abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other, by","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and successors in "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" order. That is a reverse"},{"type":"text","text":" "},{"type":"text","text":"topological order of the condensation: every edge between components goes from a later"},{"type":"text","text":" "},{"type":"text","text":"component to an earlier one, so "},{"type":"codeVoice","code":"reversed()"},{"type":"text","text":" lists the components with every edge going"},{"type":"text","text":" "},{"type":"text","text":"forward. Each component lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"code":"StableDirectedGraph","type":"codeVoice"},{"type":"text","text":"), one sort by that vertex’s position"},{"type":"text","text":" "},{"type":"text","text":"puts the components in insertion order, O(C log C) for C components:"}],"type":"paragraph"},{"code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"On any graph, one pass over "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists them in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(V):"}],"type":"paragraph"},{"code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"type":"codeListing","syntax":"swift"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(V + E)."}]}],"type":"aside","style":"note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","abstract":[],"role":"collection"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic","url":"\/documentation\/connectivity","role":"collection","title":"Connectivity","kind":"symbol","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"title":"DirectedGraph","kind":"symbol","abstract":[]},"doc://Connectivity/documentation/Connectivity/Components":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Components","kind":"identifier"}],"url":"\/documentation\/connectivity\/components","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"title":"Components","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","abstract":[{"text":"A partition of a graph’s vertices into components, in a documented order: a collection of","type":"text"},{"text":" ","type":"text"},{"text":"components, each a slice of vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, with an O(1) ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":"."}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","kind":"symbol","abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","type":"topic","title":"stronglyConnectedComponents()"}}}