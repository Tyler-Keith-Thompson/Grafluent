ifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}],"abstract":[],"title":"DirectedGraph","type":"topic","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/Components":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"abstract":[{"text":"A partition of a graph’s vertices into components, in a documented order: a collection of","type":"text"},{"text":" ","type":"text"},{"text":"components, each a slice of vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, with an O(1) ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":".","type":"text"}],"title":"Components","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","kind":"symbol","url":"\/documentation\/connectivity\/components","navigatorTitle":[{"text":"Components","kind":"identifier"}]}}}