onents","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"role":"collection","url":"\/documentation\/connectivity","type":"topic","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","role":"symbol","abstract":[],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}]}}}