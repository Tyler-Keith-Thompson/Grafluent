{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"]}],"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search","type":"text"},{"text":" ","type":"text"},{"text":"with roots in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and successors in ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" order. That is a reverse","type":"text"},{"text":" ","type":"text"},{"text":"topological order of the condensation: every edge between components goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"component to an earlier one, so ","type":"text"},{"code":"reversed()","type":"codeVoice"},{"text":" lists the components with every edge going","type":"text"},{"text":" ","type":"text"},{"text":"forward. Each component lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", so on a graph whose vertex","type":"text"},{"text":" ","type":"text"},{"text":"positions are insertion order (","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":"), one sort by that vertex’s position","type":"text"},{"text":" ","type":"text"},{"text":"puts the components in insertion order, O(C log C) for C components:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"type":"codeListing"},{"inlineContent":[{"text":"On any graph, one pass over ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" lists them in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(V):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"text":"O(V + E).","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"title":"stronglyConnectedComponents()","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148","fileName":"StronglyConnectedComponents.swift"},"roleHeading":"Instance Method","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"fragments":[{"text":"fun