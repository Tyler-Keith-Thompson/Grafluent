{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","role":"symbol","remoteSource":{"fileName":"StronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148"},"roleHeading":"Instance Method","title":"stronglyConnectedComponents()","extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"]}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and successors in "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" order. That is a reverse"},{"type":"text","text":" "},{"type":"text","text":"topological order of the condensation: every edge between components goes from a later"},{"type":"text","text":" "},{"type":"text","text":"component to an earlier one, so "},{"code":"reversed()","type":"codeVoice"},{"type":"text","text":" lists the components with every edge going"},{"type":"text","text":" "},{"type":"text","text":"forward. Each component lists its vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"code":"StableDirectedGraph","type":"codeVoice"},{"type":"text","text":"), one sort by that vertex’s position"},{"type":"text","text":" "},{"type":"text","text":"puts the components in insertion order, O(C log C) for C components:"}],"type":"paragraph"},{"code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"On any graph, one pass over ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" lists them in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(V):","type":"text"}],"type":"paragraph"},{"code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"type":"codeListing","syntax":"swift"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(V + E)."}]}],"type":"aside"}]}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other, by","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm.","type":"text"}],"type":"topic","kind":"symbol","title":"stronglyConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph"},"doc://Connectivity/documentation/Connectivity":{"role":"collection","kind":"symbol","title":"Connectivity","abstract":[],"url":"\/documentation\/connectivity","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity"},"doc://Connectivity/documentation/Connectivity/Components":{"role":"symbol","kind":"symbol","title":"Components","navigatorTitle":[{"text":"Components","kind":"identifier"}],"abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"url":"\/documentation\/connectivity\/components","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"}}}