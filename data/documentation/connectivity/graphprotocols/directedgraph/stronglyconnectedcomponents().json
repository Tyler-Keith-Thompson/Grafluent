{"sections":[],"metadata":{"title":"stronglyConnectedComponents()","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"fileName":"StronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L136"},"extendedModule":"GraphProtocols","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","role":"symbol","symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and successors in "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" order (the order of"},{"type":"text","text":" "},{"type":"text","text":"NetworkX, petgraph and Boost). That is a reverse topological order of the condensation:"},{"type":"text","text":" "},{"type":"text","text":"every edge between components goes from a later component to an earlier one, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"reversed()"},{"type":"text","text":" lists the components with every edge going forward. Each component lists its"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":"), one sort puts the components in"},{"type":"text","text":" "},{"type":"text","text":"insertion order:"}]},{"type":"codeListing","code":["let inInsertionOrder = graph.stronglyConnectedComponents().sorted { graph.vertices.firstIndex(of: $0.first!)! < graph.vertices.firstIndex(of: $1.first!)! }"],"syntax":"swift"}]}],"abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other.","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm, iterative, O(V + E).","type":"text"}],"kind":"symbol","references":{"doc://Connectivity/documentation/Connectivity/Components":{"kind":"symbol","role":"symbol","url":"\/documentation\/connectivity\/components","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"title":"Components","navigatorTitle":[{"text":"Components","kind":"identifier"}],"abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"abstract":[],"role":"symbol"},"doc://Connectivity/documentation/Connectivity":{"abstract":[],"kind":"symbol","title":"Connectivity","role":"collection","url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","type":"topic","abstract":[],"role":"collection"},"doc://Connectivity/document