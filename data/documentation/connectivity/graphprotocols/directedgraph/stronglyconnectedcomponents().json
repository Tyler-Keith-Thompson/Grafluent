{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","extendedModule":"GraphProtocols","role":"symbol","title":"stronglyConnectedComponents()"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and successors in "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" order. That is a reverse"},{"type":"text","text":" "},{"type":"text","text":"topological order of the condensation: every edge between components goes from a later"},{"type":"text","text":" "},{"type":"text","text":"component to an earlier one, so "},{"type":"codeVoice","code":"reversed()"},{"type":"text","text":" lists the components with every edge going"},{"type":"text","text":" "},{"type":"text","text":"forward. Each component lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":"), one sort by that vertex’s position"},{"type":"text","text":" "},{"type":"text","text":"puts the components in insertion order, O(C log C) for C components:"}]},{"type":"codeListing","code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On any graph, one pass over ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" lists them in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(V):","type":"text"}]},{"type":"codeListing","code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"syntax":"swift"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"name":"Complexity"}]}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"]}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"url":"\/documentation\/connectivity\/graphprotocols","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity":{"kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","title":"DirectedGraph","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","abstract":[],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/Components":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"}],"abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with an O(1) "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"Components"}],"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","url":"\/documentation\/connectivity\/components","role":"symbol","title":"Components"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"title":"stronglyConnectedComponents()","kind":"symbol"}}}