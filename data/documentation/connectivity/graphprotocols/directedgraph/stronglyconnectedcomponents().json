{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Instance Method","title":"stronglyConnectedComponents()","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L131","fileName":"StronglyConnectedComponents.swift"},"symbolKind":"method","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","role":"symbol","extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other.","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm, iterative, O(V + E).","type":"text"}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and successors in "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" order (the order of"},{"type":"text","text":" "},{"type":"text","text":"NetworkX, petgraph and Boost). That is a reverse topological order of the condensation:"},{"type":"text","text":" "},{"type":"text","text":"every edge between components goes from a later component to an earlier one, so"},{"type":"text","text":" "},{"code":"reversed()","type":"codeVoice"},{"type":"text","text":" lists the components with every edge going forward. Each component lists its"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so on a graph whose vertex"},{"type":"text","text":" "},{"type":"text","text":"positions are insertion order ("},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":"), one sort puts the components in"},{"type":"text","text":" "},{"type":"text","text":"insertion order:"}]},{"code":["let inInsertionOrder = graph.stronglyConnectedComponents().sorted { graph.vertices.firstIndex(of: $0.first!)! < graph.vertices.firstIndex(of: $1.first!)! }"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"sections":[],"kind":"symbol","references":{"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","kind":"symbol","abstract":[],"type":"topic","title":"Connectivity","url":"\/documentation\/connectivity"},"doc://Connectivity/documentation/Connectivity/Components":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Components"}],"abstract":[{"type":"text","text":"A partition of a graph’s vertices into components, in a documented order: a collection of"},{"type":"text","text":" "},{"type":"text","text":"components, each a slice of vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, with an O(1) "},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Components"}],"title":"Components","url":"\/documentation\/connectivity\/components"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","type":"topic","title":"DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"url":"\/documentation\/connectivity\/graphprotocols","kind":"symbol","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","type":"topic","title":"GraphProtocols","role":"collection"},"doc://Connectivity/document