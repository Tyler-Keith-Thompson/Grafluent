{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()"]}],"metadata":{"role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"remoteSource":{"fileName":"StronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148"},"title":"stronglyConnectedComponents()","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","extendedModule":"GraphProtocols"},"abstract":[{"type":"text","text":"The strongly connected components: maximal sets of vertices each reaching every other, by"},{"type":"text","text":" "},{"type":"text","text":"Tarjan’s algorithm."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search","type":"text"},{"text":" ","type":"text"},{"text":"with roots in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and successors in ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" order. That is a reverse","type":"text"},{"text":" ","type":"text"},{"text":"topological order of the condensation: every edge between components goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"component to an earlier one, so ","type":"text"},{"code":"reversed()","type":"codeVoice"},{"text":" lists the components with every edge going","type":"text"},{"text":" ","type":"text"},{"text":"forward. Each component lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":", so on a graph whose vertex","type":"text"},{"text":" ","type":"text"},{"text":"positions are insertion order (","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":"), one sort by that vertex’s position","type":"text"},{"text":" ","type":"text"},{"text":"puts the components in insertion order, O(C log C) for C components:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"inlineContent":[{"type":"text","text":"On any graph, one pass over "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists them in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(V):"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(V + E).","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()","interfaceLanguage":"swift"},"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"stronglyConnectedComponents()","type":"topic","kind":"symbol","abstract":[{"text":"The strongly connected components: maximal sets of vertices each reaching every other, by","type":"text"},{"text":" ","type":"text"},{"text":"Tarjan’s algorithm.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/stronglyConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"url":"\/documentation\/connectivity\/graphprotocols","kind":"symbol","type":"topic","title":"GraphProtocols","role":"collection","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols"},"doc://Connectivity/documentati