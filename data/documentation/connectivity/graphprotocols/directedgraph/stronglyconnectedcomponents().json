ertexPosition(of: $1.first!) }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On any graph, one pass over ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" lists them in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, O(V):","type":"text"}]},{"code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/Components":{"type":"topic","abstract":[{"text":"A partition of a graph’s vertices into components, in a documented order: a collection of","type":"text"},{"text":" ","type":"text"},{"text":"components, each a slice of vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, with an O(1) ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":".","type":"text"}],"role":"symbol","url":"\/documentation\/connectivity\/components","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Components","kind":"identifier"}],"title":"Components","kind":"symbol","navigatorTitle":[{"text":"Components","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/stronglyConnectedComponents()":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedcomponents()","title":"stronglyConnec