":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","type":"topic","role":"symbol","abstract":[]},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"url":"\/documentation\/connectivity","role":"collection","type":"topic","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","abstract":[],"url":"\/documentation\/connectivity\/graphprotocols","role":"collection","kind":"symbol","type":"topic"}}}