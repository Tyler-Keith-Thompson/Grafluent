{"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"remoteSource":{"fileName":"StronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/StronglyConnectedComponents.swift#L148"},"role":"symbol","roleHeading":"Instance Method","extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"stronglyConnectedComponents()","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE27stronglyConnectedComponentsAD0G0VyxGyF","symbolKind":"method"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are in the order Tarjan’s algorithm completes them, on a depth-first search"},{"type":"text","text":" "},{"type":"text","text":"with roots in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and successors in "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" order. That is a reverse"},{"type":"text","text":" "},{"type":"text","text":"topological order of the condensation: every edge between components goes from a later"},{"type":"text","text":" "},{"type":"text","text":"component to an earlier one, so "},{"type":"codeVoice","code":"reversed()"},{"type":"text","text":" lists the components with every edge going"},{"type":"text","text":" "},{"type":"text","text":"forward. Each component lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}]},{"type":"paragraph","inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":", so on a graph whose vertex","type":"text"},{"text":" ","type":"text"},{"text":"positions are insertion order (","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":"), one sort by that vertex’s position","type":"text"},{"text":" ","type":"text"},{"text":"puts the components in insertion order, O(C log C) for C components:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let inInsertionOrder = graph.stronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On any graph, one pass over "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists them in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(V):"}]},{"syntax":"swift","type":"codeListing","code":["let components = graph.stronglyConnectedComponents()","let inVertexOrder = graph.vertices.compactMap { vertex in","    let component = components[components.component(of: vertex)]","    return component.first == vertex ? component : nil","}"]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(V + E)."}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/stronglyconnectedco