{"sections":[],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nontrivialStronglyConnectedComponents"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:s10ArraySliceV","kind":"typeIdentifier","text":"ArraySlice"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">]"}],"title":"nontrivialStronglyConnectedComponents()","extendedModule":"GraphProtocols","symbolKind":"method","remoteSource":{"fileName":"NontrivialStronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/NontrivialStronglyConnectedComponents.swift#L89"},"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s"},{"type":"text","text":" "},{"type":"text","text":"successors."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The components are those of "},{"type":"codeVoice","code":"stronglyConnectedComponents()"},{"type":"text","text":" without the trivial ones, in the"},{"type":"text","text":" "},{"type":"text","text":"same order, a reverse topological order: every path between two of them goes from a later"},{"type":"text","text":" "},{"type":"text","text":"one to an earlier one. Each lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Empty exactly when the"},{"type":"text","text":" "},{"type":"text","text":"graph is acyclic. Each is a slice of one shared array, as in "},{"type":"codeVoice","code":"attractingComponents()"},{"type":"text","text":", so its"},{"type":"text","text":" "},{"type":"text","text":"indices do not start at 0."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":", so one sort by that vertex’s"},{"type":"text","text":" "},{"type":"text","text":"position puts the components in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, O(C log C) for C components. On a"},{"type":"text","text":" "},{"code":"StableDirectedGraph","type":"codeVoice"},{"type":"text","text":", where positions are insertion order:"}],"type":"paragraph"},{"code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"type":"aside"}]}],"abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()"},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","type":"topic","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","title":"DirectedGraph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"abstract":[],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/connectivity","title":"Connectivity","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","title":"Vertex","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/nontrivialStronglyConnectedComponents()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nontrivialStronglyConnectedComponents"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"ArraySlice","preciseIdentifier":"s:s10ArraySliceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">]"}],"type":"topic","title":"nontrivialStronglyConnectedComponents()","role":"symbol","abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()"}}}