m goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"one to an earlier one. Each lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. Empty exactly when the","type":"text"},{"text":" ","type":"text"},{"text":"graph is acyclic. Each is a slice of one shared array, as in ","type":"text"},{"code":"attractingComponents()","type":"codeVoice"},{"text":", so its","type":"text"},{"text":" ","type":"text"},{"text":"indices do not start at 0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so one sort by that vertex’s"},{"type":"text","text":" "},{"type":"text","text":"position puts the components in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(C log C) for C components. On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":", where positions are insertion order:"}]},{"syntax":"swift","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","title":"Vertex","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/nontrivialStronglyConnectedComponents()":{"fragments":[{"kind":"keyword","text":"func"},{"k