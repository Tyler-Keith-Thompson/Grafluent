{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:s10ArraySliceV","text":"ArraySlice","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF","role":"symbol","remoteSource":{"fileName":"NontrivialStronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/NontrivialStronglyConnectedComponents.swift#L89"},"roleHeading":"Instance Method","title":"nontrivialStronglyConnectedComponents()","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols"},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nontrivialStronglyConnectedComponents"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV","text":"ArraySlice"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">]"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"successors.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The components are those of ","type":"text"},{"code":"stronglyConnectedComponents()","type":"codeVoice"},{"text":" without the trivial ones, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order, a reverse topological order: every path between two of them goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"one to an earlier one. Each lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. Empty exactly when the","type":"text"},{"text":" ","type":"text"},{"text":"graph is acyclic. Each is a slice of one shared array, as in ","type":"text"},{"code":"attractingComponents()","type":"codeVoice"},{"text":", so its","type":"text"},{"text":" ","type":"text"},{"text":"indices do not start at 0.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", so one sort by that vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"position puts the components in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(C log C) for C components. On a","type":"text"},{"text":" ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":", where positions are insertion order:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"type":"codeListing"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"style":"note","type":"aside"}],"kind":"content"}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","fragments":[{"text":"associatedtype","kin