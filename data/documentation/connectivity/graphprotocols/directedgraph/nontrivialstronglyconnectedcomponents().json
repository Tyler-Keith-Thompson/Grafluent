{"abstract":[{"text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the","type":"text"},{"text":" ","type":"text"},{"text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in","type":"text"},{"text":" ","type":"text"},{"text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes","type":"text"},{"text":" ","type":"text"},{"text":"through both.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"metadata":{"roleHeading":"Instance Method","title":"nontrivialStronglyConnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","preciseIdentifier":"s:s10ArraySliceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"symbolKind":"method","remoteSource":{"fileName":"NontrivialStronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/NontrivialStronglyConnectedComponents.swift#L89"},"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF","extendedModule":"GraphProtocols","role":"symbol"},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","preciseIdentifier":"s:s10ArraySliceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"successors.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The components are those of "},{"type":"codeVoice","code":"stronglyConnectedComponents()"},{"type":"text","text":" without the trivial ones, in the"},{"type":"text","text":" "},{"type":"text","text":"same order, a reverse topological order: every path between two of them goes from a later"},{"type":"text","text":" "},{"type":"text","text":"one to an earlier one. Each lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Empty exactly when the"},{"type":"text","text":" "},{"type":"text","text":"graph is acyclic. Each is a slice of one shared array, as in "},{"type":"codeVoice","code":"attractingComponents()"},{"type":"text","text":", so its"},{"type":"text","text":" "},{"type":"text","text":"indices do not start at 0."}],"type":"paragraph"},{"inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", so one sort by that vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"position puts the components in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(C log C) for C components. On a","type":"text"},{"text":" ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":", where positions are insertion order:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(V + E)."}],"type":"paragraph"}]}]}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Connectivity/documentation/Connectivity":{"role":"collection","abstract":[],"url":"\/documentation\/connectivity","title":"Connectivity","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/nontrivialStronglyConnectedComponents()":{"abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "}