{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">]","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"successors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The components are those of ","type":"text"},{"code":"stronglyConnectedComponents()","type":"codeVoice"},{"text":" without the trivial ones, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order, a reverse topological order: every path between two of them goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"one to an earlier one. Each lists its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. Empty exactly when the","type":"text"},{"text":" ","type":"text"},{"text":"graph is acyclic. Each is a slice of one shared array, as in ","type":"text"},{"code":"attractingComponents()","type":"codeVoice"},{"text":", so its","type":"text"},{"text":" ","type":"text"},{"text":"indices do not start at 0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so one sort by that vertex’s"},{"type":"text","text":" "},{"type":"text","text":"position puts the components in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(C log C) for C components. On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":", where positions are insertion order:"}]},{"syntax":"swift","type":"codeListing","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(V + E)."}]}],"name":"Complexity"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nontrivialStronglyConnectedComponents"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"ArraySlice","preciseIdentifier":"s:s10ArraySliceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">]"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"roleHeading":"Instance Method","symbolKind":"method","title":"nontrivialStronglyConnectedComponents()","role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF","extendedModule":"GraphProtocols","remoteSource":{"fileName":"NontrivialStronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/NontrivialStronglyConnectedComponents.swift#L89"}},"sections":[],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the","type":"text"},{"text":" ","type":"text"},{"text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in","type":"text"},{"text":" ","type":"text"},{"text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes","type":"text"},{"text":" ","type":"text"},{"text":"through both.","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/nontrivialStronglyConnectedComponents()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","preciseIdentifier":"s:s10ArraySliceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"title":"nontrivialStronglyConnectedComponents()","abstract":[{"text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the","type":"text"},{"text":" ","type":"text"},{"text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in","type":"text"},{"text":" ","type":"text"},{"text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes","type":"text"},{"text":" ","type":"text"},{"text":"through both.","type":"text"}],"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"kind":"symbol","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","abstract":[],"type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity":{"role":"collection","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","kind":"symbol","type":"topic","url":"\/documentation\/connectivity","abstract":[],"title":"Connectivity"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","abstract":[],"title":"Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind"