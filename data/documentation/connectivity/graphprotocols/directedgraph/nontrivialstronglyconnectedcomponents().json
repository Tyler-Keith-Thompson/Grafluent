{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"kind":"symbol","metadata":{"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF","symbolKind":"method","title":"nontrivialStronglyConnectedComponents()","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">]","kind":"text"}],"extendedModule":"GraphProtocols","role":"symbol","modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nontrivialStronglyConnectedComponents"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"ArraySlice","preciseIdentifier":"s:s10ArraySliceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"kind":"text","text":">]"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"successors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The components are those of "},{"type":"codeVoice","code":"stronglyConnectedComponents()"},{"type":"text","text":" without the trivial ones, in the"},{"type":"text","text":" "},{"type":"text","text":"same order, a reverse topological order: every path between two of them goes from a later"},{"type":"text","text":" "},{"type":"text","text":"one to an earlier one. Each lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Empty exactly when the"},{"type":"text","text":" "},{"type":"text","text":"graph is acyclic. Each is a slice of one shared array, as in "},{"type":"codeVoice","code":"attractingComponents()"},{"type":"text","text":", so its"},{"type":"text","text":" "},{"type":"text","text":"indices do not start at 0."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so one sort by that vertex’s"},{"type":"text","text":" "},{"type":"text","text":"position puts the components in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(C log C) for C components. On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":", where positions are insertion order:"}]},{"syntax":"swift","type":"codeListing","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(V + E).","type":"text"}]}],"type":"aside","name":"Complexity"}]}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"role":"symbol","kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"title":"Vertex","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","url":"\/documentation\/graphprotocols\/directedgraph\/vertex"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/nontrivialStronglyConnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()","title":"nontrivialStronglyConnectedComponents()","abstract":[{"text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the","type":"text"},{"text":" ","type":"text"},{"text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in","type":"text"},{"text":" ","type":"text"},{"text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes","type":"text"},{"text":" ","type":"text"},{"text":"through both.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">]","kind":"text"}],"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()","kind":"symbol","role":"symbol"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"title":"Connectivity","role":"collection","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"role":"collection","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","url":"\/documentation\/connectivity\/graphprotocols","type":"topic","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","type":"topic","kind":"symbol","title":"DirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"abstract":[]}}}