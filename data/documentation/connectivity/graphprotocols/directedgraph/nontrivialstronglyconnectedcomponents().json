{"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":">]","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"successors.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The components are those of "},{"type":"codeVoice","code":"stronglyConnectedComponents()"},{"type":"text","text":" without the trivial ones, in the"},{"type":"text","text":" "},{"type":"text","text":"same order, a reverse topological order: every path between two of them goes from a later"},{"type":"text","text":" "},{"type":"text","text":"one to an earlier one. Each lists its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Empty exactly when the"},{"type":"text","text":" "},{"type":"text","text":"graph is acyclic. Each is a slice of one shared array, as in "},{"type":"codeVoice","code":"attractingComponents()"},{"type":"text","text":", so its"},{"type":"text","text":" "},{"type":"text","text":"indices do not start at 0."}]},{"type":"paragraph","inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":", so one sort by that vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"position puts the components in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, O(C log C) for C components. On a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":", where positions are insertion order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(V + E)."}],"type":"paragraph"}],"name":"Complexity"}],"kind":"content"}],"metadata":{"remoteSource":{"fileName":"NontrivialStronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/NontrivialStronglyConnectedComponents.swift#L89"},"title":"nontrivialStronglyConnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV","text":"ArraySlice"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">]"}],"role":"symbol","roleHeading":"Instance Method","extendedModule":"GraphProtocols","symbolKind":"method","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()"},"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","abstract":[],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","title":"Vertex","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},"doc://Connectivity/documentation/Connectivity":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","url":"\/documentation\/connectivity","type":"topic","kind":"symbol","role":"collection","title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/nontrivialStronglyConnectedComponents()":{"abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"ArraySlice","kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":">]","kind":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()","kind":"symbol","title":"nontrivialStronglyConnectedComponents()"}}}