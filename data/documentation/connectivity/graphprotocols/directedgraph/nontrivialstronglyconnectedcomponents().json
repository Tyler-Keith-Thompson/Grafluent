{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the"},{"type":"text","text":" "},{"type":"text","text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in"},{"type":"text","text":" "},{"type":"text","text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes"},{"type":"text","text":" "},{"type":"text","text":"through both."}],"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"metadata":{"externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nontrivialStronglyConnectedComponents"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:s10ArraySliceV","kind":"typeIdentifier","text":"ArraySlice"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">]"}],"remoteSource":{"fileName":"NontrivialStronglyConnectedComponents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/NontrivialStronglyConnectedComponents.swift#L89"},"symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"extendedModule":"GraphProtocols","role":"symbol","title":"nontrivialStronglyConnectedComponents()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nontrivialStronglyConnectedComponents"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:s10ArraySliceV","text":"ArraySlice"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">]"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s"},{"type":"text","text":" "},{"type":"text","text":"successors."}]},{"type":"paragraph","inlineContent":[{"text":"The components are those of ","type":"text"},{"type":"codeVoice","code":"stronglyConnectedComponents()"},{"text":" without the trivial ones, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order, a reverse topological order: every path between two of them goes from a later","type":"text"},{"text":" ","type":"text"},{"text":"one to an earlier one. Each lists its vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. Empty exactly when the","type":"text"},{"text":" ","type":"text"},{"text":"graph is acyclic. Each is a slice of one shared array, as in ","type":"text"},{"type":"codeVoice","code":"attractingComponents()"},{"text":", so its","type":"text"},{"text":" ","type":"text"},{"text":"indices do not start at 0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each component’s first vertex is its earliest in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", so one sort by that vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"position puts the components in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, O(C log C) for C components. On a","type":"text"},{"text":" ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":", where positions are insertion order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(V + E)."}],"type":"paragraph"}]}]}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","type":"topic"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"type":"topic","title":"Connectivity","url":"\/documentation\/connectivity","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph/nontrivialStronglyConnectedComponents()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStro