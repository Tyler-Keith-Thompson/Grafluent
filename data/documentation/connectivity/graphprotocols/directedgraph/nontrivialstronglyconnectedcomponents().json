{"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/directedgraph\/nontrivialstronglyconnectedcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph\/nontrivialStronglyConnectedComponents()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph"]]},"sections":[],"abstract":[{"text":"The nontrivial strongly connected components: the ones that contain a cycle, which are the","type":"text"},{"text":" ","type":"text"},{"text":"components of two or more vertices and the single vertices with a self-loop. A vertex is in","type":"text"},{"text":" ","type":"text"},{"text":"one exactly when it lies on a cycle, and two vertices share one exactly when a cycle passes","type":"text"},{"text":" ","type":"text"},{"text":"through both.","type":"text"}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:s10ArraySliceV","text":"ArraySlice","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"title":"nontrivialStronglyConnectedComponents()","extendedModule":"GraphProtocols","roleHeading":"Instance Method","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/NontrivialStronglyConnectedComponents.swift#L89","fileName":"NontrivialStronglyConnectedComponents.swift"},"role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P12ConnectivityE37nontrivialStronglyConnectedComponentsSays10ArraySliceVy6VertexQzGGyF"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"nontrivialStronglyConnectedComponents","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:s10ArraySliceV","text":"ArraySlice","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Tarjan’s algorithm, one pass: a self-loop is noticed while the search reads the vertex’s"},{"type":"text","text":" "},{"type":"text","text":"successors."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The components are those of "},{"code":"stronglyConnectedComponents()","type":"codeVoice"},{"type":"text","text":" without the trivial ones, in the"},{"type":"text","text":" "},{"type":"text","text":"same order, a reverse topological order: every path between two of them goes from a later"},{"type":"text","text":" "},{"type":"text","text":"one to an earlier one. Each lists its vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. Empty exactly when the"},{"type":"text","text":" "},{"type":"text","text":"graph is acyclic. Each is a slice of one shared array, as in "},{"code":"attractingComponents()","type":"codeVoice"},{"type":"text","text":", so its"},{"type":"text","text":" "},{"type":"text","text":"indices do not start at 0."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each component’s first vertex is its earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", so one sort by that vertex’s"},{"type":"text","text":" "},{"type":"text","text":"position puts the components in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, O(C log C) for C components. On a"},{"type":"text","text":" "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":", where positions are insertion order:"}],"type":"paragraph"},{"type":"codeListing","code":["let inInsertionOrder = graph.nontrivialStronglyConnectedComponents()","    .sorted { graph.vertexPosition(of: $0.first!) < graph.vertexPosition(of: $1.first!) }"],"syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(V + E)."}]}],"style":"note","type":"aside","name":"Complexity"}],"kind":"content"}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"title":"GraphProtocols","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/DirectedGraph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}],"title":"DirectedGraph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/DirectedGraph","url":"\/documentation\/connectivity\/graphprotocols\/directedgraph","type":"topic","abstract":[],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind