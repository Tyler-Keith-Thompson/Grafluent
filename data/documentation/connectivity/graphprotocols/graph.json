ion/Connectivity/GraphProtocols/Graph/blockCutTree()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","abstract":[{"type":"text","text":"The block–cut tree: a node per block and per articulation point, and an edge between each"},{"type":"text","text":" "},{"type":"text","text":"block and each articulation point in it. A forest, one tree per connected component with an"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop."}],"kind":"symbol","title":"blockCutTree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedComponents(_:)":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedComponents(_:)","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedcomponents(_:)","abstract":[{"type":"text","text":"The k-edge-connected components: the classes of vertices joined pairwise by at least "},{"type":"codeVoice","code":"k"},{"type":"text","text":" "},{"type":"text","text":"edge-disjoint paths in the whole graph, ordered as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". Parallel edges"},{"type":"text","text":" "},{"type":"text","text":"are separate paths and self-loops count for nothing. "},{"type":"codeVoice","code":"k = 1"},{"type":"text","text":" gives the connected"},{"type":"text","text":" "},{"type":"text","text":"components and "},{"type":"codeVoice","code":"k = 2"},{"type"