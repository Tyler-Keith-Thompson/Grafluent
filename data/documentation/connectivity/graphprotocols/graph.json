{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"},"kind":"symbol","topicSections":[{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols"]]},"sections":[],"metadata":{"title":"Graph","symbolKind":"extension","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"extendedModule":"GraphProtocols","roleHeading":"Extended Protocol","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"externalID":"s:e:s:14GraphProtocols0A0P12ConnectivityE19connectedComponentsAD0E0VyAA12DirectedViewVyxGGyF","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directed"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","kind":"symbol","title":"Graph","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol","abstract":[{"text":"The articulation points: the vertices whose removal adds a connected component","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s ","type":"text"},{"type":"codeVoice","code":"articulation_points"},{"text":"; cut vertices), in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. Self-loops and parallel edges never make one. O(n + m).","type":"text"}],"title":"articulationPoints()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()"},"doc://Connectivity/documentation/Connectivity":{"kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/connectivity","title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"abstract":[{"type":"text","text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s "},{"code":"is_biconnected","type":"codeVoice"},{"type":"text","text":"): at"},{"type":"text","text":" "},{"type":"text","text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is not. Stops at the first articulation point."}],"role":"symbol","type":"topic","kind":"symbol","title":"isBiconnected","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"type":"topic","role":"symbol","abstract":[{"text":"The bi-edge-connected (2-edge-connected) components (LEMON’s ","type":"text"},{"code":"biEdgeConnectedComponents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s bridge components): the components left when every bridge is removed, ordered","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". An isolated vertex is one on its own. O(n + m).","type":"text"}],"title":"biEdgeConnectedComponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"abstract":[{"text":"The block–cut tree (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"BlockCutpointGraph"},{"text":"): a node per block and per articulation","type":"text"},{"text":" ","type":"text"},{"text":"point, and an edge between each block and each articulation point in it. A forest, one tree","type":"text"},{"text":" ","type":"text"},{"text":"per connected component with an edge that is not a self-loop. O(n + m).","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"blockCutTree()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"biconnected_components"},{"type":"text","text":"): the maximal biconnected subgraphs, as sets of edges, which they"},{"type":"text","text":" "},{"type":"text","text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their"},{"type":"text","text":" "},{"type":"text","text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,"},{"type":"text","text":" "},{"type":"text","text":"or one with only self-loops, is in no block. O(n + m)."}],"title":"biconnectedComponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","abstract":[{"type":"text","text":"The connected components (NetworkX’s, Boost’s and igraph’s "},{"type":"codeVoice","code":"connected_components"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"the order of their first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", each listing its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order. The same value as "},{"type":"codeVoice","code":"directed.weaklyConnectedComponents()"},{"type":"text","text":", computed over each edge"},{"type":"text","text":" "},{"type":"text","text":"once from flat rows ("},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"type":"text","text":"). Over a graph with vertex indices but without"},{"type":"text","text":" "},{"type":"text","text":"them it is "},{"code":"directed.weaklyConnectedComponents()","type":"codeVoice"},{"type":"text","text":": union–find over each row walked in place"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"_forEachNeighborIndex","type":"codeVoice"},{"type":"text","text":"), which a computed row (a product, a subgraph view) runs faster"},{"type":"text","text":" "},{"type":"text","text":"than copying the rows first. O(n + m α(n))."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"title":"connectedComponents()","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"type":"text","text":"): at least two vertices, connected, and no bridge. So a doubled"},{"type":"text","text":" "},{"type":"text","text":"edge is, and K₁ and K₂ are not. Stops at the first bridge."}],"role":"symbol","type":"topic","kind":"symbol","title":"isBiEdgeConnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiEdgeConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"url":"\/documentation\/connectivity\/graphprotocols","kind":"symbol","type":"topic","role":"collection","abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bridges"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The bridges: the edges whose removal adds a connected component (NetworkX’s, JGraphT’s,"},{"type":"text","text":" "},{"type":"text","text":"igraph’s and petgraph’s "},{"type":"codeVoice","code":"bridges"},{"type":"text","text":"), as positions in ascending order. A self-loop is never a"},{"type":"text","text":" "},{"type":"text","text":"bridge, and neither is any of two or more parallel edges. O(n + m)."}],"title":"bridges()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"abstract":[{"type":"text","text":"Whether the graph has a bridge (NetworkX’s "},{"type":"codeVoice","code":"has_bridges"},{"type":"text","text":"). Stops at the first one found."}],"role":"symbol","type":"topic","kind":"symbol","title":"hasBridges","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasBridges","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"url":"\/documentation\/connectivity\/graphprotocols\/graph","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[],"title":"Graph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Whether the graph has exactly one connected component; false for the empty graph, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"isWeaklyConnected"},{"type":"text","text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have"},{"type":"text","text":" "},{"type":"text","text":"succeeded. Without flat rows, as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":": "},{"type":"codeVoice","code":"directed.isWeaklyConnected"},{"type":"text","text":"."}],"title":"isConnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected"}}}