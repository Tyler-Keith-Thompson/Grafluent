ation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()"],"generated":true,"anchor":"Instance-Methods"}],"references":{"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","url":"\/documentation\/connectivity","role":"collection","abstract":[],"title":"Connectivity","kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"type":"topic","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","abstract":[{"text":"The articulation points: the vertices whose removal adds a connected component","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s ","type":"text"},{"code":"articulation_points","type":"codeVoice"},{"text":"; cut vertices), in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. Self-loops and parallel edges never make one. O(n + m).","type":"text"}],"title":"articulationPoints()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"biconnectedComponents()","abstract":[{"text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s","type":"text"},{"text":" ","type":"text"},{"code":"biconnected_components","type":"codeVoice"},{"text":"): the maximal biconnected subgraphs, as sets of edges, which they","type":"text"},{"text":" ","type":"text"},{"text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their","type":"text"},{"text":" ","type":"text"},{"text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"or one with only self-loops, is in no block. O(n + m).","type":"text"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity12BlockCutTreeV","kind":"typeIdentifier","text":"BlockCutTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The block–cut tree (JGraphT’s "},{"type":"codeVoice","code":"BlockCutpointGraph"},{"type":"text","text":"): a node per block and per articulation"},{"type":"text","text":" "},{"type":"text","text":"point, and an edge between each block and each articulation point in it. A forest, one tree"},{"type":"text","text":" "},{"type":"text","text":"per connected component with an edge that is not a self-loop. O(n + m)."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","title":"blockCutTree()","role":"symbol","kind":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directedView"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiEdgeConnected"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"type":"text","text":"): at least two vertices, connected, and no bridge. So a doubled"},{"type":"text","text":" "},{"type":"text","text":"edge is, and K₁ and K₂ are not. Stops at the first bridge."}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","title":"isBiEdgeConnected","role":"symbol","kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","role":"symbol","abstract":[{"type":"text","text":"Whether the graph has exactly one connected component; false for the empty graph, as"},{"type":"text","text":" "},{"code":"isWeaklyConnected","type":"codeVoice"},{"type":"text","text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have"},{"type":"text","text":" "},{"type":"text","text":"succeeded. Without flat rows, as "},{"code":"connectedComponents()","type":"codeVoice"},{"type":"text","text":": "},{"code":"directedView.isWeaklyConnected","type":"codeVoice"},{"type":"text","text":"."}],"title":"isConnected","kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"title":"connectedComponents()","kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","abstract":[{"type":"text","text":"The connected components (NetworkX’s, Boost’s and igraph’s "},{"code":"connected_components","type":"codeVoice"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"the order of their first vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":", each listing its vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order. The same value as "},{"code":"directedView.weaklyConnectedComponents()","type":"codeVoice"},{"type":"text","text":", computed over each edge"},{"type":"text","text":" "},{"type":"text","text":"once from flat rows ("},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"type":"text","text":"). Over a graph with vertex indices but without"},{"type":"text","text":" "},{"type":"text","text":"them it is "},{"code":"directedView.weaklyConnectedComponents()","type":"codeVoice"},{"type":"text","text":": union–find over each row walked in place"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"_forEachNeighborIndex","type":"codeVoice"},{"type":"text","text":"), which a computed row (a product, a subgraph view) runs faster"},{"type":"text","text":" "},{"type":"text","text":"than copying the rows first. O(n + m α(n))."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"type":"topic","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biEdgeConnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","abstract":[{"type":"text","text":"The bi-edge-connected (2-edge-connected) components (LEMON’s "},{"type":"codeVoice","code":"biEdgeConnectedComponents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s bridge components): the components left when every bridge is removed, ordered"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". An isolated vertex is one on its own. O(n + m)."}],"title":"biEdgeConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiconnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","abstract":[{"text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s ","type":"text"},{"code":"is_biconnected","type":"codeVoice"},{"text":"): at","type":"text"},{"text":" ","type":"text"},{"text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is not. Stops at the first articulation point.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","title":"isBiconnected","role":"symbol","type":"topic","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"type":"topic","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bridges","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","abstract":[{"type":"text","text":"The bridges: the edges whose removal adds a connected component (NetworkX’s, JGraphT’s,"},{"type":"text","text":" "},{"type":"text","text":"igraph’s and petgraph’s "},{"type":"codeVoice","code":"bridges"},{"type":"text","text":"), as positions in ascending order. A self-loop is never a"},{"type":"text","text":" "},{"type":"text","text":"bridge, and neither is any of two or more parallel edges. O(n + m)."}],"title":"bridges()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","url":"\/documentation\/connectivity\/graphprotocols","role":"collection","abstract":[],"title":"GraphProtocols","kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","url":"\/documentation\/connectivity\/graphprotocols\/graph","title":"Graph","role":"symbol","kind":"symbol","type":"topic"},"doc://Con