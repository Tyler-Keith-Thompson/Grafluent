onnectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"title":"GraphProtocols","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","type":"topic","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"kComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","kind":"symbol","abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"type":"topic","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedSubgraphs(_:)":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedSubgraphs(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kEdgeConnectedSubgraphs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"title":"kEdgeConnectedSubgraphs(_:)","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedsubgraphs(_:)","abstract":[{"text":"The k-edge-connected subgraphs: the maximal sets of vertices whose induced subgraph is","type":"text"},{"text":" ","type":"text"},{"text":"k-edge-connected (every pair joined by ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" edge-disjoint paths inside it), ordered as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"connectedComponents()"},{"text":". They partition the vertices, a vertex in none being a set alone.","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are separate paths and self-loops count for nothing. Each set is refined","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"type":"codeVoice","code":"kEdgeConnectedComponents(_:)"},{"text":" of its own induced subgraph until it is one class; at","type":"text"},{"text":" ","type":"text"},{"text":"most n refinements, each O(k n (n + m)). ","type":"text"},{"type":"codeVoice","code":"k = 1"},{"text":" gives the connected components in","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","abstract":[{"text":"The biconnected components, or blocks: the maximal biconnected subgraphs, as sets of edges,","type":"text"},{"text":" ","type":"text"},{"text":"which they partition (a self-loop is in no block). Blocks are ordered by their smallest edge","type":"text"},{"text":" ","type":"text"},{"text":"position, each listing its edges in ascending position. An isolated vertex, or one with only","type":"text"},{"text":" ","type":"text"},{"text":"self-loops, is in no block.","type":"text"}],"title":"biconnectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"title":"blockCutTree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","kind":"symbol","abstract":[{"type":"text","text":"The block–cut tree: a node per block and per articulation point, and an edge between each"},{"type":"text","text":" "},{"type":"text","text":"block and each articulation point in it. A forest, one tree per connected component with an"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"title":"connectedComponents()","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","abstract":[{"type":"text","text":"The connected components, in the order of their first vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":", each listing"},{"type":"text","text":" "},{"type":"text","text":"its vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"title":"articulationPoints()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"articulationPoints"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"role":"symbol","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","abstract":[{"type":"text","text":"The articulation points (cut vertices): the vertices whose removal adds a connected"},{"type":"text","text":" "},{"type":"text","text":"component, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one."}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","title":"isConnected","abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"isWeaklyConnected"},{"text":". Stops as soon as n − 1 joins have succeeded.","type":"text"}],"type":"topic","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedComponents(_:)":{"abstract":[{"type":"text","text":"The k-edge-connected components: the classes of vertices joined pairwise by at least "},{"code":"k","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"edge-disjoint paths in the whole graph, ordered as "},{"code":"connectedComponents()","type":"codeVoice"},{"type":"text","text":". Parallel edges"},{"type":"text","text":" "},{"type":"text","text":"are separate paths and self-loops count for nothing. "},{"code":"k = 1","type":"codeVoice"},{"type":"text","text":" gives the connected"},{"type":"text","text":" "},{"type":"text","text":"components and "},{"code":"k = 2","type":"codeVoice"},{"type":"text","text":" the bi-edge-connected ones, each in O(n + m); for larger k, at most"},{"type":"text","text":" "},{"type":"text","text":"2n unit-capacity flows, each stopped after k augmenting paths: O(k n (n + m))."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kEdgeConnectedComponents"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"kind":"symbol","type":"topic","title":"kEdgeConnectedComponents(_:)","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedComponents(_:)","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedcomponents(_:)"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bridges","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"title":"bridges()","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","abstract":[{"type":"text","text":"The bridges: the edges whose removal adds a connected component, as positions in ascending"},{"type":"text","text":" "},{"type":"text","text":"order. A self-loop is never a bridge, and neither is any of two or more parallel edges."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","url":"\/documentation\/connectivity","type":"topic","abstract":[],"kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasBridges","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"hasBridges","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","kind":"symbol","abstract":[{"text":"Whether the graph has a bridge. Stops at the first one found.","type":"text"}],"type":"topic","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"title":"isBiconnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","type":"topic","abstract":[{"type":"text","text":"Whether the graph is biconnected: at least two vertices, connected, and no articulation"},{"type":"text","text":" "},{"type":"text","text":"point. So K₂ is, and a graph with an isolated vertex is not. Stops at the first articulation"},{"type":"text","text":" "},{"type":"text","text":"point."}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isBiEdgeConnected","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","kind":"symbol","abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected): at least two vertices,","type":"text"},{"text":" ","type":"text"},{"text":"connected, and no bridge. So a doubled edge is, and K₁ and K₂ are not. Stops at the first","type":"text"},{"text":" ","type":"text"},{"text":"bridge.","type":"text"}],"type":"topic","role":"symbol"}}}