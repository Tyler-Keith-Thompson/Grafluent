onents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","title":"kComponents()","abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as for","type":"text"},{"text":" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":". Stops as soon as n − 1 joins have succeeded.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","type":"topic","title":"isConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"title":"biEdgeConnectedComponents()","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"abstract":[{"type":"text","text":"The bi-edge-connected (2-edge-connected) components: the components left when every bridge"},{"type":"text","text":" "},{"type":"text","text":"is removed, ordered as "},{"code":"connectedComponents()","type":"codeVoice"},{"type":"text","text":". An isolated vertex is one on its own."}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","kind":"symbol","abstract":[{"type":"text","text":"The biconnected components, or blocks: the maximal biconnected subgraphs, as sets of edges,"},{"type":"text","text":" "},{"type":"text","text":"which they partition (a self-loop is in no block). Blocks are ordered by their smallest edge"},{"type":"text","text":" "},{"type":"text","text":"position, each listing its edges in ascending position. An isolated vertex, or one with only"},{"type":"text","text":" "},{"type":"text","text":"self-loops, is in no block."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","title":"biconnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedSubgraphs(_:)":{"title":"kEdgeConnectedSubgraphs(_:)","role":"symbol","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedsubgraphs(_:)","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedSubgraphs(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kEdgeConnectedSubgraphs"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"abstract":[{"type":"text","text":"The k-edge-connected subgraphs: the maximal sets of vertices whose induced subgraph is"},{"type":"text","text":" "},{"type":"text","text":"k-edge-connected (every pair joined by "},{"type":"codeVoice","code":"k"},{"type":"text","text":" edge-disjoint paths inside it), ordered as"},{"type":"text","text":" "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". They partition the vertices, a vertex in none being a set alone."},{"type":"text","text":" "},{"type":"text","text":"Parallel edges are separate paths and self-loops count for nothing. Each set is refined"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"kEdgeConnectedComponents(_:)"},{"type":"text","text":" of its own induced subgraph until it is one class; at"},{"type":"text","text":" "},{"type":"text","text":"most n refinements, each O(k n (n + m)). "},{"type":"codeVoice","code":"k = 1"},{"type":"text","text":" gives the connected components in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}]},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic","url":"\/documentation\/connectivity","role":"collection","title":"Connectivity","kind":"symbol","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","kind":"symbol","abstract":[{"text":"The block–cut tree: a node per block and per articulation point, and an edge between each","type":"text"},{"text":" ","type":"text"},{"text":"block and each articulation point in it. A forest, one tree per connected component with an","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","title":"blockCutTree()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","kind":"symbol","abstract":[{"type":"text","text":"Whether the graph is biconnected: at least two vertices, connected, and no articulation"},{"type":"text","text":" "},{"type":"text","text":"point. So K₂ is, and a graph with an isolated vertex is not. Stops at the first articulation"},{"type":"text","text":" "},{"type":"text","text":"point."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","type":"topic","title":"isBiconnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiEdgeConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"isBiEdgeConnected","kind":"symbol","abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected): at least two vertices,","type":"text"},{"text":" ","type":"text"},{"text":"connected, and no bridge. So a doubled edge is, and K₁ and K₂ are not. Stops at the first","type":"text"},{"text":" ","type":"text"},{"text":"bridge.","type":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","abstract":[{"type":"text","text":"The bridges: the edges whose removal adds a connected component, as positions in ascending"},{"type":"text","text":" "},{"type":"text","text":"order. A self-loop is never a bridge, and neither is any of two or more parallel edges."}],"kind":"symbol","title":"bridges()","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bridges"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typ