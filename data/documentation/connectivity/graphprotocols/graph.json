s","type":"text"},{"text":" ","type":"text"},{"text":"are separate paths and self-loops count for nothing. ","type":"text"},{"code":"k = 1","type":"codeVoice"},{"text":" gives the connected","type":"text"},{"text":" ","type":"text"},{"text":"components and ","type":"text"},{"code":"k = 2","type":"codeVoice"},{"text":" the bi-edge-connected ones, each in O(n + m); for larger k, at most","type":"text"},{"text":" ","type":"text"},{"text":"2n unit-capacity flows, each stopped after k augmenting paths: O(k n (n + m)).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedComponents(_:)","title":"kEdgeConnectedComponents(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kEdgeConnectedComponents"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"title":"biEdgeConnectedComponents()","type":"topic","role":"symbol","abstract":[{"text":"The bi-edge-connected (2-edge-connected) components: the components left when every bridge","type":"text"},{"text":" ","type":"text"},{"text":"is removed, ordered as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". An isolated vertex is one on its own.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"title":"blockCutTree()","role":"symbol","abstract":[{"type":"text","text":"The block–cut tree: a node per block and per articulation point, and an edge between each"},{"type":"text","text":" "},{"type":"text","text":"block and each articulation point in it. A forest, one tree per connected component with an"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop."}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","title":"hasBridges","role":"symbol","abstract":[{"type":"text","text":"Whether the graph has a bridge. Stops at the first one found."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"role":"symbol","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","title":"isConnected","kind":"symbol","abstract":[{"type":"text","text":"Whether the graph has exactly one connected component; false for the empty graph, as for"},{"type":"text","text":" "},{"code":"isWeaklyConnected","type":"codeVoice"},{"type":"text","text":". Stops as soon as n − 1 joins have succeeded."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"url":"\/documentation\/connectivity\/graphprotocols\/graph","title":"Graph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"abstract":[],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","abstract":[{"type":"text","text":"The connected components, in the order of their first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", each listing"},{"type":"text","text":" "},{"type":"text","text":"its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}],"title":"connectedComponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","title":"kComponents()","role":"symbol","abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"articulationPoints"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"type":"topic","title":"articulationPoints()","role":"symbol","abstract":[{"type":"text","text":"The articulation points (cut vertices): the vertices whose removal adds a connected"},{"type":"text","text":" "},{"type":"text","text":"component, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","type":"topic","role":"collection","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols","kind":"symbol"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/connectivity","title":"Connectivity","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedSubgraphs(_:)":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedsubgraphs(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kEdgeConnectedSubgraphs"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"title":"kEdgeConnectedSubgraphs(_:)","type":"topic","role":"symbol","abstract":[{"text":"The k-edge-connected subgraphs: the maximal sets of vertices whose induced subgraph is","type":"text"},{"text":" ","type":"text"},{"text":"k-edge-connected (every pair joined by ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" edge-disjoint paths inside it), ordered as","type":"text"},{"text":" ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". They partition the vertices, a vertex in none being a set alone.","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are separate paths and self-loops count for nothing. Each set is refined","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"kEdgeConnectedComponents(_:)","type":"codeVoice"},{"text":" of its own induced subgraph until it is one class; at","type":"text"},{"text":" ","type":"text"},{"text":"most n refinements, each O(k n (n + m)). ","type":"text"},{"code":"k = 1","type":"codeVoice"},{"text":" gives the connected components in","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedSubgraphs(_:)"}}}