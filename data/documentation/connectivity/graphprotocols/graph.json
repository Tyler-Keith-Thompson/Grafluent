":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"kind":"symbol","title":"Graph","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","kind":"symbol","abstract":[],"type":"topic","title":"Connectivity","url":"\/documentation\/connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiEdgeConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"is_k_edge_connected(G, 2)","type":"codeVoice"},{"text":"): at least two vertices, connected, and no bridge. So a doubled","type":"text"},{"text":" ","type":"text"},{"text":"edge is, and K₁ and K₂ are not. Stops at the first bridge.","type":"text"}],"kind":"symbol","title":"isBiEdgeConnected","role":"symbol"},"doc://Connectivity/