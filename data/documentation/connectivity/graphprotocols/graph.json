xt":" ","type":"text"},{"text":"is removed, ordered as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". An isolated vertex is one on its own.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","type":"topic","title":"biEdgeConnectedComponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"title":"articulationPoints()","abstract":[{"type":"text","text":"The articulation points (cut vertices): the vertices whose removal adds a connected"},{"type":"text","text":" "},{"type":"text","text":"component, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. Self-loops and parallel edges never make one."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()"},"doc://Connectivity/documenta