e":"text"},{"type":"codeVoice","code":"k = 2"},{"text":" the bi-edge-connected ones, each in O(n + m); for larger k, at most","type":"text"},{"text":" ","type":"text"},{"text":"2n unit-capacity flows, each stopped after k augmenting paths: O(k n (n + m)).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kEdgeConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"type":"topic","title":"hasBridges","abstract":[{"text":"Whether the graph has a bridge. Stops at the first one found.","type":"text"}],"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected): at least two vertices,"},{"type":"text","text":" "},{"type":"text","text":"connected, and no bridge. So a doubled edge is, and K₁ and K₂ are not. Stops at the first"},{"type":"text","text":" "},{"type":"text","text":"bridge."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","title":"isBiEdgeConnected","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","type":"topic"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","url":"\/documentation\/connectivity","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"title":"isBiconnected","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","abstract":[{"type":"text","text":"Whether the graph is biconnected: at least two vertices, connected, and no articulation"},{"type":"text","text":" "},{"type":"text","text":"point. So K₂ is, and a graph with an isolated vertex is not. Stops at the first articulation"},{"type":"text","text":" "},{"type":"text","text":"point."}],"type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","role":"symbol","abstract":[{"type":"text","text":"Whether the graph has exactly one connected component; false for the empty graph, as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"isWeaklyConnected"},{"type":"text","text":". Stops as soon as n − 1 joins have succeeded."}],"title":"isConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"title":"articulationPoints()","kind":"symbol","abstract":[{"text":"The articulation points (cut vertices): the vertices whose removal adds a connected","type":"text"},{"text":" ","type":"text"},{"text":"component, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. Self-loops and parallel edges never make one.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()"}}}