kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"kind":"symbol","abstract":[{"type":"text","text":"The articulation points: the vertices whose removal adds a connected component"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s "},{"type":"codeVoice","code":"articulation_points"},{"type":"text","text":"; cut vertices), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one. O(n + m)."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","type":"topic","role":"symbol","title":"articulationPoints()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","kind":"symbol","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"is_k_edge_connected(G, 2)","type":"codeVoice"},{"text":"): at least two vertices, connected, and no bridge. So a doubled","type":"text"},{"text":" ","type":"text"},{"text":"edge is, and K₁ and K₂ are not. Stops at the first bridge.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"isBiEdgeConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"role":"symbol","kind":"symbol","title":"biconnectedComponents()","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"biconnected_components"},{"text":"): the maximal biconnected subgraphs, as sets of edges, which they","type":"text"},{"text":" ","type":"text"},{"text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their","type":"text"},{"text":" ","type":"text"},{"text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"or one with only self-loops, is in no block. O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"role":"symbol","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","type":"topic","title":"blockCutTree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"text":"The block–cut tree (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"BlockCutpointGraph"},{"text":"): a node per block and per articulation","type":"text"},{"text":" ","type":"text"},{"text":"point, and an edge between each block and each articulation point in it. A forest, one tree","type":"text"},{"text":" ","type":"text"},{"text":"per connected component with an edge that is not a self-loop. O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","kind":"symbol","url":"\/documentation\/connectivity","role":"collection","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as","type":"text"},{"text":" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have","type":"text"},{"text":" ","type":"text"},{"text":"succeeded. Without flat rows, as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":": ","type":"text"},{"code":"directed.isWeaklyConnected","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","title":"isConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","abstract":[{"text":"The connected components (NetworkX’s, Boost’s and igraph’s ","type":"text"},{"code":"connected_components","type":"codeVoice"},{"text":"): in","type":"text"},{"text":" ","type":"text"},{"text":"the order of their first vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", each listing its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order. The same value as ","type":"text"},{"code":"directed.weaklyConnectedComponents()","type":"codeVoice"},{"text":", computed over each edge","type":"text"},{"text":" ","type":"text"},{"text":"once from flat rows (","type":"text"},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"text":"). Over a graph with vertex indices but without","type":"text"},{"text":" ","type":"text"},{"text":"them it is ","type":"text"},{"code":"directed.weaklyConnectedComponents()","type":"codeVoice"},{"text":": union–find over each row walked in place","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"_forEachNeighborIndex","type":"codeVoice"},{"text":"), which a computed row (a product, a subgraph view) runs faster","type":"text"},{"text":" ","type":"text"},{"text":"than copying the rows first. O(n + m α(n)).","type":"text"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","title":"connectedComponents()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","title":"Graph","url":"\/documentation\/graphprotocols\/graph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"title":"Graph","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"role":"collection","url":"\/documentation\/connectivity\/graphprotocols","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","kind":"symbol","title":"GraphProtocols","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"role":"symbol","type":"topic","title":"biEdgeConnectedComponents()","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"abstract":[{"text":"The bi-edge-connected (2-edge-connected) components (LEMON’s ","type":"text"},{"code":"biEdgeConnectedComponents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s bridge components): the components left when every bridge is removed, ordered","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". An isolated vertex is one on its own. O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","type":"topic","abstract":[{"text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s ","type":"text"},{"code":"is_biconnected","type":"codeVoice"},{"text":"): at","type":"text"},{"text":" ","type":"text"},{"text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is not. Stops at the first articulation point.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","title":"isBiconnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasBridges","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","abstract":[{"type":"text","text":"Whether the graph has a bridge (NetworkX’s "},{"type":"codeVoice","code":"has_bridges"},{"type":"text","text":"). Stops at the first one found."}],"type":"topic","role":"symbol","title":"hasBridges","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges"}}}