" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have","type":"text"},{"text":" ","type":"text"},{"text":"succeeded. Without flat rows, as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":": ","type":"text"},{"code":"directed.isWeaklyConnected","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","title":"isConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"role":"symbol","abstract":[],"kind":"symbol","type":"topic","title":"Graph","url":"\/documentation\/connectivity\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"kind":"symbol","title":"blockCutTree()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","abstract":[{"type":"text","text":"The block–cut tree (JGraphT’s "},{"type":"codeVoice","code":"BlockCutpointGraph"},{"type":"text","text":"): a node per block and per articulation"},{"type":"text","text":" "},{"type":"text","text":"point, and an edge between each block and each articulation point in it. A forest, one tree"},{"type":"text","text":" "},{"type":"text","text":"per connected component with an edge that is not a self-loop. O(n + m)."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","title":"hasBridges","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","abstract":[{"type":"text","text":"Whether the graph has a bridge (NetworkX’s "},{"type":"codeVoice","code":"has_bridges"},{"type":"text","text":"). Stops at the first one found."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"kind":"symbol","title":"bridges()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","abstract":[{"type":"text","text":"The bridges: the edges whose removal adds a connected component (NetworkX’s, JGraphT’s,"},{"type":"text","text":" "},{"type":"text","text":"igraph’s and petgraph’s "},{"type":"codeVoice","code":"bridges"},{"type":"text","text":"), as positions in ascending order. A self-loop is never a"},{"type":"text","text":" "},{"type":"text","text":"bridge, and neither is any of two or more parallel edges. O(n + m)."}],"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bridges","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","kind":"symbol","type":"topic","title":"biconnectedComponents()","abstract":[{"type":"text","text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"biconnected_components"},{"type":"text","text":"): the maximal biconnected subgraphs, as sets of edges, which they"},{"type":"text","text":" "},{"type":"text","text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their"},{"type":"text","text":" "},{"type":"text","text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,"},{"type":"text","text":" "},{"type":"text","text":"or one with only self-loops, is in no block. O(n + m)."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","text":"BiconnectedComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphPro