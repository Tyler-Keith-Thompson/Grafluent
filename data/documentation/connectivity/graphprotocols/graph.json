onnectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","kind":"symbol","title":"biconnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The biconnected components, or blocks: the maximal biconnected subgraphs, as sets of edges,"},{"type":"text","text":" "},{"type":"text","text":"which they partition (a self-loop is in no block). Blocks are ordered by their smallest edge"},{"type":"text","text":" "},{"type":"text","text":"position, each listing its edges in ascending position. An isolated vertex, or one with only"},{"type":"text","text":" "},{"type":"text","text":"self-loops, is in no block."}],"type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","title":"bridges()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","kind":"symbol","abstract":[{"text":"The bridges: the edges whose removal adds a connected component, as positions in ascending","type":"text"},{"text":" ","type":"text"},{"text":"order. A self-loop is never a bridge, and neither is any of two or more parallel edges.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bridges","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeI