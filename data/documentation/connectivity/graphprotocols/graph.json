rtition the vertices, a vertex in none being a set alone."},{"type":"text","text":" "},{"type":"text","text":"Parallel edges are separate paths and self-loops count for nothing. Each set is refined"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"kEdgeConnectedComponents(_:)"},{"type":"text","text":" of its own induced subgraph until it is one class; at"},{"type":"text","text":" "},{"type":"text","text":"most n refinements, each O(k n (n + m)). "},{"type":"codeVoice","code":"k = 1"},{"type":"text","text":" gives the connected components in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"title":"kEdgeConnectedSubgraphs(_:)","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedSubgraphs(_:)","kind":"symbol","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected): at least two vertices,"},{"type":"text","text":" "},{"type":"text","text":"connected, and no bridge. So a doubled edge is, and K₁ and K₂ are not. Stops at the first"},{"type":"text","text":" "},{"type":"text","text":"bridge."}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","type":"topic","title":"isBiEdgeConnected"},"doc://Connectivity/documentation/Connectivity":{"role":"collection","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","kind":"symbol","type":"topic","url":"\/documentation\/connectivity","abstract":[],"title":"Connectivity"},"doc://Connectivity/documentation