dges,","type":"text"},{"text":" ","type":"text"},{"text":"which they partition (a self-loop is in no block). Blocks are ordered by their smallest edge","type":"text"},{"text":" ","type":"text"},{"text":"position, each listing its edges in ascending position. An isolated vertex, or one with only","type":"text"},{"text":" ","type":"text"},{"text":"self-loops, is in no block.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","title":"biconnectedComponents()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","text":"BiconnectedComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"isBiconnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","title":"isBiconnected","role":"symbol","abstract":[{"text":"Whether the graph is biconnected: at least two vertices, connected, and no articulation","type":"text"},{"text":" ","type":"text"},{"text":"point. So K₂ is, and a graph with an isolated vertex is not. Stops at the first articulation","type":"text"},{"text":" ","type":"text"},{"text":"point.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","fragments":[{"text":"fu