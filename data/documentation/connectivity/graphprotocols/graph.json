text":"edge-disjoint paths in the whole graph, ordered as "},{"code":"connectedComponents()","type":"codeVoice"},{"type":"text","text":". Parallel edges"},{"text":" ","type":"text"},{"text":"are separate paths and self-loops count for nothing. ","type":"text"},{"code":"k = 1","type":"codeVoice"},{"text":" gives the connected","type":"text"},{"text":" ","type":"text"},{"text":"components and ","type":"text"},{"code":"k = 2","type":"codeVoice"},{"type":"text","text":" the bi-edge-connected ones, each in O(n + m); for larger k, at most"},{"type":"text","text":" "},{"type":"text","text":"2n unit-capacity flows, each stopped after k augmenting paths: O(k n (n + m))."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","kind":"symbol","abstract":[{"type":"text","text":"Whether the graph has a bridge. Stops at the first one found."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","type":"topic","title":"hasBridges"}}}