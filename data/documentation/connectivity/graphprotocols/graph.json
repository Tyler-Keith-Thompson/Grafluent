>>"}],"type":"topic","title":"kEdgeConnectedComponents(_:)","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedComponents(_:)","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedcomponents(_:)"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"title":"bridges()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bridges","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"type":"topic","kind":"symbol","abstract":[{"text":"The bridges: the edges whose removal adds a connected component, as positions in ascending","type":"text"},{"text":" ","type":"text"},{"text":"order. A self-loop is never a bridge, and neither is any of two or more parallel edges.","type":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"role":"symbol","abstract":[{"type":"text","text":"Whether the graph has exactly one connected component; false for the empty graph, as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"isWeaklyConnected"},{"type":"text","text":". Stops as soon as n − 1 joins have succeeded."}],"kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProto