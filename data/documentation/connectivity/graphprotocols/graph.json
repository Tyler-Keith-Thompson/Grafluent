text":"bridge, and neither is any of two or more parallel edges. O(n + m).","type":"text"}],"type":"topic","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","title":"isConnected","type":"topic","abstract":[{"type":"text","text":"Whether the graph has exactly one connected component; false for the empty graph, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"isWeaklyConnected"},{"type":"text","text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have"},{"type":"text","text":" "},{"type":"text","text":"succeeded."}],"kind":"symbol","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","kind":"symbol","role":"symbol","abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"is_k_edge_connected(G, 2)","type":"codeVoice"},{"text":"): at least two vertices, connected, and no bridge. So a doubled","type":"text"},{"text":" ","type":"text"},{"text":"edge is, and K₁ and K₂ are not. Stops at the first bridge.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"isBiEdgeConnected","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","type":"topic"}}}