","text":"Graph"}],"modules":[{"name":"Connectivity","relatedModules":["GraphProtocols"]}],"externalID":"s:e:s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","title":"Graph","roleHeading":"Extended Protocol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}]}]}],"kind":"symbol","references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","type":"topic","title":"connectedComponents()","abstract":[{"text":"The connected components, in the order of their first vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":", each listing","type":"text"},{"text":" ","type":"text"},{"text":"its vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedSubgraphs(_:)":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedSubgraphs(_:)","abstract":[{"text":"The k-edge-connected subgraphs: the maximal sets of vertices whose induced subgraph is","type":"text"},{"text":" ","type":"text"},{"text":"k-edge-connected (every pair joined by ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" edge-disjoint paths inside it), ordered as","type":"text"},{"text":" ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". They partition the vertices, a vertex in none being a set alone.","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are separate paths and self-loops count for nothing. Each set is refined","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"kEdgeConnectedComponents(_:)","type":"codeVoice"},{"text":" of its own induced subgraph until it is one class; at","type":"text"},{"text":" ","type":"text"},{"text":"most n refinements, each O(k n (n + m)). ","type":"text"},{"code":"k = 1","type":"codeVoice"},{"text":" gives the connected components in","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedsubgraphs(_:)","type":"topic","kind":"symbol","role":"symbol","title":"kEdgeConnectedSubgraphs(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kEdgeConnectedSubgraphs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","type":"topic","title":"blockCutTree()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","abstract":[{"type":"text","text":"The block–cut tree: a node per block and per articulation point, and an edge between each"},{"type":"text","text":" "},{"type":"text","text":"block and each articulation point in it. A forest, one tree per connected component with an"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop."}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","title":"isConnected","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as for","type":"text"},{"text":" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":". Stops as soon as n − 1 joins have succeeded.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"title":"biEdgeConnectedComponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","abstract":[{"type":"text","text":"The bi-edge-connected (2-edge-connected) components: the components left when every bridge"},{"type":"text","text":" "},{"type":"text","text":"is removed, ordered as "},{"code":"connectedComponents()","type":"codeVoice"},{"type":"text","text":". An isolated vertex is one on its own."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","type":"topic","kind":"symbol","role":"symbol","title":"kComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"url":"\/documentation\/connectivity\/graphprotocols\/graph","title":"Graph","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","role":"symbol","title":"biconnectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","text":"BiconnectedComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","type":"topic","abstract":[{"text":"The biconnected components, or blocks: the maximal biconnected subgraphs, as sets of edges,","type":"text"},{"text":" ","type":"text"},{"text":"which they partition (a self-loop is in no block). Blocks are ordered by their smallest edge","type":"text"},{"text":" ","type":"text"},{"text":"position, each listing its edges in ascending position. An isolated vertex, or one with only","type":"text"},{"text":" ","type":"text"},{"text":"self-loops, is in no block.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","title":"Graph","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"title":"hasBridges","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasBridges","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","abstract":[{"type":"text","text":"Whether the graph has a bridge. Stops at the first one found."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected): at least two vertices,","type":"text"},{"text":" ","type":"text"},{"text":"connected, and no bridge. So a doubled edge is, and K₁ and K₂ are not. Stops at the first","type":"text"},{"text":" ","type":"text"},{"text":"bridge.","type":"text"}],"kind":"symbol","type":"topic","title":"isBiEdgeConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiEdgeConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","abstract":[{"type":"text","text":"The bridges: the edges whose removal adds a connected component, as positions in ascending"},{"type":"text","text":" "},{"type":"text","text":"order. A self-loop is never a bridge, and neither is any of two or more parallel edges."}],"kind":"symbol","type":"topic","title":"bridges()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bridges"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":"]"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","url":"\/documentation\/connectivity","type":"topic","kind":"symbol","role":"collection","title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"abstract":[{"type":"text","text":"Whether the graph is biconnected: at least two vertices, connected, and no articulation"},{"type":"text","text":" "},{"type":"text","text":"point. So K₂ is, and a graph with an isolated vertex is not. Stops at the first articulation"},{"type":"text","text":" "},{"type":"text","text":"point."}],"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"kind":"symbol","title":"isBiconnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedComponents(_:)":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedComponents(_:)","role":"symbol","title":"kEdgeConnectedComponents(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kEdgeConnectedComponents"},{"kind":"text","text":"("},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier","text":"Components"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedcomponents(_:)","type":"topic","abstract":[{"text":"The k-edge-connected components: the classes of vertices joined pairwise by at least ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" ","type":"text"},{"text":"edge-disjoint paths in the whole graph, ordered as ","type":"text"},{"type":"codeVoice","code":"connectedComponents()"},{"text":". Parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"are separate paths and self-loops count for nothing. ","type":"text"},{"type":"codeVoice","code":"k = 1"},{"text":" gives the connected","type":"text"},{"text":" ","type":"text"},{"text":"components and ","type":"text"},{"type":"codeVoice","code":"k = 2"},{"text":" the bi-edge-connected ones, each in O(n + m); for larger k, at most","type":"text"},{"text":" ","type":"text"},{"text":"2n unit-capacity flows, each stopped after k augmenting paths: O(k n (n + m)).","type":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"abstract":[{"type":"text","text":"The articulation points (cut vertices): the vertices whose removal adds a connected"},{"type":"text","text":" "},{"type":"text","text":"component, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","role":"symbol","title":"articulationPoints()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","type":"topic","kind":"symbol"}}}