n\/Connectivity\/GraphProtocols","type":"topic","title":"GraphProtocols","url":"\/documentation\/connectivity\/graphprotocols","kind":"symbol","role":"collection","abstract":[]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"title":"hasBridges","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","abstract":[{"type":"text","text":"Whether the graph has a bridge (NetworkX’s "},{"type":"codeVoice","code":"has_bridges"},{"type":"text","text":"). Stops at the first one found."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"type":"topic","abstract":[{"type":"text","text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s"},{"type":"text","text":" "},{"code":"biconnected_components","type":"codeVoice"},{"type":"text","text":"): the maximal biconnected subgraphs, as sets of edges, which they"},{"type":"text","text":" "},{"type":"text","text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their"},{"text":" ","type":"text"},{"text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"or one with only self-loops, is in no block. O(n + m).","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","kind":"typeIdentifier","text":"BiconnectedComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","title":"biconnectedComponents()","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"type":"topic","title":"isBiEdgeConnected","abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"type":"text","text":"): at least two vertices, connected, and no bridge. So a doubled"},{"type":"text","text":" "},{"type":"text","text":"edge is, and K₁ and K₂ are not. Stops at the first bridge."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdg