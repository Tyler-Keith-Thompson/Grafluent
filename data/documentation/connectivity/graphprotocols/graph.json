GraphProtocols/Graph/articulationPoints()":{"title":"articulationPoints()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","abstract":[{"type":"text","text":"The articulation points: the vertices whose removal adds a connected component"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s "},{"type":"codeVoice","code":"articulation_points"},{"type":"text","text":"; cut vertices), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one. O(n + m)."}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://Connectivity/documentation/Connectivity":{"url":"\/documentation\/connectivity","title":"Connectivity","kind":"symbol","role":"collection","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"type":"topic","title":"biconnectedComponents()","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","kind":"symbol","abstract":[{"type":"text","text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"biconnected_components"},{"type":"text","text":"): the maximal biconnected subgraphs, as sets of edges, which they"},{"type":"text","text":" "},{"type":"text","text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their"},{"type":"text","text":" "},{"type":"text","text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,"},{"type":"text","text":" "},{"type":"text","text":"or one with only self-loops, is in no block. O(n + m)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"title":"isBiEdgeConnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"type":"text","text":"): at least two vertices, connected, and no bridge. So a doubled"},{"type":"text","text":" "},{"type":"text","text":"edge is, and K₁ and K₂ are not. Stops at the first bridge."}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"title":"isConnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as","type":"text"},{"text":" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have","type":"text"},{"text":" ","type":"text"},{"text":"succeeded.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"type":"topic","title":"biEdgeConnectedComponents()","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","kind":"symbol","abstract":[{"text":"The bi-edge-connected (2-edge-connected) components (LEMON’s ","type":"text"},{"type":"codeVoice","code":"biEdgeConnectedComponents"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s bridge components): the components left when every bridge is removed, ordered","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"type":"codeVoice","code":"connectedComponents()"},{"text":". An isolated vertex is one on its own. O(n + m).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"te