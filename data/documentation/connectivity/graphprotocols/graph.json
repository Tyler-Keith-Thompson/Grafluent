phs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","abstract":[{"text":"The articulation points (cut vertices): the vertices whose removal adds a connected","type":"text"},{"text":" ","type":"text"},{"text":"component, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. Self-loops and parallel edges never make one.","type":"text"}],"role":"symbol","kind":"symbol","title":"articulationPoints()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"articulationPoints"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"role":"symbol","title":"Graph","type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":