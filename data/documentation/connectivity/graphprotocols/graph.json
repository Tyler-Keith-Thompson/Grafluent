).","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","title":"articulationPoints()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bridges"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]"}],"role":"symbol","abstract":[{"type":"text","text":"The bridges: the edges whose removal adds a connected component (NetworkX’s, JGraphT’s,"},{"type":"text","text":" "},{"type":"text","text":"igraph’s and petgraph’s "},{"code":"bridges","type":"codeVoice"},{"type":"text","text":"), as positions in ascending order. A self-loop is never a"},{"type":"text","text":" "},{"type":"text","text":"bridge, and neither is any of two or more parallel edges. O(n + m)."}],"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","title":"bridges()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"type":"text","text":"): at least two vertices, connected, and no bridge. So a doubled"},{"type":"text","text":" "},{"type":"text","text":"edge is, and K₁ and K₂ are not. Stops at the first bridge."}],"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","type":"topic","title":"isBiEdgeConnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol"}}}