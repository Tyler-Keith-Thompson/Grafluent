tocols\/graph\/articulationpoints()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","abstract":[{"type":"text","text":"The articulation points: the vertices whose removal adds a connected component"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s "},{"code":"articulation_points","type":"codeVoice"},{"type":"text","text":"; cut vertices), in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. Self-loops and parallel edges never make one. O(n + m)."}],"kind":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"type":"topic","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directedView","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"kind":"symbol","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","role":"collection","url":"\/documentation\/connectivity","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","title":"biEdgeConnectedComponents()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","abstract":[{"type":"text","text":"The bi-edge-connected (2-edge-connected) components (LEMON’s "},{"type":"codeVoice","code":"biEdgeConnectedComponents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s bridge components): the components left when every bridge is removed, ordered"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". An isolated vertex is one on its own. O(n + m)."}],"type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as","type":"text"},{"text":" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have","type":"text"},{"text":" ","type":"text"},{"text":"succeeded. Without flat rows, as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":": ","type":"text"},{"code":"directedView.isWeaklyConnected","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"isConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"title":"Graph"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"isBiconnected","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","abstract":[{"type":"text","text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s "},{"type":"codeVoice","code":"is_biconnected"},{"type":"text","text":"): at"},{"type":"text","text":" "},{"type":"text","text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an"},{"type":"text","text":" "},{"text":"isolated vertex is not. Stops at the first articulation point.","type":"text"}],"kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","title":"GraphProtocols"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","title":"biconnectedComponents()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","text":"BiconnectedComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","abstract":[{"text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s","type":"text"},{"text":" ","type":"text"},{"code":"biconnected_components","type":"codeVoice"},{"text":"): the maximal biconnected subgraphs, as sets of edges, which they","type":"text"},{"text":" ","type":"text"},{"text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their","type":"text"},{"text":" ","type":"text"},{"text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"or one with only self-loops, is in no block. O(n + m).","type":"text"}],"type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"title":"connectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","abstract":[{"text":"The connected components (NetworkX’s, Boost’s and igraph’s ","type":"text"},{"code":"connected_components","type":"codeVoice"},{"text":"): in","type":"text"},{"text":" ","type":"text"},{"text":"the order of their first vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"type":"text","text":", each listing its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order. The same value as "},{"type":"codeVoice","code":"directedView.weaklyConnectedComponents()"},{"type":"text","text":", computed over each edge"},{"type":"text","text":" "},{"type":"text","text":"once from flat rows ("},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"type":"text","text":"). Over a graph with vertex indices but without"},{"type":"text","text":" "},{"type":"text","text":"them it is "},{"type":"codeVoice","code":"directedView.weaklyConnectedComponents()"},{"type":"text","text":": union–find over each row walked in place"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"_forEachNeighborIndex"},{"type":"text","text":"), which a computed row (a product, a subgraph view) runs faster"},{"type":"text","text":" "},{"type":"text","text":"than copying the rows first. O(n + m α(n))."}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","abstract":[{"text":"The bridges: the edges whose removal adds a connected component (NetworkX’s, JGraphT’s,","type":"text"},{"text":" ","type":"text"},{"text":"igraph’s and petgraph’s ","type":"text"},{"code":"bridges","type":"codeVoice"},{"text":"), as positions in ascending order. A self-loop is never a","type":"text"},{"text":" ","type":"text"},{"text":"bridge, and neither is any of two or more parallel edges. O(n + m).","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bridges"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}],"title":"bridges()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","title":"hasBridges","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","type":"topic","abstract":[{"text":"Whether the graph has a bridge (NetworkX’s ","type":"text"},{"code":"has_bridges","type":"codeVoice"},{"text":"). Stops at the first one found.","type":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","abstract":[{"text":"The block–cut tree (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"BlockCutpointGraph"},{"text":"): a node per block and per articulation","type":"text"},{"text":" ","type":"text"},{"text":"point, and an edge between each block and each articulation point in it. A forest, one tree","type":"text"},{"text":" ","type":"text"},{"text":"per connected component with an edge that is not a self-loop. O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"blockCutTree()"}}}