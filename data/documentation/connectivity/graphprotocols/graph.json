ntifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","kind":"symbol","abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected): at least two vertices,"},{"type":"text","text":" "},{"type":"text","text":"connected, and no bridge. So a doubled edge is, and K₁ and K₂ are not. Stops at the first"},{"type":"text","text":" "},{"type":"text","text":"bridge."}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"isBiEdgeConnected","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"title":"biEdgeConnectedComponents()","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"abstract":[{"type":"text","text":"The bi-edge-connected (2-edge-connected) components: the components left when every bridge"},{"type":"text","text":" "},{"type":"text","text":"is removed, ordered as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". An isolated vertex is one on its own."}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","kind":"symbol","abstract":[{"text":"The block–cut tree: a node per block and per articulation point, and an edge between each","type":"text"},{"text":" ","type":"text"},{"text":"block and each articulation point in it. A forest, one tree per connected component with an","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop.","type":"text"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"blockCutTree()","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","kind":"symbol","abstract":[{"text":"Whether the graph has a bridge. Stops at the first one found.","type":"text"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasBridges","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"hasBridges","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"title":"connectedComponents()","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"abstract":[{"text":"The connected components, in the order of their first vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", each listing","type":"text"},{"text":" ","type":"text"},{"text":"its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"type":"topic","url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"title":"Graph","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"title":"biconnectedComponents()","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"The biconnected components, or blocks: the maximal biconnected subgraphs, as sets of edges,","type":"text"},{"text":" ","type":"text"},{"text":"which they partition (a self-loop is in no block). Blocks are ordered by their smallest edge","type":"text"},{"text":" ","type":"text"},{"text":"position, each listing its edges in ascending position. An isolated vertex, or one with only","type":"text"},{"text":" ","type":"text"},{"text":"self-loops, is in no block.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedSubgraphs(_:)":{"title":"kEdgeConnectedSubgraphs(_:)","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedSubgraphs(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kEdgeConnectedSubgraphs"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"abstract":[{"type":"text","text":"The k-edge-connected subgraphs: the maximal sets of vertices whose induced subgraph is"},{"type":"text","text":" "},{"type":"text","text":"k-edge-connected (every pair joined by "},{"type":"codeVoice","code":"k"},{"type":"text","text":" edge-disjoint paths inside it), ordered as"},{"type":"text","text":" "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". They partition the vertices, a vertex in none being a set alone."},{"type":"text","text":" "},{"type":"text","text":"Parallel edges are separate paths and self-loops count for nothing. Each set is refined"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"kEdgeConnectedComponents(_:)"},{"type":"text","text":" of its own induced subgraph until it is one class; at"},{"type":"text","text":" "},{"type":"text","text":"most n refinements, each O(k n (n + m)). "},{"type":"codeVoice","code":"k = 1"},{"type":"text","text":" gives the connected components in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedsubgraphs(_:)"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","abstract":[],"url":"\/documentation\/connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"type":"topic","abstract":[{"type":"text","text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal"},{"type":"text","text":" "},{"type":"text","text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer"},{"type":"text","text":" "},{"type":"text","text":"than k vertices. Parallel edges count once and self-loops not at all."}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","title":"kComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedComponents(_:)":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedComponents(_:)","kind":"symbol","abstract":[{"text":"The k-edge-connected components: the classes of vertices joined pairwise by at least ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" ","type":"text"},{"text":"edge-disjoint paths in the whole graph, ordered as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". Parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"are separate paths and self-loops count for nothing. ","type":"text"},{"code":"k = 1","type":"codeVoice"},{"text":" gives the connected","type":"text"},{"text":" ","type":"text"},{"text":"components and ","type":"text"},{"code":"k = 2","type":"codeVoice"},{"text":" the bi-edge-connected ones, each in O(n + m); for larger k, at most","type":"text"},{"text":" ","type":"text"},{"text":"2n unit-capacity flows, each stopped after k augmenting paths: O(k n (n + m)).","type":"text"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedcomponents(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kEdgeConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"title":"kEdgeConnectedComponents(_:)","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiconnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","type":"topic","abstract":[{"type":"text","text":"Whether the graph is biconnected: at least two vertices, connected, and no articulation"},{"type":"text","text":" "},{"type":"text","text":"point. So K₂ is, and a graph with an isolated vertex is not. Stops at the first articulation"},{"type":"text","text":" "},{"type":"text","text":"point."}],"title":"isBiconnected","role":"symbol"}}}