aph\/biEdgeConnectedComponents()","title":"biEdgeConnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"abstract":[{"type":"text","text":"The articulation points: the vertices whose removal adds a connected component"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s "},{"type":"codeVoice","code":"articulation_points"},{"type":"text","text":"; cut vertices), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one. O(n + m)."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","title":"articulationPoints()","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"articulationPoints"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"role":"symbol","kind":"symbol","abstract":[{"text":"Whether the graph has a bridge (NetworkX’s ","type":"text"},{"code":"has_bridges","type":"codeVoice"},{"text":"). Stops at the first one found.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasBridges","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","title":"hasBridges"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The block–cut tree (JGraphT’s "},{"code":"BlockCutpointGraph","type":"codeVoice"},{"type":"text","text":"): a node per block and per articulation"},{"type":"text","text":" "},{"type":"text","text":"point, and an edge between each block and each articulation point in it. A forest, one tree"},{"type":"text","text":" "},{"text":"per connected component with an edge that is not a self-loop. O(n + m).","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","title":"blockCutTree()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"abstract":[{"text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s ","type":"text"},{"code":"is_biconnected","type":"codeVoice"},{"text":"): at","type":"text"},{"text":" ","type":"text"},{"text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is not. Stops at the first articulation point.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","title":"isBiconnected","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"role":"symbol","kind":"symbol","abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"text":"): at least two vertices, connected, and no bridge. So a doubled","type":"text"},{"text":" ","type":"text"},{"text":"edge is, and K₁ and K₂ are not. Stops at the first bridge.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","title":"isBiEdgeConnected"},"doc://Connectivity/documentation/Connectivity":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"abstract":[{"text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s","type":"text"},{"text":" ","type":"text"},{"code":"biconnected_components","type":"codeVoice"},{"text":"): the maximal biconnected subgraphs, as sets of edges, which they","type":"text"},{"text":" ","type":"text"},{"text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their","type":"text"},{"text":" ","type":"text"},{"text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"or one with only self-loops, is in no block. O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","title":"biconnectedComponents()","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}}}