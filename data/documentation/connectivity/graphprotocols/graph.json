tocols\/Graph\/blockCutTree()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph"},"kind":"symbol","variants":[{"paths":["\/documentation\/connectivity\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","title":"articulationPoints()","abstract":[{"type":"text","text":"The articulation points: the vertices whose removal adds a connected component"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s "},{"type":"codeVoice","code":"articulation_points"},{"type":"text","text":"; cut vertices), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one. O(n + m)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","abstract":[{"text":"The bi-edge-connected (2-edge-connected) components (LEMON’s ","type":"text"},{"type":"codeVoice","code":"biEdgeConnectedComponents"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s bridge components): the components left when every bridge is removed, ordered","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". An isolated vertex is one on its own. O(n + m)."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","title":"biEdgeConnectedComponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"role":"collection","title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s","type":"text"},{"text":" ","type":"text"},{"code":"biconnected_components","type":"codeVoice"},{"text":"): the maximal biconnected subgraphs, as sets of edges, which they","type":"text"},{"text":" ","type":"text"},{"text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their","type":"text"},{"text":" ","type":"text"},{"text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"or one with only self-loops, is in no block. O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","role":"symbol","title":"biconnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"url":"\/documentation\/connectivity\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[],"kind":"symbol","title":"Graph","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","title":"isConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as","type":"text"},{"text":" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have","type":"text"},{"text":" ","type":"text"},{"text":"succeeded. Without flat rows, as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":": ","type":"text"},{"code":"directed.isWeaklyConnected","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","abstract":[{"text":"The bridges: the edges whose removal adds a connected component (NetworkX’s, JGraphT’s,","type":"text"},{"text":" ","type":"text"},{"text":"igraph’s and petgraph’s ","type":"text"},{"type":"codeVoice","code":"bridges"},{"text":"), as positions in ascending order. A self-loop is never a","type":"text"},{"text":" ","type":"text"},{"text":"bridge, and neither is any of two or more parallel edges. O(n + m).","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bridges"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]"}],"title":"bridges()","type":"topic","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","title":"blockCutTree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The block–cut tree (JGraphT’s "},{"code":"BlockCutpointGraph","type":"codeVoice"},{"type":"text","text":"): a node per block and per articulation"},{"type":"text","text":" "},{"type":"text","text":"point, and an edge between each block and each articulation point in it. A forest, one tree"},{"type":"text","text":" "},{"type":"text","text":"per connected component with an edge that is not a self-loop. O(n + m)."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","title":"hasBridges","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","type":"topic","abstract":[{"text":"Whether the graph has a bridge (NetworkX’s ","type":"text"},{"type":"codeVoice","code":"has_bridges"},{"text":"). Stops at the first one found.","type":"text"}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"type":"text","text":"): at least two vertices, connected, and no bridge. So a doubled"},{"type":"text","text":" "},{"type":"text","text":"edge is, and K₁ and K₂ are not. Stops at the first bridge."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiEdgeConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","title":"isBiEdgeConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"title":"isBiconnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiconnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","role":"symbol","abstract":[{"type":"text","text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s "},{"code":"is_biconnected","type":"codeVoice"},{"type":"text","text":"): at"},{"type":"text","text":" "},{"type":"text","text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is not. Stops at the first articulation point."}]},"doc://Connectivity/documentation/Connectivity":{"url":"\/documentation\/connectivity","abstract":[],"role":"collection","title":"Connectivity","kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"type":"topic","abstract":[{"type":"text","text":"The connected components (NetworkX’s, Boost’s and igraph’s "},{"code":"connected_components","type":"codeVoice"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"the order of their first vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":", each listing its vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order. The same value as "},{"code":"directed.weaklyConnectedComponents()","type":"codeVoice"},{"type":"text","text":", computed over each edge"},{"type":"text","text":" "},{"type":"text","text":"once from flat rows ("},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"type":"text","text":"). Over a graph with vertex indices but without"},{"type":"text","text":" "},{"type":"text","text":"them it is "},{"code":"directed.weaklyConnectedComponents()","type":"codeVoice"},{"type":"text","text":": union–find over each row walked in place"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"_forEachNeighborIndex","type":"codeVoice"},{"type":"text","text":"), which a computed row (a product, a subgraph view) runs faster"},{"type":"text","text":" "},{"type":"text","text":"than copying the rows first. O(n + m α(n))."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","role":"symbol","title":"connectedComponents()"}}}