nected components in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kEdgeConnectedSubgraphs","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"title":"kEdgeConnectedSubgraphs(_:)","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedsubgraphs(_:)"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","type":"topic","title":"connectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","abstract":[{"text":"The connected components, in the order of their first vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", each listing","type":"text"},{"text":" ","type":"text"},{"text":"its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","type":"topic","title":"blockCutTree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","abstract":[{"type":"text","text":"The block–cut tree: a node per block and per articulation point, and an edge between each"},{"type":"text","text":" "},{"type":"text","text":"block and each articulation point in it. A forest, one tree per connected component with an"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"type":"topic","title":"Graph","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"abstract":[],"role":"collection","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","type":"topic","url":"\/documentation\/connectivity\/graphprotocols"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Grap