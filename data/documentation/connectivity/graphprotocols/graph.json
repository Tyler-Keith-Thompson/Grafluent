"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order. The same value as ","type":"text"},{"type":"codeVoice","code":"directed.weaklyConnectedComponents()"},{"text":", computed over each edge","type":"text"},{"text":" ","type":"text"},{"text":"once from flat rows (","type":"text"},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"text":"). Over a graph with vertex indices but without","type":"text"},{"text":" ","type":"text"},{"text":"them it is ","type":"text"},{"type":"codeVoice","code":"directed.weaklyConnectedComponents()"},{"text":": union–find over each row walked in place","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"_forEachNeighborIndex"},{"text":"), which a computed row (a product, a subgraph view) runs faster","type":"text"},{"text":" ","type":"text"},{"text":"than copying the rows first. O(n + m α(n)).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier","text":"Components"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"kind":"symbol","title":"hasBridges","abstract":[{"type":"text","text":"Whether the graph has a bridge (NetworkX’s "},{"type":"codeVoice","code":"has_bridges"},{"type":"text","text":"). Stops at the first one found."}],"role":"symbol","type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","fragments":[{"text":"var","kind":"keyword"},{"text":