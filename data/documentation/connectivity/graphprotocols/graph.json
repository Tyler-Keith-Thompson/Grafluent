iculationPoints()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"articulationPoints"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","kind":"symbol","type":"topic","title":"articulationPoints()","abstract":[{"type":"text","text":"The articulation points: the vertices whose removal adds a connected component"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s "},{"type":"codeVoice","code":"articulation_points"},{"type":"text","text":"; cut vertices), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one. O(n + m)."}],"role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","url":"\/documentation\/connectivity","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","type":"topic","kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","abstract":[],"role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","kind":"symbol","role":"symbol","abstract":[{"text":"The block–cut tree (JGraphT’s ","type":"text"},{"code":"BlockCutpointGraph","type":"codeVoice"},{"text":"): a node per block and per articulation","type":"text"},{"text":" ","type":"text"},{"text":"point, and an edge between each block and each articulation point in it. A forest, one tree","type":"text"},{"text":" ","type":"text"},{"text":"per connected component with an edge that is not a self-loop. O(n + m).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"blockCutTree()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiconnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","title":"isBiconnected","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s "},{"type":"codeVoice","code":"is_biconnected"},{"type":"text","text":"): at"},{"type":"text","text":" "},{"type":"text","text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is not. Stops at the first articulation point."}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasBridges","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","k