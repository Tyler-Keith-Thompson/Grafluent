ation\/connectivity\/graphprotocols\/graph\/articulationpoints()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","title":"articulationPoints()","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","abstract":[{"type":"text","text":"The connected components (NetworkX’s, Boost’s and igraph’s "},{"type":"codeVoice","code":"connected_components"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"the order of their first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", each listing its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order. The same value as "},{"type":"codeVoice","code":"directedView.weaklyConnectedComponents()"},{"type":"text","text":", computed over each edge"},{"type":"text","text":" "},{"type":"text","text":"once from flat rows ("},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"type":"text","text":"). Over a graph with vertex indices but without"},{"type":"text","text":" "},{"type":"text","text":"them it is "},{"type":"codeVoice","code":"directedView.weaklyConnectedComponents()"},{"type":"text","text":": union–find over each row walked in place"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"_forEachNeighborIndex"},{"type":"text","text":"), which a computed row (a product, a subgraph view) runs faster"},{"type":"text","text":" "},{"type":"text","text":"than copying the rows first. O(n + m α(n))."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","title":"connectedComponents()","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","abstract":[{"type":"text","text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s "},{"code":"is_biconnected","type":"codeVoice"},{"type":"text","text":"): at"},{"type":"text","text":" "},{"type":"text","text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is not. Stops at the first articulation point."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiconnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","title":"isBiconnected","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/connectivit