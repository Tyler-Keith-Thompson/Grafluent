ragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Connectivity"}],"externalID":"s:e:s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF","roleHeading":"Extended Protocol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/connectivity\/graphprotocols\/graph"]}],"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols"]]},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBiEdgeConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether the graph is bi-edge-connected (2-edge-connected): at least two vertices,","type":"text"},{"text":" ","type":"text"},{"text":"connected, and no bridge. So a doubled edge is, and K₁ and K₂ are not. Stops at the first","type":"text"},{"text":" ","type":"text"},{"text":"bridge.","type":"text"}],"kind":"symbol","title":"isBiEdgeConnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"abstract":[{"type":"text","text":"Whether the graph is biconnected: at least two vertices, connected, and no articulation"},{"type":"text","text":" "},{"type":"text","text":"point. So K₂ is, and a graph with an isolated vertex is not. Stops at the first articulation"},{"type":"text","text":" "},{"type":"text","text":"point."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","title":"isBiconnected","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiconnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"abstract":[{"text":"The bridges: the edges whose removal adds a connected component, as positions in ascending","type":"text"},{"text":" ","type":"text"},{"text":"order. A self-loop is never a bridge, and neither is any of two or more parallel edges.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","title":"bridges()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bridges"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","type":"topic","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"blockCutTree()","abstract":[{"type":"text","text":"The block–cut tree: a node per block and per articulation point, and an edge between each"},{"type":"text","text":" "},{"type":"text","text":"block and each articulation point in it. A forest, one tree per connected component with an"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop."}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedComponents(_:)":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedComponents(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kEdgeConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"title":"kEdgeConnectedComponents(_:)","kind":"symbol","abstract":[{"text":"The k-edge-connected components: the classes of vertices joined pairwise by at least ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" ","type":"text"},{"text":"edge-disjoint paths in the whole graph, ordered as ","type":"text"},{"code":"connectedComponents()","type":"codeVoice"},{"text":". Parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"are separate paths and self-loops count for nothing. ","type":"text"},{"code":"k = 1","type":"codeVoice"},{"text":" gives the connected","type":"text"},{"text":" ","type":"text"},{"text":"components and ","type":"text"},{"code":"k = 2","type":"codeVoice"},{"text":" the bi-edge-connected ones, each in O(n + m); for larger k, at most","type":"text"},{"text":" ","type":"text"},{"text":"2n unit-capacity flows, each stopped after k augmenting paths: O(k n (n + m)).","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedcomponents(_:)","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"text":"Whether the graph has exactly one connected component; false for the empty graph, as for","type":"text"},{"text":" ","type":"text"},{"code":"isWeaklyConnected","type":"codeVoice"},{"text":". Stops as soon as n − 1 joins have succeeded.","type":"text"}],"kind":"symbol","title":"isConnected","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"title":"Graph","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"type":"topic","url":"\/documentation\/graphprotocols\/graph"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kComponents()":{"abstract":[{"text":"The k-components for every k (Moody and White’s cohesive blocking): for each k, the maximal","type":"text"},{"text":" ","type":"text"},{"text":"sets of vertices whose induced subgraph has more than k vertices and no vertex cut of fewer","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices. Parallel edges count once and self-loops not at all.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kComponents()","title":"kComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kcomponents()","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/kEdgeConnectedSubgraphs(_:)":{"role":"symbol","title":"kEdgeConnectedSubgraphs(_:)","url":"\/documentation\/connectivity\/graphprotocols\/graph\/kedgeconnectedsubgraphs(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kEdgeConnectedSubgraphs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Components","preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/kEdgeConnectedSubgraphs(_:)","abstract":[{"type":"text","text":"The k-edge-connected subgraphs: the maximal sets of vertices whose induced subgraph is"},{"type":"text","text":" "},{"type":"text","text":"k-edge-connected (every pair joined by "},{"type":"codeVoice","code":"k"},{"type":"text","text":" edge-disjoint paths inside it), ordered as"},{"type":"text","text":" "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". They partition the vertices, a vertex in none being a set alone."},{"type":"text","text":" "},{"type":"text","text":"Parallel edges are separate paths and self-loops count for nothing. Each set is refined"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"kEdgeConnectedComponents(_:)"},{"type":"text","text":" of its own induced subgraph until it is one class; at"},{"type":"text","text":" "},{"type":"text","text":"most n refinements, each O(k n (n + m)). "},{"type":"codeVoice","code":"k = 1"},{"type":"text","text":" gives the connected components in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The articulation points (cut vertices): the vertices whose removal adds a connected"},{"type":"text","text":" "},{"type":"text","text":"component, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops and parallel edges never make one."}],"kind":"symbol","title":"articulationPoints()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","role":"collection","title":"GraphProtocols","kind":"symbol","abstract":[],"url":"\/documentation\/connectivity\/graphprotocols","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"abstract":[{"text":"Whether the graph has a bridge. Stops at the first one found.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","title":"hasBridges","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"type":"topic","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"role":"symbol","title":"biconnectedComponents()","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biconnectedComponents"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","kind":"typeIdentifier","text":"BiconnectedComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()","abstract":[{"text":"The biconnected components, or blocks: the maximal biconnected subgraphs, as sets of edges,","type":"text"},{"text":" ","type":"text"},{"text":"which they partition (a self-loop is in no block). Blocks are ordered by their smallest edge","type":"text"},{"text":" ","type":"text"},{"text":"position, each listing its edges in ascending position. An isolated vertex, or one with only","type":"text"},{"text":" ","type":"text"},{"text":"self-loops, is in no block.","type":"text"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"title":"connectedComponents()","abstract":[{"text":"The connected components, in the order of their first vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":", each listing","type":"text"},{"text":" ","type":"text"},{"text":"its vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"biEdgeConnectedComponents"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity10ComponentsV","kind":"typeIdentifier","text":"Components"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"abstract":[{"type":"text","text":"The bi-edge-connected (2-edge-connected) components: the components left when every bridge"},{"type":"text","text":" "},{"type":"text","text":"is removed, ordered as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". An isolated vertex is one on its own."}],"kind":"symbol","title":"biEdgeConnectedComponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()"}}}