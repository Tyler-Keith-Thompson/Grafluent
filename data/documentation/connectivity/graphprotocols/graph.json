]}],"identifier":{"url":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]}],"kind":"symbol","references":{"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isConnected":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isconnected","abstract":[{"type":"text","text":"Whether the graph has exactly one connected component; false for the empty graph, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"isWeaklyConnected"},{"type":"text","text":" (igraph, JGraphT; NetworkX raises). Stops as soon as n − 1 joins have"},{"type":"text","text":" "},{"type":"text","text":"succeeded. Without flat rows, as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":": "},{"type":"codeVoice","code":"directed.isWeaklyConnected"},{"type":"text","text":"."}],"title":"isConnected","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isConnected","type":"topic","kind":"symbol"},"doc://Connectivity/documentation/Connectivity":{"abstract":[],"kind":"symbol","title":"Connectivity","role":"collection","url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"kind":"symbol","title":"Graph","role":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/bridges()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/bridges()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/bridges()","title":"bridges()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bridges","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The bridges: the edges whose removal adds a connected component (NetworkX’s, JGraphT’s,","type":"text"},{"text":" ","type":"text"},{"text":"igraph’s and petgraph’s ","type":"text"},{"code":"bridges","type":"codeVoice"},{"text":"), as positions in ascending order. A self-loop is never a","type":"text"},{"text":" ","type":"text"},{"text":"bridge, and neither is any of two or more parallel edges. O(n + m).","type":"text"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols","title":"GraphProtocols","type":"topic","abstract":[],"role":"collection"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/articulationPoints()":{"title":"articulationPoints()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"articulationPoints","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/articulationpoints()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/articulationPoints()","abstract":[{"text":"The articulation points: the vertices whose removal adds a connected component","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX’s, Boost’s, igraph’s and petgraph’s ","type":"text"},{"code":"articulation_points","type":"codeVoice"},{"text":"; cut vertices), in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. Self-loops and parallel edges never make one. O(n + m).","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiconnected":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiconnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"text":"Whether the graph is biconnected (NetworkX’s, JGraphT’s and igraph’s ","type":"text"},{"code":"is_biconnected","type":"codeVoice"},{"text":"): at","type":"text"},{"text":" ","type":"text"},{"text":"least two vertices, connected, and no articulation point. So K₂ is, and a graph with an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is not. Stops at the first articulation point.","type":"text"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiconnected","title":"isBiconnected","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiconnected","kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biEdgeConnectedComponents()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biedgeconnectedcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biEdgeConnectedComponents()","title":"biEdgeConnectedComponents()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biEdgeConnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity10ComponentsV","text":"Components","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"abstract":[{"type":"text","text":"The bi-edge-connected (2-edge-connected) components (LEMON’s "},{"type":"codeVoice","code":"biEdgeConnectedComponents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s bridge components): the components left when every bridge is removed, ordered"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". An isolated vertex is one on its own. O(n + m)."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/blockCutTree()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/blockcuttree()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/blockCutTree()","title":"blockCutTree()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"The block–cut tree (JGraphT’s ","type":"text"},{"code":"BlockCutpointGraph","type":"codeVoice"},{"text":"): a node per block and per articulation","type":"text"},{"text":" ","type":"text"},{"text":"point, and an edge between each block and each articulation point in it. A forest, one tree","type":"text"},{"text":" ","type":"text"},{"text":"per connected component with an edge that is not a self-loop. O(n + m).","type":"text"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph":{"title":"Graph","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph","url":"\/documentation\/connectivity\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/connectedComponents()":{"kind":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/connectedcomponents()","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/connectedComponents()","title":"connectedComponents()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Components","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity10ComponentsV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"abstract":[{"type":"text","text":"The connected components (NetworkX’s, Boost’s and igraph’s "},{"type":"codeVoice","code":"connected_components"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"the order of their first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", each listing its vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order. The same value as "},{"type":"codeVoice","code":"directed.weaklyConnectedComponents()"},{"type":"text","text":", computed over each edge"},{"type":"text","text":" "},{"type":"text","text":"once from flat rows ("},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"type":"text","text":"). Over a graph with vertex indices but without"},{"type":"text","text":" "},{"type":"text","text":"them it is "},{"type":"codeVoice","code":"directed.weaklyConnectedComponents()"},{"type":"text","text":": union–find over each row walked in place"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"_forEachNeighborIndex"},{"type":"text","text":"), which a computed row (a product, a subgraph view) runs faster"},{"type":"text","text":" "},{"type":"text","text":"than copying the rows first. O(n + m α(n))."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/biconnectedComponents()":{"kind":"symbol","role":"symbol","url":"\/documentation\/connectivity\/graphprotocols\/graph\/biconnectedcomponents()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"biconnectedComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BiconnectedComponents","preciseIdentifier":"s:12Connectivity21BiconnectedComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"biconnectedComponents()","abstract":[{"type":"text","text":"The biconnected components, or blocks (Boost’s, NetworkX’s and igraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"biconnected_components"},{"type":"text","text":"): the maximal biconnected subgraphs, as sets of edges, which they"},{"type":"text","text":" "},{"type":"text","text":"partition (self-loops apart: a self-loop is in no block). Blocks are ordered by their"},{"text":" ","type":"text"},{"text":"smallest edge position, each listing its edges in ascending position. An isolated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"or one with only self-loops, is in no block. O(n + m).","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/biconnectedComponents()"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/isBiEdgeConnected":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBiEdgeConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/connectivity\/graphprotocols\/graph\/isbiedgeconnected","abstract":[{"type":"text","text":"Whether the graph is bi-edge-connected (2-edge-connected; NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_k_edge_connected(G, 2)"},{"type":"text","text":"): at least two vertices, connected, and no bridge. So a doubled"},{"type":"text","text":" "},{"type":"text","text":"edge is, and K₁ and K₂ are not. Stops at the first bridge."}],"title":"isBiEdgeConnected","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/isBiEdgeConnected","type":"topic","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/GraphProtocols/Graph/hasBridges":{"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/GraphProtocols\/Graph\/hasBridges","url":"\/documentation\/connectivity\/graphprotocols\/graph\/hasbridges","title":"hasBridges","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasBridges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether the graph has a bridge (NetworkX’s "},{"code":"has_bridges","type":"codeVoice"},{"type":"text","text":"). Stops at the first one found."}],"role":"symbol"}}}