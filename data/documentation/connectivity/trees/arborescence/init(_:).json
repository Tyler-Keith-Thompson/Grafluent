{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The dominator tree as an arborescence rooted at its root: every vertex the root reaches,","type":"text"},{"text":" ","type":"text"},{"text":"each with its immediate dominator as parent. A post-dominator tree converts the same way:","type":"text"},{"text":" ","type":"text"},{"text":"each vertex that reaches the exit, with its immediate post-dominator as parent.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/Trees\/Arborescence\/init(_:)"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/Trees","doc:\/\/Connectivity\/documentation\/Connectivity\/Trees\/Arborescence"]]},"metadata":{"externalID":"s:5Trees12ArborescenceV12ConnectivityEyACyxGAD13DominatorTreeVyqd__Gc6VertexQyd__Rsz14GraphProtocols08DirectedG0Rd__lufc","symbolKind":"init","title":"init(_:)","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:12Connectivity13DominatorTreeV","text":"DominatorTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"extendedModule":"Trees","role":"symbol","conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"modules":[{"relatedModules":["Trees"],"name":"Connectivity"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"external