vity/KComponents/description":{"type":"topic","abstract":[],"title":"description","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/description","role":"symbol","url":"\/documentation\/connectivity\/kcomponents\/description","kind":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"G"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"title":"Connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","url":"\/documentation\/connectivity","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/KComponents":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"type":"topic","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","url":"\/documentation\/connectivity\/kcomponents","title":"KComponents","role":"symbol"}}}