vity/KComponents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"role":"symbol","type":"topic","url":"\/documentation\/connectivity\/kcomponents","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","title":"KComponents"},"doc://Connectivity/documentation/Connectivity/KComponents/description":{"title":"description","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/description","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"description"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"role":"symbol","kind":"symbol","url":"\/documentation\/connectivity\/kcomponents\/description","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"G"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":".","type":"text"}]}},"doc://