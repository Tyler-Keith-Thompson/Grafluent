vity":{"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","url":"\/documentation\/connectivity","type":"topic","role":"collection","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/KComponents/description":{"type":"topic","title":"description","role":"symbol","abstract":[],"url":"\/documentation\/connectivity\/kcomponents\/description","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"G","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/description","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"description"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/KComponents":{"abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"title":"KComponents","url":"\/documentation\/connectivity\/kcomponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KCompone