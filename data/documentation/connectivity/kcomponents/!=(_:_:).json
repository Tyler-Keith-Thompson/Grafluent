ntation/Connectivity/KComponents/!=(_:_:)":{"title":"!=(_:_:)","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/!=(_:_:)","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","kind":"symbol","url":"\/documentation\/connectivity\/kcomponents\/!=(_:_:)"},"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"role":"symbol","type":"topic","url":"\/documentation\/connectivity\/kcomponents","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","title":"KComponents"},"doc://Connectivity/documentation/Connectivity":{"role":"collection","type":