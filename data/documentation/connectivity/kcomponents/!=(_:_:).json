ntation/Connectivity/KComponents/!=(_:_:)":{"url":"\/documentation\/connectivity\/kcomponents\/!=(_:_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"!=(_:_:)","kind":"symbol","abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/!=(_:_:)"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/KComponents":{"url":"\/documentation\/connectivity\/kcomponents","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text",