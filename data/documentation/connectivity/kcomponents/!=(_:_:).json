ntation/Connectivity/KComponents/!=(_:_:)":{"title":"!=(_:_:)","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/!=(_:_:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"!="},{"kind":"text","text":" "},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[],"url":"\/documentation\/connectivity\/kcomponents\/!=(_:_:)"},"doc://Connectivity/documentation/Connectivity/KComponents":{"title":"KComponents","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"url":"\/documentation\/connectivity\/kcomponents"},"doc://Connectivity/documentation/Connectivity":{"title":"Connectivity","type":"topic","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","role":"collection","abstract":[],"url":"\/documentation\/connectivity"}}}