for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"title":"KComponents","url":"\/documentation\/connectivity\/kcomponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}]},"doc://Connectivity/documentation/Connectivity/KComponents/maximumK":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/maximumK","type":"topic","role":"symbol","url":"\/documentation\/connectivity\/kcomponents\/maximumk","abstract":[{"type":"text","text":"The greatest k with a k-component, or 0 when no edge joins two distinct vertices."}],"kind":"symbol","title":"maximumK","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumK"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]}}}