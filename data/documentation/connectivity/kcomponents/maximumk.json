s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"kind":"symbol","title":"KComponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},"doc://Connectivity/documentation/Connectivity":{"type":"topic","abstract":[],"url":"\/documentation\/connectivity","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","title":"Connectivity","kind":"symbol","role":"collection"},"doc://Connectivity/documentation/Connectivity/KComponents/maximumK":{"url":"\/documentation\/connectivity\/kcomponents\/maximumk","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumK","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"abstract":[{"text":"The greatest k with a k-component, or 0 when no edge joins two distinct vertices.","type":"text"}],"title":"maximumK","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/maximumK"}}}