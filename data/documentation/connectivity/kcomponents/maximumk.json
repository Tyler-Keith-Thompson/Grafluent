mumK"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/connectivity\/kcomponents\/maximumk","title":"maximumK","kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/maximumK","abstract":[{"type":"text","text":"The greatest k with a k-component, or 0 when no edge joins two distinct vertices."}],"role":"symbol"},"doc://Connectivity/documentation/Connectivity/KComponents":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"url":"\/documentation\/connectivity\/kcomponents","title":"KComponents","kind":"symbol","type":"topic","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"role":"symbol"}}}