,"type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"title":"KComponents","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","kind":"symbol"},"doc://Connectivity/documentation/Connectivity":{"role":"collection","abstract":[],"url":"\/documentation\/connectivity","title":"Connectivity","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/KComponents/maximumK":{"url":"\/documentation\/connectivity\/kcomponents\/maximumk","abstract":[{"type":"text","text":"The greatest k with a k-component, or 0 when no edge joins two distinct vertices."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/maximumK","title":"maximumK","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumK","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol"}}}