{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/connectivity\/kcomponents\/customstringconvertible-implementations"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"API Collection","title":"CustomStringConvertible Implementations","modules":[{"name":"Connectivity"}],"role":"collectionGroup"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/CustomStringConvertible-Implementations"},"hierarchy":{"paths":[["doc:\/\/Connectivity\/documentation\/Connectivity","doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"]]},"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/description"]}],"sections":[],"kind":"article","references":{"doc://Connectivity/documentation/Connectivity/KComponents":{"kind":"symbol","url":"\/documentation\/connectivity\/kcomponents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"type":"topic","title":"KComponents","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},"doc://Connectivity/documentation/Connectivity/KComponents/description":{"kind":"symbol","url":"\/documentation\/connectivity\/kcomponents\/description","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"description","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"type":"topic","title":"description","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"G"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}]},"abstract":[],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents\/description"},"doc://Connectivity/documentation/Connectivity":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/connectivity","title":"Connectivity","kind":"symbol"}}}