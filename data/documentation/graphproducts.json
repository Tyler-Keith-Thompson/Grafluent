ianProductView"}],"title":"CartesianProductView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CartesianProductView"}]},"doc://GraphProducts/documentation/GraphProducts/tensorProductView(_:_:)-5nvgi":{"role":"symbol","title":"tensorProductView(_:_:)","url":"\/documentation\/graphproducts\/tensorproductview(_:_:)-5nvgi","abstract":[{"type":"text","text":"The tensor product G × H of two undirected graphs, as a lazy view: for every edge {a, b} of G"},{"type":"text","text":" "},{"type":"text","text":"and every edge {c, d} of H, the edges {(a, c), (b, d)} and {(a, d), (b, c)}, which coincide when"},{"type":"text","text":" "},{"type":"text","text":"either factor edge is a self-loop. K2 × G is G’s bipartite double cover. O(1)."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tensorProductView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"H"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"H"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"TensorProductView","preciseIdentifier":"s:13GraphProducts17TensorProductViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"H"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/tensorProductView(_:_:)-5nvgi","kind":"symbol"}}}