with each vertex"},{"type":"text","text":" "},{"type":"text","text":"replaced by a copy of H, and every vertex of one copy joined to every vertex of another when G"},{"type":"text","text":" "},{"type":"text","text":"joins their vertices. K2 ∘ (2 isolated vertices) is C4. It is not commutative. O(1)."}],"type":"topic"},"doc://GraphProducts/documentation/GraphProducts/cartesianProductView(_:_:)-8mkyl":{"abstract":[{"text":"The Cartesian product G □ H of two undirected graphs, as a lazy view: vertex (g, h) is","type":"text"},{"text":" ","type":"text"},{"text":"joined to (g′, h) for every edge {g, g′} of G, and to (g, h′) for every edge {h, h′} of H.","type":"text"},{"text":" ","type":"text"},{"text":"P_r □ P_c is the r × c grid. O(1).","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProducts\/documentation\/GraphProducts\/cartesianProductView(_:_:)-8mkyl","url":"\/documentation\/graphproducts\/cartesianproductview(_:_:)-8mkyl","title":"cartesianProductView(_:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cartesianProductView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"H","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"CartesianProductView","preciseIdentifier":"s:13GraphProducts20CartesianProductViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"H","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol"},"doc://GraphProducts/documentation/GraphProducts/Pair":{"type":"topic","url":"\/documentation\/graphproducts\/pair","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Pair","kind":"identifier"}],"identifier":"doc:\/\/Graph