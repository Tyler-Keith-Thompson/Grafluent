 reachable from the vertex; so the diameter is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is not connected (or not strongly connected), and the radius when no vertex","type":"text"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"title":"Eccentricities","url":"\/documentation\/distances\/eccentricities","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}],"type":"topic"}}}