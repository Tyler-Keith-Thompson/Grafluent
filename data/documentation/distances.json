s "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"url":"\/documentation\/distances\/eccentricities","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","role":"symbol","title":"Eccentricities","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}]}}}