{"metadata":{"role":"collection","roleHeading":"Framework","title":"Distances","symbolKind":"module","externalID":"Distances","modules":[{"name":"Distances"}]},"kind":"symbol","identifier":{"url":"doc:\/\/Distances\/documentation\/Distances","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distances"]}],"sections":[],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Distances\/documentation\/Distances\/Eccentricities"],"anchor":"Structures","generated":true},{"title":"Extended Modules","anchor":"Extended-Modules","generated":true,"identifiers":["doc:\/\/Distances\/documentation\/Distances\/GraphProtocols"]}],"references":{"doc://Distances/documentation/Distances/GraphProtocols":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols","url":"\/documentation\/distances\/graphprotocols","abstract":[],"title":"GraphProtocols","role":"collection"},"doc://Distances/documentation/Distances":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances","url":"\/documentation\/distances","abstract":[],"title":"Distances","role":"collection"},"doc://Distances/documentation/Distances/Eccentricities":{"title":"Eccentricities","abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"type":"codeVoice","code":"all_eccentricities"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","type":"topic","url":"\/documentation\/distances\/eccentricities","role":"symbol"}}}