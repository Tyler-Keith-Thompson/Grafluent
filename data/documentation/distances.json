d (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"url":"\/documentation\/distances\/eccentricities","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}],"type":"topic","title":"Eccentricities","role":"symbol"},"doc://Distances/documentation/Distances/GraphProtocols":{"role":"collection","identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/distances\/graphprotocols","abstract":[],"kind":"symbol","type":"topic"}}}