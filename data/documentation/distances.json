{"identifier":{"url":"doc:\/\/Distances\/documentation\/Distances","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"role":"collection","roleHeading":"Framework","modules":[{"name":"Distances"}],"symbolKind":"module","externalID":"Distances","title":"Distances"},"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/Distances\/documentation\/Distances\/Eccentricities"],"generated":true,"title":"Structures"},{"identifiers":["doc:\/\/Distances\/documentation\/Distances\/GraphProtocols"],"generated":true,"title":"Extended Modules","anchor":"Extended-Modules"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distances"]}],"hierarchy":{"paths":[[]]},"references":{"doc://Distances/documentation/Distances/Eccentricities":{"identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"kind":"symbol","title":"Eccentricities","abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"code":"all_eccentricities","type":"codeVoice"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}],"role":"symbol","url":"\/documentation\/distances\/eccentricities"},"doc://Distances/documentation/Distances":{"identifier":"doc:\/\/Distances\/documentation\/Distances","type":"topic","kind":"symbol","title":"Distances","abstract":[],"role":"collection","url":"\/documentation\/distances"},"doc://Distances/documentation/Distances/GraphProtocols":{"identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols","type":"topic","abstract":[],"title":"GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/distances\/graphprotocols"}}}