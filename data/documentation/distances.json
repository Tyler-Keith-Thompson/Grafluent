inity, when some vertex is not reachable from the vertex; so the diameter is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is not connected (or not strongly connected), and the radius when no vertex","type":"text"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"kind":"symbol","title":"Eccentricities","role":"symbol"},"doc://Distances/documentation/Distances":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/distances","identifier":"doc:\/\/Distances\/documentation\/Distances","title":"Distances"}}}