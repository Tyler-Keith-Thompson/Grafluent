{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"module","role":"collection","roleHeading":"Framework","modules":[{"name":"Distances"}],"title":"Distances","externalID":"Distances"},"sections":[],"identifier":{"url":"doc:\/\/Distances\/documentation\/Distances","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/distances"]}],"hierarchy":{"paths":[[]]},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Distances\/documentation\/Distances\/Eccentricities"],"title":"Structures","generated":true,"anchor":"Structures"},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/Distances\/documentation\/Distances\/GraphProtocols"]}],"references":{"doc://Distances/documentation/Distances/Eccentricities":{"title":"Eccentricities","kind":"symbol","type":"topic","url":"\/documentation\/distances\/eccentricities","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eccentricities"}],"abstract":[{"text":"Every vertex’s eccentricity, computed once (Boost’s ","type":"text"},{"type":"codeVoice","code":"all_eccentricities"},{"text":"), with the measures","type":"text"},{"text":" ","type":"text"},{"text":"that follow from them: the radius (the least), the diameter (the greatest), the center and","type":"text"},{"text":" ","type":"text"},{"text":"the periphery (the vertices that attain them). An eccentricity is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", standing for","type":"text"},{"text":" ","type":"text"},{"text":"infinity, when some vertex is not reachable from the vertex; so the diameter is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is not connected (or not strongly connected), and the radius when no vertex","type":"text"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Eccentricities"}],"identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","role":"symbol"},"doc://Distances/documentation/Distances/GraphProtocols":{"url":"\/documentation\/distances\/graphprotocols","role":"collection","title":"GraphProtocols","kind":"symbol","abstract":[],"identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols","type":"topic"},"doc://Distances/documentation/Distances":{"abstract":[],"type":"topic","url":"\/documentation\/distances","role":"collection","kind":"symbol","title":"Distances","identifier":"doc:\/\/Distances\/documentation\/Distances"}}}