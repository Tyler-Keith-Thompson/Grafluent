 edge with its "},{"type":"codeVoice","code":"<attvalues>"},{"type":"text","text":". A "},{"type":"codeVoice","code":"label"},{"type":"text","text":" pair becomes the element’s "},{"type":"codeVoice","code":"label"},{"type":"text","text":" and an edge’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" pair its "},{"type":"codeVoice","code":"weight"},{"type":"text","text":", as the reader reports them; an edge’s "},{"type":"codeVoice","code":"id"},{"type":"text","text":" is its position. The"},{"type":"text","text":" "},{"type":"text","text":"attribute closures are called twice per element (to type the declarations, then to write)"},{"type":"text","text":" "},{"type":"text","text":"and must return the same pairs both times; "},{"type":"codeVoice","code":"vertexID"},{"type":"text","text":" is called once per vertex. GEXF has"},{"type":"text","text":" "},{"type":"text","text":"no graph attributes."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(n + m + output size), plus the closures’ cost.","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"WriteError"},{"type":"text","text":", checked before anything is written:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"duplicateID"},{"text":" when two vertices have the same ID, compared by Unicode scalars;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"invalidID"},{"type":"text","text":", "},{"type":"codeVoice","code":"invalidKey"},{"type":"text","text":" or "},{"type":"codeVoice","code":"invalidValue"},{"type":"text","text":" when an ID, an attribute name or a string"},{"type":"text","text":" "},{"type":"text","text":"value holds a character XML 1.0 cannot represent (a C0 control other than tab, line feed"},{"type":"text","text":" "},{"type":"text","text":"and carriage return, U+FFFE or U+FFFF), and "},{"type":"codeVoice","code":"invalidValue"},{"type":"text","text":" for a "},{"type":"codeVoice","code":"label"},{"type":"text","text":" that is not a"},{"type":"text","text":" "},{"type":"text","text":"string or an edge "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" that is not a number;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"typeMismatch"},{"text":" when one attribute name holds values of two types other than integers and","type":"text"},{"text":" ","type":"text"},{"text":"doubles.","type":"text"}]}]}],"type":"unorderedList"}]},{"inlineContent":[{"type":"text","text":"Traps when an attribute closure gives one key twice for one element."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/GraphFormats\/documentation\/GraphFormats","doc:\/\/GraphFormats\/documentation\/GraphFormats\/GraphProtocols","doc:\/\/GraphFormats\/documentation\/GraphFormats\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/GraphFormats\/documentation\/GraphFormats\/GraphProtocols\/Graph\/writeGEXF(to:vertexID:vertexAttributes:edgeAttributes:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/graphformats\/graphprotocols\/graph\/writegexf(to:vertexid:vertexattributes:edgeattributes:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"metadata":{"modules":[{"name":"GraphFormats","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P0A7FormatsE9writeGEXF2to8vertexID0G10Attributes04edgeI0yqd__z_SS6VertexQzXESaySS3key_AD14AttributeValueO5valuetGAKXEAP5Edges_5IndexQZXEtAD10WriteErrorOYKs16TextOutputStreamRd__lF","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","title":"writeGEXF(to:vertexID:vertexAttributes:edgeAttributes:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"te