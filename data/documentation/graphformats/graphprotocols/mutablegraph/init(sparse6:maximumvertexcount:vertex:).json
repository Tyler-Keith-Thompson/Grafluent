,"text":" at "},{"type":"codeVoice","code":";"},{"type":"text","text":" (incremental sparse6);"},{"type":"text","text":" "},{"type":"codeVoice","code":"unexpectedEndOfInput"},{"type":"text","text":" when the size is cut short; "},{"type":"codeVoice","code":"limitExceeded"},{"type":"text","text":" at N(n) when n is above"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumVertexCount"},{"type":"text","text":"; "},{"type":"codeVoice","code":"invalidVertex"},{"type":"text","text":" at N(n) when "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"type":"aside"}],"kind":"content"}],"references":{"doc://GraphFormats/documentation/GraphFormats/GraphProtocols":{"type":"topic","title":"GraphProtocols","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/GraphFormats\/documentation\/GraphFormats\/GraphProtocols","url":"\/documentation\/graphformats\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://GraphFormats/documentation/GraphFormats/GraphProtocols/MutableGraph/init(sparse6:maximumVertexCount:vertex:)":{"identifier":"doc:\/\/GraphFormats\/documentation\/GraphFormats\/GraphProtocols\/MutableGraph\/init(sparse6:maximumVertexCount:vertex:)","title":"init(sparse6:maximumVertexCount:vertex:)","abstract":[{"text":"Reads sparse6: the vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":", then the edges in the order the file lists them (each","type":"text"},{"text":" ","type