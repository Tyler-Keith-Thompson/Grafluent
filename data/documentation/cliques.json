":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClusteringCoefficients","kind":"identifier"}],"role":"symbol","title":"ClusteringCoefficients"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","title":"MaximalCliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/CoreNumbers":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","url":"\/documentation\/cliques\/corenumbers","navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}],"abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik; NetworkX "},{"code":"core_number","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"code":"coreness","type":"codeVoice"},{"type":"text","text":", JGraphT "},{"code":"Coreness","type":"codeVoice"},{"type":"text","text":"), over its simple graph: a vertex’s core number"},{"type":"text","text":" "},{"type":"text","text":"is the largest k such that it lies in a subgraph where every vertex has at least k neighbors."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreNumbers"}],"role":"symbol","title":"CoreNumbers"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"url":"\/documentation\/cliques\/graphprotocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","type":"topic","kind":"symbol","role":"collection","abstract":[],"title":"GraphProtocols"}}}