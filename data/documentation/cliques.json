xt":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","kind":"symbol","title":"MaximalCliques","type":"topic","url":"\/documentation\/cliques\/maximalcliques"},"doc://Cliques/documentation/Cliques":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","type":"topic","role":"collection","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClusteringCoefficients","kind":"identifier"}],"abstract":[{"type":"text","text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one"},{"type":"text","text":" "},{"type":"text","text":"pass (JGraphT’s "},{"type":"codeVoice","code":"ClusteringCoefficient"},{"type":"text","text":"; NetworkX "},{"type":"codeVoice","code":"triangles"},{"type":"text","text":", "},{"type":"codeVoice","code":"clustering"},{"type":"text","text":", "},{"type":"codeVoice","code":"transitivity"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"average_clustering"},{"type":"text","text":")."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","title":"ClusteringCoefficients","type":"topic","navigatorTitle":[{"text":"ClusteringCoefficients","kind":"identifier"}],"role":"symbol","url":"\/documentation\/cliques\/clusteringcoefficients"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik; NetworkX "},{"code":"core_number","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"code":"coreness","type":"codeVoice"},{"type":"text","text":", JGraphT "},{"code":"Coreness","type":"codeVoice"},{"type":"text","text":"), over its simple graph: a vertex’s core number"},{"type":"text","text":" "},{"type":"text","text":"is the largest k such that it lies in a subgraph where every vertex has at least k neighbors."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreNumbers"}],"navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}],"title":"CoreNumbers","url":"\/documentation\/cliques\/corenumbers","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"role":"collection","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","kind":"symbol","type":"topic","title":"GraphProtocols","url":"\/documentation\/cliques\/graphprotocols"}}}