{"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[[]]},"sections":[],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"],"title":"Structures","anchor":"Structures"},{"generated":true,"identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"],"title":"Extended Modules","anchor":"Extended-Modules"}],"variants":[{"paths":["\/documentation\/cliques"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Framework","role":"collection","externalID":"Cliques","symbolKind":"module","modules":[{"name":"Cliques"}],"title":"Cliques"},"references":{"doc://Cliques/documentation/Cliques/GraphProtocols":{"abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","type":"topic","url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","role":"collection"},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"title":"ClusteringCoefficients","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClusteringCoefficients"}],"navigatorTitle":[{"kind":"identifier","text":"ClusteringCoefficients"}],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/clusteringcoefficients","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one"},{"type":"text","text":" "},{"type":"text","text":"pass (JGraphT’s "},{"type":"codeVoice","code":"ClusteringCoefficient"},{"type":"text","text":"; NetworkX "},{"type":"codeVoice","code":"triangles"},{"text":", ","type":"text"},{"type":"codeVoice","code":"clustering"},{"text":", ","type":"text"},{"type":"codeVoice","code":"transitivity"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"average_clustering"},{"text":").","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","role":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"type":"topic","title":"MaximalCliques","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"url":"\/documentation\/cliques\/maximalcliques"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"title":"CoreNumbers","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreNumbers"}],"navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/corenumbers","abstract":[{"text":"The core decomposition of an undirected graph (Batagelj–Zaversnik; NetworkX ","type":"text"},{"type":"codeVoice","code":"core_number"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"igraph ","type":"text"},{"type":"codeVoice","code":"coreness"},{"type":"text","text":", JGraphT "},{"code":"Coreness","type":"codeVoice"},{"type":"text","text":"), over its simple graph: a vertex’s core number"},{"type":"text","text":" "},{"type":"text","text":"is the largest k such that it lies in a subgraph where every vertex has at least k neighbors."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","role":"symbol"},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection"}}}