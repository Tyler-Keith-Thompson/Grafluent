{"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques"]}],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques","interfaceLanguage":"swift"},"metadata":{"symbolKind":"module","role":"collection","modules":[{"name":"Cliques"}],"roleHeading":"Framework","title":"Cliques","externalID":"Cliques"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers"],"title":"Structures","generated":true},{"identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent"],"title":"Enumerations","generated":true,"anchor":"Enumerations"},{"identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"],"title":"Extended Modules","generated":true,"anchor":"Extended-Modules"}],"references":{"doc://Cliques/documentation/Cliques/TrussNumbers":{"title":"TrussNumbers","url":"\/documentation\/cliques\/trussnumbers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrussNumbers"}],"abstract":[{"type":"text","text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An"},{"type":"text","text":" "},{"type":"text","text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at"},{"type":"text","text":" "},{"type":"text","text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges share their simple edge’s number, and a self-loop has none."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TrussNumbers"}]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","role":"collection","abstract":[],"kind":"symbol"},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"abstract":[{"text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one","type":"text"},{"text":" ","type":"text"},{"text":"pass.","type":"text"}],"role":"symbol","url":"\/documentation\/cliques\/clusteringcoefficients","type":"topic","title":"ClusteringCoefficients","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClusteringCoefficients","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"ClusteringCoefficients","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients"},"doc://Cliques/documentation/Cliques/TreeDecomposition":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","title":"TreeDecomposition","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TreeDecomposition"}],"abstract":[{"text":"A tree decomposition of a graph: bags of vertices, joined by edges into a tree, such that","type":"text"},{"text":" ","type":"text"},{"text":"every vertex is in a bag, both ends of every edge are together in a bag, and the bags holding","type":"text"},{"text":" ","type":"text"},{"text":"any one vertex form a connected subtree.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TreeDecomposition"}],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/treedecomposition"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols","role":"collection","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols"},"doc://Cliques/documentation/Cliques/AllCliques":{"kind":"symbol","url":"\/documentation\/cliques\/allcliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","navigatorTitle":[{"kind":"identifier","text":"AllCliques"}],"abstract":[{"text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,","type":"text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"title":"AllCliques","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllCliques"}],"type":"topic"},"doc://Cliques/documentation/Cliques/OnionLayers":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","url":"\/documentation\/cliques\/onionlayers","navigatorTitle":[{"kind":"identifier","text":"OnionLayers"}],"abstract":[{"type":"text","text":"The onion decomposition of an undirected graph’s simple graph: each vertex’s layer, a"},{"type":"text","text":" "},{"type":"text","text":"refinement of the core decomposition in which every layer lies inside one k-shell. Layers are"},{"type":"text","text":" "},{"type":"text","text":"numbered from 1; isolated vertices, when there are any, are layer 1 alone."}],"title":"OnionLayers","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OnionLayers"}],"type":"topic"},"doc://Cliques/documentation/Cliques/BronKerboschEvent":{"title":"BronKerboschEvent","url":"\/documentation\/cliques\/bronkerboschevent","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvent","kind":"identifier"}],"abstract":[{"text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":" runs","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"BronKerboschEvent","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/MaximalCliques":{"abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"title":"CoreNumbers","url":"\/documentation\/cliques\/corenumbers","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CoreNumbers"}],"abstract":[{"text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at","type":"text"},{"text":" ","type":"text"},{"text":"least k neighbors.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}]},"doc://Cliques/documentation/Cliques/BronKerboschEvents":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","title":"BronKerboschEvents","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvents","kind":"identifier"}],"abstract":[{"type":"text","text":"The Bron–Kerbosch algorithm with pivoting as a sequence of "},{"type":"codeVoice","code":"BronKerboschEvent"},{"type":"text","text":"s: the search of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":", one clique at a time. Pulling an event past the last one kept runs the"},{"type":"text","text":" "},{"type":"text","text":"search to its next maximal clique and keeps the events on the way."}],"navigatorTitle":[{"text":"BronKerboschEvents","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/bronkerboschevents"}}}