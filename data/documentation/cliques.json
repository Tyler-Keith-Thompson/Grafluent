hProtocols":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","url":"\/documentation\/cliques\/graphprotocols","role":"collection","title":"GraphProtocols"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"title":"CoreNumbers","role":"symbol","abstract":[{"text":"The core decomposition of an undirected graph (Batagelj–Zaversnik; NetworkX ","type":"text"},{"type":"codeVoice","code":"core_number"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"igraph ","type":"text"},{"type":"codeVoice","code":"coreness"},{"type":"text","text":", JGraphT "},{"type":"codeVoice","code":"Coreness"},{"type":"text","text":"), over its simple graph: a vertex’s core number"},{"type":"text","text":" "},{"type":"text","text":"is the largest k such that it lies in a subgraph where every vertex has at least k neighbors."}],"type":"topic","url":"\/documentation\/cliques\/corenumbers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreNumbers","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/MaximalCliques":{"url":"\/documentation\/cliques\/maximalcliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"role":"symbol","type":"topic","title":"MaximalCliques","abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrderin