{"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques"},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers"],"anchor":"Structures"},{"generated":true,"title":"Enumerations","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent"],"anchor":"Enumerations"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"],"anchor":"Extended-Modules"}],"metadata":{"role":"collection","title":"Cliques","externalID":"Cliques","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"Cliques"}]},"references":{"doc://Cliques/documentation/Cliques/MaximalCliques":{"url":"\/documentation\/cliques\/maximalcliques","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","title":"MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"type":"topic"},"doc://Cliques/documentation/Cliques/BronKerboschEvents":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvents","kind":"identifier"}],"title":"BronKerboschEvents","type":"topic","navigatorTitle":[{"text":"BronKerboschEvents","kind":"identifier"}],"url":"\/documentation\/cliques\/bronkerboschevents","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","kind":"symbol","abstract":[{"text":"The Bron–Kerbosch algorithm with pivoting as a sequence of ","type":"text"},{"code":"BronKerboschEvent","type":"codeVoice"},{"text":"s: the search of","type":"text"},{"text":" ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":", one clique at a time. Pulling an event past the last one kept runs the","type":"text"},{"text":" ","type":"text"},{"text":"search to its next maximal clique and keeps the events on the way.","type":"text"}]},"doc://Cliques/documentation/Cliques/BronKerboschEvent":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvent","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"BronKerboschEvent","type":"topic","abstract":[{"text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":" runs","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"url":"\/documentation\/cliques\/bronkerboschevent","navigatorTitle":[{"text":"BronKerboschEvent","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/AllCliques":{"url":"\/documentation\/cliques\/allcliques","kind":"symbol","abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","title":"AllCliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllCliques"}],"navigatorTitle":[{"kind":"identifier","text":"AllCliques"}],"type":"topic"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"kind":"symbol","title":"CoreNumbers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","abstract":[{"text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at","type":"text"},{"text":" ","type":"text"},{"text":"least k neighbors.","type":"text"}],"role":"symbol","type":"topic","navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreNumbers","kind":"identifier"}],"url":"\/documentation\/cliques\/corenumbers"},"doc://Cliques/documentation/Cliques/OnionLayers":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"OnionLayers"}],"type":"topic","title":"OnionLayers","navigatorTitle":[{"kind":"identifier","text":"OnionLayers"}],"url":"\/documentation\/cliques\/onionlayers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","kind":"symbol","abstract":[{"type":"text","text":"The onion decomposition of an undirected graph’s simple graph: each vertex’s layer, a"},{"type":"text","text":" "},{"type":"text","text":"refinement of the core decomposition in which every layer lies inside one k-shell. Layers are"},{"type":"text","text":" "},{"type":"text","text":"numbered from 1; isolated vertices, when there are any, are layer 1 alone."}]},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClusteringCoefficients"}],"type":"topic","title":"ClusteringCoefficients","navigatorTitle":[{"kind":"identifier","text":"ClusteringCoefficients"}],"url":"\/documentation\/cliques\/clusteringcoefficients","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","kind":"symbol","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one"},{"type":"text","text":" "},{"type":"text","text":"pass."}]},"doc://Cliques/documentation/Cliques/GraphProtocols":{"url":"\/documentation\/cliques\/graphprotocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","abstract":[],"kind":"symbol","role":"collection","type":"topic","title":"GraphProtocols"},"doc://Cliques/documentation/Cliques/TreeDecomposition":{"url":"\/documentation\/cliques\/treedecomposition","abstract":[{"text":"A tree decomposition of a graph: bags of vertices, joined by edges into a tree, such that","type":"text"},{"text":" ","type":"text"},{"text":"every vertex is in a bag, both ends of every edge are together in a bag, and the bags holding","type":"text"},{"text":" ","type":"text"},{"text":"any one vertex form a connected subtree.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TreeDecomposition"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TreeDecomposition"}],"title":"TreeDecomposition"},"doc://Cliques/documentation/Cliques":{"role":"collection","type":"topic","title":"Cliques","url":"\/documentation\/cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","kind":"symbol","abstract":[]},"doc://Cliques/documentation/Cliques/TrussNumbers":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrussNumbers","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"TrussNumbers","type":"topic","abstract":[{"text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An","type":"text"},{"text":" ","type":"text"},{"text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at","type":"text"},{"text":" ","type":"text"},{"text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges share their simple edge’s number, and a self-loop has none.","type":"text"}],"url":"\/documentation\/cliques\/trussnumbers","navigat