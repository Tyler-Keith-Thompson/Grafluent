ntation/Cliques/TreeDecomposition":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","abstract":[{"text":"A tree decomposition of a graph: bags of vertices, joined by edges into a tree, such that","type":"text"},{"text":" ","type":"text"},{"text":"every vertex is in a bag, both ends of every edge are together in a bag, and the bags holding","type":"text"},{"text":" ","type":"text"},{"text":"any one vertex form a connected subtree.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"TreeDecomposition","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeDecomposition","kind":"identifier"}],"url":"\/documentation\/cliques\/treedecomposition","title":"TreeDecomposition","type":"topic"},"doc://Cliques/documentation/Cliques":{"url":"\/documentation\/cliques","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","role":"collection","abstract":[],"kind":"symbol"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"CoreNumbers","kind":"identifier"}],"abstract":[{"text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at","type":"text"},{"text":" ","type":"text"},{"text":"least k neighbors.","type":"text"}],"url":"\/documentation\/cliques\/corenumbers","title":"CoreNumbers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"kind":"symbol","title":"MaximalCliques","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"type":"topic"},"doc://Cliques/documentation/Cliques/TrussNumbers":{"navigatorTitle":[{"kind":"identifier","text":"TrussNumbers"}],"abstract":[{"type":"text","text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An"},{"type":"text","text":" "},{"type":"text","text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at"},{"type":"text","text":" "},{"type":"text","text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges share their simple edge’s number, and a self-loop has none."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers","kind":"symbol","url":"\/documentation\/cliques\/trussnumbers","title":"TrussNumbers","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrussNumbers"}]},"doc://Cliques/documentation/Cliques/OnionLayers":{"navigatorTitle":[{"text":"OnionLayers","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OnionLayers","kind":"identifier"}],"abstract":[{"type":"text","text":"The onion decomposition of an undirected graph’s simple graph: each vertex’s layer, a"},{"type":"text","text":" "},{"type":"text","text":"refinement of the core decomposition in which every layer lies inside one k-shell. Layers are"},{"type":"text","text":" "},{"type":"text","text":"numbered from 1; isolated vertices, when there are any, are layer 1 alone."}],"url":"\/documentation\/cliques\/onionlayers","title":"OnionLayers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"type":"topic","role":"collection","url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols"},"doc://Cliques/documentation/Cliques/AllCliques":{"navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"url":"\/documentation\/cliques\/allcliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","title":"AllCliques","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/BronKerboschEvents":{"navigatorTitle":[{"text":"BronKerboschEvents","kind":"identifier"}],"abstract":[{"text":"The Bron–Kerbosch algorithm with pivoting as a sequence of ","type":"text"},{"type":"codeVoice","code":"BronKerboschEvent"},{"text":"s: the search of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maximalCliques()"},{"text":", one clique at a time. Pulling an event past the last one kept runs the","type":"text"},{"text":" ","type":"text"},{"text":"search to its next maximal clique and keeps the events on the way.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","kind":"symbol","title":"BronKerboschEvents","url":"\/documentation\/cliques\/bronkerboschevents","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvents","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/BronKerboschEvent":{"navigatorTitle":[{"text":"BronKerboschEvent","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvent","kind":"identifier"}],"abstract":[{"type":"text","text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" runs"},{"type":"text","text":" "},{"type":"text","text":"it."}],"url":"\/documentation\/cliques\/bronkerboschevent","title":"BronKerboschEvent","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent","type":"topic","role":"symbol"}}}