{"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers"]},{"generated":true,"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent"]},{"generated":true,"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"]}],"sections":[],"variants":[{"paths":["\/documentation\/cliques"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques","interfaceLanguage":"swift"},"metadata":{"externalID":"Cliques","symbolKind":"module","role":"collection","modules":[{"name":"Cliques"}],"title":"Cliques","roleHeading":"Framework"},"references":{"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","abstract":[],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection","kind":"symbol"},"doc://Cliques/documentation/Cliques/TrussNumbers":{"title":"TrussNumbers","kind":"symbol","navigatorTitle":[{"text":"TrussNumbers","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers","url":"\/documentation\/cliques\/trussnumbers","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrussNumbers","kind":"identifier"}],"abstract":[{"type":"text","text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An"},{"type":"text","text":" "},{"type":"text","text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at"},{"type":"text","text":" "},{"type":"text","text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges share their simple edge’s number, and a self-loop has none."}],"role":"symbol"},"doc://Cliques/documentation/Cliques/TreeDecomposition":{"title":"TreeDecomposition","type":"topic","abstract":[{"text":"A tree decomposition of a graph: bags of vertices, joined by edges into a tree, such that","type":"text"},{"text":" ","type":"text"},{"text":"every vertex is in a bag, both ends of every edge are together in a bag, and the bags holding","type":"text"},{"text":" ","type":"text"},{"text":"any one vertex form a connected subtree.","type":"text"}],"url":"\/documentation\/cliques\/treedecomposition","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","role":"symbol","navigatorTitle":[{"text":"TreeDecomposition","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeDecomposition","kind":"identifier"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/BronKerboschEvent":{"title":"BronKerboschEvent","url":"\/documentation\/cliques\/bronkerboschevent","abstract":[{"text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":" runs","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BronKerboschEvent"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BronKerboschEvent"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","title":"MaximalCliques","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol"},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"navigatorTitle":[{"kind":"identifier","text":"ClusteringCoefficients"}],"abstract":[{"text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one","type":"text"},{"text":" ","type":"text"},{"text":"pass.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClusteringCoefficients"}],"url":"\/documentation\/cliques\/clusteringcoefficients","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","title":"ClusteringCoefficients"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"kind":"symbol","title":"CoreNumbers","navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","url":"\/documentation\/cliques\/corenumbers","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreNumbers"}],"abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A"},{"type":"text","text":" "},{"type":"text","text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at"},{"type":"text","text":" "},{"type":"text","text":"least k neighbors."}],"role":"symbol"},"doc://Cliques/documentation/Cliques/OnionLayers":{"abstract":[{"text":"The onion decomposition of an undirected graph’s simple graph: each vertex’s layer, a","type":"text"},{"text":" ","type":"text"},{"text":"refinement of the core decomposition in which every layer lies inside one k-shell. Layers are","type":"text"},{"text":" ","type":"text"},{"text":"numbered from 1; isolated vertices, when there are any, are layer 1 alone.","type":"text"}],"navigatorTitle":[{"text":"OnionLayers","kind":"identifier"}],"role":"symbol","url":"\/documentation\/cliques\/onionlayers","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","title":"OnionLayers","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OnionLayers","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/AllCliques":{"title":"AllCliques","url":"\/documentation\/cliques\/allcliques","abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AllCliques"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllCliques"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","type":"topic","url":"\/documentation\/cliques\/graphprotocols","abstract":[],"role":"collection"},"doc://Cliques/documentation/Cliques/BronKerboschEvents":{"abstract":[{"type":"text","text":"The Bron–Kerbosch algorithm with pivoting as a sequence of "},{"type":"codeVoice","code":"BronKerboschEvent"},{"type":"text","text":"s: the search of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":", one clique at a time. Pulling an event past the last one kept runs the"},{"type":"text","text":" "},{"type":"text","text":"search to its next maximal clique and keeps the events on the way."}],"navigatorTitle":[{"text":"BronKerboschEvents","kind":"identifier"}],"role":"symbol","url":"\/documentation\/cliques\/bronkerboschevents","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","title":"BronKerboschEvents","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvents","kind":"identifier"}]}}}