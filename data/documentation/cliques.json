ntation/Cliques/MaximalCliques":{"kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","type":"topic","role":"symbol","title":"MaximalCliques"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"role":"collection","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cliques\/graphprotocols","title":"GraphProtocols"},"doc://Cliques/documentation/Cliques/BronKerboschEvent":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BronKerboschEvent"}],"type":"topic","url":"\/documentation\/cliques\/bronkerboschevent","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent","navigatorTitle":[{"kind":"identifier","text":"BronKerboschEvent"}],"title":"BronKerboschEvent","abstract":[{"type":"text","text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" runs"},{"type":"text","text":" "},{"type":"text","text":"it."}]},"doc://Cliques/documentation/Cliques/TrussNumbers":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrussNumbers"}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers","url":"\/documentation\/cliques\/trussnumbers","navigatorTitle":[{"kind":"identifier","text":"TrussNumbers"}],"title":"TrussNumbers","abstract":[{"text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An","type":"text"},{"text":" ","type":"text"},{"text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at","type":"text"},{"text":" ","type":"text"},{"text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"edges share their simple edge’s number, and a self-loop has none."}]},"doc://Cliques/documentation/Cliques/BronKerboschEvents":{"role":"symbol","navigatorTitle":[{"text":"BronKerboschEvents","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","abstract":[{"type":"text","text":"The Bron–Kerbosch algorithm with pivoting as a sequence of "},{"code":"BronKerboschEvent","type":"codeVoice"},{"type":"text","text":"s: the search of"},{"type":"text","text":" "},{"code":"maximalCliques()","type":"codeVoice"},{"type":"text","text":", one clique at a time. Pulling an event past the last one kept runs the"},{"type":"text","text":" "},{"type":"text","text":"search to its next maximal clique and keeps the events on the way."}],"type":"topic","kind":"symbol","title":"BronKerboschEvents","url":"\/documentation\/cliques\/bronkerboschevents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvents","kind":"identifier"}]},"doc://Cliques/documentation/Cliques":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","url":"\/documentation\/cliques","title":"Cliques","abstract":[]},"doc://Cliques/documentation/Cliques/CoreNumbers":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CoreNumbers"}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","url":"\/documentation\/cliques\/corenumbers","navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}],"title":"CoreNumbers","abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A"},{"type":"text","text":" "},{"type":"text","text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at"},{"type":"text","text":" "},{"type":"text","text":"least k neighbors."}]},"doc://Cliques/documentation/Cliques/TreeDecomposition":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","navigatorTitle":[{"text":"TreeDecomposition","kind":"identifier"}],"url":"\/documentation\/cliques\/treedecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeDecomposition","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A tree decomposition of a graph: bags of vertices, joined by edges into a tree, such that","type":"text"},{"text":" ","type":"text"},{"text":"every vertex is in a bag, both ends of every edge are together in a bag, and the bags holding","type":"text"},{"text":" ","type":"text"},{"text":"any one vertex form a connected subtree.","type":"text"}],"title":"TreeDecomposition","role":"symbol"},"doc://Cliques/documentation/Cliques/OnionLayers":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OnionLayers","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","url":"\/documentation\/cliques\/onionlayers","type":"topic","navigatorTitle":[{"text":"OnionLayers","kind":"identifier"}],"title":"OnionLayers","abstract":[{"type":"text","text":"The onion decomposition of an undirected graph’s simple graph: each vertex’s layer, a"},{"type":"text","text":" "},{"type":"text","text":"refinement of the core decomposition in which every layer lies inside one k-shell. Layers are"},{"type":"text","text":" "},{"type":"text","text":"numbered from 1; isolated vertices, when there are any, are layer 1 alone."}]},"doc://Cliques/documentation/Cliques/AllCliques":{"url":"\/documentation\/cliques\/allcliques","type":"topic","kind":"symbol","abstract":[{"text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,","type":"text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","title":"AllCliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"role":"symbol"}}}