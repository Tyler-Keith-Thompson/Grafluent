s","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one"},{"type":"text","text":" "},{"type":"text","text":"pass."}]},"doc://Cliques/documentation/Cliques/TreeDecomposition":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TreeDecomposition"}],"url":"\/documentation\/cliques\/treedecomposition","abstract":[{"text":"A tree decomposition of a graph: bags of vertices, joined by edges into a tree, such that","type":"text"},{"text":" ","type":"text"},{"text":"every vertex is in a bag, both ends of every edge are together in a bag, and the bags holding","type":"text"},{"text":" ","type":"text"},{"text":"any one vertex form a connected subtree.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TreeDecomposition"}],"kind":"symbol","title":"TreeDecomposition","role":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","role":"collection","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols","type":"topic","abstract":[]},"doc://Cliques/documentation/Cliques/TrussNumbers":{"navigatorTitle":[{"text":"TrussNumbers","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TrussNumbers","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers","abstract":[{"text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An","type":"text"},{"text":" ","type":"text"},{"text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at","type":"text"},{"text":" ","type":"text"},{"text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges share their simple edge’s number, and a self-loop has none.","type":"text"}],"url":"\/documentation\/cliques\/trussnumbers","title":"TrussNumbers","type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques/BronKerboschEvents":{"navigatorTitle":[{"text":"BronKerboschEvents","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvents","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","url":"\/documentation\/cliques\/bronkerboschevents","role":"symbol","title":"BronKerboschEvents","abstract":[{"text":"The Bron–Kerbosch algorithm with pivoting as a sequence of ","type":"text"},{"code":"BronKerboschEvent","type":"codeVoice"},{"text":"s: the search of","type":"text"},{"text":" ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":", one clique at a time. Pulling an event past the last one kept runs the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"search to its next maximal clique and keeps the events on the way."}]},"doc://Cliques/documentation/Cliques/OnionLayers":{"kind":"symbol","role":"symbol","title":"OnionLayers","abstract":[{"text":"The onion decomposition of an undirected graph’s simple graph: each vertex’s layer, a","type":"text"},{"text":" ","type":"text"},{"text":"refinement of the core decomposition in which every layer lies inside one k-shell. Layers are","type":"text"},{"text":" ","type":"text"},{"text":"numbered from 1; isolated vertices, when there are any, are layer 1 alone.","type":"text"}],"url":"\/documentation\/cliques\/onionlayers","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OnionLayers","kind":"identifier"}],"navigatorTitle":[{"text":"OnionLayers","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers"},"doc://Cliques/documentation/Cliques/BronKerboschEvent":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BronKerboschEvent"}],"abstract":[{"type":"text","text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" runs"},{"type":"text","text":" "},{"type":"text","text":"it."}],"url":"\/documentation\/cliques\/bronkerboschevent","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"BronKerboschEvent"}],"title":"BronKerboschEvent","kind":"symbol"},"doc://Cliques/documentation/Cliques/AllCliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"abstract":[{"text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,","type":"text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"url":"\/documentation\/cliques\/allcliques","role":"symbol","type":"topic","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"title":"AllCliques","kind":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"url":"\/documentation\/cliques\/maximalcliques","role":"symbol","type":"topic","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","kind":"symbol"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"CoreNumbers","kind":"identifier"}],"navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","title":"CoreNumbers","url":"\/documentation\/cliques\/corenumbers","abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A"},{"type":"text","text":" "},{"type":"text","text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at"},{"type":"text","text":" "},{"type":"text","text":"least k neighbors."}]}}}