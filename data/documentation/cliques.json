Numbers":{"navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","url":"\/documentation\/cliques\/corenumbers","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreNumbers","kind":"identifier"}],"abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik; NetworkX "},{"type":"codeVoice","code":"core_number"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"type":"codeVoice","code":"coreness"},{"text":", JGraphT ","type":"text"},{"code":"Coreness","type":"codeVoice"},{"text":"), over its simple graph: a vertex’s core number","type":"text"},{"text":" ","type":"text"},{"text":"is the largest k such that it lies in a subgraph where every vertex has at least k neighbors.","type":"text"}],"role":"symbol","kind":"symbol","title":"CoreNumbers","type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","kind":"symbol","title":"MaximalCliques","type":"topic"},"doc://Cliques/documentation/Cliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","abstract":[],"role":"collection","kind":"symbol","title":"Cliques","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","url":"\/documentation\/cliques\/graphprotocols","abstract":[],"kind":"symbol","type":"topic","role":"collection"}}}