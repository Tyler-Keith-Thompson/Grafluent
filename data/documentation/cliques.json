bstract":[],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/cliques","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"url":"\/documentation\/cliques\/graphprotocols","type":"topic","kind":"symbol","title":"GraphProtocols","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","role":"collection"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/CoreNumbers":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}],"kind":"symbol","url":"\/documentation\/cliques\/corenumbers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreNumbers"}],"type":"topic","title":"CoreNumbers","abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik; NetworkX "},{"type":"codeVoice","code":"core_number"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"type":"codeVoice","code":"coreness"},{"text":", JGraphT ","type":"text"},{"type":"codeVoice","code":"Coreness"},{"text":"), over its simple graph: a vertex’s core number","type":"text"},{"text":" ","type":"text"},{"text":"is the largest k such that it lies in a subgraph where every vertex has at least k neighbors.","type":"text"}]}}}