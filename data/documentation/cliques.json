{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques","interfaceLanguage":"swift"},"metadata":{"role":"collection","symbolKind":"module","title":"Cliques","externalID":"Cliques","modules":[{"name":"Cliques"}],"roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"]}],"references":{"doc://Cliques/documentation/Cliques/TreeDecomposition":{"navigatorTitle":[{"text":"TreeDecomposition","kind":"identifier"}],"title":"TreeDecomposition","role":"symbol","url":"\/documentation\/cliques\/treedecomposition","abstract":[{"text":"A tree decomposition of a graph: bags of vertices, joined by edges into a tree, such that","type":"text"},{"text":" ","type":"text"},{"text":"every vertex is in a bag, both ends of every edge are together in a bag, and the bags holding","type":"text"},{"text":" ","type":"text"},{"text":"any one vertex form a connected subtree.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeDecomposition","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/BronKerboschEvent":{"type":"topic","abstract":[{"text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":" runs","type":"text"},{"text":" ","type":"text"},{"text":"it.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"BronKerboschEvent"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BronKerboschEvent"}],"title":"BronKerboschEvent","url":"\/documentation\/cliques\/bronkerboschevent"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","kind":"symbol","role":"collection","title":"GraphProtocols","url":"\/documentation\/cliques\/graphprotocols"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","role":"symbol","url":"\/documentation\/cliques\/maximalcliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/BronKerboschEvents":{"navigatorTitle":[{"text":"BronKerboschEvents","kind":"identifier"}],"title":"BronKerboschEvents","role":"symbol","url":"\/documentation\/cliques\/bronkerboschevents","abstract":[{"text":"The Bron–Kerbosch algorithm with pivoting as a sequence of ","type":"text"},{"type":"codeVoice","code":"BronKerboschEvent"},{"text":"s: the search of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maximalCliques()"},{"text":", one clique at a time. Pulling an event past the last one kept runs the","type":"text"},{"text":" ","type":"text"},{"text":"search to its next maximal clique and keeps the events on the way.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvents","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvents","type":"topic"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"type":"topic","abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A"},{"type":"text","text":" "},{"type":"text","text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at"},{"type":"text","text":" "},{"type":"text","text":"least k neighbors."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"CoreNumbers","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}],"title":"CoreNumbers","url":"\/documentation\/cliques\/corenumbers"},"doc://Cliques/documentation/Cliques/TrussNumbers":{"navigatorTitle":[{"kind":"identifier","text":"TrussNumbers"}],"title":"TrussNumbers","role":"symbol","url":"\/documentation\/cliques\/trussnumbers","abstract":[{"text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An","type":"text"},{"text":" ","type":"text"},{"text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at","type":"text"},{"text":" ","type":"text"},{"text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"edges share their simple edge’s number, and a self-loop has none."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TrussNumbers"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TrussNumbers","type":"topic"},"doc://Cliques/documentation/Cliques/AllCliques":{"navigatorTitle":[{"kind":"identifier","text":"AllCliques"}],"title":"AllCliques","role":"symbol","url":"\/documentation\/cliques\/allcliques","abstract":[{"text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,","type":"text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","type":"topic","url":"\/documentation\/cliques\/clusteringcoefficients","navigatorTitle":[{"text":"ClusteringCoefficients","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClusteringCoefficients","kind":"identifier"}],"abstract":[{"text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one","type":"text"},{"text":" ","type":"text"},{"text":"pass.","type":"text"}],"title":"ClusteringCoefficients"},"doc://Cliques/documentation/Cliques/OnionLayers":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/OnionLayers","abstract":[{"type":"text","text":"The onion decomposition of an undirected graph’s simple graph: each vertex’s layer, a"},{"type":"text","text":" "},{"type":"text","text":"refinement of the core decomposition in which every layer lies inside one k-shell. Layers are"},{"type":"text","text":" "},{"type":"text","text":"numbered from 1; isolated vertices, when there are any, are layer 1 alone."}],"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"OnionLayers"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OnionLayers"}],"kind":"symbol","url":"\/documentation\/cliques\/onionlayers","title":"OnionLayers"},"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","kind":"symbol","role":"collecti