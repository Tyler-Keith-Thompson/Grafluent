{"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"],"title":"Structures","generated":true},{"anchor":"Extended-Modules","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"],"title":"Extended Modules","generated":true}],"variants":[{"paths":["\/documentation\/cliques"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"Cliques"}],"symbolKind":"module","role":"collection","title":"Cliques","roleHeading":"Framework","externalID":"Cliques"},"references":{"doc://Cliques/documentation/Cliques/MaximalCliques":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques":{"type":"topic","url":"\/documentation\/cliques","role":"collection","identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","abstract":[],"kind":"symbol"},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClusteringCoefficients","kind":"identifier"}],"url":"\/documentation\/cliques\/clusteringcoefficients","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","navigatorTitle":[{"text":"ClusteringCoefficients","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one","type":"text"},{"text":" ","type":"text"},{"text":"pass.","type":"text"}],"title":"ClusteringCoefficients"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"abstract":[{"text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at","type":"text"},{"text":" ","type":"text"},{"text":"least k neighbors.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}],"url":"\/documentation\/cliques\/corenumbers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","title":"CoreNumbers","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreNumbers","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/GraphProtocols":{"abstract":[],"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols"}}}