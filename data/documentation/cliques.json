e"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"average_clustering","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClusteringCoefficients"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ClusteringCoefficients"}]},"doc://Cliques/documentation/Cliques/CoreNumbers":{"url":"\/documentation\/cliques\/corenumbers","role":"symbol","title":"CoreNumbers","type":"topic","abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik; NetworkX "},{"type":"codeVoice","code":"core_number"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"type":"codeVoice","code":"coreness"},{"text":", JGraphT ","type":"text"},{"code":"Coreness","type":"codeVoice"},{"text":"), over its simple graph: a vertex’s core number","type":"text"},{"text":" ","type":"text"},{"text":"is the largest k such that it lies in a subgraph where every vertex has at least k neighbors.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreNumbers"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CoreNumbers"}]},"doc://Cliques/documentation/Cliques/MaximalCliques":{"title":"MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}]}}}