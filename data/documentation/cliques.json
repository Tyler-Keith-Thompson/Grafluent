{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]},{"title":"Extended Modules","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"],"anchor":"Extended-Modules","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques"},"kind":"symbol","metadata":{"symbolKind":"module","roleHeading":"Framework","modules":[{"name":"Cliques"}],"title":"Cliques","role":"collection","externalID":"Cliques"},"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques"]}],"references":{"doc://Cliques/documentation/Cliques/GraphProtocols":{"kind":"symbol","type":"topic","url":"\/documentation\/cliques\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","abstract":[],"role":"collection"},"doc://Cliques/documentation/Cliques":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"kind":"symbol","role":"collection","title":"Cliques","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/CoreNumbers":{"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreNumbers","kind":"identifier"}],"navigatorTitle":[{"text":"CoreNumbers","kind":"identifier"}],"title":"CoreNumbers","url":"\/documentation\/cliques\/corenumbers","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/CoreNumbers","abstract":[{"type":"text","text":"The core decomposition of an undirected graph (Batagelj–Zaversnik), over its simple graph. A"},{"type":"text","text":" "},{"type":"text","text":"vertex’s core number is the largest k such that it lies in a subgraph where every vertex has at"},{"type":"text","text":" "},{"type":"text","text":"least k neighbors."}],"role":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","title":"MaximalCliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/ClusteringCoefficients":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/ClusteringCoefficients","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of an undirected graph’s simple graph, from one"},{"type":"text","text":" "},{"type":"text","text":"pass."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClusteringCoefficients","kind":"identifier"}],"title":"ClusteringCoefficients","navigatorTitle":[{"text":"ClusteringCoefficients","kind":"identifier"}],"url":"\/documentation\/cliques\/clusteringcoefficients"}}}