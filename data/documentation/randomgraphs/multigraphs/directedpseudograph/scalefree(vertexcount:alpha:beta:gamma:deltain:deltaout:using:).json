er":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deltaOut"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"DirectedPseudograph","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"modules":[{"name":"RandomGraphs","relatedModules":["Multigraphs"]}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/randomgraphs\/multigraphs\/directedpseudograph\/scalefree(vertexcount:alpha:beta:gamma:deltain:deltaout:using:)"]}],"abstract":[{"type":"text","text":"The directed scale-free graph of Bollobás, Borgs, Chayes and Riordan, whose in- and"},{"type":"text","text":" "},{"type":"text","text":"out-degrees both follow power laws:"}],"hierarchy":{"paths":[["doc:\/\/RandomGraphs\/documentation\/RandomGraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaleFree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"n","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"alpha","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.41, ","kind":"text"},{"text":"beta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.54, ","kind":"text"},{"text":"gamma","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.05, ","kind":"text"},{"text":"deltaIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.2, ","kind":"text"},{"text":"deltaOut","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"DirectedPseudograph","kind":"typeIdentifier","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Béla Bollobás, Christian Borgs, Jennifer Chayes and Oliver Riordan. Directed scale-free"},{"type":"text","text":" "},{"type":"text","text":"graphs. "},{"type":"emphasis","inlineContent":[{"text":"Proceedings of the 14th ACM–SIAM Symposium on Discrete Algorithms","type":"text"}]},{"type":"text","text":" (SODA 2003),"},{"type":"text","text":" "},{"type":"text","text":"132–139."}]}],"name":"Note"},{"type":"paragraph","inlineContent":[{"text":"It starts from the directed cycle 0 → 1 → 2 → 0 and adds one arc per step until there are","type":"text"},{"text":" ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" vertices. With probability α the step adds a new vertex v → w; with","type":"text"},{"text":" ","type":"text"},{"text":"probability β an arc v → w between existing vertices; otherwise (γ) an arc v → w to a new","type":"text"},{"text":" ","type":"text"},{"text":"vertex w. An existing source is drawn with probability proportional to its out-degree plus","type":"text"},{"text":" ","type":"text"},{"code":"deltaOut","type":"codeVoice"},{"text":", an existing target to its in-degree plus ","type":"text"},{"code":"deltaIn","type":"codeVoice"},{"text":": with probability","type":"text"},{"text":" ","type":"text"},{"text":"nδ\/(nδ + m) a uniform vertex (new ones included), else the source (or target) of a uniform","type":"text"},{"text":" ","type":"text"},{"text":"arc. New vertices take the next number. Self-loops and parallel arcs occur. The arcs are at","type":"text"},{"text":" ","type":"text"},{"text":"positions ","type":"text"},{"code":"0..<m","type":"codeVoice"},{"text":" in the order they were added, the cycle first.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(m) expected, with m ≈ (n − 3)\/(α + γ) + 3 arcs.","type":"text"}]}],"name":"Complexity"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"vertexCount ≥ 3"},{"type":"text","text":"; α, β and γ positive, summing to 1 within 10⁻⁹; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"deltaIn"},{"type":"text","text":", "},{"type":"codeVoice","code":"deltaOut"},{"type":"text","text":" non-negative and finite."}],"type":"paragraph"}],"name":"Precondition"}]