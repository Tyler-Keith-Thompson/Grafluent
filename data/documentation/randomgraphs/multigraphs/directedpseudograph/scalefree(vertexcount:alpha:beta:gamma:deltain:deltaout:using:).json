0, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"DirectedPseudograph","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"name":"Note","content":[{"inlineContent":[{"text":"Béla Bollobás, Christian Borgs, Jennifer Chayes and Oliver Riordan. Directed scale-free","type":"text"},{"text":" ","type":"text"},{"text":"graphs. ","type":"text"},{"inlineContent":[{"type":"text","text":"Proceedings of the 14th ACM–SIAM Symposium on Discrete Algorithms"}],"type":"emphasis"},{"text":" (SODA 2003),","type":"text"},{"text":" ","type":"text"},{"text":"132–139.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"inlineContent":[{"text":"It starts from the directed cycle 0 → 1 → 2 → 0 and adds one arc per step until there are","type":"text"},{"text":" ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" vertices. With probability α the step adds a new vertex v → w; with","type":"text"},{"text":" ","type":"text"},{"text":"probability β an arc v → w between existing vertices; otherwise (γ) an arc v → w to a new","type":"text"},{"text":" ","type":"text"},{"text":"vertex w. An existing source is drawn with probability proportional to its out-degree plus","type":"text"},{"text":" ","type":"text"},{"code":"deltaOut","type":"codeVoice"},{"text":", an existing target to its in-degree plus ","type":"text"},{"code":"deltaIn","type":"codeVoice"},{"text":": with probability","type":"text"},{"text":" ","type":"text"},{"text":"nδ\/(nδ + m) a uniform vertex (new ones included), else the source (or target) of a uniform","type":"text"},{"text":" ","type":"text"},{"text":"arc. New vertices take the next number. Self-loops and parallel arcs occur. The arcs are at","type":"text"},{"text":" ","type":"text"},{"text":"positions ","type":"text"},{"code":"0..<m","type":"codeVoice"},{"text":" in the order they were added, the cycle first.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m) expected, with m ≈ (n − 3)\/(α + γ) + 3 arcs."}]}],"style":"note","type":"aside"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"vertexCount ≥ 3","type":"codeVoice"},{"text":"; α, β and γ positive, summing to 1 within 10⁻⁹; and","type":"text"},{"text":" ","type":"text"},{"code":"deltaIn","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deltaOut","type":"codeVoice"},{"text":" non-negative and finite.","type":"text"}]}],"style":"note","type":"aside"}]}],"kind":"symbol","sections":[],"metadata":{"externalID":"s:11Multigraphs19DirectedPseudographV12RandomGraphsSiRszrlE9scaleFree11vertexCount5alpha4beta5gamma7deltaIn0M3Out5usingACySiGSi_S5dqd__ztSGRd__lFZ","extendedModule":"Multigraphs","role":"symbol","remoteSource":{"fileName":"ScaleFree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/RandomGraphs\/ScaleFree.swift#L38"},"roleHeading":"Type Method","modules":[{"name":"RandomGraphs","relatedModules":["Multigraphs"]}],"symbolKind":"method","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when