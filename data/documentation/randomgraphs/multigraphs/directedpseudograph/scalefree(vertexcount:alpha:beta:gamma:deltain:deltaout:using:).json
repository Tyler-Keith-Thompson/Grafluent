,"code":"Int"},{"type":"text","text":"."}]},"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/RandomGraphs\/ScaleFree.swift#L38","fileName":"ScaleFree.swift"},"symbolKind":"method","title":"scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)","roleHeading":"Type Method","externalID":"s:11Multigraphs19DirectedPseudographV12RandomGraphsSiRszrlE9scaleFree11vertexCount5alpha4beta5gamma7deltaIn0M3Out5usingACySiGSi_S5dqd__ztSGRd__lFZ","modules":[{"name":"RandomGraphs","relatedModules":["Multigraphs"]}]},"sections":[],"abstract":[{"type":"text","text":"The directed scale-free graph of Bollobás, Borgs, Chayes and Riordan, whose in- and"},{"type":"text","text":" "},{"type":"text","text":"out-degrees both follow power laws:"}],"hierarchy":{"paths":[["doc:\/\/RandomGraphs\/documentation\/RandomGraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/randomgraphs\/multigraphs\/directedpseudograph\/scalefree(vertexcount:alpha:beta:gamma:deltain:deltaout:using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph\/scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaleFree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"n","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"alpha","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.41, ","kind":"text"},{"text":"beta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.54, ","kind":"text"},{"text":"gamma","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.05, ","kind":"text"},{"text":"deltaIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.2, ","kind":"text"},{"text":"deltaOut","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"DirectedPseudograph","kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Béla Bollobás, Christian Borgs, Jennifer Chayes and Oliver Riordan. Directed scale-free","type":"text"},{"text":" ","type":"text"},{"text":"graphs. ","type":"text"},{"inlineContent":[{"text":"Proceedings of the 14th ACM–SIAM Symposium on Discrete Algorithms","type":"text"}],"type":"emphasis"},{"text":" (SODA 2003),","type":"text"},{"text":" ","type":"text"},{"text":"132–139.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It starts from the directed cycle 0 → 1 → 2 → 0 and adds one arc per step until there are"},{"type":"text","text":" "},{"code":"vertexCount","type":"codeVoice"},{"type":"text","text":" vertices. With probability α the step adds a new vertex v → w; with"},{"type":"text","text":" "},{"type":"text","text":"probability β an arc v → w between existing vertices; otherwise (γ) an arc v → w to a new"},{"type":"text","text":" "},{"type":"text","text":"vertex w. An existing source is drawn with probability proportional to its out-degree plus"},{"type":"text","text":" "},{"code":"deltaOut","type":"codeVoice"},{"type":"text","text":", an existing target to its in-degree plus "},{"code":"deltaIn","type":"codeVoice"},{"type":"text","text":": with probability"},{"type":"text","text":" "},{"type":"text","text":"nδ\/(nδ + m) a uniform vertex (new ones included), else the source (or target) of a uniform"},{"type":"text","text":" "},{"type":"text","text":"arc. New vertices take the next number. Self-loops and parallel arcs occur. The arcs are at"},{"type":"text","text":" "},{"type":"text","text":"positions "},{"code":"0..<m","type":"codeVoice"},{"type":"text","text":" in the order they were added, the cycle first."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m) expected, with m ≈ (n − 3)\/(α + γ) + 3 arcs."}]}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"vertexCount ≥ 3","type":"codeVoice"},{"text":"; α, β and γ positive, summing to 1 within 10⁻⁹; and","type":"text"},{"text":" ","type":"text"},{"code":"deltaIn","type":"codeVoice"},{"text":", ","type":"text"},{"code":"deltaOut","type":"codeVoice"},{"text":" non-negative and finite.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://RandomGraphs/documentation/RandomGraphs/Multigraphs/DirectedPseudograph/scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)":{"identifier":"doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph\/scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)","role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"."}]},"abstract":[{"text":"The directed scale-free graph of Bollobás, Borgs, Chayes and Riordan, whose in- and","type":"text"},{"text":" ","type":"text"},{"text":"out-degrees both follow power laws:","type":"text"}],"title":"scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)","kind":"symbol","url":"\/documentation\/randomgraphs\/multigraphs\/directedpseudograph\/scalefree(vertexcount:alpha:beta:gamma:deltain:deltaout:using:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaleFree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"alpha","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"beta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"gamma","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text"