{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaleFree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"n","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"alpha","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.41, ","kind":"text"},{"text":"beta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.54, ","kind":"text"},{"text":"gamma","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.05, ","kind":"text"},{"text":"deltaIn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.2, ","kind":"text"},{"text":"deltaOut","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"DirectedPseudograph","kind":"typeIdentifier","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"Béla Bollobás, Christian Borgs, Jennifer Chayes and Oliver Riordan. Directed scale-free","type":"text"},{"text":" ","type":"text"},{"text":"graphs. ","type":"text"},{"inlineContent":[{"type":"text","text":"Proceedings of the 14th ACM–SIAM Symposium on Discrete Algorithms"}],"type":"emphasis"},{"text":" (SODA 2003),","type":"text"},{"text":" ","type":"text"},{"text":"132–139.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"It starts from the directed cycle 0 → 1 → 2 → 0 and adds one arc per step until there are","type":"text"},{"text":" ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" vertices. With probability α the step adds a new vertex v → w; with","type":"text"},{"text":" ","type":"text"},{"text":"probability β an arc v → w between existing vertices; otherwise (γ) an arc v → w to a new","type":"text"},{"text":" ","type":"text"},{"text":"vertex w. An existing source is drawn with probability proportional to its out-degree plus","type":"text"},{"text":" ","type":"text"},{"code":"deltaOut","type":"codeVoice"},{"text":", an existing target to its in-degree plus ","type":"text"},{"code":"deltaIn","type":"codeVoice"},{"text":": with probability","type":"text"},{"text":" ","type":"text"},{"text":"nδ\/(nδ + m) a uniform vertex (new ones included), else the source (or target) of a uniform","type":"text"},{"text":" ","type":"text"},{"text":"arc. New vertices take the next number. Self-loops and parallel arcs occur. The arcs are at","type":"text"},{"text":" ","type":"text"},{"text":"positions ","type":"text"},{"code":"0..<m","type":"codeVoice"},{"text":" in the order they were added, the cycle first.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(m) expected, with m ≈ (n − 3)\/(α + γ) + 3 arcs.","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"vertexCount ≥ 3","type":"codeVoice"},{"type":"text","text":"; α, β and γ positive, summing to 1 within 10⁻⁹; and"},{"type":"text","text":" "},{"code":"deltaIn","type":"codeVoice"},{"type":"text","text":", "},{"code":"deltaOut","type":"codeVoice"},{"type":"text","text":" non-negative and finite."}]}]}]}],"metadata":{"roleHeading":"Type Method","externalID":"s:11Multigraphs19DirectedPseudographV12RandomGraphsSiRszrlE9scaleFree11vertexCount5alpha4beta5gamma7deltaIn0M3Out5usingACySiGSi_S5dqd__ztSGRd__lFZ","title":"scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)","role":"symbol","modules":[{"name":"RandomGraphs","relatedModules":["Multigraphs"]}],"extendedModule":"Multigraphs","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/RandomGraphs\/ScaleFree.swift#L38","fileName":"ScaleFree.swift"},"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaleFree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alpha"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"beta"},{"kind":"t