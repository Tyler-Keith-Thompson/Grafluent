am"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.41, ","kind":"text"},{"text":"beta","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.54, ","kind":"text"},{"text":"gamma","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.05, ","kind":"text"},{"text":"deltaIn","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.2, ","kind":"text"},{"text":"deltaOut","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SG","text":"RandomNumberGenerator","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV","text":"DirectedPseudograph","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Béla Bollobás, Christian Borgs, Jennifer Chayes and Oliver Riordan. Directed scale-free"},{"type":"text","text":" "},{"type":"text","text":"graphs. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Proceedings of the 14th ACM–SIAM Symposium on Discrete Algorithms"}]},{"type":"text","text":" (SODA 2003),"},{"type":"text","text":" "},{"type":"text","text":"132–139."}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"It starts from the directed cycle 0 → 1 → 2 → 0 and adds one arc per step until there are","type":"text"},{"text":" ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" vertices. With probability α the step adds a new vertex v → w; with","type":"text"},{"text":" ","type":"text"},{"text":"probability β an arc v → w between existing vertices; otherwise (γ) an arc v → w to a new","type":"text"},{"text":" ","type":"text"},{"text":"vertex w. An existing source is drawn with probability proportional to its out-degree plus","type":"text"},{"text":" ","type":"text"},{"code":"deltaOut","type":"codeVoice"},{"text":", an existing target to its in-degree plus ","type":"text"},{"code":"deltaIn","type":"codeVoice"},{"text":": with probability","type":"text"},{"text":" ","type":"text"},{"text":"nδ\/(nδ + m) a uniform vertex (new ones included), else the source (or target) of a uniform","type":"text"},{"text":" ","type":"text"},{"text":"arc. New vertices take the next number. Self-loops and parallel arcs occur. The arcs are at","type":"text"},{"text":" ","type":"text"},{"text":"positions ","type":"text"},{"code":"0..<m","type":"codeVoice"},{"text":" in the order they were added, the cycle first.","type":"text"}]},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m) expected, with m ≈ (n − 3)\/(α + γ) + 3 arcs."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"vertexCount ≥ 3"},{"type":"text","text":"; α, β and γ positive, summing to 1 within 10⁻⁹; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"deltaIn"},{"type":"text","text":", "},{"type":"codeVoice","code":"deltaOut"},{"type":"text","text":" non-negative and finite."}]}]