{"hierarchy":{"paths":[["doc:\/\/RandomGraphs\/documentation\/RandomGraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph"]]},"abstract":[{"text":"The directed scale-free graph of Bollobás, Borgs, Chayes and Riordan, whose in- and","type":"text"},{"text":" ","type":"text"},{"text":"out-degrees both follow power laws:","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaleFree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":" "},{"kind":"internalParam","text":"n"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alpha"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 0.41, "},{"kind":"externalParam","text":"beta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 0.54, "},{"kind":"externalParam","text":"gamma"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 0.05, "},{"kind":"externalParam","text":"deltaIn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 0.2, "},{"kind":"externalParam","text":"deltaOut"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 0, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV","text":"DirectedPseudograph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Béla Bollobás, Christian Borgs, Jennifer Chayes and Oliver Riordan. Directed scale-free","type":"text"},{"text":" ","type":"text"},{"text":"graphs. ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Proceedings of the 14th ACM–SIAM Symposium on Discrete Algorithms"}]},{"text":" (SODA 2003),","type":"text"},{"text":" ","type":"text"},{"text":"132–139.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"It starts from the directed cycle 0 → 1 → 2 → 0 and adds one arc per step until there are"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexCount"},{"type":"text","text":" vertices. With probability α the step adds a new vertex v → w; with"},{"type":"text","text":" "},{"type":"text","text":"probability β an arc v → w between existing vertices; otherwise (γ) an arc v → w to a new"},{"type":"text","text":" "},{"type":"text","text":"vertex w. An existing source is drawn with probability proportional to its out-degree plus"},{"type":"text","text":" "},{"type":"codeVoice","code":"deltaOut"},{"type":"text","text":", an existing target to its in-degree plus "},{"type":"codeVoice","code":"deltaIn"},{"type":"text","text":": with probability"},{"type":"text","text":" "},{"type":"text","text":"nδ\/(nδ + m) a uniform vertex (new ones included), else the source (or target) of a uniform"},{"type":"text","text":" "},{"type":"text","text":"arc. New vertices take the next number. Self-loops and parallel arcs occur. The arcs are at"},{"type":"text","text":" "},{"type":"text","text":"positions "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" in the order they were added, the cycle first."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m) expected, with m ≈ (n − 3)\/(α + γ) + 3 arcs."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"code":"vertexCount ≥ 3","type":"codeVoice"},{"type":"text","text":"; α, β and γ positive, summing to 1 within 10⁻⁹; and"},{"type":"text","text":" "},{"code":"deltaIn","type":"codeVoice"},{"type":"text","text":", "},{"code":"deltaOut","type":"codeVoice"},{"type":"text","text":" non-negative and finite."}],"type":"paragraph"}],"type":"aside"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/randomgraphs\/multigraphs\/directedpseudograph\/scalefree(vertexcount:alpha:beta:gamma:deltain:deltaout:using:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph\/scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"modules":[{"name":"RandomGraphs","relatedModules":["Multigraphs"]}],"externalID":"s:11Multigraphs19DirectedPseudographV12RandomGraphsSiRszrlE9scaleFree11vertexCount5alpha4beta5gamma7deltaIn0M3Out5usingACySiGSi_S5dqd__ztSGRd__lFZ","symbolKind":"method","remoteSource":{"fileName":"ScaleFree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/RandomGraphs\/ScaleFree.swift#L38"},"role":"symbol","roleHeading":"Type Method","fragments":[{"text":"static","kind":"