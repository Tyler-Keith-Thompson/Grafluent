{"sections":[],"abstract":[{"type":"text","text":"The directed scale-free graph of Bollobás, Borgs, Chayes and Riordan, whose in- and"},{"type":"text","text":" "},{"type":"text","text":"out-degrees both follow power laws:"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph\/scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/randomgraphs\/multigraphs\/directedpseudograph\/scalefree(vertexcount:alpha:beta:gamma:deltain:deltaout:using:)"]}],"hierarchy":{"paths":[["doc:\/\/RandomGraphs\/documentation\/RandomGraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs","doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/DirectedPseudograph"]]},"metadata":{"roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaleFree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alpha"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"beta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"gamma"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deltaIn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deltaOut"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"DirectedPseudograph","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"modules":[{"name":"RandomGraphs","relatedModules":["Multigraphs"]}],"role":"symbol","conformance":{"constraints":[{"type":"codeVoice","code":"Vertex"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"extendedModule":"Multigraphs","remoteSource":{"fileName":"ScaleFree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/RandomGraphs\/ScaleFree.swift#L38"},"externalID":"s:11Multigraphs19DirectedPseudographV12RandomGraphsSiRszrlE9scaleFree11vertexCount5alpha4beta5gamma7deltaIn0M3Out5usingACySiGSi_S5dqd__ztSGRd__lFZ","symbolKind":"method","title":"scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scaleFree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"n","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alpha","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.41, ","kind":"text"},{"text":"beta","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.54, ","kind":"text"},{"text":"gamma","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.05, ","kind":"text"},{"text":"deltaIn","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0.2, ","kind":"text"},{"text":"deltaOut","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 0, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SG","text":"RandomNumberGenerator","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:11Multigraphs19DirectedPseudographV","text":"DirectedPseudograph","kind":"typeIdentifier","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Béla Bollobás, Christian Borgs, Jennifer Chayes and Oliver Riordan. Directed scale-free"},{"type":"text","text":" "},{"type":"text","text":"graphs. "},{"inlineContent":[{"type":"text","text":"Proceedings of the 14th ACM–SIAM Symposium on Discrete Algorithms"}],"type":"emphasis"},{"type":"text","text":" (SODA 2003),"},{"type":"text","text":" "},{"type":"text","text":"132–139."}]}],"type":"aside","style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It starts from the directed cycle 0 → 1 → 2 → 0 and adds one arc per step until there are"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexCount"},{"type":"text","text":" vertices. With probability α the step adds a new vertex v → w; with"},{"type":"text","text":" "},{"type":"text","text":"probability β an arc v → w between existing vertices; otherwise (γ) an arc v → w to a new"},{"type":"text","text":" "},{"type":"text","text":"vertex w. An existing source is drawn with probability proportional to its out-degree plus"},{"type":"text","text":" "},{"type":"codeVoice","code":"deltaOut"},{"type":"text","text":", an existing target to its in-degree plus "},{"type":"codeVoice","code":"deltaIn"},{"type":"text","text":": with probability"},{"type":"text","text":" "},{"type":"text","text":"nδ\/(nδ + m) a uniform vertex (new ones included), else the source (or target) of a uniform"},{"type":"text","text":" "},{"type":"text","text":"arc. New vertices take the next number. Self-loops and parallel arcs occur. The arcs are at"},{"type":"text","text":" "},{"type":"text","text":"positions "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" in the order they were added, the cycle first."}]},{"content":[{"inlineContent":[{"type":"text","text":"O(m) expected, with m ≈ (n − 3)\/(α + γ) + 3 arcs."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"vertexCount ≥ 3","type":"codeVoice"},{"type":"text","text":"; α, β and γ positive, summing to 1 within 10⁻⁹; and"},{"type":"text","text":" "},{"code":"deltaIn","type":"codeVoice"},{"type":"text","text":", "},{"code":"deltaOut","type":"codeVoice"},{"type":"text","text":" non-negative and finite."}]}],"type":"aside","style":"note","name":"Precondition"}]}],"references":{"doc://RandomGraphs/documentation/RandomGraphs/Multigraphs/DirectedPseudograph/scaleFree(vertexCount:alpha:beta:gamma:deltaIn:deltaOut:using:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaleFree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alpha"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"beta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"gamma"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deltaIn"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deltaOut"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs19DirectedPseudographV","text":"DirectedPseudograph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"text":"The directed scale-free graph of Bol