y likely, so"},{"type":"text","text":" "},{"type":"text","text":"self-loops and parallel edges occur; a self-loop counts 2 toward its vertex’s degree, and"},{"type":"text","text":" "},{"type":"text","text":"every vertex has exactly its degree. The edges are at positions "},{"code":"0..<m","type":"codeVoice"},{"type":"text","text":" in pairing order,"},{"type":"text","text":" "},{"type":"text","text":"each written (first-half end, second-half end). The shuffle is Fisher–Yates, i from the"},{"type":"text","text":" "},{"type":"text","text":"last stub down to 1 swapped with "},{"code":"below(i + 1)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"configurationModel"},{"kind":"text","text":"("},{"kind":"externalParam","text":"degreeSequence"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Pseudograph","preciseIdentifier":"s:11Multigraphs11PseudographV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"configurationModel(degreeSequence:using:)","url":"\/documentation\/randomgraphs\/multigraphs\/pseudograph\/configurationmodel(degreesequence:using:)"}}}