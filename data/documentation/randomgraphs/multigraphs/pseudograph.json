/Pseudograph\/configurationModel(degreeSequence:using:)","url":"\/documentation\/randomgraphs\/multigraphs\/pseudograph\/configurationmodel(degreesequence:using:)","title":"configurationModel(degreeSequence:using:)","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A random pseudograph with these degrees, by the configuration model: vertex i gets","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"degreeSequence[i]"},{"text":" stubs, the stubs are shuffled, and the k-th stub of the first half is","type":"text"},{"text":" ","type":"text"},{"text":"paired with the k-th of the second half. Every pairing of the stubs is equally likely, so","type":"text"},{"text":" ","type":"text"},{"text":"self-loops and parallel edges occur; a self-loop counts 2 toward its vertex’s degree, and","type":"text"},{"text":" ","type":"text"},{"text":"every vertex has exactly its degree. The edges are at positions ","type":"text"},{"type":"codeVoice","code":"0..<m"},{"text":" in pairing order,","type":"text"},{"text":" ","type":"text"},{"text":"each written (first-half end, second-half end). The shuffle is Fisher–Yates, i from the","type":"text"},{"text":" ","type":"text"},{"text":"last stub down to 1 swapped with ","type":"text"},{"type":"codeVoice","code":"below(i + 1)"},{"text":".","type":"text"}]},"doc://Multigraphs/documentation/Multigraphs/Pseudograph":{"type":"topic","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph","role":"symbol","url":"\/documentation\/multigraphs\/pseudograph","title":"Pseudograph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Pseudograph","kind":"identifier"}],"navigatorTitle":[{"text":"Pseudograph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph that allows parallel edges and self-loops."}]}}}