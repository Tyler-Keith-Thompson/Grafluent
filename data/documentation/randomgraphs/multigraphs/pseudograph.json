:" "},{"type":"text","text":"every vertex has exactly its degree. The edges are at positions "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" in pairing order,"},{"type":"text","text":" "},{"type":"text","text":"each written (first-half end, second-half end). The shuffle is Fisher–Yates, i from the"},{"type":"text","text":" "},{"type":"text","text":"last stub down to 1 swapped with "},{"type":"codeVoice","code":"below(i + 1)"},{"type":"text","text":"."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configurationModel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"degreeSequence","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Pseudograph","preciseIdentifier":"s:11Multigraphs11PseudographV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"configurationModel(degreeSequence:using:)","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}}}}