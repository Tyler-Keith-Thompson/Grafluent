":"maxIterations","type":"codeVoice"},{"type":"text","text":" changes every"},{"type":"text","text":" "},{"type":"text","text":"similarity by less than "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":", with "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" and the last step’s largest"},{"type":"text","text":" "},{"type":"text","text":"change."}]}],"style":"note","type":"aside"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/Graph\/simRankSimilarity(importanceFactor:tolerance:maxIterations:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/similarity\/graphprotocols\/graph\/simranksimilarity(importancefactor:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Similarity/documentation/Similarity/GraphProtocols/Graph/simRankSimilarity(importanceFactor:tolerance:maxIterations:)":{"abstract":[{"type":"text","text":"SimRank (Jeh and Widom): two vertices are similar when their neighbors are similar."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simRankSimilarity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"importanceFactor","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseId