:"s:14GraphProtocols0A0P10SimilarityE07simRankC016importanceFactor9tolerance13maxIterationsAD03SimeC0VyAA12DirectedViewVyxGGSd_SdSitAA13NoConvergenceVYKF"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Similarity\/documentation\/Similarity","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/Graph"]]},"sections":[],"abstract":[{"text":"SimRank (Jeh and Widom): two vertices are similar when their neighbors are similar.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simRankSimilarity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"importanceFactor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.9, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-4, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 1000) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"SimRankSimilarity","kind":"typeIdentifier","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity","preciseIdentifier":"s:10Similarity07SimRankA0V"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"importanceFactor","content":[{"inlineContent":[{"type":"text","text":"C, the decay applied to each step away from the pair."}],"type":"paragraph"}]},{"name":"tolerance","content":[{"inlineContent":[{"type":"text","text":"The largest change in any similarity that counts as converged."}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The most steps to take."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"Every pair’s similarity, symmetric, with 1 on the diagonal.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|Γ(a)| |Γ(b)|) · Σ s(i, j) over i ∈ Γ(a) and","type":"text"},{"text":" ","type":"text"},{"text":"j ∈ Γ(b), or 0 when a or b has no neighbor, where Γ(x) is the set of neighbors of x: parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges count once, and a vertex with a self-loop is its own neighbor. The iteration starts","type":"text"},{"text":" ","type":"text"},{"text":"from s(a, b) = 0 for a ≠ b and stops after the first step whose largest change in any","type":"text"},{"text":" ","type":"text"},{"text":"similarity is below ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":". O(n (n + m)) per step and O(n²) memory, for n vertices and","type":"text"},{"text":" ","type":"text"},{"text":"m edges.","type":"text"}]},{"style":"note","name":"Precondition","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"importanceFactor","type":"codeVoice"},{"text":" is between 0 and 1, exclusive; ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}]},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when no step of the first ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" changes every","type":"text"},{"text":" ","type":"text"},{"text":"similarity by less than ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" and the last step’s largest","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","role":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/noconvergence","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"title":"NoConvergence"},"doc://Similarity/documentation/Similarity/SimRankSimilarity":{"url":"\/documentation\/similarity\/simranksimilarity","type":"topic","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity","role":"symbol","title":"SimRankSimilarity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SimRankSimilarity"}],"kind":"symbol","abstract":[{"type":"text","text":"SimRank similarities of every pair of vertic