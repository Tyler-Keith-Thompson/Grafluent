{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"roleHeading":"Instance Method","role":"symbol","extendedModule":"GraphProtocols","title":"simRankSimilarity(importanceFactor:tolerance:maxIterations:)","modules":[{"name":"Similarity","relatedModules":["GraphProtocols"]}],"symbolKind":"method","externalID":"s:14GraphProtocols0A0P10SimilarityE07simRankC016importanceFactor9tolerance13maxIterationsAD03SimeC0VyAA12DirectedViewVyxGGSd_SdSitAA13NoConvergenceVYKF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simRankSimilarity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"importanceFactor","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:10Similarity07SimRankA0V","text":"SimRankSimilarity","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Similarity\/SimRank.swift#L213","fileName":"SimRank.swift"}},"kind":"symbol","identifier":{"url":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/Graph\/simRankSimilarity(importanceFactor:tolerance:maxIterations:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"SimRank (Jeh and Widom): two vertices are similar when their neighbors are similar."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simRankSimilarity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"importanceFactor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 0.9, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 1000) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity","text":"SimRankSimilarity","preciseIdentifier":"s:10Similarity07SimRankA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"C, the decay applied to each step away from the pair.","type":"text"}]}],"name":"importanceFactor"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The largest change in any similarity that counts as converged.","type":"text"}]}],"name":"tolerance"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The most steps to take."}]}],"name":"maxIterations"}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"text":"Every pair’s similarity, symmetric, with 1 on the diagonal.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|Γ(a)| |Γ(b)|) · Σ s(i, j) over i ∈ Γ(a) and"},{"type":"text","text":" "},{"type":"text","text":"j ∈ Γ(b), or 0 when a or b has no neighbor, where Γ(x) is the set of neighbors of x: parallel"},{"type":"text","text":" "},{"type":"text","text":"edges count once, and a vertex with a self-loop is its own neighbor. The iteration starts"},{"type":"text","text":" "},{"type":"text","text":"from s(a, b) = 0 for a ≠ b and stops after the first step whose largest change in any"},{"type":"text","text":" "},{"type":"text","text":"similarity is below "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":". O(n (n + m)) per step and O(n²) memory, for n vertices and"},{"type":"text","text":" "},{"type":"text","text":"m edges."}]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"importanceFactor"},{"text":" is between 0 and 1, exclusive; ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" when no step of the first ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" changes every","type":"text"},{"text":" ","type":"text"},{"text":"similarity by less than ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" and the last step’s largest","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/similarity\/graphprotocols\/graph\/simranksimilarity(importancefactor:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Similarity\/documentation\/Similarity","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/Graph"]]},"references":{"doc://Similarity/documentation/Similarity/GraphProtocols":{"role":"collection","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/similarity\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"role":"symbol","kind":"symbol","url":"\/documentation\/graphprotocols\/directedview","abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the two arcs ","type":"text"},{"type":"codeVoice","code":"u→v"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"v→u","type":"codeVoice"},{"type":"text","text":", so "},{"code":"successors","type":"codeVoice"},{"type":"text","text":" and "},{"code":"predecessors","type":"codeVoice"},{"type":"text","text":" are both "},{"code":"neighbors","type":"codeVoice"},{"type":"text","text":", and "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"type":"topic