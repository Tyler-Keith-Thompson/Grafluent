":"text","text":"C, the decay applied to each step away from the pair."}],"type":"paragraph"}]},{"name":"tolerance","content":[{"inlineContent":[{"type":"text","text":"The largest change in any similarity that counts as converged."}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"inlineContent":[{"text":"The most steps to take.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"Every pair’s similarity, symmetric, with 1 on the diagonal.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|Γ(a)| |Γ(b)|) · Σ s(i, j) over i ∈ Γ(a) and"},{"type":"text","text":" "},{"type":"text","text":"j ∈ Γ(b), or 0 when a or b has no neighbor, where Γ(x) is the set of neighbors of x: parallel"},{"type":"text","text":" "},{"type":"text","text":"edges count once, and a vertex with a self-loop is its own neighbor. The iteration starts"},{"type":"text","text":" "},{"type":"text","text":"from s(a, b) = 0 for a ≠ b and stops after the first step whose largest change in any"},{"type":"text","text":" "},{"type":"text","text":"similarity is below "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":". O(n (n + m)) per step and O(n²) memory, for n vertices and"},{"type":"text","text":" "},{"type":"text","text":"m edges."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"importanceFactor","type":"codeVoice"},{"text":" is between 0 and 1, exclusive; ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is at least 1.","type":"text"}]}],"type":"asid