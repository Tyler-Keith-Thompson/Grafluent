{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","abstract":[{"type":"text","text":"SimRank (Jeh and Widom): two vertices are similar when their neighbors are similar."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simRankSimilarity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"importanceFactor"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 0.9, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 1000) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:10Similarity07SimRankA0V","kind":"typeIdentifier","text":"SimRankSimilarity","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"C, the decay applied to each step away from the pair."}],"type":"paragraph"}],"name":"importanceFactor"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The largest change in any similarity that counts as converged.","type":"text"}]}],"name":"tolerance"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The most steps to take."}]}],"name":"maxIterations"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"text":"Every pair’s similarity, symmetric, with 1 on the diagonal.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|Γ(a)| |Γ(b)|) · Σ s(i, j) over i ∈ Γ(a) and"},{"type":"text","text":" "},{"type":"text","text":"j ∈ Γ(b), or 0 when a or b has no neighbor, where Γ(x) is the set of neighbors of x: parallel"},{"type":"text","text":" "},{"type":"text","text":"edges count once, and a vertex with a self-loop is its own neighbor. The iteration starts"},{"type":"text","text":" "},{"type":"text","text":"from s(a, b) = 0 for a ≠ b and stops after the first step whose largest change in any"},{"type":"text","text":" "},{"type":"text","text":"similarity is below "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":". O(n (n + m)) per step and O(n²) memory, for n vertices and"},{"type":"text","text":" "},{"type":"text","text":"m edges."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"importanceFactor","type":"codeVoice"},{"text":" is between 0 and 1, exclusive; ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when no step of the first ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" changes every","type":"text"},{"text":" ","type":"text"},{"text":"similarity by less than ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" and the last step’s largest","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"}],"name":"Throws","type":"aside"}]}],"variants":[{"paths":["\/documentation\/similarity\/graphprotocols\/graph\/simranksimilarity(importancefactor:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/Graph\/simRankSimilarity(importanceFactor:tolerance:maxIterations:)","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Similarity\/documentation\/Similarity","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/Graph"]]},"metadata":{"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P10SimilarityE07simRankC016importanceFactor9tolerance13maxIterationsAD03SimeC0VyAA12DirectedViewVyxGGSd_SdSitAA13NoConvergenceVYKF","modules":[{"relatedModules":["GraphProtocols"],"name":"Similarity"}],"title":"simRankSimilarity(importanceFactor:tolerance:maxIterations:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simRankSimilarity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"importanceFactor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","