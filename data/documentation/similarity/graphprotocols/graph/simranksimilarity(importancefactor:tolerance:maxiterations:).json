eVoice","code":"tolerance"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" is at least 1.","type":"text"}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when no step of the first ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" changes every","type":"text"},{"text":" ","type":"text"},{"text":"similarity by less than ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" and the last step’s largest","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/similarity\/graphprotocols\/graph\/simranksimilarity(importancefactor:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:14GraphProtocols0A0P10SimilarityE07simRankC016importanceFactor9tolerance13maxIterationsAD03SimeC0VyAA12DirectedViewVyxGGSd_SdSitAA13NoConvergenceVYKF","modules":[{"relatedModules":["GraphProtocols"],"name":"Similarity"}],"role":"symbol","title":"simRankSimilarity(importanceFactor:tolerance:maxIterations:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simRankSimilarity"},{"text":"(","kind":"text"},{"text":"importanceFactor","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"