{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"The Adamic–Adar index of "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":": the sum of 1 \/ ln |Γ(w)| over their common neighbors"},{"type":"text","text":" "},{"type":"text","text":"w."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adamicAdarIndex","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"u","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"and","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"v","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}]}]},{"kind":"parameters","parameters":[{"name":"u","content":[{"inlineContent":[{"text":"A vertex of the graph.","type":"text"}],"type":"paragraph"}]},{"name":"v","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A vertex of the graph, possibly "},{"type":"codeVoice","code":"u"},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A common neig