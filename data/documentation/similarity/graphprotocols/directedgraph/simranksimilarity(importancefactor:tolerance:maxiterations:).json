t":" ","kind":"text"},{"text":"simRankSimilarity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"importanceFactor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.9, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-4, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 1000) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"text":"SimRankSimilarity","kind":"typeIdentifier","preciseIdentifier":"s:10Similarity07SimRankA0V","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"C, the decay applied to each step away from the pair."}]}],"name":"importanceFactor"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The largest change in any similarity that counts as converged.","type":"text"}]}],"name":"tolerance"},{"content":[{"inlineContent":[{"text":"The most steps to take.","type":"text"}],"type":"paragraph"}],"name":"maxIterations"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"Every pair’s similarity, symmetric, with 1 on the diagonal.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|I(a)| |I(b)|) · Σ s(i, j) over i ∈ I(a) and","type":"text"},{"text":" ","type":"text"},{"text":"j ∈ I(b), or 0 when a or b has no in-neighbor, where I(x) is the set of predecessors of x:","type":"text"},{"text":" ","type":"text"},{"text":"parallel arcs count once, and a vertex with a self-loop is its own predecessor. The","type":"text"},{"text":" ","type":"text"},{"text":"iteration starts from s(a, b) = 0 for a ≠ b and stops after the first step whose largest","type":"text"},{"text":" ","type":"text"},{"text":"change in any similarity is below ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":". O(n (n + m)) per step and O(n²) memory, for","type":"text"},{"text":" ","type":"text"},{"text":"n vertices and m edges.","type":"text"}]},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"importanceFactor"},{"text":" is between 0 and 1, exclusive; ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when no step of the first "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" changes every"},{"type":"text","text":" "},{"type":"text","text":"similarity by less than "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":", with "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" and the last step’s largest"},{"type":"text","text":" "},{"type":"text","text":"change."}]}],"type":"aside"}],"kind":"content"}],"identifier":{"interfa