03SimfD0VyxGSd_SdSitAA13NoConvergenceVYKF"},"abstract":[{"text":"SimRank (Jeh and Widom): two vertices are similar when the vertices pointing to them are","type":"text"},{"text":" ","type":"text"},{"text":"similar.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simRankSimilarity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"importanceFactor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.9, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-4, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 1000) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"text":"SimRankSimilarity","kind":"typeIdentifier","preciseIdentifier":"s:10Similarity07SimRankA0V","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"importanceFactor","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"C, the decay applied to each step away from the pair."}]}]},{"name":"tolerance","content":[{"inlineContent":[{"text":"The largest change in any similarity that counts as converged.","type":"text"}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"text":"The most steps to take.","type":"text"}]}]}]},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every pair’s similarity, symmetric, with 1 on the diagonal."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|I(a)| |I(b)|) · Σ s(i, j) over i ∈ I(a) and"},{"type":"text","text":" "},{"type":"text","text":"j ∈ I(b), or 0 when a or b has no in-neighbor, where I(x) is the set of predecessors of x:"},{"type":"text","text":" "},{"type":"text","text":"parallel arcs count once, and a vertex with a self-loop is its own predecessor. The"},{"type":"text","text":" "},{"type":"text","text":"iteration starts from s(a, b) = 0 for a ≠ b and stops after the first step whose largest"},{"type":"text","text":" "},{"type":"text","text":"change in any similarity is below "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":". O(n (n + m)) per step and O(n²) memory, for"},{"type":"text","text":" "},{"type":"text","text":"n vertices and m edges."}],"type":"paragraph"},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"importanceFactor"},{"type":"text","text":" is between 0 and 1, exclusive; "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" is positive"},{"type":"text","text":" "},{"type":"text","text":"and finite; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" is at least 1."}],"type":"paragraph"}]},{"name":"Throws","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when no step of the first ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" changes every","type":"text"},{"text":" ","type":"text"},{"text":"similarity by less than ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" and the last step’s largest","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Similarity\/documentation\/Similarity","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/DirectedGraph"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","type":"topic","abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"url":"\/documentation\/graphprotocols\/noconvergence","kind":"symbol","title":"NoConvergence","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}]},"doc://Similarity/documentation/Similarity/GraphProtocols/DirectedGraph/simRankSimilarity(importanceFactor:tolerance:maxIterations:)":{"role":"symbol","abstract":[{"text":"SimRank (Jeh and Widom): two vertices are similar when the vertices pointing to them are","type":"text"},{"text":" ","type":"text"},{"text":"similar.","type":"text"}],"kind":"symbol","type":"topic","title":"simRankSimilarity(importanceFactor:tolerance:maxIterations:)","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/DirectedGraph\/simRankSimilarity(importanceFactor:tolerance:maxIterations:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simRankSimilarity"},{"kind":"text","tex