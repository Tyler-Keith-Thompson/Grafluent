{"abstract":[{"type":"text","text":"SimRank (Jeh and Widom): two vertices are similar when the vertices pointing to them are"},{"type":"text","text":" "},{"type":"text","text":"similar."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/DirectedGraph\/simRankSimilarity(importanceFactor:tolerance:maxIterations:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/similarity\/graphprotocols\/directedgraph\/simranksimilarity(importancefactor:tolerance:maxiterations:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"title":"simRankSimilarity(importanceFactor:tolerance:maxIterations:)","extendedModule":"GraphProtocols","roleHeading":"Instance Method","role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P10SimilarityE07simRankD016importanceFactor9tolerance13maxIterationsAD03SimfD0VyxGSd_SdSitAA13NoConvergenceVYKF","modules":[{"name":"Similarity","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simRankSimilarity","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"importanceFactor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Similarity07SimRankA0V","text":"SimRankSimilarity"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Similarity\/SimRank.swift#L244","fileName":"SimRank.swift"},"symbolKind":"method"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Similarity\/documentation\/Similarity","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/DirectedGraph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simRankSimilarity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"importanceFactor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 0.9, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 1000) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SimRankSimilarity","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity","preciseIdentifier":"s:10Similarity07SimRankA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"C, the decay applied to each step away from the pair."}]}],"name":"importanceFactor"},{"content":[{"inlineContent":[{"type":"text","text":"The largest change in any similarity that counts as converged."}],"type":"paragraph"}],"name":"tolerance"},{"content":[{"inlineContent":[{"text":"The most steps to take.","type":"text"}],"type":"paragraph"}],"name":"maxIterations"}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"Every pair’s similarity, symmetric, with 1 on the diagonal."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|I(a)| |I(b)|) · Σ s(i, j) over i ∈ I(a) and"},{"type":"text","text":" "},{"type":"text","text":"j ∈ I(b), or 0 when a or b has no in-neighbor, where I(x) is the set of predecessors of x:"},{"type":"text","text":" "},{"type":"text","text":"parallel arcs count once, and a vertex with a self-loop is its own predecessor. The"},{"type":"text","text":" "},{"type":"text","text":"iteration starts from s(a, b) = 0 for a ≠ b and stops after the first step whose largest"},{"type":"text","text":" "},{"type":"text","text":"change in any similarity is below "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":". O(n (n + m)) per step and O(n²) memory, for"},{"type":"text","text":" "},{"type":"text","text":"n vertices and m edges."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"importanceFactor","type":"codeVoice"},{"text":" is between 0 and 1, exclusive; ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is at least 1.","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when no step of the first "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" changes every"},{"type":"text","text":" "},{"type":"text","text":"similarity by less than "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":", with "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" and the last step’s largest"},{"type":"text","text":" "},{"type":"text","text":"change."}]}]}]}],"references":{"doc://Similarity/documentation/Similarity/GraphProtocols/DirectedGraph":{"url":"\/documentation\/similarity\/graphprotocols\/directedgraph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"abstract":[],"role":"symbol","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","title":"DirectedGraph"},"doc://Similarity/documentation/Similarity":{"title":"Similarity","kind":"symbol","role":"collection","abstract":[],"identifier":"doc:\/\/Similarity\/documentation\/Similarity","url":"\/documentation\/similarity","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"role":"symbol","abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"symbol","title":"NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoConvergence"}],"type":"topic","navigatorT