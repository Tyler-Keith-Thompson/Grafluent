entation\/Similarity\/GraphProtocols","doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols\/DirectedGraph"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simRankSimilarity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"importanceFactor","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 0.9, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-4, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 1000) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity","text":"SimRankSimilarity","kind":"typeIdentifier","preciseIdentifier":"s:10Similarity07SimRankA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"importanceFactor","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"C, the decay applied to each step away from the pair."}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"text":"The largest change in any similarity that counts as converged.","type":"text"}]}]},{"name":"maxIterations","content":[{"inlineContent":[{"text":"The most steps to take.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"Every pair’s similarity, symmetric, with 1 on the diagonal."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|I(a)| |I(b)|) · Σ s(i, j) over i ∈ I(a) and"},{"type":"text","text":" "},{"type":"text","text":"j ∈ I(b), or 0 when a or b has no in-neighbor, where I(x) is the set of predecessors of x:"},{"type":"text","text":" "},{"type":"text","text":"parallel arcs count once, and a vertex with a self-loop is its own predecessor. The"},{"type":"text","text":" "},{"type":"text","text":"iteration starts from s(a, b) = 0 for a ≠ b and stops after the first step whose largest"},{"type":"text","text":" "},{"type":"text","text":"change in any similarity is below "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":". O(n (n + m)) per step and O(n²) memory, for"},{"type":"text","text":" "},{"type":"text","text":"n vertices and m edges."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"importanceFactor"},{"type":"text","text":" is between 0 and 1, exclusive; "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" is positive"},{"type":"text","text":" "},{"type":"text","text":"and finite; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" is at least 1."}]}]},{"type":"aside","style":"note","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when no step of the first ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" changes every","type":"text"},{"text":" ","type":"text"},{"text":"similarity by less than ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" and the last step’s largest","type":"text"},{"text":" ","type":"text"},{"text":"change.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/similarity\/graphprotocols\/directedgraph\/simranksimilarity(importancefactor:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"SimRank (Jeh and Widom): two vertices are similar when the vertices pointing to them are","type":"text"},{"text":" ","type":"text"},{"text":"similar.","type":"text"}],"references":{"doc://Similarity/documentation/Similarity/GraphProtocols":{"url":"\/documentation\/similarity\/graphprotocols","type":"topic","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/GraphProtocols","role":"collection","title":"GraphProtocols","kind":"symbol","abstract":[]},"doc://Similarity/documentation/Similarity":{"type":"topic","identifier":"doc:\/\/Similarity\/documentation\/Similarity","role":"collection","url":"\/documentation\/similarity","kind":"symbol","abstract":[],"title":"Similarity"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","role":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/noconvergence","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"title":"NoConvergence"},"doc://Similarity/documentation/Similarity/GraphProtocols/DirectedGraph/simRankSimilarity(importanceFactor:tolerance:maxIterations:)":{"url":"\/documentation\/similarity\/graphprotocols\/directedgraph\/simranksimilarity(importa