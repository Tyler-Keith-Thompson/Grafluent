.9, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 1e-4, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 1000) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:10Similarity07SimRankA0V","text":"SimRankSimilarity","kind":"typeIdentifier","identifier":"doc:\/\/Similarity\/documentation\/Similarity\/SimRankSimilarity"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"importanceFactor","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"C, the decay applied to each step away from the pair."}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"text":"The largest change in any similarity that counts as converged.","type":"text"}]}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"text":"The most steps to take.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every pair’s similarity, symmetric, with 1 on the diagonal."}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"S(A, a) = 1, and for a ≠ b, s(a, b) = C \/ (|I(a)| |I(b)|) · Σ s(i, j) over i ∈ I(a) and"},{"type":"text","text":" "},{"type":"text","text":"j ∈ I(b), or 0 when a or b has no in-neighbor, where I(x) is the set of predecessors of x:"},{"type":"text","text":" "},{"type":"text","text":"parallel arcs count once, and a vertex with a self-loop is its own predecessor. The"},{"type":"text","text":" "},{"type":"text","text":"iteration starts from s(a, b) = 0 for a ≠ b and stops after the first step whose largest"},{"type":"text","text":" "},{"type":"text","text":"change in any similarity is below "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":". O(n (n + m)) per step and O(n²) memory, for"},{"type":"text","text":" "},{"type":"text","text":"n vertices and m edges."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"importanceFactor","type":"codeVoice"},{"text":" is between 0 and 1, exclusive; ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" is positive","type":"text"},{"text":" ","type":"text"},{"text":"and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is at least 1.","type":"text"}]}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when no step of the first "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" changes every"},{"type":"text","text":" "},{"type":"text","text":"similarity by less than "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":", with "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" and the last step’s largest"},{"type":"text","text":" "},{"type":"text","text":"change."}],"type":"paragraph"}],"name":"Throws","type":"aside","style":"note"}]}],"variants":[{"paths":["\/documentation\/similarity\/graphprotocols\/directedgraph\/simranksimilarity(importancefactor:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hiera