{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/StableGraphs\/documentation\/StableGraphs","doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph"]]},"sections":[],"identifier":{"url":"doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph\/init(from:)","interfaceLanguage":"swift"},"abstract":[{"text":"Decodes the format ","type":"text"},{"code":"encode(to:)","type":"codeVoice"},{"text":" writes, every position and both ends restored. Throws","type":"text"},{"text":" ","type":"text"},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"text":" for a positions\/values count mismatch, a repeated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"positions that do not strictly increase or that reach past their end, an odd-length edge","type":"text"},{"text":" ","type":"text"},{"text":"list, an endpoint out of range, or an implausible end.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"decoder"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Decoding allocates a page table entry for every page of 1024 positions from the first listed"},{"type":"text","text":" "},{"type":"text","text":"position to the end, and a page for each page holding a listed element; positions before the"},{"type":"text","text":" "},{"type":"text","text":"first listed one cost nothing. An end is implausible when that span is more than"},{"type":"text","text":" "},{"type":"codeVoice","code":"16 × count + 64"},{"type":"text","text":" pages, where "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is the number of vertices (or edges) listed: at most"},{"type":"text","text":" "},{"type":"text","text":"16 page table entries per listed element (about 2 KB for a vertex, 256 bytes for an edge)"},{"type":"text","text":" "},{"type":"text","text":"plus 64. So "},{"type":"codeVoice","code":"\"vertexEnd\": 4611686018427387903"},{"type":"text","text":" with no vertices decodes, in O(1), while a"},{"type":"text","text":" "},{"type":"text","text":"payload cannot make decoding allocate without limit. A graph that has run more than that"},{"type":"text","text":" "},{"type":"text","text":"many empty pages past its live elements does not round-trip."}],"type":"paragraph"}]}],"metadata":{"extendedModule":"StableGraphs","symbolKind":"init","title":"init(from:)","roleHeading":"Initializer","modules":[{"name":"StableGraphs"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"remoteSource":{"fileName":"StableDirectedGraph+Conformances.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/StableGraphs\/StableDirectedGraph+Conformances.swift#L413"},"role":"symbol","externalID":"s:12StableGraphs0A13DirectedGraphVAASeRzrlE4fromACyxGs7Decoder_p_tKcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"kind":"symbol","variants":[{"paths":["\/documentation\/stablegraphs\/stabledirectedgraph\/init(from:)"],