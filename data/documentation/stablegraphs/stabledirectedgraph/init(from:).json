 live elements does not round-trip."}]}]}],"references":{"doc://StableGraphs/documentation/StableGraphs":{"identifier":"doc:\/\/StableGraphs\/documentation\/StableGraphs","type":"topic","abstract":[],"url":"\/documentation\/stablegraphs","kind":"symbol","title":"StableGraphs","role":"collection"},"doc://StableGraphs/documentation/StableGraphs/StableDirectedGraph/init(from:)":{"identifier":"doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph\/init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","url":"\/documentation\/stablegraphs\/stabledirectedgraph\/init(from:)","role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Decodable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","title":"init(from:)","abstract":[{"text":"Decodes the format ","type":"text"},{"type":"codeVoice","code":"encode(to:)"},{"text":" writes, every position and both ends restored. Throws","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"text":" for a positions\/values count mismatch, a repeated vertex,","type":"text"},{"text":" ","type":"text"},{"text":"positions that do not strictly increase or that reach past their end, an odd-length edge","type":"text"},{"text":" ","type":"text"},{"text":"list, an endpoint out of range, or an implausible end.","type":"text"}]},"doc://StableGraphs/documentation/StableGraphs/StableDirectedGraph":{"url":"\/documentation\/stablegraphs\/stabledirectedgra