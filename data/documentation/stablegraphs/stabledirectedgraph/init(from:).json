listed one cost nothing. An end is implausible when that span is more than"},{"type":"text","text":" "},{"type":"codeVoice","code":"16 × count + 64"},{"type":"text","text":" pages, where "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is the number of vertices (or edges) listed: at most"},{"type":"text","text":" "},{"type":"text","text":"16 page table entries per listed element (about 2 KB for a vertex, 256 bytes for an edge)"},{"type":"text","text":" "},{"type":"text","text":"plus 64. So "},{"type":"codeVoice","code":"\"vertexEnd\": 4611686018427387903"},{"type":"text","text":" with no vertices decodes, in O(1), while a"},{"type":"text","text":" "},{"type":"text","text":"payload cannot make decoding allocate without limit. A graph that has run more than that"},{"type":"text","text":" "},{"type":"text","text":"many empty pages past its live elements does not round-trip."}]}]}],"metadata":{"extendedModule":"StableGraphs","externalID":"s:12StableGraphs0A13DirectedGraphVAASeRzrlE4fromACyxGs7Decoder_p_tKcfc","title":"init(from:)","symbolKind":"init","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]},"roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/StableGraphs\/StableDirectedGraph+Conformances.swift#L413","fileName":"StableDirectedGraph+Conformances.swift"},"modules":