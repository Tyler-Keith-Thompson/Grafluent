es not round-trip."}]}],"kind":"content"}],"references":{"doc://StableGraphs/documentation/StableGraphs/StableDirectedGraph":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StableDirectedGraph"}],"abstract":[{"type":"text","text":"A directed graph that allows parallel edges and self-loops, in which a vertex’s or an edge’s"},{"type":"text","text":" "},{"type":"text","text":"position never changes while it exists (petgraph’s "},{"type":"codeVoice","code":"StableDiGraph"},{"type":"text","text":")."}],"title":"StableDirectedGraph","navigatorTitle":[{"kind":"identifier","text":"StableDirectedGraph"}],"role":"symbol","identifier":"doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph","url":"\/documentation\/stablegraphs\/stabledirectedgraph"},"doc://StableGraphs/documentation/StableGraphs/StableDirectedGraph/init(from:)":{"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"type":"topic","title":"init(from:)","abstract":[{"type":"text","text":"Decodes the format "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" writes, every position and both ends restored. Throws"},{"type":"text","text":" "},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"type":"text","text":" for a positions\/values count mismatch, a repeated vertex,"},{"type":"text","text":" "},{"type":"text","text":"positions that do not strictly increase or that reach past their end, an odd-length edge"},{"type":"text","text":" "},{"type":"text","text":"list, an endpoint out of range, or an implausible end."}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conf