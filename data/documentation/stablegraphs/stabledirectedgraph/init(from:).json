more than"},{"type":"text","text":" "},{"code":"16 × count + 64","type":"codeVoice"},{"type":"text","text":" pages, where "},{"code":"count","type":"codeVoice"},{"type":"text","text":" is the number of vertices (or edges) listed: at most"},{"type":"text","text":" "},{"type":"text","text":"16 page table entries per listed element (about 2 KB for a vertex, 256 bytes for an edge)"},{"type":"text","text":" "},{"type":"text","text":"plus 64. So "},{"code":"\"vertexEnd\": 4611686018427387903","type":"codeVoice"},{"type":"text","text":" with no vertices decodes, in O(1), while a"},{"type":"text","text":" "},{"type":"text","text":"payload cannot make decoding allocate without limit. A graph that has run more than that"},{"type":"text","text":" "},{"type":"text","text":"many empty pages past its live elements does not round-trip."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"role":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]},"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"symbolKind":"init","modules":[{"name":"StableGraphs"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/StableGraphs\/StableDirectedGraph+Conformances.swift#L401","fileName":"StableDirectedGraph+Conformances.swift"},"title":"init(from:)","extendedModule":"StableGraphs","externalID":"s:12StableGraphs0A13DirectedGraphVAASeRzrlE4fromACyxGs7Dec