{"hierarchy":{"paths":[["doc:\/\/StableGraphs\/documentation\/StableGraphs","doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph"]]},"abstract":[{"type":"text","text":"Decodes the format "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" writes, every position and both ends restored. Throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for a positions\/values count mismatch, a repeated vertex,"},{"type":"text","text":" "},{"type":"text","text":"positions that do not strictly increase or that reach past their end, an odd-length edge"},{"type":"text","text":" "},{"type":"text","text":"list, an endpoint out of range, or an implausible end."}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"decoder","kind":"internalParam"},{"text":": any ","kind":"text"},{"text":"Decoder","preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding allocates a page table entry for every page of 1024 positions from the first listed"},{"type":"text","text":" "},{"type":"text","text":"position to the end, and a page for each page holding a listed element; positions before the"},{"type":"text","text":" "},{"type":"text","text":"first listed one cost nothing. An end is implausible when that span is more than"},{"type":"text","text":" "},{"code":"16 × count + 64","type":"codeVoice"},{"type":"text","text":" pages, where "},{"code":"count","type":"codeVoice"},{"type":"text","text":" is the number of vertices (or edges) listed: at most"},{"type":"text","text":" "},{"type":"text","text":"16 page table entries per listed element (about 2 KB for a vertex, 256 bytes for an edge)"},{"type":"text","text":" "},{"type":"text","text":"plus 64. So "},{"code":"\"vertexEnd\": 4611686018427387903","type":"codeVoice"},{"type":"text","text":" with no vertices decodes, in O(1), while a"},{"type":"text","text":" "},{"type":"text","text":"payload cannot make decoding allocate without limit. A graph that has run more than that"},{"type":"text","text":" "},{"type":"text","text":"many empty pages past its live elements does not round-trip."}]}]}],"metadata":{"title":"init(from:)","modules":[{"name":"StableGraphs"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7DecoderP","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"remoteSource":{"fileName":"StableDirectedGraph+Conformances.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/StableGraphs\/StableDirectedGraph+Conformances.swift#L384"},"extendedModule":"StableGraphs","symbolKind":"init","roleHeading":"Initializer","externalID":"s:12StableGraphs0A13DirectedGraphVAASeRzrlE4fromACyxGs7Decoder_p_tKcfc","role":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph\/init(from:)"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/stablegr