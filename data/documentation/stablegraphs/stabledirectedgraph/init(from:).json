{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7DecoderP","kind":"typeIdentifier","text":"Decoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"externalID":"s:12StableGraphs0A13DirectedGraphVAASeRzrlE4fromACyxGs7Decoder_p_tKcfc","modules":[{"name":"StableGraphs"}],"extendedModule":"StableGraphs","roleHeading":"Initializer","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Decodable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"symbolKind":"init","title":"init(from:)","role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"decoder","kind":"internalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Decoding allocates a page table entry for every page of 1024 positions from the first listed"},{"type":"text","text":" "},{"type":"text","text":"position to the end, and a page for each page holding a listed element; positions before the"},{"type":"text","text":" "},{"type":"text","text":"first listed one cost nothing. An end is implausible when that span is more than"},{"type":"text","text":" "},{"type":"codeVoice","code":"16 × count + 64"},{"type":"text","text":" pages, where "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is the number of vertices (or edges) listed: at most"},{"type":"text","text":" "},{"type":"text","text":"16 page table entries per listed element (about 2 KB for a vertex, 256 bytes for an edge)"},{"type":"text","text":" "},{"type":"text","text":"plus 64. So "},{"type":"codeVoice","code":"\"vertexEnd\": 4611686018427387903"},{"type":"text","text":" with no vertices decodes, in O(1), while a"},{"type":"text","text":" "},{"type":"text","text":"payload cannot make decoding allocate without limit. A graph that has run more than that"},{"type":"text","text":" "},{"type":"text","text":"many empty pages past its live elements does not round-trip."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/stablegraphs\/stabledirectedgraph\/init(from:)"]}],"abstract":[{"type":"text","text":"Decodes the format "},{"type":"codeVoice","code":"encode(to:)"},{"type":"text","text":" writes, every position and both ends restored. Throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for a positions\/values count mismatch, a repeated vertex,"},{"type":"text","text":" "},{"type":"text","text":"positions that do not strictly increase or that reach past their end, an odd-length edge"},{"type":"text","text":" "},{"type":"text","text":"list, an endpoint out of range, or an implausible end."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph\/init(from:)"},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/StableGraphs\/documentation\/StableGraphs","doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph"]]},"references":{"doc://StableGraphs/documentation/StableGraphs":{"type":"topic","role":"collection","title":"StableGraphs","url":"\/documentation\/stablegraphs","identifi