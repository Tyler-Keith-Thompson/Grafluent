{"hierarchy":{"paths":[["doc:\/\/StableGraphs\/documentation\/StableGraphs","doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph"]]},"sections":[],"abstract":[{"type":"text","text":"Decodes the format "},{"code":"encode(to:)","type":"codeVoice"},{"type":"text","text":" writes, every position and both ends restored. Throws"},{"type":"text","text":" "},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"type":"text","text":" for a positions\/values count mismatch, a repeated vertex,"},{"type":"text","text":" "},{"type":"text","text":"positions that do not strictly increase or that reach past their end, an odd-length edge"},{"type":"text","text":" "},{"type":"text","text":"list, an endpoint out of range, or an implausible end."}],"variants":[{"paths":["\/documentation\/stablegraphs\/stabledirectedgraph\/init(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:12StableGraphs0A13DirectedGraphVAASeRzrlE4fromACyxGs7Decoder_p_tKcfc","extendedModule":"StableGraphs","symbolKind":"init","role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Decodable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}]},"modules":[{"name":"StableGraphs"}],"title":"init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"roleHeading":"Initializer"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/StableGraphs\/documentation\/StableGraphs\/StableDirectedGraph\/init(from:)"},"kind":"symbol","primaryContentSections":[{"declarations":