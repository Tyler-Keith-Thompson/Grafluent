{"abstract":[{"type":"text","text":"A directed graph stored as out- and in-adjacency lists."}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Neighbors"],"generated":true,"title":"Structures"},{"anchor":"Initializers","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init()","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-2unw2","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-6cbnw","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(adjacency:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(edges:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:edges:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/insert(_:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/insert(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/remove(_:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/remove(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/removeAll(keepingCapacity:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/removeAllEdges(keepingCapacity:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/reserveCapacity(vertexCount:edgeCount:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/BidirectionalDirectedGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/DirectedGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Hashable-Implementations"],"generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" values. The edge set is a set of ordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" in "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":", and a weight can live"},{"type":"text","text":" "},{"type":"text","text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel"},{"type":"text","text":" "},{"type":"text","text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one"},{"type":"text","text":" "},{"type":"text","text":"array, so the graph makes a constant number of allocations however many vertices it has"},{"type":"text","text":" "},{"type":"text","text":"(amortized, like "},{"type":"codeVoice","code":"Array"},{"type":"text","text":"), and copying it copies a constant number of buffers. A dictionary from"},{"type":"text","text":" "},{"type":"text","text":"slot pair to position answers "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList","interfaceLanguage":"swift"},"relations