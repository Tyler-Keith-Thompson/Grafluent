{"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"}],"symbolKind":"struct","navigatorTitle":[{"text":"AdjacencyList","kind":"identifier"}],"remoteSource":{"fileName":"AdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/AdjacencyList.swift#L20"},"roleHeading":"Structure","title":"AdjacencyList","externalID":"s:19AdjacencyListModule0aB0V","modules":[{"name":"AdjacencyListModule"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values. The edge set is a set of ordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices: self-loops are allowed, parallel edges are not."}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. Edges are kept in an","type":"text"},{"text":" ","type":"text"},{"text":"array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":", and a weight can live","type":"text"},{"text":" ","type":"text"},{"text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel","type":"text"},{"text":" ","type":"text"},{"text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one","type":"text"},{"text":" ","type":"text"},{"text":"array, so the graph makes a constant number of allocations however many vertices it has","type":"text"},{"text":" ","type":"text"},{"text":"(amortized, like ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":"), and copying it copies a constant number of buffers. A dictionary from","type":"text"},{"text":" ","type":"text"},{"text":"slot pair to position answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in O(1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"abstract":[{"text":"A directed graph stored as out- and in-adjacency lists.","type":"text"}],"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Neighbors"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init()","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-2unw2","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-6cbnw","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(adjacency:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(edges:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:edges:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/insert(_:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/insert(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/remove(_:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/remove(edge:)","doc