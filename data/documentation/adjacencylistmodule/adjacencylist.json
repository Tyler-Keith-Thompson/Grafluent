"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"}],"role":"symbol"},"identifier":{"url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values. The edge set is a set of ordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices"},{"type":"text","text":" "},{"type":"text","text":"are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" in order, each its own slot). Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" in "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":", and a weight can live"},{"type":"text","text":" "},{"type":"text","text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel"},{"type":"text","text":" "},{"type":"text","text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one"},{"type":"text","text":" "},{"type":"text","text":"array, so the graph makes a constant number of allocations however many vertices it has"},{"type":"text","text":" "},{"type":"text","text":"(amortized, like "},{"type":"codeVoice","code":"Array"},{"type":"text","text":"), and copying it copies a constant number of buffers. A hash table from"},{"type":"text","text":" "},{"type":"text","text":"slot pair to position (open addressing with a multiplicative hash, not "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"’s SipHash)"},{"type":"text","text":" "},{"type":"text","text":"answers "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1) expected."}],"type":"paragraph"},{"inlineContent":[{"text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row","type":"text"},{"text":" ","type":"text"},{"text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So","type":"text"},{"text":" ","type":"text"},{"text":"vertex order, edge order and edge positions are unspecified and may change after a removal.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A directed graph stored as out- and in-adjacency lists."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"]}],"references":{"doc://AdjacencyListModule/documentation/AdjacencyListModule/AdjacencyList/ExpressibleByDictionaryLiteral-Implementations":{"kind":"article","type":"topic","identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","url":"\/documentation\/adjacencylistmodule\/adjacencylist\/expressiblebydiction