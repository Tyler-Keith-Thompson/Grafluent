{"identifier":{"url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"AdjacencyListModule"}],"symbolKind":"struct","remoteSource":{"fileName":"AdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/AdjacencyList.swift#L24"},"title":"AdjacencyList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"}],"navigatorTitle":[{"text":"AdjacencyList","kind":"identifier"}],"externalID":"s:19AdjacencyListModule0aB0V","roleHeading":"Structure","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values. The edge set is a set of ordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices"},{"type":"text","text":" "},{"type":"text","text":"are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" in order, each its own slot). Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" in "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":", and a weight can live"},{"type":"text","text":" "},{"type":"text","text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel"},{"type":"text","text":" "},{"type":"text","text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one"},{"type":"text","text":" "},{"type":"text","text":"array, so the graph makes a constant number of allocations however many vertices it has"},{"type":"text","text":" "},{"type":"text","text":"(amortized, like "},{"type":"codeVoice","code":"Array"},{"type":"text","text":"), and copying it copies a constant number of buffers. A hash table from"},{"type":"text","text":" "},{"type":"text","text":"slot pair to position (open addressing with a multiplicative hash, not "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"’s SipHash)"},{"type":"text","text":" "},{"type":"text","text":"answers "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1) expected. A graph built in bulk from sorted edges (a"},{"type":"text","text":" "},{"type":"text","text":"condensation, a line graph, a named graph) builds that table on its first lookup or mutation,"},{"type":"text","text":" "},{"type":"text","text":"in O(m), so a result that is only traversed never pays for it."}],"type":"paragraph"},{"inlineContent":[{"text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row","type":"text"},{"text":" ","type":"text"},{"text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So","type":"text"},{"text":" ","type":"text"},{"text":"vertex order, edge order and edge positions are unspecified and may change after a removal.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Neighbors"],"generated":true},{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init()","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-2unw2","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-6cbnw","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(adjacency:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(edges:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:edges:)"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/degree(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/inDegree(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/inEdges(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/insert(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/insert(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModu