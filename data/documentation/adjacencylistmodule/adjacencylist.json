ion\/AdjacencyListModule\/AdjacencyList\/source(checkedEdgeAt:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/successors(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/target(checkedEdgeAt:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/vertexIndex(checked:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/BidirectionalDirectedGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/DirectedGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Hashable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/MutableDirectedGraph-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values. The edge set is a set of ordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices","type":"text"},{"text":" ","type":"text"},{"text":"are the ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":"s ","type":"text"},{"type":"codeVoice","code":"0..<n"},{"text":" in order, each its own slot). Edges are kept in an","type":"text"},{"text":" ","type":"text"},{"text":"array, so an edge’s position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" is an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"0..<edgeCount"},{"text":", and a weight can live","type":"text"},{"text":" ","type":"text"},{"text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel","type":"text"},{"text":" ","type":"text"},{"text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one","type":"text"},{"text":" ","type":"text"},{"text":"array, so the graph makes a constant number of allocations however many vertices it has","type":"text"},{"text":" ","type":"text"},{"text":"(amortized, like ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":"), and copying it copies a constant number of buffers. A hash table from","type":"text"},{"text":" ","type":"text"},{"text":"slot pair to position (open addressing with a multiplicative hash, not ","type":"text"},{"type":"codeVoice","code":"Dictionary"},{"text":"’s SipHash)","type":"text"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"type":"codeVoice","code":"contains(edge:)"},{"text":" in O(1) expected. A graph built in bulk from sorted edges (a","type":"text"},{"text":" ","type":"text"},{"text":"condensation, a line graph, a named graph) builds that table on its first lookup or mutation,","type":"text"},{"text":" ","type":"text"},{"text":"in O(m), so a result that is only traversed never pays for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"variants":[{"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A directed graph stored as out- and in-adjacency lists."}],"metadata":{"modules":[{"name":"AdjacencyListModule"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"}],"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/AdjacencyList.swift#L24","fileName":"AdjacencyList.s