{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"sections":[],"abstract":[{"text":"A directed graph stored as out- and in-adjacency lists.","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" values. The edge set is a set of ordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices: self-loops are allowed, parallel edges are not."}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices","type":"text"},{"text":" ","type":"text"},{"text":"are the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each its own slot). Edges are kept in an","type":"text"},{"text":" ","type":"text"},{"text":"array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":", and a weight can live","type":"text"},{"text":" ","type":"text"},{"text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel","type":"text"},{"text":" ","type":"text"},{"text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one","type":"text"},{"text":" ","type":"text"},{"text":"array, so the graph makes a constant number of allocations however many vertices it has","type":"text"},{"text":" ","type":"text"},{"text":"(amortized, like ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":"), and copying it copies a constant number of buffers. A hash table from","type":"text"},{"text":" ","type":"text"},{"text":"slot pair to position (open addressing with a multiplicative hash, not ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":"’s SipHash)","type":"text"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in O(1) expected. A graph built in bulk from sorted edges (a","type":"text"},{"text":" ","type":"text"},{"text":"condensation, a line graph, a named graph) builds that table on its first lookup or mutation,","type":"text"},{"text":" ","type":"text"},{"text":"in O(m), so a result that is only traversed never pays for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."}]}]}],"variants":[{"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Neighbors"]},{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init()","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-2unw2","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(_:)-6cbnw","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(adjacency:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(edges:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/init(vertices:edges:)"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\