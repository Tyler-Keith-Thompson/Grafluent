rotocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A directed graph stored as out- and in-adjacency lists."}],"metadata":{"roleHeading":"Structure","role":"symbol","externalID":"s:19AdjacencyListModule0aB0V","modules":[{"name":"AdjacencyListModule"}],"title":"AdjacencyList","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/AdjacencyList.swift#L24","fileName":"AdjacencyList.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"}],"navigatorTitle":[{"kind":"identifier","text":"AdjacencyList"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" values. The edge set is a set of ordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices: self-loops are allowed, parallel edges are not."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices"},{"type":"text","text":" "},{"type":"text","text":"are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" in order, each its own slot). Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" in "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":", and a weight can live"},{"type":"text","text":" "},{"type":"text","text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel"},{"type":"text","text":" "},{"type":"text","text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one"},{"type":"text","text":" "},{"type":"text","text":"array, so the graph makes a constant number of allocations however many vertices it has"},{"type":"text","text":" "},{"type":"text","text":"(amortized, like "},{"type":"codeVoice","code":"Array"},{"type":"text","text":"), and copying it copies a constant number of buffers. A hash table from"},{"type":"text","text":" "},{"type":"text","text":"slot pair to position (open addressing with a multiplicative hash, not "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"’s SipHash)"},{"type":"text","text":" "},{"type":"text","text":"answers "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1) expected. A graph built in bulk from sorted edges (a"},{"type":"text","text":" "},{"type":"text","text":"condensation, a line graph, a named graph) builds that table on its first lookup or mutation,"},{"type":"text","text":" "},{"type":"text","text":"in O(m), so a result that is only traversed never pays for it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"references":{"doc://AdjacencyListModule/s9EscapableP":{"identifier":"doc:\/\/AdjacencyListModule\/s9EscapableP","type":"unresolvable","title":"Swift.Escapable"},"doc://AdjacencyListModule/documentation/AdjacencyListModule/AdjacencyList/Neighbors":{"kind":"symbol","url":"\/documentation\/adjacencylistmodule\/adjacencylist\/neighbors","type":"topic","identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Neighbors","role":"symbol","abstract":[{"text":"A neighborhood: out- or in-neighbors here, an undirected graph’s neighbors in","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedAdjacencyList","type":"codeVoice"},{"text":". A value: unaffected by later changes to the graph.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Neighbors","kind":"identifier"}],"navigatorTitle":[{"text":"Neighbors","kind":"identifier"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"title":"AdjacencyList.Neighbors"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"role":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"code":"MutableGraph","type":"codeVoice"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"add_vertex","type":"codeVoice"},{"type":"text","text":", "},{"code":"add_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_vertex","type":"codeVoice"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"title":"MutableDirectedGraph"},"doc://AdjacencyListModule/documentation/AdjacencyListModule/AdjacencyList/vertexIndex(checked:)":{"url":"\/documentation\/adjacencylistmodule\/adjacencylist\/vertexindex(checked:)","title":"vertexIndex(checked:)","kind":"symbol","type":"topic","identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/Adjacenc