{"abstract":[{"type":"text","text":"A directed graph stored as out- and in-adjacency lists."}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" values. The edge set is a set of ordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices: self-loops are allowed, parallel edges are not."}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. While the vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each is its own slot and there is no dictionary. Edges are kept in","type":"text"},{"text":" ","type":"text"},{"text":"an array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":". A weight or other","type":"text"},{"text":" ","type":"text"},{"text":"value per edge or vertex lives in a map attached to the graph (","type":"text"},{"code":"addEdgeMap(default:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":"), which every mutation keeps in step.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each slot has a row of the slots of its out-neighbors, a parallel row of those edges’"},{"type":"text","text":" "},{"type":"text","text":"positions, and a row of its in-neighbors. The rows of each kind share one array, so the graph"},{"type":"text","text":" "},{"type":"text","text":"makes an amortized constant number of allocations however many vertices it has, and copying it"},{"type":"text","text":" "},{"type":"text","text":"copies a constant number of buffers. A hash table from slot pair to position answers"},{"type":"text","text":" "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1) expected. A graph built in bulk from sorted edges (a condensation, a"},{"type":"text","text":" "},{"type":"text","text":"line graph, a named graph) builds that table in O(m) on its first lookup or mutation, so a"},{"type":"text","text":" "},{"type":"text","text":"result that is only traversed never pays for it."}]},{"type":"paragraph","inlineContent":[{"text":"Removing an edge is O(1). The last edge moves into its position, and the last entry of each row","type":"text"},{"text":" ","type":"text"},{"text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. Vertex","type":"text"},{"text":" ","type":"text"},{"text":"order, edge order and edge positions are therefore unspecified and may change after a removal.","type":"text"},{"text":" ","type":"text"},{"text":"Attached maps move their values with them, and each insertion or removal appends or moves one","type":"text"},{"text":" ","type":"text"},{"text":"value per map.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList"},"kind":"symbol","metadata":{"modules":[{"name":"AdjacencyListModule"}],"remoteSource":{"fileName":"AdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/AdjacencyList.swift#L28"},"navigatorTitle":[{"kind":"identifier","text":"AdjacencyList"}],"title":"AdjacencyList","roleHeading":"Structure","externalID":"s:19AdjacencyListModule0aB0V","symbolKind":"struct","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"}]},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Neighbors"],"anchor":"Structures","generated":true},{"title":"Initializers","identif