[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values. The edge set is a set of ordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices","type":"text"},{"text":" ","type":"text"},{"text":"are the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each its own slot). Edges are kept in an","type":"text"},{"text":" ","type":"text"},{"text":"array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":", and a weight can live","type":"text"},{"text":" ","type":"text"},{"text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel","type":"text"},{"text":" ","type":"text"},{"text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one","type":"text"},{"text":" ","type":"text"},{"text":"array, so the graph makes a constant number of allocations however many vertices it has","type":"text"},{"text":" ","type":"text"},{"text":"(amortized, like ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":"), and copying it copies a constant number of buffers. A hash table from","type":"text"},{"text":" ","type":"text"},{"text":"slot pair to position (open addressing with a multiplicative hash, not ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":"’s SipHash)","type":"text"},{"text":" ","type":"text"},{"text":"answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in O(1) expected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."}]}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/adjacencylistmodule\/adjacencylist"]}],"abstract":[{"text":"A directed graph stored as out- and in-adjacency lists.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList"},"references":{"doc://AdjacencyListModule/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"},"doc://AdjacencyListModule/documentation/AdjacencyListModule/AdjacencyList/CustomDebugStringConvertible-Implementations":{"role":"collectionGroup","identifier":"do