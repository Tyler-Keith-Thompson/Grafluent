ule\/AdjacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/DirectedGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList\/Hashable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" values. The edge set is a set of ordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. Edges are kept in an","type":"text"},{"text":" ","type":"text"},{"text":"array, so an edge’s position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" is an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"0..<edgeCount"},{"text":", and a weight can live","type":"text"},{"text":" ","type":"text"},{"text":"in an array beside the graph. Each slot has a row of the slots of its out-neighbors, a parallel","type":"text"},{"text":" ","type":"text"},{"text":"row of those edges’ positions, and a row of its in-neighbors; the rows of each kind share one","type":"text"},{"text":" ","type":"text"},{"text":"array, so the graph makes a constant number of allocations however many vertices it has","type":"text"},{"text":" ","type":"text"},{"text":"(amortized, like ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":"), and copying it copies a constant number of buffers. A dictionary from","type":"text"},{"text":" ","type":"text"},{"text":"slot pair to position answers ","type":"text"},{"type":"codeVoice","code":"contains(edge:)"},{"text":" in O(1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."}]}],"kind":"content"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AdjacencyList"}],"remoteSource":{"fileName":"AdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Kei