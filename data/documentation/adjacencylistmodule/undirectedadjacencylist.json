":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"and","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"EdgesConnecting","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V15EdgesConnectinga"}],"abstract":[{"type":"text","text":"The position of the edge joining "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":", in either orientation, as a collection of at"},{"type":"text","text":" "},{"type":"text","text":"most one position; for "},{"type":"codeVoice","code":"u == v"},{"type":"text","text":", the self-loop. Empty when there is no such edge, or when"},{"type":"text","text":" "},{"type":"text","text":"either is not a vertex. O(1) expected."}],"identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/edges(between:and:)","type":"topic","title":"edges(between:and:)","url":"\/documentation\/adjacencylistmodule\/undirectedadjacencylist\/edges(between:and:)","kind":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}]}},"doc://AdjacencyListModule/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/AdjacencyListModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","fragments":[{"text":"protocol","kind":"keyword"}