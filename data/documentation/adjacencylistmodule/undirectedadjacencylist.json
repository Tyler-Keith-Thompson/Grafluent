le-Implementations"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values. The edge set is a set of unordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not, and ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" is the same edge as","type":"text"},{"text":" ","type":"text"},{"code":"{v, u}","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. Edges are kept in an","type":"text"},{"text":" ","type":"text"},{"text":"array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":". Each slot has a row of","type":"text"},{"text":" ","type":"text"},{"text":"the slots of its neighbors and a parallel row of the positions of its incident edges; each edge","type":"text"},{"text":" ","type":"text"},{"text":"is in both its endpoints’ rows, and a self-loop twice in its vertex’s row (as Boost stores it).","type":"text"},{"text":" ","type":"text"},{"text":"The rows share one array per kind, so the graph makes a constant number of allocations however","type":"text"},{"text":" ","type":"text"},{"text":"many vertices it has. A dictionary from unordered slot pair to position answers","type":"text"},{"text":" ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in O(1).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each","type":"text"},{"text":" ","type":"text"},{"text":"row into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So","type":"text"},{"text":" ","type":"text"},{"text":"vertex order, edge order and edge positions are unspecified and may change after a removal.","type":"text"},{"text":" ","type":"text"},{"text":"Each edge keeps the orientation it was first inserted with.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/adjacencylistmodule\/undirectedadjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList","interfaceLanguage":"swift"},"sections":[],"references":{"doc://AdjacencyListModule/s30ExpressibleByDictionaryLi