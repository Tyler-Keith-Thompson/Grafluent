yList\/MutableGraph-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values. The edge set is a set of unordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not, and ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" is the same edge as","type":"text"},{"text":" ","type":"text"},{"code":"{v, u}","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices","type":"text"},{"text":" ","type":"text"},{"text":"are the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each its own slot). Edges are kept in an","type":"text"},{"text":" ","type":"text"},{"text":"array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":". Each slot has a row of","type":"text"},{"text":" ","type":"text"},{"text":"the slots of its neighbors and a parallel row of the positions of its incident edges; each edge","type":"text"},{"text":" ","type":"text"},{"text":"is in both its endpoints’ rows, and a self-loop twice in its vertex’s row (as Boost stores it).","type":"text"},{"text":" ","type":"text"},{"text":"The rows share one array per kind, so the graph makes a constant number of allocations however","type":"text"},{"text":" ","type":"text"},{"text":"many vertices it has. A hash table from unordered slot pair to position (open addressing with a","type":"text"},{"text":" ","type":"text"},{"text":"multiplicative hash, not ","type":"text"},{"code":"Dictionary","type":"codeVoice"},{"text":"’s SipHash) answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in O(1) expected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each"},{"type":"text","text":" "},{"type":"text","text":"row into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."},{"type":"text","text":" "},{"type":"text","text":"Each edge keeps the orientation it was first inserted with."}]}],"kind":"content"}],"metadata":{"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L24","fileName":"UndirectedAdjacencyList.swift"},"roleHeading":"Structure","modules":[{"name":"AdjacencyListModule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"}],"externalID":"s:19AdjacencyListModule010UndirectedaB0V","role":"symbol","navigatorTitle":[{"text":"UndirectedAdjacencyList","kind":"identifier"}],"title":"UndirectedAdjacencyList"},"abstract":[{"text":"An 