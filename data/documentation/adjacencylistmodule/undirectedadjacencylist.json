{"metadata":{"externalID":"s:19AdjacencyListModule010UndirectedaB0V","remoteSource":{"fileName":"UndirectedAdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L26"},"navigatorTitle":[{"kind":"identifier","text":"UndirectedAdjacencyList"}],"role":"symbol","modules":[{"name":"AdjacencyListModule"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"}],"symbolKind":"struct","title":"UndirectedAdjacencyList","roleHeading":"Structure"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values. The edge set is a set of unordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices. Self-loops are allowed, parallel edges are not, and "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the same edge as"},{"type":"text","text":" "},{"type":"codeVoice","code":"{v, u}"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. While the vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each is its own slot and there is no dictionary. Edges are kept in","type":"text"},{"text":" ","type":"text"},{"text":"an array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":". Each slot has a row","type":"text"},{"text":" ","type":"text"},{"text":"of the slots of its neighbors and a parallel row of the positions of its incident edges. Each","type":"text"},{"text":" ","type":"text"},{"text":"edge is in both its endpoints’ rows, and a self-loop is in its vertex’s row twice. The rows","type":"text"},{"text":" ","type":"text"},{"text":"share one array per kind, so the graph makes a constant number of allocations however many","type":"text"},{"text":" ","type":"text"},{"text":"vertices it has. The bulk initializers (","type":"text"},{"code":"init(vertices:edges:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(edges:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"init(adjacency:)","type":"codeVoice"},{"text":", the builder and the dictionary literal) lay every row out once at its exact","type":"text"},{"text":" ","type":"text"},{"text":"size, in slot order; a row that later outgrows its block moves to the end. A hash table from unordered slot pair to position answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"O(1) expected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Removing an edge is O(1). The last edge moves into its position, and the last entry of each row","type":"text"},{"text":" ","type":"text"},{"text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. Vertex","type":"text"},{"text":" ","type":"text"},{"text":"order, edge order and edge positions are therefore unspecified and may change after a removal.","type":"text"},{"text":" ","type":"text"},{"text":"Maps attached to the graph (","type":"text"},{"type":"codeVoice","code":"addEdgeMap(default:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PropertyGraph"},{"text":") move their values with","type":"text"},{"text":" ","type":"text"},{"text":"them. Each edge keeps the orientation it was first inserted with.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"An undirected graph stored as adjacency lists, the undirected counterpart of "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"identifier":{"url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/