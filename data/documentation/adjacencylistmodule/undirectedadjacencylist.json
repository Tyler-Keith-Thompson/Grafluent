djacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Graph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Hashable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/MutableGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/PropertyGraph-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" values. The edge set is a set of unordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices. Self-loops are allowed, parallel edges are not, and ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the same edge as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"{v, u}"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. While the vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each is its own slot and there is no dictionary. Edges are kept in","type":"text"},{"text":" ","type":"text"},{"text":"an array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":". Each slot has a row","type":"text"},{"text":" ","type":"text"},{"text":"of the slots of its neighbors and a parallel row of the positions of its incident edges. Each","type":"text"},{"text":" ","type":"text"},{"text":"edge is in both its endpoints’ rows, and a self-loop is in its vertex’s row twice. The rows","type":"text"},{"text":" ","type":"text"},{"text":"share one array per kind, so the graph makes a constant number of allocations however many","type":"text"},{"text":" ","type":"text"},{"text":"vertices it has. The bulk initializers (","type":"text"},{"code":"init(vertices:edges:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(edges:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"init(adjacency:)","type":"codeVoice"},{"text":", the builder and the dictionary literal) lay every row out once at its exact","type":"text"},{"text":" ","type":"text"},{"text":"size, in slot order; a row that later outgrows its block moves to the end. A hash table from unordered slot pair to position answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"O(1) expected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1). The last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. Vertex"},{"type":"text","text":" "},{"type":"text","text":"order, edge order and edge positions are therefore unspecified and may change after a removal."},{"type":"text","text":" "},{"type":"text","text":"Maps attached to the graph ("},{"type":"codeVoice","code":"addEdgeMap(default:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":") move their values with"},{"type":"text","text":" "},{"type":"text","text":"them. Each edge keeps the orientation it was first inserted with."}]}],"kind":"content"}],"metadata":{"symbolKind":"struct","modules":[{"name":"AdjacencyListModule"}],"roleHeading":"Structure","title":"UndirectedAdjacencyList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"}],"role":"symbol","remoteSource":{"fileName":"UndirectedAdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L26"},"navigatorTitle":[{"kind":"identifier","text":"UndirectedAdjacencyList"}],"externalID":"s:19AdjacencyListModule010UndirectedaB0V"},