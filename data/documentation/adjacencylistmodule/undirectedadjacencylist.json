{"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init()","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(_:)-17f2v","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(_:)-2o9bq","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(adjacency:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(edges:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(vertices:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(vertices:edges:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/degree(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/incidentEdges(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/neighbors(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/vertexIndex(checked:)"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Graph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Hashable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/MutableGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/PropertyGraph-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" values. The edge set is a set of unordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not, and ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the same edge as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"{v, u}"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices"},{"type":"text","text":" "},{"type":"text","text":"are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" in order, each its own slot). Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" in "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":". Each slot has a row of"},{"type":"text","text":" "},{"type":"text","text":"the slots of its neighbors and a parallel row of the positions of its incident edges; each edge"},{"type":"text","text":" "},{"type":"text","text":"is in both its endpoints’ rows, and a self-loop twice in its vertex’s row (as Boost stores it)."},{"type":"text","text":" "},{"type":"text","text":"The rows share one array per kind, so the graph makes a constant number of allocations however"},{"type":"text","text":" "},{"type":"text","text":"many vertices it has. A hash table from unordered slot pair to position (open addressing with a"},{"type":"text","text":" "},{"type":"text","text":"multiplicative hash, not "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"’s SipHash) answers "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1) expected."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each"},{"type":"text","text":" "},{"type":"text","text":"row into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal;"},{"type":"text","text":" "},{"type":"text","text":"maps attached to the graph ("},{"code":"addEdgeMap(default:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"PropertyGraph","type":"codeVoice"},{"type":"text","text":") move their values with"},{"type":"text","text":" "},{"type":"text","text":"them. Each edge keeps the orientation it was first inserted with."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList"},"metadata":{"remoteSource":{"fileName":"UndirectedAdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L25"},"symbolKind":"struct","title":"UndirectedAdjacencyList","navigatorTitle":[{"kind":"identifier","text":"UndirectedAdjacencyList"}],"roleHeading":"Structure","role":"symbol","modules":[{"name":"AdjacencyListModule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"}],"externalID":"s:19AdjacencyListModule010UndirectedaB0V"},"kind":"symbol","variants":[{"paths":["\/documentation\/adjacencylistmodule\/undirectedadjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc