\/init(vertices:edges:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/degree(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/edges(between:and:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/incidentEdges(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/neighbors(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/vertexIndex(checked:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/EdgesConnecting"],"title":"Type Aliases","anchor":"Type-Aliases"},{"generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Graph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Hashable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/MutableGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/PropertyGraph-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values. The edge set is a set of unordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices. Self-loops are allowed, parallel edges are not, and "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the same edge as"},{"type":"text","text":" "},{"type":"codeVoice","code":"{v, u}"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. While the vertices are"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" in order, each is its own slot and there is no dictionary. Edges are kept in"},{"type":"text","text":" "},{"type":"text","text":"an array, so an edge’s position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" is an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" in "},{"code":"0..<edgeCount","type":"codeVoice"},{"type":"text","text":". Each slot has a row"},{"type":"text","text":" "},{"type":"text","text":"of the slots of its neighbors and a parallel row of the positions of its incident edges. Each"},{"type":"text","text":" "},{"type":"text","text":"edge is in both its endpoints’ rows, and a self-loop is in its vertex’s row twice. The rows"},{"type":"text","text":" "},{"type":"text","text":"share one array per kind, so the graph makes a constant number of allocations however many"},{"type":"text","text":" "},{"type":"text","text":"vertices it has. The bulk initializers ("},{"code":"init(vertices:edges:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"init(edges:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"init(_:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"init(adjacency:)","type":"codeVoice"},{"type":"text","text":", the builder and the dictionary literal) lay every row out once at its exact"},{"type":"text","text":" "},{"type":"text","text":"size, in slot order; a row that later outgrows its block moves to the end. A hash table from unordered slot pair to position answers "},{"code":"contains(edge:)","type":"codeVoice"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"O(1) expected."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Removing an edge is O(1). The last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. Vertex"},{"type":"text","text":" "},{"type":"text","text":"order, edge order and edge positions are therefore unspecified and may change after a removal."},{"type":"text","text":" "},{"type":"text","text":"Maps attached to the graph ("},{"type":"codeVoice","code":"addEdgeMap(default:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":") move their values with"},{"type":"text","text":" "},{"type":"text","text":"them. Each edge keeps the orientation it was first inserted with."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://AdjacencyListModule/documentation/AdjacencyListModule/UndirectedAdjacencyList/CustomStringConvertible-Implementations":{"role":"collectionGroup","abstract":[],"identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomStringConvertible-Implementations","type":"topic","title":"CustomStringConvertible Implementations","url":"\/documentation\/adjacencylistmodule\/undirectedadjacencylist\/customstringconvertible-implementations","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"url":"\/documentation\/graphprotocols\/mutablegraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}],"title":"MutableGraph","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":", with the members a reader needs to build a graph by key."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}],"type":"topic"},"doc://AdjacencyListModule/SE":{"identifier":"doc:\/\/AdjacencyListModule\/SE","type":"unresolvable","title":"Swift.Encodable"},"doc://AdjacencyListModule/documentation/AdjacencyListModule/UndirectedAdjacencyList/insert(edge:)":{"type":"topic","role":"symbol","url":"\/documentation\/adjacencylistmodule\/undirectedadjacencylist\/insert(edge:)","identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(edge:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UndirectedEdge","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14UndirectedEdgeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">) -> (inserted","kind":"text"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", memberAfterInsert","kind":"text"},{"text":": ","kind":"text"},{"text":"UndirectedEdge","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14UndirectedEdgeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifie