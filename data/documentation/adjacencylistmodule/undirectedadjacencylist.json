{"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" values. The edge set is a set of unordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not, and ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the same edge as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"{v, u}"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" in "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":". Each slot has a row of"},{"type":"text","text":" "},{"type":"text","text":"the slots of its neighbors and a parallel row of the positions of its incident edges; each edge"},{"type":"text","text":" "},{"type":"text","text":"is in both its endpoints’ rows, and a self-loop twice in its vertex’s row (as Boost stores it)."},{"type":"text","text":" "},{"type":"text","text":"The rows share one array per kind, so the graph makes a constant number of allocations however"},{"type":"text","text":" "},{"type":"text","text":"many vertices it has. A dictionary from unordered slot pair to position answers"},{"type":"text","text":" "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each"},{"type":"text","text":" "},{"type":"text","text":"row into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."},{"type":"text","text":" "},{"type":"text","text":"Each edge keeps the orientation it was first inserted with."}]}]}],"kind":"symbol","metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L23","fileName":"UndirectedAdjacencyList.swift"},"role":"symbol","modules":[{"name":"AdjacencyListModule"}],"roleHeading":"Structure","externalID":"s:19AdjacencyListModule010UndirectedaB0V","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"}],"navigatorTitle":[{"kind":"identifier","text":"UndirectedAdjacencyList"}],"title":"UndirectedAdjacencyList"},"variants":[{"paths":["\/documentation\/adjacencylistmodule\/undirectedadjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init()","doc:\/\/AdjacencyListModule\/d