,"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/degree(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/edges(between:and:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/incidentEdges(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/neighbors(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/vertexIndex(checked:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/EdgesConnecting"],"title":"Type Aliases","anchor":"Type-Aliases"},{"generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Graph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Hashable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/MutableGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/PropertyGraph-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values. The edge set is a set of unordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices. Self-loops are allowed, parallel edges are not, and "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the same edge as"},{"type":"text","text":" "},{"type":"codeVoice","code":"{v, u}"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. While the vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each is its own slot and there is no dictionary. Edges are kept in","type":"text"},{"text":" ","type":"text"},{"text":"an array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":". Each slot has a row","type":"text"},{"text":" ","type":"text"},{"text":"of the slots of its neighbors and a parallel row of the positions of its incident edges. Each","type":"text"},{"text":" ","type":"text"},{"text":"edge is in both its endpoints’ rows, and a self-loop is in its vertex’s row twice. The rows","type":"text"},{"text":" ","type":"text"},{"text":"share one array per kind, so the graph makes a constant number of allocations however many","type":"text"},{"text":" ","type":"text"},{"text":"vertices it has. A hash table from unordered slot pair to position answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"O(1) expected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Removing an edge is O(1). The last edge moves into its position, and the last entry of each row","type":"text"},{"text":" ","type":"text"},{"text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. Vertex","type":"text"},{"text":" ","type":"text"},{"text":"order, edge order and edge positions are therefore unspecified and may change after a removal.","type":"text"},{"text":" ","type":"text"},{"text":"Maps attached to the graph (","type":"text"},{"code":"addEdgeMap(default:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":") move their values with","type":"text"},{"text":" ","type":"text"},{"text":"them. Each edge keeps the orientation it was first inserted with.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"metadata":{"title":"UndirectedAdjacencyList","modules":[{"name":"AdjacencyListModule"}],"role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"}],"externalID":"s:19AdjacencyListModule010UndirectedaB0V","navigatorTitle":[{"kind":"identifier","text":"UndirectedAdjacencyList"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L24","fileName":"UndirectedAdjacencyList.swift"},"symbolKind":"struct"},"variants":[{"paths":["\/documentation\/adjacencylistmodule\/undirectedadjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://AdjacencyListModule/documentation/AdjacencyListModule/UndirectedAdjacencyList":{"type":"topic","url":"\/documentation\/adjacencylistmodule\/undirectedadjacencylist","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"}],"identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList","navigatorTitle":[{"text":"UndirectedAdjacencyList","kind":"identifier"}],"title":"UndirectedAdjacencyList","abstract":[{"type":"text","text":"An undirected graph stored as adjacency lists, the undirected counterpart of "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"."}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph":{"url":"\/documentation\/graphprotocols\/propertygraph","kind":"symbol","title":"PropertyGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"}],"abstract":