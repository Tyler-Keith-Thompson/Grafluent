irectedaB0V","symbolKind":"struct","modules":[{"name":"AdjacencyListModule"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"}],"remoteSource":{"fileName":"UndirectedAdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L26"},"role":"symbol","title":"UndirectedAdjacencyList"},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/adjacencylistmodule\/undirectedadjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" values. The edge set is a set of unordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices. Self-loops are allowed, parallel edges are not, and "},{"code":"{u, v}","type":"codeVoice"},{"type":"text","text":" is the same edge as"},{"type":"text","text":" "},{"code":"{v, u}","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. While the vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in order, each is its own slot and there is no dictionary. Edges are kept in","type":"text"},{"text":" ","type":"text"},{"text":"an array, so an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"0..<edgeCount","type":"codeVoice"},{"text":". Each slot has a row","type":"text"},{"text":" ","type":"text"},{"text":"of the slots of its neighbors and a parallel row of the positions of its incident edges. Each","type":"text"},{"text":" ","type":"text"},{"text":"edge is in both its endpoints’ rows, and a self-loop is in its vertex’s row twice. The rows","type":"text"},{"text":" ","type":"text"},{"text":"share one array per kind, so the graph makes a constant number of allocations however many","type":"text"},{"text":" ","type":"text"},{"text":"vertices it has. The bulk initializers (","type":"text"},{"code":"init(vertices:edges:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(edges:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"init(adjacency:)","type":"codeVoice"},{"text":", the builder and the dictionary literal) lay every row out once at its exact","type":"text"},{"text":" ","type":"text"},{"text":"size, in slot order; a row that later outgrows its block moves to the end. A hash table from unordered slot pair to position answers ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"O(1) expected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Removing an edge is O(1). The last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. Vertex"},{"type":"text","text":" "},{"type":"text","text":"order, edge order and edge positions are therefore unspecified and may change after a removal."},{"type":"text","text":" "},{"type":"text","text":"Maps attached to the graph ("},{"type":"codeVoice","code":"addEdgeMap(default:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":") move their values with"},{"type":"text","text":" "},{"type":"text","text":"them. Each edge keeps the orientation it was first inserted with."}],"type":"paragraph"}]}],"references":{"doc://AdjacencyListModule/documentation/AdjacencyListModule/UndirectedAdjacencyList/init(_:)-17f2v":{"identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(_:)-17f2v","role":"symbol","url":"\/documentation\/adjacencylistmodule\/undirectedadjacencylist\/init(_:)-17f2v","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A graph from a list of edges and vertices; see "},{"code":"GraphBuilder","type":"codeVoice"},{"t