{"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"metadata":{"role":"symbol","title":"UndirectedAdjacencyList","navigatorTitle":[{"text":"UndirectedAdjacencyList","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:19AdjacencyListModule010UndirectedaB0V","modules":[{"name":"AdjacencyListModule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"}],"symbolKind":"struct","remoteSource":{"fileName":"UndirectedAdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L25"}},"abstract":[{"text":"An undirected graph stored as adjacency lists: the undirected counterpart of ","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(Boost’s ","type":"text"},{"code":"adjacency_list<…, undirectedS>","type":"codeVoice"},{"text":").","type":"text"}],"variants":[{"paths":["\/documentation\/adjacencylistmodule\/undirectedadjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The vertex set is any set of ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values. The edge set is a set of unordered pairs of","type":"text"},{"text":" ","type":"text"},{"text":"vertices: self-loops are allowed, parallel edges are not, and ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" is the same edge as","type":"text"},{"text":" ","type":"text"},{"code":"{v, u}","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot (none while the vertices"},{"type":"text","text":" "},{"type":"text","text":"are the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" in order, each its own slot). Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" is an "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" in "},{"code":"0..<edgeCount","type":"codeVoice"},{"type":"text","text":". Each slot has a row of"},{"type":"text","text":" "},{"type":"text","text":"the slots of its neighbors and a parallel row of the positions of its incident edges; each edge"},{"type":"text","text":" "},{"type":"text","text":"is in both its endpoints’ rows, and a self-loop twice in its vertex’s row (as Boost stores it)."},{"type":"text","text":" "},{"type":"text","text":"The rows share one array per kind, so the graph makes a constant number of allocations however"},{"type":"text","text":" "},{"type":"text","text":"many vertices it has. A hash table from unordered slot pair to position (open addressing with a"},{"type":"text","text":" "},{"type":"text","text":"multiplicative hash, not "},{"code":"Dictionary","type":"codeVoice"},{"type":"text","text":"’s SipHash) answers "},{"code":"contains(edge:)","type":"codeVoice"},{"type":"text","text":" in O(1) expected."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each"},{"type":"text","text":" "},{"type":"text","text":"row into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal;"},{"type":"text","text":" "},{"type":"text","text":"maps attached to the graph ("},{"code":"addEdgeMap(default:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"PropertyGraph","type":"codeVoice"},{"type":"text","text":") move their values with"},{"type":"text","text":" "},{"type":"text","text":"them. Each edge keeps the orientation it was first inserted with."}]}],"kind":"content"}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init()","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(_:)-17f2v","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(_:)-2o9bq","doc:\/\/Adjacency