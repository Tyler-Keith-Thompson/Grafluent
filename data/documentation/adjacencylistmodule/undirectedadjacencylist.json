","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"],"kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L23","fileName":"UndirectedAdjacencyList.swift"},"title":"UndirectedAdjacencyList","roleHeading":"Structure","role":"symbol","symbolKind":"struct","modules":[{"name":"AdjacencyListModule"}],"externalID":"s:19AdjacencyListModule010UndirectedaB0V","navigatorTitle":[{"kind":"identifier","text":"UndirectedAdjacencyList"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values. The edge set is a set of unordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices: self-loops are allowed, parallel edges are not, and "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the same edge as"},{"type":"text","text":" "},{"type":"codeVoice","code":"{v, u}"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. Edges are kept in an"},{"type":"text","text":" "},{"type":"text","text":"array, so an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" in "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":". Each slot has a row of"},{"type":"text","text":" "},{"type":"text","text":"the slots of its neighbors and a parallel row of the positions of its incident edges; each edge"},{"type":"text","text":" "},{"type":"text","text":"is in both its endpoints’ rows, and a self-loop twice in its vertex’s row (as Boost stores it)."},{"type":"text","text":" "},{"type":"text","text":"The rows share one array per kind, so the graph makes a constant number of allocations however"},{"type":"text","text":" "},{"type":"text","text":"many vertices it has. A dictionary from unordered slot pair to position answers"},{"type":"text","text":" "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" in O(1)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Removing an edge is O(1): the last edge moves into its position, and the last entry of each"},{"type":"text","text":" "},{"type":"text","text":"row into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. So"},{"type":"text","text":" "},{"type":"text","text":"vertex order, edge order and edge positions are unspecified and may change after a removal."},{"type":"text","text":" "},{"type":"text","text":"Each edge keeps the orientation it was first inserted with."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://AdjacencyListModule/documentation/AdjacencyListM