{"hierarchy":{"paths":[["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule"]]},"abstract":[{"type":"text","text":"An undirected graph stored as adjacency lists, the undirected counterpart of "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"."}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init()","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(_:)-17f2v","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(_:)-2o9bq","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(adjacency:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(edges:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(vertices:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(vertices:edges:)"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/degree(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/edges(between:and:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/incidentEdges(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/insert(edge:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/neighbors(checked:)","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/vertexIndex(checked:)"]},{"anchor":"Type-Aliases","title":"Type Aliases","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/EdgesConnecting"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomDebugStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomReflectable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/CustomStringConvertible-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Decodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Encodable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Equatable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/ExpressibleByDictionaryLiteral-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Graph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/Hashable-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/MutableGraph-Implementations","doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/PropertyGraph-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertex set is any set of "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values. The edge set is a set of unordered pairs of"},{"type":"text","text":" "},{"type":"text","text":"vertices. Self-loops are allowed, parallel edges are not, and "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the same edge as"},{"type":"text","text":" "},{"type":"codeVoice","code":"{v, u}"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Vertices are kept in dense slots, with a dictionary from vertex to slot. While the vertices are","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":"s ","type":"text"},{"type":"codeVoice","code":"0..<n"},{"text":" in order, each is its own slot and there is no dictionary. Edges are kept in","type":"text"},{"text":" ","type":"text"},{"text":"an array, so an edge’s position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" is an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"0..<edgeCount"},{"text":". Each slot has a row","type":"text"},{"text":" ","type":"text"},{"text":"of the slots of its neighbors and a parallel row of the positions of its incident edges. Each","type":"text"},{"text":" ","type":"text"},{"text":"edge is in both its endpoints’ rows, and a self-loop is in its vertex’s row twice. The rows","type":"text"},{"text":" ","type":"text"},{"text":"share one array per kind, so the graph makes a constant number of allocations however many","type":"text"},{"text":" ","type":"text"},{"text":"vertices it has. The bulk initializers (","type":"text"},{"type":"codeVoice","code":"init(vertices:edges:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(edges:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"init(_:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"init(adjacency:)"},{"text":", the builder and the dictionary literal) lay every row out once at its exact","type":"text"},{"text":" ","type":"text"},{"text":"size, in slot order; a row that later outgrows its block moves to the end. A hash table from unordered slot pair to position answers ","type":"text"},{"type":"codeVoice","code":"contains(edge:)"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"text":"O(1) expected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing an edge is O(1). The last edge moves into its position, and the last entry of each row"},{"type":"text","text":" "},{"type":"text","text":"into the hole. Removing a vertex costs O(degree) and moves the last slot into its place. Vertex"},{"type":"text","text":" "},{"type":"text","text":"order, edge order and edge positions are therefore unspecified and may change after a removal."},{"type":"text","text":" "},{"type":"text","text":"Maps attached to the graph ("},{"type":"codeVoice","code":"addEdgeMap(default:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":") move their values with"},{"type":"text","text":" "},{"type":"text","text":"them. Each edge keeps the orientation it was first inserted with."}]}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/AdjacencyListModule\/s8CopyableP","doc:\/\/AdjacencyListModule\/s28CustomDebugStringConvertibleP","doc:\/\/AdjacencyListModule\/s17CustomReflectableP","doc:\/\/AdjacencyListModule\/s23CustomStringConvertibleP","doc:\/\/AdjacencyListModule\/Se","doc:\/\/AdjacencyListModule\/SE","doc:\/\/AdjacencyListModule\/SQ","doc:\/\/AdjacencyListModule\/s9EscapableP","doc:\/\/AdjacencyListModule\/s30ExpressibleByDictionaryLiteralP","doc:\/\/AdjacencyListModule\/SH","doc:\/\/AdjacencyListModule\/s8SendableP","doc:\/\/AdjacencyListModule\/s16SendableMetatypeP"]}],"sections":[],"metadata":{"title":"UndirectedAdjacencyList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"UndirectedAdjacencyList"}],"role":"symbol","remoteSource":{"fileName":"UndirectedAdjacencyList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/AdjacencyListModule\/UndirectedAdjacencyList.swift#L26"},"modules":[{"name":"AdjacencyListModule"}],"externalID":"s:19AdjacencyListModule010UndirectedaB0V","roleHeading":"Structure","symbolKind":"struct"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList"},"variants":[{"paths":["\/documentation\/adjacencylistmodule\/undirectedadjacencylist"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://AdjacencyListModule/documentation/AdjacencyListModule/UndirectedAdjacencyList/init(adjacency:)":{"title":"init(adjacency:)","identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/UndirectedAdjacencyList\/init(adjacency:)","abstract":[{"text":"A graph from an adjacency mapping: each key is a vertex, and its value lists neighbors.","type":"text"},{"text":" ","type":"text"},{"text":"Neighbors that are not keys become vertices, and an edge listed from bot