reealgorithms\/trees\/orderedtree\/treeeditdistance(to:substitutioncost:deletioncost:insertioncost:)","title":"treeEditDistance(to:substitutionCost:deletionCost:insertionCost:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The tree edit distance to "},{"code":"other","type":"codeVoice"},{"type":"text","text":" at the given costs: the least total cost of deleting"},{"type":"text","text":" "},{"type":"text","text":"vertices of this tree, inserting vertices of "},{"code":"other","type":"codeVoice"},{"type":"text","text":" and substituting one for the other"},{"type":"text","text":" "},{"type":"text","text":"that turns this tree into "},{"code":"other","type":"codeVoice"},{"type":"text","text":". Deleting a vertex makes its children children of its"},{"type":"text","text":" "},{"type":"text","text":"parent, in its place in the order; inserting is the reverse. Equivalently, the least cost"},{"type":"text","text":" "},{"type":"text","text":"of a mapping between the trees that keeps ancestry and sibling order, with unmapped"},{"type":"text","text":" "},{"type":"text","text":"vertices deleted or inserted."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treeEditDistance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Other","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Cost","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OrderedTree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees11OrderedTreeV"},{"text":"<","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"substitutio