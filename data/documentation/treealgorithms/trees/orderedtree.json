conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","abstract":[{"text":"The tree edit distance to ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" at the given costs: the least total cost of deleting","type":"text"},{"text":" ","type":"text"},{"text":"vertices of this tree, inserting vertices of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" and substituting one for the other","type":"text"},{"text":" ","type":"text"},{"text":"that turns this tree into ","type":"text"},{"code":"other","type":"codeVoice"},{"text":". Deleting a vertex makes its children children of its","type":"text"},{"text":" ","type":"text"},{"text":"parent, in its place in the order; inserting is the reverse. Equivalently, the least cost","type":"text"},{"text":" ","type":"text"},{"text":"of a mapping between the trees that keeps ancestry and sibling order, with unmapped","type":"text"},{"text":" ","type":"text"},{"text":"vertices deleted or inserted.","type":"text"}],"type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","url":"\/documentation\/treealgorithms","kind":"symbol","abstract":[],"title":"TreeAlgorithms","role":"collection"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/OrderedTree":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/OrderedTree","title":"OrderedTree","role":"symbol","url":"\/documentation\/treealgorithms\/trees\/orderedtree","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier","preciseIdentifier":"s:5Trees11OrderedTreeV"}],"navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"kind":"symbol","abstract":[],"type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/OrderedTree/treeEditDistance(to:)":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/OrderedTree\/treeEditDistance(to:)","title":"treeEditDistance(to:)","role":"symbol","url":"\/documentation\/treealgorithms\/trees\/orderedtree\/treeeditdistance(to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treeEditDistance"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Other"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"OrderedTree","preciseIdentifier":"s:5Trees11OrderedTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","abstract":[{"type":"text","text":"The tree edit distance to "},{"type":"codeVoice","code":"other"},{"type":"text","text":" at unit costs: the fewest vertex deletions and"},{"type":"text","text":" "},{"type":"text","text":"insertions that turn this tree’s shape into "},{"type":"codeVoice","code":"other"},{"type":"text","text":"’s, substitution being free. Zero"},{"type":"text","text":" "},{"type":"text","text":"exactly when the two have the same shape as ordered trees."}],"type":"topic"},"doc://Trees/documentation/Trees/OrderedTree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}],"navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"url":"\/documentation\/trees\/orderedtree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"kind":"symbol","type":"topic","title":"OrderedTree"}}}