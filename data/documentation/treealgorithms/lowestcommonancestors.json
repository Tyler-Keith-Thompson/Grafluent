{"sections":[],"metadata":{"externalID":"s:14TreeAlgorithms21LowestCommonAncestorsV","title":"LowestCommonAncestors","remoteSource":{"fileName":"LowestCommonAncestor.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L76"},"role":"symbol","symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"TreeAlgorithms"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LowestCommonAncestors"}],"navigatorTitle":[{"kind":"identifier","text":"LowestCommonAncestors"}]},"abstract":[{"type":"text","text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"code":"lowest_common_ancestor","type":"codeVoice"},{"type":"text","text":", JGraphT’s "},{"code":"LowestCommonAncestorAlgorithm","type":"codeVoice"},{"type":"text","text":")."}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/TreeAlgorithms\/s8SendableP","doc:\/\/TreeAlgorithms\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"For vertices at preorder positions p < q, the answer is the vertex at the least position among","type":"text"},{"text":" ","type":"text"},{"text":"the parents of the vertices at positions p + 1 … q: those parents lie in the answer’s subtree","type":"text"},{"text":" ","type":"text"},{"text":"and include it, and it has the least position there. So a query is one range minimum over","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 parent positions (the Euler tour reduction on half the entries), answered by 64-entry","type":"text"},{"text":" ","type":"text"},{"text":"blocks with a bitmask of each prefix’s minimum stack and a sparse table over the blocks’ minima.","type":"text"},{"text":" ","type":"text"},{"text":"About two words per vertex, plus (n\/64)·log₂(n\/64) for the table.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/treealgorithms\/lowestcommonancestors"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"},"hierarchy":{"paths":[["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-9p0ha"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(from:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(fromIndex:toIndex:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(of:_:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(ofIndex:_:)"]}],"references":{"doc://TreeAlgorithms/documentation/TreeAlgor