< q, the answer is the vertex at the least position among"},{"type":"text","text":" "},{"type":"text","text":"the parents of the vertices at positions p + 1 … q. Those parents lie in the answer’s subtree"},{"type":"text","text":" "},{"type":"text","text":"and include it, and it has the least position there. A query is therefore one range minimum"},{"type":"text","text":" "},{"type":"text","text":"over n − 1 parent positions, answered by 64-entry blocks with a bitmask of each prefix’s"},{"type":"text","text":" "},{"type":"text","text":"minimum stack and a sparse table over the blocks’ minima. Memory is about 20 bytes per vertex,"},{"type":"text","text":" "},{"type":"text","text":"plus (n\/64)·log₂(n\/64) entries for the table."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/treealgorithms\/lowestcommonancestors"]}],"abstract":[{"text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work.","type":"text"}],"identifier":{"url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Structure","externalID":"s:14TreeAlgorithms21LowestCommonAncestorsV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LowestCommonAncestors"}],"modules":[{"name":"TreeAlgorithms"}],"navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"role":"symbol","symbolKind":"struct","title":"LowestCommonAncestors","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L96","fileName":"LowestCommonAncestor.swift"}},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"]]},"references":{"doc://TreeAlgorithms/documentation/TreeAlgorithms/LowestCommonAncestors/lowestCommonAnces