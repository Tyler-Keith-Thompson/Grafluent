{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LowestCommonAncestors"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For vertices at preorder positions p < q, the answer is the vertex at the least position among"},{"type":"text","text":" "},{"type":"text","text":"the parents of the vertices at positions p + 1 … q. Those parents lie in the answer’s subtree"},{"type":"text","text":" "},{"type":"text","text":"and include it, and it has the least position there. A query is therefore one range minimum"},{"type":"text","text":" "},{"type":"text","text":"over n − 1 parent positions, answered by 64-entry blocks with a bitmask of each prefix’s"},{"type":"text","text":" "},{"type":"text","text":"minimum stack and a sparse table over the blocks’ minima. Memory is about 20 bytes per vertex,"},{"type":"text","text":" "},{"type":"text","text":"plus (n\/64)·log₂(n\/64) entries for the table."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work."}],"hierarchy":{"paths":[["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgor