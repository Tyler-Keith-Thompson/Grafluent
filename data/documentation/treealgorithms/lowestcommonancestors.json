{"abstract":[{"type":"text","text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"code":"lowest_common_ancestor","type":"codeVoice"},{"type":"text","text":", JGraphT’s "},{"code":"LowestCommonAncestorAlgorithm","type":"codeVoice"},{"type":"text","text":")."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"},"metadata":{"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"LowestCommonAncestors"}],"modules":[{"name":"TreeAlgorithms"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L76","fileName":"LowestCommonAncestor.swift"},"title":"LowestCommonAncestors","externalID":"s:14TreeAlgorithms21LowestCommonAncestorsV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"]]},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-9p0ha"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(from:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(fromIndex:toIndex:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(of:_:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(ofIndex:_:)"],"anchor":"Instance-Methods"}],"re