{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/TreeAlgorithms\/s8SendableP","doc:\/\/TreeAlgorithms\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"metadata":{"symbolKind":"struct","role":"symbol","externalID":"s:14TreeAlgorithms21LowestCommonAncestorsV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LowestCommonAncestors"}],"navigatorTitle":[{"kind":"identifier","text":"LowestCommonAncestors"}],"title":"LowestCommonAncestors","roleHeading":"Structure","modules":[{"name":"TreeAlgorithms"}],"remoteSource":{"fileName":"LowestCommonAncestor.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L96"}},"abstract":[{"type":"text","text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/treealgorithms\/lowestcommonancestors"]}],"topicSections":[{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-9p0ha"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(checkedFrom:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(from:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(fromIndex:toIndex:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(checked:_:)","doc:\/\/TreeAlgorithms\/documentation