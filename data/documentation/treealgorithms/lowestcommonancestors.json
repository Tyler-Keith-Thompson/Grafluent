{"hierarchy":{"paths":[["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/TreeAlgorithms\/s8SendableP","doc:\/\/TreeAlgorithms\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"abstract":[{"text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"code":"lowest_common_ancestor","type":"codeVoice"},{"text":", JGraphT’s ","type":"text"},{"code":"LowestCommonAncestorAlgorithm","type":"codeVoice"},{"text":").","type":"text"}],"sections":[],"metadata":{"externalID":"s:14TreeAlgorithms21LowestCommonAncestorsV","title":"LowestCommonAncestors","roleHeading":"Structure","symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"LowestCommonAncestors"}],"modules":[{"name":"TreeAlgorithms"}],"remoteSource":{"fileName":"LowestCommonAncestor.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L76"}},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-9p0ha"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(from:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/d