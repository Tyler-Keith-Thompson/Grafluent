{"hierarchy":{"paths":[["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"]]},"abstract":[{"text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"code":"lowest_common_ancestor","type":"codeVoice"},{"text":", JGraphT’s ","type":"text"},{"code":"LowestCommonAncestorAlgorithm","type":"codeVoice"},{"text":").","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/TreeAlgorithms\/s8SendableP","doc:\/\/TreeAlgorithms\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LowestCommonAncestors"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"For vertices at preorder positions p < q, the answer is the vertex at the least position among","type":"text"},{"text":" ","type":"text"},{"text":"the parents of the vertices at positions p + 1 … q: those parents lie in the answer’s subtree","type":"text"},{"text":" ","type":"text"},{"text":"and include it, and it has the least position there. So a query is one range minimum over","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 parent positions (the Euler tour reduction on half the entries), answered by 64-entry","type":"text"},{"text":" ","type":"text"},{"text":"blocks with a bitmask of each prefix’s minimum stack and a sparse table over the blocks’ minima.","type":"text"},{"text":" ","type":"text"},{"text":"About two words per vertex, plus (n\/64)·log₂(n\/64) for the table.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-9p0ha"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(checkedFrom:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(from:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(fromIndex:toIndex:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(checked:_:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(of:_:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(ofIndex:_:)"],"anchor":"Instance-Methods"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/treealgorithms\/lowestcommonancestors"]}],"metadata":{"navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"title":"LowestCommonAncestors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"remoteSource":{"fileName":"LowestCommonAncestor.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L97"},"externalID":"s:14TreeAlgorithm