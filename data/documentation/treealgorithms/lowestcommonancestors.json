{"metadata":{"modules":[{"name":"TreeAlgorithms"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","externalID":"s:14TreeAlgorithms21LowestCommonAncestorsV","title":"LowestCommonAncestors","navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L96","fileName":"LowestCommonAncestor.swift"},"role":"symbol"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/treealgorithms\/lowestcommonancestors"]}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/TreeAlgorithms\/s8SendableP","doc:\/\/TreeAlgorithms\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"identifier":{"url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-9p0ha"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(checkedFrom:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(from:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(fromIndex:toIndex:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(checked:_:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/lowestCommonAncestor(of:_:)","doc:\/\/Tr