{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/TreeAlgorithms\/s8SendableP","doc:\/\/TreeAlgorithms\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For vertices at preorder positions p < q, the answer is the vertex at the least position among"},{"type":"text","text":" "},{"type":"text","text":"the parents of the vertices at positions p + 1 … q: those parents lie in the answer’s subtree"},{"type":"text","text":" "},{"type":"text","text":"and include it, and it has the least position there. So a query is one range minimum over"},{"type":"text","text":" "},{"type":"text","text":"n − 1 parent positions (the Euler tour reduction on half the entries), answered by 64-entry"},{"type":"text","text":" "},{"type":"text","text":"blocks with a bitmask of each prefix’s minimum stack and a sparse table over the blocks’ minima."},{"type":"text","text":" "},{"type":"text","text":"About two words per vertex, plus (n\/64)·log₂(n\/64) for the table."}]}],"kind":"content"}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","do