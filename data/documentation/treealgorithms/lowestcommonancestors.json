{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"},"abstract":[{"text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"type":"codeVoice","code":"lowest_common_ancestor"},{"text":", JGraphT’s ","type":"text"},{"type":"codeVoice","code":"LowestCommonAncestorAlgorithm"},{"text":").","type":"text"}],"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/LowestCommonAncestor.swift#L97","fileName":"LowestCommonAncestor.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"externalID":"s:14TreeAlgorithms21LowestCommonAncestorsV","title":"LowestCommonAncestors","navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"TreeAlgorithms"}],"roleHeading":"Structure"},"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/TreeAlgorithms\/s8SendableP","doc:\/\/TreeAlgorithms\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/treealgorithms\/lowestcommonancestors"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-6re9c","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/init(_:)-9p0ha"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(checkedFrom:to:)","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors\/distance(from:to:)","doc:\/\/TreeAlgorith