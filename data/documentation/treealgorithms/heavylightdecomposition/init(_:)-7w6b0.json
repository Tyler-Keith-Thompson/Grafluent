 first in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order on a tie), and the","type":"text"},{"text":" ","type":"text"},{"text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,","type":"text"},{"text":" ","type":"text"},{"text":"so each heavy path and each subtree is an interval of positions, and any path between two","type":"text"},{"text":" ","type":"text"},{"text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals (","type":"text"},{"code":"segments(from:to:)","type":"codeVoice"},{"text":"), for path and subtree","type":"text"},{"text":" ","type":"text"},{"text":"queries over a structure indexed by position.","type":"text"}],"type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-7w6b0":{"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Arborescence","kind":"typeIdentifier","preciseIdentifier":"s:5Trees12ArborescenceV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"kind":"symbol","title":"init(_:)","type":"topic","abstract":[{"type":"text","text":"Decomposes an arborescence. O(n)."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-7w6b0","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0"}}}