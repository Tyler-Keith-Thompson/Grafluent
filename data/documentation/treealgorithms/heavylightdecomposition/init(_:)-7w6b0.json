cumentation\/TreeAlgorithms\/HeavyLightDecomposition","url":"\/documentation\/treealgorithms\/heavylightdecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"title":"HeavyLightDecomposition","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-7w6b0":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:5Trees12ArborescenceV","text":"Arborescence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"Decomposes an arborescence. O(n).","type":"text"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-7w6b0","title":"init(_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent (NetworkX ","type":"text"},{"code":"is_arborescence","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"role":"symbol","title":"Arborescence","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"kind":"symbol","url":"\/documentation\/trees\/arborescence"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"abstract":[],"role":"collection","title":"TreeAlgorithms","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","url":"\/documentation\/treealgorithms"}}}