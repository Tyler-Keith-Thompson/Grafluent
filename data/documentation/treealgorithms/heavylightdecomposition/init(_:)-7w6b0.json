escence. O(n)."}],"type":"topic","title":"init(_:)","role":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-7w6b0","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0"},"doc://Trees/documentation/Trees/Arborescence":{"type":"topic","url":"\/documentation\/trees\/arborescence","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","kind":"symbol","title":"Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]}}}