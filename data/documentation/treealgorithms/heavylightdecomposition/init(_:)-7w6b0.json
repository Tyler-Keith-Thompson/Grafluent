ed by position."}],"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","role":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition","kind":"symbol","title":"HeavyLightDecomposition"},"doc://Trees/documentation/Trees/Arborescence":{"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","role":"symbol","url":"\/documentation\/trees\/arborescence","title":"Arborescence","kind":"symbol"}}}