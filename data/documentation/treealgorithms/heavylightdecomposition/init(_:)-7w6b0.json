{"hierarchy":{"paths":[["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition"]]},"variants":[{"paths":["\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-7w6b0"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0"},"metadata":{"modules":[{"name":"TreeAlgorithms"}],"symbolKind":"init","title":"init(_:)","role":"symbol","externalID":"s:14TreeAlgorithms23HeavyLightDecompositionVyACyxG5Trees12ArborescenceVyxGcfc","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:5Trees12ArborescenceV","kind":"typeIdentifier","text":"Arborescence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">)"}],"remoteSource":{"fileName":"HeavyLightDecomposition.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/TreeAlgorithms\/HeavyLightDecomposition.swift#L26"},"roleHeading":"Initializer"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Decomposes an arborescence. O(n)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"arborescence"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","preciseIdentifier":"s:5Trees12ArborescenceV","kind":"typeIdentifier","text":"Arborescence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">)"}]}]}],"references":{"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-7w6b0":{"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Arborescence","kind":"typeIdentifier","preciseIdentifier":"s:5Trees12ArborescenceV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-7w6b0","kind":"symbol","abstract":[{"text":"Decomposes an arborescence. O(n).","type":"text"}],"title":"init(_:)","role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","title":"HeavyLightDecomposition","role":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"kind":"symbol","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"type":"topic"},"doc://Trees/documentation/Trees/Arborescence":{"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/trees\/arborescence","title":"Arborescence","role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","url":"\/documentation\/treealgorithms","kind":"symbol","abstract":[],"title":"TreeAlgorithms","role":"collection"}}}