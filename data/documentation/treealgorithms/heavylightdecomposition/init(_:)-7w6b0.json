hose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence","url":"\/documentation\/trees\/arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-7w6b0":{"kind":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-7w6b0","title":"init(_:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Arborescence","kind":"typeIdentifier","preciseIdentifier":"s:5Trees12ArborescenceV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0","abstract":[{"type":"text","text":"Decomposes an arborescence. O(n)."}],"role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"kind":"symbol","url":"\/documentation\/treealgorithms","title":"TreeAlgorithms","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","abstract":[],"role":"collection"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"url":"\/documentation\/treealgorithms\/heavylightdecomposition","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","title":"HeavyLightDecomposition","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"role":"symbol"}}}