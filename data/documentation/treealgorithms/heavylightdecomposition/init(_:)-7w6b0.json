gments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"url":"\/documentation\/trees\/arborescence","kind":"symbol","role":"symbol","title":"Arborescence","type":"topic","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent. As a ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"kind":"symbol","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","title":"HeavyLightDecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"role":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"abstract":[],"url":"\/documentation\/treealgorithms","kind":"symbol","role":"collection","title":"TreeAlgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-7w6b0":{"abstract":[{"text":"Decomposes an arborescence. O(n).","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Arborescence","kind":"typeIdentifier","preciseIdentifier":"s:5Trees12ArborescenceV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"title":"init(_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0","type":"topic","kind":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-7w6b0","role":"symbol"}}}