ex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"type":"topic","kind":"symbol","title":"HeavyLightDecomposition","role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","url":"\/documentation\/treealgorithms\/heavylightdecomposition","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","type":"topic","title":"TreeAlgorithms","abstract":[],"kind":"symbol","url":"\/documentation\/treealgorithms","role":"collection"}}}