":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"kind":"symbol","navigatorTitle":[{"text":"VertexNotFound","kind":"identifier"}],"title":"VertexNotFound","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","abstract":[{"type":"text","text":"The error a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" call throws when a vertex it was given isn’t in the graph. Named after"},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s "},{"type":"codeVoice","code":"NodeNotFound"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexNotFound","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/vertexnotfound","role":"symbol"}}}