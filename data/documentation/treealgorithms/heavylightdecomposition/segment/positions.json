text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","title":"HeavyLightDecomposition","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","type":"topic","kind":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Segment":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Segment","kind":"symbol","title":"HeavyLightDecomposition.Segment","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Segment","kind":"identifier"}],"role":"symbol","conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"type":"topic","abstract":[{"type":"text","text":"An interval of positions on one heavy path."}],"navigatorTitle":[{"text":"Segment","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/segment"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"role":"collection","abstract":[],"url":"\/documentation\/treealgorithms","kind":"symbol","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","title":"TreeAlgorithms"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Segment/positions":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"positions","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Range","kind":"typeIdentifier","preciseIdentifier":"s:Sn"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"abstract":[],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/segment\/positions","title":"positions","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Segment\/positions","kind":"symbol"}}}