":"codeVoice"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Segment/init(positions:isReversed:)":{"title":"init(positions:isReversed:)","abstract":[],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"positions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Range","preciseIdentifier":"s:Sn","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"isReversed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Segment\/init(positions:isReversed:)","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/segment\/init(positions:isreversed:)","kind":"symbol","type":"topic","role":"symbol"}}}