reciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"type":"topic","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"title":"HeavyLightDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","role":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Segment":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Segment","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/segment","title":"HeavyLightDecomposition.Segment","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"c