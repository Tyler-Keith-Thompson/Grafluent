 is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}]},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"navigatorTitle":[{"kind":"identifier","text":"VertexNotFound"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VertexNotFound"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","abstract":[{"text":"The error a ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" call throws when a vertex it was given isn’t in the graph.","type":"text"}],"kind":"symbol","title":"VertexNotFound","role":"symbol","url":"\/documentation\/graphprotocols\/vertexnotfound"}}}