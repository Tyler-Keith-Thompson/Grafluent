mposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","role":"symbol","kind":"symbol","title":"HeavyLightDecomposition","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"url":"\/documentation\/treealgorithms","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","role":"collection","title":"TreeAlgorithms"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Preorder-swift.struct":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Preorder","kind":"identifier"}],"abstract":[{"type":"text","text":"The vertices by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-swift.struct","role":"symbol","kind":"symbol","title":"HeavyLightDecomposition.Preorder","navigatorTitle":[{"text":"Preorder","kind":"identifier"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"