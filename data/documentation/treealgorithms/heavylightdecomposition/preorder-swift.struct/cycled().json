sition/Preorder-swift.struct/cycled()":{"title":"cycled()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycled"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"CycledSequence","preciseIdentifier":"s:10Algorithms14CycledSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Preorder-swift.struct\/cycled()","kind":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-swift.struct\/cycled()","type":"topic","abstract":[]},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"role":"collection","title":"TreeAlgorithms","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","abstract":[],"url":"\/documentation\/treealgorithms"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Preorder-swift.struct":{"role":"symbol","title":"HeavyLightDecomposition.Preorder","type":"topic","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Preorder-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Preorder"}],"abstract":[{"text":"The vertices by position.","type":"text"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Preorder"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"title":"HeavyLightDecomposition","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","kind":"symbol","type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}]}}}