xt":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"url":"\/documentation\/treealgorithms","abstract":[],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","type":"topic","title":"TreeAlgorithms","role":"collection"}}}