:" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","role":"symbol","title":"HeavyLightDecomposition","navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"kind":"symbol","abstract":[],"url":"\/documentation\/treealgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","role":"collection","title":"TreeAlgorithms","type":"topic"}}}