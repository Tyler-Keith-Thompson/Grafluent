deVoice","code":"Collection"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","title":"joined(by:)","role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"type":"topic","role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","title":"HeavyLightDecomposition","kind":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"title":"TreeAlgorithms","role":"collection","url":"\/documentation\/treealgorithms","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","abstract":[],"kind":"symbol"}}}