":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","title":"HeavyLightDecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"role":"symbol","url":"\/documentation\/treealgorithms\/heavylightdecomposition","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"abstract":[],"url":"\/documentation\/treealgorithms","kind":"symbol","role":"collection","title":"TreeAlgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","type":"topic"}}}