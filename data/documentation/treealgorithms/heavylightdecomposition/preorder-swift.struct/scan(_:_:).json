ild is","type":"text"},{"text":" ","type":"text"},{"text":"its child with the largest subtree (the first in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order on a tie), and the","type":"text"},{"text":" ","type":"text"},{"text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,","type":"text"},{"text":" ","type":"text"},{"text":"so each heavy path and each subtree is an interval of positions, and any path between two","type":"text"},{"text":" ","type":"text"},{"text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals (","type":"text"},{"code":"segments(from:to:)","type":"codeVoice"},{"text":"), for path and subtree","type":"text"},{"text":" ","type":"text"},{"text":"queries over a structure indexed by position.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition"}}}