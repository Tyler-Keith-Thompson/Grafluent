"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","role":"symbol","kind":"symbol","title":"HeavyLightDecomposition","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Preorder-swift.struct/startIndex":{"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-swift.struct\/startindex","title":"startIndex","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Preorder-swift.struct\/startIndex","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"startIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[],"type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"url":"\/documentat