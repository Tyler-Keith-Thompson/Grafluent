ny path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"role":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","title":"HeavyLightDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Preorder-swift.struct/adjacentPairs()":{"title":"adjacentPairs()","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-swift.struct\/adjacentpairs()","type":"topic","role":"symbol","abstract":[],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Preorder-swift.struct\/adjacentPairs()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsCollection","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms23AdjacentPairsCollectionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"title":"TreeAlgorithms","type":"topic","abstract":[],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","url":"\/documentation\/treealgorithms","role":"collection"}}}