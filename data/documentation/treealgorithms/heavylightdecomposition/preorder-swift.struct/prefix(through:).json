:" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","role":"symbol","title":"HeavyLightDecomposition","navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Preorder-swift.struct":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Preorder","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Preorder-swift.struct","conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"abstract":[{"text":"The vertices by position.","type":"text"}],"type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-swift.struct","navigatorTitle":[{"text":"Preorder","kind":"identifier"}],"title":"HeavyLightDecomposition.Preorder","role":"symbol","kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"kind":"symbol","abstract":[],"url":"\/documentation\/treealgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","role":"collection","title":"T