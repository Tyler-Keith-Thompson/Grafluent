h the largest subtree (the first in ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" order on a tie), and the","type":"text"},{"text":" ","type":"text"},{"text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,","type":"text"},{"text":" ","type":"text"},{"text":"so each heavy path and each subtree is an interval of positions, and any path between two","type":"text"},{"text":" ","type":"text"},{"text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals (","type":"text"},{"type":"codeVoice","code":"segments(from:to:)"},{"text":"), for path and subtree","type":"text"},{"text":" ","type":"text"},{"text":"queries over a structure indexed by position.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"type":"topic","role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Preorder-swift.struct":{"role":"symbol","navigatorTitle":[{"text":"Preorder","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-swift.struct","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Preorder-swift.struct","abstract":[{"text":"The vertices by position.","type":"text"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}]},"kind":"symbol","title":"HeavyLightDecomposition.Preorder","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Preorder","kind":"identifier"}]}}}