,"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"kind":"symbol","abstract":[{"text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is","type":"text"},{"text":" ","type":"text"},{"text":"its child with the largest subtree (the first in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order on a tie), and the","type":"text"},{"text":" ","type":"text"},{"text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,","type":"text"},{"text":" ","type":"text"},{"text":"so each heavy path and each subtree is an interval of positions, and any path between two","type":"text"},{"text":" ","type":"text"},{"text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals (","type":"text"},{"code":"segments(from:to:)","type":"codeVoice"},{"text":"), for path and subtree","type":"text"},{"text":" ","type":"text"},{"text":"queries over a structure indexed by position.","type":"text"}],"type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/Preorder-swift.struct":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/Preorder-swift.struct","conformance":{"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Preorder"}],"title":"HeavyLightDecomposition.Preorder","navigatorTitle":[{"kind":"identifier","text":"Preorder"}],"kind":"symbol","abstract":[{"type":"text","text":"The vertices by position."}],"type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/preorder-