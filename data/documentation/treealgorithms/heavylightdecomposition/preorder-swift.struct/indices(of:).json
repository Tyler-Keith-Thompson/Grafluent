truct"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"abstract":[{"text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is","type":"text"},{"text":" ","type":"text"},{"text":"its child with the largest subtree (the first in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order on a tie), and the","type":"text"},{"text":" ","type":"text"},{"text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,","type":"text"},{"text":" ","type":"text"},{"text":"so each heavy path and each subtree is an interval of positions, and any path between two","type":"text"},{"text":" ","type":"text"},{"text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals (","type":"text"},{"code":"segments(from:to:)","type":"codeVoice"},{"text":"), for path and subtree","type":"text"},{"text":" ","type":"text"},{"text":"queries over a structure indexed by position.","type":"text"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","kind":"symbol","role":"symbol","title":"HeavyLightDecomposition"}}}