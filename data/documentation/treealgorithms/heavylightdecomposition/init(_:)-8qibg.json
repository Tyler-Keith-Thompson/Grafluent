ootedTree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","title":"RootedTree","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"title":"TreeAlgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","abstract":[],"url":"\/documentation\/treealgorithms","kind":"symbol","role":"collection","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-8qibg":{"abstract":[{"text":"Decomposes a rooted tree. O(n).","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-8qibg","role":"symbol","type":"topic","kind":"symbol","url":"\/documen