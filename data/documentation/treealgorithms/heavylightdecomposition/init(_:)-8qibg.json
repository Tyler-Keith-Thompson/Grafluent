Voice"},{"text":", ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"depth(of:)","type":"codeVoice"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"code":"preorder","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"topic","url":"\/documentation\/trees\/rootedtree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-8qibg":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-8qibg","abstract":[{"type":"text","text":"Decomposes a rooted tree. O(n)."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"RootedTree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees10RootedTreeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-8qibg","title":"init(_:)"}}}