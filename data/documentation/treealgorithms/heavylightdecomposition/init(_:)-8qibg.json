s a rooted tree. O(n).","type":"text"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/init(_:)-8qibg","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-8qibg","type":"topic"},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","url":"\/documentation\/trees\/rootedtree","title":"RootedTree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"title":"HeavyLightDecomposition","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"title":"TreeAlgorithms","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/treealgorithms"}}}