gorithms\/heavylightdecomposition\/init(_:)-8qibg","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Decomposes a rooted tree. O(n)."}],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-8qibg","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"preciseIdentifier":"s:5Trees10RootedTreeV","kind":"typeIdentifier","text":"RootedTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">)"}]},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"topic","url":"\/documentation\/trees\/rootedtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"root"},{"text":", ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"text":", ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"depth(of:)","type":"codeVoice"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"code":"preorder","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"RootedTree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"kind":"symbol","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"role":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","title":"HeavyLightDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"title":"TreeAlgorithms","type":"topic","abstract":[],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","url":"\/documentation\/treealgorithms","role":"collection"}}}