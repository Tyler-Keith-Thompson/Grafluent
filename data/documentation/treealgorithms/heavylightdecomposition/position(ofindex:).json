","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","title":"TreeAlgorithms","url":"\/documentation\/treealgorithms","role":"collection","abstract":[],"type":"topic","kind":"symbol"}}}