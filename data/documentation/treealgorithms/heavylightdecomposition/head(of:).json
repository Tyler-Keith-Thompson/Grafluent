"},{"kind":"identifier","text":"HeavyLightDecomposition"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"title":"HeavyLightDecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/head(of:)":{"type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/head(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"head","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"title":"head(of:)","kind":"symbol","abstract":[{"text":"The top vertex of the heavy path through ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":". O(1).","type":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/head(of:)","role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{