here "},{"type":"codeVoice","code":"isReversed"},{"type":"text","text":" (going"},{"type":"text","text":" "},{"type":"text","text":"up). At most 2⌊log₂ n⌋ + 1 segments. Without the common ancestor (for values stored on"},{"type":"text","text":" "},{"type":"text","text":"edges, at their child’s position) the ancestor’s position is dropped, and a segment left"},{"type":"text","text":" "},{"type":"text","text":"empty by it. O(log n), one allocation."}],"title":"segments(from:to:includingCommonAncestor:)","url":"\/documentation\/treealgorithms\/heavylightdecomposition\/segments(from:to:includingcommonancestor:)","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/head(of:)":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"head"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/head(of:)","type":"topic","title":"head(of:)","abstract":[{"type":"text","text":"The top vertex of the heavy path through "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":". O(1)."}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition\/head(of:)"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"url":"\/documentation\/treealgorithms","abstract":[],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","type":"topic","title":"TreeAlgorithms","role":"collection"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition/init(_:)-7w6b0":{"kind":"symbol","title":"init(_:)","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition\/init(_:)-7w6b0","abstract":[{"type":"text","text":"Decomposes an arborescenc