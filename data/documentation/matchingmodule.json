atchingModule\/documentation\/MatchingModule\/StableMatching","kind":"symbol","navigatorTitle":[{"text":"StableMatching","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StableMatching","kind":"identifier"}],"role":"symbol"},"doc://MatchingModule/documentation/MatchingModule/Matching":{"title":"Matching","abstract":[{"type":"text","text":"A matching in an undirected graph: edges no two of which share an endpoint, as positions in the"},{"type":"text","text":" "},{"type":"text","text":"graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", with the sum of their weights (JGraphT’s "},{"type":"codeVoice","code":"Matching"},{"text":"). Never contains a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop.","type":"text"}],"type":"topic","url":"\/documentation\/matchingmodule\/matching","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/Matching","kind":"symbol","navigatorTitle":[{"text":"Matching","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Matching","kind":"identifier"}],"role":"symbol"},"doc://MatchingModule/documentation/MatchingModule/stableMatching(proposerPreferences:reviewerPreferences:)":{"role":"symbol","abstract":[{"type":"text","text":"The proposer-optimal stable matching (Gale and Shapley’s deferred acceptance). Each list ranks"},{"type":"text","text":" "},{"type":"text","text":"the other side’s indices, best first; a pair is acceptable when each lists the other. Unequal"},{"type":"text","text":" "},{"type":"text","text":"sides and incomplete lists are allowed. The result is unique, so the order of proposals does"},{"type":"text","text":" "},{"text":"not matter: every proposer gets the best reviewer it has in any stable matching, and the same","type":"text"},{"text":" ","type":"text"},{"text":"agents are matched in all of them. O(total list length).","type":"text"}],"identifier":"doc:\/\/MatchingMod