 ","type":"text"},{"text":"not matter: every proposer gets the best reviewer it has in any stable matching, and the same","type":"text"},{"text":" ","type":"text"},{"text":"agents are matched in all of them. O(total list length).","type":"text"}]},"doc://MatchingModule/documentation/MatchingModule/StableMatching":{"identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/StableMatching","url":"\/documentation\/matchingmodule\/stablematching","title":"StableMatching","type":"topic","abstract":[{"type":"text","text":"A stable matching between proposers and reviewers, by index: the result of "},{"type":"codeVoice","code":"stableMatching"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StableMatching","kind":"identifier"}],"navigatorTitle":[{"text":"StableMatching","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://MatchingModule/documentation/MatchingModule/GraphProtocols":{"type":"topic","title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/MatchingModule\/documentation\/MatchingModule\/GraphProtocols","url":"\/documentation\/matchingmodule\/graphprotocols","role":"collection","abstract":[]}}}