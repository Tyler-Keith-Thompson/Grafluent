rue)"},{"text":". It conforms to ","type":"text"},{"type":"codeVoice","code":"DirectedHypergraph"},{"text":", so the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" ","type":"text"},{"text":"algorithms (B- and F-connection, components, the clique expansion) run on it unchanged; it is","type":"text"},{"text":" ","type":"text"},{"text":"not a ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":".","type":"text"}],"title":"OrientedIncidenceMatrix","url":"\/documentation\/incidencematrixmodule\/orientedincidencematrix","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrientedIncidenceMatrix","kind":"identifier"}]},"doc://IncidenceMatrixModule/documentation/IncidenceMatrixModule/IncidenceMatrix":{"kind":"symbol","title":"IncidenceMatrix","navigatorTitle":[{"text":"IncidenceMatrix","kind":"identifier"}],"abstract":[{"text":"The unoriented incidence matrix of a hypergraph: an n × m matrix of bits with cell (v, p) set","type":"text"},{"text":" ","type":"text"},{"text":"when vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of column ","type":"text"},{"code":"p","type":"codeVoice"},{"text":". The vertices are ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" and the columns,","type":"text"},{"text":" ","type":"text"},{"text":"the hyperedges, are at positions ","type":"text"},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"text":". It conforms to ","type":"text"},{"code":"Hypergraph","type":"codeVoice"},{"text":", so the","type":"text"},{"text":" ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" algorithms run on it unchanged; it is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" even when built from one,","type":"text"},{"text":" ","type":"text"},{"text":"because a cell edit can give a column any number of bits.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":