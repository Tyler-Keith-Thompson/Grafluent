ge":"swift"}],"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"title":"Graph"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/minimumColoring()":{"title":"minimumColoring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()","abstract":[{"text":"An optimal colouring of the simple graph: on each connected component, of all its","type":"text"},{"text":" ","type":"text"},{"text":"colourings with its own chromatic number of colours, the one whose colour vector (in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least. So within a component colours appear in","type":"text"},{"text":" ","type":"text"},{"text":"order of first use, colour classes are numbered by their least vertex, a bipartite","type":"text"},{"text":" ","type":"text"},{"text":"component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two colours beside a","type":"text"},{"text":" ","type":"text"},{"text":"triangle. Combinatorica ","type":"text"},{"code":"MinimumVertexColoring","type":"codeVoice"},{"text":", Sage ","type":"text"},{"code":"vertex_coloring()","type":"codeVoice"},{"text":", JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"BrownBacktrackColoring.getColoring","type":"codeVoice"},{"text":", with this tie rule. First fit in index order when it","type":"text"},{"text":" ","type":"text"},{"text":"is already optimal; otherwise DSatur branch and bound per vertex prefix. Exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"worst case.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/minimumcoloring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:)":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ColoringStrategy","preciseIdentifier":"s:14ColoringModule0A8StrategyO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"A greedy colouring of the simple graph (self-loops ignored, parallel edges once): each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in the strategy’s order takes the least colour none of its already coloured","type":"text"},{"text":" ","type":"text"},{"text":"neighbours has. NetworkX ","type":"text"},{"type":"codeVoice","code":"greedy_color(G, strategy)"},{"text":", the same colours on simple graphs for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".largestFirst"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".saturationLargestFirst"},{"text":", and for the others wherever NetworkX’s set","type":"text"},{"text":" ","type":"text"},{"text":"iteration is ascending (NetworkX counts a self-loop in degrees, and its smallest last","type":"text"},{"text":" ","type":"text"},{"text":"raises on one); Boost ","type":"text"},{"type":"codeVoice","code":"sequential_vertex_coloring"},{"text":" in the strategy’s order; rustworkx","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"graph_greedy_color"},{"text":". Colours are first-fit numbers, not renumbered: colour 0 goes to the","type":"text"},{"text":" ","type":"text"},{"text":"first vertex coloured. At most Δ + 1 colours (","type":"text"},{"type":"codeVoice","code":".smallestLast"},{"text":": degeneracy + 1). O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"for largest first and connected sequential, O((n + m) log n) for smallest last and DSatur,","type":"text"},{"text":" ","type":"text"},{"text":"O(χ (n + m) log n) for independent set.","type":"text"}],"kind":"symbol","title":"greedyColoring(strategy:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/edgeColoring()":{"title":"edgeColoring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","abstract":[{"type":"text","text":"An edge colouring with at most Δ + 1 colours (Vizing’s bound), by Misra and Gries’s"},{"type":"text","text":" "},{"type":"text","text":"constructive proof (Boost "},{"type":"codeVoice","code":"edge_coloring"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"graph_misra_gries_edge_color"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"their own choices; Sage "},{"type":"codeVoice","code":"edge_coloring"},{"type":"text","text":"). Edges in position order, each coloured through a"},{"type":"text","text":" "},{"type":"text","text":"fan at its end with the lesser vertex index, every choice the least colour or vertex"},{"type":"text","text":" "},{"type":"text","text":"available. At least Δ colours always, and Δ + 1 on class-2 graphs (odd cycles, odd complete"},{"type":"text","text":" "},{"type":"text","text":"graphs, Petersen), but sometimes Δ + 1 on class-1 graphs too (K(4)); on a bipartite graph"},{"type":"text","text":" "},{"type":"codeVoice","code":"bipartiteEdgeColoring()"},{"type":"text","text":" always gives Δ. O(n · m) time, O(n · Δ) memory."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/edgecoloring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"title":"GraphProtocols","abstract":[],"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","url":"\/documentation\/coloringmodule\/graphprotocols","kind":"symbol","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[],"role":"symbol","title":"Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/bipartiteEdgeColoring()":{"title":"bipartiteEdgeColoring()","kind":"symbol","abstract":[{"text":"An edge colouring with exactly Δ colours, Δ counting parallel edges, on a bipartite graph","type":"text"},{"text":" ","type":"text"},{"text":"(König’s theorem; rustworkx ","type":"text"},{"type":"codeVoice","code":"graph_bipartite_edge_color"},{"text":"), or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"bipartite (","type":"text"},{"type":"codeVoice","code":"findOddCycle()"},{"text":" gives the witness; a self-loop makes it not bipartite).","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are fine. Edges in position order: each takes the least colour free at its","type":"text"},{"text":" ","type":"text"},{"text":"end with the lesser vertex index, after the alternating path of that colour and the least","type":"text"},{"text":" ","type":"text"},{"text":"colour free at the other end is flipped from the other end, when the two differ there.","type":"text"},{"text":" ","type":"text"},{"text":"O(n · m) time, O(n · Δ) memory.","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bipartiteEdgeColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/bipartiteedgecoloring()"},"doc://ColoringModule/documentation/ColoringModule":{"title":"ColoringModule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/coloringmodule"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isEdgeColoring(_:)":{"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isedgecoloring(_:)","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether every two edges with a common end have different colours: parallel edges, which"},{"type":"text","text":" "},{"type":"text","text":"share both ends, and a self-loop and any other edge at its vertex (igraph"},{"type":"text","text":" "},{"type":"codeVoice","code":"igraph_is_edge_coloring"},{"type":"text","text":"). Any Ints count as colours. "},{"type":"codeVoice","code":"color"},{"type":"text","text":" is called once per edge, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order. O(n + m), plus one hash per edge when the colours are not small"},{"type":"text","text":" "},{"type":"text","text":"non-negative numbers."}],"kind":"symbol","title":"isEdgeColoring(_:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/chromaticNumber()":{"title":"chromaticNumber()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","kind":"symbol","abstract":[{"type":"text","text":"The chromatic number χ of the simple graph (self-loops ignored, parallel edges once): the"},{"type":"text","text":" "},{"type":"text","text":"fewest colours of a proper colouring. 0 for the empty graph, 1 without edges, 2 when"},{"type":"text","text":" "},{"type":"text","text":"bipartite with an edge (BipartiteGraphs’ two-colouring, O(n + m)). Otherwise the greatest"},{"type":"text","text":" "},{"type":"text","text":"over the connected components, each non-bipartite one decided by DSatur branch and bound"},{"type":"text","text":" "},{"type":"text","text":"(Brélaz 1979) between a greedy clique and greedy DSatur (Sage "},{"type":"codeVoice","code":"chromatic_number"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"BrownBacktrackColoring.getChromaticNumber"},{"type":"text","text":", Mathematica "},{"type":"codeVoice","code":"ChromaticNumber"},{"type":"text","text":"). Exponential in"},{"type":"text","text":" "},{"type":"text","text":"the worst case: Mycielski graphs, whose χ exceeds ω by a lot, are the hard ones."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chromaticNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/chromaticnumber()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(order:)":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(order:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"order","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">) -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"First fit in "},{"type":"codeVoice","code":"order"},{"type":"text","text":" on the simple graph: each vertex in turn takes the least colour none of"},{"type":"text","text":" "},{"type":"text","text":"its already coloured neighbours has (Boost "},{"type":"codeVoice","code":"sequential_vertex_coloring(g, order, color)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"JGraphT "},{"type":"codeVoice","code":"GreedyColoring"},{"type":"text","text":", NetworkX "},{"type":"codeVoice","code":"greedy_color"},{"type":"text","text":" with a callable strategy). A shuffled"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is NetworkX’s "},{"type":"codeVoice","code":"random_sequential"},{"type":"text","text":". At most Δ + 1 colours. O(n + m) after one"},{"type":"text","text":" "},{"type":"text","text":"lookup per vertex."}],"title":"greedyColoring(order:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isColoring(_:)":{"title":"isColoring(_:)","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isColoring(_:)","kind":"symbol","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"color"},{"type":"text","text":" gives the two ends of every edge different colours (NetworkX "},{"type":"codeVoice","code":"is_coloring"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"type":"codeVoice","code":"igraph_is_vertex_coloring"},{"type":"text","text":"). Self-loops are ignored, as the colourings ignore them"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX’s "},{"type":"codeVoice","code":"is_coloring"},{"type":"text","text":" is false on any loop). Any Ints count as colours, not only"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":". "},{"type":"codeVoice","code":"color"},{"type":"text","text":" is called once per vertex, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. O(n + m)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isColoring"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/iscoloring(_:)"}}}