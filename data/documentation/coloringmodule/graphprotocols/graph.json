{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"}],"platforms":["Linux"]}],"kind":"declarations"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols"]]},"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"topicSections":[{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()"]}],"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","title":"Graph","externalID":"s:e:s:14GraphProtocols0A0P14ColoringModuleE04edgeC0AD04EdgeC0VyxGyF","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"roleHeading":"Extended Protocol","extendedModule":"GraphProtocols","symbolKind":"extension","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}]},"kind":"symbol","references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(order:)":{"type":"topic","role":"symbol","title":"greedyColoring(order:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(order:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyColoring"},{"kind":"text","text":"("},{"kind":"externalParam","text":"order"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","abstract":[{"type":"text","text":"First fit in "},{"type":"codeVoice","code":"order"},{"type":"text","text":" on the simple graph: each vertex in turn takes the least colour none of"},{"type":"text","text":" "},{"type":"text","text":"its already coloured neighbours has (Boost "},{"type":"codeVoice","code":"sequential_vertex_coloring(g, order, color)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"JGraphT "},{"type":"codeVoice","code":"GreedyColoring"},{"type":"text","text":", NetworkX "},{"type":"codeVoice","code":"greedy_color"},{"type":"text","text":" with a callable strategy). A shuffled"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is NetworkX’s "},{"type":"codeVoice","code":"random_sequential"},{"type":"text","text":". At most Δ + 1 colours. O(n + m) after one"},{"type":"text","text":" "},{"type":"text","text":"lookup per vertex."}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"role":"symbol","abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"title":"lexicographicallyFirstMinimumColoring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isEdgeColoring(_:)":{"role":"symbol","title":"isEdgeColoring(_:)","abstract":[{"text":"Whether every two edges with a common end have different colours: parallel edges, which","type":"text"},{"text":" ","type":"text"},{"text":"share both ends, and a self-loop and any other edge at its vertex (igraph","type":"text"},{"text":" ","type":"text"},{"code":"is_edge_coloring","type":"codeVoice"},{"text":"). Any Ints count as colours. ","type":"text"},{"type":"codeVoice","code":"color"},{"type":"text","text":" is called once per edge, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order. O(n + m), plus one hash per edge when the colours are not small"},{"type":"text","text":" "},{"type":"text","text":"non-negative numbers."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isedgecoloring(_:)","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/edgeColoring()":{"kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/edgecoloring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"edgeColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule04EdgeA0V","text":"EdgeColoring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"An edge colouring with at most Δ + 1 colours (Vizing’s bound), by Misra and Gries’s","type":"text"},{"text":" ","type":"text"},{"text":"constructive proof (Boost ","type":"text"},{"code":"edge_coloring","type":"codeVoice"},{"text":", rustworkx ","type":"text"},{"code":"graph_misra_gries_edge_color","type":"codeVoice"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"their own choices; Sage ","type":"text"},{"code":"edge_coloring","type":"codeVoice"},{"text":"). Edges in position order, each coloured through a","type":"text"},{"text":" ","type":"text"},{"text":"fan at its end with the lesser vertex index, every choice the least colour or vertex","type":"text"},{"text":" ","type":"text"},{"text":"available. At least Δ colours always, and Δ + 1 on class-2 graphs (odd cycles, odd complete","type":"text"},{"text":" ","type":"text"},{"text":"graphs, Petersen), but sometimes Δ + 1 on class-1 graphs too (K(4)); on a bipartite graph","type":"text"},{"text":" ","type":"text"},{"code":"bipartiteEdgeColoring()","type":"codeVoice"},{"text":" always gives Δ. O(m · (Δ² + n)) time: a fan has at most Δ","type":"text"},{"text":" ","type":"text"},{"text":"vertices, each found among the edges at u, and a path at most n edges. O(n + m) memory.","type":"text"},{"text":" ","type":"text"},{"text":"For a multigraph (","type":"text"},{"code":"digraph.undirected","type":"codeVoice"},{"text":" with an antiparallel pair is one), use","type":"text"},{"text":" ","type":"text"},{"code":"greedyEdgeColoring()","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","title":"edgeColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyEdgeColoring()":{"type":"topic","role":"symbol","title":"greedyEdgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedyedgecoloring()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyEdgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","abstract":[{"type":"text","text":"A greedy edge colouring of any graph, parallel edges and self-loops included, with at most"},{"type":"text","text":" "},{"type":"text","text":"2Δ − 1 colours: rustworkx "},{"type":"codeVoice","code":"graph_greedy_edge_color"},{"type":"text","text":", the largest-first colouring of the"},{"type":"text","text":" "},{"type":"text","text":"line graph, with the same colours. Edges by the number of other edges they share an end"},{"type":"text","text":" "},{"type":"text","text":"with, most first (a parallel copy counts at both ends, a self-loop meets each other edge at"},{"type":"text","text":" "},{"type":"text","text":"its vertex once), ties in position order; each takes the least colour of no edge it shares"},{"type":"text","text":" "},{"type":"text","text":"an end with that is already coloured. A self-loop is one edge at its vertex, as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"isEdgeColoring(_:)"},{"type":"text","text":". O(n + m · Δ) time, O(n + m) memory, without building the line graph."}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"role":"collection","title":"GraphProtocols","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","url":"\/documentation\/coloringmodule\/graphprotocols","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/chromaticNumber()":{"role":"symbol","abstract":[{"type":"text","text":"The chromatic number χ of the simple graph (self-loops ignored, parallel edges once): the"},{"type":"text","text":" "},{"type":"text","text":"fewest colours of a proper colouring. 0 for the empty graph, 1 without edges, 2 when"},{"type":"text","text":" "},{"type":"text","text":"bipartite with an edge (BipartiteGraphs’ two-colouring, O(n + m)). Otherwise the greatest"},{"type":"text","text":" "},{"text":"over the connected components, each non-bipartite one decided by DSatur branch and bound","type":"text"},{"text":" ","type":"text"},{"text":"(Brélaz 1979) between a greedy clique and greedy DSatur (Sage ","type":"text"},{"code":"chromatic_number","type":"codeVoice"},{"text":", JGraphT","type":"text"},{"text":" ","type":"text"},{"code":"BrownBacktrackColoring.getChromaticNumber","type":"codeVoice"},{"text":", Mathematica ","type":"text"},{"code":"VertexChromaticNumber","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Exponential in the worst case: Mycielski graphs, whose χ exceeds ω by a lot, are the hard","type":"text"},{"text":" ","type":"text"},{"text":"ones. The search does not check for task cancellation.","type":"text"}],"title":"chromaticNumber()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chromaticNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/chromaticnumber()","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"role":"collection","title":"ColoringModule","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/bipartiteEdgeColoring()":{"title":"bipartiteEdgeColoring()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bipartiteEdgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"type":"topic","abstract":[{"text":"An edge colouring with exactly Δ colours, Δ counting parallel edges, on a bipartite graph","type":"text"},{"text":" ","type":"text"},{"text":"(König’s theorem; rustworkx ","type":"text"},{"code":"graph_bipartite_edge_color","type":"codeVoice"},{"text":"), or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"bipartite (","type":"text"},{"code":"findOddCycle()","type":"codeVoice"},{"text":" gives the witness; a self-loop makes it not bipartite).","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are fine. Edges in position order: each takes the least colour free at its","type":"text"},{"text":" ","type":"text"},{"text":"end with the lesser vertex index, after the alternating path of that colour and the least","type":"text"},{"text":" ","type":"text"},{"text":"colour free at the other end is flipped from the other end, when the two differ there.","type":"text"},{"text":" ","type":"text"},{"text":"O(m · (n + Δ)) time, O(n + m) memory.","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/bipartiteedgecoloring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:presetColor:)":{"type":"topic","role":"symbol","title":"greedyColoring(strategy:presetColor:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:presetcolor:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ColoringStrategy","preciseIdentifier":"s:14ColoringModule0A8StrategyO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"presetColor","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","abstract":[{"type":"text","text":"The greedy colouring with some colours fixed in advance (rustworkx"},{"type":"text","text":" "},{"code":"graph_greedy_color(preset_color_fn=)","type":"codeVoice"},{"type":"text","text":"): "},{"code":"presetColor","type":"codeVoice"},{"type":"text","text":" gives a vertex’s colour, or nil to"},{"type":"text","text":" "},{"type":"text","text":"leave it to the strategy. Preset vertices keep their colours and count as coloured from the"},{"type":"text","text":" "},{"type":"text","text":"start; the others are coloured as by "},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"type":"text","text":", each taking the least"},{"type":"text","text":" "},{"type":"text","text":"colour no coloured neighbour has. The orders of "},{"code":".largestFirst","type":"codeVoice"},{"type":"text","text":", "},{"code":".smallestLast","type":"codeVoice"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"type":"text","text":"connected sequential strategies are those of the whole graph with the preset vertices"},{"type":"text","text":" "},{"type":"text","text":"skipped (rustworkx’s largest first: whole-graph degrees, preset vertices left out);"},{"type":"text","text":" "},{"type":"text","text":"DSatur counts preset colours in saturation from the start (rustworkx’s saturation);"},{"type":"text","text":" "},{"code":".independentSet","type":"codeVoice"},{"type":"text","text":"‘s class k starts without the neighbours of the vertices preset to k"},{"type":"text","text":" "},{"type":"text","text":"(rustworkx’s independent set); "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":" counts preset neighbours as coloured and"},{"type":"text","text":" "},{"type":"text","text":"takes its first vertex from its heap. "},{"code":"colorCount","type":"codeVoice"},{"type":"text","text":" is one more than the greatest colour,"},{"type":"text","text":" "},{"type":"text","text":"so preset colours may leave some colours unused. "},{"code":"presetColor","type":"codeVoice"},{"type":"text","text":" is called once per vertex,"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. The strategy’s time, plus O(n + m) to check the presets."}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isVertexColoring(_:)":{"kind":"symbol","title":"isVertexColoring(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVertexColoring"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"type":"topic","abstract":[{"type":"text","text":"Whether "},{"code":"color","type":"codeVoice"},{"type":"text","text":" gives the two ends of every edge different colours (igraph"},{"type":"text","text":" "},{"code":"is_vertex_coloring","type":"codeVoice"},{"type":"text","text":", NetworkX "},{"code":"is_coloring","type":"codeVoice"},{"type":"text","text":"). Self-loops are ignored, as the colourings"},{"type":"text","text":" "},{"type":"text","text":"ignore them (NetworkX’s "},{"code":"is_coloring","type":"codeVoice"},{"type":"text","text":" is false on any loop). Any Ints count as colours, not"},{"type":"text","text":" "},{"type":"text","text":"only "},{"code":"0..<k","type":"codeVoice"},{"type":"text","text":". "},{"code":"color","type":"codeVoice"},{"type":"text","text":" is called once per vertex, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. O(n + m)."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isvertexcoloring(_:)"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directed","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:)":{"type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:)","title":"greedyColoring(strategy:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ColoringStrategy","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A8StrategyO"},{"text":") -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","abstract":[{"text":"A greedy colouring of the simple graph (self-loops ignored, parallel edges once): each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in the strategy’s order takes the least colour none of its already coloured","type":"text"},{"text":" ","type":"text"},{"text":"neighbours has. NetworkX ","type":"text"},{"code":"greedy_color(G, strategy)","type":"codeVoice"},{"text":", the same colours on simple graphs for","type":"text"},{"text":" ","type":"text"},{"code":".largestFirst","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".saturationLargestFirst","type":"codeVoice"},{"text":", and for the others wherever NetworkX’s set","type":"text"},{"text":" ","type":"text"},{"text":"iteration is ascending (NetworkX counts a self-loop in degrees, and its smallest last","type":"text"},{"text":" ","type":"text"},{"text":"raises on one); igraph ","type":"text"},{"code":"vertex_coloring_greedy","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":"; Boost","type":"text"},{"text":" ","type":"text"},{"code":"sequential_vertex_coloring","type":"codeVoice"},{"text":" in the strategy’s order; rustworkx ","type":"text"},{"code":"graph_greedy_color","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Colours are first-fit numbers, not renumbered: colour 0 goes to the first vertex coloured.","type":"text"},{"text":" ","type":"text"},{"text":"At most Δ + 1 colours (","type":"text"},{"code":".smallestLast","type":"codeVoice"},{"text":": degeneracy + 1). O(n + m) for largest first and","type":"text"},{"text":" ","type":"text"},{"text":"connected sequential, O((n + m) log n) for smallest last, DSatur and colored neighbours,","type":"text"},{"text":" ","type":"text"},{"text":"O(χ (n + m) log n) for independent set.","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","type":"topic","abstract":[],"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/minimumColoring()":{"kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/minimumcoloring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"An optimal colouring of the simple graph: ","type":"text"},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"text":", with colours","type":"text"},{"text":" ","type":"text"},{"text":"numbered by first appearance in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (the first vertex has colour 0, and each","type":"text"},{"text":" ","type":"text"},{"text":"colour first appears after the one below it). It is the colouring ","type":"text"},{"type":"codeVoice","code":"chromaticNumber()"},{"text":"‘s","type":"text"},{"text":" ","type":"text"},{"text":"search finds, so it costs the same: a bipartite graph gets its ","type":"text"},{"type":"codeVoice","code":"bipartition()"},{"text":" sides (left","type":"text"},{"text":" ","type":"text"},{"text":"0), and each other component the colouring that DSatur branch and bound found for it, or","type":"text"},{"text":" ","type":"text"},{"text":"greedy DSatur’s when that already uses no more colours than another component needs.","type":"text"},{"text":" ","type":"text"},{"text":"Sage ","type":"text"},{"type":"codeVoice","code":"vertex_coloring()"},{"text":" and JGraphT ","type":"text"},{"type":"codeVoice","code":"BrownBacktrackColoring.getColoring"},{"text":", which also return","type":"text"},{"text":" ","type":"text"},{"text":"the optimal colouring their search finds; Mathematica ","type":"text"},{"type":"codeVoice","code":"FindVertexColoring"},{"text":". Deterministic, but which optimal colouring it is depends on the search; for one fixed","type":"text"},{"text":" ","type":"text"},{"text":"by a rule, see ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"text":". Exponential in the worst case, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"chromaticNumber()"},{"text":" is; the search does not check for task cancellation.","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()","title":"minimumColoring()"}}}