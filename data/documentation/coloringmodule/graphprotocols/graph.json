{"kind":"symbol","topicSections":[{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()"]}],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols"]]},"sections":[],"metadata":{"role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"ColoringModule"}],"roleHeading":"Extended Protocol","symbolKind":"extension","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"extendedModule":"GraphProtocols","externalID":"s:e:s:14GraphProtocols0A0P14ColoringModuleE04edgeC0AD04EdgeC0VyxGyF","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}]}]}],"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/minimumColoring()":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/minimumcoloring()","kind":"symbol","abstract":[{"text":"An optimal colouring of the simple graph: ","type":"text"},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"text":", with colours","type":"text"},{"text":" ","type":"text"},{"text":"numbered by first appearance in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (the first vertex has colour 0, and each","type":"text"},{"text":" ","type":"text"},{"text":"colour first appears after the one below it). It is the colouring ","type":"text"},{"type":"codeVoice","code":"chromaticNumber()"},{"text":"‘s","type":"text"},{"text":" ","type":"text"},{"text":"search finds, so it costs the same: a bipartite graph gets its ","type":"text"},{"type":"codeVoice","code":"bipartition()"},{"text":" sides (left","type":"text"},{"text":" ","type":"text"},{"text":"0), and each other component the colouring that DSatur branch and bound found for it, or","type":"text"},{"text":" ","type":"text"},{"text":"greedy DSatur’s when that already uses no more colours than another component needs.","type":"text"},{"text":" ","type":"text"},{"text":"Deterministic, but which optimal colouring it is depends on the search; for one fixed by a","type":"text"},{"text":" ","type":"text"},{"text":"rule, see ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"text":". Exponential in the worst case, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"chromaticNumber()"},{"text":" is; the search does not check for task cancellation.","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()","title":"minimumColoring()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/bipartiteEdgeColoring()":{"kind":"symbol","abstract":[{"text":"An edge colouring with exactly Δ colours, Δ counting parallel edges, on a bipartite graph","type":"text"},{"text":" ","type":"text"},{"text":"(König’s theorem), or nil when the graph is not bipartite (","type":"text"},{"type":"codeVoice","code":"findOddCycle()"},{"text":" gives the","type":"text"},{"text":" ","type":"text"},{"text":"witness; a self-loop makes it not bipartite). Parallel edges are fine. Edges in position","type":"text"},{"text":" ","type":"text"},{"text":"order: each takes the least colour free at its end with the lesser vertex index, after the","type":"text"},{"text":" ","type":"text"},{"text":"alternating path of that colour and the least colour free at the other end is flipped from","type":"text"},{"text":" ","type":"text"},{"text":"the other end, when the two differ there. O(m · (n + Δ)) time, O(n + m) memory.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bipartiteEdgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/bipartiteedgecoloring()","title":"bipartiteEdgeColoring()","type":"topic"},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"title":"ColoringModule","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyEdgeColoring()":{"type":"topic","title":"greedyEdgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedyedgecoloring()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyEdgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"text":"A greedy edge colouring of any graph, parallel edges and self-loops included, with at most","type":"text"},{"text":" ","type":"text"},{"text":"2Δ − 1 colours: the largest-first colouring of the line graph. Edges by the number of other","type":"text"},{"text":" ","type":"text"},{"text":"edges they share an end with, most first (a parallel copy counts at both ends, a self-loop","type":"text"},{"text":" ","type":"text"},{"text":"meets each other edge at its vertex once), ties in position order; each takes the least","type":"text"},{"text":" ","type":"text"},{"text":"colour of no edge it shares an end with that is already coloured. A self-loop is one edge at","type":"text"},{"text":" ","type":"text"},{"text":"its vertex, as for ","type":"text"},{"code":"isEdgeColoring(_:)","type":"codeVoice"},{"text":". O(n + m · Δ) time, O(n + m) memory, without","type":"text"},{"text":" ","type":"text"},{"text":"building the line graph.","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isEdgeColoring(_:)":{"kind":"symbol","abstract":[{"text":"Whether every two edges with a common end have different colours: parallel edges, which","type":"text"},{"text":" ","type":"text"},{"text":"share both ends, and a self-loop and any other edge at its vertex. Any Ints count as","type":"text"},{"text":" ","type":"text"},{"text":"colours. ","type":"text"},{"type":"codeVoice","code":"color"},{"text":" is called once per edge, in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" order. O(n + m), plus one hash per edge","type":"text"},{"text":" ","type":"text"},{"text":"when the colours are not small non-negative numbers.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isedgecoloring(_:)","type":"topic","title":"isEdgeColoring(_:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(order:)":{"kind":"symbol","abstract":[{"text":"First fit in ","type":"text"},{"type":"codeVoice","code":"order"},{"text":" on the simple graph: each vertex in turn takes the least colour none of","type":"text"},{"text":" ","type":"text"},{"text":"its already coloured neighbours has. A shuffled ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" gives a random sequential","type":"text"},{"text":" ","type":"text"},{"text":"colouring. At most Δ + 1 colours. O(n + m) after one lookup per vertex.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"order","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(order:)","type":"topic","title":"greedyColoring(order:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"url":"\/documentation\/coloringmodule\/graphprotocols\/graph","type":"topic","kind":"symbol","abstract":[],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"kind":"symbol","abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","type":"topic","title":"lexicographicallyFirstMinimumColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols","kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","title":"GraphProtocols"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:)":{"kind":"symbol","abstract":[{"type":"text","text":"A greedy colouring of the simple graph (self-loops ignored, parallel edges once): each"},{"type":"text","text":" "},{"type":"text","text":"vertex in the strategy’s order takes the least colour none of its already coloured"},{"type":"text","text":" "},{"type":"text","text":"neighbours has. Colours are first-fit numbers, not renumbered: colour 0 goes to the first"},{"type":"text","text":" "},{"type":"text","text":"vertex coloured. At most Δ + 1 colours ("},{"code":".smallestLast","type":"codeVoice"},{"type":"text","text":": degeneracy + 1). O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"largest first and connected sequential, O((n + m) log n) for smallest last, DSatur and"},{"type":"text","text":" "},{"type":"text","text":"colored neighbours, O(χ (n + m) log n) for independent set."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ColoringStrategy","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A8StrategyO"},{"text":") -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:)","type":"topic","title":"greedyColoring(strategy:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/edgeColoring()":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/edgecoloring()","kind":"symbol","abstract":[{"type":"text","text":"An edge colouring with at most Δ + 1 colours (Vizing’s bound), by Misra and Gries’s"},{"type":"text","text":" "},{"type":"text","text":"constructive proof. Edges in position order, each coloured through a fan at its end with the"},{"type":"text","text":" "},{"type":"text","text":"lesser vertex index, every choice the least colour or vertex available. At least Δ colours"},{"type":"text","text":" "},{"type":"text","text":"always, and Δ + 1 on class-2 graphs (odd cycles, odd complete graphs, Petersen), but"},{"type":"text","text":" "},{"type":"text","text":"sometimes Δ + 1 on class-1 graphs too (K(4)); on a bipartite graph "},{"type":"codeVoice","code":"bipartiteEdgeColoring()"},{"type":"text","text":" "},{"type":"text","text":"always gives Δ. O(m · (Δ² + n)) time: a fan has at most Δ vertices, each found among the"},{"type":"text","text":" "},{"type":"text","text":"edges at u, and a path at most n edges. O(n + m) memory. For a multigraph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"digraph.undirectedView"},{"type":"text","text":" with an antiparallel pair is one), use "},{"type":"codeVoice","code":"greedyEdgeColoring()"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","title":"edgeColoring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"edgeColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/chromaticNumber()":{"type":"topic","title":"chromaticNumber()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/chromaticnumber()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chromaticNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","abstract":[{"type":"text","text":"The chromatic number χ of the simple graph (self-loops ignored, parallel edges once): the"},{"type":"text","text":" "},{"type":"text","text":"fewest colours of a proper colouring. 0 for the empty graph, 1 without edges, 2 when"},{"type":"text","text":" "},{"type":"text","text":"bipartite with an edge (BipartiteGraphs’ two-colouring, O(n + m)). Otherwise the greatest"},{"type":"text","text":" "},{"type":"text","text":"over the connected components, each non-bipartite one decided by DSatur branch and bound"},{"type":"text","text":" "},{"type":"text","text":"(Brélaz 1979) between a greedy clique and greedy DSatur. Exponential in the worst case:"},{"type":"text","text":" "},{"type":"text","text":"Mycielski graphs, whose χ exceeds ω by a lot, are the hard ones. The search does not check"},{"type":"text","text":" "},{"type":"text","text":"for task cancellation."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:presetColor:)":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:presetcolor:)","title":"greedyColoring(strategy:presetColor:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A8StrategyO","text":"ColoringStrategy","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"presetColor","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"text":"The greedy colouring with some colours fixed in advance: ","type":"text"},{"type":"codeVoice","code":"presetColor"},{"text":" gives a vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"colour, or nil to leave it to the strategy. Preset vertices keep their colours and count as","type":"text"},{"text":" ","type":"text"},{"text":"coloured from the start; the others are coloured as by ","type":"text"},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"text":", each","type":"text"},{"text":" ","type":"text"},{"text":"taking the least colour no coloured neighbour has. The orders of ","type":"text"},{"type":"codeVoice","code":".largestFirst"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".smallestLast"},{"text":" and the connected sequential strategies are those of the whole graph with","type":"text"},{"text":" ","type":"text"},{"text":"the preset vertices skipped (whole-graph degrees); DSatur counts preset colours in","type":"text"},{"text":" ","type":"text"},{"text":"saturation from the start; ","type":"text"},{"type":"codeVoice","code":".independentSet"},{"text":"‘s class k starts without the neighbours of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices preset to k; ","type":"text"},{"type":"codeVoice","code":".coloredNeighbors"},{"text":" counts preset neighbours as coloured and takes its","type":"text"},{"text":" ","type":"text"},{"text":"first vertex from its heap. ","type":"text"},{"type":"codeVoice","code":"colorCount"},{"text":" is one more than the greatest colour, so preset","type":"text"},{"text":" ","type":"text"},{"text":"colours may leave some colours unused. ","type":"text"},{"type":"codeVoice","code":"presetColor"},{"text":" is called once per vertex, in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. The strategy’s time, plus O(n + m) to check the presets.","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isVertexColoring(_:)":{"kind":"symbol","abstract":[{"text":"Whether ","type":"text"},{"type":"codeVoice","code":"color"},{"text":" gives the two ends of every edge different colours. Self-loops are ignored,","type":"text"},{"text":" ","type":"text"},{"text":"as the colourings ignore them. Any Ints count as colours, not only ","type":"text"},{"type":"codeVoice","code":"0..<k"},{"text":". ","type":"text"},{"type":"codeVoice","code":"color"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"called once per vertex, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. O(n + m).","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isVertexColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isvertexcoloring(_:)","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","title":"isVertexColoring(_:)","type":"topic"}}}