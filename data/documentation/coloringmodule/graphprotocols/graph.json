{"metadata":{"extendedModule":"GraphProtocols","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"roleHeading":"Extended Protocol","title":"Graph","externalID":"s:e:s:14GraphProtocols0A0P14ColoringModuleE04edgeC0AD04EdgeC0VyxGyF","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"ColoringModule"}],"symbolKind":"extension"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols"]]},"sections":[],"topicSections":[{"generated":true,"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()"],"title":"Instance Methods","anchor":"Instance-Methods"}],"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/bipartiteEdgeColoring()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bipartiteEdgeColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"An edge colouring with exactly Δ colours, Δ counting parallel edges, on a bipartite graph"},{"type":"text","text":" "},{"type":"text","text":"(König’s theorem), or nil when the graph is not bipartite ("},{"code":"findOddCycle()","type":"codeVoice"},{"type":"text","text":" gives the"},{"type":"text","text":" "},{"type":"text","text":"witness; a self-loop makes it not bipartite). Parallel edges are fine. Edges in position"},{"type":"text","text":" "},{"type":"text","text":"order: each takes the least colour free at its end with the lesser vertex index, after the"},{"type":"text","text":" "},{"type":"text","text":"alternating path of that colour and the least colour free at the other end is flipped from"},{"type":"text","text":" "},{"type":"text","text":"the other end, when the two differ there. O(m · (n + Δ)) time, O(n + m) memory."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/bipartiteedgecoloring()","title":"bipartiteEdgeColoring()","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"role":"collection","abstract":[],"type":"topic","title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","url":"\/documentation\/coloringmodule\/graphprotocols"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyEdgeColoring()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyEdgeColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","title":"greedyEdgeColoring()","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedyedgecoloring()","abstract":[{"text":"A greedy edge colouring of any graph, parallel edges and self-loops included, with at most","type":"text"},{"text":" ","type":"text"},{"text":"2Δ − 1 colours: the largest-first colouring of the line graph. Edges by the number of other","type":"text"},{"text":" ","type":"text"},{"text":"edges they share an end with, most first (a parallel copy counts at both ends, a self-loop","type":"text"},{"text":" ","type":"text"},{"text":"meets each other edge at its vertex once), ties in position order; each takes the least","type":"text"},{"text":" ","type":"text"},{"text":"colour of no edge it shares an end with that is already coloured. A self-loop is one edge at","type":"text"},{"text":" ","type":"text"},{"text":"its vertex, as for ","type":"text"},{"type":"codeVoice","code":"isEdgeColoring(_:)"},{"text":". O(n + m · Δ) time, O(n + m) memory, without","type":"text"},{"text":" ","type":"text"},{"text":"building the line graph.","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ColoringStrategy","preciseIdentifier":"s:14ColoringModule0A8StrategyO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A greedy colouring of the simple graph (self-loops ignored, parallel edges once): each"},{"type":"text","text":" "},{"type":"text","text":"vertex in the strategy’s order takes the least colour none of its already coloured"},{"type":"text","text":" "},{"type":"text","text":"neighbours has. Colours are first-fit numbers, not renumbered: colour 0 goes to the first"},{"type":"text","text":" "},{"type":"text","text":"vertex coloured. At most Δ + 1 colours ("},{"type":"codeVoice","code":".smallestLast"},{"type":"text","text":": degeneracy + 1). O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"largest first and connected sequential, O((n + m) log n) for smallest last, DSatur and"},{"type":"text","text":" "},{"type":"text","text":"colored neighbours, O(χ (n + m) log n) for independent set."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:)","title":"greedyColoring(strategy:)","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"code":"bipartition()","type":"codeVoice"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","title":"lexicographicallyFirstMinimumColoring()","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isVertexColoring(_:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether "},{"code":"color","type":"codeVoice"},{"type":"text","text":" gives the two ends of every edge different colours. Self-loops are ignored,"},{"type":"text","text":" "},{"type":"text","text":"as the colourings ignore them. Any Ints count as colours, not only "},{"code":"0..<k","type":"codeVoice"},{"text":". ","type":"text"},{"code":"color","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"called once per vertex, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVertexColoring"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"isVertexColoring(_:)","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isvertexcoloring(_:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isEdgeColoring(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEdgeColoring"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","type":"topic","title":"isEdgeColoring(_:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isedgecoloring(_:)","abstract":[{"type":"text","text":"Whether every two edges with a common end have different colours: parallel edges, which"},{"type":"text","text":" "},{"type":"text","text":"share both ends, and a self-loop and any other edge at its vertex. Any Ints count as"},{"type":"text","text":" "},{"type":"text","text":"colours. "},{"code":"color","type":"codeVoice"},{"type":"text","text":" is called once per edge, in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order. O(n + m), plus one hash per edge"},{"type":"text","text":" "},{"type":"text","text":"when the colours are not small non-negative numbers."}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:presetColor:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ColoringStrategy","preciseIdentifier":"s:14ColoringModule0A8StrategyO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"presetColor","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","title":"greedyColoring(strategy:presetColor:)","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:presetcolor:)","abstract":[{"type":"text","text":"The greedy colouring with some colours fixed in advance: "},{"code":"presetColor","type":"codeVoice"},{"type":"text","text":" gives a vertex’s"},{"type":"text","text":" "},{"type":"text","text":"colour, or nil to leave it to the strategy. Preset vertices keep their colours and count as"},{"type":"text","text":" "},{"text":"coloured from the start; the others are coloured as by ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":", each","type":"text"},{"text":" ","type":"text"},{"text":"taking the least colour no coloured neighbour has. The orders of ","type":"text"},{"code":".largestFirst","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":".smallestLast","type":"codeVoice"},{"text":" and the connected sequential strategies are those of the whole graph with","type":"text"},{"text":" ","type":"text"},{"text":"the preset vertices skipped (whole-graph degrees); DSatur counts preset colours in","type":"text"},{"text":" ","type":"text"},{"text":"saturation from the start; ","type":"text"},{"code":".independentSet","type":"codeVoice"},{"text":"‘s class k starts without the neighbours of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices preset to k; ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":" counts preset neighbours as coloured and takes its","type":"text"},{"text":" ","type":"text"},{"text":"first vertex from its heap. ","type":"text"},{"code":"colorCount","type":"codeVoice"},{"text":" is one more than the greatest colour, so preset","type":"text"},{"text":" ","type":"text"},{"text":"colours may leave some colours unused. ","type":"text"},{"code":"presetColor","type":"codeVoice"},{"text":" is called once per vertex, in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. The strategy’s time, plus O(n + m) to check the presets.","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/chromaticNumber()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chromaticNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","abstract":[{"type":"text","text":"The chromatic number χ of the simple graph (self-loops ignored, parallel edges once): the"},{"type":"text","text":" "},{"type":"text","text":"fewest colours of a proper colouring. 0 for the empty graph, 1 without edges, 2 when"},{"type":"text","text":" "},{"type":"text","text":"bipartite with an edge (BipartiteGraphs’ two-colouring, O(n + m)). Otherwise the greatest"},{"type":"text","text":" "},{"text":"over the connected components, each non-bipartite one decided by DSatur branch and bound","type":"text"},{"text":" ","type":"text"},{"text":"(Brélaz 1979) between a greedy clique and greedy DSatur. Exponential in the worst case:","type":"text"},{"text":" ","type":"text"},{"text":"Mycielski graphs, whose χ exceeds ω by a lot, are the hard ones. The search does not check","type":"text"},{"text":" ","type":"text"},{"text":"for task cancellation.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/chromaticnumber()","title":"chromaticNumber()","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/minimumColoring()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"An optimal colouring of the simple graph: "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":", with colours"},{"type":"text","text":" "},{"type":"text","text":"numbered by first appearance in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (the first vertex has colour 0, and each"},{"type":"text","text":" "},{"type":"text","text":"colour first appears after the one below it). It is the colouring "},{"type":"codeVoice","code":"chromaticNumber()"},{"type":"text","text":"‘s"},{"type":"text","text":" "},{"type":"text","text":"search finds, so it costs the same: a bipartite graph gets its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left"},{"type":"text","text":" "},{"type":"text","text":"0), and each other component the colouring that DSatur branch and bound found for it, or"},{"type":"text","text":" "},{"type":"text","text":"greedy DSatur’s when that already uses no more colours than another component needs."},{"type":"text","text":" "},{"type":"text","text":"Deterministic, but which optimal colouring it is depends on the search; for one fixed by a"},{"type":"text","text":" "},{"type":"text","text":"rule, see "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"type":"text","text":". Exponential in the worst case, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"chromaticNumber()"},{"type":"text","text":" is; the search does not check for task cancellation."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/minimumcoloring()","title":"minimumColoring()","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/edgeColoring()":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"An edge colouring with at most Δ + 1 colours (Vizing’s bound), by Misra and Gries’s"},{"type":"text","text":" "},{"type":"text","text":"constructive proof. Edges in position order, each coloured through a fan at its end with the"},{"type":"text","text":" "},{"type":"text","text":"lesser vertex index, every choice the least colour or vertex available. At least Δ colours"},{"type":"text","text":" "},{"type":"text","text":"always, and Δ + 1 on class-2 graphs (odd cycles, odd complete graphs, Petersen), but"},{"type":"text","text":" "},{"type":"text","text":"sometimes Δ + 1 on class-1 graphs too (K(4)); on a bipartite graph "},{"type":"codeVoice","code":"bipartiteEdgeColoring()"},{"type":"text","text":" "},{"type":"text","text":"always gives Δ. O(m · (Δ² + n)) time: a fan has at most Δ vertices, each found among the"},{"type":"text","text":" "},{"type":"text","text":"edges at u, and a path at most n edges. O(n + m) memory. For a multigraph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"digraph.undirectedView"},{"type":"text","text":" with an antiparallel pair is one), use "},{"type":"codeVoice","code":"greedyEdgeColoring()"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"edgeColoring()","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/edgecoloring()"},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule","title":"ColoringModule","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","type":"topic","url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"role":"symbol","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"title":"Graph","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","url":"\/documentation\/coloringmodule\/graphprotocols\/graph"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(order:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"First fit in "},{"type":"codeVoice","code":"order"},{"type":"text","text":" on the simple graph: each vertex in turn takes the least colour none of"},{"type":"text","text":" "},{"type":"text","text":"its already coloured neighbours has. A shuffled "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" gives a random sequential"},{"type":"text","text":" "},{"type":"text","text":"colouring. At most Δ + 1 colours. O(n + m) after one lookup per vertex."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyColoring"},{"kind":"text","text":"("},{"kind":"externalParam","text":"order"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"greedyColoring(order:)","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(order:)"}}}