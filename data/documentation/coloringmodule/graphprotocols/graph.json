{"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Extended Protocol","modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"title":"Graph","extendedModule":"GraphProtocols","role":"symbol","externalID":"s:e:s:14GraphProtocols0A0P14ColoringModuleE04edgeC0AD04EdgeC0VyxGyF","symbolKind":"extension","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"platforms":["Linux"]}],"kind":"declarations"}],"topicSections":[{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()"],"anchor":"Instance-Methods"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","title":"GraphProtocols","abstract":[],"role":"collection","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/edgeColoring()":{"title":"edgeColoring()","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/edgecoloring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","abstract":[{"type":"text","text":"An edge colouring with at most Δ + 1 colours (Vizing’s bound), by Misra and Gries’s"},{"type":"text","text":" "},{"type":"text","text":"constructive proof (Boost "},{"code":"edge_coloring","type":"codeVoice"},{"type":"text","text":", rustworkx "},{"code":"graph_misra_gries_edge_color","type":"codeVoice"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"their own choices; Sage "},{"code":"edge_coloring","type":"codeVoice"},{"type":"text","text":"). Edges in position order, each coloured through a"},{"type":"text","text":" "},{"type":"text","text":"fan at its end with the lesser vertex index, every choice the least colour or vertex"},{"type":"text","text":" "},{"type":"text","text":"available. At least Δ colours always, and Δ + 1 on class-2 graphs (odd cycles, odd complete"},{"type":"text","text":" "},{"type":"text","text":"graphs, Petersen), but sometimes Δ + 1 on class-1 graphs too (K(4)); on a bipartite graph"},{"type":"text","text":" "},{"code":"bipartiteEdgeColoring()","type":"codeVoice"},{"type":"text","text":" always gives Δ. O(m · (Δ² + n)) time: a fan has at most Δ"},{"type":"text","text":" "},{"type":"text","text":"vertices, each found among the edges at u, and a path at most n edges. O(n + m) memory."},{"type":"text","text":" "},{"type":"text","text":"For a multigraph ("},{"code":"digraph.undirected","type":"codeVoice"},{"type":"text","text":" with an antiparallel pair is one), use"},{"type":"text","text":" "},{"code":"greedyEdgeColoring()","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyEdgeColoring()":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","abstract":[{"type":"text","text":"A greedy edge colouring of any graph, parallel edges and self-loops included, with at most"},{"type":"text","text":" "},{"type":"text","text":"2Δ − 1 colours: rustworkx "},{"type":"codeVoice","code":"graph_greedy_edge_color"},{"type":"text","text":", the largest-first colouring of the"},{"type":"text","text":" "},{"type":"text","text":"line graph, with the same colours. Edges by the number of other edges they share an end"},{"type":"text","text":" "},{"type":"text","text":"with, most first (a parallel copy counts at both ends, a self-loop meets each other edge at"},{"type":"text","text":" "},{"type":"text","text":"its vertex once), ties in position order; each takes the least colour of no edge it shares"},{"type":"text","text":" "},{"type":"text","text":"an end with that is already coloured. A self-loop is one edge at its vertex, as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"isEdgeColoring(_:)"},{"type":"text","text":". O(n + m · Δ) time, O(n + m) memory, without building the line graph."}],"title":"greedyEdgeColoring()","role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedyedgecoloring()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyEdgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule04EdgeA0V","text":"EdgeColoring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://ColoringModule/documentation/ColoringModule":{"title":"ColoringModule","type":"topic","url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"kind":"symbol","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:presetColor:)":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","title":"greedyColoring(strategy:presetColor:)","abstract":[{"text":"The greedy colouring with some colours fixed in advance (rustworkx","type":"text"},{"text":" ","type":"text"},{"code":"graph_greedy_color(preset_color_fn=)","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"presetColor","type":"codeVoice"},{"text":" gives a vertex’s colour, or nil to","type":"text"},{"text":" ","type":"text"},{"text":"leave it to the strategy. Preset vertices keep their colours and count as coloured from the","type":"text"},{"text":" ","type":"text"},{"text":"start; the others are coloured as by ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":", each taking the least","type":"text"},{"text":" ","type":"text"},{"text":"colour no coloured neighbour has. The orders of ","type":"text"},{"code":".largestFirst","type":"codeVoice"},{"text":", ","type":"text"},{"code":".smallestLast","type":"codeVoice"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"connected sequential strategies are those of the whole graph with the preset vertices","type":"text"},{"text":" ","type":"text"},{"text":"skipped (rustworkx’s largest first: whole-graph degrees, preset vertices left out);","type":"text"},{"text":" ","type":"text"},{"text":"DSatur counts preset colours in saturation from the start (rustworkx’s saturation);","type":"text"},{"text":" ","type":"text"},{"code":".independentSet","type":"codeVoice"},{"text":"‘s class k starts without the neighbours of the vertices preset to k","type":"text"},{"text":" ","type":"text"},{"text":"(rustworkx’s independent set); ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":" counts preset neighbours as coloured and","type":"text"},{"text":" ","type":"text"},{"text":"takes its first vertex from its heap. ","type":"text"},{"code":"colorCount","type":"codeVoice"},{"text":" is one more than the greatest colour,","type":"text"},{"text":" ","type":"text"},{"text":"so preset colours may leave some colours unused. ","type":"text"},{"code":"presetColor","type":"codeVoice"},{"text":" is called once per vertex,","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. The strategy’s time, plus O(n + m) to check the presets.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:presetcolor:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ColoringStrategy","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A8StrategyO"},{"text":", ","kind":"text"},{"text":"presetColor","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?) -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isEdgeColoring(_:)":{"title":"isEdgeColoring(_:)","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isedgecoloring(_:)","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","abstract":[{"type":"text","text":"Whether every two edges with a common end have different colours: parallel edges, which"},{"type":"text","text":" "},{"type":"text","text":"share both ends, and a self-loop and any other edge at its vertex (igraph"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_edge_coloring"},{"type":"text","text":"). Any Ints count as colours. "},{"type":"codeVoice","code":"color"},{"type":"text","text":" is called once per edge, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order. O(n + m), plus one hash per edge when the colours are not small"},{"type":"text","text":" "},{"type":"text","text":"non-negative numbers."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(order:)":{"title":"greedyColoring(order:)","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(order:)","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","abstract":[{"text":"First fit in ","type":"text"},{"type":"codeVoice","code":"order"},{"text":" on the simple graph: each vertex in turn takes the least colour none of","type":"text"},{"text":" ","type":"text"},{"text":"its already coloured neighbours has (Boost ","type":"text"},{"type":"codeVoice","code":"sequential_vertex_coloring(g, order, color)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"JGraphT ","type":"text"},{"type":"codeVoice","code":"GreedyColoring"},{"text":", NetworkX ","type":"text"},{"type":"codeVoice","code":"greedy_color"},{"text":" with a callable strategy). A shuffled","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is NetworkX’s ","type":"text"},{"type":"codeVoice","code":"random_sequential"},{"text":". At most Δ + 1 colours. O(n + m) after one","type":"text"},{"text":" ","type":"text"},{"text":"lookup per vertex.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyColoring"},{"kind":"text","text":"("},{"kind":"externalParam","text":"order"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"abstract":[],"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"title":"Graph","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isVertexColoring(_:)":{"title":"isVertexColoring(_:)","type":"topic","abstract":[{"text":"Whether ","type":"text"},{"code":"color","type":"codeVoice"},{"text":" gives the two ends of every edge different colours (igraph","type":"text"},{"text":" ","type":"text"},{"code":"is_vertex_coloring","type":"codeVoice"},{"text":", NetworkX ","type":"text"},{"code":"is_coloring","type":"codeVoice"},{"text":"). Self-loops are ignored, as the colourings","type":"text"},{"text":" ","type":"text"},{"text":"ignore them (NetworkX’s ","type":"text"},{"code":"is_coloring","type":"codeVoice"},{"text":" is false on any loop). Any Ints count as colours, not","type":"text"},{"text":" ","type":"text"},{"text":"only ","type":"text"},{"code":"0..<k","type":"codeVoice"},{"text":". ","type":"text"},{"code":"color","type":"codeVoice"},{"text":" is called once per vertex, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isvertexcoloring(_:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVertexColoring"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"lexicographicallyFirstMinimumColoring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:)":{"title":"greedyColoring(strategy:)","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:)","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","abstract":[{"type":"text","text":"A greedy colouring of the simple graph (self-loops ignored, parallel edges once): each"},{"type":"text","text":" "},{"type":"text","text":"vertex in the strategy’s order takes the least colour none of its already coloured"},{"type":"text","text":" "},{"type":"text","text":"neighbours has. NetworkX "},{"type":"codeVoice","code":"greedy_color(G, strategy)"},{"type":"text","text":", the same colours on simple graphs for"},{"type":"text","text":" "},{"type":"codeVoice","code":".largestFirst"},{"type":"text","text":" and "},{"type":"codeVoice","code":".saturationLargestFirst"},{"type":"text","text":", and for the others wherever NetworkX’s set"},{"type":"text","text":" "},{"type":"text","text":"iteration is ascending (NetworkX counts a self-loop in degrees, and its smallest last"},{"type":"text","text":" "},{"type":"text","text":"raises on one); igraph "},{"type":"codeVoice","code":"vertex_coloring_greedy"},{"type":"text","text":" for "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"; Boost"},{"type":"text","text":" "},{"type":"codeVoice","code":"sequential_vertex_coloring"},{"type":"text","text":" in the strategy’s order; rustworkx "},{"type":"codeVoice","code":"graph_greedy_color"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Colours are first-fit numbers, not renumbered: colour 0 goes to the first vertex coloured."},{"type":"text","text":" "},{"type":"text","text":"At most Δ + 1 colours ("},{"type":"codeVoice","code":".smallestLast"},{"type":"text","text":": degeneracy + 1). O(n + m) for largest first and"},{"type":"text","text":" "},{"type":"text","text":"connected sequential, O((n + m) log n) for smallest last, DSatur and colored neighbours,"},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for independent set."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyColoring"},{"kind":"text","text":"("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ColoringStrategy","preciseIdentifier":"s:14ColoringModule0A8StrategyO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/bipartiteEdgeColoring()":{"kind":"symbol","abstract":[{"type":"text","text":"An edge colouring with exactly Δ colours, Δ counting parallel edges, on a bipartite graph"},{"type":"text","text":" "},{"type":"text","text":"(König’s theorem; rustworkx "},{"code":"graph_bipartite_edge_color","type":"codeVoice"},{"type":"text","text":"), or nil when the graph is not"},{"type":"text","text":" "},{"type":"text","text":"bipartite ("},{"code":"findOddCycle()","type":"codeVoice"},{"type":"text","text":" gives the witness; a self-loop makes it not bipartite)."},{"type":"text","text":" "},{"type":"text","text":"Parallel edges are fine. Edges in position order: each takes the least colour free at its"},{"type":"text","text":" "},{"type":"text","text":"end with the lesser vertex index, after the alternating path of that colour and the least"},{"type":"text","text":" "},{"type":"text","text":"colour free at the other end is flipped from the other end, when the two differ there."},{"type":"text","text":" "},{"type":"text","text":"O(m · (n + Δ)) time, O(n + m) memory."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bipartiteEdgeColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"title":"bipartiteEdgeColoring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/bipartiteedgecoloring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/minimumColoring()":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()","abstract":[{"type":"text","text":"An optimal colouring of the simple graph: "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":", with colours"},{"type":"text","text":" "},{"type":"text","text":"numbered by first appearance in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (the first vertex has colour 0, and each"},{"type":"text","text":" "},{"type":"text","text":"colour first appears after the one below it). It is the colouring "},{"code":"chromaticNumber()","type":"codeVoice"},{"type":"text","text":"‘s"},{"type":"text","text":" "},{"type":"text","text":"search finds, so it costs the same: a bipartite graph gets its "},{"code":"bipartition()","type":"codeVoice"},{"type":"text","text":" sides (left"},{"type":"text","text":" "},{"type":"text","text":"0), and each other component the colouring that DSatur branch and bound found for it, or"},{"type":"text","text":" "},{"type":"text","text":"greedy DSatur’s when that already uses no more colours than another component needs."},{"type":"text","text":" "},{"type":"text","text":"Sage "},{"code":"vertex_coloring()","type":"codeVoice"},{"type":"text","text":" and JGraphT "},{"code":"BrownBacktrackColoring.getColoring","type":"codeVoice"},{"type":"text","text":", which also return"},{"type":"text","text":" "},{"type":"text","text":"the optimal colouring their search finds; Mathematica "},{"code":"FindVertexColoring","type":"codeVoice"},{"type":"text","text":". Deterministic, but which optimal colouring it is depends on the search; for one fixed"},{"type":"text","text":" "},{"type":"text","text":"by a rule, see "},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"type":"text","text":". Exponential in the worst case, as"},{"type":"text","text":" "},{"code":"chromaticNumber()","type":"codeVoice"},{"type":"text","text":" is; the search does not check for task cancellation."}],"title":"minimumColoring()","role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/minimumcoloring()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/chromaticNumber()":{"title":"chromaticNumber()","type":"topic","abstract":[{"text":"The chromatic number χ of the simple graph (self-loops ignored, parallel edges once): the","type":"text"},{"text":" ","type":"text"},{"text":"fewest colours of a proper colouring. 0 for the empty graph, 1 without edges, 2 when","type":"text"},{"text":" ","type":"text"},{"text":"bipartite with an edge (BipartiteGraphs’ two-colouring, O(n + m)). Otherwise the greatest","type":"text"},{"text":" ","type":"text"},{"text":"over the connected components, each non-bipartite one decided by DSatur branch and bound","type":"text"},{"text":" ","type":"text"},{"text":"(Brélaz 1979) between a greedy clique and greedy DSatur (Sage ","type":"text"},{"type":"codeVoice","code":"chromatic_number"},{"text":", JGraphT","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BrownBacktrackColoring.getChromaticNumber"},{"text":", Mathematica ","type":"text"},{"type":"codeVoice","code":"VertexChromaticNumber"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Exponential in the worst case: Mycielski graphs, whose χ exceeds ω by a lot, are the hard","type":"text"},{"text":" ","type":"text"},{"text":"ones. The search does not check for task cancellation.","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/chromaticnumber()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chromaticNumber"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}]}}}