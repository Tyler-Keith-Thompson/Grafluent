{"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"symbolKind":"extension","modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}],"roleHeading":"Extended Protocol","externalID":"s:e:s:14GraphProtocols0A0P14ColoringModuleE04edgeC0AD04EdgeC0VyxGyF","title":"Graph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"extendedModule":"GraphProtocols"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"languages":["swift"],"platforms":["Linux"]}]}],"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/edgeColoring()":{"abstract":[{"type":"text","text":"An edge colouring with at most Δ + 1 colours (Vizing’s bound), by Misra and Gries’s"},{"type":"text","text":" "},{"type":"text","text":"constructive proof (Boost "},{"type":"codeVoice","code":"edge_coloring"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"graph_misra_gries_edge_color"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"their own choices; Sage "},{"type":"codeVoice","code":"edge_coloring"},{"type":"text","text":"). Edges in position order, each coloured through a"},{"type":"text","text":" "},{"type":"text","text":"fan at its end with the lesser vertex index, every choice the least colour or vertex"},{"type":"text","text":" "},{"type":"text","text":"available. At least Δ colours always, and Δ + 1 on class-2 graphs (odd cycles, odd complete"},{"type":"text","text":" "},{"type":"text","text":"graphs, Petersen), but sometimes Δ + 1 on class-1 graphs too (K(4)); on a bipartite graph"},{"type":"text","text":" "},{"type":"codeVoice","code":"bipartiteEdgeColoring()"},{"type":"text","text":" always gives Δ. O(m · (Δ² + n)) time: a fan has at most Δ"},{"type":"text","text":" "},{"type":"text","text":"vertices, each found among the edges at u, and a path at most n edges. O(n + m) memory."},{"type":"text","text":" "},{"type":"text","text":"For a multigraph ("},{"type":"codeVoice","code":"digraph.undirected"},{"type":"text","text":" with an antiparallel pair is one), use"},{"type":"text","text":" "},{"type":"codeVoice","code":"greedyEdgeColoring()"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule04EdgeA0V","text":"EdgeColoring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"edgeColoring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/edgecoloring()","type":"topic","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:presetColor:)":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:presetcolor:)","title":"greedyColoring(strategy:presetColor:)","role":"symbol","abstract":[{"type":"text","text":"The greedy colouring with some colours fixed in advance (rustworkx"},{"type":"text","text":" "},{"code":"graph_greedy_color(preset_color_fn=)","type":"codeVoice"},{"type":"text","text":"): "},{"code":"presetColor","type":"codeVoice"},{"type":"text","text":" gives a vertex’s colour, or nil to"},{"type":"text","text":" "},{"type":"text","text":"leave it to the strategy. Preset vertices keep their colours and count as coloured from the"},{"type":"text","text":" "},{"type":"text","text":"start; the others are coloured as by "},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"type":"text","text":", each taking the least"},{"type":"text","text":" "},{"type":"text","text":"colour no coloured neighbour has. The orders of "},{"code":".largestFirst","type":"codeVoice"},{"type":"text","text":", "},{"code":".smallestLast","type":"codeVoice"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"type":"text","text":"connected sequential strategies are those of the whole graph with the preset vertices"},{"type":"text","text":" "},{"type":"text","text":"skipped (rustworkx’s largest first: whole-graph degrees, preset vertices left out);"},{"type":"text","text":" "},{"type":"text","text":"DSatur counts preset colours in saturation from the start (rustworkx’s saturation);"},{"type":"text","text":" "},{"code":".independentSet","type":"codeVoice"},{"type":"text","text":"‘s class k starts without the neighbours of the vertices preset to k"},{"type":"text","text":" "},{"type":"text","text":"(rustworkx’s independent set); "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":" counts preset neighbours as coloured and"},{"type":"text","text":" "},{"type":"text","text":"takes its first vertex from its heap. "},{"code":"colorCount","type":"codeVoice"},{"type":"text","text":" is one more than the greatest colour,"},{"type":"text","text":" "},{"type":"text","text":"so preset colours may leave some colours unused. "},{"code":"presetColor","type":"codeVoice"},{"type":"text","text":" is called once per vertex,"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. The strategy’s time, plus O(n + m) to check the presets."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyColoring"},{"kind":"text","text":"("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14ColoringModule0A8StrategyO","kind":"typeIdentifier","text":"ColoringStrategy"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presetColor"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?) -> "},{"preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyEdgeColoring()":{"abstract":[{"type":"text","text":"A greedy edge colouring of any graph, parallel edges and self-loops included, with at most"},{"type":"text","text":" "},{"type":"text","text":"2Δ − 1 colours: rustworkx "},{"type":"codeVoice","code":"graph_greedy_edge_color"},{"type":"text","text":", the largest-first colouring of the"},{"type":"text","text":" "},{"type":"text","text":"line graph, with the same colours. Edges by the number of other edges they share an end"},{"type":"text","text":" "},{"type":"text","text":"with, most first (a parallel copy counts at both ends, a self-loop meets each other edge at"},{"type":"text","text":" "},{"type":"text","text":"its vertex once), ties in position order; each takes the least colour of no edge it shares"},{"type":"text","text":" "},{"type":"text","text":"an end with that is already coloured. A self-loop is one edge at its vertex, as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"isEdgeColoring(_:)"},{"type":"text","text":". O(n + m · Δ) time, O(n + m) memory, without building the line graph."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyEdgeColoring"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:14ColoringModule04EdgeA0V","kind":"typeIdentifier","text":"EdgeColoring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","type":"topic","title":"greedyEdgeColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedyedgecoloring()","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:)":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:)","title":"greedyColoring(strategy:)","role":"symbol","abstract":[{"text":"A greedy colouring of the simple graph (self-loops ignored, parallel edges once): each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in the strategy’s order takes the least colour none of its already coloured","type":"text"},{"text":" ","type":"text"},{"text":"neighbours has. NetworkX ","type":"text"},{"type":"codeVoice","code":"greedy_color(G, strategy)"},{"type":"text","text":", the same colours on simple graphs for"},{"type":"text","text":" "},{"type":"codeVoice","code":".largestFirst"},{"type":"text","text":" and "},{"type":"codeVoice","code":".saturationLargestFirst"},{"type":"text","text":", and for the others wherever NetworkX’s set"},{"type":"text","text":" "},{"type":"text","text":"iteration is ascending (NetworkX counts a self-loop in degrees, and its smallest last"},{"type":"text","text":" "},{"type":"text","text":"raises on one); igraph "},{"type":"codeVoice","code":"vertex_coloring_greedy"},{"type":"text","text":" for "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"; Boost"},{"type":"text","text":" "},{"type":"codeVoice","code":"sequential_vertex_coloring"},{"type":"text","text":" in the strategy’s order; rustworkx "},{"type":"codeVoice","code":"graph_greedy_color"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Colours are first-fit numbers, not renumbered: colour 0 goes to the first vertex coloured."},{"type":"text","text":" "},{"type":"text","text":"At most Δ + 1 colours ("},{"type":"codeVoice","code":".smallestLast"},{"type":"text","text":": degeneracy + 1). O(n + m) for largest first and"},{"type":"text","text":" "},{"type":"text","text":"connected sequential, O((n + m) log n) for smallest last, DSatur and colored neighbours,"},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for independent set."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A8StrategyO","text":"ColoringStrategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","url":"\/documentation\/graphprotocols\/graph","title":"Graph","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","url":"\/documentation\/coloringmodule\/graphprotocols","title":"GraphProtocols","role":"collection","abstract":[],"kind":"symbol","type":"topic"},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"kind":"symbol","title":"ColoringModule","type":"topic","url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/chromaticNumber()":{"kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/chromaticnumber()","abstract":[{"type":"text","text":"The chromatic number χ of the simple graph (self-loops ignored, parallel edges once): the"},{"type":"text","text":" "},{"type":"text","text":"fewest colours of a proper colouring. 0 for the empty graph, 1 without edges, 2 when"},{"type":"text","text":" "},{"type":"text","text":"bipartite with an edge (BipartiteGraphs’ two-colouring, O(n + m)). Otherwise the greatest"},{"type":"text","text":" "},{"type":"text","text":"over the connected components, each non-bipartite one decided by DSatur branch and bound"},{"type":"text","text":" "},{"type":"text","text":"(Brélaz 1979) between a greedy clique and greedy DSatur (Sage "},{"type":"codeVoice","code":"chromatic_number"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"BrownBacktrackColoring.getChromaticNumber"},{"type":"text","text":", Mathematica "},{"type":"codeVoice","code":"VertexChromaticNumber"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Exponential in the worst case: Mycielski graphs, whose χ exceeds ω by a lot, are the hard"},{"type":"text","text":" "},{"type":"text","text":"ones. The search does not check for task cancellation."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chromaticNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","title":"chromaticNumber()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isEdgeColoring(_:)":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isedgecoloring(_:)","title":"isEdgeColoring(_:)","role":"symbol","abstract":[{"type":"text","text":"Whether every two edges with a common end have different colours: parallel edges, which"},{"type":"text","text":" "},{"type":"text","text":"share both ends, and a self-loop and any other edge at its vertex (igraph"},{"type":"text","text":" "},{"type":"codeVoice","code":"is_edge_coloring"},{"type":"text","text":"). Any Ints count as colours. "},{"type":"codeVoice","code":"color"},{"type":"text","text":" is called once per edge, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order. O(n + m), plus one hash per edge when the colours are not small"},{"type":"text","text":" "},{"type":"text","text":"non-negative numbers."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/minimumColoring()":{"kind":"symbol","abstract":[{"type":"text","text":"An optimal colouring of the simple graph: "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":", with colours"},{"type":"text","text":" "},{"type":"text","text":"numbered by first appearance in "},{"code":"vertices","type":"codeVoice"},{"text":" order (the first vertex has colour 0, and each","type":"text"},{"text":" ","type":"text"},{"text":"colour first appears after the one below it). It is the colouring ","type":"text"},{"code":"chromaticNumber()","type":"codeVoice"},{"text":"‘s","type":"text"},{"text":" ","type":"text"},{"text":"search finds, so it costs the same: a bipartite graph gets its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left","type":"text"},{"text":" ","type":"text"},{"text":"0), and each other component the colouring that DSatur branch and bound found for it, or","type":"text"},{"text":" ","type":"text"},{"text":"greedy DSatur’s when that already uses no more colours than another component needs.","type":"text"},{"text":" ","type":"text"},{"text":"Sage ","type":"text"},{"code":"vertex_coloring()","type":"codeVoice"},{"text":" and JGraphT ","type":"text"},{"code":"BrownBacktrackColoring.getColoring","type":"codeVoice"},{"text":", which also return","type":"text"},{"text":" ","type":"text"},{"text":"the optimal colouring their search finds; Mathematica ","type":"text"},{"code":"FindVertexColoring","type":"codeVoice"},{"text":". Deterministic, but which optimal colouring it is depends on the search; for one fixed","type":"text"},{"text":" ","type":"text"},{"text":"by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"text":". Exponential in the worst case, as","type":"text"},{"text":" ","type":"text"},{"code":"chromaticNumber()","type":"codeVoice"},{"text":" is; the search does not check for task cancellation.","type":"text"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/minimumcoloring()","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()","title":"minimumColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isVertexColoring(_:)":{"kind":"symbol","abstract":[{"text":"Whether ","type":"text"},{"code":"color","type":"codeVoice"},{"text":" gives the two ends of every edge different colours (igraph","type":"text"},{"text":" ","type":"text"},{"code":"is_vertex_coloring","type":"codeVoice"},{"text":", NetworkX ","type":"text"},{"code":"is_coloring","type":"codeVoice"},{"text":"). Self-loops are ignored, as the colourings","type":"text"},{"text":" ","type":"text"},{"text":"ignore them (NetworkX’s ","type":"text"},{"code":"is_coloring","type":"codeVoice"},{"text":" is false on any loop). Any Ints count as colours, not","type":"text"},{"text":" ","type":"text"},{"text":"only ","type":"text"},{"code":"0..<k","type":"codeVoice"},{"text":". ","type":"text"},{"code":"color","type":"codeVoice"},{"text":" is called once per vertex, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isvertexcoloring(_:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isVertexColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","title":"isVertexColoring(_:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(order:)":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(order:)","title":"greedyColoring(order:)","role":"symbol","abstract":[{"text":"First fit in ","type":"text"},{"code":"order","type":"codeVoice"},{"text":" on the simple graph: each vertex in turn takes the least colour none of","type":"text"},{"text":" ","type":"text"},{"text":"its already coloured neighbours has (Boost ","type":"text"},{"code":"sequential_vertex_coloring(g, order, color)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"JGraphT ","type":"text"},{"code":"GreedyColoring","type":"codeVoice"},{"text":", NetworkX ","type":"text"},{"code":"greedy_color","type":"codeVoice"},{"text":" with a callable strategy). A shuffled","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is NetworkX’s ","type":"text"},{"code":"random_sequential","type":"codeVoice"},{"text":". At most Δ + 1 colours. O(n + m) after one","type":"text"},{"text":" ","type":"text"},{"text":"lookup per vertex.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"order","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/bipartiteEdgeColoring()":{"kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/bipartiteedgecoloring()","abstract":[{"text":"An edge colouring with exactly Δ colours, Δ counting parallel edges, on a bipartite graph","type":"text"},{"text":" ","type":"text"},{"text":"(König’s theorem; rustworkx ","type":"text"},{"code":"graph_bipartite_edge_color","type":"codeVoice"},{"text":"), or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"bipartite (","type":"text"},{"code":"findOddCycle()","type":"codeVoice"},{"text":" gives the witness; a self-loop makes it not bipartite).","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are fine. Edges in position order: each takes the least colour free at its","type":"text"},{"text":" ","type":"text"},{"text":"end with the lesser vertex index, after the alternating path of that colour and the least","type":"text"},{"text":" ","type":"text"},{"text":"colour free at the other end is flipped from the other end, when the two differ there.","type":"text"},{"text":" ","type":"text"},{"text":"O(m · (n + Δ)) time, O(n + m) memory.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bipartiteEdgeColoring"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:14ColoringModule04EdgeA0V","kind":"typeIdentifier","text":"EdgeColoring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","title":"bipartiteEdgeColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[],"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","type":"topic","title":"Graph","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","title":"lexicographicallyFirstMinimumColoring()","role":"symbol","abstract":[{"type":"text","text":"The lexicographically first minimum colouring of the simple graph: on each connected"},{"type":"text","text":" "},{"type":"text","text":"component, of all its colourings with its own chromatic number of colours, the one whose"},{"type":"text","text":" "},{"type":"text","text":"colour vector (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()"}}}