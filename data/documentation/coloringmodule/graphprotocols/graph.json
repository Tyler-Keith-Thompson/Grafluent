{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"metadata":{"symbolKind":"extension","role":"symbol","extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"roleHeading":"Extended Protocol","title":"Graph","externalID":"s:e:s:14GraphProtocols0A0P14ColoringModuleE04edgeC0AD04EdgeC0VyxGyF","modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph"]}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}]}]}],"sections":[],"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"kind":"symbol","title":"lexicographicallyFirstMinimumColoring()","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","role":"symbol","abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"symbol","url":"\/documentation\/graphprotocols\/graph","title":"Graph","role":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directed"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(order:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyColoring","kind":"identifier"},{"text":"(","kind":"text"},{"text":"order","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(order:)","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(order:)","abstract":[{"type":"text","text":"First fit in "},{"type":"codeVoice","code":"order"},{"type":"text","text":" on the simple graph: each vertex in turn takes the least colour none of"},{"type":"text","text":" "},{"type":"text","text":"its already coloured neighbours has (Boost "},{"type":"codeVoice","code":"sequential_vertex_coloring(g, order, color)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"JGraphT ","type":"text"},{"code":"GreedyColoring","type":"codeVoice"},{"text":", NetworkX ","type":"text"},{"code":"greedy_color","type":"codeVoice"},{"text":" with a callable strategy). A shuffled","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is NetworkX’s ","type":"text"},{"code":"random_sequential","type":"codeVoice"},{"text":". At most Δ + 1 colours. O(n + m) after one","type":"text"},{"text":" ","type":"text"},{"text":"lookup per vertex.","type":"text"}],"title":"greedyColoring(order:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"kind":"symbol","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","abstract":[],"title":"Graph","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isVertexColoring(_:)":{"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isVertexColoring(_:)","kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isvertexcoloring(_:)","title":"isVertexColoring(_:)","role":"symbol","abstract":[{"text":"Whether ","type":"text"},{"code":"color","type":"codeVoice"},{"text":" gives the two ends of every edge different colours (igraph","type":"text"},{"text":" ","type":"text"},{"code":"is_vertex_coloring","type":"codeVoice"},{"text":", NetworkX ","type":"text"},{"code":"is_coloring","type":"codeVoice"},{"text":"). Self-loops are ignored, as the colourings","type":"text"},{"text":" ","type":"text"},{"text":"ignore them (NetworkX’s ","type":"text"},{"code":"is_coloring","type":"codeVoice"},{"text":" is false on any loop). Any Ints count as colours, not","type":"text"},{"text":" ","type":"text"},{"text":"only ","type":"text"},{"code":"0..<k","type":"codeVoice"},{"text":". ","type":"text"},{"code":"color","type":"codeVoice"},{"text":" is called once per vertex, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVertexColoring"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/chromaticNumber()":{"kind":"symbol","title":"chromaticNumber()","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/chromaticnumber()","role":"symbol","abstract":[{"type":"text","text":"The chromatic number χ of the simple graph (self-loops ignored, parallel edges once): the"},{"type":"text","text":" "},{"type":"text","text":"fewest colours of a proper colouring. 0 for the empty graph, 1 without edges, 2 when"},{"type":"text","text":" "},{"type":"text","text":"bipartite with an edge (BipartiteGraphs’ two-colouring, O(n + m)). Otherwise the greatest"},{"type":"text","text":" "},{"type":"text","text":"over the connected components, each non-bipartite one decided by DSatur branch and bound"},{"type":"text","text":" "},{"type":"text","text":"(Brélaz 1979) between a greedy clique and greedy DSatur (Sage "},{"type":"codeVoice","code":"chromatic_number"},{"type":"text","text":", JGraphT"},{"type":"text","text":" "},{"type":"codeVoice","code":"BrownBacktrackColoring.getChromaticNumber"},{"type":"text","text":", Mathematica "},{"type":"codeVoice","code":"VertexChromaticNumber"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Exponential in the worst case: Mycielski graphs, whose χ exceeds ω by a lot, are the hard"},{"type":"text","text":" "},{"type":"text","text":"ones. The search does not check for task cancellation."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chromaticNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/chromaticNumber()"},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"role":"collection","url":"\/documentation\/coloringmodule","kind":"symbol","title":"ColoringModule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/isEdgeColoring(_:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeColoring","kind":"identifier"},{"text":"((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/isEdgeColoring(_:)","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/isedgecoloring(_:)","title":"isEdgeColoring(_:)","abstract":[{"text":"Whether every two edges with a common end have different colours: parallel edges, which","type":"text"},{"text":" ","type":"text"},{"text":"share both ends, and a self-loop and any other edge at its vertex (igraph","type":"text"},{"text":" ","type":"text"},{"code":"is_edge_coloring","type":"codeVoice"},{"text":"). Any Ints count as colours. ","type":"text"},{"code":"color","type":"codeVoice"},{"type":"text","text":" is called once per edge, in"},{"type":"text","text":" "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" order. O(n + m), plus one hash per edge when the colours are not small"},{"type":"text","text":" "},{"type":"text","text":"non-negative numbers."}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/edgeColoring()":{"kind":"symbol","title":"edgeColoring()","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/edgecoloring()","role":"symbol","abstract":[{"type":"text","text":"An edge colouring with at most Δ + 1 colours (Vizing’s bound), by Misra and Gries’s"},{"type":"text","text":" "},{"type":"text","text":"constructive proof (Boost "},{"type":"codeVoice","code":"edge_coloring"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"graph_misra_gries_edge_color"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"their own choices; Sage "},{"code":"edge_coloring","type":"codeVoice"},{"type":"text","text":"). Edges in position order, each coloured through a"},{"type":"text","text":" "},{"type":"text","text":"fan at its end with the lesser vertex index, every choice the least colour or vertex"},{"type":"text","text":" "},{"type":"text","text":"available. At least Δ colours always, and Δ + 1 on class-2 graphs (odd cycles, odd complete"},{"type":"text","text":" "},{"type":"text","text":"graphs, Petersen), but sometimes Δ + 1 on class-1 graphs too (K(4)); on a bipartite graph"},{"type":"text","text":" "},{"code":"bipartiteEdgeColoring()","type":"codeVoice"},{"type":"text","text":" always gives Δ. O(m · (Δ² + n)) time: a fan has at most Δ"},{"type":"text","text":" "},{"type":"text","text":"vertices, each found among the edges at u, and a path at most n edges. O(n + m) memory."},{"type":"text","text":" "},{"type":"text","text":"For a multigraph ("},{"code":"digraph.undirected","type":"codeVoice"},{"type":"text","text":" with an antiparallel pair is one), use"},{"type":"text","text":" "},{"code":"greedyEdgeColoring()","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EdgeColoring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/edgeColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/minimumColoring()":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/minimumColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/minimumcoloring()","title":"minimumColoring()","abstract":[{"type":"text","text":"An optimal colouring of the simple graph: "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":", with colours"},{"type":"text","text":" "},{"type":"text","text":"numbered by first appearance in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (the first vertex has colour 0, and each"},{"type":"text","text":" "},{"type":"text","text":"colour first appears after the one below it). It is the colouring "},{"code":"chromaticNumber()","type":"codeVoice"},{"type":"text","text":"‘s"},{"type":"text","text":" "},{"type":"text","text":"search finds, so it costs the same: a bipartite graph gets its "},{"code":"bipartition()","type":"codeVoice"},{"type":"text","text":" sides (left"},{"type":"text","text":" "},{"type":"text","text":"0), and each other component the colouring that DSatur branch and bound found for it, or"},{"type":"text","text":" "},{"type":"text","text":"greedy DSatur’s when that already uses no more colours than another component needs."},{"type":"text","text":" "},{"type":"text","text":"Sage "},{"code":"vertex_coloring()","type":"codeVoice"},{"type":"text","text":" and JGraphT "},{"code":"BrownBacktrackColoring.getColoring","type":"codeVoice"},{"type":"text","text":", which also return"},{"type":"text","text":" "},{"type":"text","text":"the optimal colouring their search finds; Mathematica "},{"code":"FindVertexColoring","type":"codeVoice"},{"type":"text","text":". Deterministic, but which optimal colouring it is depends on the search; for one fixed"},{"type":"text","text":" "},{"type":"text","text":"by a rule, see "},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"type":"text","text":". Exponential in the worst case, as"},{"type":"text","text":" "},{"code":"chromaticNumber()","type":"codeVoice"},{"type":"text","text":" is; the search does not check for task cancellation."}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyEdgeColoring()":{"kind":"symbol","title":"greedyEdgeColoring()","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedyedgecoloring()","role":"symbol","abstract":[{"text":"A greedy edge colouring of any graph, parallel edges and self-loops included, with at most","type":"text"},{"text":" ","type":"text"},{"text":"2Δ − 1 colours: rustworkx ","type":"text"},{"code":"graph_greedy_edge_color","type":"codeVoice"},{"text":", the largest-first colouring of the","type":"text"},{"text":" ","type":"text"},{"text":"line graph, with the same colours. Edges by the number of other edges they share an end","type":"text"},{"text":" ","type":"text"},{"text":"with, most first (a parallel copy counts at both ends, a self-loop meets each other edge at","type":"text"},{"text":" ","type":"text"},{"text":"its vertex once), ties in position order; each takes the least colour of no edge it shares","type":"text"},{"text":" ","type":"text"},{"text":"an end with that is already coloured. A self-loop is one edge at its vertex, as for","type":"text"},{"text":" ","type":"text"},{"code":"isEdgeColoring(_:)","type":"codeVoice"},{"text":". O(n + m · Δ) time, O(n + m) memory, without building the line graph.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"greedyEdgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule04EdgeA0V","text":"EdgeColoring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyEdgeColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:)":{"kind":"symbol","title":"greedyColoring(strategy:)","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:)","role":"symbol","abstract":[{"type":"text","text":"A greedy colouring of the simple graph (self-loops ignored, parallel edges once): each"},{"type":"text","text":" "},{"type":"text","text":"vertex in the strategy’s order takes the least colour none of its already coloured"},{"type":"text","text":" "},{"type":"text","text":"neighbours has. NetworkX "},{"code":"greedy_color(G, strategy)","type":"codeVoice"},{"type":"text","text":", the same colours on simple graphs for"},{"type":"text","text":" "},{"code":".largestFirst","type":"codeVoice"},{"type":"text","text":" and "},{"code":".saturationLargestFirst","type":"codeVoice"},{"type":"text","text":", and for the others wherever NetworkX’s set"},{"type":"text","text":" "},{"type":"text","text":"iteration is ascending (NetworkX counts a self-loop in degrees, and its smallest last"},{"type":"text","text":" "},{"type":"text","text":"raises on one); igraph "},{"code":"vertex_coloring_greedy","type":"codeVoice"},{"type":"text","text":" for "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":"; Boost"},{"type":"text","text":" "},{"code":"sequential_vertex_coloring","type":"codeVoice"},{"type":"text","text":" in the strategy’s order; rustworkx "},{"code":"graph_greedy_color","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Colours are first-fit numbers, not renumbered: colour 0 goes to the first vertex coloured."},{"type":"text","text":" "},{"type":"text","text":"At most Δ + 1 colours ("},{"code":".smallestLast","type":"codeVoice"},{"type":"text","text":": degeneracy + 1). O(n + m) for largest first and"},{"type":"text","text":" "},{"type":"text","text":"connected sequential, O((n + m) log n) for smallest last, DSatur and colored neighbours,"},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for independent set."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyColoring"},{"kind":"text","text":"("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A8StrategyO","text":"ColoringStrategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/greedyColoring(strategy:presetColor:)":{"kind":"symbol","title":"greedyColoring(strategy:presetColor:)","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/greedycoloring(strategy:presetcolor:)","role":"symbol","abstract":[{"text":"The greedy colouring with some colours fixed in advance (rustworkx","type":"text"},{"text":" ","type":"text"},{"code":"graph_greedy_color(preset_color_fn=)","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"presetColor","type":"codeVoice"},{"text":" gives a vertex’s colour, or nil to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"leave it to the strategy. Preset vertices keep their colours and count as coloured from the"},{"type":"text","text":" "},{"type":"text","text":"start; the others are coloured as by "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":", each taking the least"},{"type":"text","text":" "},{"type":"text","text":"colour no coloured neighbour has. The orders of "},{"type":"codeVoice","code":".largestFirst"},{"type":"text","text":", "},{"type":"codeVoice","code":".smallestLast"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"type":"text","text":"connected sequential strategies are those of the whole graph with the preset vertices"},{"type":"text","text":" "},{"type":"text","text":"skipped (rustworkx’s largest first: whole-graph degrees, preset vertices left out);"},{"type":"text","text":" "},{"type":"text","text":"DSatur counts preset colours in saturation from the start (rustworkx’s saturation);"},{"type":"text","text":" "},{"type":"codeVoice","code":".independentSet"},{"type":"text","text":"‘s class k starts without the neighbours of the vertices preset to k"},{"type":"text","text":" "},{"type":"text","text":"(rustworkx’s independent set); "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":" counts preset neighbours as coloured and"},{"type":"text","text":" "},{"type":"text","text":"takes its first vertex from its heap. "},{"type":"codeVoice","code":"colorCount"},{"type":"text","text":" is one more than the greatest colour,"},{"type":"text","text":" "},{"type":"text","text":"so preset colours may leave some colours unused. "},{"type":"codeVoice","code":"presetColor"},{"type":"text","text":" is called once per vertex,"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. The strategy’s time, plus O(n + m) to check the presets."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyColoring"},{"kind":"text","text":"("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ColoringStrategy","preciseIdentifier":"s:14ColoringModule0A8StrategyO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"presetColor"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/greedyColoring(strategy:presetColor:)"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/bipartiteEdgeColoring()":{"kind":"symbol","title":"bipartiteEdgeColoring()","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/bipartiteedgecoloring()","role":"symbol","abstract":[{"type":"text","text":"An edge colouring with exactly Δ colours, Δ counting parallel edges, on a bipartite graph"},{"type":"text","text":" "},{"type":"text","text":"(König’s theorem; rustworkx "},{"type":"codeVoice","code":"graph_bipartite_edge_color"},{"type":"text","text":"), or nil when the graph is not"},{"type":"text","text":" "},{"text":"bipartite (","type":"text"},{"code":"findOddCycle()","type":"codeVoice"},{"text":" gives the witness; a self-loop makes it not bipartite).","type":"text"},{"text":" ","type":"text"},{"text":"Parallel edges are fine. Edges in position order: each takes the least colour free at its","type":"text"},{"text":" ","type":"text"},{"text":"end with the lesser vertex index, after the alternating path of that colour and the least","type":"text"},{"text":" ","type":"text"},{"text":"colour free at the other end is flipped from the other end, when the two differ there.","type":"text"},{"text":" ","type":"text"},{"text":"O(m · (n + Δ)) time, O(n + m) memory.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bipartiteEdgeColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EdgeColoring","preciseIdentifier":"s:14ColoringModule04EdgeA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/bipartiteEdgeColoring()"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"abstract":[],"role":"collection","kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","type":"topic"}}}