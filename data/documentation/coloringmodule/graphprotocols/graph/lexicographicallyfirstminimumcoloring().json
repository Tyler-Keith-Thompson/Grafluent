"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","title":"lexicographicallyFirstMinimumColoring()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph","title":"Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"kind":"symbol","title":"Coloring","navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A proper colouring of a graph’s vertices by the colours "},{"type":"codeVoice","code":"0..<colorCount"},{"type":"text","text":", each of which is"},{"type":"text","text":" "},{"type":"text","text":"used (unless preset colours skip some): the result of "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"greedyColoring(strategy:presetColor:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"greedyColoring(order:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"minimumColoring()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"type":"text","text":" (JGraphT "},{"type":"codeVoice","code":"VertexColoringAlgorithm.Coloring"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Graphs.jl "},{"type":"codeVoice","code":"Coloring"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"url":"\/documentation\/coloringmodule\/coloring"},"doc://ColoringModule/documentation/ColoringModule":{"kind":"symbol","title":"ColoringModule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/coloringmodule"}}}