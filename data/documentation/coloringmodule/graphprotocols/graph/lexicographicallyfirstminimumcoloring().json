{"kind":"symbol","identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"First fit in index order (the lexicographically first proper colouring of all) when it is"},{"type":"text","text":" "},{"type":"text","text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still"},{"type":"text","text":" "},{"type":"text","text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the"},{"type":"text","text":" "},{"type":"text","text":"last colouring found when one avoids the prefix, else DSatur branch and bound over the parts"},{"type":"text","text":" "},{"type":"text","text":"after the prefix that the vertex touches (on sparse components with conflict-directed"},{"type":"text","text":" "},{"type":"text","text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first"},{"type":"text","text":" "},{"type":"text","text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in"},{"type":"text","text":" "},{"type":"text","text":"polynomial time. It can be far slower than "},{"code":"minimumColoring()","type":"codeVoice"},{"type":"text","text":", and its time grows steeply"},{"type":"text","text":" "},{"type":"text","text":"with n even on sparse 3-colourable graphs. The search does not check for task cancellation."}],"type":"paragraph"}]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF","extendedModule":"GraphProtocols","role":"symbol","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/ExactColoring.swift#L622","fileName":"ExactColoring.swift"},"symbolKind":"method","modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}],"title":"lexicographicallyFirstMinimumColoring()"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"]}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"The lexicographically first minimum colouring of the simple graph: on each connected"},{"type":"text","text":" "},{"type":"text","text":"component, of all its colourings with its own chromatic number of colours, the one whose"},{"type":"text","text":" "},{"type":"text","text":"colour vector (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","title":"lexicographicallyFirstMinimumColoring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"role":"symbol","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph","abstract":[]},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"abstract":[{"text":"A proper colouring of a graph’s vertices by the colours ","type":"text"},{"code":"0..<colorCount","type":"codeVoice"},{"text":", each of which is used","type":"text"},{"text":" ","type":"text"},{"text":"(unless preset colours skip some): the result of ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"greedyColoring(strategy:presetColor:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"greedyColoring(order:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","url":"\/documentation\/coloringmodule\/coloring","title":"Coloring","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"kind":"symbol","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","title":"ColoringModule","kind":"symbol","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","title":"GraphProtocols","type":"topic","url":"\/documentation\/coloringmodule\/graphprotocols","role":"collection","abstract":[]}}}