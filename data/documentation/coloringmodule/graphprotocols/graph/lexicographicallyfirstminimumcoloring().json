umentation\/ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"abstract":[{"type":"text","text":"A proper colouring of a graph’s vertices by the colours "},{"type":"codeVoice","code":"0..<colorCount"},{"type":"text","text":", each of which is"},{"type":"text","text":" "},{"type":"text","text":"used (unless preset colours skip some): the result of "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"greedyColoring(strategy:presetColor:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"greedyColoring(order:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"minimumColoring()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"type":"text","text":" (JGraphT "},{"type":"codeVoice","code":"VertexColoringAlgorithm.Coloring"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Graphs.jl "},{"type":"codeVoice","code":"Coloring"},{"type":"text","text":")."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"url":"\/documentation\/coloringmodule\/coloring","title":"Coloring"}}}