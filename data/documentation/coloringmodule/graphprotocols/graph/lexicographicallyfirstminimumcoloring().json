{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","interfaceLanguage":"swift"},"sections":[],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/ExactColoring.swift#L625","fileName":"ExactColoring.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF","title":"lexicographicallyFirstMinimumColoring()","modules":[{"relatedModules":["GraphProtocols"],"name":"ColoringModule"}],"role":"symbol","extendedModule":"GraphProtocols","symbolKind":"method"},"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"First fit in index order (the lexicographically first proper colouring of all) when it is"},{"type":"text","text":" "},{"type":"text","text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still"},{"type":"text","text":" "},{"type":"text","text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the"},{"type":"text","text":" "},{"type":"text","text":"last colouring found when one avoids the prefix, else DSatur branch and bound over the parts"},{"type":"text","text":" "},{"type":"text","text":"after the prefix that the vertex touches (on sparse components with conflict-directed"},{"type":"text","text":" "},{"type":"text","text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first"},{"type":"text","text":" "},{"type":"text","text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in"},{"type":"text","text":" "},{"type":"text","text":"polynomial time. It can be far slower than "},{"type":"codeVoice","code":"minimumColoring()"},{"type":"text","text":", and its time grows steeply"},{"type":"text","text":" "},{"type":"text","text":"with n even on sparse 3-colourable graphs. The search does not check for task cancellation."}]}]}],"references":{"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"type":"topic","title":"ColoringModule","url":"\/documentation\/coloringmodule","role":"collection","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"title":"Coloring","abstract":[{"text":"A proper colouring of a graph’s vertices by the colours ","type":"text"},{"type":"codeVoice","code":"0..<colorCount"},{"text":", each of which is used","type":"text"},{"text":" ","type":"text"},{"text":"(unless preset colours skip some): the result of ","type":"text"},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"greedyColoring(strategy:presetColor:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"greedyColoring(order:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"minimumColoring()"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/coloring"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[],"type":"topic","title":"Graph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","abstract":[{"type":"text","text":"The lexicographically first minimum colouring of the simple graph: on each connected"},{"type":"text","text":" "},{"type":"text","text":"component, of all its colourings with its own chromatic number of colours, the one whose"},{"type":"text","text":" "},{"type":"text","text":"colour vector (in "},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"type":"topic","title":"lexicographicallyFirstMinimumColoring()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","title":"GraphProtocols","abstract":[],"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/coloringmodule\/graphprotocols"}}}