lours beside a triangle."}]},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"title":"Coloring","abstract":[{"text":"A proper colouring of a graph’s vertices by the colours ","type":"text"},{"code":"0..<colorCount","type":"codeVoice"},{"text":", each of which is","type":"text"},{"text":" ","type":"text"},{"text":"used (unless preset colours skip some): the result of ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"greedyColoring(strategy:presetColor:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"greedyColoring(order:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"text":" (JGraphT ","type":"text"},{"code":"VertexColoringAlgorithm.Coloring","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Graphs.jl ","type":"text"},{"code":"Coloring","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","url":"\/documentation\/coloringmodule\/coloring","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"role":"symbol"}}}