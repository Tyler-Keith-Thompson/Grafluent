{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"ColoringModule"}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF","symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"lexicographicallyFirstMinimumColoring()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()"},"abstract":[{"type":"text","text":"The lexicographically first minimum colouring of the simple graph: on each connected"},{"type":"text","text":" "},{"type":"text","text":"component, of all its colourings with its own chromatic number of colours, the one whose"},{"type":"text","text":" "},{"type":"text","text":"colour vector (in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"code":"bipartition()","type":"codeVoice"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"First fit in index order (the lexicographically first proper colouring of all) when it is"},{"type":"text","text":" "},{"type":"text","text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still"},{"type":"text","text":" "},{"type":"text","text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the"},{"type":"text","text":" "},{"type":"text","text":"last colouring found when one avoids the prefix, else DSatur branch and bound over the parts"},{"type":"text","text":" "},{"type":"text","text":"after the prefix that the vertex touches (on sparse components with conflict-directed"},{"type":"text","text":" "},{"type":"text","text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first"},{"type":"text","text":" "},{"type":"text","text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in"},{"type":"text","text":" "},{"type":"text","text":"polynomial time. It can be far slower than "},{"code":"minimumColoring()","type":"codeVoice"},{"type":"text","text":", and its time grows steeply"},{"type":"text","text":" "},{"type":"text","text":"with n even on sparse 3-colourable graphs. The search does not check for task cancellation."}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ColoringModule/documentation/ColoringModule/Coloring":{"kind":"symbol","title":"Coloring","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Coloring","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloring","type":"topic","navigatorTitle":[{"text":"Coloring","kind":"identifier"}],"abstract":[{"type":"text","text":"A proper colouring of a graph’s vertices by the colours "},{"type":"codeVoice","code":"0..<colorCount"},{"type":"text","text":", each of which is used"},{"type":"text","text":" "},{"type":"text","text":"(unless preset colours skip some): the result of "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"greedyColoring(strategy:presetColor:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"greedyColoring(order:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"minimumColoring()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"type":"text","text":"."}],"role":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","kind":"symbol","url":"\/documentation\/coloringmodule","abstract":[],"title":"ColoringModule","role":"collection","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","abstract":[{"type":"text","text":"The lexicographically first minimum colouring of the simple graph: on each connected"},{"type":"text","text":" "},{"type":"text","text":"component, of all its colourings with its own chromatic number of colours, the one whose"},{"type":"text","text":" "},{"type":"text","text":"colour vector (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"title":"lexicographicallyFirstMinimumColoring()","role":"symbol","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","url":"\/documentation\/coloringmodule\/graphprotocols","type":"topic","abstract":[],"role":"collection"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph","abstract":[],"title":"Graph","role":"symbol","type":"topic"}}}