"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"First fit in index order (the lexicographically first proper colouring of all) when it is","type":"text"},{"text":" ","type":"text"},{"text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still","type":"text"},{"text":" ","type":"text"},{"text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the last","type":"text"},{"text":" ","type":"text"},{"text":"colouring found when one avoids the prefix, else DSatur branch and bound over the parts","type":"text"},{"text":" ","type":"text"},{"text":"after the prefix that the vertex touches (on sparse components with conflict-directed","type":"text"},{"text":" ","type":"text"},{"text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first","type":"text"},{"text":" ","type":"text"},{"text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in","type":"text"},{"text":" ","type":"text"},{"text":"polynomial time. It can be far slower than ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":": on random sparse","type":"text"},{"text":" ","type":"text"},{"text":"3-colourable graphs with 2n edges it took about 0.2 s at 1,000 vertices, 2.7 s at 2,000 and","type":"text"},{"text":" ","type":"text"},{"text":"over 100 s at 5,000, where ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" takes about a millisecond. The search does not","type":"text"},{"text":" ","type":"text"},{"text":"check for task cancellation.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://ColoringModule/documentation/ColoringModule/Coloring":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"abstract":[{"text":"A proper colouring of a graph’s vertices by the colours ","type":"text"},{"code":"0..<colorCount","type":"codeVoice"},{"text":", each of which is","type":"text"},{"text":" ","type":"text"},{"text":"used (unless preset colours skip some): the result of ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"greedyColoring(strategy:presetColor:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"greedyColoring(order:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"text":" (JGraphT ","type":