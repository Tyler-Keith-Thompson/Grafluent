{"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","interfaceLanguage":"swift"},"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"First fit in index order (the lexicographically first proper colouring of all) when it is"},{"type":"text","text":" "},{"type":"text","text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still"},{"type":"text","text":" "},{"type":"text","text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the last"},{"type":"text","text":" "},{"type":"text","text":"colouring found when one avoids the prefix, else DSatur branch and bound over the parts"},{"type":"text","text":" "},{"type":"text","text":"after the prefix that the vertex touches (on sparse components with conflict-directed"},{"type":"text","text":" "},{"type":"text","text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first"},{"type":"text","text":" "},{"type":"text","text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in"},{"type":"text","text":" "},{"type":"text","text":"polynomial time. It can be far slower than "},{"type":"codeVoice","code":"minimumColoring()"},{"type":"text","text":": on random sparse"},{"type":"text","text":" "},{"type":"text","text":"3-colourable graphs with 2n edges it took about 0.2 s at 1,000 vertices, 2.7 s at 2,000 and"},{"type":"text","text":" "},{"type":"text","text":"over 100 s at 5,000, where "},{"type":"codeVoice","code":"minimumColoring()"},{"type":"text","text":" takes about a millisecond. The search does not"},{"type":"text","text":" "},{"type":"text","text":"check for task cancellation."}]}]}],"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"extendedModule":"GraphProtocols","symbolKind":"method","title":"lexicographicallyFirstMinimumColoring()","externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"ColoringModule"}],"roleHeading":"Instance Method","role":"symbol","remoteSource":{"fileName":"ExactColoring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/ExactColoring.swift#L659"}},"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","abstract":[],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph","type":"topic","title":"Graph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","abstract":[],"type":"topic","title":"GraphProtocols","kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols","role":"collection"},"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"url":"\/documentation\/coloringmodule","type":"topic","title":"Coloring