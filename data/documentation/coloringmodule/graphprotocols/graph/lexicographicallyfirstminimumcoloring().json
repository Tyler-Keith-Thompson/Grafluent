{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"First fit in index order (the lexicographically first proper colouring of all) when it is","type":"text"},{"text":" ","type":"text"},{"text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still","type":"text"},{"text":" ","type":"text"},{"text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the last","type":"text"},{"text":" ","type":"text"},{"text":"colouring found when one avoids the prefix, else DSatur branch and bound over the parts","type":"text"},{"text":" ","type":"text"},{"text":"after the prefix that the vertex touches (on sparse components with conflict-directed","type":"text"},{"text":" ","type":"text"},{"text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first","type":"text"},{"text":" ","type":"text"},{"text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in","type":"text"},{"text":" ","type":"text"},{"text":"polynomial time. It can be far slower than ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":": on random sparse","type":"text"},{"text":" ","type":"text"},{"text":"3-colourable graphs with 2n edges it took about 0.2 s at 1,000 vertices, 2.7 s at 2,000 and","type":"text"},{"text":" ","type":"text"},{"text":"over 100 s at 5,000, where ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" takes about a millisecond. The search does not","type":"text"},{"text":" ","type":"text"},{"text":"check for task cancellation.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()"},"abstract":[{"type":"text","text":"The lexicographically first minimum colouring of the simple graph: on each connected"},{"type":"text","text":" "},{"type":"text","text":"component, of all its colourings with its own chromatic number of colours, the one whose"},{"type":"text","text":" "},{"type":"text","text":"colour vector (in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"code":"bipartition()","type":"codeVoice"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"]}],"metadata":{"roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","symbolKind":"method","modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/ExactColoring.swift#L626","fileName":"ExactColoring.swift"},"title":"lexicographicallyFirstMinimumColoring()"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"title":"Graph","abstract":[],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"url":"\/documentation\/coloringmodule","title":"ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","abstract":[],"url":"\/documentation\/coloringmodule\/graphprotocols","title":"GraphProtocols"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","kind":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","role":"symbol","title":"lexicographicallyFirstMinimumColoring()"},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"abstract":[{"type":"text","text":"A proper colouring of a graph’s vertices by the colours "},{"code":"0..<colorCount","type":"codeVoice"},{"type":"text","text":", each of which is"},{"type":"text","text":" "},{"type":"text","text":"used (unless preset colours skip some): the result of "},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"greedyColoring(strategy:presetColor:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"greedyColoring(order:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"minimumColoring()"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"text":" (JGraphT ","type":"text"},{"type":"codeVoice","code":"VertexColoringAlgorithm.Coloring"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Graphs.jl ","type":"text"},{"type":"codeVoice","code":"Coloring"},{"text":").","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"type":"topic","kind":"symbol","url":"\/documentation\/coloringmodule\/coloring","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"title":"Coloring"}}}