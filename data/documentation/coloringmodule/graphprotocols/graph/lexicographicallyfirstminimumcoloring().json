r graph is NP-hard to find, though some four-colouring is found in","type":"text"},{"text":" ","type":"text"},{"text":"polynomial time. It can be far slower than ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":", and its time grows steeply","type":"text"},{"text":" ","type":"text"},{"text":"with n even on sparse 3-colourable graphs. The search does not check for task cancellation.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"references":{"doc://ColoringModule/documentation/ColoringModule/Coloring":{"role":"symbol","abstract":[{"text":"A proper colouring of a graph’s vertices by the colours ","type":"text"},{"code":"0..<colorCount","type":"codeVoice"},{"text":", each of which is used","type":"text"},{"text":" ","type":"text"},{"text":"(unless preset colours skip some): the result of ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"greedyColoring(strategy:presetColor:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"greedyColoring(order:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Coloring","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","type":"topic","navigatorTitle":[{"text":"Coloring","kind":"identifier"}],"title":"Coloring","url":"\/documentation\/coloringmodule\/coloring","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"kind":"symbol","abstract":[],"url":"\