{"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","interfaceLanguage":"swift"},"metadata":{"extendedModule":"GraphProtocols","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/ExactColoring.swift#L626","fileName":"ExactColoring.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF","modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","title":"lexicographicallyFirstMinimumColoring()"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule0A0V","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","text":"Coloring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"First fit in index order (the lexicographically first proper colouring of all) when it is","type":"text"},{"text":" ","type":"text"},{"text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still","type":"text"},{"text":" ","type":"text"},{"text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the last","type":"text"},{"text":" ","type":"text"},{"text":"colouring found when one avoids the prefix, else DSatur branch and bound over the parts","type":"text"},{"text":" ","type":"text"},{"text":"after the prefix that the vertex touches (on sparse components with conflict-directed","type":"text"},{"text":" ","type":"text"},{"text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first","type":"text"},{"text":" ","type":"text"},{"text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in","type":"text"},{"text":" ","type":"text"},{"text":"polynomial time. It can be far slower than ","type":"text"},{"type":"codeVoice","code":"minimumColoring()"},{"text":": on random sparse","type":"text"},{"text":" ","type":"text"},{"text":"3-colourable graphs with 2n edges it took about 0.2 s at 1,000 vertices, 2.7 s at 2,000 and","type":"text"},{"text":" ","type":"text"},{"text":"over 100 s at 5,000, where ","type":"text"},{"type":"codeVoice","code":"minimumColoring()"},{"text":" takes about a millisecond. The search does not","type":"text"},{"text":" ","type":"text"},{"text":"check for task cancellation.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"type":"codeVoice","code":"bipartition()"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","title":"GraphProtocols","role":"collection","url":"\/documentation\/coloringmodule\/graphprotocols"},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"type":"topic","abstract":[{"text":"A proper colouring of a graph’s vertices by the colours ","type":"text"},{"code":"0..<colorCount","type":"codeVoice"},{"text":", each of which is","type":"text"},{"text":" ","type":"text"},{"text":"used (unless preset colours skip some): the result of ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"greedyColoring(strategy:presetColor:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"greedyColoring(order:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"text":" (JGraphT ","type":"text"},{"code":"VertexColoringAlgorithm.Coloring","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Graphs.jl ","type":"text"},{"code":"Coloring","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Coloring","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloring","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","title":"Coloring","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Coloring","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"type":"topic","abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"title":"Graph","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph"},"doc://ColoringModule/documentation/ColoringModule":{"type":"topic","abstract":[],"url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","title":"ColoringModule","kind":"symbol","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"type":"topic","abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"type":"codeVoice","code":"bipartition()"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"lexicographicallyFirstMinimumColoring()","role":"symbol","url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"}}}