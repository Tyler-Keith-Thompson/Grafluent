{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","interfaceLanguage":"swift"},"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"variants":[{"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"First fit in index order (the lexicographically first proper colouring of all) when it is"},{"type":"text","text":" "},{"type":"text","text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still"},{"type":"text","text":" "},{"type":"text","text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the last"},{"type":"text","text":" "},{"type":"text","text":"colouring found when one avoids the prefix, else DSatur branch and bound over the parts"},{"type":"text","text":" "},{"type":"text","text":"after the prefix that the vertex touches (on sparse components with conflict-directed"},{"type":"text","text":" "},{"type":"text","text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first"},{"type":"text","text":" "},{"type":"text","text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in"},{"type":"text","text":" "},{"type":"text","text":"polynomial time. It can be far slower than "},{"code":"minimumColoring()","type":"codeVoice"},{"type":"text","text":": on random sparse"},{"type":"text","text":" "},{"type":"text","text":"3-colourable graphs with 2n edges it took about 0.2 s at 1,000 vertices, 2.7 s at 2,000 and"},{"type":"text","text":" "},{"type":"text","text":"over 100 s at 5,000, where "},{"code":"minimumColoring()","type":"codeVoice"},{"type":"text","text":" takes about a millisecond. The search does not"},{"type":"text","text":" "},{"type":"text","text":"check for task cancellation."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"method","role":"symbol","title":"lexicographicallyFirstMinimumColoring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"extendedModule":"GraphProtocols","remoteSource":{"fileName":"ExactColoring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/ExactColoring.swift#L659"},"roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"ColoringModule"}],"externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"sections":[],"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"role":"symbol","abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order) is lexicographically least, Khuller and Vazirani’s"},{"type":"text","text":" "},{"type":"text","text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a"},{"type":"text","text":" "},{"type":"text","text":"component colours appear in order of first use, colour classes are numbered by their least"},{"type":"text","text":" "},{"type":"text","text":"vertex, a bipartite component is coloured by its "},{"type":"codeVoice","code":"bipartition()"},{"type":"text","text":" sides (left 0), and"},{"type":"text","text":" "},{"type":"codeVoice","code":"colorCount == chromaticNumber()"},{"type":"text","text":". Components are not coupled: a bipartite one keeps two"},{"type":"text","text":" "},{"type":"text","text":"colours beside a triangle."}],"title":"lexicographicallyFirstMinimumColoring()","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/coloringmodule\/graphprotocols\/graph","type":"topic","abstract":[],"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"role":"collection","title":"GraphProtocols","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","url":"\/documentation\/coloringmodule\/graphprotocols","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"role":"collection","title":"ColoringModule","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"url":"\/documentation\/coloringmodule\/coloring","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Coloring","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Coloring","kind":"identifier"}],"abstract":[{"type":"text","text":"A proper colouring of a graph’s vertices by the colours "},{"type":"codeVoice","code":"0..<colorCount"},{"type":"text","text":", each of which is"},{"type":"text","text":" "},{"type":"text","text":"used (unless preset colours skip some): the result of "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"greedyColoring(strategy:presetColor:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"greedyColoring(order:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"minimumColoring()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumColoring()"},{"type":"text","text":" (JGraphT "},{"type":"codeVoice","code":"VertexColoringAlgorithm.Coloring"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Graphs.jl "},{"type":"codeVoice","code":"Coloring"},{"type":"text","text":")."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","title":"Coloring"}}}