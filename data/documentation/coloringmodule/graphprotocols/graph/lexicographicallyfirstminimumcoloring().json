allyFirstMinimumColoring()"},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"navigatorTitle":[{"kind":"identifier","text":"Coloring"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","abstract":[{"text":"A proper colouring of a graph’s vertices by the colours ","type":"text"},{"code":"0..<colorCount","type":"codeVoice"},{"text":", each of which is","type":"text"},{"text":" ","type":"text"},{"text":"used (unless preset colours skip some): the result of ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"greedyColoring(strategy:presetColor:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"greedyColoring(order:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"minimumColoring()","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"type":"text","text":" (JGraphT "},{"code":"VertexColoringAlgorithm.Coloring","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Graphs.jl "},{"code":"Coloring","type":"codeVoice"},{"type":"text","text":")."}],"url":"\/documentation\/coloringmodule\/coloring","type":"topic","title":"Coloring","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}],"kind":"symbol"}}}