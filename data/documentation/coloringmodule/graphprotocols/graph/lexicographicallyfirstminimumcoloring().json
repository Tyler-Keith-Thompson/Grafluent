{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()"]}],"abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"First fit in index order (the lexicographically first proper colouring of all) when it is","type":"text"},{"text":" ","type":"text"},{"text":"already optimal. Otherwise each vertex in turn takes the least colour its prefix still","type":"text"},{"text":" ","type":"text"},{"text":"extends with (k-colouring’s self-reduction to its decision problem): a Kempe swap of the","type":"text"},{"text":" ","type":"text"},{"text":"last colouring found when one avoids the prefix, else DSatur branch and bound over the parts","type":"text"},{"text":" ","type":"text"},{"text":"after the prefix that the vertex touches (on sparse components with conflict-directed","type":"text"},{"text":" ","type":"text"},{"text":"backjumping and restarts). Khuller and Vazirani show the lexicographically first","type":"text"},{"text":" ","type":"text"},{"text":"four-colouring of a planar graph is NP-hard to find, though some four-colouring is found in","type":"text"},{"text":" ","type":"text"},{"text":"polynomial time. It can be far slower than ","type":"text"},{"type":"codeVoice","code":"minimumColoring()"},{"text":", and its time grows steeply","type":"text"},{"text":" ","type":"text"},{"text":"with n even on sparse 3-colourable graphs. The search does not check for task cancellation.","type":"text"}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Instance Method","role":"symbol","extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Coloring","kind":"typeIdentifier","preciseIdentifier":"s:14ColoringModule0A0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/ExactColoring.swift#L625","fileName":"ExactColoring.swift"},"modules":[{"relatedModules":["GraphProtocols"],"name":"ColoringModule"}],"externalID":"s:14GraphProtocols0A0P14ColoringModuleE029lexicographicallyFirstMinimumC0AD0C0VyxGyF","title":"lexicographicallyFirstMinimumColoring()"},"references":{"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"kind":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/coloringmodule\/graphprotocols","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"url":"\/documentation\/coloringmodule\/graphprotocols\/graph","role":"symbol","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","type":"topic","role":"collection","url":"\/documentation\/coloringmodule","title":"ColoringModule","abstract":[]},"doc://ColoringModule/documentation/ColoringModule/Coloring":{"url":"\/documentation\/coloringmodule\/coloring","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Coloring","kind":"identifier"}]