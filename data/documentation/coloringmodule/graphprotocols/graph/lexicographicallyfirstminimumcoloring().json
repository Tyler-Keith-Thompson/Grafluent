nless preset colours skip some): the result of ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"greedyColoring(strategy:presetColor:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"greedyColoring(order:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"minimumColoring()","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMinimumColoring()","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Coloring"}]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols":{"url":"\/documentation\/coloringmodule\/graphprotocols","type":"topic","kind":"symbol","title":"GraphProtocols","role":"collection","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","abstract":[]},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph/lexicographicallyFirstMinimumColoring()":{"url":"\/documentation\/coloringmodule\/graphprotocols\/graph\/lexicographicallyfirstminimumcoloring()","role":"symbol","kind":"symbol","abstract":[{"text":"The lexicographically first minimum colouring of the simple graph: on each connected","type":"text"},{"text":" ","type":"text"},{"text":"component, of all its colourings with its own chromatic number of colours, the one whose","type":"text"},{"text":" ","type":"text"},{"text":"colour vector (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order) is lexicographically least, Khuller and Vazirani’s","type":"text"},{"text":" ","type":"text"},{"text":"lexicographically first k-colouring (1991) with k = the component’s χ. So within a","type":"text"},{"text":" ","type":"text"},{"text":"component colours appear in order of first use, colour classes are numbered by their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex, a bipartite component is coloured by its ","type":"text"},{"code":"bipartition()","type":"codeVoice"},{"text":" sides (left 0), and","type":"text"},{"text":" ","type":"text"},{"code":"colorCount == chromaticNumber()","type":"codeVoice"},{"text":". Components are not coupled: a bipartite one keeps two","type":"text"},{"text":" ","type":"text"},{"text":"colours beside a triangle.","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumColoring()","title":"lexicographicallyFirstMinimumColoring()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumColoring"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Coloring","preciseIdentifier":"s:14ColoringModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]}}}