e":"text"},{"text":"edges at u, and a path at most n edges. O(n + m) memory. For a multigraph","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"digraph.undirectedView"},{"text":" with an antiparallel pair is one), use ","type":"text"},{"type":"codeVoice","code":"greedyEdgeColoring()"},{"text":".","type":"text"}],"metadata":{"modules":[{"name":"ColoringModule","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeColoring","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ColoringModule04EdgeA0V","text":"EdgeColoring","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"edgeColoring()","role":"symbol","externalID":"s:14GraphProtocols0A0P14ColoringModuleE04edgeC0AD04EdgeC0VyxGyF"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols","doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph"]]},"references":{"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","kind":"symbol","url":"\/documentation\/coloringmodule","abstract":[],"title":"ColoringModule","role":"collection","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/GraphProtocols/Graph":{"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/