he fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"independent_set"},{"type":"text","text":", whose ties follow set order instead. O(χ (n + m) log n) for χ classes."}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"abstract":[{"text":"The same in depth-first preorder. NetworkX ","type":"text"},{"type":"codeVoice","code":"connected_sequential_dfs"},{"text":". O(n + m).","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","title":"ColoringStrategy.connectedSequentialDepthFirst","kind":"symbol","role":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"abstract":[{"text":"How ","type":"text"},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"text":" orders the vertices. Each vertex in turn takes the least colour","type":"text"},{"text":" ","type":"text"},{"text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct","type":"text"},{"text":" ","type":"text"},{"text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".coloredNeighbors"},{"text":". NetworkX ","type":"text"},{"type":"codeVoice","code":"greedy_color(G, strategy)"},{"text"