"ColoringStrategy","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"title":"ColoringStrategy.smallestLast","role":"symbol","type":"topic","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast"},"doc://ColoringModule/s12CaseIterableP":{"title":"Swift.CaseIterable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","type":"unresolvable"},"doc://ColoringModule/SH":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH","title":"Swift.Hashable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"title":"ColoringStrategy.largestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"type":"topic","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. O(n + m)."}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","abstract":[{"type":"text","text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured"},{"type":"text","text":" "},{"type":"text","text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in"},{"type":"text","text":" "},{"type":"text","text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n)."}],"title":"ColoringStrategy.saturationLargestFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"saturationLargestFirst"}],"role":"symbol","kind":"symbol","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"title":"Equatable Implementations","role":"collectionGroup","type":"topic","abstract":[],"kind":"article","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"title":"ColoringStrategy.coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"type":"topic","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"title":"ColoringStrategy.connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}],"type":"topic","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order. O(n + m).","type":"text"}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","title":"ColoringStrategy.connectedSequentialDepthFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","abstract":[{"type":"text","text":"The same in depth-first preorder. O(n + m)."}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"title":"ColoringModule","url":"\/documentation\/coloringmodule","type":"topic","role":"collection","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"text":"O(χ (n + m) log n) for χ classes.","type":"text"}],"title":"ColoringStrategy.independentSet","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"role":"symbol","kind":"symbol","type":"topic"},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://ColoringModule/SQ":{"identifier":"doc:\/\/ColoringModule\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://ColoringModule/s16SendableMetatypeP":{"identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"}}}