e":"ColoringModule"}],"navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"roleHeading":"Enumeration"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","interfaceLanguage":"swift"},"abstract":[{"text":"How ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":" orders the vertices. Each vertex in turn takes the least colour","type":"text"},{"text":" ","type":"text"},{"text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct","type":"text"},{"text":" ","type":"text"},{"text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for","type":"text"},{"text":" ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"role":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","kind":"symbol","title":"ColoringStrategy.largestFirst","abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. O(n + m)."}]},"doc://ColoringModule/documentation/ColoringModule":{"type":"topic","abstract":[],"title":"ColoringModule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","role":"collection","kind":"symbol"},"doc://ColoringModule/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s8SendableP"},"doc://ColoringModule/s16SendableMetatypeP":{"identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"type":"topic","role":"symbol","title":"ColoringStrategy.coloredNeighbors","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","title":"Equatable Implementations","type":"topic","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","kind":"article","role":"collectionGroup"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"kind":"symbol","role":"symbol","type":"topic","title":"ColoringStrategy.connectedSequentialBreadthFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"type":"topic","navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"title":"ColoringStrategy","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","url":"\/documentation\/coloringmodule\/coloringstrategy","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"kind":"symbol","role":"symbol","type":"topic","title":"ColoringStrategy.independentSet","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"text":"O(χ (n + m) log n) for χ classes.","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"type":"topic","abstract":[{"type":"text","text":"The same in depth-first preorder. O(n + m)."}],"title":"ColoringStrategy.connectedSequentialDepthFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialDepthFirst"}],"role":"symbol","kind":"symbol"},"doc://ColoringModule/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH"},"doc://ColoringModule/SQ":{"identifier":"doc:\/\/ColoringModule\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://ColoringModule/s12CaseIterableP":{"title":"Swift.CaseIterable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"type":"topic","role":"symbol","abstract":[{"text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured","type":"text"},{"text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n).","type":"text"}],"title":"ColoringStrategy.saturationLargestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"saturationLargestFirst","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"type":"topic","role":"symbol","title":"ColoringStrategy.smallestLast","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}]}}}