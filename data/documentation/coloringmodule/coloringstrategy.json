l, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. NetworkX "},{"type":"codeVoice","code":"largest_first"},{"type":"text","text":" "},{"type":"text","text":"(the same colouring), JGraphT "},{"type":"codeVoice","code":"LargestDegreeFirstColoring"},{"type":"text","text":". O(n + m)."}]},"doc://ColoringModule/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"kind":"symbol","title":"ColoringStrategy.coloredNeighbors","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","role":"symbol","abstract":[{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS"},{"type":"text","text":" ("},{"type":"codeVoice","code":"vertex_coloring_greedy(method= \"colored_neighbors\")"},{"type":"text","text":"): first the vertex of greatest degree (the least index on ties), then"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s"},{"type":"text","text":" "},{"type":"text","text":"indexed binary heap breaks them (so not by index), which this follows step for step: the"},{"type":"text","text":" "},{"type":"text","text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)"},{"type":"text","text":" "},{"type":"text","text":"log n)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","kin