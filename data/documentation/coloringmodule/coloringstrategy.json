ier":"doc:\/\/ColoringModule\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://ColoringModule/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://ColoringModule/SH":{"identifier":"doc:\/\/ColoringModule\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"independent_set"},{"type":"text","text":", whose ties follow set order instead. O(χ (n + m) log n) for χ classes."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","title":"ColoringStrategy.independentSet","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","role":"symbol","title":"ColoringStrategy.connectedSequentialBreadthFirst","type":"topic","kind":"symbol","abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order. NetworkX ","type":"text"},{"type":"codeVoice","code":"connected_sequential_bfs"},{"text":", which starts each component","type":"text"},{"text":" ","type":"text"},{"text":"at an arbitrary vertex instead. O(n + m).","type":"text"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"abstract":[{"text":"The same in depth-first preorder. NetworkX ","type":"text"},{"code":"connected_sequential_dfs","type":"codeVoice"},{"text":". O(n + m).","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialDepthFirst"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","title":"ColoringStrategy.connectedSequentialDepthFirst","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","role":"symbol","title":"ColoringStrategy.largestFirst","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. NetworkX "},{"type":"codeVoice","code":"largest_first"},{"type":"text","text":" "},{"type":"text","text":"(the same colouring), JGraphT "},{"type":"codeVoice","code":"LargestDegreeFirstColoring"},{"type":"text","text":". O(n + m)."}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index","type":"text"},{"text":" ","type":"text"},{"text":"on ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours,","type":"text"},{"text":" ","type":"text"},{"text":"so at most 6 on a planar graph. NetworkX ","type":"text"},{"code":"smallest_last","type":"codeVoice"},{"text":", whose ties follow set order","type":"text"},{"text":" ","type":"text"},{"text":"instead. O((n + m) log n).","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","title":"ColoringStrategy.smallestLast","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast"}}}