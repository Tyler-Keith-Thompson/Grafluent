"},{"type":"text","text":" "},{"type":"text","text":"(the same colouring), JGraphT "},{"type":"codeVoice","code":"LargestDegreeFirstColoring"},{"type":"text","text":". O(n + m)."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","kind":"symbol","title":"ColoringStrategy.largestFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","role":"symbol","type":"topic"},"doc://ColoringModule/s16SendableMetatypeP":{"identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","type":"topic","kind":"article","role":"collectionGroup","title":"Equatable Implementations"},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"}}}