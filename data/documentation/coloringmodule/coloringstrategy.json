{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/coloringstrategy"]}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"symbolKind":"enum","remoteSource":{"fileName":"Coloring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L109"},"title":"ColoringStrategy","modules":[{"name":"ColoringModule"}],"roleHeading":"Enumeration","externalID":"s:14ColoringModule0A8StrategyO","navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"role":"symbol"},"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/ColoringModule\/s12CaseIterableP","doc:\/\/ColoringModule\/SQ","doc:\/\/ColoringModule\/SH","doc:\/\/ColoringModule\/s8SendableP","doc:\/\/ColoringModule\/s16SendableMetatypeP"],"kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"sections":[],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","interfaceLanguage":"swift"},"topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"]}],"references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialDepthFirst"}],"abstract":[{"text":"The same in depth-first preorder. O(n + m).","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","kind":"symbol","title":"ColoringStrategy.connectedSequentialDepthFirst"},"doc://ColoringModule/SH":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH","title":"Swift.Hashable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","kind":"article","title":"Equatable Implementations","role":"collectionGroup","abstract":[]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"saturationLargestFirst"}],"abstract":[{"type":"text","text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured"},{"type":"text","text":" "},{"type":"text","text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in"},{"type":"text","text":" "},{"type":"text","text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n)."}],"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","kind":"symbol","title":"ColoringStrategy.saturationLargestFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","kind":"symbol","title":"ColoringStrategy.smallestLast","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}],"abstract":[{"type":"text","text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so"},{"type":"text","text":" "},{"type":"text","text":"at most 6 on a planar graph. O((n + m) log n)."}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","kind":"symbol","title":"ColoringStrategy.connectedSequentialBreadthFirst","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}],"abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order. O(n + m).","type":"text"}]},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","title":"Swift.CaseIterable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP"},"doc://ColoringModule/SQ":{"identifier":"doc:\/\/ColoringModule\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. O(n + m).","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","kind":"symbol","title":"ColoringStrategy.largestFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"title":"ColoringStrategy","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"abstract":[{"type":"text","text":"How "},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy"},"doc://ColoringModule/documentation/ColoringModule":{"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","kind":"symbol","title":"ColoringModule","role":"collection","abstract":[]},"doc://ColoringModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP"},"doc://ColoringModule/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s8SendableP"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","kind":"symbol","title":"ColoringStrategy.independentSet","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"abstract":[{"text":"First the vertex of greatest degree (the least index on ties), then repeatedly the","type":"text"},{"text":" ","type":"text"},{"text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and","type":"text"},{"text":" ","type":"text"},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","kind":"symbol","title":"ColoringStrategy.coloredNeighbors"}}}