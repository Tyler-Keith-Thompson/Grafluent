e":"codeVoice","code":"vertex_coloring_greedy"},{"text":".","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","title":"ColoringStrategy.largestFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}],"abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. NetworkX ","type":"text"},{"type":"codeVoice","code":"largest_first"},{"text":" ","type":"text"},{"text":"(the same colouring), JGraphT ","type":"text"},{"type":"codeVoice","code":"LargestDegreeFirstColoring"},{"text":". O(n + m).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","title":"ColoringStrategy.coloredNeighbors","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"abstract":[{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS"},{"type":"text","text":" ("},{"type":"codeVoice","code":"vertex_coloring_greedy(method= \"colored_neighbors\")"},{"type":"text","text":"): first the vertex of greatest degree (the least index on ties), then"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s"},{"type":"text","text":" "},{"type":"text","text":"indexed binary heap breaks them (so not by index), which this follows step for step: the"},{"type":"text","text":" "},{"type":"text","text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)"},{"type":"text","text":" "},{"type":"text","text":"log n)."}]},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","title":"Swift.CaseIterable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"role":"collectionGroup","type":"topic","kind":"article","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","title":"Equatable Implementations"},"doc://ColoringModule/documentation/ColoringModule":{"role":"collection","type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","title":"ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"saturationLargestFirst"}],"title":"ColoringStrategy.saturationLargestFirst","abstract":[{"text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured","type":"text"},{"text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. NetworkX ","type":"text"},{"type":"codeVoice","code":"saturation_largest_first"},{"text":" (","type":"text"},{"code":"DSATUR","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"the same colouring. Exact on bipartite graphs. O((n + m) log n).","type":"text"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","kind":"symbol","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","title":"ColoringStrategy.smallestLast","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}],"abstract":[{"type":"text","text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index"},{"type":"text","text":" "},{"type":"text","text":"on ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours,"},{"type":"text","text":" "},{"type":"text","text":"so at most 6 on a planar graph. NetworkX "},{"code":"smallest_last","type":"codeVoice"},{"type":"text","text":", whose ties follow set order"},{"type":"text","text":" "},{"type":"text","text":"instead. O((n + m) log n)."}]}}}