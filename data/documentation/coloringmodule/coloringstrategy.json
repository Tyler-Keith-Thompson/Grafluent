Module/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","kind":"symbol","type":"topic","title":"ColoringStrategy.coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}],"title":"ColoringStrategy.smallestLast","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast"},"doc://ColoringM