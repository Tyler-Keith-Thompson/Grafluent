,"text":"smallestLast"}],"title":"ColoringStrategy.smallestLast","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index","type":"text"},{"text":" ","type":"text"},{"text":"on ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours,","type":"text"},{"text":" ","type":"text"},{"text":"so at most 6 on a planar graph. NetworkX ","type":"text"},{"code":"smallest_last","type":"codeVoice"},{"text":", whose ties follow set order","type":"text"},{"text":" ","type":"text"},{"text":"instead. O((n + m) log n).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"title":"ColoringStrategy.largestFirst","abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. NetworkX "},{"type":"codeVoice","code":"largest_first"},{"type":"text","text":" "},{"type":"text","text":"(the same colouring), JGraphT "},{"type":"codeVoice","code":"LargestDegreeFirstColoring"},{"type":"text","text":". O(n + m)."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"title":"Equatable Implementations","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","kind":