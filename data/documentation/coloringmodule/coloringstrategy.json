rst order from its least vertex, neighbours"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" order. NetworkX "},{"code":"connected_sequential_bfs","type":"codeVoice"},{"type":"text","text":", which starts each component"},{"type":"text","text":" "},{"type":"text","text":"at an arbitrary vertex instead. O(n + m)."}]},"doc://ColoringModule/SH":{"identifier":"doc:\/\/ColoringModule\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"role":"symbol","title":"ColoringStrategy.connectedSequentialDepthFirst","abstract":[{"text":"The same in depth-first preorder. NetworkX ","type":"text"},{"code":"connected_sequential_dfs","type":"codeVoice"},{"text":". O(n + m).","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialDepthFirst"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","type":"topic","kind":"symbol"},"doc://ColoringModule/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/ColoringModule\/SQ"},"doc://ColoringModule/documentation/ColoringModule":{"role":"collection","title":"ColoringModule","abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"role":"collectionGroup","abstract":[],"title":"Equatable Implementations","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","type":"topic","kind":"article"},"doc://ColoringModule/s12CaseIterableP":{"identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","type":"unresolvable","title":"Swift.CaseIterable"},"doc://ColoringModule/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/ColoringModule\/s8SendableP"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"abstract":[{"text":"How ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":" orders the vertices. Each vertex in turn takes the least colour","type":"text"},{"text":" ","type":"text"},{"text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct","type":"text"},{"text":" ","type":"text"},{"text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for","type":"text"},{"text":" ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":". NetworkX ","type":"text"},{"code":"greedy_color(G, strategy)","type":"codeVoice"},{"text":", rustworkx ","type":"text"},{"code":"ColoringStrategy","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"igraph ","type":"text"},{"code":"vertex_coloring_greedy","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","title":"ColoringStrategy"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"kind":"symbol","title":"ColoringStrategy.saturationLargestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saturationLargestFirst","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured"},{"type":"text","text":" "},{"type":"text","text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in"},{"type":"text","text":" "},{"type":"text","text":"the whole graph, then to the lesser index. NetworkX "},{"type":"codeVoice","code":"saturation_largest_first"},{"type":"text","text":" ("},{"code":"DSATUR","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"the same colouring. Exact on bipartite graphs. O((n + m) log n)."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"type":"topic","role":"symbol","title":"ColoringStrategy.coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","abstract":[{"text":"igraph’s ","type":"text"},{"code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS","type":"codeVoice"},{"text":" (","type":"text"},{"code":"vertex_coloring_greedy(method= \"colored_neighbors\")","type":"codeVoice"},{"text":"): first the vertex of greatest degree (the least index on ties), then","type":"text"},{"text":" ","type":"text"},{"text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary heap breaks them (so not by index), which this follows step for step: the","type":"text"},{"text":" ","type":"text"},{"text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)","type":"text"},{"text":" ","type":"text"},{"text":"log n).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"kind":"symbol","title":"ColoringStrategy.largestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. NetworkX "},{"code":"largest_first","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(the same colouring), JGraphT "},{"code":"LargestDegreeFirstColoring","type":"codeVoice"},{"text":". O(n + m).","type":"text"}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst"},"doc://ColoringModule/s16SendableMetatypeP":{"identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"type":"topic","role":"symbol","title":"ColoringStrategy.smallestLast","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}],"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","abstract":[{"type":"text","text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index"},{"type":"text","text":" "},{"type":"text","text":"on ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours,"},{"type":"text","text":" "},{"type":"text","text":"so at most 6 on a planar graph. NetworkX "},{"type":"codeVoice","code":"smallest_last"},{"text":", whose ties follow set order","type":"text"},{"text":" ","type":"text"},{"text":"instead. O((n + m) log n).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"independent_set"},{"type":"text","text":", whose ties follow set order instead. O(χ (n + m) log n) for χ classes."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","title":"ColoringStrategy.independentSet"}}}