 neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. NetworkX ","type":"text"},{"code":"saturation_largest_first","type":"codeVoice"},{"text":" (","type":"text"},{"code":"DSATUR","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"the same colouring. Exact on bipartite graphs. O((n + m) log n).","type":"text"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst"},"doc://ColoringModule/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/ColoringModule\/s8SendableP","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"abstract":[{"text":"igraph’s ","type":"text"},{"code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS","type":"codeVoice"},{"text":" (","type":"text"},{"code":"vertex_coloring_greedy(method= \"colored_neighbors\")","type":"codeVoice"},{"text":"): first the vertex of greatest degree (the least index on ties), then","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s"},{"type":"text","text":" "},{"type":"text","text":"indexed binary heap breaks them (so not by index), which this follows step for step: the"},{"type":"text","text":" "},{"type":"text","text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)"},{"type":"text","text":" "},{"type":"text","text":"log n)."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","title":"ColoringStrategy.coloredNeighbors","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrat