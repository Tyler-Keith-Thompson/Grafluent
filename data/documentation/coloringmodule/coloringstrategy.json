{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"},"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"symbolKind":"enum","externalID":"s:14ColoringModule0A8StrategyO","navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L109","fileName":"Coloring.swift"},"role":"symbol","roleHeading":"Enumeration","title":"ColoringStrategy","modules":[{"name":"ColoringModule"}]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/ColoringModule\/s12CaseIterableP","doc:\/\/ColoringModule\/SQ","doc:\/\/ColoringModule\/SH","doc:\/\/ColoringModule\/s8SendableP","doc:\/\/ColoringModule\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/coloringstrategy"]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Default Implementations","identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","role":"symbol","abstract":[{"text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured","type":"text"},{"text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n).","type":"text"}],"type":"topic","kind":"symbol","title":"ColoringStrategy.saturationLargestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saturationLargestFirst","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst"},"doc://ColoringModule/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"role":"symbol","title":"ColoringStrategy.largestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}],"abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. O(n + m)."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","kind":"symbol","type":"topic"},"doc://ColoringModule/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s8SendableP","title":"Swift.Sendable"},"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","type":"topic","kind":"symbol","role":"collection","abstract":[],"title":"ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}],"type":"topic","kind":"symbol","abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"title":"ColoringStrategy.connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"title":"Equatable Implementations","kind":"article","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","abstract":[],"role":"collectionGroup"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialDepthFirst"}],"type":"topic","kind":"symbol","abstract":[{"text":"The same in depth-first preorder. O(n + m).","type":"text"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","title":"ColoringStrategy.connectedSequentialDepthFirst","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","type":"topic","kind":"symbol","role":"symbol","title":"ColoringStrategy.independentSet","abstract":[{"text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet","type":"text"},{"text":" ","type":"text"},{"text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still","type":"text"},{"text":" ","type":"text"},{"text":"available (the least index on ties) and making it and its neighbours unavailable.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}]},"doc://ColoringModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP"},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","role":"symbol","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}],"type":"topic","kind":"symbol","title":"ColoringStrategy.coloredNeighbors","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"How "},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":"."}],"title":"ColoringStrategy","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"url":"\/documentation\/coloringmodule\/coloringstrategy"},"doc://ColoringModule/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SQ"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","type":"topic","kind":"symbol","role":"symbol","title":"ColoringStrategy.smallestLast","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}]}}}