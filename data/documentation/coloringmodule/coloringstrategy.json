:"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","abstract":[{"type":"text","text":"igraph’s "},{"code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS","type":"codeVoice"},{"type":"text","text":" ("},{"code":"vertex_coloring_greedy(method= \"colored_neighbors\")","type":"codeVoice"},{"type":"text","text":"): first the vertex of greatest degree (the least index on ties), then"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s"},{"type":"text","text":" "},{"type":"text","text":"indexed binary heap breaks them (so not by index), which this follows step for step: the"},{"type":"text","text":" "},{"type":"text","text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)"},{"type":"text","text":" "},{"type":"text","text":"log n)."}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"},"doc://ColoringModule/documentation/ColoringModule":{"kind":"symbol","url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","role":"collection","abstract":[],"title":"ColoringModule","type":"topic"}}}