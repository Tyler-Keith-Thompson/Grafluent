{"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"metadata":{"navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"role":"symbol","externalID":"s:14ColoringModule0A8StrategyO","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L109","fileName":"Coloring.swift"},"symbolKind":"enum","roleHeading":"Enumeration","modules":[{"name":"ColoringModule"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"title":"ColoringStrategy"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]}],"variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast"],"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases"},{"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/ColoringModule\/s12CaseIterableP","doc:\/\/ColoringModule\/SQ","doc:\/\/ColoringModule\/SH","doc:\/\/ColoringModule\/s8SendableP","doc:\/\/ColoringModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","interfaceLanguage":"swift"},"sections":[],"references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","type":"topic","kind":"symbol","title":"ColoringStrategy.connectedSequentialDepthFirst","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","abstract":[{"text":"The same in depth-first preorder. O(n + m).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","role":"symbol","kind":"symbol","abstract":[{"text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured","type":"text"},{"text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n).","type":"text"}],"title":"ColoringStrategy.saturationLargestFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"saturationLargestFirst"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"url":"\/documentation\/coloringmodule\/coloringstrategy","type":"topic","kind":"symbol","title":"ColoringStrategy","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","type":"topic","kind":"symbol","title":"ColoringStrategy.coloredNeighbors","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}]},"doc://ColoringModule/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH"},"doc://ColoringModule/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/ColoringModule\/SQ"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","type":"topic","kind":"symbol","title":"ColoringStrategy.largestFirst","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. O(n + m).","type":"text"}]},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","role":"collectionGroup","kind":"article","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","abstract":[],"type":"topic","title":"Equatable Implementations"},"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/coloringmodule","type":"topic","title":"ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","role":"symbol","kind":"symbol","abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","title":"ColoringStrategy.connectedSequentialBreadthFirst","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","role":"symbol","kind":"symbol","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}],"title":"ColoringStrategy.smallestLast","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}]},"doc://ColoringModule/s12CaseIterableP":{"identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","type":"topic","kind":"symbol","title":"ColoringStrategy.independentSet","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","abstract":[{"text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet","type":"text"},{"text":" ","type":"text"},{"text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still","type":"text"},{"text":" ","type":"text"},{"text":"available (the least index on ties) and making it and its neighbours unavailable.","type":"text"},{"text":" ","type":"text"},{"text":"O(χ (n + m) log n) for χ classes.","type":"text"}]},"doc://ColoringModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","type":"unresolvable"}}}