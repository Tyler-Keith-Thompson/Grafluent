{"sections":[],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"relationshipsSections":[{"identifiers":["doc:\/\/ColoringModule\/s12CaseIterableP","doc:\/\/ColoringModule\/SQ","doc:\/\/ColoringModule\/SH","doc:\/\/ColoringModule\/s8SendableP","doc:\/\/ColoringModule\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}]}],"kind":"declarations"}],"topicSections":[{"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","doc:\/\/ColoringModule\/documentation\/Col