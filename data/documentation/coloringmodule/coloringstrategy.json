ts each component"},{"type":"text","text":" "},{"type":"text","text":"at an arbitrary vertex instead. O(n + m)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}],"abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index","type":"text"},{"text":" ","type":"text"},{"text":"on ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours,","type":"text"},{"text":" ","type":"text"},{"text":"so at most 6 on a planar graph. NetworkX ","type":"text"},{"type":"codeVoice","code":"smallest_last"},{"text":", whose ties follow set order","type":"text"},{"text":" ","type":"text"},{"text":"instead. O((n + m) log n).","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","type":"topic","title":"ColoringStrategy.smallestLast","kind":"symbol","role":"symbol"},"doc://ColoringModule/s16SendableMetatypeP":{"identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"title":"ColoringStrategy.coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","type":"topic","abstract":[{"text":"igraph’s ","type":"text"},{"code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS","type":"codeVoice"},{"text":" (","type":"text"},{"code":"vertex_coloring_greedy(method= \"colored_neighbors\")","type":"codeVoice"},{"text":"): first the vertex of greatest degree (the least index on ties), then","type":"text"},{"text":" ","type":"text"},{"text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary heap breaks them (so not by index), which this follows step for step: the","type":"text"},{"text":" ","type":"text"},{"text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)","type":"text"},{"text":" ","type":"text"},{"text":"log n).","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors"},"doc://ColoringModule/s12CaseIterableP":{"title":"Swift.CaseIterable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","type":"unresolvable"},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://ColoringModule/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/ColoringModule\/SH","type":"unresolvable"}}}