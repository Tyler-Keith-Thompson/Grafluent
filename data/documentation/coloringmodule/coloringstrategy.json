raph’s "},{"type":"codeVoice","code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS"},{"type":"text","text":" ("},{"type":"codeVoice","code":"vertex_coloring_greedy(method= \"colored_neighbors\")"},{"type":"text","text":"): first the vertex of greatest degree (the least index on ties), then"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s"},{"type":"text","text":" "},{"type":"text","text":"indexed binary heap breaks them (so not by index), which this follows step for step: the"},{"type":"text","text":" "},{"type":"text","text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)"},{"type":"text","text":" "},{"type":"text","text":"log n)."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"title":"ColoringStrategy.coloredNeighbors","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","role":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"role":"symbol","navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy","title":"ColoringStrategy","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "