ice"},{"type":"text","text":". O(n + m)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","kind":"symbol","title":"ColoringStrategy.connectedSequentialBreadthFirst","role":"symbol","abstract":[{"type":"text","text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order. NetworkX "},{"type":"codeVoice","code":"connected_sequential_bfs"},{"type":"text","text":", which starts each component"},{"type":"text","text":" "},{"type":"text","text":"at an arbitrary vertex instead. O(n + m)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"type":"topic"},"doc://ColoringModule/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s8SendableP"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"type":"topic","title":"ColoringStrategy.coloredNeighbors","role":"symbol","kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","abstract":[{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS"},{"type":"text","text":" ("},{"type":"codeVoice","code":"vertex_coloring_greedy(method= \"colored_neighbors\")"},{"type":"text","text":"): first the vertex of greatest degree (the least index on ties), then"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s"},{"type":"text","text":" "},{"type":"text","text":"indexed binary heap breaks them (so not by index), which this follows step for step: the"},{"type":"text","text":" "},{"type":"text","text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)"},{"type":"text","text":" "},{"type":"text","text":"log n)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors"},"doc://ColoringModule/SH":{"identifier":"doc:\/\/ColoringModule\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","kind":"symbol","title":"ColoringStrategy.saturationLargestFirst","role":"symbol","abstract":[{"text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured","type":"text"},{"text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. NetworkX ","type":"text"},{"code":"saturation_largest_first","type":"codeVoice"},{"text":" (","type":"text"},{"code":"DSATUR","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"the same colouring. Exact on bipartite graphs. O((n + m) log n).","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saturationLargestFirst","kind":"identifier"}],"type":"topic"},"doc://Colorin