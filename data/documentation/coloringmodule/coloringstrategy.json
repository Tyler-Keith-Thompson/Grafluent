gModule\/ColoringStrategy\/connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","title":"ColoringStrategy.connectedSequentialBreadthFirst"},"doc://ColoringModule/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/ColoringModule\/SQ","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"title":"ColoringStrategy.independentSet","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","abstract":[{"text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet","type":"text"},{"text":" ","type":"text"},{"text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still","type":"text"},{"text":" ","type":"text"},{"text":"available (the least index on ties) and making it and its neighbours unavailable. NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"independent_set","type":"codeVoice"},{"text":", whose ties follow set order instead. O(χ (n + m) log n) for χ classes.","type":"text"}]},"doc://ColoringModule/s12CaseIterableP":{"identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],