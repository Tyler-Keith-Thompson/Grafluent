oc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}],"abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order. O(n + m).","type":"text"}],"title":"ColoringStrategy.connectedSequentialBreadthFirst","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}],"title":"ColoringStrategy.independentSet","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"text":" ","type":"text"},{"text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".coloredNeighbors"},{"text":".","type":"text"}],"title":"ColoringStrategy","url":"\/documentation\/coloringmodule\/coloringstrategy","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"type":"topic","role":"collectionGroup","abstract":[],"kind":"article","title":"Equatable Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"abstract":[{"text":"The same in depth-first preorder. O(n + m).","type":"text"}],"type":"topic","title":"ColoringStrategy.connectedSequentialDepthFirst","kind":"symbol","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst"},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}],"type":"topic","title":"ColoringStrategy.coloredNeighbors","kind":"symbol","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"},"doc://ColoringModule/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s8SendableP"}}}