already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"url":"\/documentation\/coloringmodule\/coloringstrategy","title":"ColoringStrategy","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}]},"doc://ColoringModule/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/ColoringModule\/SQ","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","role":"symbol","title":"ColoringStrategy.largestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. O(n + m).","type":"text"}]}}}