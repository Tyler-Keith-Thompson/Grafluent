"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L109","fileName":"Coloring.swift"}},"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/coloringstrategy"]}],"kind":"symbol","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","role":"symbol","title":"ColoringStrategy.largestFirst","abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. O(n + m).","type":"text"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","type":"topic","role":"collection","url":"\/documentation\/coloringmodule","title":"ColoringModule","abstract":[]},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","title":"Swift.CaseIterable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP"},"doc://ColoringModule/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"kind":"symbol","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","title":"ColoringStrategy.connectedSequentialDepthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","abstract":[{"type":"text","text":"The same in depth-first preorder. O(n + m)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","title":"ColoringStrategy.smallestLast","abstract":[{"type":"text","text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so"},{"type":"text","text":" "},{"type":"text","text":"at most 6 on a planar graph. O((n + m) log n)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://ColoringModule/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"title":"ColoringStrategy","abstract":[{"text":"How ","type":"text"},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"text":" orders the vertices. Each vertex in turn takes the least colour","type":"text"},{"text":" ","type":"text"},{"text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct","type":"text"},{"text":" ","type":"text"},{"text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".coloredNeighbors"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy","kind":"symbol","type":"topic"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","title":"ColoringStrategy.connectedSequentialBreadthFirst","abstract":[{"type":"text","text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in"},{"type":"text","text":" "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" order. O(n + m)."}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","kind":"symbol","type":"topic"},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"kind":"symbol","type":"topic","abstract":[{"text":"First the vertex of greatest degree (the least index on ties), then repeatedly the","type":"text"},{"text":" ","type":"text"},{"text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and","type":"text"},{"text":" ","type":"text"},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}],"title":"ColoringStrategy.coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","role":"collectionGroup","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","abstract":[],"title":"Equatable Implementations","type":"topic","kind":"article"},"doc://ColoringModule/SQ":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SQ","title":"Swift.Equatable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","title":"ColoringStrategy.independentSet","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","role":"symbol","title":"ColoringStrategy.saturationLargestFirst","abstract":[{"type":"text","text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured"},{"type":"text","text":" "},{"type":"text","text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in"},{"type":"text","text":" "},{"type":"text","text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n)."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saturationLargestFirst","kind":"identifier"}],"type":"topic","kind":"symbol"}}}