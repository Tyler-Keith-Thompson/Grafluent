ion\/coloringmodule\/coloringstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":". NetworkX "},{"type":"codeVoice","code":"greedy_color(G, strategy)"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"ColoringStrategy"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"type":"codeVoice","code":"vertex_coloring_greedy"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"languages":["swift"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"},"kind":"symbol","references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured"},{"type":"text","text":" "},{"type":"text","text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in"},{"type":"text","text":" "},{"type":"text","text":"the whole graph, then to the lesser index. NetworkX "},{"code":"saturation_largest_first","type":"codeVoice"},{"text":" (","type":"text"},{"code":"DSATUR","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"the same colouring. Exact on bipartite graphs. O((n + m) log n).","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saturationLargestFirst","kind":"identifier"}],"title":"ColoringStrategy.saturationLargestFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule":{"type":"topic","kind":"symbol","abstract":[],"title":"ColoringModule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","url":"\/documentation\/coloringmodule","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"type":"topic","abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. NetworkX "},{"type":"codeVoice","code":"largest_first"},{"type":"text","text":" "},{"type":"text","text":"(the same colouring), JGraphT "},{"type":"codeVoice","code":"LargestDegreeFirstColoring"},{"type":"text","text":". O(n + m)."}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","role":"symbol","title":"ColoringStrategy.largestFirst","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"role":"symbol","title":"ColoringStrategy.connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order. NetworkX ","type":"text"},{"type":"codeVoice","code":"connected_sequential_bfs"},{"type":"text","text":", which starts each component"},{"type":"text","text":" "},{"type":"text","text":"at an arbitrary vertex instead. O(n + m)."}],"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"type":"topic","abstract":[],"kind":"article","title":"Equatable Implementations","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","role":"collectionGroup"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"role":"symbol","title":"ColoringStrategy.connectedSequentialDepthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","abstract":[{"type":"text","text":"The same in depth-first preorder. NetworkX "},{"type":"codeVoice","code":"connected_sequential_dfs"},{"type":"text","text":". O(n + m)."}],"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialDepthFirst"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","kind":"symbol"},"doc://ColoringModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"type":"topic","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"independent_set"},{"type":"text","text":", whose ties follow set order instead. O(χ (n + m) log n) for χ classes."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","title":"ColoringStrategy.independentSet","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","role":"symbol"},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable"},"doc://ColoringModule/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/ColoringModule\/SH","type":"unresolvable"},"doc://ColoringModule/SQ":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SQ","title":"Swift.Equatable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"type":"topic","abstract":[{"type":"text","text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index"},{"type":"text","text":" "},{"type":"text","text":"on ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours,"},{"type":"text","text":" "},{"type":"text","text":"so at most 6 on a planar graph. NetworkX "},{"type":"codeVoice","code":"smallest_last"},{"type":"text","text":", whose ties follow set order"},{"type":"text","text":" "},{"type":"text","text":"instead. O((n + m) log n)."}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","role":"symbol","title":"ColoringStrategy.smallestLast","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}]},"doc://ColoringModule/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/ColoringModule\/s8SendableP","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"type":"topic","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":". NetworkX "},{"type":"codeVoice","code":"greedy_color(G, strategy)"},{"type":"text","text":", rustworkx "},{"type":"codeVoice","code":"ColoringStrategy"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"type":"codeVoice","code":"vertex_coloring_greedy"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy","role":"symbol","title":"ColoringStrategy","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"type":"topic","abstract":[{"type":"text","text":"igraph’s "},{"type":"codeVoice","code":"IGRAPH_COLORING_GREEDY_COLORED_NEIGHBORS"},{"type":"text","text":" ("},{"type":"codeVoice","code":"vertex_coloring_greedy(method= \"colored_neighbors\")"},{"type":"text","text":"): first the vertex of greatest degree (the least index on ties), then"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the uncoloured vertex with the most coloured neighbours, ties as igraph’s"},{"type":"text","text":" "},{"type":"text","text":"indexed binary heap breaks them (so not by index), which this follows step for step: the"},{"type":"text","text":" "},{"type":"text","text":"same colouring as igraph on simple graphs (igraph counts each parallel edge). O((n + m)"},{"type":"text","text":" "},{"type":"text","text":"log n)."}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","role":"symbol","title":"ColoringStrategy.coloredNeighbors","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}]}}}