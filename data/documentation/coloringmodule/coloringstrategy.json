{"sections":[],"abstract":[{"type":"text","text":"How "},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":"."}],"relationshipsSections":[{"identifiers":["doc:\/\/ColoringModule\/s12CaseIterableP","doc:\/\/ColoringModule\/SQ","doc:\/\/ColoringModule\/SH","doc:\/\/ColoringModule\/s8SendableP","doc:\/\/ColoringModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"platforms":["Linux"]}],"kind":"declarations"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"},"topicSections":[{"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"]}],"variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"metadata":{"externalID":"s:14ColoringModule0A8StrategyO","role":"symbol","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"roleHeading":"Enumeration","modules":[{"name":"ColoringModule"}],"title":"ColoringStrategy","remoteSource":{"fileName":"Coloring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L109"},"navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://ColoringModule/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SQ"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialDepthFirst"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","abstract":[{"text":"The same in depth-first preorder. O(n + m).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","title":"ColoringStrategy.connectedSequentialDepthFirst","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy","title":"ColoringStrategy","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so"},{"type":"text","text":" "},{"type":"text","text":"at most 6 on a planar graph. O((n + m) log n)."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"smallestLast","kind":"identifier"}],"title":"ColoringStrategy.smallestLast","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast"},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://ColoringModule/SH":{"identifier":"doc:\/\/ColoringModule\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"title":"ColoringStrategy.saturationLargestFirst","abstract":[{"type":"text","text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured"},{"type":"text","text":" "},{"type":"text","text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in"},{"type":"text","text":" "},{"type":"text","text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n)."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"saturationLargestFirst"}],"type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"title":"ColoringStrategy.independentSet","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset"},"doc://ColoringModule/s16SendableMetatypeP":{"identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule","title":"ColoringModule","role":"collection"},"doc://ColoringModule/s12CaseIterableP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order. O(n + m)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"title":"ColoringStrategy.connectedSequentialBreadthFirst","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"role":"collectionGroup","abstract":[],"type":"topic","title":"Equatable Implementations","kind":"article","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"largestFirst"}],"abstract":[{"type":"text","text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by"},{"type":"text","text":" "},{"type":"text","text":"class in this order and gives the same colouring as first fit. O(n + m)."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","title":"ColoringStrategy.largestFirst","role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"title":"ColoringStrategy.coloredNeighbors","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"}}}