le degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":". NetworkX "},{"code":"greedy_color(G, strategy)","type":"codeVoice"},{"type":"text","text":", rustworkx "},{"code":"ColoringStrategy","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"igraph "},{"code":"vertex_coloring_greedy","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","title":"ColoringStrategy","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"role":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"role":"symbol","type":"topic","title":"ColoringStrategy.independentSet","kind":"symbol","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"independent_set"},{"text":", whose ties follow set order instead. O(χ (n + m) log n) for χ classes.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"role":"symbol","abstract":[{"type":"text","text":"igraph’s "},{"code":"IGRA