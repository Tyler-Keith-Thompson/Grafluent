rue,"title":"Enumeration Cases"},{"identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"abstract":[{"text":"How ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":" orders the vertices. Each vertex in turn takes the least colour","type":"text"},{"text":" ","type":"text"},{"text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct","type":"text"},{"text":" ","type":"text"},{"text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for","type":"text"},{"text":" ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"title":"ColoringStrategy.independentSet","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"role":"symbol","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","title":"ColoringStrategy.saturationLargestFirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"saturationLargestFirst"}],"abstract":[{"text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured","type":"text"},{"text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n).","type":"text"}]},"doc://ColoringModule/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH"},"doc://ColoringModule/documentation/ColoringModule":{"url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","role":"collection","type":"topic","abstract":[],"title":"ColoringModule","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}],"title":"ColoringStrategy.smallestLast","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","abstract":[{"type":"text","text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so"},{"type":"text","text":" "},{"type":"text","text":"at most 6 on a planar graph. O((n + m) log n)."}],"kind":"symbol"},"doc://ColoringModule/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s8SendableP","title":"Swift.Sendable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"role":"collectionGroup","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","title":"Equatable Implementations","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","kind":"article","type":"topic","abstract":[]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","kind":"symbol","title":"ColoringStrategy.connectedSequentialBreadthFirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}],"abstract":[{"type":"text","text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in"},{"type":"text","text":" "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" order. O(n + m)."}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"title":"ColoringStrategy.connectedSequentialDepthFirst","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","abstract":[{"type":"text","text":"The same in depth-first preorder. O(n + m)."}],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","title":"ColoringStrategy.largestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","kind":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}],"abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. O(n + m).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"title":"ColoringStrategy.coloredNeighbors","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"kind":"symbol"},"doc://ColoringModul