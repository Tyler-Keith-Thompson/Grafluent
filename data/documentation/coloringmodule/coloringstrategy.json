{"abstract":[{"text":"How ","type":"text"},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"text":" orders the vertices. Each vertex in turn takes the least colour","type":"text"},{"text":" ","type":"text"},{"text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct","type":"text"},{"text":" ","type":"text"},{"text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for","type":"text"},{"text":" ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Default Implementations","identifiers":["doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"metadata":{"role":"symbol","externalID":"s:14ColoringModule0A8StrategyO","modules":[{"name":"ColoringModule"}],"navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L109","fileName":"Coloring.swift"},"title":"ColoringStrategy","roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"symbolKind":"enum"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/ColoringModule\/s12CaseIterableP","doc:\/\/ColoringModule\/SQ","doc:\/\/ColoringModule\/SH","doc:\/\/ColoringModule\/s8SendableP","doc:\/\/ColoringModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule"]]},"references":{"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","abstract":[{"type":"text","text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order. O(n + m)."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"title":"ColoringStrategy.connectedSequentialBreadthFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst"},"doc://ColoringModule/documentation/ColoringModule":{"role":"collection","type":"topic","url":"\/documentation\/coloringmodule","abstract":[],"kind":"symbol","title":"ColoringModule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule"},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://ColoringModule/s12CaseIterableP":{"title":"Swift.CaseIterable","identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","type":"unresolvable"},"doc://ColoringModule/SH":{"identifier":"doc:\/\/ColoringModule\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://ColoringModule/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/ColoringModule\/SQ","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","type":"topic","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}],"title":"ColoringStrategy.smallestLast"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"role":"symbol","navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"title":"ColoringStrategy","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","kind":"symbol","abstract":[{"text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet","type":"text"},{"text":" ","type":"text"},{"text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still","type":"text"},{"text":" ","type":"text"},{"text":"available (the least index on ties) and making it and its neighbours unavailable.","type":"text"},{"text":" ","type":"text"},{"text":"O(χ (n + m) log n) for χ classes.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"title":"ColoringStrategy.independentSet","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"role":"collectionGroup","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","abstract":[],"kind":"article","title":"Equatable Implementations","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","kind":"symbol","abstract":[{"text":"First the vertex of greatest degree (the least index on ties), then repeatedly the","type":"text"},{"text":" ","type":"text"},{"text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and","type":"text"},{"text":" ","type":"text"},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"title":"ColoringStrategy.coloredNeighbors","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. O(n + m).","type":"text"}],"role":"symbol","kind":"symbol","title":"ColoringStrategy.largestFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","role":"symbol","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","abstract":[{"text":"The same in depth-first preorder. O(n + m).","type":"text"}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"title":"ColoringStrategy.connectedSequentialDepthFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"role":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","abstract":[{"type":"text","text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured"},{"type":"text","text":" "},{"type":"text","text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in"},{"type":"text","text":" "},{"type":"text","text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n)."}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saturationLargestFirst","kind":"identifier"}],"title":"ColoringStrategy.saturationLargestFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst"},"doc://ColoringModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","type":"unresolvable"}}}