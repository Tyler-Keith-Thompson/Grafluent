xt":" ","type":"text"},{"code":".coloredNeighbors","type":"codeVoice"},{"text":".","type":"text"}]},"doc://ColoringModule/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/ColoringModule\/SH","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","type":"topic","url":"\/documentation\/coloringmodule","kind":"symbol","abstract":[],"role":"collection","title":"ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/largestFirst":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/largestFirst","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"largestFirst","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/largestfirst","kind":"symbol","abstract":[{"text":"Degree descending, the lesser index first on ties: Welsh–Powell, which colours class by","type":"text"},{"text":" ","type":"text"},{"text":"class in this order and gives the same colouring as first fit. O(n + m).","type":"text"}],"role":"symbol","title":"ColoringStrategy.largestFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialBreadthFirst","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","abstract":[{"type":"text","text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order. O(n + m)."}],"type":"topic","title":"ColoringStrategy.connectedSequentialBreadthFirst","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","kind":"symbol","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}],"role":"symbol","title":"ColoringStrategy.independentSet"},"doc://ColoringModule/s8SendableP":{"identifier":"doc:\/\/ColoringModule\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://ColoringModule/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/ColoringModule\/SQ","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"type":"topic","title":"ColoringStrategy.coloredNeighbors","role":"symbol","kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","abstract":[{"text":"First the vertex of greatest degree (the least index on ties), then repeatedly the","type":"text"},{"text":" ","type":"text"},{"text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and","type":"text"},{"text":" ","type":"text"},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/Equatable-Implementations":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/Equatable-Implementations","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy\/equatable-implementations","kind":"article","abstract":[],"role":"collectionGroup","title":"Equatable Implementations"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","kind":"symbol","abstract":[{"type":"text","text":"The same in depth-first preorder. O(n + m)."}],"role":"symbol","title":"ColoringStrategy.connectedSequentialDepthFirst"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/smallestLast":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}],"type":"topic","title":"ColoringStrategy.smallestLast","role":"symbol","kind":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","abstract":[{"text":"Matula–Beck: repeatedly remove a vertex of least degree in what is left (the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties), then colour in the reverse of that removal order. At most degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}]},"doc://ColoringModule/s12CaseIterableP":{"identifier":"doc:\/\/ColoringModule\/s12CaseIterableP","title":"Swift.CaseIterable","type":"unresolvable"},"doc://ColoringModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP","type":"unresolvable"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/saturationLargestFirst":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"saturationLargestFirst"}],"type":"topic","title":"ColoringStrategy.saturationLargestFirst","role":"symbol","url":"\/documentation\/coloringmodule\/coloringstrategy\/saturationlargestfirst","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/saturationLargestFirst","abstract":[{"text":"DSatur (Brélaz 1979): first a vertex of greatest degree, then repeatedly the uncoloured","type":"text"},{"text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. Exact on bipartite graphs. O((n + m) log n).","type":"text"}]}}}