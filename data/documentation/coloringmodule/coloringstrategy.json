text":" ","type":"text"},{"text":"vertex with the most distinct colours among its neighbours, ties to the greatest degree in","type":"text"},{"text":" ","type":"text"},{"text":"the whole graph, then to the lesser index. NetworkX ","type":"text"},{"code":"saturation_largest_first","type":"codeVoice"},{"text":" (","type":"text"},{"code":"DSATUR","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"the same colouring. Exact on bipartite graphs. O((n + m) log n).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialDepthFirst":{"title":"ColoringStrategy.connectedSequentialDepthFirst","kind":"symbol","abstract":[{"text":"The same in depth-first preorder. NetworkX ","type":"text"},{"type":"codeVoice","code":"connected_sequential_dfs"},{"text":". O(n + m).","type":"text"}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedSequentialDepthFirst","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialdepthfirst","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialDepthFirst"},"doc://ColoringModule/documentation/ColoringModule":{"title":"ColoringModule","kind":"symbol","abstract":[],"role":"collection","url":"\/documentation\/coloringmodule","type":"topic","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule"},"doc://ColoringModule/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/SH"},"doc://ColoringModule/SQ":{"identifier":"doc:\/\/ColoringModule\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://ColoringModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/ColoringModule\/s16SendableMetatypeP"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/connectedSequentialBreadthFirst":{"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/connectedSequentialBreadthFirst","url":"\/documentation\/coloringmodule\/coloringstrategy\/connectedsequentialbreadthfirst","title":"ColoringStrategy.connectedSequentialBreadthFirst","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedSequentialBreadthFirst"}],"type":"topic","role":"symbol","abstract":[{"text":"Components by least vertex, each in breadth-first order from its least vertex, neighbours","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order. NetworkX ","type":"text"},{"type":"codeVoice","code":"connected_sequential_bfs"},{"text":", which starts each component","type":"text"},{"text":" ","type":"text"},{"text":"at an arbitrary vertex instead. O(n + m).","type":"text"}]},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","title":"ColoringStrategy.independentSet","url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet","type":"text"},{"text":" ","type":"text"},{"text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still","type":"text"},{"text":" ","type":"text"},{"text":"available (the least index on ties) and making it and its neighbours unavailable. NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"independent_set"},{"type":"text","text":", whose ties follow set order instead. O(χ (n + m) log n) for χ classes."}]},"doc://ColoringModule/docume