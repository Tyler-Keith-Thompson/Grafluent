{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"kind":"symbol","variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"externalID":"s:14ColoringModule0A8StrategyO16coloredNeighborsyA2CmF","title":"ColoringStrategy.coloredNeighbors","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"remoteSource":{"fileName":"Coloring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L136"},"modules":[{"name":"ColoringModule"}],"roleHeading":"Case","symbolKind":"case"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}]}]}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"]]},"references":{"doc://ColoringModule/documentation/ColoringModule