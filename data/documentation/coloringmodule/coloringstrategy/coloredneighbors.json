{"abstract":[{"text":"First the vertex of greatest degree (the least index on ties), then repeatedly the","type":"text"},{"text":" ","type":"text"},{"text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and","type":"text"},{"text":" ","type":"text"},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}],"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","metadata":{"remoteSource":{"fileName":"Coloring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L136"},"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"roleHeading":"Case","modules":[{"name":"ColoringModule"}],"externalID":"s:14ColoringModule0A8StrategyO16coloredNeighborsyA2CmF","role":"symbol","symbolKind":"case","title":"ColoringStrategy.coloredNeighbors"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]}],"references":{"doc://ColoringModule/documentation/ColoringModule