{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","interfaceLanguage":"swift"},"metadata":{"symbolKind":"case","modules":[{"name":"ColoringModule"}],"externalID":"s:14ColoringModule0A8StrategyO16coloredNeighborsyA2CmF","role":"symbol","roleHeading":"Case","title":"ColoringStrategy.coloredNeighbors","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}]},"abstract":[{"text":"First the vertex of greatest degree (the least index on ties), then repeatedly the","type":"text"},{"text":" ","type":"text"},{"text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way","type":"text"},{"text":" ","type":"text"},{"text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and","type":"text"},{"text":" ","type":"text"},{"text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and","type":"text"},{"text":" ","type":"text"},{"text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n).","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"platforms":["Linux"]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ColoringModule/documentation/ColoringModule":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","kind":"symbol","url":"\/documentation\/coloringmodule","abstract":[],"title":"ColoringModule