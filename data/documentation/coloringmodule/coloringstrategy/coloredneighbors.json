{"sections":[],"abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}]}],"kind":"declarations"}],"kind":"symbol","identifier":{"url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"]}],"hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"]]},"metadata":{"externalID":"s:14ColoringModule0A8StrategyO16coloredNeighborsyA2CmF","role":"symbol","symbolKind":"case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"coloredNeighbors"}],"roleHeading":"Case","modules":[{"name":"ColoringModule"}],"title":"ColoringStrategy.coloredNeighbors","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L136","fileName":"Coloring.swift"}},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule","title":"ColoringModule","role":"collection"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/coloredNeighbors":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"First the vertex of greatest degree (the least index on ties), then repeatedly the"},{"type":"text","text":" "},{"type":"text","text":"uncoloured vertex with the most coloured neighbours. Ties among those fall as a two-way"},{"type":"text","text":" "},{"type":"text","text":"indexed binary max-heap breaks them, not by index: vertices are pushed in index order and"},{"type":"text","text":" "},{"type":"text","text":"raised neighbour by neighbour in ascending order; an entry moves above an equal parent and"},{"type":"text","text":" "},{"type":"text","text":"sinks to the left child unless the right one is strictly greater. O((n + m) log n)."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coloredNeighbors","kind":"identifier"}],"title":"ColoringStrategy.coloredNeighbors","kind":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/coloredNeighbors","url":"\/documentation\/coloringmodule\/coloringstrategy\/coloredneighbors"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColoringStrategy"}],"abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","navigatorTitle":[{"kind":"identifier","text":"ColoringStrategy"}],"kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule\/coloringstrategy","title":"ColoringStrategy","role":"symbol"}}}