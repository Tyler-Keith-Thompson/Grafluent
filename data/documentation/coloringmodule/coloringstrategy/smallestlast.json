 in the reverse of that removal order. At most degeneracy + 1 colours, so"},{"type":"text","text":" "},{"type":"text","text":"at most 6 on a planar graph. O((n + m) log n)."}],"title":"ColoringStrategy.smallestLast","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"smallestLast","kind":"identifier"}]},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"title":"ColoringModule","url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","role":"collection","type":"topic","kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"abstract":[{"type":"text","text":"How "},{"code":"greedyColoring(strategy:)","type":"codeVoice"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"code":".coloredNeighbors","type":"codeVoice"},{"type":"text","text":"."}],"title":"ColoringStrategy","url":"\/documentation\/coloringmodule\/coloringstrategy","navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","role":"symbol","type":"topic","kind":"symbol"}}}