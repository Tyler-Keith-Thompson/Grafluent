 degeneracy + 1 colours, so","type":"text"},{"text":" ","type":"text"},{"text":"at most 6 on a planar graph. O((n + m) log n).","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"smallestLast"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/smallestLast","url":"\/documentation\/coloringmodule\/coloringstrategy\/smallestlast"},"doc://ColoringModule/documentation/ColoringModule":{"title":"ColoringModule","url":"\/documentation\/coloringmodule","type":"topic","role":"collection","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"title":"ColoringStrategy","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/coloringstrategy"}}}