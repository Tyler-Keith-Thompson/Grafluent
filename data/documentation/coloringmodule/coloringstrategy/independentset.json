{"metadata":{"roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independentSet","kind":"identifier"}],"modules":[{"name":"ColoringModule"}],"remoteSource":{"fileName":"Coloring.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ColoringModule\/Coloring.swift#L125"},"externalID":"s:14ColoringModule0A8StrategyO14independentSetyA2CmF","symbolKind":"case","title":"ColoringStrategy.independentSet","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet"},"abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"languages":["swift"],"platforms":["Linux"]}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/ColoringModule\/documentation\/ColoringModule","doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/coloringmodule\/coloringstrategy\/independentset"]}],"references":{"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","kind":"symbol","type":"topic","url":"\/documentation\/coloringmodule","title":"ColoringModule","role":"collection"},