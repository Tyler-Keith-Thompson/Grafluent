s the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","url":"\/documentation\/coloringmodule\/coloringstrategy","navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"title":"ColoringStrategy","type":"topic"},"doc://ColoringModule/documentation/ColoringModule":{"abstract":[],"title":"ColoringModule","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/coloringmodule","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy/independentSet":{"url":"\/documentation\/coloringmodule\/coloringstrategy\/independentset","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Colour classes one at a time: class k is a maximal independent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"type":"text","text":"O(χ (n + m) log n) for χ classes."}],"role":"symbol","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","title":"ColoringStrategy.independentSet","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"i