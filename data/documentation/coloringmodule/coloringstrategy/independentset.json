ent set of the vertices not yet"},{"type":"text","text":" "},{"type":"text","text":"coloured, built by repeatedly taking the one with the fewest neighbours among those still"},{"type":"text","text":" "},{"type":"text","text":"available (the least index on ties) and making it and its neighbours unavailable."},{"type":"text","text":" "},{"text":"O(χ (n + m) log n) for χ classes.","type":"text"}],"title":"ColoringStrategy.independentSet","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy\/independentSet","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"independentSet"}],"role":"symbol","kind":"symbol","type":"topic"},"doc://ColoringModule/documentation/ColoringModule":{"title":"ColoringModule","url":"\/documentation\/coloringmodule","type":"topic","role":"collection","identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule","abstract":[],"kind":"symbol"},"doc://ColoringModule/documentation/ColoringModule/ColoringStrategy":{"identifier":"doc:\/\/ColoringModule\/documentation\/ColoringModule\/ColoringStrategy","abstract":[{"type":"text","text":"How "},{"type":"codeVoice","code":"greedyColoring(strategy:)"},{"type":"text","text":" orders the vertices. Each vertex in turn takes the least colour"},{"type":"text","text":" "},{"type":"text","text":"none of its already coloured neighbours has (first fit). Degrees are simple degrees (distinct"},{"type":"text","text":" "},{"type":"text","text":"other neighbours, self-loops left out); ties go to the lesser vertex index, except for"},{"type":"text","text":" "},{"type":"codeVoice","code":".coloredNeighbors"},{"type":"text","text":"."}],"title":"ColoringStrategy","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColoringStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"ColoringStrategy","kind":"identifier"}],"url":"\/documentation\/coloringmodule\/c