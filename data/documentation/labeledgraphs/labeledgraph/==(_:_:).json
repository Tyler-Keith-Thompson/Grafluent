,{"inlineContent":[{"type":"text","text":"When the labels are equal in order, this is "},{"code":"lhs.base == rhs.base","type":"codeVoice"},{"type":"text","text":". Otherwise the label sets"},{"type":"text","text":" "},{"type":"text","text":"are compared with n hashes, the right graph’s indices are mapped into the left’s, and each"},{"type":"text","text":" "},{"type":"text","text":"mapped edge is looked up with the left base’s "},{"code":"contains(edge:)","type":"codeVoice"},{"type":"text","text":". That is O(m log d) for"},{"type":"text","text":" "},{"code":"CompressedSparseRow","type":"codeVoice"},{"type":"text","text":" and O(m) for "},{"code":"AdjacencyMatrix","type":"codeVoice"},{"type":"text","text":". A base that allows parallel edges is"},{"type":"text","text":" "},{"type":"text","text":"compared by edge multiplicity through a dictionary."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://LabeledGraphs/documentation/LabeledGraphs/LabeledGraph":{"title":"LabeledGraph","url":"\/documentation\/labeledgraphs\/labeledgraph","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LabeledGraph"}],"abstract":[{"type":"text","text":"A directed graph whose vertices are "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" labels, stored over an index-based"},{"type":"text","text":" "},{"type":"text","text":"representation whose vertices are "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"LabeledGraph"}],"identifier":"doc:\/\/LabeledGraphs\/documentation\/LabeledGraphs\/LabeledGraph","type":"topic"},"doc://LabeledGraphs/documentation/LabeledGraphs":{"url":"\/documentation\/labeledgraphs","title":"LabeledGraphs","role":"collection","abstract":[],"identifier":"doc:\/\/LabeledGraphs\/documentation\/LabeledGraphs","kind":"symbol","type":"topic"},"doc://LabeledGraphs/documentation/LabeledGraphs/LabeledGrap