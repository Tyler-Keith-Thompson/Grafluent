documentation\/Cycles\/DirectedSimpleCycles\/Element","role":"symbol"},"doc://Cycles/documentation/Cycles/DirectedSimpleCycles":{"abstract":[{"text":"Every simple cycle of a directed graph once, lazily: by least vertex (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order),","type":"text"},{"text":" ","type":"text"},{"text":"and among the cycles with one least vertex in the order a depth-first search from it, taking","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, meets them."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedSimpleCycles"}],"url":"\/documentation\/cycles\/directedsimplecycles","type":"topic","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedSimpleCycles"}],"title":"DirectedSimpleCycles"},"doc://Walks/documentation/Walks/Cycle":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"url":"\/documentation\/walks\/cycle","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"kind":"symbol","title":"Cycle","role":"symbol","identifier":"doc:\/\/Walks\/documentation\/Walks\/