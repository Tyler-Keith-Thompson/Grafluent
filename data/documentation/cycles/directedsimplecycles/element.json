ext"},{"text":"DirectedSimpleCycles","kind":"identifier"}],"title":"DirectedSimpleCycles","type":"topic","url":"\/documentation\/cycles\/directedsimplecycles","abstract":[{"type":"text","text":"Every simple cycle of a directed graph once, lazily: by least vertex (in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order),"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"out-edges in "},{"code":"outEdges","type":"codeVoice"},{"type":"text","text":" order, meets them."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"DirectedSimpleCycles","kind":"identifier"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles"},"doc://Cycles/documentation/Cycles/DirectedSimpleCycles/Element":{"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Element","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"abstract":[],"title":"DirectedSimpleCycles.Element","type":"topic","url":"\/documentation\/cycles\/directedsimplecycles\/element","navigatorTitle":[{"text":"Element","kind":"identifier"}]},"doc://Walks/documentation/Walks/Cycle":{"fragments":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"title":"Cycle","type":"topic","url":"\/documentation\/walks\/cycle","abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"}}}