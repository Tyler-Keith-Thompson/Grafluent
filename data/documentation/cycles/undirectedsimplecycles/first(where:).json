"kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedSimpleCycles","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"UndirectedSimpleCycles","abstract":[{"type":"text","text":"Every simple cycle of an undirected graph once, lazily, each starting at its least vertex (in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) and leaving it through the lesser of its two edges there: by least vertex,"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, meets them in that orientation."}],"navigatorTitle":[{"text":"UndirectedSimpleCycles","kind":"identifier"}]},"doc://Cycles/documentation/Cycles":{"role":"collection","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles","kind":"symbol","abstract":[],"url":"\/documentation\/cycles","title":"Cycles"}}}