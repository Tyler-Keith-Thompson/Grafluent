":[{"text":"UndirectedSimpleCycles","kind":"identifier"}],"title":"UndirectedSimpleCycles","role":"symbol","abstract":[{"type":"text","text":"Every simple cycle of an undirected graph once, lazily, each starting at its least vertex (in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) and leaving it through the lesser of its two edges there: by least vertex,"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, meets them in that orientation."}],"type":"topic","url":"\/documentation\/cycles\/undirectedsimplecycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/UndirectedSimpleCycles"},"doc://Cycles/documentation/Cycles":{"role":"collection","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cycles","title":"Cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles"}}}