ithub.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L77","fileName":"SimpleCycles.swift"},"title":"UndirectedSimpleCycles.Element","role":"symbol","modules":[{"name":"Cycles"}]},"references":{"doc://Walks/documentation/Walks/Cycle":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cycle"}],"url":"\/documentation\/walks\/cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Cycle"}],"title":"Cycle","abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"kind":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"abstract":[],"title":"Vertex","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","role":"symbol"},"doc://Cycles/documentation/Cycles":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles","url":"\/documentation\/cycles","title":"Cycles","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://Cycles/documentation/Cycles/UndirectedSimpleCycles/Element