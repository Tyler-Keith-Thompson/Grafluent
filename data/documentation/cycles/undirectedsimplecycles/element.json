ges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]}],"references":{"doc://Walks/documentation/Walks/Cycle":{"title":"Cycle","navigatorTitle":[{"kind":"identifier","text":"Cycle"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cycle"}],"type":"topic","url":"\/documentation\/walks\/cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles":{"title":"Cycles","type":"topic","url":"\/documentation\/cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles","abstract":[],"kind":"symbol","role":"collection"},"doc://Cycles/documentation/Cycles/UndirectedSimpleCycles":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedSimpleCycles","kind":"identifier"}],"navigatorTitle":[{"text":"UndirectedSimpleCycles","kind":"identifier"}],"role":"symbol","url":"\/documentation\/cycles\/undirectedsimplecycles","title":"UndirectedSimpleCycles","type":"topic","abstract":[{"type":"text","text":"Every simple cycle of an undirected graph once, lazily, each starting at its least vertex (in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) and leaving it through the lesser of its two edges there: by least vertex,"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, meets them in that orientation."}],"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/UndirectedSimpleCycles"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","type":"topic","title":"Edges","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Cycles/documentation/Cycles/UndirectedSimpleCycles/Element":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"navigatorTitle":[{"kind":"identifier","text":"Element"}],"role":"symbol","url":"\/documentation\/cycles\/undirectedsimplecycles\/element","title":"UndirectedSimpleCycles.Element","type":"topic","abstract":[],"iden