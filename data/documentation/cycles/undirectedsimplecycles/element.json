afluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L77","fileName":"SimpleCycles.swift"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/UndirectedSimpleCycles\/Element"},"references":{"doc://Walks/documentation/Walks/Cycle":{"url":"\/documentation\/walks\/cycle","kind":"symbol","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"title":"Cycle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},"doc://Cycles/documentation/Cycles/UndirectedSimpleCycles":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/UndirectedSimpleCycles","type":"topic","url":"\/documentation\/cycles\/undirectedsimplecycles","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedSimpleCycles","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"UndirectedSimpleCycles","abstract":[{"type":"text","text":"Every simple cycle of an undirected graph once, lazily, each starting at its least vertex (in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) and leaving it through the lesser of its two edges there: by least vertex,"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, meets them in that orientation."}],"navigatorTitle":[{"text":"UndirectedSimpleCycles","kind":"identifier"}]},"doc://Cycles/documentation/Cycles":{"role":"collection","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles","kind":"symbol","abstract":[],"url":"\/documentation\/cycles","title":"Cycles"},"doc://Cycles/documentation/Cycles/UndirectedSimpleCycles/Element":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/UndirectedSimpleCycles\/Element","type":"topic","url":"\/documentation\/cycles\/undirectedsimplecycles\/element","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"UndirectedSimpleCycles.Element","abstract":[],"navigatorTitle":[{"text":"Element","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"symbol","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","title":"Edges","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind