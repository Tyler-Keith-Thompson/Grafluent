tifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/undirectedsimplecycles\/element"]}],"sections":[],"kind":"symbol","references":{"doc://Cycles/documentation/Cycles/UndirectedSimpleCycles":{"role":"symbol","type":"topic","url":"\/documentation\/cycles\/undirectedsimplecycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/UndirectedSimpleCycles","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedSimpleCycles","kind":"identifier"}],"abstract":[{"type":"text","text":"Every simple cycle of an undirected graph once, lazily, each starting at its least vertex (in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order) and leaving it through the lesser of its two edges there: by least vertex,"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, meets them in that orientation."}],"title":"UndirectedSimpleCycles","navigatorTitle":[{"text":"UndirectedSimpleCycles","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text"