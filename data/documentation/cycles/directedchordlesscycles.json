{"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Cycles\/s8SendableP","doc:\/\/Cycles\/s16SendableMetatypeP","doc:\/\/Cycles\/ST"]}],"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/Iterator"],"anchor":"Structures"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/maxLength"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/makeIterator()"],"anchor":"Instance-Methods"},{"title":"Type Aliases","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/Element"],"anchor":"Type-Aliases"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/Sequence-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedChordlessCycles"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"A self-loop is a chordless cycle when it is its vertex’s only one, and its vertex is on no","type":"text"},{"text":