{"metadata":{"modules":[{"name":"Cycles"}],"remoteSource":{"fileName":"ChordlessCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/ChordlessCycles.swift#L273"},"roleHeading":"Structure","symbolKind":"struct","externalID":"s:6Cycles017DirectedChordlessA0V","navigatorTitle":[{"text":"DirectedChordlessCycles","kind":"identifier"}],"role":"symbol","title":"DirectedChordlessCycles","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedChordlessCycles"}]},"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles"]]},"abstract":[{"type":"text","text":"Every chordless cycle of a directed graph once, lazily: the simple cycles whose vertices"},{"type":"text","text":" "},{"type":"text","text":"induce no edge but the cycle’s own. By least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order), and among the"},{"type":"text","text":" "},{"type":"text","text":"cycles with one least vertex in the order a depth-first search from it, taking out-edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, meets them."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/directedchordlesscycles"]}],"relationshipsSections":[{"identifiers":["doc:\/\/Cycles\/s8SendableP","doc:\/\/Cycles\/s16SendableMetatypeP","doc:\/\/Cycles\/ST"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedChordlessCycles"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"type