{"metadata":{"remoteSource":{"fileName":"ChordlessCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/ChordlessCycles.swift#L273"},"modules":[{"name":"Cycles"}],"roleHeading":"Structure","role":"symbol","externalID":"s:6Cycles017DirectedChordlessA0V","title":"DirectedChordlessCycles","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedChordlessCycles","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedChordlessCycles"}]},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles"]]},"relationshipsSections":[{"identifiers":["doc:\/\/Cycles\/s8SendableP","doc:\/\/Cycles\/s16SendableMetatypeP","doc:\/\/Cycles\/ST"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedChordlessCycles","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A self-loop is a chordless cycle when it is its vertex’s only one, and its vertex is on no"},{"type":"text","text":" "},{"type":"text","text":"other; two opposite edges are one when nothing else joins their ends. A parallel edge is a"},{"type":"text","text":" "},{"type":"text","text":"chord of every cycle through its ends."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The sequence holds the graph (a value), so iterating again gives the same cycles. The first"},{"type":"text","text":" "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" copies the graph’s rows, O(n + m). The search extends only induced paths, each step"},{"type":"text","text":" "},{"type":"text","text":"O(d) for the degree d of the vertex entered or left."}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/Iterator"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/maxLength"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/makeIterator()"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/Element"],"anchor":"Type-Aliases","title":"Type Aliases","generated":true},{"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles\/Sequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/directedchordlesscycles"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedChordlessCycles"},"abstract":[{"type":"text","text":"Every chordless cycle of a directed graph once, lazily: the simple cycles whose vertices"},{"type":"text","text":" "},{"type":"text","text":"induce no edge but the cycle’s own. By least vertex (in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order), and among the"},{"type":"text","text":" "},{"type":"