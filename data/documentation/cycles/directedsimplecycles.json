":"codeVoice"},{"text":" copies the graph’s rows and","type":"text"},{"text":" ","type":"text"},{"text":"decomposes them, O(n + m). Unbounded, the time between consecutive cycles is O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"(Johnson), so c cycles take O((n + m)(c + 1)); with a bound k the whole enumeration takes","type":"text"},{"text":" ","type":"text"},{"text":"O((c + n)·k·d^k) for average degree d (Gupta–Suzumura).","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"text":"Every simple cycle of a directed graph once, lazily: by least vertex (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order),","type":"text"},{"text":" ","type":"text"},{"text":"and among the cycles with one least vertex in the order a depth-first search from it, taking","type":"text"},{"text":" ","type":"text"},{"text":"out-edges in ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" order, meets them.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Iterator"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/maxLength"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/makeIterator()"]},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Element"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Sequence-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/directedsimplecycles"]}],"sections":