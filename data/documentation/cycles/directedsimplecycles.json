:"text"},{"text":" ","type":"text"},{"text":"the original graph afterwards changes nothing. The first ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" copies the graph’s rows and","type":"text"},{"text":" ","type":"text"},{"text":"decomposes them, O(n + m). Unbounded, the time between consecutive cycles is O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"(Johnson), so c cycles take O((n + m)(c + 1)); with a bound k the whole enumeration takes","type":"text"},{"text":" ","type":"text"},{"text":"O((c + n)·k·d^k) for average degree d (Gupta–Suzumura).","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/directedsimplecycles"]}],"abstract":[{"type":"text","text":"Every simple cycle of a directed graph once, lazily: by least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order),"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, meets them."}],"metadata":{"title":"DirectedSimpleCycles","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L14","fileName":"SimpleCycles.swift"},"symbolKind":"struct","externalID":"s:6Cycles014DirectedSimpleA0V","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimpleCycles","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedSimpleCycles"}],"modules":[{"name":"Cycles"}],"roleHeading":"Structure"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles"]]},"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles","interfaceLanguage":"swift