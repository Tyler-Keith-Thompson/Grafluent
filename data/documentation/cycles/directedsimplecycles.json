{"metadata":{"modules":[{"name":"Cycles"}],"remoteSource":{"fileName":"SimpleCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L14"},"roleHeading":"Structure","externalID":"s:6Cycles014DirectedSimpleA0V","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"DirectedSimpleCycles"}],"role":"symbol","title":"DirectedSimpleCycles","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimpleCycles","kind":"identifier"}]},"sections":[],"abstract":[{"type":"text","text":"Every simple cycle of a directed graph once, lazily: by least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order),"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, meets them."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/directedsimplecycles"]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Cycles\/s8SendableP","doc:\/\/Cycles\/s16SendableMetatypeP","doc:\/\/Cycles\/ST"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimpleCycles","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/G