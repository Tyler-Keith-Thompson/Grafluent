{"metadata":{"externalID":"s:6Cycles014DirectedSimpleA0V","modules":[{"name":"Cycles"}],"title":"DirectedSimpleCycles","roleHeading":"Structure","navigatorTitle":[{"text":"DirectedSimpleCycles","kind":"identifier"}],"role":"symbol","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimpleCycles","kind":"identifier"}],"remoteSource":{"fileName":"SimpleCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L14"}},"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimpleCycles","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The sequence holds the graph (a value), so iterating again gives the same cycles, and changing"},{"type":"text","text":" "},{"type":"text","text":"the original graph afterwards changes nothing. The first "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" copies the graph’s rows and"},{"type":"text","text":" "},{"type":"text","text":"decomposes them, O(n + m). Unbounded, the time between consecutive cycles is O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"(Johnson), so c cycles take O((n + m)(c + 1)); with a bound k the whole enumeration takes"},{"type":"text","text":" "},{"type":"text","text":"O((c + n)·k·d^k) for average degree d (Gupta–Suzumura)."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Every simple cycle of a directed graph once, lazily: by least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order),"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, meets them."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/directedsimplecycles"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Cycles\/s8SendableP","doc:\/\/Cycles\/s16SendableMetatypeP","doc:\/\/Cycles\/ST"],"type":"conformsTo","title":"Conforms To"}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Iterator"],"title":"Structures","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/maxLength"],"title":"Instance Properties","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/makeIterator()"],"title":"Instance Methods","generated":true},{"anchor":"Type-Aliases","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Element"],"title":"Type Aliases","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Sequence-Implementations"],"title":"Default Implementations","generated":true