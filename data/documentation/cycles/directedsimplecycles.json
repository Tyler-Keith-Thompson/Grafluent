{"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"DirectedSimpleCycles","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L14","fileName":"SimpleCycles.swift"},"externalID":"s:6Cycles014DirectedSimpleA0V","symbolKind":"struct","modules":[{"name":"Cycles"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimpleCycles","kind":"identifier"}],"role":"symbol","title":"DirectedSimpleCycles","roleHeading":"Structure"},"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Iterator"],"title":"Structures"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/maxLength"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/makeIterator()"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Element"],"title":"Type Aliases"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Sequence-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedSimpleCycles"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"identi