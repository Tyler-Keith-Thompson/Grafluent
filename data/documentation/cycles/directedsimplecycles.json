{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles"},"abstract":[{"type":"text","text":"Every simple cycle of a directed graph once, lazily: by least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order),"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, meets them."}],"metadata":{"symbolKind":"struct","role":"symbol","remoteSource":{"fileName":"SimpleCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L14"},"externalID":"s:6Cycles014DirectedSimpleA0V","roleHeading":"Structure","title":"DirectedSimpleCycles","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedSimpleCycles"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedSimpleCycles"}],"modules":[{"name":"Cycles"}]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Cycles\/s8SendableP","doc:\/\/Cycles\/s16SendableMetatypeP","doc:\/\/Cycles\/ST"]}],"variants":[{"paths":["\/documentation\/cycles\/directedsimplecycles"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimpleCycles","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"t