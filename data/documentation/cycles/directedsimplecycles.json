{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Every simple cycle of a directed graph once, lazily: by least vertex (in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order),"},{"type":"text","text":" "},{"type":"text","text":"and among the cycles with one least vertex in the order a depth-first search from it, taking"},{"type":"text","text":" "},{"type":"text","text":"out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, meets them."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedSimpleCycles"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"The sequence holds the graph (a value), so iterating again gives the same cycles, and changing","type":"text"},{"text":" ","type":"text"},{"text":"the original graph afterwards changes nothing. The first ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" copies the graph’s rows and","type":"text"},{"text":" ","type":"text"},{"text":"decomposes them, O(n + m). Unbounded, the time between consecutive cycles is O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"(Johnson), so c cycles take O((n + m)(c + 1)); with a bound k the whole enumeration takes","type":"text"},{"text":" ","type":"text"},{"text":"O((c + n)·k·d^k) for average degree d (Gupta–Suzumura).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/directedsimplecycles"]}],"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Iterator"],"title":"Structures"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/maxLength"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/makeIterator()"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Element"],"title":"Type Aliases"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Sequence-Implementations"],"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles"]]},"metadata":{"externalID":"s:6Cycles014DirectedSimpleA0V","title":"DirectedSimpleCycles","symbolKind":"struct","remoteSource":{"fileName":"SimpleCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L14"},"roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"DirectedSimpleCycles","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedSimpleCycles"}],"modules":[{"name":"Cycles"}]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Cycles\/s8SendableP","doc:\/\/Cycles\/s16SendableMetatypeP","doc:\/\/Cycles\/ST"],"title":"Conforms To"