{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles"},"sections":[],"metadata":{"remoteSource":{"fileName":"SimpleCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/SimpleCycles.swift#L14"},"navigatorTitle":[{"text":"DirectedSimpleCycles","kind":"identifier"}],"modules":[{"name":"Cycles"}],"roleHeading":"Structure","externalID":"s:6Cycles014DirectedSimpleA0V","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedSimpleCycles"}],"symbolKind":"struct","role":"symbol","title":"DirectedSimpleCycles"},"abstract":[{"text":"Every simple cycle of a directed graph once, lazily: by least vertex (in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order),","type":"text"},{"text":" ","type":"text"},{"text":"and among the cycles with one least vertex in the order a depth-first search from it, taking","type":"text"},{"text":" ","type":"text"},{"text":"out-edges in ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" order, meets them.","type":"text"}],"kind":"symbol","topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Iterator"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/maxLength"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/makeIterator()"],"generated":true},{"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Element"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/Cycles\/documentation\/Cycles\/DirectedSimpleCycles\/Sequence-Implementations"],"