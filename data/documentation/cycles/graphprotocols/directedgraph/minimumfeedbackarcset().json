{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A minimum feedback arc set: the fewest edges whose removal leaves no directed cycle, by"},{"type":"text","text":" "},{"type":"text","text":"position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", ascending. Every self-loop is in it, and parallel edges count one"},{"type":"text","text":" "},{"type":"text","text":"each. On an acyclic graph the result is empty. Which of several minimum sets is returned"},{"type":"text","text":" "},{"type":"text","text":"is unspecified."}],"metadata":{"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumFeedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":"]"}],"modules":[{"name":"Cycles","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols08DirectedA0P6CyclesE21minimumFeedbackArcSetSay5Edges_5IndexQZGyF","extendedModule":"GraphProtocols","remoteSource":{"fileName":"MinimumFeedbackSets.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/MinimumFeedbackSets.swift#L149"},"title":"minimumFeedbackArcSet()"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/minimumfeedbackarcset()"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/minimumFeedbackArcSet()"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/G