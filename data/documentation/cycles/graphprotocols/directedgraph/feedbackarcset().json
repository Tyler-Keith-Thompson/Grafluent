{"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum.","type":"text"},{"text":" ","type":"text"},{"text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"metadata":{"extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L23","fileName":"FeedbackArcSet.swift"},"title":"feedbackArcSet()","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","modules":[{"relatedModules":["GraphProtocols"],"name":"Cycles"}]},"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward","type":"text"},{"text":" ","type":"text"},{"text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the","type":"text"},{"text":" ","type":"text"},{"text":"sequence), else a source (at the left end), else the vertex whose out-degree minus","type":"text"},{"text":" ","type":"text"},{"text":"in-degree is largest (at the left end), with the least ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" offset on ties. Sinks and","type":"text"},{"text":" ","type":"text"},{"text":"sources are removed in the order they became one, starting from ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic","type":"text"},{"text":" ","type":"text"},{"text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges","type":"text"},{"text":" ","type":"text"},{"text":"leaves no directed cycle.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,","type":"text"},{"text":" ","type":"text"},{"text":"Information Processing Letters 47(6), 1993. The largest-difference vertices are kept in a","type":"text"},{"text":" ","type":"text"},{"text":"binary heap so that ties go to the least offset.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O((n + m) log n) time, O(n + m) memory."}],"type":"paragraph"}],"name":"Complexity"}]}],"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","interfaceLanguage":"swift"},"references":{"doc://Cycles/documentation/Cycles/GraphProtocols":{"url":"\/documentation\/cycles\/graphprotocols","kind":"symbol","title":"GraphProtocols","abstract":[],"type":"topic","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols"},"doc://Cycles/documentation/Cycles":{"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles","title":"Cycles","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","title":"feedbackArcSet()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum.","type":"text"},{"text":" ","type":"text"},{"text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"abstract":[],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"title":"DirectedGraph","url":"\/documentation\/cycles\/graphprotocols\/directedgraph","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"kind":"symbol","title":"Edges","abstract":[],"type":"topic","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"}}}