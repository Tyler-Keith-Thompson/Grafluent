{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward","type":"text"},{"text":" ","type":"text"},{"text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the","type":"text"},{"text":" ","type":"text"},{"text":"sequence), else a source (at the left end), else the vertex whose out-degree minus","type":"text"},{"text":" ","type":"text"},{"text":"in-degree is largest (at the left end), with the least ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" offset on ties. Sinks and","type":"text"},{"text":" ","type":"text"},{"text":"sources are removed in the order they became one, starting from ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic","type":"text"},{"text":" ","type":"text"},{"text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges","type":"text"},{"text":" ","type":"text"},{"text":"leaves no directed cycle.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 47(6), 1993. Linear time with bucket queues; this"},{"type":"text","text":" "},{"type":"text","text":"implementation keeps the largest-difference vertices in a binary heap so that ties go to"},{"type":"text","text":" "},{"type":"text","text":"the least offset: O((n + m) log n) time, O(n + m) memory. igraph breaks ties in its own"},{"type":"text","text":" "},{"type":"text","text":"bucket order, so on some graphs it returns another set of the same kind."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"Cycles"}],"externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","symbolKind":"method","roleHeading":"Instance Method","title":"feedbackArcSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}],"extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L24","fileName":"FeedbackArcSet.swift"},"role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()"},"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s ","type":"text"},{"code":"feedback_arc_set","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"method=\"eades\"","type":"codeVoice"},{"text":"). Every self-loop is in it, as in igraph:","type":"text"},{"text":" ","type":"text"},{"text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"references":{"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"type":"topic","url":"\/documentation\/cycles\/graphprotocols\/directedgraph","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","abstract":[],"kind":"symbol","title":"DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", ascending: a feedback arc set, small in practice but not minimum"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s "},{"type":"codeVoice","code":"feedback_arc_set"},{"type":"text","text":" with "},{"type":"codeVoice","code":"method=\"eades\""},{"type":"text","text":"). Every self-loop is in it, as in igraph:"},{"type":"text","text":" "},{"type":"text","text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2]."}],"title":"feedbackArcSet()","url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","type":"topic"},"doc://Cycles/documentation/Cycles":{"title":"Cycles","url":"\/documentation\/cycles","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles","type":"topic","abstract":[],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","title":"Edges","abstract":[],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"title":"GraphProtocols","url":"\/documentation\/cycles\/graphprotocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"kind":"symbol","type":"topic","role":"collection"}}}