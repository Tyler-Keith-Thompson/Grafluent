{"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","interfaceLanguage":"swift"},"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", ascending: a feedback arc set, small in practice but not minimum","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s ","type":"text"},{"type":"codeVoice","code":"feedback_arc_set"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"method=\"eades\""},{"text":"). Every self-loop is in it, as in igraph:","type":"text"},{"text":" ","type":"text"},{"text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward"},{"type":"text","text":" "},{"type":"text","text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the"},{"type":"text","text":" "},{"type":"text","text":"sequence), else a source (at the left end), else the vertex whose out-degree minus"},{"type":"text","text":" "},{"type":"text","text":"in-degree is largest (at the left end), with the least "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" offset on ties. Sinks and"},{"type":"text","text":" "},{"type":"text","text":"sources are removed in the order they became one, starting from "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."},{"type":"text","text":" "},{"type":"text","text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic"},{"type":"text","text":" "},{"type":"text","text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges"},{"type":"text","text":" "},{"type":"text","text":"leaves no directed cycle."}]},{"type":"paragraph","inlineContent":[{"text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,","type":"text"},{"text":" ","type":"text"},{"text":"Information Processing Letters 47(6), 1993. Linear time with bucket queues; this","type":"text"},{"text":" ","type":"text"},{"text":"implementation keeps the largest-difference vertices in a binary heap so that ties go to","type":"text"},{"text":" ","type":"text"},{"text":"the least offset: O((n + m) log n) time, O(n + m) memory. igraph breaks ties in its own","type":"text"},{"text":" ","type":"text"},{"text":"bucket order, so on some graphs it returns another set of the same kind.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"feedbackArcSet()","remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L24"},"symbolKind":"method","externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Cycles"}],"extendedModule":"GraphProtocols"},"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"references":{"doc://Cycles/documentation/Cycles":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles","title":"Cycles","type":"topic","url":"\/documentation\/cycles","abstract":[]},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"abstract":[]},"doc://Cycles/documentation/Cycles/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"url":"\/documentation\/cycles\/graphprotocols","kind":"symbol","role":"collection","type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", ascending: a feedback arc set, small in practice but not minimum"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s "},{"type":"codeVoice","code":"feedback_arc_set"},{"type":"text","text":" with "},{"type":"codeVoice","code":"method=\"eades\""},{"type":"text","text":"). Every self-loop is in it, as in igraph:"},{"type":"text","text":" "},{"type":"text","text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2]."}],"kind":"symbol","type":"topic","role":"symbol","title":"feedbackArcSet()","url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"abstract":[],"kind":"symbol","type":"topic","role":"symbol","title":"Edges","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}]}}}