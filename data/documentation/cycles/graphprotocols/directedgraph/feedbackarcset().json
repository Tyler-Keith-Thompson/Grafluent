{"metadata":{"modules":[{"name":"Cycles","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","role":"symbol","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":"]"}],"remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L23"},"title":"feedbackArcSet()","symbolKind":"method"},"abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", ascending: a feedback arc set, small in practice but not minimum."},{"type":"text","text":" "},{"type":"text","text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2]."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"]}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward","type":"text"},{"text":" ","type":"text"},{"text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the","type":"text"},{"text":" ","type":"text"},{"text":"sequence), else a source (at the left end), else the vertex whose out-degree minus","type":"text"},{"text":" ","type":"text"},{"text":"in-degree is largest (at the left end), with the least ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" offset on ties. Sinks and","type":"text"},{"text":" ","type":"text"},{"text":"sources are removed in the order they became one, starting from ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic","type":"text"},{"text":" ","type":"text"},{"text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges","type":"text"},{"text":" ","type":"text"},{"text":"leaves no directed cycle.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,","type":"text"},{"text":" ","type":"text"},{"text":"Information Processing Letters 47(6), 1993. The largest-difference vertices are kept in a","type":"text"},{"text":" ","type":"text"},{"text":"binary heap so that ties go to the least offset.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"O((n + m) log n) time, O(n + m) memory.","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note"}],"kind":"content"}],"references":{"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}],"type":"topic","url":"\/documentation\/cycles\/graphprotocols\/directedgraph","kind":"symbol","title":"DirectedGraph"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"title":"feedbackArcSet()","url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","type":"topic","abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", ascending: a feedback arc set, small in practice but not minimum."},{"type":"text","text":" "},{"type":"text","text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2]."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"title":"Edges","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","abstract":[],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},"doc://Cycles/documentation/Cycles":{"role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles","abstract":[],"kind":"symbol","type":"topic","title":"Cycles","url":"\/documentation\/cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"title":"GraphProtocols","type":"topic","role":"collection","url":"\/documentation\/cycles\/graphprotocols","kind":"symbol"}}}