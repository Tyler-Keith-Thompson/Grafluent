{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward","type":"text"},{"text":" ","type":"text"},{"text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the","type":"text"},{"text":" ","type":"text"},{"text":"sequence), else a source (at the left end), else the vertex whose out-degree minus","type":"text"},{"text":" ","type":"text"},{"text":"in-degree is largest (at the left end), with the least ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" offset on ties. Sinks and","type":"text"},{"text":" ","type":"text"},{"text":"sources are removed in the order they became one, starting from ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic","type":"text"},{"text":" ","type":"text"},{"text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges","type":"text"},{"text":" ","type":"text"},{"text":"leaves no directed cycle.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,","type":"text"},{"text":" ","type":"text"},{"text":"Information Processing Letters 47(6), 1993. The largest-difference vertices are kept in a","type":"text"},{"text":" ","type":"text"},{"text":"binary heap so that ties go to the least offset.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O((n + m) log n) time, O(n + m) memory."}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()"},"metadata":{"modules":[{"name":"Cycles","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","title":"feedbackArcSet()","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L23"},"roleHeading":"Instance Method","role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF"},"kind":"symbol","abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", ascending: a feedback arc set, small in practice but not minimum."},{"type":"text","text":" "},{"type":"text","text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2]."}],"references":{"doc://Cycles/documentation/Cycles":{"kind":"symbol","title":"Cycles","url":"\/documentation\/cycles","role":"collection","abstract":[],"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"kind":"symbol","title":"Edges","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","role":"symbol","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","type":"topic","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","role":"symbol","abstract":[],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"title":"feedbackArcSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":"]"}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","role":"symbol","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", ascending: a feedback arc set, small in practice but not minimum.","type":"text"},{"text":" ","type":"text"},{"text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"type":"topic","kind":"symbol"}}}