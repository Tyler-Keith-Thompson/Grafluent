{"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"metadata":{"role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}],"modules":[{"name":"Cycles","relatedModules":["GraphProtocols"]}],"remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L23"},"symbolKind":"method","roleHeading":"Instance Method","title":"feedbackArcSet()"},"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum.","type":"text"},{"text":" ","type":"text"},{"text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward","type":"text"},{"text":" ","type":"text"},{"text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the","type":"text"},{"text":" ","type":"text"},{"text":"sequence), else a source (at the left end), else the vertex whose out-degree minus","type":"text"},{"text":" ","type":"text"},{"text":"in-degree is largest (at the left end), with the least ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" offset on ties. Sinks and","type":"text"},{"text":" ","type":"text"},{"text":"sources are removed in the order they became one, starting from ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic","type":"text"},{"text":" ","type":"text"},{"text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges","type":"text"},{"text":" ","type":"text"},{"text":"leaves no directed cycle.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 47(6), 1993. The largest-difference vertices are kept in a"},{"type":"text","text":" "},{"type":"text","text":"binary heap so that ties go to the least offset."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O((n + m) log n) time, O(n + m) memory."}],"type":"paragraph"}],"name":"Complexity","type":"aside"}]}],"references":{"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"kind":"symbol","title":"feedbackArcSet()","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum.","type":"text"},{"text":" ","type":"text"},{"text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":"]"}],"type":"topic","role":"symbol"},"doc://Cycles/documentation/Cycles":{"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/cycles","abstract":[],"identifier":"doc:\/\/Cycles\/documentation\/Cycles","title":"Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/directedgraph","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"kind":"symbol","title":"Edges","abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"type":"topic","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"title":"GraphProtocols","role":"collection","url":"\/documentation\/cycles\/graphprotocols"}}}