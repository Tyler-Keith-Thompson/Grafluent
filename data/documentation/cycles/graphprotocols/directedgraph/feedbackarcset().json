{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"]}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic reverses to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":": a feedback arc set, small in practice but not minimum (igraph’s","type":"text"},{"text":" ","type":"text"},{"code":"feedback_arc_set","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"algo=\"eades\"","type":"codeVoice"},{"text":").","type":"text"}],"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"Cycles"}],"extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L22","fileName":"FeedbackArcSet.swift"},"externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"symbolKind":"method","roleHeading":"Instance Method","role":"symbol","title":"feedbackArcSet()"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()"},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The heuristic orders the vertices in a sequence and reverses every edge that points"},{"type":"text","text":" "},{"type":"text","text":"leftward in it. It repeatedly removes a sink (placed at the right end of the sequence),"},{"type":"text","text":" "},{"type":"text","text":"else a source (at the left end), else the vertex whose out-degree minus in-degree is"},{"type":"text","text":" "},{"type":"text","text":"largest (at the left end), with the least "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offset on ties. Sinks and sources are"},{"type":"text","text":" "},{"type":"text","text":"removed in the order they became one, starting from "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored and never returned; parallel edges count once each. On an acyclic graph the result"},{"type":"text","text":" "},{"type":"text","text":"is empty, and for every graph, reversing the returned edges leaves no directed cycle"},{"type":"text","text":" "},{"type":"text","text":"other than self-loops."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 47(6), 1993. Linear time with bucket queues; this"},{"type":"text","text":" "},{"type":"text","text":"implementation keeps the largest-difference vertices in a binary heap so that ties go to"},{"type":"text","text":" "},{"type":"text","text":"the least offset: O((n + m) log n) time, O(n + m) memory."}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"abstract":[],"kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","role":"symbol","title":"Edges"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","type":"topic","abstract":[],"url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","role":"collection","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic reverses to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":": a feedback arc set, small in practice but not minimum (igraph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"feedback_arc_set"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"algo=\"eades\""},{"text":").","type":"text"}],"role":"symbol","type":"topic","title":"feedbackArcSet()","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"url":"\/documentation\/cycles\/graphprotocols\/directedgraph","abstract":[],"role":"symbol","title":"DirectedGraph","type":"topic","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}]},"doc://Cycles/documentation/Cycles":{"url":"\/documentation\/cycles","abstract":[],"role":"collection","title":"Cycles","type":"topic","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles"}}}