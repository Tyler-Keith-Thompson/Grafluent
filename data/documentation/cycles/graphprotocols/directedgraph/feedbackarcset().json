{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum.","type":"text"},{"text":" ","type":"text"},{"text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward"},{"type":"text","text":" "},{"type":"text","text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the"},{"type":"text","text":" "},{"type":"text","text":"sequence), else a source (at the left end), else the vertex whose out-degree minus"},{"type":"text","text":" "},{"type":"text","text":"in-degree is largest (at the left end), with the least "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" offset on ties. Sinks and"},{"type":"text","text":" "},{"type":"text","text":"sources are removed in the order they became one, starting from "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."},{"type":"text","text":" "},{"type":"text","text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic"},{"type":"text","text":" "},{"type":"text","text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges"},{"type":"text","text":" "},{"type":"text","text":"leaves no directed cycle."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 47(6), 1993. The largest-difference vertices are kept in a"},{"type":"text","text":" "},{"type":"text","text":"binary heap so that ties go to the least offset."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O((n + m) log n) time, O(n + m) memory."}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L23"},"modules":[{"relatedModules":["GraphProtocols"],"name":"Cycles"}],"role":"symbol","roleHeading":"Instance Method","extendedModule":"GraphProtocols","title":"feedbackArcSet()","externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF"},"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Cycles/documentation/Cycles":{"kind":"symbol","role":"collection","abstract":[],"type":"topic","url":"\/documentation\/cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles","title":"Cycles"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"title":"Edges","abstract":[],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"title":"GraphProtocols","abstract":[],"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","url":"\/documentation\/cycles\/graphprotocols"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","abstract":[],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"title":"feedbackArcSet()","type":"topic","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum.","type":"text"},{"text":" ","type":"text"},{"text":"Every self-loop is in it: arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"}}}