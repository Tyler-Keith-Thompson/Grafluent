{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":"]"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward"},{"type":"text","text":" "},{"type":"text","text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the"},{"type":"text","text":" "},{"type":"text","text":"sequence), else a source (at the left end), else the vertex whose out-degree minus"},{"type":"text","text":" "},{"type":"text","text":"in-degree is largest (at the left end), with the least "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offset on ties. Sinks and"},{"type":"text","text":" "},{"type":"text","text":"sources are removed in the order they became one, starting from "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."},{"type":"text","text":" "},{"type":"text","text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic"},{"type":"text","text":" "},{"type":"text","text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges"},{"type":"text","text":" "},{"type":"text","text":"leaves no directed cycle."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 47(6), 1993. Linear time with bucket queues; this"},{"type":"text","text":" "},{"type":"text","text":"implementation keeps the largest-difference vertices in a binary heap so that ties go to"},{"type":"text","text":" "},{"type":"text","text":"the least offset: O((n + m) log n) time, O(n + m) memory. igraph breaks ties in its own"},{"type":"text","text":" "},{"type":"text","text":"bucket order, so on some graphs it returns another set of the same kind."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"]}],"metadata":{"title":"feedbackArcSet()","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L24","fileName":"FeedbackArcSet.swift"},"role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Cycles"}],"externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","symbolKind":"method","roleHeading":"Instance Method","extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","interfaceLanguage":"swift"},"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s ","type":"text"},{"code":"feedback_arc_set","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"method=\"eades\"","type":"codeVoice"},{"text":"). Every self-loop is in it, as in igraph:","type":"text"},{"text":" ","type":"text"},{"text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","kind":"symbol","role":"symbol","type":"topic","abstract":[],"title":"Edges","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"role":"collection","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","kind":"symbol","abstract":[],"url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","role":"symbol","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/directedgraph","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}]},"doc://Cycles/documentation/Cycles":{"role":"collection","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles","kind":"symbol","abstract":[],"url":"\/documentation\/cycles","title":"Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"title":"feedbackArcSet()","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s ","type":"text"},{"code":"feedback_arc_set","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"method=\"eades\"","type":"codeVoice"},{"text":"). Every self-loop is in it, as in igraph:","type":"text"},{"text":" ","type":"text"},{"text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}],"kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"}}}