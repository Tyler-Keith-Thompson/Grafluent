{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The heuristic orders the vertices in a sequence and reverses every edge that points"},{"type":"text","text":" "},{"type":"text","text":"leftward in it. It repeatedly removes a sink (placed at the right end of the sequence),"},{"type":"text","text":" "},{"type":"text","text":"else a source (at the left end), else the vertex whose out-degree minus in-degree is"},{"type":"text","text":" "},{"type":"text","text":"largest (at the left end), with the least "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offset on ties. Sinks and sources are"},{"type":"text","text":" "},{"type":"text","text":"removed in the order they became one, starting from "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored and never returned; parallel edges count once each. On an acyclic graph the result"},{"type":"text","text":" "},{"type":"text","text":"is empty, and for every graph, reversing the returned edges leaves no directed cycle"},{"type":"text","text":" "},{"type":"text","text":"other than self-loops."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 47(6), 1993. Linear time with bucket queues; this"},{"type":"text","text":" "},{"type":"text","text":"implementation keeps the largest-difference vertices in a binary heap so that ties go to"},{"type":"text","text":" "},{"type":"text","text":"the least offset: O((n + m) log n) time, O(n + m) memory."}]}]}],"metadata":{"externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","roleHeading":"Instance Method","remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L22"},"modules":[{"name":"Cycles","relatedModules":["GraphProtocols"]}],"role":"symbol","title":"feedbackArcSet()","extendedModule":"GraphProtocols","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"feedbackArcSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()"},"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic reverses to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":": a feedback arc set, small in practice but not minimum (igraph’s"},{"type":"text","text":" "},{"code":"feedback_arc_set","type":"codeVoice"},{"type":"text","text":" with "},{"code":"algo=\"eades\"","type":"codeVoice"},{"type":"text","text":")."}],"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Cycles/documentation/Cycles":{"role":"collection","type":"topic","kind":"symbol","title":"Cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles","abstract":[],"url":"\/documentation\/cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"role":"collection","type":"topic","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"url":"\/documentation\/cycles\/graphprotocols"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph","type":"topic","abstract":[],"kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"role":"symbol","type":"topic","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic reverses to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":": a feedback arc set, small in practice but not minimum (igraph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"feedback_arc_set"},{"type":"text","text":" with "},{"type":"codeVoice","code":"algo=\"eades\""},{"type":"text","text":")."}],"url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","title":"feedbackArcSet()"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","kind":"symbol","role":"symbol","title":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sl","kind":"typeIdentifier","text":"Collection"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" == "},{"preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV","kind":"typeIdentifier","text":"DirectedEdge"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols