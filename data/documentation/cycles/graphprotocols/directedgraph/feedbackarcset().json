{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"]}],"abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", ascending: a feedback arc set, small in practice but not minimum"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s "},{"type":"codeVoice","code":"feedback_arc_set"},{"type":"text","text":" with "},{"type":"codeVoice","code":"method=\"eades\""},{"type":"text","text":"). Every self-loop is in it, as in igraph:"},{"type":"text","text":" "},{"type":"text","text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2]."}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"extendedModule":"GraphProtocols","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"feedbackArcSet()","role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Cycles","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L24"}},"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward"},{"type":"text","text":" "},{"type":"text","text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the"},{"type":"text","text":" "},{"type":"text","text":"sequence), else a source (at the left end), else the vertex whose out-degree minus"},{"type":"text","text":" "},{"type":"text","text":"in-degree is largest (at the left end), with the least "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offset on ties. Sinks and"},{"type":"text","text":" "},{"type":"text","text":"sources are removed in the order they became one, starting from "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."},{"type":"text","text":" "},{"type":"text","text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic"},{"type":"text","text":" "},{"type":"text","text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges"},{"type":"text","text":" "},{"type":"text","text":"leaves no directed cycle."}]},{"type":"paragraph","inlineContent":[{"text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,","type":"text"},{"text":" ","type":"text"},{"text":"Information Processing Letters 47(6), 1993. Linear time with bucket queues; this","type":"text"},{"text":" ","type":"text"},{"text":"implementation keeps the largest-difference vertices in a binary heap so that ties go to","type":"text"},{"text":" ","type":"text"},{"text":"the least offset: O((n + m) log n) time, O(n + m) memory. igraph breaks ties in its own","type":"text"},{"text":" ","type":"text"},{"text":"bucket order, so on some graphs it returns another set of the same kind.","type":"text"}]}],"kind":"content"}],"references":{"doc://Cycles/documentation/Cycles/GraphProtocols":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","role":"collection","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"title":"Edges","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"abstract":[],"role":"symbol","kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"title":"DirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/directedgraph"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"abstract":[{"type":"text","text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,"},{"type":"text","text":" "},{"type":"text","text":"by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", ascending: a feedback arc set, small in practice but not minimum"},{"type":"text","text":" "},{"type":"text","text":"(igraph’s "},{"type":"codeVoice","code":"feedback_arc_set"},{"type":"text","text":" with "},{"type":"codeVoice","code":"method=\"eades\""},{"type":"text","text":"). Every self-loop is in it, as in igraph:"},{"type":"text","text":" "},{"type":"text","text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2]."}],"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"feedbackArcSet()","role":"symbol","type":"topic"},"doc://Cycles/documentation/Cycles":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles","url":"\/documentation\/cycles","title":"Cycles","role":"collection","type":"topic"}}}