{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()"]}],"abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", ascending: a feedback arc set, small in practice but not minimum","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s ","type":"text"},{"code":"feedback_arc_set","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"method=\"eades\"","type":"codeVoice"},{"text":"). Every self-loop is in it, as in igraph:","type":"text"},{"text":" ","type":"text"},{"text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph"]]},"sections":[],"identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Cycles","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]","kind":"text"}],"externalID":"s:14GraphProtocols08DirectedA0P6CyclesE14feedbackArcSetSay5Edges_5IndexQZGyF","symbolKind":"method","roleHeading":"Instance Method","remoteSource":{"fileName":"FeedbackArcSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/FeedbackArcSet.swift#L24"},"title":"feedbackArcSet()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The heuristic orders the vertices in a sequence and takes every edge that points leftward"},{"type":"text","text":" "},{"type":"text","text":"in it, and every self-loop. It repeatedly removes a sink (placed at the right end of the"},{"type":"text","text":" "},{"type":"text","text":"sequence), else a source (at the left end), else the vertex whose out-degree minus"},{"type":"text","text":" "},{"type":"text","text":"in-degree is largest (at the left end), with the least "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offset on ties. Sinks and"},{"type":"text","text":" "},{"type":"text","text":"sources are removed in the order they became one, starting from "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."},{"type":"text","text":" "},{"type":"text","text":"Self-loops do not count toward degrees; parallel edges count once each. On an acyclic"},{"type":"text","text":" "},{"type":"text","text":"graph the result is empty, and for every graph, removing (or reversing) the returned edges"},{"type":"text","text":" "},{"type":"text","text":"leaves no directed cycle."}],"type":"paragraph"},{"inlineContent":[{"text":"Eades, Lin and Smyth, “A fast and effective heuristic for the feedback arc set problem”,","type":"text"},{"text":" ","type":"text"},{"text":"Information Processing Letters 47(6), 1993. Linear time with bucket queues; this","type":"text"},{"text":" ","type":"text"},{"text":"implementation keeps the largest-difference vertices in a binary heap so that ties go to","type":"text"},{"text":" ","type":"text"},{"text":"the least offset: O((n + m) log n) time, O(n + m) memory. igraph breaks ties in its own","type":"text"},{"text":" ","type":"text"},{"text":"bucket order, so on some graphs it returns another set of the same kind.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Cycles/documentation/Cycles/GraphProtocols":{"kind":"symbol","title":"GraphProtocols","type":"topic","url":"\/documentation\/cycles\/graphprotocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"role":"collection"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph/feedbackArcSet()":{"url":"\/documentation\/cycles\/graphprotocols\/directedgraph\/feedbackarcset()","type":"topic","abstract":[{"text":"The edges that Eades, Lin and Smyth’s greedy heuristic removes to make the graph acyclic,","type":"text"},{"text":" ","type":"text"},{"text":"by position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", ascending: a feedback arc set, small in practice but not minimum","type":"text"},{"text":" ","type":"text"},{"text":"(igraph’s ","type":"text"},{"type":"codeVoice","code":"feedback_arc_set"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"method=\"eades\""},{"text":"). Every self-loop is in it, as in igraph:","type":"text"},{"text":" ","type":"text"},{"text":"arcs 0 → 0, 0 → 1, 1 → 0 give positions [0, 2].","type":"text"}],"kind":"symbol","title":"feedbackArcSet()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph\/feedbackArcSet()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"feedbackArcSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"abstract":[],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","role":"symbol","title":"Edges","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},"doc://Cycles/documentation/Cycles":{"role":"collection","abstract":[],"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles","url":"\/documentation\/cycles","kind":"symbol","title":"Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/DirectedGraph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","type":"topic","title":"DirectedGraph","url":"\/documentation\/cycles\/graphprotocols\/directedgraph","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/DirectedGraph","abstract":[],"role":"symbol"}}}