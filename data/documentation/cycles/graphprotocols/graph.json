ength 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"type":"text","text":" for the order."}],"role":"symbol","title":"simpleCycles(maxLength:)"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"kind":"symbol","abstract":[],"url":"\/documentation\/cycles\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","type":"topic","title":"Graph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle(from:)":{"kind":"symbol","type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle(from:)","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle(from:)","title":"findCycle(from:)","abstract":[{"type":"text","text":"A cycle reachable from "},{"type":"codeVoice","code":"roots"},{"type":"text","text":", searched from each in order (skipping roots already"},{"type":"text","text":" "},{"type":"text","text":"reached), or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when their components are acyclic. Otherwise as "},{"type":"codeVoice","code":"findCycle()"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"