url":"\/documentation\/cycles","title":"Cycles","role":"collection","type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","role":"collection","type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/simpleCycles(maxLength:)":{"type":"topic","abstract":[{"type":"text","text":"Every simple cycle of the graph once, lazily: no vertex and no edge twice, so a self-loop"},{"type":"text","text":" "},{"type":"text","text":"is a cycle of length 1, each pair of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"type":"text","text":" for the order."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simpleCycles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"UndirectedSimpleCycles","kind":"typeIdentifier","preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"simpleCycles(maxLength:)","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/simplecycles(maxlength:)"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"title":"cycleBasis()","abstract":[{"text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each","type":"text"},{"text":" ","type":"text"},{"text":"edge outside the forest, in ascending position of that edge, so ","type":"text"},{"code":"edgeCount - vertexCount + c","type":"codeVoice"},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","role":"symbol","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/isAcyclic":{"title":"isAcyclic","abstract":[{"type":"text","text":"Whether the graph has no cycle (is a forest). A self-loop is a cycle, and so is a pair of"},{"type":"text","text":" "},{"type":"text","text":"parallel edges. The empty graph is acyclic."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isAcyclic","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/isAcyclic","url":"\/documentation\/cycles\/graphprotocols\/graph\/isacyclic","role":"symbol","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","url":"\/documentation\/cycles\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"title":"Graph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"title":"findCycle()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"A cycle of the graph, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it is acyclic: the one closed by the first edge a"},{"type":"text","text":" "},{"type":"text","text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each vertex’s edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, and the search never"},{"type":"text","text":" "},{"type":"text","text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found."}],"role":"symbol","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/girth()":{"type":"topic","abstract":[{"text":"The length of a shortest cycle, in edges: 1 when there is a self-loop, 2 when there is a","type":"text"},{"text":" ","type":"text"},{"text":"pair of parallel edges; ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when the graph is acyclic.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"girth","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"girth()","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/girth()","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/girth()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"title":"Graph","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic"}}}