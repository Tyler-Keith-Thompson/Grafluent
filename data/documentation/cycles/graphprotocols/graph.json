xt"},{"text":" ","type":"text"},{"text":"edge outside the forest, in ascending position of that edge, so ","type":"text"},{"code":"edgeCount - vertexCount + c","type":"codeVoice"},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","abstract":[]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle(from:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":