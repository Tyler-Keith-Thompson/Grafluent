ext"},{"text":" ","type":"text"},{"text":"short cycles are broken by the rows’ order.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/minimumCycleBasis()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","title":"cycleBasis()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","role":"symbol","