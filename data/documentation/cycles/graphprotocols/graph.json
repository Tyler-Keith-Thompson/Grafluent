n\/Cycles\/GraphProtocols\/Graph\/findCycle(from:)","abstract":[{"type":"text","text":"A cycle reachable from "},{"code":"roots","type":"codeVoice"},{"type":"text","text":", searched from each in order (skipping roots already"},{"type":"text","text":" "},{"type":"text","text":"reached), or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when their components are acyclic. Otherwise as "},{"code":"findCycle()","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle(from:)","title":"findCycle(from:)","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/isAcyclic":{"type":"topic","kind":"symbol","title":"isAcyclic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isAcyclic","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","abstract":[{"text":"Whether the graph has no cycle (is a forest). A self-loop is a cycle, and so is a pair of","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges. The empty graph is acyclic.","type":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/isacyclic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/isAcyclic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"