","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Cycles/documentation/Cycles/GraphProtocols":{"role":"collection","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols"},"doc://Cycles/documentation/Cycles":{"role":"collection","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cycles","title":"Cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","type":"topic","abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"role":"symbol","kind":"symbol","url":