raph, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when it is acyclic: the one closed by the first edge a","type":"text"},{"text":" ","type":"text"},{"text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, each vertex’s edges in ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order, and the search never","type":"text"},{"text":" ","type":"text"},{"text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"role":"symbol","type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/cycles\/graphprotocols\/graph","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P