 of its two edges there; the"},{"type":"text","text":" "},{"type":"text","text":"cycles come in nondecreasing length, then by their edge positions. Ties between equally"},{"type":"text","text":" "},{"type":"text","text":"short cycles are broken by the rows’ order."}],"type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph\/minimumcyclebasis()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/minimumCycleBasis()"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/minimumCycleBasis(weight:)":{"type":"topic","kind":"symbol","title":"minimumCycleBasis(weight:)","url":"\/documentation\/cycles\/graphprotocols\/graph\/minimumcyclebasis(weight:)","role":"symbol","abstract":[{"type":"text","text":"A minimum-weight cycle basis (de Pina 1995): "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles, for c"},{"type":"text","text":" "},{"type":"text","text":"components, independent over GF(2) and spanning the cycle space, of the least total weight"},{"type":"text","text":" "},{"type":"text","text":"of any such basis. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order. Each cycle starts"},{"type":"text","text":" "},{"type":"text","text":"at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser of its two edges"},{"type":"text","text":" "},{"type":"text","text":"there; the cycles come in nondecreasing weight, then length, then by their edge positions."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumCycleBasis","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtoc