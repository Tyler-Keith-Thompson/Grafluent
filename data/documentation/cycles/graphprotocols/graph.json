pe":"text"},{"text":"none. Each starts at its least vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order and leaves it through the lesser","type":"text"},{"text":" ","type":"text"},{"text":"of its two edges there, so equal cycles have equal ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":"; see","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"text":" for the order.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simpleCycles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxLength"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V","kind":"typeIdentifier","text":"UndirectedSimpleCycles"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)","kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle(from:)":{"title":"findCycle(from:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"type":"topic","abstract":[{"type":"text","text":"A cycle reachable from "},{"type":"codeVoice","code":"roots"},{"type":"text","text":", searched from each in order (skipping roots already"},{"type":"text","text":" "},{"type":"text","text":"reached), or "},{"type":"codeVoice","code":"nil"},{"text":" when their components are acyclic. Otherwise as ","type":"text"},{"code":"findCycle()","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle(from:)","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle(from:)","role":"symbol","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"title":"GraphProtocols","type":"topic","abstract":[],"url":"\/documentation\/cycles\/graphprotocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","role":"collection","kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/girth()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/girth()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"girth","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"girth()","kind":"symbol","abstract":[{"type":"text","text":"The length of a shortest cycle, in edges: 1 when there is a self-loop, 2 when there is a"},{"type":"text","text":" "},{"type":"text","text":"pair of parallel edges; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is acyclic."}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/girth()","type":"topic","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","title":"findCycle()","abstract":[{"type":"text","text":"A cycle of the graph, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it is acyclic: the one closed by the first edge a"},{"type":"text","text":" "},{"type":"text","text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each vertex’s edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, and the search never"},{"type":"text","text":" "},{"type":"text","text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()","kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">]"}],"title":"cycleBasis()","kind":"symbol","abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","type":"topic","role":"symbol"},"doc://Cycles/documentation/Cycles":{"title":"Cycles","type":"topic","abstract":[],"identifier":"doc:\/\/Cycles\/documentation\/Cycles","url":"\/documentation\/cycles","role":"collection","kind":"symbol"},"doc://Cyc