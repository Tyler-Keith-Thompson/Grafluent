cles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"title":"cycleBasis()","abstract":[{"text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each","type":"text"},{"text":" ","type":"text"},{"text":"edge outside the forest, in ascending position of that edge, so ","type":"text"},{"code":"edgeCount - vertexCount + c","type":"codeVoice"},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">]","kind":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"title":"Graph","abstract":[],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"url":"\/documentation\/cycles\/graphprotocols\/graph"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/simpleCycles(maxLength:)":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Every simple cycle of the graph once, lazily: no vertex and no edge twice, so a self-loop"},{"type":"text","text":" "},{"type":"text","text":"is a cycle of length 1, each pair of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"type":"text","text":" for the order."}],"type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph\/simplecycles(maxlength:)","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)","title":"simpleCycles(maxLength:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simpleCycles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"UndirectedSimpleCycles","preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}}}