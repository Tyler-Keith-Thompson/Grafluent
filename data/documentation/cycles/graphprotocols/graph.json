les/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","title":"findCycle()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()","abstract":[{"type":"text","text":"A cycle of the graph, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it is acyclic: the one closed by the first edge a"},{"type":"text","text":" "},{"type":"text","text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each vertex’s edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, and the search never"},{"type":"text","text":" "},{"type":"text","text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"title":"cycleBasis()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","type":"topic","abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and edges in"},{"type":"text","text":" "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">]"}],"kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"abstract":[],"url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentat