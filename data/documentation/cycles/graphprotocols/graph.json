les/documentation/Cycles":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles","url":"\/documentation\/cycles","title":"Cycles","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()","role":"symbol","title":"findCycle()","kind":"symbol","abstract":[{"text":"A cycle of the graph, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when it is acyclic: the one closed by the first edge a","type":"text"},{"text":" ","type":"text"},{"text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, each vertex’s edges in ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order, and the search never","type":"text"},{"text":" ","type":"text"},{"text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found.","type":"text"}],"type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/isAcyclic":{"type":"topic","abstract":[{"type":"text","text":"Whether the graph has no cycle (is a forest). A self-loop is a cycle, and so is a pair of"},{"type":"text","text":" "},{"type":"text","text":"parallel edges. The empty graph is acyclic."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isAcyclic"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/isacyclic","kind":"symbol","title":"isAcyclic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/isAcyclic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/girth()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"girth"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/girth()","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/girth()","kind":"symbol","title":"girth()","abstract":[{"type":"text","text":"The length of a shortest cycle, in edges: 1 when there is a self-loop, 2 when there is a"},{"type":"text","text":" "},{"type":"text","text":"pair of parallel edges; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is acyclic."}],"role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","url":"\/documentation\/cycles\/graphprotocols","type":"topic","role":"collection","kind":"symbol","abstract":[]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/simpleCycles(maxLength:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simpleCycles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"UndirectedSimpleCycles","preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)","url":"\/documentation\/cycles\/graphprotocols\/graph\/simplecycles(maxlength:)","role":"symbol","title":"simpleCycles(maxLength:)","kind":"symbol","abstract":[{"type":"text","text":"Every simple cycle of the graph once, lazily: no vertex and no edge twice, so a self-loop"},{"type":"text","text":" "},{"type":"text","text":"is a cycle of length 1, each pair of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"type":"text","text":" for the order."}],"type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/cycles\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">]"}],"abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"title":"cycleBasis()","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","type":"topic","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle(from:)":{"type":"topic","abstract":[{"type":"text","text":"A cycle reachable from "},{"type":"codeVoice","code":"roots"},{"type":"text","text":", searched from each in order (skipping roots already"},{"type":"text","text":" "},{"type":"text","text":"reached), or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when their components are acyclic. Otherwise as "},{"type":"codeVoice","code":"findCycle()"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle(from:)","kind":"symbol","title":"findCycle(from:)","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle(from:)"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"type":"topic"}}}