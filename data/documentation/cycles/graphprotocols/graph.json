{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">]","kind":"text"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()","abstract":[{"type":"text","text":"A cycle of the graph, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when it is acyclic: the one closed by the first edge a"},{"type":"text","text":" "},{"type":"text","text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, each vertex’s edges in "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" order, and the search never"},{"type":"text","text":" "},{"type":"text","text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found."}],"type":"topic","title":"findCycle()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/girth()":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/girth()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"girth"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/girth()","type":"topic","title":"girth()","abstract":[{"text":"The length of a shortest cycle, in edges: 1 when there is a self-loop, 2 when there is a","type":"text"},{"text":" ","type":"text"},{"text":"pair of parallel edges; ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is acyclic.","type":"text"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"title":"Graph"},"doc://Cycles/documentation/Cycles":{"abstract":[],"url":"\/documentation\/cycles","title":"Cycles","kind":"symbol","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","title":"Graph","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/simpleCycles(maxLength:)":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/simplecycles(maxlength:)","title":"simpleCycles(maxLength:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simpleCycles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V","text":"UndirectedSimpleCycles"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Every simple cycle of the graph once, lazily: no vertex and no edge twice, so a self-loop"},{"type":"text","text":" "},{"type":"text","text":"is a cycle of length 1, each pair of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"type":"text","text":" for the order."}]},"doc://Cycles/documentation/Cycles/GraphProtocols":{"abstract":[],"url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","kind":"symbol","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","type":"topic"}}}