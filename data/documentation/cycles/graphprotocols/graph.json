e basis (de Pina 1995): "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles, for c"},{"type":"text","text":" "},{"type":"text","text":"components, independent over GF(2) and spanning the cycle space, of the least total weight"},{"type":"text","text":" "},{"type":"text","text":"of any such basis. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge, in position order. Each cycle starts"},{"type":"text","text":" "},{"type":"text","text":"at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser of its two edges"},{"type":"text","text":" "},{"type":"text","text":"there; the cycles come in nondecreasing weight, then length, then by their edge positions."}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/isAcyclic":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/isAcyclic","kind":"symbol","role":"symbol","title":"isAcyclic","type":"topic","abstract":[{"text":"Whether the graph has no cycle (is a forest). A self-loop is a cycle, and so is a pair of","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges. The empty graph is acyclic.","type":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/isacyclic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isAcyclic"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/minimumFeedbackVertexSet()":{"title":"minimumFeedbackVertexSet()","abstract":[{"type":"text","text":"A minimum feedback vertex set: the fewest vertices whose removal leaves a forest, in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. A vertex with a self-loop is in it, and one end of every pair of parallel"},{"type":"text","text":" "},{"type":"text","text":"edges. On a forest the result is empty. Among the minimum sets, the one that lists first"},{"type":"text","text":" "},{"type":"text","text":"by "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" offsets is returned."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/minimumFeedbackVertexSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumFeedbackVertexSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/minimumfeedbackvertexset()"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"title":"GraphProtocols","abstract":[],"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","url":"\/documentation\/cycles\/graphprotocols"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/chordlessCycles(maxLength:)":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/chordlessCycles(maxLength:)","kind":"symbol","role":"symbol","title":"chordlessCycles(maxLength:)","type":"topic","abstract":[{"type":"text","text":"Every chordless (induced) cycle of the graph once, lazily: a simple cycle whose vertices"},{"type":"text","text":" "},{"type":"text","text":"induce no edge but its own. Each starts at its least vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and leaves"},{"type":"text","text":" "},{"type":"text","text":"it through the lesser of its two edges there, as "},{"code":"simpleCycles()","type":"codeVoice"},{"type":"text","text":" lists it; see"},{"type":"text","text":" "},{"code":"UndirectedChordlessCycles","type":"codeVoice"},{"type":"text","text":" for the order, loops and parallel edges."}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/chordlesscycles(maxlength:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordlessCycles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"UndirectedChordlessCycles","preciseIdentifier":"s:6Cycles019UndirectedChordlessA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"url":"\/documentation\/graphprotocols\/graph"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/girth()":{"title":"girth()","abstract":[{"type":"text","text":"The length of a shortest cycle, in edges: 1 when there is a self-loop, 2 when there is a"},{"type":"text","text":" "},{"type":"text","text":"pair of parallel edges; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is acyclic."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/girth()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"girth"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"url":"\/documen