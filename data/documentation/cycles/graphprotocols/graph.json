},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","role":"symbol","title":"cycleBasis()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cycles\/graphprotocols","role":"collection","title":"GraphProtocols","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols"},"doc://Cycles/documentation/Cycles":{"role":"collection","title":"Cycles","kind":"symbol","url":"\/documentation\/cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles","abstract":[],"type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","ki