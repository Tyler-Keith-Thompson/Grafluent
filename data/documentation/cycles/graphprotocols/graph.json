","text":"Vertex","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"title":"findCycle(from:)"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/chordlessCycles(maxLength:)":{"abstract":[{"type":"text","text":"Every chordless (induced) cycle of the graph once, lazily: a simple cycle whose vertices"},{"type":"text","text":" "},{"type":"text","text":"induce no edge but its own. Each starts at its least vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and leaves"},{"type":"text","text":" "},{"type":"text","text":"it through the lesser of its two edges there, as "},{"code":"simpleCycles()","type":"codeVoice"},{"type":"text","text":" lists it; see"},{"type":"text","text":" "},{"code":"UndirectedChordlessCycles","type":"codeVoice"},{"type":"text","text":" for the order, loops and parallel edges."}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/chordlesscycles(maxlength:)","title":"chordlessCycles(maxLength:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/chordlessCycles(maxLength:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordlessCycles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxLength","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},