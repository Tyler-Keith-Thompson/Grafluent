 of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" and "},{"code":"edges","type":"codeVoice"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"code":"UndirectedSimpleCycles","type":"codeVoice"},{"type":"text","text":" for the order."}]}}}