 "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"type":"topic","role":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","kind":"symbol","abstract":[{"text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each","type":"text"},{"text":" ","type":"text"},{"text":"edge outside the forest, in ascending position of that edge, so ","type":"text"},{"code":"edgeCount - vertexCount + c","type":"codeVoice"},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">]"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","title":"cycleBasis()"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/chordlessCycles(maxLength:)":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/chordlesscycles(maxlength:)","abstract":[{"type":"text","text":"Every chordless (induced) cycle of the graph once, lazily: a simple cycle whose vertices"},{"type":"text","text":" "},{"type":"text","text":"induce no edge but its own. Each starts at its least vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and leaves"},{"type":"text","text":" "},{"type":"text","text":"it through the lesser of its two edges there, as "},{"code":"simpleCycles()","type":"codeVoice"},{"type":"text","text":" lists it; see"},{"type":"text","text":" "},{"code":"UndirectedChordlessCycles","type":"codeVoice"},{"type":"text","text":" for the order, loops and parallel edges."}],"title":"chordlessCycles(maxLength:)","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/chordlessCycles(maxLength:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordlessCycles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxLength","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Cycles019UndirectedChordlessA0V","text":"UndirectedChordlessCycles","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/simpleCycles(maxLength:)":{"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/simplecycles(maxlength:)","abstract":[{"type":"text","text":"Every simple cycle of the graph once, lazily: no vertex and no edge twice, so a self-loop"},{"type":"text","text":" "},{"type":"text","text":"is a cycle of length 1, each pair of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"type":"text","text":" for the order."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simpleCycles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"UndirectedSimpleCycles","preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)","title":"simpleCycles(maxLength:)"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"title":"GraphProtocols","role":"collection","url":"\/documentation\/cycles\/graphprotocols"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"abstract":[{"type":"text","text":"A cycle of the graph, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it is acyclic: the one closed by the first edge a"},{"type":"text","text":" "},{"type":"text","text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each vertex’s edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, and the search never"},{"type":"text","text":" "},{"type":"text","text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found."}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","title":"findCycle()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"kind":"symbol"},"doc://Cycles/documentation/Cycles":{"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/cycles","abstract":[],"identifier":"doc:\/\/Cycles\/documentation\/Cycles","title":"Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"kind":"symbol","abstract":[],"title":"Graph","url":"\/documentation\/cycles\/graphprotocols\/graph","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/minim