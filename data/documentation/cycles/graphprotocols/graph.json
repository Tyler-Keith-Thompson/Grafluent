les/documentation/Cycles/GraphProtocols/Graph/isAcyclic":{"role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isAcyclic","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether the graph has no cycle (is a forest). A self-loop is a cycle, and so is a pair of","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges. The empty graph is acyclic.","type":"text"}],"title":"isAcyclic","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/isacyclic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/isAcyclic"}}}