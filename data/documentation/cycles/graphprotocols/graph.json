-first search meets that leads back to a vertex on the search path. Roots are taken","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, each vertex’s edges in ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order, and the search never","type":"text"},{"text":" ","type":"text"},{"text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"title":"Graph","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","url":"\/documentation\/cycles\/graphprotocols\/graph","type":"topic","role":"symbol","abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle(from:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"title":"findCycle(from:)","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle(from:)","role":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle(from:)","abstract":[{"type":"text","text":"A cycle reachable from "},{"code":"roots","type":"codeVoice"},{"type":"text","text":", searched from each in order (skipping roots already"},{"type":"text","text":" "},{"type":"text","text":"reached), or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when their components are acyclic. Otherwise as "},{"code":"findCycle()","type":"codeVoice"},{"type":"text","text":"."}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/isAcyclic":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/isacyclic","title":"isAcyclic","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isAcyclic","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether the graph has no cycle (is a forest). A self-loop is a cycle, and so is a pair of"},{"type":"text","text":" "},{"type":"text","text":"parallel edges. The empty graph is acyclic."}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/isAcyclic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/simpleCycles(maxLength:)":{"kind":"symbol","title":"simpleCycles(maxLength:)","type":"topic","abstract":[{"type":"text","text":"Every simple cycle of the graph once, lazily: no vertex and no edge twice, so a self-loop"},{"type":"text","text":" "},{"type":"text","text":"is a cycle of length 1, each pair of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves it through the lesser"},{"type":"text","text":" "},{"type":"text","text":"of its two edges there, so equal cycles have equal "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedSimpleCycles"},{"type":"text","text":" for the order."}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"simpleCycles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxLength","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"UndirectedSimpleCycles","preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/simplecycles(maxlength:)"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","title":"cycleBasis()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">]"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","type":"topic","abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","kind":"symbol","role":"collection","type":"topic","abstract":[],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/chordlessCycles(maxLength:)":{"title":"chordlessCycles(maxLength:)","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/chordlessCycles(maxLength:)","url":"\/documentation\/cycles\/graphprotocols\/graph\/chordlesscycles(maxlength:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Every chordless (induced) cycle of the graph once, lazily: a simple cycle whose vertices"},{"type":"text","text":" "},{"type":"text","text":"induce no edge but its own. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and leaves"},{"type":"text","text":" "},{"type":"text","text":"it through the lesser of its two edges there, as "},{"type":"codeVoice","code":"simpleCycles()"},{"type":"text","text":" lists it; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedChordlessCycles"},{"type":"text","text":" for the order, loops and parallel edges."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordlessCycles","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxLength","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:6Cycles019UndirectedChordlessA0V","text":"UndirectedChordlessCycles","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cycles/documentation/Cycles":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles","role":"collection","abstract":[],"type":"topic","title":"Cycles","url":"\/documentation\/cycles","kind":"symbol"}}}