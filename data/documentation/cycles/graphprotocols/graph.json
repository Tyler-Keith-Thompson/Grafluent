,"title":"Graph","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","abstract":[{"text":"A cycle of the graph, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when it is acyclic: the one closed by the first edge a","type":"text"},{"text":" ","type":"text"},{"text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, each vertex’s edges in ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order, and the search never","type":"text"},{"text":" ","type":"text"},{"text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found.","type":"text"}],"kind":"symbol","type":"topic","title":"findCycle()","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/isAcyclic":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/isacyclic","title":"isAcyclic","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isAcyclic","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether the graph has no cycle (is a forest). A self-loop is a cycle, and so is a pair of","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges. The empty graph is acyclic.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/isAcyclic"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle(from:)":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle(from:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"role":"symbol","abstract":[{"text":"A cycle reachable from ","type":"text"},{"code":"roots","type":"codeVoice"},{"text":", searched from each in order (skipping roots already","type":"text"},{"text":" ","type":"text"},{"text":"reached), or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when their components are acyclic. Otherwise as ","type":"text"},{"code":"findCycle()","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","title":"findCycle(from:)","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle(from:)"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/simpleCycles(maxLength:)":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/simplecycles(maxlength:)","title":"simpleCycles(maxLength:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"simpleCycles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Cycles016UndirectedSimpleA0V","text":"UndirectedSimpleCycles"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"Every simple cycle of the graph once, lazily: no vertex and no edge twice, so a self-loop"},{"type":"text","text":" "},{"type":"text","text":"is a cycle of length 1, each pair of parallel edges one of length 2, and a single edge"},{"type":"text","text":" "},{"type":"text","text":"none. Each starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"text":" order and leaves it through the lesser","type":"text"},{"text":" ","type":"text"},{"text":"of its two edges there, so equal cycles have equal ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":"; see","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedSimpleCycles","type":"codeVoice"},{"text":" for the order.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/simpleCycles(maxLength:)"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/chordlessCycles(maxLength:)":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/chordlessCycles(maxLength:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordlessCycles"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Cycles019UndirectedChordlessA0V","text":"UndirectedChordlessCycles"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","abstract":[{"type":"text","text":"Every chordless (induced) cycle of the graph once, lazily: a simple cycle whose vertices"},{"type":"text","text":" "},{"type":"text","text":"induce no edge but its own. Each starts at its least vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and leaves"},{"type":"text","text":" "},{"type":"text","text":"it through the lesser of its two edges there, as "},{"type":"codeVoice","code":"simpleCycles()"},{"type":"text","text":" lists it; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedChordlessCycles"},{"type":"text","text":" for the order, loops and parallel edges."}],"kind":"symbol","type":"topic","title":"chordlessCycles(maxLength:)","url":"\/documentation\/cycles\/graphprotocols\/graph\/chordlesscycles(maxlength:)"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","title":"cycleBasis()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">]"}],"abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"code":"edgeCount - vertexCount + c","type":"codeVoice"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"code":"vertices","type":"codeVoice"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()"}}}