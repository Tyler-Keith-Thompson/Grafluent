{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directed"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"type":"topic","url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"title":"Graph","kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"title":"findCycle()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">?"}],"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle()","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","abstract":[{"type":"text",