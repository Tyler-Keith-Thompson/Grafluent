ndCycle()"},{"type":"text","text":"."}],"title":"findCycle(from:)","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/findCycle(from:)","url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle(from:)"},"doc://Cycles/documentation/Cycles":{"kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/cycles","role":"collection","title":"Cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findCycle"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"abstract":[{"type":"text","text":"A cycle of the graph, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when it is acyclic: the one closed by the first edge a"},{"type":"text","text":" "},{"type":"text","text":"depth-first search meets that leads back to a vertex on the search path. Roots are taken"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each vertex’s edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, and the search never"},{"type":"text","text":" "},{"type":"text","text":"goes back along the edge it arrived by, so a self-loop or a parallel pair is found."}],"