eVoice","code":"vertices"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directedView","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"type":"topic","title":"Graph","role":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}]},"doc://Cycles/documentation/Cycles":{"url":"\/documentation\/cycles","title":"Cycles","type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/Cycles\/documentation\/Cycles","role":"collection"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/findCycle()":{"url":"\/documentation\/cycles\/graphprotocols\/graph\/findcycle()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findCycle","kind":"identifier"},{"text":"() -> ","kind":"text"