{"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()"]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"t