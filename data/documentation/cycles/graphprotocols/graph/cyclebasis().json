em (mod 2). Each starts at its","type":"text"},{"text":" ","type":"text"},{"text":"least vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and leaves it through the lesser of its two edges there.","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m) plus the total length of the cycles.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","type":"topic","title":"Edges","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"url":"\/documentation\/cycles\/graphprotocols\/graph","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","abstract":[],"kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBas