ycleBasisSay5Walks5CycleVy6VertexQz5Edges_5IndexQZGGyF","roleHeading":"Instance Method","remoteSource":{"fileName":"UndirectedCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cycles\/UndirectedCycles.swift#L72"},"title":"cycleBasis()","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Cycles"}]},"references":{"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/cycles\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">]"}],"abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"title":"cycleBasis()","kind":"symbol","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","type":"topic","role":"symbol"},"doc://Cycles/documentation/Cycles":{"identifier":"doc:\/\/Cycles\/documentation\/Cycles","url":"\/documentation\/cycles","title":"Cycles","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://Walks/documentation/Walks/Cycle":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cycle"}],"url":"\/documentation\/walks\/cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Cycle"}],"title":"Cycle","abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"kind":"symbol","type":"topic"},"doc://Cycles/documentation/Cycles/GraphProtocols":