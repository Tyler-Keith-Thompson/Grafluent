{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Cycles\/documentation\/Cycles","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleBasis"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":">]"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Every cycle in the basis has exactly one edge outside the forest, so the cycles are"},{"type":"text","text":" "},{"type":"text","text":"independent, and every cycle of the graph is a sum of them (mod 2). Each starts at its"},{"type":"text","text":" "},{"type":"text","text":"least vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and leaves it through the lesser of its two edges there."},{"type":"text","text":" "},{"type":"text","text":"O(n + m) plus the total length of the cycles."}],"type":"paragraph"}]}],"abstract":[{"text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each","type":"text"},{"text":" ","type":"text"},{"text":"edge outside the forest, in ascending position of that edge, so ","type":"text"},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"metadata":{"externalID":"s:14GraphProtocols0A0P6CyclesE10cycleBasisSay5Walks5CycleVy6VertexQz5Edges_5IndexQZGGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">]","kind":"text"}],