s and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"title":"cycleBasis()"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"title":"GraphProtocols","type":"topic","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"url":"\/documentation\/cycles\/graphprotocols","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","title":"Edges","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","kind":"symbol","role":"symbol"},"doc://Cycles/documentation/Cycles":{"role":"collection","type":"topic","url":"\/documentation\/cycles","identifier":"doc:\/\/Cycles\/documentation\/Cycles","kind":"symbol","abstract":[],"title":"Cycles"},"doc://Walks/documentation/Walks/Cycle":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"abstract":[{"type":"text","text":"A cycle: a closed path, at least one edge long, listed without repeating its start (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"simple_cycles"},{"type":"text","text":", petgraph). Vertex i goes to vertex (i + 1) mod "},{"type":"codeVoice","code":"count"},{"type":"text","text":" through edge i, and no"},{"type":"text","text":" "},{"type":"text","text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges"},{"type":"text","text":" "},{"type":"text","text":"one of length 2. It is the witness cycle detection returns."}],"url":"\/documentation\/walks\/cycle","title":"Cycle","navigatorTitle":[{"text":"Cycle","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"title":"Graph","type":"topic","role":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","abstract":[],"url":"\/documentation\/cycles\/graphprotocols\/graph","kind":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}]}}}