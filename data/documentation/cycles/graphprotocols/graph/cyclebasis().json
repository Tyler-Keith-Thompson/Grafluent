 goes to vertex (i + 1) mod "},{"code":"count","type":"codeVoice"},{"type":"text","text":" through edge i, and no"},{"text":" ","type":"text"},{"text":"vertex or edge position appears twice; a self-loop is a cycle of length 1, two parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"one of length 2. It is the witness cycle detection returns.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Cycle","kind":"identifier"}],"type":"topic","url":"\/documentation\/walks\/cycle","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","role":"symbol","title":"Cycle","navigatorTitle":[{"text":"Cycle","kind":"identifier"}]},"doc://Cycles/documentation/Cycles":{"url":"\/documentation\/cycles","abstract":[],"role":"collection","title":"Cycles","type":"topic","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph":{"url":"\/documentation\/cycles\/graphprotocols\/graph","abstract":[],"role":"symbol","type":"topic","title":"Graph","kind":"symbol","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}]},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"type":"topic","abstract":[{"type":"text","text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each"},{"type":"text","text":" "},{"type":"text","text":"edge outside the forest, in ascending position of that edge, so "},{"type":"codeVoice","code":"edgeCount - vertexCount + c"},{"type":"text","text":" cycles for c components. Roots are taken in "},{"type":"codeVoice","code":"vertices"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Cycle","kind":"typeIdentifier","preciseIdentifier":"s:5Walks5CycleV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">]","kind":"text"}],"url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()","kind":"symbol","role":"symbol","title":"cycleBasis()"}}}