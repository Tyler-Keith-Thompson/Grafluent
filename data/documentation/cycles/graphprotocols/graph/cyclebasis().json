":"text","text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge"},{"type":"text","text":" "},{"type":"text","text":"closes a cycle of length 2."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Cycles/documentation/Cycles":{"kind":"symbol","title":"Cycles","url":"\/documentation\/cycles","role":"collection","abstract":[],"type":"topic","identifier":"doc:\/\/Cycles\/documentation\/Cycles"},"doc://Cycles/documentation/Cycles/GraphProtocols":{"url":"\/documentation\/cycles\/graphprotocols","title":"GraphProtocols","type":"topic","role":"collection","identifier":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols","abstract":[],"kind":"symbol"},"doc://Cycles/documentation/Cycles/GraphProtocols/Graph/cycleBasis()":{"kind":"symbol","title":"cycleBasis()","url":"\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()","role":"symbol","abstract":[{"text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each","type":"text"},{"text":" ","type":"text"},{"text":"edge outside the forest, in ascending position of that edge, so ","type":"text"},{"code":"edgeCount - vertexCount + c","type":"codeVoice"},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and edges in","type":"text"