{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/cycles\/graphprotocols\/graph\/cyclebasis()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A cycle basis: the fundamental cycles of the breadth-first spanning forest, one for each","type":"text"},{"text":" ","type":"text"},{"text":"edge outside the forest, in ascending position of that edge, so ","type":"text"},{"code":"edgeCount - vertexCount + c","type":"codeVoice"},{"text":" cycles for c components. Roots are taken in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and edges in","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order; a vertex’s tree edge is the one that discovered it. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges are supported: a loop is a cycle of its own, and a second copy of an edge","type":"text"},{"text":" ","type":"text"},{"text":"closes a cycle of length 2.","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cycles\/documentation\/Cycles\/GraphProtocols\/Graph\/cycleBasis()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","identifier":"doc:\/\/Walks\/documentation\/Walks\/Cycle","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Every cycle in the basis has exactly one edge outside the forest, so the cycles are","type":"text"},{"text":" ","type":"text"},{"text":"independent, and every cycle of the graph is a sum of them (mod 2). Each starts at its","type":"text"},{"text":" ","type":"text"},{"text":"least vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order and leaves it through the lesser of its two edges there.","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m) plus the total length of the cycles.","type":"text"}],"type":"paragraph"}]}],"sections":[],"metadata":{"roleHeading":"Instance Method","role":"symbol","externalID":"s:14GraphProtocols0A0P6CyclesE10cycleBasisSay5Walks5CycleVy6VertexQz5Edges_5IndexQZGGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleBasis","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:5Walks5CycleV","text":"Cycle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"remoteSource":{"fileName":"UndirectedCycles.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cy