/Graph","type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph":{"kind":"symbol","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph","url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://IsomorphismModule/documentation/IsomorphismModule/Isomorphisms":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Isomorphisms","kind":"identifier"}],"title":"Isomorphisms","navigatorTitle":[{"text":"Isomorphisms","kind":"identifier"}],"url":"\/documentation\/isomorphismmodule\/isomorphisms","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphisms","abstract":[{"type":"text","text":"Every mapping of one problem (isomorphism, subgraph isomorphism or monomorphism), found lazily:"},{"type":"text","text":" "},{"type":"text","text":"each iterator runs the search and stops at each mapping. Iterating twice runs the search twice"},{"type":"text","text":" "},{"type":"text","text":"and gives the same mappings in the same order. Colours were read when the sequence was made."}],"role":"symbol"}}}