{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph\/automorphismGroup()"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automorphismGroup","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV","text":"AutomorphismGroup","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Found by individualization–refinement with automorphism pruning (McKay & Piperno 2014;"},{"type":"text","text":" "},{"type":"text","text":"Junttila & Kaski 2007): the search tree of one graph, each later leaf compared with the"},{"type":"text","text":" "},{"type":"text","text":"first, the branches an automorphism found so far maps onto a searched one skipped. Runs to"},{"type":"text","text":" "},{"type":"text","text":"completion (it does not check for task cancellation). Exponential in the worst case (as"},{"type":"text","text":" "},{"type":"text","text":"nauty and bliss); near-linear refinement per search node, and on most graphs a few nodes per"},{"type":"text","text":" "},{"type":"text","text":"base vertex."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/isomorphismmodule\/graphprotocols\/graph\/automo