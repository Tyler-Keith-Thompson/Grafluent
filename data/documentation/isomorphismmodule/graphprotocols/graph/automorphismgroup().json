{"identifier":{"url":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph\/automorphismGroup()","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"IsomorphismModule","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IsomorphismModule\/AutomorphismGroup.swift#L261","fileName":"AutomorphismGroup.swift"},"symbolKind":"method","role":"symbol","title":"automorphismGroup()","externalID":"s:14GraphProtocols0A0P17IsomorphismModuleE17automorphismGroupAD012AutomorphismF0VyxGyF","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"automorphismGroup"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AutomorphismGroup","preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/isomorphismmodule\/graphprotocols\/graph\/automorphismgroup()"]}],"hierarchy":{"paths":[["doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph"]]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"automorphismGroup"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV","kind":"typeIdentifier","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","text":"AutomorphismGroup"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Se