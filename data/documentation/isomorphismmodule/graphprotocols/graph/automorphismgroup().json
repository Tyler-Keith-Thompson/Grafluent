xt":" ","type":"text"},{"text":"between every pair of vertices (self-loops included), with generators, orbits and order.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"automorphismGroup"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV","text":"AutomorphismGroup"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://IsomorphismModule/documentation/IsomorphismModule/AutomorphismGroup":{"type":"topic","abstract":[{"type":"text","text":"The automorphism group of a graph, as returned by "},{"type":"codeVoice","code":"automorphismGroup()"},{"type":"text","text":": the permutations of"},{"type":"text","text":" "},{"type":"text","text":"its vertices that keep every edge multiplicity (and the colours, when given), described by"},{"type":"text","text":" "},{"type":"text","text":"generators, by the orbits they cut the vertices into, and by its order."}],"role":"symbol","url":"\/documentation\/isomorphismmodule\/automorphismgroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutomorphismGroup","kind":"identifier"}],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","navigatorTitle":[{"text":"AutomorphismGroup","kind":"identifier"}],"title":"AutomorphismGroup","kind":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"kind":"symbol","url":"\/documentation\/isomorphismmodule","title":"IsomorphismModule","role":"collection","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","abstract":[]},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph":{"kind":"symbol","url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph","title":"Graph","role":"symbol","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/Isom