:">"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Found by individualization–refinement with automorphism pruning (McKay & Piperno 2014;"},{"type":"text","text":" "},{"type":"text","text":"Junttila & Kaski 2007): the search tree of one graph, each later leaf compared with the"},{"type":"text","text":" "},{"type":"text","text":"first, the branches an automorphism found so far maps onto a searched one skipped. Runs to"},{"type":"text","text":" "},{"type":"text","text":"completion (it does not check for task cancellation). Exponential in the worst case;"},{"type":"text","text":" "},{"type":"text","text":"near-linear refinement per search node, and on most graphs a few nodes per base vertex."}]}],"kind":"content"}],"abstract":[{"text":"The automorphism group: the permutations of the vertices that keep the number of edges","type":"text"},{"text":" ","type":"text"},{"text":"between every pair of vertices (self-loops included), with generators, orbits and order.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://IsomorphismModule/documentation/IsomorphismModule/AutomorphismGroup":{"kind":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AutomorphismGroup"}],"title":"AutomorphismGroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutomorphismGroup"}],"type":"topic","abstract":[{"type":"text","text":"The automorphism group of a graph, as returned by "},{"type":"codeVoice","code":"automorphismGroup()"},{"type":"text","text":": the permutations of"},{"type":"text","text":" "},{"type":"text","text":"its vertices that keep every edge multiplicity (and the colours, when given), described by"},{"type":"text","text":" "},{"type":"text","text":"generators, by the orbits they cut the vertices into, and by its order."}],"url":"\/documentation\/isomorphismmodule\/automorphismgroup"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph":{"kind":"symbol","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph","abstract":[],"type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"abstract":[],"title":"IsomorphismModule","role":"collection","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","url":"\/documentation\/isomorphismmodule","kind":"symbol","type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"abstract":[],"title":"GraphProtocols","role":"collection","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","url":"\/documentation\/isomorphismmodule\/graphprotocols","kind":"symbol","type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph/automorphismGroup()":{"url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph\/automorphismgroup()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automorphismGroup","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AutomorphismGroup","preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"automorphismGroup()","abstract":[{"text":"The automorphism group: the permutations of the vertices that keep the number of edges","type":"text"},{"text":" ","type":"text"},{"text":"bet