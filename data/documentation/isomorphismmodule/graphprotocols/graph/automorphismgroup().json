{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/isomorphismmodule\/graphprotocols\/graph\/automorphismgroup()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"automorphismGroup"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AutomorphismGroup","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Found by individualization–refinement with automorphism pruning (McKay & Piperno 2014;"},{"type":"text","text":" "},{"type":"text","text":"Junttila & Kaski 2007): the search tree of one graph, each later leaf compared with the"},{"type":"text","text":" "},{"type":"text","text":"first, the branches an automorphism found so far maps onto a searched one skipped. Runs to"},{"type":"text","text":" "},{"type":"text","text":"completion (it does not check for task cancellation). Exponential in the worst case (as"},{"type":"text","text":" "},{"type":"text","text":"nauty and bliss); near-linear refinement per search node, and on most graphs a few nodes per"},{"type":"text","text":" "},{"type":"text","text":"base vertex."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph"]]},"metadata":{"extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"IsomorphismModule"}],"role":"symbol","title":"automorphismGroup()","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P17IsomorphismModuleE17automorphismGroupAD012AutomorphismF0VyxGyF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"automorphismGroup"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AutomorphismGroup","preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"remoteSource":{"fileName":"AutomorphismGroup.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/IsomorphismModule\/AutomorphismGroup.swift#L261"}},"kind":"symbol","identifier":{"url":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph\/automorphismGroup()","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"The automorphism group: the permutations of the vertices that keep the number of edges"},{"type":"text","text":" "},{"type":"text","text":"between every pair of vertices (self-loops included), with generators, orbits and order."}],"references":{"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"title":"GraphProtocols","kind":"symbol","url":"\/documentation\/isomorphismmodule\/graphprotocols","abstract":[],"type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","role":"collection"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"title":"IsomorphismModule","kind":"symbol","url":"\/documentation\/isomorphismmodule","abstract":[],"type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","role":"collection"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph/automorphismGroup()":{"url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph\/automorphismgroup()","abstract":[{"type":"text","text":"The automorphism group: the permutations of the vertices that keep the number of edges"},{"type":"text","text":" "},{"type":"text","text":"between every pair of vertices (self-loops included), with generators, orbits and order."}],"title":"automorphismGroup()","kind":"symbol","role":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph\/automorphismGroup()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"automorphismGroup"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17IsomorphismModule17AutomorphismGroupV","text":"AutomorphismGroup"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph":{"title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph","abstract":[],"type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule/AutomorphismGroup":{"title":"AutomorphismGroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutomorphismGroup","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/isomorphismmodule\/automorphismgroup","abstract":[{"type":"text","text":"The automorphism group of a graph, as returned by "},{"type":"codeVoice","code":"automorphismGroup()"},{"type":"text","text":": the permutations of"},{"type":"text","text":" "},{"type":"text","text":"its vertices that keep every edge multiplicity (and the colours, when