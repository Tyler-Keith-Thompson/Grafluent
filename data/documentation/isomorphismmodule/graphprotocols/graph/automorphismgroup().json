text","text":"Found by individualization–refinement with automorphism pruning (McKay & Piperno 2014;"},{"type":"text","text":" "},{"type":"text","text":"Junttila & Kaski 2007): the search tree of one graph, each later leaf compared with the"},{"type":"text","text":" "},{"type":"text","text":"first, the branches an automorphism found so far maps onto a searched one skipped. Runs to"},{"type":"text","text":" "},{"type":"text","text":"completion (it does not check for task cancellation). Exponential in the worst case (as"},{"type":"text","text":" "},{"type":"text","text":"nauty and bliss); near-linear refinement per search node, and on most graphs a few nodes per"},{"type":"text","text":" "},{"type":"text","text":"base vertex."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/isomorphismmodule\/graphprotocols\/graph\/automorphismgroup()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"The automorphism group: the permutations of the vertices that keep the number of edges","type":"text"},{"text":" ","type":"text"},{"text":"between every pair of vertices (self-loops included), with generators, orbits and order.","type":"text"}],"references":{"doc://IsomorphismModule/documentation/IsomorphismModule":{"title":"IsomorphismModule","role":"collection","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","abstract":[],"kind":"symbol","url":"\/documentation\/isomorphismmodule","type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","role":"symbol","title":"Graph","url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"ide