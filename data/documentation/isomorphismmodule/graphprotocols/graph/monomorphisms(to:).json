{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph\/monomorphisms(to:)"},"abstract":[{"type":"text","text":"Every one of the monomorphisms from this graph (the pattern) into "},{"code":"other","type":"codeVoice"},{"type":"text","text":": injections onto a subgraph, not necessarily induced; between every ordered pair of pattern vertices the target has at least as many edges as the pattern (self-loops included), as a lazy sequence; the empty graph has one, the empty mapping."},{"type":"text","text":" "},{"type":"text","text":"Each mapping reads from this graph to "},{"code":"other","type":"codeVoice"},{"type":"text","text":": "},{"code":"images","type":"codeVoice"},{"type":"text","text":" lists the image of each vertex in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. The order of the sequence is fixed for given inputs but not specified."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"monomorphisms"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Other"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"other"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:17IsomorphismModule12IsomorphismsV","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphisms","kind":"typeIdentifier","text":"Isomorphisms"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Other"},