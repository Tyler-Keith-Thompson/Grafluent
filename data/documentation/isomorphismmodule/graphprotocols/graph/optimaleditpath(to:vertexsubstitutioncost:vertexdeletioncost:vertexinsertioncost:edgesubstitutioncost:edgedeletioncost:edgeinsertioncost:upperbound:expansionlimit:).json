ociatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":", "},{"kind":"externalParam","text":"upperBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"expansionLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/EditPath","preciseIdentifier":"s:17IsomorphismModule8EditPathV","text":"EditPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s13SignedNumericP","text":"SignedNumeric"}],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The graph to reach."}],"type":"paragraph"}],"name":"other"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of substituting a vertex of this graph by one of"},{"type":"text","text":" "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}]}],"name":"vertexSubstitutionCost"},{"content":[{"inlineContent":[{"text":"The cost of deleting a vertex of this graph.","type":"text"}],"type":"paragraph"}],"name":"vertexDeletionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of inserting a vertex of "},{"code":"other","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"vertexInsertionCost"},{"content":[{"inlineContent":[{"text":"The cost of substituting an edge of this graph by one of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"by position.","type":"text"}],"type":"paragraph"}],"name":"edgeSubstitutionCost"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The cost of deleting an edge of this graph.","type":"text"}]}],"name":"edgeDeletionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of inserting an edge of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}]}],"name":"edgeInsertionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When set, only paths costing at most this are considered."}]}],"name":"upperBound"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When set, the search expands at most this many nodes and returns the"},{"type":"text","text":" "},{"type":"text","text":"cheapest path found, with "},{"type":"codeVoice","code":"isOptimal"},{"type":"text","text":" false when it stopped early."}]}],"name":"expansionLimit"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The path, or nil when every path costs more than ","type":"text"},{"type":"codeVoice","code":"upperBound"},{"text":".","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"An edit path substitutes each vertex of this graph by a distinct vertex of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deletes it, and inserts the rest of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":"‘s vertices; the edges between two vertices (or","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or","type":"text"},{"text":" ","type":"text"},{"text":"deleted, and ","type":"text"},{"type":"codeVoice","code":"other"},{"text":"’s remaining edges inserted. Parallel edges are matched as a group at","type":"text"},{"text":" ","type":"text"},{"text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)","type":"text"},{"text":" ","type":"text"},{"text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit","type":"text"},{"text":" ","type":"text"},{"text":"assignment of the undecided vertices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call"},{"type":"text","text":" "},{"type":"text","text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an"},{"type":"text","text":" "},{"type":"text","text":"insertion; the path then takes the cheaper."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Every cost is finite and not negative; twice the sum of all costs fits in","type":"text"},{"text":" ","type":"text"},{"code":"Cost","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"expansionLimit","type":"codeVoice"},{"text":" is not negative.","type":"text"}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exponential in the worst case (the problem is NP-hard); each node costs"},{"type":"text","text":" "},{"type":"text","text":"O((n + n′)³ + n · n′ · n) for its lower bound."}]}],"style":"note","name":"Complexity"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"type":"topic","title":"Graph"},"doc://IsomorphismModule/documentation/IsomorphismModule/EditPath":{"abstract":[{"type":"text","text":"An edit path from one graph to another, as returned by "},{"code":"optimalEditPath(to:)","type":"codeVoice"},{"type":"text","text":": each vertex and"},{"type":"text","text":" "},{"type":"text","text":"edge of this graph (the pattern) is substituted by one of "},{"code":"other","type":"codeVoice"},{"type":"text","text":" (the target) or deleted, and"},{"type":"text","text":" "},{"type":"text","text":"every vertex and edge of the target that is no substitute is inserted."}],"kind":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/EditPath","url":"\/documentation\/isomorphismmodule\/editpath","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EditPath"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditPath"}],"type":"topic","title":"EditPath"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph/optimalEditPath(to:vertexSubstitutionCost:vertexDeletionCost:vertexInsertionCost:edgeSubstitutionCost:edgeDeletionCost:edgeInsertionCost:upper