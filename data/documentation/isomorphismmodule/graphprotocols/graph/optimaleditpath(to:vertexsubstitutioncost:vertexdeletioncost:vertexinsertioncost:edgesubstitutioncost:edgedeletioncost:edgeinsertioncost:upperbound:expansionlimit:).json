{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Graph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"},{"text":", ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"},{"text":", ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedNumeric","kind":"typeIdentifier","preciseIdentifier":"s:s13SignedNumericP"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The graph to reach.","type":"text"}],"type":"paragraph"}],"name":"other"},{"content":[{"inlineContent":[{"type":"text","text":"The cost of substituting a vertex of this graph by one of"},{"type":"text","text":" "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"vertexSubstitutionCost"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The cost of deleting a vertex of this graph.","type":"text"}]}],"name":"vertexDeletionCost"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The cost of inserting a vertex of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":".","type":"text"}]}],"name":"vertexInsertionCost"},{"content":[{"inlineContent":[{"type":"text","text":"The cost of substituting an edge of this graph by one of "},{"type":"codeVoice","code":"other"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"by position."}],"type":"paragraph"}],"name":"edgeSubstitutionCost"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The cost of deleting an edge of this graph.","type":"text"}]}],"name":"edgeDeletionCost"},{"content":[{"inlineContent":[{"text":"The cost of inserting an edge of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"edgeInsertionCost"},{"content":[{"inlineContent":[{"type":"text","text":"When set, only paths costing at most this are considered."}],"type":"paragraph"}],"name":"upperBound"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When set, the search expands at most this many nodes and returns the"},{"type":"text","text":" "},{"type":"text","text":"cheapest path found, with "},{"type":"codeVoice","code":"isOptimal"},{"type":"text","text":" false when it stopped early."}]}],"name":"expansionLimit"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The path, or nil when every path costs more than "},{"code":"upperBound","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"An edit path substitutes each vertex of this graph by a distinct vertex of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deletes it, and inserts the rest of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"‘s vertices; the edges between two vertices (or","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or","type":"text"},{"text":" ","type":"text"},{"text":"deleted, and ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"’s remaining edges inserted. Parallel edges are matched as a group at","type":"text"},{"text":" ","type":"text"},{"text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)","type":"text"},{"text":" ","type":"text"},{"text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit","type":"text"},{"text":" ","type":"text"},{"text":"assignment of the undecided vertices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call"},{"type":"text","text":" "},{"type":"text","text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an"},{"type":"text","text":" "},{"type":"text","text":"insertion; the path then takes the cheaper."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every cost is finite and not negative; twice the sum of all costs fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":"; "},{"type":"codeVoice","code":"expansionLimit"},{"type":"text","text":" is not negative."}]}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exponential in the worst case (the problem is NP-hard); each node costs"},{"type":"text","text":" "},{"type":"text","text":"O((n + n′)³ + n · n′ · n) for its lower bound."}]}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"abstract":[{"type":"text","text":"A least-cost edit path from this graph to "},{"type":"codeVoice","code":"other"},{"type":"text","text":", each vertex and edge substituted,"},{"type":"text","text":" "},{"type":"text","text":"deleted or inserted at the given costs; the graph edit distance is its "},{"type":"codeVoice","code":"cost"},{"type":"text","text":"."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/isomorphismmodule\/graphprotocols\/graph\/optimaleditpath(to:vertexsubstitutioncost:vertexdeletioncost:vertexinsertioncost:edgesubstitutioncost:edgedeletioncost:edgeinsertioncost:upperbound:expansionlimit:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","doc:\/\/Isomorphism