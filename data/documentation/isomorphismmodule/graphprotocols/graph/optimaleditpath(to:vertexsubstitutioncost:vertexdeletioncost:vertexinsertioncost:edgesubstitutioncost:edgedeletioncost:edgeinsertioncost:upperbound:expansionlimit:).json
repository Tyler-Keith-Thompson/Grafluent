raph","inlineContent":[{"text":"An edit path substitutes each vertex of this graph by a distinct vertex of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deletes it, and inserts the rest of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"‘s vertices; the edges between two vertices (or","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or","type":"text"},{"text":" ","type":"text"},{"text":"deleted, and ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"’s remaining edges inserted. Parallel edges are matched as a group at","type":"text"},{"text":" ","type":"text"},{"text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)","type":"text"},{"text":" ","type":"text"},{"text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit","type":"text"},{"text":" ","type":"text"},{"text":"assignment of the undecided vertices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call","type":"text"},{"text":" ","type":"text"},{"text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an","type":"text"},{"text":" ","type":"text"},{"text":"insertion; the path then takes the cheaper.","type":"text"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Every cost is finite and not negative; twice the sum of all costs fits in","type":"text"},{"text":" ","type":"text"},{"code":"Cost","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"expansionLimit","type":"codeVoice"},{"text":" is not negative.","type":"text"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"Exponential in the worst case (the problem is NP-hard); each node costs","type":"text"},{"text":" ","type":"text"},{"text":"O((n + n′)³ + n · n′ · n) for its lower bound.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"symbol","title":"Edges","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","type":"topic","abstract":[]},"doc://IsomorphismModule/documentation/IsomorphismModule":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","type":"topic","title":"IsomorphismModule","role":"collection","url":"\/documentation\/isomorphismmodule"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"title":"Graph","role":"symbol","url":"\/documentation\/graphprotocols\/graph"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph/optimalEditPath(to:vertexSubstitutionCost:vertexDeletionCost:vertexInsertionCost:edgeSubstitutionCost:edgeDeletionCost:edgeInsertionCost:upperBound:expansionLimit:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A least-cost edit path from this 