t":"."}]}],"name":"vertexSubstitutionCost"},{"content":[{"inlineContent":[{"text":"The cost of deleting a vertex of this graph.","type":"text"}],"type":"paragraph"}],"name":"vertexDeletionCost"},{"content":[{"inlineContent":[{"type":"text","text":"The cost of inserting a vertex of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"vertexInsertionCost"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The cost of substituting an edge of this graph by one of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"by position.","type":"text"}]}],"name":"edgeSubstitutionCost"},{"content":[{"inlineContent":[{"text":"The cost of deleting an edge of this graph.","type":"text"}],"type":"paragraph"}],"name":"edgeDeletionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of inserting an edge of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}]}],"name":"edgeInsertionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When set, only paths costing at most this are considered."}]}],"name":"upperBound"},{"content":[{"inlineContent":[{"text":"When set, the search expands at most this many nodes and returns the","type":"text"},{"text":" ","type":"text"},{"text":"cheapest path found, with ","type":"text"},{"code":"isOptimal","type":"codeVoice"},{"text":" false when it stopped early.","type":"text"}],"type":"paragraph"}],"name":"expansionLimit"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"The path, or nil when every path costs more than "},{"type":"codeVoice","code":"upperBound"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"An edit path substitutes each vertex of this graph by a distinct vertex of "},{"type":"codeVoice","code":"other"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deletes it, and inserts the rest of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"‘s vertices; the edges between two vertices (or"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or"},{"type":"text","text":" "},{"type":"text","text":"deleted, and "},{"type":"codeVoice","code":"other"},{"type":"text","text":"’s remaining edges inserted. Parallel edges are matched as a group at"},{"type":"text","text":" "},{"type":"text","text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)"},{"type":"text","text":" "},{"type":"text","text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit"},{"type":"text","text":" "},{"type":"text","text":"assignment of the undecided vertices."}],"type":"paragraph"},{"inlineContent":[{"text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call","type":"text"},{"text":" ","type":"text"},{"text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an","type":"text"},{"text":" ","type":"text"},{"text":"insertion; the path then takes the cheaper.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Every cost is finite and not negative; twice the sum of all costs fits in","type":"text"},{"text":" ","type":"text"},{"code":"Cost","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"expansionLimit","type":"codeVoice"},{"text":" is not negative.","type":"text"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"Exponential in the worst case (the problem is NP-hard); each node costs"},{"type":"text","text":" "},{"type":"text","text":"O((n + n′)³ + n · n′ · n) for its lower bound."}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph/optimalEditPath(to:vertexSubstitutionCost:vertexDeletionCost:vertexInsertionCost:edgeSubstitutionCost:edgeDeletionCost:edgeInsertionCost:upperBound:expansionLimit:)":{"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph\/optimalEditPath(to:vertexSubstitutionCost:vertexDeletionCost:vertexInsertionCost:edgeSubstitutionCost:edgeDeletionCost:edgeInsertionCost:upperBound:expansionLimit:)","role":"symbol","abstract":[{"text":"A least-cost edit path from this graph to ","type":"text"},{"code":"other","type":"codeVoice"},{"text":", each vertex and edge substituted,","type":"text"},{"text":" ","type":"text"},{"text":"deleted or inserted at the given costs; the graph edit distance is its ","type":"text"},{"code":"cost","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph\/optimaleditpath(to:vertexsubstitutioncost:vertexdeletioncost:vertexinsertioncost:edgesubstitutioncost:edgedeletioncost:edgeinsertioncost:upperbound:expansionlimit:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"optimalEditPath","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Other","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Cost","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"vertexSubstitutionCost","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},