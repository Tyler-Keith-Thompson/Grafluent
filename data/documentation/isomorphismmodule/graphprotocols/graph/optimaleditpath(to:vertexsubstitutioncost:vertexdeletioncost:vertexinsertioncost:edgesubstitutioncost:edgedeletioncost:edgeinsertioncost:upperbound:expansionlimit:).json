pe"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":", "},{"kind":"externalParam","text":"upperBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"expansionLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil) -> "},{"kind":"typeIdentifier","text":"EditPath","preciseIdentifier":"s:17IsomorphismModule8EditPathV","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/EditPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedNumeric","preciseIdentifier":"s:s13SignedNumericP"}]}]},{"kind":"parameters","parameters":[{"name":"other","content":[{"inlineContent":[{"type":"text","text":"The graph to reach."}],"type":"paragraph"}]},{"name":"vertexSubstitutionCost","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of substituting a vertex of this graph by one of"},{"type":"text","text":" "},{"code":"other","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"vertexDeletionCost","content":[{"type":"paragraph","inlineContent":[{"text":"The cost of deleting a vertex of this graph.","type":"text"}]}]},{"name":"vertexInsertionCost","content":[{"inlineContent":[{"type":"text","text":"The cost of inserting a vertex of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"edgeSubstitutionCost","content":[{"type":"paragraph","inlineContent":[{"text":"The cost of substituting an edge of this graph by one of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"by position.","type":"text"}]}]},{"name":"edgeDeletionCost","content":[{"inlineContent":[{"type":"text","text":"The cost of deleting an edge of this graph."}],"type":"paragraph"}]},{"name":"edgeInsertionCost","content":[{"type":"paragraph","inlineContent":[{"text":"The cost of inserting an edge of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"upperBound","content":[{"type":"paragraph","inlineContent":[{"text":"When set, only paths costing at most this are considered.","type":"text"}]}]},{"name":"expansionLimit","content":[{"inlineContent":[{"text":"When set, the search expands at most this many nodes and returns the","type":"text"},{"text":" ","type":"text"},{"text":"cheapest path found, with ","type":"text"},{"type":"codeVoice","code":"isOptimal"},{"text":" false when it stopped early.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The path, or nil when every path costs more than "},{"code":"upperBound","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"An edit path substitutes each vertex of this graph by a distinct vertex of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deletes it, and inserts the rest of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"‘s vertices; the edges between two vertices (or","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or","type":"text"},{"text":" ","type":"text"},{"text":"deleted, and ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"’s remaining edges inserted. Parallel edges are matched as a group at","type":"text"},{"text":" ","type":"text"},{"text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)","type":"text"},{"text":" ","type":"text"},{"text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit","type":"text"},{"text":" ","type":"text"},{"text":"assignment of the undecided vertices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call"},{"type":"text","text":" "},{"type":"text","text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an"},{"type":"text","text":" "},{"type":"text","text":"insertion; the path then takes the cheaper."}]},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Every cost is finite and not negative; twice the sum of all costs fits in","type":"text"},{"text":" ","type":"text"},{"code":"Cost","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"expansionLimit","type":"codeVoice"},{"text":" is not negative.","type":"text"}]}],"type":"aside","style":"note"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exponential in the worst case (the problem is NP-hard); each node costs"},{"type":"text","text":" "},{"type":"text"