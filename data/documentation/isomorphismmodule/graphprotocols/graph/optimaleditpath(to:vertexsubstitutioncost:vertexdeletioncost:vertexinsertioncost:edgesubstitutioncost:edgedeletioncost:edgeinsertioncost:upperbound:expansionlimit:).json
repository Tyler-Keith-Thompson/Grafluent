pe":"paragraph","inlineContent":[{"text":"The cost of inserting a vertex of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":".","type":"text"}]}]},{"name":"edgeSubstitutionCost","content":[{"inlineContent":[{"type":"text","text":"The cost of substituting an edge of this graph by one of "},{"type":"codeVoice","code":"other"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"by position."}],"type":"paragraph"}]},{"name":"edgeDeletionCost","content":[{"inlineContent":[{"type":"text","text":"The cost of deleting an edge of this graph."}],"type":"paragraph"}]},{"name":"edgeInsertionCost","content":[{"inlineContent":[{"type":"text","text":"The cost of inserting an edge of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"upperBound","content":[{"inlineContent":[{"type":"text","text":"When set, only paths costing at most this are considered."}],"type":"paragraph"}]},{"name":"expansionLimit","content":[{"inlineContent":[{"type":"text","text":"When set, the search expands at most this many nodes and returns the"},{"type":"text","text":" "},{"type":"text","text":"cheapest path found, with "},{"type":"codeVoice","code":"isOptimal"},{"type":"text","text":" false when it stopped early."}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The path, or nil when every path costs more than ","type":"text"},{"code":"upperBound","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An edit path substitutes each vertex of this graph by a distinct vertex of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deletes it, and inserts the rest of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"‘s vertices; the edges between two vertices (or","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or","type":"text"},{"text":" ","type":"text"},{"text":"deleted, and ","type":"text"},{"code":"other","type":"codeVoice"},{"text":"’s remaining edges inserted. Parallel edges are matched as a group at","type":"text"},{"text":" ","type":"text"},{"text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)","type":"text"},{"text":" ","type":"text"},{"text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit","type":"text"},{"text":" ","type":"text"},{"text":"assignment of the undecided vertices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call"},{"type":"text","text":" "},{"type":"text","text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an"},{"type":"text","text":" "},{"type":"text","text":"insertion; the path then takes the cheaper."}]},{"name":"Precondition","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every cost is finite and not negative; twice the sum of all costs fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":"; "},{"type":"codeVoice","code":"expansionLimit"},{"type":"text","text":" is not negative."}],"type":"paragraph"}]},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Exponential in the worst case (the problem is NP-hard); each node costs"},{"type":"text","text":" "},{"type":"text","text":"O((n + n′)³ + n · n′ · n) for its lower bound."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/isomorphismmodule\/graphprotocols