pe"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":", "},{"kind":"externalParam","text":"upperBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"expansionLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil) -> "},{"kind":"typeIdentifier","text":"EditPath","preciseIdentifier":"s:17IsomorphismModule8EditPathV","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/EditPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Cost"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"SignedNumeric","preciseIdentifier":"s:s13SignedNumericP"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The graph to reach.","type":"text"}]}],"name":"other"},{"content":[{"inlineContent":[{"type":"text","text":"The cost of substituting a vertex of this graph by one of"},{"type":"text","text":" "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"vertexSubstitutionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of deleting a vertex of this graph."}]}],"name":"vertexDeletionCost"},{"content":[{"inlineContent":[{"type":"text","text":"The cost of inserting a vertex of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"vertexInsertionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of substituting an edge of this graph by one of "},{"code":"other","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"by position."}]}],"name":"edgeSubstitutionCost"},{"content":[{"inlineContent":[{"type":"text","text":"The cost of deleting an edge of this graph."}],"type":"paragraph"}],"name":"edgeDeletionCost"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The cost of inserting an edge of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"."}]}],"name":"edgeInsertionCost"},{"content":[{"inlineContent":[{"text":"When set, only paths costing at most this are considered.","type":"text"}],"type":"paragraph"}],"name":"upperBound"},{"content":[{"inlineContent":[{"type":"text","text":"When set, the search expands at most this many nodes and returns the"},{"type":"text","text":" "},{"type":"text","text":"cheapest path found, with "},{"type":"codeVoice","code":"isOptimal"},{"type":"text","text":" false when it stopped early."}],"type":"paragraph"}],"name":"expansionLimit"}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The path, or nil when every path costs more than ","type":"text"},{"code":"upperBound","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"An edit path substitutes each vertex of this graph by a distinct vertex of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deletes it, and inserts the rest of ","type":"text"},{"type":"codeVoice","code":"other"},{"text":"‘s vertices; the edges between two vertices (or","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or","type":"text"},{"text":" ","type":"text"},{"text":"deleted, and ","type":"text"},{"type":"codeVoice","code":"other"},{"text":"’s remaining edges inserted. Parallel edges are matched as a group at","type":"text"},{"text":" ","type":"text"},{"text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)","type":"text"},{"text":" ","type":"text"},{"text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit","type":"text"},{"text":" ","type":"text"},{"text":"assignment of the undecided vertices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call","type":"text"},{"text":" ","type":"text"},{"text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an","type":"text"},{"text":" ","type":"text"},{"text":"insertion; the path then takes the cheaper.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Every cost is finite and not negative; twice the sum of all costs fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":"; "},{"type":"codeVoice","code":"expansionLimit"},{"type":"text","text":" is not negative."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exponential in the worst case (the problem is NP-hard); each node costs"},{"type":"text","text":" "},{"type":"text","text":"O((n + n′)³ + n · n′ · n) for its lower bound."}]}],"style":"note","type":"aside","name":"Complexity"}]}],"identifier":{"url":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph\/optimalEditPath(to:vertexSubstitutionCost:vertexDeletionCost:vertexInsertionCost:edgeSubstitutionCost:edgeDeletionCost:edgeInsertionCost:upperBound:expansionLimit:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph"]]},"sections":[],"variants":[{"paths":["\/documentation\/isomorphismmodule\/graphprotocols\/graph\/optimaleditpath(to:vertexsubstitutioncost:vertexdeletioncost:vertexinsertioncost:edgesubstitutioncost:edgedeletioncost:edgeinsertioncost:upperbound:expansionlimit:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"IsomorphismModule","relatedModules":["GraphProtocols"]}],"title":"optimalEditPath(to:vertexSubstitutionCost:vertexDeletionCost:vertexInsertionCost:edgeSubstitutionCost:edgeDeletionCost:edgeInsertionCost:upperBound:expansionLimit:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"optimalEditPath"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Other"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Cost"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Other"},{"kind":"text","text":", "},{"kind":"externalParam","text":"vertexSubstitutionCost"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Other"},{"kind