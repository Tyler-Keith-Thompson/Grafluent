es","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"upperBound","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"expansionLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) -> ","kind":"text"},{"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/EditPath","text":"EditPath","kind":"typeIdentifier","preciseIdentifier":"s:17IsomorphismModule8EditPathV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P"},{"text":", ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"},{"text":", ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"SignedNumeric","kind":"typeIdentifier","preciseIdentifier":"s:s13SignedNumericP"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph to reach."}]}],"name":"other"},{"content":[{"inlineContent":[{"text":"The cost of substituting a vertex of this graph by one of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"other"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"vertexSubstitutionCost"},{"content":[{"inlineContent":[{"text":"The cost of deleting a vertex of this graph.","type":"text"}],"type":"paragraph"}],"name":"vertexDeletionCost"},{"content":[{"inlineContent":[{"text":"The cost of inserting a vertex of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"vertexInsertionCost"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The cost of substituting an edge of this graph by one of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"by position.","type":"text"}]}],"name":"edgeSubstitutionCost"},{"content":[{"inlineContent":[{"type":"text","text":"The cost of deleting an edge of this graph."}],"type":"paragraph"}],"name":"edgeDeletionCost"},{"content":[{"inlineContent":[{"text":"The cost of inserting an edge of ","type":"text"},{"code":"other","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"edgeInsertionCost"},{"content":[{"inlineContent":[{"text":"When set, only paths costing at most this are considered.","type":"text"}],"type":"paragraph"}],"name":"upperBound"},{"content":[{"inlineContent":[{"type":"text","text":"When set, the search expands at most this many nodes and returns the"},{"type":"text","text":" "},{"type":"text","text":"cheapest path found, with "},{"code":"isOptimal","type":"codeVoice"},{"type":"text","text":" false when it stopped early."}],"type":"paragraph"}],"name":"expansionLimit"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The path, or nil when every path costs more than ","type":"text"},{"code":"upperBound","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An edit path substitutes each vertex of this graph by a distinct vertex of "},{"type":"codeVoice","code":"other"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deletes it, and inserts the rest of "},{"type":"codeVoice","code":"other"},{"type":"text","text":"‘s vertices; the edges between two vertices (or"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s self-loops) are then substituted by edges between their images, one for one, or"},{"type":"text","text":" "},{"type":"text","text":"deleted, and "},{"type":"codeVoice","code":"other"},{"type":"text","text":"’s remaining edges inserted. Parallel edges are matched as a group at"},{"type":"text","text":" "},{"type":"text","text":"the least cost. Found exactly by depth-first branch and bound (Abu-Aisheh et al. 2015)"},{"type":"text","text":" "},{"type":"text","text":"from the bipartite upper bound (Riesen and Bunke 2009), with a lower bound from an edit"},{"type":"text","text":" "},{"type":"text","text":"assignment of the undecided vertices."}]},{"type":"paragraph","inlineContent":[{"text":"Each closure is called once per vertex, edge, or pair of vertices or of edges, at the call","type":"text"},{"text":" ","type":"text"},{"text":"(so O(m · m′) edge substitution costs). A substitution may cost more than a deletion and an","type":"text"},{"text":" ","type":"text"},{"text":"insertion; the path then takes the cheaper.","type":"text"}]},{"name":"Precondition","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every cost is finite and not negative; twice the sum of all costs fits in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Cost"},{"type":"text","text":"; "},{"type":"codeVoice","code":"expansionLimit"},{"type":"text","text":" is not negative."}]}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Exponential in the worst case (the problem is NP-hard); each node costs","type":"text"},{"text":" ","type":"text"},{"text":"O((n + n′)³ + n · n′ · n) for its lower bound.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"type":"topic","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","kind":"symbol","role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"url":"\/documentation\/isomorphismmodule","title":"IsomorphismModule","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","kind":"symbol","abstract":[],"type":"topic","role":"collection"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/isomorphismmodule\/graphprotocols\/graph","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{