{"abstract":[{"type":"text","text":"The stationary distribution of the random walk (see "},{"type":"codeVoice","code":"StationaryDistribution"},{"text":"): the walk","type":"text"},{"text":" ","type":"text"},{"text":"leaves along an out-arc with probability proportional to its multiplicity, and a dangling","type":"text"},{"text":" ","type":"text"},{"text":"vertex jumps to a vertex drawn uniformly.","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stationaryDistribution","kind":"identifier"},{"text":"(","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-12, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"StationaryDistribution","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/StationaryDistribution","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory22StationaryDistributionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"text":"The L1 residual ‖πP − π‖₁ to reach.","type":"text"}]}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The steps the iteration may take; nil for 100,000."}]}]}]},{"content":[{"le