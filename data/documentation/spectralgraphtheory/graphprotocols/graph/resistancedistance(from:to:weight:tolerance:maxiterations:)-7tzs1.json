alGraphTheory\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resistanceDistance","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-10, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"Conjugate gradients on the Laplacian grounded at ","type":"text"},{"code":"target","type":"codeVoice"},{"text":", from 0, until the residual’s","type":"text"},{"text":" ","type":"text"},{"text":"Euclidean norm is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" (relative to the right-hand side, which has norm 1),","type":"text"},{"text":" ","type":"text"},{"text":"or, on a weight spread that puts that below rounding, until the true residual stops","type":"text"},{"text":" ","type":"text"},{"text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky","type":"text"},{"text":" ","type":"text"},{"text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for","type":"text"},{"text":" ","type":"text"},{"text":"the factor when it is built.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the conductance of the edge at each position, read once per position (every"},{"type":"text","text":" "},{"type":"text","text":"position, also outside the component); a weight of 0 is no edge."}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"source"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target"},{"text":" are vertices of the graph, every weight is finite and","type":"text"},{"text":" ","type":"text"},{"text":"nonnegative, ","type":"text"},{"type":"codeVoice","code":"tolerance > 0"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":", when given, is at least 1.","type":"text"}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" after ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" conjugate-gradient iterations (one","type":"text"},{"text":" ","type":"text"},{"text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm","type":"text"},{"text":" ","type":"text"},{"text":"relative to the right-hand side’s. No input has reached the default limit in the","type":"text"},{"text":" ","type":"text"},{"text":"measurements.","type":"text"}]}],"style":"note","name":"Throws"}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","url":"\/documentation\/spectralgraphtheory\/graphprotocols","abstract":[],"title":"GraphProtocols","role":"collection","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","abstra