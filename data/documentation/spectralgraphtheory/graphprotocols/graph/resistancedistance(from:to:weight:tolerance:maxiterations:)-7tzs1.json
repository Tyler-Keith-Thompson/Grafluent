t":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices of the graph, every weight is finite and"},{"type":"text","text":" "},{"type":"text","text":"nonnegative, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"type":"aside","style":"note"},{"name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" conjugate-gradient iterations (one"},{"type":"text","text":" "},{"type":"text","text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm"},{"type":"text","text":" "},{"type":"text","text":"relative to the right-hand side’s. No input has reached the default limit in the"},{"type":"text","text":" "},{"type":"text","text":"measurements."}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","type":"topic","url":"\/documentation\/graphprotocols\/noconvergence","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"title":"NoConvergence","kind":"symbol","abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule."}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/resistanceDistance(from:to:weight:tolerance:maxIterations:)-7tzs1