ce:maxIterations:)-7tzs1"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resistanceDistance"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-10, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sz","kind":"typeIdentifier","text":"BinaryInteger"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Conjugate gradients on the Laplacian grounded at "},{"type":"codeVoice","code":"target"},{"type":"text","text":", from 0, until the residual’s"},{"type":"text","text":" "},{"type":"text","text":"Euclidean norm is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" (relative to the right-hand side, which has norm 1),"},{"type":"text","text":" "},{"type":"text","text":"or, on a weight spread that puts that below rounding, until the true residual stops"},{"type":"text","text":" "},{"type":"text","text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky"},{"type":"text","text":" "},{"type":"text","text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"the factor when it is built."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives the conductance of the edge at each position, read once per position (every","type":"text"},{"text":" ","type":"text"},{"text":"position, also outside the component); a weight of 0 is no edge.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices of the graph, every weight is finite and"},{"type":"text","text":" "},{"type":"text","text":"nonnegative, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" conjugate-gradient iterations (one","type":"text"},{"text":" ","type":"text"},{"text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm","type":"text"},{"text":" ","type":"text"},{"text":"relative to the right-hand side’s. No input has reached the default limit in the","type":"text"},{"text":" ","type":"text"},{"text":"measurements.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"}]}],"sections":[],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","abstract":[],"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","kind":"symbol","type":"topic","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"t