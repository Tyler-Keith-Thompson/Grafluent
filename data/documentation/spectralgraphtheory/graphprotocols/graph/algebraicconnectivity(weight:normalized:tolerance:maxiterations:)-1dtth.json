nce","type":"codeVoice"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"code":"ArpackNoConvergence","type":"codeVoice"},{"text":" in the same place.","type":"text"}],"title":"NoConvergence","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}]}}}