","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(weight:normalized:tolerance:maxIterations:)-4aqxc"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"text":"The spectral ordering (Barnard, Pothen and Simon): the components in order of their least","type":"text"},{"text":" ","type":"text"},{"text":"vertex index; a component of at most two vertices in index order; a larger one ascending by","type":"text"},{"text":" ","type":"text"},{"text":"the Fiedler vector of that component (for a connected graph, ","type":"text"},{"code":"fiedlerVector()","type":"codeVoice"},{"text":"’s), entries","type":"text"},{"type":"text","text":" "},{"type":"text","text":"within 10⁻⁸ · max|x| of their predecessor kept in index order. "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" for the empty graph."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"spectralOrdering","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"] "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryFloatingPoint","preciseIdentifier":"s:SB"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected","type":"text"},{"text":" ","type":"text"},{"text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with","type":"text"},{"text":" ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a","type":"text"},{"text":" ","type":"text"},{"text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is","type":"text"},{"text":" ","type":"text"},{"text":"accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ₂, so λ₂ is relative to itself however","type":"text"},{"text":" ","type":"text"},{"text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The","type":"text"},{"text":" ","type":"text"},{"text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s (34 n from 5,000","type":"text"},{"text":" ","type":"text"},{"text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the","type":"text"},{"text":" ","type":"text"},{"text":"solver.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":". Every weight is finite and nonnegative, and","type":"text"},{"text":" ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}]}]},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when the Lanczos run on L⁺ spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" matrix–vector","type":"text"},{"text":" ","type":"text"},{"text":"products (1,000 when nil) without converging, with the products spent and the Ritz","type":"text"},{"text":" ","type":"text"},{"text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to","type":"text"},{"text":" ","type":"text"},{"text":"shift-invert rather than throwing, after 4,000 + 20√n products or ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,","type":"text"},{"text":" ","type":"text"},{"text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the","type":"text"},{"text":" ","type":"text"},{"text":"dense solver answers and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is unused. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached the default limits in the measurements.","type":"text"}]}]}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","url":"\/documentation\/spectralgraphtheory\/graphprotocols","abstract":[],"title":"GraphProtocols","role":"collection","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","abstract":[],"typ