Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(weight:normalized:tolerance:maxIterations:)-4aqxc"},"abstract":[{"type":"text","text":"The spectral ordering (NetworkX "},{"type":"codeVoice","code":"spectral_ordering"},{"type":"text","text":"; Barnard, Pothen and Simon): the"},{"type":"text","text":" "},{"type":"text","text":"components in order of their least vertex index; a component of at most two vertices in"},{"type":"text","text":" "},{"type":"text","text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected"},{"type":"text","text":" "},{"type":"text","text":"graph, "},{"type":"codeVoice","code":"fiedlerVector()"},{"type":"text","text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in"},{"type":"text","text":" "},{"type":"text","text":"index order. "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" for the empty graph."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralOrdering"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":",