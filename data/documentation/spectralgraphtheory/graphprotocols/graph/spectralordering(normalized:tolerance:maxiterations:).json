{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(normalized:tolerance:maxIterations:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralordering(normalized:tolerance:maxiterations:)"]}],"abstract":[{"text":"The spectral ordering (NetworkX ","type":"text"},{"code":"spectral_ordering","type":"codeVoice"},{"text":"; Barnard, Pothen and Simon): the","type":"text"},{"text":" ","type":"text"},{"text":"components in order of their least vertex index; a component of at most two vertices in","type":"text"},{"text":" ","type":"text"},{"text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected","type":"text"},{"text":" ","type":"text"},{"text":"graph, ","type":"text"},{"code":"fiedlerVector()","type":"codeVoice"},{"text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in","type":"text"},{"text":" ","type":"text"},{"text":"index order. ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" for the empty graph.","type":"text"}],"metadata":{"symbolKind":"method","title":"spectralOrdering(normalized:tolerance:maxIterations:)","remoteSource":{"fileName":"FiedlerVector.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/FiedlerVector.swift#L293"},"extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralOrdering"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE16spectralOrdering10normalized9tolerance13maxIterationsSay6VertexQzGSb_SdSiSgtAA13NoConvergenceVYKF"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralOrdering","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"code":"normalized","type":"codeVoice"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}]}],"type":"aside","style":"note"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when the Lanczos run on L⁺ spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" matrix–vector"},{"type":"text","text":" "},{"type":"text","text":"products (1,000 when nil) without converging, with the products spent and the Ritz"},{"type":"text","text":" "},{"type":"text","text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to"},{"type":"text","text":" "},{"type":"text","text":"shift-invert rather than throwing, after 4,000 + 20√n products or "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,"},{"type":"text","text":" "},{"type":"text","text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the"},{"type":"text","text":" "},{"type":"text","text":"dense solver answers and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" is unused. Only a tolerance below rounding has"},{"type":"text","text":" "},{"type":"text","text":"reached the default limits in the measurements."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"abstract":[{"type":"text","text":"The error an iterative method throws when it spends its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos"},{"type":"text","text":" "},{"type":"text","text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s"},{"type":"text","text":" "},{"code":"ComputationInfo::NoConvergence","type":"codeVoice"},{"text":"; NetworkX raises ","type":"text"},{"code":"PowerIterationFailedConvergence","type":"codeVoice"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"code":"ArpackNoConvergence","type":"codeVoice"},{"text":" in the same place.","type":"text"}],"title":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphprotocols\/noconvergence"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","abstract":[],"title":"GraphProtocols","type":"topic","role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","kind":"symbol","type":"topic","abstract":[],"title":"SpectralGraphTheory","role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/spectralOrdering(normalized:tolerance:maxIterations:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralOrdering"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":