{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralOrdering"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected","type":"text"},{"text":" ","type":"text"},{"text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with","type":"text"},{"text":" ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a","type":"text"},{"text":" ","type":"text"},{"text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is","type":"text"},{"text":" ","type":"text"},{"text":"accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ₂, so λ₂ is relative to itself however","type":"text"},{"text":" ","type":"text"},{"text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The","type":"text"},{"text":" ","type":"text"},{"text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s (34 n from 5,000","type":"text"},{"text":" ","type":"text"},{"text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the","type":"text"},{"text":" ","type":"text"},{"text":"solver.","type":"text"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}]}]},{"type":"aside","style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when the Lanczos run on L⁺ spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" matrix–vector"},{"type":"text","text":" "},{"type":"text","text":"products (1,000 when nil) without converging, with the products spent and the Ritz"},{"type":"text","text":" "},{"type":"text","text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to"},{"type":"text","text":" "},{"type":"text","text":"shift-invert rather than throwing, after 4,000 + 20√n products or "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,"},{"type":"text","text":" "},{"type":"text","text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the"},{"type":"text","text":" "},{"type":"text","text":"dense solver answers and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" is unused. Only a tolerance below rounding has"},{"type":"text","text":" "},{"type":"text","text":"reached the default limits in the measurements."}],"type":"paragraph"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralordering(normalized:tolerance:maxiterations:)"]}],"metadata":{"title":"spectralOrdering(normalized:tolerance:maxIterations:)","role":"symbol","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE16spectralOrdering10normalized9tolerance13maxIterationsSay6VertexQzGSb_SdSiSgtAA13NoConvergenceVYKF","remoteSource":{"fileName":"FiedlerVector.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/FiedlerVector.swift#L293"},"extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralOrdering","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"symbolKind":"method","modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}]},"sections":[],"abstract":[{"type":"text","text":"The spectral ordering (NetworkX "},{"code":"spectral_ordering","type":"codeVoice"},{"type":"text","text":"; Barnard, Pothen and Simon): the"},{"type":"text","text":" "},{"type":"text","text":"components in order of their least vertex index; a component of at most two vertices in"},{"type":"text","text":" "},{"type":"text","text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected"},{"type":"text","text":" "},{"type":"text","text":"graph, "},{"code":"fiedlerVector()","type":"codeVoice"},{"type":"text","text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in"},{"type":"text","text":" "},{"type":"text","text":"index order. "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" for the empty graph."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(normalized:tolerance:maxIterations:)"},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"role":"collection","title":"GraphProtocols","url":"\/documentation\/spectralgraphtheory\/graphprotocols","kind":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"title":"Graph","role":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","kind":"symbol","abstract":[],"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","title":"SpectralGraphTheory","abstract":[],"type":"topic"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/spectralOrdering(normalized:tolerance:maxIterations:)":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralordering(normalized:tolerance:maxiterations:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralOrdering"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"role":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(normalized:tolerance:maxIterations:)","title":"spectralOrdering(normalized:tolerance:maxIterations:)","abstract":[{"text":"The spectral ordering (NetworkX ","type":"text"},{"code":"spectral_ordering","type":"codeVoice"},{"text":"; Barnard, Pothen and Simon): the","type":"text"},{"text":" ","type":"text"},{"text":"components in order of their least vertex index; a component of at most two vertices in","type":"text"},{"text":" ","type":"text"},{"text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected","type":"text"},{"text":" ","type":"text"},{"text":"graph, ","type":"text"},{"code":"fiedlerVector()","type":"codeVoice"},{"text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in","type":"text"},{"text":" ","type":"text"},{"text":"index order. ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" for the empty graph.","type":"text"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"kind":"symbol","url":"\/documentation\/graphprotocols\/noconvergence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","title":"NoConvergence","abstract":[{"type":"text","text":"The error an iterative method throws when it spends its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos"},{"type":"text","text":" "},{"type":"text","text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s"},{"type":"text","text":" "},{"code":"ComputationInfo::NoConvergence","type":"codeVoice"},{"type":"text","text":"; NetworkX raises "},{"code":"PowerIterationFailedConvergence","type":"codeVoice"},{"type":"text","text":" and SciPy"},{"type":"text","text":" "},{"code":"ArpackNoConvergence","type":"codeVoice"},{"type":"text","text":" in the same place."}],"type":"topic","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","kind":"symbol","abstract":[],"type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"}}}