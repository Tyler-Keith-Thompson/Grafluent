,"text":"The spectral ordering (NetworkX "},{"code":"spectral_ordering","type":"codeVoice"},{"type":"text","text":"; Barnard, Pothen and Simon): the"},{"type":"text","text":" "},{"type":"text","text":"components in order of their least vertex index; a component of at most two vertices in"},{"type":"text","text":" "},{"type":"text","text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected"},{"type":"text","text":" "},{"type":"text","text":"graph, "},{"code":"fiedlerVector()","type":"codeVoice"},{"type":"text","text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in"},{"type":"text","text":" "},{"type":"text","text":"index order. "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" for the empty graph."}],"role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"title":"Graph","kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","type":"topic","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","abstract":[],"role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"abstract":[],"role":"collection","title":"GraphProtocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","type":"topic","url":"\/documentation\/spectralgraphtheory\/graphprotocols","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoConvergence"}],"kind":"symbol","title":"NoConvergence","navigatorTitle":[{"kind":"identifier","text":"NoConvergence"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","type":"topic","url":"\/documentation\/graphprotocols\/noconvergence","abstract":[{"text":"The error an iterative method throws when it spends its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos","type":"text"},{"text":" ","type":"text"},{"text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s","type":"text"},{"text":" ","type":"text"},{"code":"ComputationInfo::NoConvergence","type":"codeVoice"},{"text":"; NetworkX raises ","type":"text"},{"code":"PowerIterationFailedConvergence","type":"codeVoice"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"code":"ArpackNoConvergence","type":"codeVoice"},{"text":" in the same place.","type":"text"}],"role":"symbol"}}}