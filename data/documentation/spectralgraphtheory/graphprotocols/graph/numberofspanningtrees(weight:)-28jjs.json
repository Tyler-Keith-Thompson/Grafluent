{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SB","text":"BinaryFloatingPoint"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A "},{"code":"Double","type":"codeVoice"},{"type":"text","text":": counts pass "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed"},{"type":"text","text":" "},{"type":"text","text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of"},{"type":"text","text":" "},{"type":"text","text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶"},{"type":"text","text":" "},{"type":"text","text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it"},{"type":"text","text":" "},{"type":"text","text":"overflows only past "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"’s range, to "},{"code":".infinity","type":"codeVoice"},{"type":"text","text":". When every weight is an integer"},{"type":"text","text":" "},{"type":"text","text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two"},{"type":"text","text":" "},{"type":"text","text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded"},{"type":"text","text":" "},{"type":"text","text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}]}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees(weight:)-28jjs","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees(weight:)-28jjs"]}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of","type":"text"},{"text":" ","type":"text"},{"text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem).","type":"text"},{"text":" ","type":"text"},{"text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a","type":"text"},{"text":" ","type":"text"},{"text":"disconnected one, 1 for one vertex.","type":"text"}],"metadata":{"title":"numberOfSpanningTrees(weight:)","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTrees6weightSdqd__5Edges_5IndexQZXE_tSBRd__lF","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L64","fileName":"ElectricalNetworks.swift"},"extendedModule":"GraphProtocols","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}]},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/numberOfSpanningTrees(weight:)-28jjs":{"title":"numberOfSpanningTrees(weight:)","role":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees(weight:)-28jjs","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees(wei