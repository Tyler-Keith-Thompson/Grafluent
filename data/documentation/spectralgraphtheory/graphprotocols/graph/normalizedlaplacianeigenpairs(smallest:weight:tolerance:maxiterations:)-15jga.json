{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalizedLaplacianEigenpairs"},{"kind":"text","text":"<"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","preciseIdentifier":"s:Sz","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"type":"codeVoice","code":"0...vertexCount"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"smallest"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weight of the edge at each position."}]}],"name":"weight"},{"content":[{"inlineContent":[{"text":"The residual a Ritz pair must reach, relative as described above.","type":"text"}],"type":"paragraph"}],"name":"tolerance"},{"content":[{"inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for the limits"},{"type":"text","text":" "},{"type":"text","text":"under Throws."}],"type":"paragraph"}],"name":"maxIterations"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The eigenpairs, in order from that end of the spectrum.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component by component: each component’s null vector first (eigenvalue 0, components in"},{"type":"text","text":" "},{"type":"text","text":"order of their least vertex), then the smallest positive eigenvalues of the components"},{"type":"text","text":" "},{"type":"text","text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full"},{"type":"text","text":" "},{"type":"text","text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:"},{"type":"text","text":" "},{"type":"text","text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each"},{"type":"text","text":" "},{"type":"text","text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz"},{"type":"text","text":" "},{"type":"text","text":"pair is accepted when its residual is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" · λ, relative to itself as for"},{"type":"text","text":" "},{"code":"algebraicConnectivity","type":"codeVoice"},{"type":"text","text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each"},{"type":"text","text":" "},{"type":"text","text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller"},{"type":"text","text":" "},{"type":"text","text":"component, or when k is a third of it or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"smallest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", every weight is finite"},{"type":"text","text":" "},{"type":"text","text":"and nonnegative, and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run by shift-invert spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products"},{"type":"text","text":" "},{"type":"text","text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without"},{"type":"text","text":" "},{"type":"text","text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n products or "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", whichever is smaller. The dense solver throws as"},{"type":"text","text":" "},{"type":"codeVoice","code":"laplacianSpectrum"},{"type":"text","text":" does."}],"type":"paragraph"}],"name":"Throws","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/normalizedLaplacianEigenpairs(smallest:weight:tolerance:maxIterations:)-15jga","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/normalizedlaplacianeigenpairs(smallest:weight:tolerance:maxiterations:)-15jga"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE29normalizedLaplacianEigenpairs8smallest6weight9tolerance13maxIterationsAD0G0VyxGSi_qd__5Edges_5IndexQZXESdSiSgtAA13NoConvergenceVYKSzRd__lF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalizedLaplacianEigenpairs"},{"text":"<","kind":"text"},{"text":"W","kind":"g