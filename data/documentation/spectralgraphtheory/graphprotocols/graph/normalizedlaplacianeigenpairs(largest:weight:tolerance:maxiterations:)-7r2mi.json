pe":"codeVoice","code":"tolerance > 0"},{"text":", every weight is finite","type":"text"},{"text":" ","type":"text"},{"text":"and nonnegative, and ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":", when given, is at least 1.","type":"text"}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when a Lanczos run spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"code":"adjacencySpectrum","type":"codeVoice"},{"type":"text","text":" does."}]}],"style":"note","name":"Throws"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/normalizedlaplacianeigenpairs(largest:weight:tolerance:maxiterations:)-7r2mi"]}],"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","title":"NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"abstract":[{"text":"Eigenpairs of a graph matrix at one end o