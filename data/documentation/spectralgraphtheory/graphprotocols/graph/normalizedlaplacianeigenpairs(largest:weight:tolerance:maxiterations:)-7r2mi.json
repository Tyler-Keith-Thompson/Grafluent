 is no edge."}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"largest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", every weight is finite","type":"text"},{"text":" ","type":"text"},{"text":"and nonnegative, and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"name":"Precondition"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}],"name":"Throws"}]}],"sections":[],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","abstract":[],"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/normalizedLaplacianEigenpairs(largest:weight:tolerance:maxIterations:)-7r2mi":{"type":"topic","abstract":[{"type":"text","text":"The k largest eigenvalues of the norm