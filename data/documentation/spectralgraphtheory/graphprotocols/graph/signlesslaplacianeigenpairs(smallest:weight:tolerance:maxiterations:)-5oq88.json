xt"},{"text":"converging, with the products spent and the largest Ritz residual on the tolerance’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"code":"adjacencySpectrum","type":"codeVoice"},{"text":" does.","type":"text"}]}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"The k smallest eigenvalues of the signless Laplacian Q ("},{"type":"codeVoice","code":"signlessLaplacianMatrix()"},{"type":"text","text":"), k ="},{"type":"text","text":" "},{"type":"codeVoice","code":"smallest"},{"type":"text","text":", ascending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/signlesslaplacianeigenpairs(smallest:weight:tolerance:maxiterations:)-5oq88"]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","type":"topic","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"title":"Edges","kind":"symbol","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","type":"topic","url":"\/documentation\/spectralgraph