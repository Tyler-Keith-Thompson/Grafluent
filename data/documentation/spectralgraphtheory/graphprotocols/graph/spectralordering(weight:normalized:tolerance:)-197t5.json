spectralOrdering","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8) -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"] ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryFloatingPoint","kind":"typeIdentifier","preciseIdentifier":"s:SB"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Traps when the work limit is spent: 4,000 + 20√n products on σI − L (then shift-invert),"},{"type":"text","text":" "},{"type":"text","text":"1,000 shift-invert products, 20,000 + 2n per solve. Only a tolerance below rounding has"},{"type":"text","text":" "},{"type":"text","text":"reached it in the measurements."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":". Every weight is finite and nonnegative."}],"type":"paragraph"}]}]}],"kind":"symbol","abstract":[{"text":"The spectral ordering (NetworkX ","type":"text"},{"code":"spectral_ordering","type":"codeVoice"},{"text":"; Barnard, Pothen and Simon): the","type":"text"},{"text":" ","type":"text"},{"text":"components in order of their least vertex index; a component of at most two vertices in","type":"text"},{"text":" ","type":"text"},{"text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected","type":"text"},{"text":" ","type":"text"},{"text":"graph, ","type":"text"},{"code":"fiedlerVector()","type":"codeVoice"},{"text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in","type":"text"},{"text":" ","type":"text"},{"text":"index order. ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" for the empty graph.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralordering(weight:normalized:tolerance:)-197t5"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(weight:normalized:tolerance:)-197t5"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"title":"Edges","abstract":[],"kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","abstract":[],"kind":"symbol","fragment