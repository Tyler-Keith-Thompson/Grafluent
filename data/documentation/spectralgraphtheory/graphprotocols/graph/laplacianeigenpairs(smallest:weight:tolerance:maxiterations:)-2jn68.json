t":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","text":"Eigenpairs","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryFloatingPoint","preciseIdentifier":"s:SB"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"smallest","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of eigenpairs, in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":"."}]}]},{"name":"weight","content":[{"inlineContent":[{"text":"The weight of the edge at each position.","type":"text"}],"type":"paragraph"}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"text":"The residual a Ritz pair must reach, relative as described above.","type":"text"}]}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for the limits"},{"type":"text","text":" "},{"type":"text","text":"under Throws."}]}]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Component by component: each component’s null vector first (eigenvalue 0, components in","type":"text"},{"text":" ","type":"text"},{"text":"order of their least vertex), then the smallest positive eigenvalues of the components","type":"text"},{"text":" ","type":"text"},{"text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full","type":"text"},{"text":" ","type":"text"},{"text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:","type":"text"},{"text":" ","type":"text"},{"text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each","type":"text"},{"text":" ","type":"text"},{"text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz","type":"text"},{"text":" ","type":"text"},{"text":"pair is accepted when its residual is at most ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":" · λ, relative to itself as for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"algebraicConnectivity"},{"text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each","type":"text"},{"text":" ","type":"text"},{"text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller","type":"text"},{"text":" ","type":"text"},{"text":"component, or when k is a third of it or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"smallest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", every weight is finite","type":"text"},{"text":" ","type":"text"},{"text":"and nonnegative, and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}]}],"name":"Precondition"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when a Lanczos run by shift-invert spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" products"},{"type":"text","text":" "},{"type":"text","text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without"},{"type":"text","text":" "},{"type":"text","text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n products or "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", whichever is smaller. The dense solver throws as"},{"type":"text","text":" "},{"code":"laplacianSpectrum","type":"codeVoice"},{"type":"text","text":" does."}]}],"name":"Throws"}]}],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE19laplacianEigenpairs8smallest6weight9tolerance13maxIterationsAD0F0VyxGSi_qd__5Edges_5IndexQZXESdSiSgtAA13NoConvergenceVYKSBRd__lF","extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"laplacia