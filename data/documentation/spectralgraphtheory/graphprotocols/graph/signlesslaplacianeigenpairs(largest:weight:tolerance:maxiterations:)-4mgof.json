’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"code":"adjacencySpectrum","type":"codeVoice"},{"text":" does.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The k largest eigenvalues of the signless Laplacian Q ("},{"code":"signlessLaplacianMatrix()","type":"codeVoice"},{"type":"text","text":"), k ="},{"type":"text","text":" "},{"code":"largest","type":"codeVoice"},{"type":"text","text":", descending, each with a unit eigenvector (see "},{"code":"Eigenpairs","type":"codeVoice"},{"type":"text","text":")."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/signlesslaplacianeigenpairs(largest:weight:tolerance:maxiterations:)-4mgof"]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","type":"topic","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"title":"Edges","kind":"symbol","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","type":"topic","url":"\/documentation\/spectralgraphtheory","abstract":[],"role":"c