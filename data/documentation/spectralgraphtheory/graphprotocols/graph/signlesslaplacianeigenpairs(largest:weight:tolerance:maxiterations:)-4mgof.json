ifier","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","kind":"typeIdentifier","text":"Eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SB","kind":"typeIdentifier","text":"BinaryFloatingPoint"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"largest","content":[{"inlineContent":[{"type":"text","text":"The number of eigenpairs, in "},{"code":"0...vertexCount","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weight of the edge at each position."}]}]},{"name":"tolerance","content":[{"inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"inlineContent":[{"text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a"},{"type":"text","text":" "},{"type":"text","text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks"},{"type":"text","text":" "},{"type":"text","text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual"},{"type":"text","text":" "},{"type":"text","text":"is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors"},{"type":"text","text":" "},{"type":"text","text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64"},{"type":"text","text":" "},{"type":"text","text":"vertices, or when k is a third of them or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"largest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", every weight is finite"},{"type":"text","text":" "},{"type":"text","text":"and nonnegative, and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoic