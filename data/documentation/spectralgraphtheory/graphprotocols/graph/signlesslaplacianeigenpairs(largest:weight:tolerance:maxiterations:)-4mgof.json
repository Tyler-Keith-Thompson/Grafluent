olerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"code":"adjacencySpectrum","type":"codeVoice"},{"type":"text","text":" does."}]}],"type":"aside","name":"Throws","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"The k largest eigenvalues of the signless Laplacian Q ("},{"type":"codeVoice","code":"signlessLaplacianMatrix()"},{"type":"text","text":"), k ="},{"type":"text","text":" "},{"type":"codeVoice","code":"largest"},{"type":"text","text":", descending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/signlessLaplacianEigenpairs(largest:weight:tolerance:maxIterations:)-4mgof"},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/signlessLaplacianEigenpairs(largest:weight:tolerance:maxIterations:)-4mgof":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/signlessLaplacianEigenpairs(largest:weight:tolerance:maxIterations:)-4mgof","abstract":[{"type":"text","text":"The k largest eigenvalues of the signless Laplacian Q ("},{"code":"signlessLaplacianMatrix()","type":"codeVoice"},{"type":"text","text":"), k ="},{"type":"text","text":" "},{"code":"largest","type":"codeVoice"},{"type":"text","text":", descending, each with a unit eigenvector (see "},{"code":"Eigenpairs","type":"codeVoice"},{"text":").","type":"text"}],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/signlesslapl