{"abstract":[{"type":"text","text":"The k smallest eigenvalues of the Laplacian L ("},{"type":"codeVoice","code":"laplacianMatrix()"},{"type":"text","text":"), k = "},{"type":"codeVoice","code":"smallest"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"ascending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"roleHeading":"Instance Method","title":"laplacianEigenpairs(smallest:tolerance:maxIterations:)","extendedModule":"GraphProtocols","role":"symbol","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE19laplacianEigenpairs8smallest9tolerance13maxIterationsAD0F0VyxGSi_SdSiSgtAA13NoConvergenceVYKF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"laplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"fileName":"Eigenpairs.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L332"}},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/laplacianEigenpairs(smallest:tolerance:maxIterations:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"laplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"name":"smallest","content":[{"type":"paragraph","inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"type":"codeVoice","code":"0...vertexCount"},{"text":".","type":"text"}]}]},{"name":"tolerance","content":[{"inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for the limits"},{"type":"text","text":" "},{"type":"text","text":"under Throws."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Component by component: each component’s null vector first (eigenvalue 0, components in","type":"text"},{"text":" ","type":"text"},{"text":"order of their least vertex), then the smallest positive eigenvalues of the components","type":"text"},{"text":" ","type":"text"},{"text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full","type":"text"},{"text":" ","type":"text"},{"text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:","type":"text"},{"text":" ","type":"text"},{"text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each","type":"text"},{"text":" ","type":"text"},{"text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz","type":"text"},{"text":" ","type":"text"},{"text":"pair is accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ, relative to itself as for","type":"text"},{"text":" ","type":"text"},{"code":"algebraicConnectivity","type":"codeVoice"},{"text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each","type":"text"},{"text":" ","type":"text"},{"text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller","type":"text"},{"text":" ","type":"text"},{"text":"component, or when k is a third of it or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"smallest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"when given, is at least 1."}]}],"style":"note","type":"aside"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run by shift-invert spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" products","type":"text"},{"text":" ","type":"text"},{"text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without","type":"text"},{"text":" ","type":"text"},{"text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n products or ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", whichever is smaller. The dense solver throws as","type":"text"},{"text":" ","type":"text"},{"code":"laplacianSpectrum","type":"codeVoice"},{"text":" does.","type":"text"}]}],"style":"note","type":"aside"}]}],"schemaVersion":{"m