{"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"metadata":{"title":"laplacianEigenpairs(smallest:tolerance:maxIterations:)","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE19laplacianEigenpairs8smallest9tolerance13maxIterationsAD0F0VyxGSi_SdSiSgtAA13NoConvergenceVYKF","role":"symbol","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"laplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"fileName":"Eigenpairs.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L332"},"extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"symbolKind":"method"},"kind":"symbol","variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/laplacianeigenpairs(smallest:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"laplacianEigenpairs"},{"kind":"text","text":"("},{"kind":"externalParam","text":"smallest"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","text":"Eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of eigenpairs, in "},{"code":"0...vertexCount","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"smallest"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The residual a Ritz pair must reach, relative as described above.","type":"text"}]}],"name":"tolerance"},{"content":[{"inlineContent":[{"text":"The matrix–vector products each Lanczos run may spend; nil for the limits","type":"text"},{"text":" ","type":"text"},{"text":"under Throws.","type":"text"}],"type":"paragraph"}],"name":"maxIterations"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The eigenpairs, in order from that end of the spectrum.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Component by component: each component’s null vector first (eigenvalue 0, components in"},{"type":"text","text":" "},{"type":"text","text":"order of their least vertex), then the smallest positive eigenvalues of the components"},{"type":"text","text":" "},{"type":"text","text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full"},{"type":"text","text":" "},{"type":"text","text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:"},{"type":"text","text":" "},{"type":"text","text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each"},{"type":"text","text":" "},{"type":"text","text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz"},{"type":"text","text":" "},{"type":"text","text":"pair is accepted when its residual is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · λ, relative to itself as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"algebraicConnectivity"},{"type":"text","text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each"},{"type":"text","text":" "},{"type":"text","text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller"},{"type":"text","text":" "},{"type":"text","text":"component, or when k is a third of it or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}],"type":"paragraph"},{"name":"Precondition","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"smallest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"when given, is at least 1.","type":"text"}]}]},{"name":"Throws","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run by shift-invert spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" products","type":"text"},{"text":" ","type":"text"},{"text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without","type":"text"},{"text":" ","type":"text"},{"text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n products or ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", whichever is smaller. The dense solver throws as","type":"text"},{"text":" ","type":"text"},{"code":"laplacianSpectrum","type":"codeVoice"},{"text":" does.","type":"text"}]}]}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/laplacianEigenpairs(smallest:tolerance:maxIterations:)"},"abstract":[{"type":"text","text":"The k smallest eigenvalues of the Laplacian L ("},{"type":"codeVoice","code":"laplacianMatrix()"},{"type":"text","text":"), k = "},{"type":"codeVoice","code":"smallest"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"ascending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"type":"topic","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"title":"NoConvergence","kind":"symbol","url":"\/documentation\/graphprotocols\/noconvergence","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoConvergence"}],"navigatorTitle":[{"kind":"identifier","text":"NoConvergence"}],"type":"topic","abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"title":"GraphProtocols","abstract":[],"url":"\/documentation\/spectralgraphtheory\/graphprotocols","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"title":"Eigenpairs","url":"\/documentation\/spectralgraphtheory\/eigenpairs","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Eigenpairs"}],"navigatorTitle":[{"kind":"identifier","text":"Eigenpairs"}],"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","abstract":[{"type":"text","text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenvalues, from that end"},{"type":"text","text":" "},{"type":"text","text":"(ascending for the smallest, descending for the largest), and an orthonormal eigenvector for"},{"type":"text","text":" "},{"type":"text","text":"each, with one entry per vertex."}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"type":"topic","title":"SpectralGraphTheory","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","kind":"symbol","role":"collection","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/laplacianEigenpairs(smallest:tolerance:maxIterations:)":{"title":"laplacianEigenpairs(smallest:tolerance:maxIterations:)","kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/laplacianeigenpairs(smallest:tolerance:maxiterations:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"laplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","text":"Eigenpairs","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The k smallest eigenvalues of the Laplacian L ("},{"type":"codeVoice","code":"laplacianMatrix()"},{"type":"text","text":"), k = "},{"type":"codeVoice","code":"smallest"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"ascending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/laplacianEigenpairs(smallest:tolerance:maxIterations:)"}}}