{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"The Kemeny constant: the expected number of steps of the random walk (edge weights as","type":"text"},{"text":" ","type":"text"},{"text":"transition rates, a loop taken with probability 2w\/d(v)) from a vertex to a target drawn","type":"text"},{"text":" ","type":"text"},{"text":"from the stationary distribution, which does not depend on the start; Σ_{i≥2} 1\/μᵢ over the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian spectrum. nil when the graph is not connected, 0 for zero or one vertex.","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX ","type":"text"},{"code":"kemeny_constant","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Vol · (Σᵢ πᵢ (L_g⁻¹)ᵢᵢ − πᵀ L_g⁻¹ π), π the stationary distribution, which is","type":"text"},{"text":" ","type":"text"},{"text":"(1\/2vol) Σᵢⱼ dᵢ dⱼ R(i, j) (commute times are vol · R), with L_g the Laplacian grounded at","type":"text"},{"text":" ","type":"text"},{"text":"the vertex of largest degree and eliminated as for ","type":"text"},{"type":"codeVoice","code":"numberOfSpanningTrees"},{"text":". Every term is a","type":"text"},{"text":" ","type":"text"},{"text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its","type":"text"},{"text":" ","type":"text"},{"text":"relative accuracy under any weight spread. O(n³) time, n² ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/kemenyConstant()"},"metadata":{"role":"symbol","title":"kemenyConstant()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kemenyConstant"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"?"}],"remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L228"},"modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE14kemenyConstantSdSgyF","symbolKind":"method"},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/kemenyconstant()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/spectralgraphtheory\/graphprotocols","title":"GraphProtocols","type":"topic"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"abstract":[],"kind":"symbol","title":"SpectralGraphTheory","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","type":"topic"},"doc://SpectralGraphTheory/documentati