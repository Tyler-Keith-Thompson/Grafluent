{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/kemenyConstant()","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"metadata":{"role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE14kemenyConstantSdSgyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L228","fileName":"ElectricalNetworks.swift"},"symbolKind":"method","title":"kemenyConstant()","extendedModule":"GraphProtocols"},"sections":[],"abstract":[{"text":"The Kemeny constant: the expected number of steps of the random walk (edge weights as","type":"text"},{"text":" ","type":"text"},{"text":"transition rates, a loop taken with probability 2w\/d(v)) from a vertex to a target drawn","type":"text"},{"text":" ","type":"text"},{"text":"from the stationary distribution, which does not depend on the start; Σ_{i≥2} 1\/μᵢ over the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian spectrum. nil when the graph is not connected, 0 for zero or one vertex.","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX ","type":"text"},{"code":"kemeny_constant","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","