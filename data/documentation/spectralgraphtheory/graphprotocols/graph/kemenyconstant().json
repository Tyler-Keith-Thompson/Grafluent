xt"},{"type":"text","text":"normalized Laplacian spectrum. nil when the graph is not connected, 0 for zero or one vertex."}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/kemenyConstant()","title":"kemenyConstant()","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/kemenyconstant()"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[],"title":"Graph","type":"topic","kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"abstract":[],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/spectralgraphtheory\/graphprotocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","title":"GraphProtocols"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","abstract":[],"title":"SpectralGraphTheory","kind":"symbol","type":"topic","url":"\/documentation\/spectralgraphtheory","role":"collection"}}}