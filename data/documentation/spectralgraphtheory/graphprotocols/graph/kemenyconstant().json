 vertex."},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"type":"codeVoice","code":"kemeny_constant"},{"type":"text","text":"."}],"title":"kemenyConstant()","type":"topic","kind":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/kemenyConstant()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kemenyConstant"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"?"}],"role":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/kemenyconstant()"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","abstract":[],"title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","kind":"symbol","type":"topic","abstract":[],"title":"SpectralGraphTheory","role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","abstract":[],"title":"GraphProtocols","type":"topic","role":"collection"}}}