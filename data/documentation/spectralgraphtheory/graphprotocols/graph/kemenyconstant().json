{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kemenyConstant"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Vol · (Σᵢ πᵢ (L_g⁻¹)ᵢᵢ − πᵀ L_g⁻¹ π), π the stationary distribution, which is"},{"type":"text","text":" "},{"type":"text","text":"(1\/2vol) Σᵢⱼ dᵢ dⱼ R(i, j) (commute times are vol · R), with L_g the Laplacian grounded at"},{"type":"text","text":" "},{"type":"text","text":"the vertex of largest degree and eliminated as for "},{"type":"codeVoice","code":"numberOfSpanningTrees"},{"type":"text","text":". Every term is a"},{"type":"text","text":" "},{"type":"text","text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its"},{"type":"text","text":" "},{"type":"text","text":"relative accuracy under any weight spread. O(n³) time, n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/kemenyconstant()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/kemenyConstant()","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"The Kemeny constant: the expected number of steps of the random walk (edge weights as"},{"type":"text","text":" "},{"type":"text","text":"transition rates, a loop taken with probability 2w\/d(v)) from a vertex to a target drawn"},{"type":"text","text":" "},{"type":"text","text":"from the stationary distribution, which does not depend on the start; Σ_{i≥2} 1\/μᵢ over the"},{"type":"text","text":" "},{"type":"text","text":"normalized Laplacian spectrum. nil when the graph is not connected, 0 for zero or one vertex."},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"type":"codeVoice","code":"kemeny_constant"},{"type":"text","text":"."}],"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"role":"symbol","title":"kemenyConstant()","extendedModule":"GraphProtocols","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"?"}],"remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L228"},"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE14kemenyConstantSdSgyF"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"role":"symbol","abstract":[],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","kind":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","title":"Graph","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/kemenyConstant(