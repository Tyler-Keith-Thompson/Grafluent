pe":"text","text":"0 is no edge."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"largest","type":"codeVoice"},{"type":"text","text":" is in "},{"code":"0...vertexCount","type":"codeVoice"},{"type":"text","text":", "},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":", every weight is finite"},{"type":"text","text":" "},{"type":"text","text":"and nonnegative, and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", when given, is at least 1."}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}],"style":"note","name":"Throws"}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","abstract":[],"title":"GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/spectralgraphtheory\/graphprotocols"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","abstract":[],"title":"SpectralGraphTheory","kind":"symbol","role":"collection","url":"\/documentation\/spectralgraphtheory"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/normalizedLaplacianEigenpairs(largest:weight:tolerance:maxIterations:)-5fija":{"abstract":[{"text":"T