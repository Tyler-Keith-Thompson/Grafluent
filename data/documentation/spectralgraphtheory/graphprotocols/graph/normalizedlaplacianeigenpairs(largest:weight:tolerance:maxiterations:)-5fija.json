4GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryFloatingPoint","kind":"typeIdentifier","preciseIdentifier":"s:SB"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"largest","content":[{"type":"paragraph","inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weight of the edge at each position."}]}]},{"name":"tolerance","content":[{"inlineContent":[{"text":"The residual a Ritz pair must reach, relative as described above.","type":"text"}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a","type":"text"},{"text":" ","type":"text"},{"text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks","type":"text"},{"text":" ","type":"text"},{"text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual","type":"text"},{"text":" ","type":"text"},{"text":"is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors","type":"text"},{"text":" ","type":"text"},{"text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64","type":"text"},{"text":" ","type":"text"},{"text":"vertices, or when k is a third of them or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"name":"Precondition","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"largest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", every weight is finite"},{"type":"text","text":" "},{"type":"text","text":"and nonnegative, and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}]}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","type":"topic","url":"\/documentation\/spectralgraphtheory","kind":"symbol","title":"SpectralGraphTheory","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"abstract":[{"text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenvalues, from that end","type":"text"},{"text":" ","type":"text"},{"text":"(ascending for the smallest, descending for the largest), and an orthonormal eigenvector for","type":"text"},{"text":" ","type":"text"},{"text":"each, with one entry per vertex.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Eigenpairs"}],"t