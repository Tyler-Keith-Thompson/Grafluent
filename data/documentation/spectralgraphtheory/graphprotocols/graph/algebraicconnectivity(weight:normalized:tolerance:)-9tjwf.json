{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:)-9tjwf"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(weight:normalized:tolerance:)-9tjwf","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The algebraic connectivity λ₂: the second smallest eigenvalue of the Laplacian L (of the"},{"type":"text","text":" "},{"type":"text","text":"normalized Laplacian N with "},{"code":"normalized","type":"codeVoice"},{"type":"text","text":"), 0 exactly when the graph is not connected (a"},{"type":"text","text":" "},{"type":"text","text":"weight-0 edge does not connect). NetworkX "},{"code":"algebraic_connectivity","type":"codeVoice"},{"type":"text","text":"; Fiedler 1973."}],"kind":"symbol","metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"title":"algebraicConnectivity(weight:normalized:tolerance:)","remoteSource":{"fileName":"FiedlerVector.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/FiedlerVector.swift#L111"},"extendedModule":"GraphProtocols","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21algebraicConnectivity6weight10normalized9toleranceSdqd__5Edges_5IndexQZXE_SbSdtSzRd__lF"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1e-8) -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","preciseIdentifier":"s:Sz","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected","type":"text"},{"text":" ","type":"text"},{"text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with","type":"text"},{"text":" ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a","type":"text"},{"text":" ","type":"text"},{"text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is","type":"text"},{"text":" ","type":"text"},{"text":"accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ₂, so λ₂ is relative to itself however","type":"text"},{"text":" ","type":"text"},{"text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The","type":"text"},{"text":" ","type":"text"},{"text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s (34 n from 5,000","type":"text"},{"text":" ","type":"text"},{"text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the","type":"text"},{"text":" ","type":"text"},{"text":"solver.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Traps when the work limit is spent: 4,000 + 20√n products on σI − L (then shift-invert),","type":"text"},{"text":" ","type":"text"},{"text":"1,000 shift-invert products, 20,000 + 2n per solve. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached it in the measurements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"At least two vertices, and "},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":". Every weight is finite and nonnegative."}],"type":"paragraph"}],"style":"note","name":"Precondition"}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"abstract":[],"url":"\/documentation\/spectralgraphtheory","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","type":"topic","title":"SpectralGraphTheory"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/algebraicConnectivity(weight:normalized:tolerance:)-9tjwf":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:)-9tjwf","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"algebraicConnectivity"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"normaliz