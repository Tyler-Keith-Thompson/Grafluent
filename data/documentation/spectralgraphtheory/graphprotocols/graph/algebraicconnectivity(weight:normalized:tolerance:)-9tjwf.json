{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(weight:normalized:tolerance:)-9tjwf"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:)-9tjwf"]}],"abstract":[{"text":"The algebraic connectivity λ₂: the second smallest eigenvalue of the Laplacian L (of the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian N with ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":"), 0 exactly when the graph is not connected (a","type":"text"},{"text":" ","type":"text"},{"text":"weight-0 edge does not connect). NetworkX ","type":"text"},{"code":"algebraic_connectivity","type":"codeVoice"},{"text":"; Fiedler 1973.","type":"text"}],"metadata":{"extendedModule":"GraphProtocols","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifie