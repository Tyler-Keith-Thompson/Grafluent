{"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"roleHeading":"Instance Method","remoteSource":{"fileName":"Eigenpairs.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L564"},"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE29normalizedLaplacianEigenpairs8smallest9tolerance13maxIterationsAD0G0VyxGSi_SdSiSgtAA13NoConvergenceVYKF","title":"normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)","extendedModule":"GraphProtocols","role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalizedLaplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","text":"Eigenpairs","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"The k smallest eigenvalues of the normalized Laplacian N (","type":"text"},{"type":"codeVoice","code":"normalizedLaplacianMatrix()"},{"text":"), k","type":"text"},{"text":" ","type":"text"},{"text":"= ","type":"text"},{"code":"smallest","type":"codeVoice"},{"text":", ascending, each with a unit eigenvector (see ","type":"text"},{"code":"Eigenpairs","type":"codeVoice"},{"text":").","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/normalizedlaplacianeigenpairs(smallest:tolerance:maxiterations:)"]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"normalizedLaplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil) "},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","text":"Eigenpairs","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"parameters":[{"name":"smallest","content":[{"inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"text":"The residual a Ritz pair must reach, relative as described above.","type":"text"}]}]},{"name":"maxIterations","content":[{"inlineContent":[{"text":"The matrix–vector products each Lanczos run may spend; nil for the limits","type":"text"},{"text":" ","type":"text"},{"text":"under Throws.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Component by component: each component’s null vector first (eigenvalue 0, components in"},{"text":" ","type":"text"},{"type":"text","text":"order of their least vertex), then the smallest positive eigenvalues of the components"},{"type":"text","text":" "},{"type":"text","text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full"},{"type":"text","text":" "},{"type":"text","text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:"},{"type":"text","text":" "},{"type":"text","text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each"},{"type":"text","text":" "},{"type":"text","text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz"},{"type":"text","text":" "},{"type":"text","text":"pair is accepted when its residual is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" · λ, relative to itself as for"},{"type":"text","text":" "},{"code":"algebraicConnectivity","type":"codeVoice"},{"type":"text","text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each"},{"type":"text","text":" "},{"type":"text","text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller"},{"type":"text","text":" "},{"type":"text","text":"component, or when k is a third of it or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"smallest"},{"text":" is in ","type":"text"},{"type":"codeVoice","code":"0...vertexCount"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tolerance > 0"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"when given, is at least 1.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" when a Lanczos run by shift-invert spends ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" products","type":"text"},{"text":" ","type":"text"},{"text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without","type":"text"},{"text":" ","type":"text"},{"text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n products or ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":", whichever is smaller. The dense solver throws as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"laplacianSpectrum"},{"text":" does.","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","abstract":[{"type":"text","text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenvalues, from that end"},{"type":"text","text":" "},{"type":"text","text":"(ascending for the smallest, descending for the largest), and an orthonormal eigenvector for"},{"type":"text","text":" "},{"type":"text","text":"each, with one entry per vertex."}],"url":"\/documentation\/spectralgraphtheory\/eigenpairs","title":"Eigenpairs","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Eigenpairs"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eigenpairs"}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/normalizedlaplacianeigenpairs(smallest:tolerance:maxiterations:)","abstract":[{"text":"The k smallest eigenvalues of the normalized Laplacian N (","type":"text"},{"type":"codeVoice","code":"normalizedLaplacianMatrix()"},{"text":"), k","type":"text"},{"text":" ","type":"text"},{"text":"= ","type":"text"},{"type":"codeVoice","code":"smallest"},{"text":", ascending, each with a unit eigenvector (see ","type":"text"},{"type":"codeVoice","code":"Eigenpairs"},{"text":").","type":"text"}],"title":"normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalizedLaplacianEigenpairs"},{"kind":"text","text":"("},{"kind":"externalParam","text":"smallest"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","text":"Eigenpairs"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","role":"symbol","abstract":[],"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","url":"\/documentation\/spectralgraphtheory\/graphpro