"},{"type":"codeVoice","code":"normalizedLaplacianMatrix()"},{"type":"text","text":"), k"},{"type":"text","text":" "},{"type":"text","text":"= "},{"type":"codeVoice","code":"smallest"},{"type":"text","text":", ascending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"role":"symbol","title":"normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","type":"topic","url":"\/documentation\/spectralgraphtheory","abstract":[],"role":"collection","title":"SpectralGraphTheory"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","kind":"symbol","abstract":[],"role":"collection","title":"GraphProtocols"}}}