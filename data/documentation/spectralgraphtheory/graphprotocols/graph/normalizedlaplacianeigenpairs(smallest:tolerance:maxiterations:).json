tralGraphTheory","relatedModules":["GraphProtocols"]}],"role":"symbol","symbolKind":"method"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/normalizedlaplacianeigenpairs(smallest:tolerance:maxiterations:)"]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalizedLaplacianEigenpairs"},{"kind":"text","text":"("},{"kind":"externalParam","text":"smallest"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"smallest","content":[{"type":"paragraph","inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"tolerance","content":[{"inlineContent":[{"text":"The residual a Ritz pair must reach, relative as described above.","type":"text"}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"text":"The matrix–vector products each Lanczos run may spend; nil for the limits","type":"text"},{"text":" ","type":"text"},{"text":"under Throws.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component by component: each component’s null vector first (eigenvalue 0, components in"},{"type":"text","text":" "},{"type":"text","text":"order of their least vertex), then the smallest positive eigenvalues of the components"},{"type":"text","text":" "},{"type":"text","text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full"},{"type":"text","text":" "},{"type":"text","text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:"},{"type":"text","text":" "},{"type":"text","text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each"},{"type":"text","text":" "},{"type":"text","text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz"},{"type":"text","text":" "},{"type":"text","text":"pair is accepted when its residual is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" · λ, relative to itself as for"},{"type":"text","text":" "},{"code":"algebraicConnectivity","type":"codeVoice"},{"type":"text","text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each"},{"type":"text","text":" "},{"type":"text","text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller"},{"type":"text","text":" "},{"type":"text","text":"component, or when k is a third of it or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"smallest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"when given, is at least 1."}]}],"name":"Precondition"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" when a Lanczos run by shift-invert spends ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" products","type":"text"},{"text":" ","type":"text"},{"text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without","type":"text"},{"text":" ","type":"text"},{"text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n products or ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":", whichever is smaller. The dense solver throws as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"laplacianSpectrum"},{"text":" does.","type":"text"}]}],"name":"Throws"}]}],"sections":[],"kind":"symbol","references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalizedLaplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","text":"Eigenpairs"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","abstract":[{"type":"text","text":"The k smallest eigenvalues of the normalized Laplacian N ("},{"code":"normalizedLaplacianMatrix()","type":"codeVoice"},{"type":"text","text":"), k"},{"type":"text","text":" "},{"type":"text","text":"= "},{"code":"smallest","type":"codeVoice"},{"type":"text","text":", ascending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"url":"\/documentation\/s