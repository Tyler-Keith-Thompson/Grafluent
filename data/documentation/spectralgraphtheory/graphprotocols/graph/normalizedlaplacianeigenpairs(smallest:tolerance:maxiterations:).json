{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/normalizedLaplacianEigenpairs(smallest:tolerance:maxIterations:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/normalizedlaplacianeigenpairs(smallest:tolerance:maxiterations:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalizedLaplacianEigenpairs"},{"kind":"text","text":"("},{"kind":"externalParam","text":"smallest"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","text":"Eigenpairs"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"smallest","content":[{"inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}]}]},{"name":"maxIterations","content":[{"inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for the limits"},{"type":"text","text":" "},{"type":"text","text":"under Throws."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Component by component: each component’s null vector first (eigenvalue 0, components in","type":"text"},{"text":" ","type":"text"},{"text":"order of their least vertex), then the smallest positive eigenvalues of the components","type":"text"},{"text":" ","type":"text"},{"text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full","type":"text"},{"text":" ","type":"text"},{"text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:","type":"text"},{"text":" ","type":"text"},{"text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each","type":"text"},{"text":" ","type":"text"},{"text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz","type":"text"},{"text":" ","type":"text"},{"text":"pair is accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ, relative to itself as for","type":"text"},{"text":" ","type":"text"},{"code":"algebraicConnectivity","type":"codeVoice"},{"text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each","type":"text"},{"text":" ","type":"text"},{"text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller","type":"text"},{"text":" ","type":"text"},{"text":"component, or when k is a third of it or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}]},{"type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"smallest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"when given, is at least 1."}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run by shift-invert spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products"},{"type":"text","text":" "},{"type":"text","text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without"},{"type":"text","text":" "},{"type":"text","text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n products or "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", whichever is smaller. The dense solver throws as"},{"type":"text","text":" "},{"type":"codeVoice","code":"laplacianSpectrum"},{"type":"text","text":" does."}]}],"style":"note"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/Spectral