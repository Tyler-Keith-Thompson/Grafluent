s finite,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" products without","type":"text"},{"text":" ","type":"text"},{"text":"converging, with the products spent and the largest Ritz residual on the tolerance’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"code":"adjacencySpectrum","type":"codeVoice"},{"text":" does.","type":"text"}]}],"type":"aside","style":"note"}]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/adjacencyEigenpairs(smallest:weight:tolerance:maxIterations:)-2ye38","interfaceLanguage":"swift"},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"url":"\/documentation\/spectralgraphtheory\/eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","title":"Eigenpairs","kind":"symbol","abstract":[{"type":"text","text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenvalues, from that end"},{"type":"text","text":" "},{"type":"text","text":"(ascending for the smallest, descending for the largest), and an orthonormal eigenvector for"},{"type":"text","text":" "},{"type":"text","text":"each, with one entry per vertex."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Eigenpairs","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eigenpairs","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/document