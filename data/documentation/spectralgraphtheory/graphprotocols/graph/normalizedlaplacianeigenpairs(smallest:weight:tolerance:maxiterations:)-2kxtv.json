{"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/normalizedLaplacianEigenpairs(smallest:weight:tolerance:maxIterations:)-2kxtv","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"normalizedLaplacianEigenpairs","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","text":"Eigenpairs","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SB","text":"BinaryFloatingPoint","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"smallest","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of eigenpairs, in "},{"code":"0...vertexCount","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weight of the edge at each position."}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}]}]},{"name":"maxIterations","content":[{"inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for the limits"},{"type":"text","text":" "},{"type":"text","text":"under Throws."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The eigenpairs, in order from that end of the spectrum.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component by component: each component’s null vector first (eigenvalue 0, components in"},{"type":"text","text":" "},{"type":"text","text":"order of their least vertex), then the smallest positive eigenvalues of the components"},{"type":"text","text":" "},{"type":"text","text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full"},{"type":"text","text":" "},{"type":"text","text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:"},{"type":"text","text":" "},{"type":"text","text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each"},{"type":"text","text":" "},{"type":"text","text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz"},{"type":"text","text":" "},{"type":"text","text":"pair is accepted when its residual is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · λ, relative to itself as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"algebraicConnectivity"},{"type":"text","text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each"},{"type":"text","text":" "},{"type":"text","text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller"},{"type":"text","text":" "},{"type":"text","text":"component, or when k is a third of it or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"smallest"},{"text":" is in ","type":"text"},{"type":"codeVoice","code":"0...vertexCount"},{"text":", ","type":"text"},{"type":"codeVoice","code":"tolerance > 0"},{"text":", every weight is finite","type":"text"},{"text":" ","type":"text"},{"text":"and nonnegative, and ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run by shift-invert spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" products","type":"text"},{"text":" ","type":"text"},{"text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without","type":"text"},{"text":" ","type":"text"},{"text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n products or ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", whichever is smaller. The dense solver throws as","type":"text"},{"text":" ","type":"text"},{"code":"laplacianSpectrum","type":"codeVoice"},{"text":" does.","type":"text"}]}]}]}],"metadata":{"title":"normalizedLaplacianEigenpairs(smallest:weight:tolerance:maxIterations:)","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE29normalizedLaplacianEigenpairs8smallest6weight9tolerance13maxIterationsAD0G0VyxGSi_qd__5Edges_5IndexQZXESdSiSgtAA13NoConvergenceVYKSBRd__lF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L650","fileName":"Eigenpairs.swift"},"modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalizedLaplacianEigenpairs"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"ex