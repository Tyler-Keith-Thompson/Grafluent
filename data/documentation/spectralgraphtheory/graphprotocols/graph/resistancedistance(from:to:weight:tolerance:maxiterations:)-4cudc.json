\/ r($0) }"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resistanceDistance"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-10, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil