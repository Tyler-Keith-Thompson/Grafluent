raph","inlineContent":[{"text":"","type":"text"},{"code":"source","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" are vertices of the graph, every weight is finite and","type":"text"},{"text":" ","type":"text"},{"text":"nonnegative, ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" conjugate-gradient iterations (one"},{"type":"text","text":" "},{"type":"text","text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm"},{"type":"text","text":" "},{"type":"text","text":"relative to the right-hand side’s. No input has reached the default limit in the"},{"type":"text","text":" "},{"type":"text","text":"measurements."}]}],"style":"note","name":"Throws"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"title":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","abstract":[],"type":"topic","role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","abstract":[],"title":"GraphProtocols","kind":"s