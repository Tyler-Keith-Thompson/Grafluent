{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"The resistance distance between "},{"code":"source","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" (Klein and Randić 1993): the effective","type":"text"},{"text":" ","type":"text"},{"text":"resistance between them when each edge is a conductance (its weight; 1 without ","type":"text"},{"code":"weight:","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any weight;","type":"text"},{"text":" ","type":"text"},{"text":"nil when they lie in different components. Symmetric. To read weights as resistances","type":"text"},{"text":" ","type":"text"},{"text":"instead, pass ","type":"text"},{"code":"{ 1 \/ r($0) }","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"role":"symbol","modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resistanceDistance","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":"