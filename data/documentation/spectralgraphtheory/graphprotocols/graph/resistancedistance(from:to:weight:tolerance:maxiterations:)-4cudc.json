"},{"text":" ","type":"text"},{"text":"position, also outside the component); a weight of 0 is no edge.","type":"text"}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target","type":"codeVoice"},{"type":"text","text":" are vertices of the graph, every weight is finite and"},{"type":"text","text":" "},{"type":"text","text":"nonnegative, "},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":", and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", when given, is at least 1."}]}],"style":"note","type":"aside"},{"name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" conjugate-gradient iterations (one","type":"text"},{"text":" ","type":"text"},{"text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm","type":"text"},{"text":" ","type":"text"},{"text":"relative to the right-hand side’s. No input has reached the default limit in the","type":"text"},{"text":" ","type":"text"},{"text":"measurements.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"metadata":{"title":"resistanceDistance(from:to:weight:tolerance:maxIterations:)","role":"symbol","symbolKind":"method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE18resistanceDistance4from2to6weight9tolerance13maxIterationsSdSg6VertexQz_AMqd__5Edges_5IndexQZXESdSiSgtAA13NoConvergenceVYKSBRd__lF","roleHeading":"Instance Method","remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L197"},"modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"fragme