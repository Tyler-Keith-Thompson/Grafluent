ble","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryFloatingPoint","kind":"typeIdentifier","preciseIdentifier":"s:SB"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Conjugate gradients on the Laplacian grounded at ","type":"text"},{"type":"codeVoice","code":"target"},{"text":", from 0, until the residual’s","type":"text"},{"text":" ","type":"text"},{"text":"Euclidean norm is at most ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":" (relative to the right-hand side, which has norm 1),","type":"text"},{"text":" ","type":"text"},{"text":"or, on a weight spread that puts that below rounding, until the true residual stops","type":"text"},{"text":" ","type":"text"},{"text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky","type":"text"},{"text":" ","type":"text"},{"text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for","type":"text"},{"text":" ","type":"text"},{"text":"the factor when it is built.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives the conductance of the edge at each position, read once per position (every"},{"type":"text","text":" "},{"type":"text","text":"position, also outside the component); a weight of 0 is no edge."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target","type":"codeVoice"},{"type":"text","text":" are vertices of the graph, every weight is finite and"},{"type":"text","text":" "},{"type":"text","text":"nonnegative, "},{"code":"tolerance > 0","type":"codeV