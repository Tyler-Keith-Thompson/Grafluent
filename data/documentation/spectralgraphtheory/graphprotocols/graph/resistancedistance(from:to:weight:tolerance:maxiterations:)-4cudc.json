{"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the effective"},{"type":"text","text":" "},{"type":"text","text":"resistance between them when each edge is a conductance (its weight; 1 without "},{"type":"codeVoice","code":"weight:"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any weight;","type":"text"},{"text":" ","type":"text"},{"text":"nil when they lie in different components. Symmetric. To read weights as resistances","type":"text"},{"text":" ","type":"text"},{"text":"instead, pass ","type":"text"},{"code":"{ 1 \/ r($0) }","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"metadata":{"title":"resistanceDistance(from:to:weight:tolerance:maxIterations:)","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"extendedModule":"GraphProtocols","role":"symbol","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE18resistanceDistance4from2to6weight9tolerance13maxIterationsSdSg6VertexQz_AMqd__5Edges_5IndexQZXESdSiSgtAA13NoConvergenceVYKSBRd__lF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resistanceDistance"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProto