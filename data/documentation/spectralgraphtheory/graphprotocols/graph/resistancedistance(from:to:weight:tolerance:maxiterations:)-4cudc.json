tion, read once per position (every"},{"type":"text","text":" "},{"type":"text","text":"position, also outside the component); a weight of 0 is no edge."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices of the graph, every weight is finite and"},{"type":"text","text":" "},{"type":"text","text":"nonnegative, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" conjugate-gradient iterations (one"},{"type":"text","text":" "},{"type":"text","text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm"},{"type":"text","text":" "},{"type":"text","text":"relative to the right-hand side’s. No input has reached the default limit in the"},{"type":"text","text":" "},{"type":"text","text":"measurements."}]}],"name":"Throws","style":"note"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"The resistance distance between "},{"code":"source","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target","type":"codeVoice"},{"type":"text","text":" (Klein and Randić 1993): the effective"},{"type":"text","text":" "},{"type":"text","text":"resistance between them when each edge is a conductance (its weight; 1 without "},{"code":"weight:","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any wei