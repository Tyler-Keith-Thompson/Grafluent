aph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryFloatingPoint","preciseIdentifier":"s:SB"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"largest","content":[{"inlineContent":[{"type":"text","text":"The number of eigenpairs, in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weight of the edge at each position."}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}]}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a","type":"text"},{"text":" ","type":"text"},{"text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks","type":"text"},{"text":" ","type":"text"},{"text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual","type":"text"},{"text":" ","type":"text"},{"text":"is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors","type":"text"},{"text":" ","type":"text"},{"text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64","type":"text"},{"text":" ","type":"text"},{"text":"vertices, or when k is a third of them or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"asi