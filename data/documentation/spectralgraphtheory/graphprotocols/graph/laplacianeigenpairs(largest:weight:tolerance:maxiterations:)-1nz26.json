ote"}],"kind":"content"}],"metadata":{"title":"laplacianEigenpairs(largest:weight:tolerance:maxIterations:)","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE19laplacianEigenpairs7largest6weight9tolerance13maxIterationsAD0F0VyxGSi_qd__5Edges_5IndexQZXESdSiSgtAA13NoConvergenceVYKSBRd__lF","remoteSource":{"fileName":"Eigenpairs.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L525"},"modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"laplacianEigenpairs"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"largest"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> 