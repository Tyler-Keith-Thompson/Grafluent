":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a","type":"text"},{"text":" ","type":"text"},{"text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks","type":"text"},{"text":" ","type":"text"},{"text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual","type":"text"},{"text":" ","type":"text"},{"text":"is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors","type":"text"},{"text":" ","type":"text"},{"text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64","type":"text"},{"text":" ","type":"text"},{"text":"vertices, or when k is a third of them or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"largest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", every weight is finite","type":"text"},{"text":" ","type":"text"},{"text":"and nonnegative, and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}]}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}],"style":"note","name":"Throws","type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/laplacianEigenpairs(largest:weight:tolerance:maxIterations:)-1nz26"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","title":"NoConvergence","role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges",