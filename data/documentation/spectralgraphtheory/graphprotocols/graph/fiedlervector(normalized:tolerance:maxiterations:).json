{"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"type":"text","text":"The Fiedler vector: λ₂ and a unit eigenvector of it, with the canonical sign (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"FiedlerVector"},{"type":"text","text":"); nil when the graph is not connected."}],"kind":"symbol","variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/fiedlervector(normalized:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fiedlerVector","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"FiedlerVector","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory13FiedlerVectorV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"title":"fiedlerVector(normalized:tolerance:maxIterations:)","roleHeading":"Instance Method","remoteSource":{"fileName":"FiedlerVector.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/FiedlerVector.swift#L195"},"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE13fiedlerVector10normalized9tolerance13maxIterationsAD07FiedlerF0VyxGSgSb_SdSiSgtAA13NoConvergenceVYKF","role":"symbol"},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/fiedlerVector(normalized:tolerance:maxIterations:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fiedlerVector","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"FiedlerVector","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/FiedlerVector","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory13FiedlerVectorV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At least two vertices, "},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":", and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", when given, is"},{"type":"text","text":" "},{"type":"text","text":"at least 1."}]}]},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when the Lanczos run on L⁺ spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" matrix–vector","type":"text"},{"text":" ","type":"text"},{"text":"products (1,000 when nil) without converging, with the products spent and the Ritz","type":"text"},{"text":" ","type":"text"},{"text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to","type":"text"},{"text":" ","type":"text"},{"text":"shift-invert rather than throwing, after 4,000 + 20√n products or ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,","type":"text"},{"text":" ","type":"text"},{"text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the","type":"text"},{"text":" ","type":"text"},{"text":"dense solver answers and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is unused. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached the default limits in the measurements.","type":"text"}]}]}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","kind":"symbol","type":"topic","role":"collection","title":"GraphProtocols","abstract":[],"url":"\/documentation\/spectralgraphtheory\/graphprotocols"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/fiedlerVector(normalized:tolerance:maxIterations:)":{"title":"fiedlerVector(normalized:tolerance:maxIterations:)","kind":"symbol","abstract":[{"text":"The Fiedler vector: λ₂ and a unit eigenvector of it, with the canonical sign (see","type":"text"},{"text":" ","type":"text"},{"code":"FiedlerVector","type":"codeVoice"},{"text":"); nil when the graph is not connected.","type":"text"}],"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/fiedlerVector(normalized:tolerance:maxIterations:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fiedlerVector"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory13FiedlerVectorV","text":"FiedlerVector"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/fiedlervector(normalized:tolerance:maxiterations:)","role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/FiedlerVector":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/FiedlerVector","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FiedlerVector"}],"kind":"symbol","type":"topic","role":"symbol","title":"FiedlerVector","navigatorTitle":[{"kind":"identifier","text":"FiedlerVector"}],"abstract":[{"text":"The Fiedler vector of a connected graph: a unit eigenvector of λ₂, the algebraic","type":"text"},{"text":" ","type":"text"},{"text":"connectivity, of the Laplacian (or of the normalized Laplacian), with one entry per vertex.","type":"text"}],"url":"\/documentation\/spectralgraphtheory\/fiedlervector"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"title":"Graph","kind":"symbol","abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","type":"topic","role":"collection","title":"SpectralGraphTheory","abstract":[],"url":"\/documentation\/spectralgraphtheory"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"title":"NoConvergence","kind":"symbol","abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule."}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/noconvergence","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"role":"symbol"}}}