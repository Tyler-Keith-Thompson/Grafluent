ce","type":"codeVoice"},{"text":"; NetworkX raises ","type":"text"},{"code":"PowerIterationFailedConvergence","type":"codeVoice"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"code":"ArpackNoConvergence","type":"codeVoice"},{"text":" in the same place.","type":"text"}],"role":"symbol"}}}