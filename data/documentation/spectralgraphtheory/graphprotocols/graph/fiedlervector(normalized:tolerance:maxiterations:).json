:"SpectralGraphTheory"}]},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"abstract":[{"text":"The Fiedler vector: λ₂ and a unit eigenvector of it, with the canonical sign (see","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FiedlerVector"},{"text":"); nil when the graph is not connected. NetworkX ","type":"text"},{"type":"codeVoice","code":"fiedler_vector"},{"text":".","type":"text"}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fiedlerVector","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:19SpectralGraphTheory13FiedlerVectorV","text":"FiedlerVector","kind":"typeIdentifier","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/FiedlerVector"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"code":"normalized","type":"codeVoice"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"At least two vertices, ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is","type":"text"},{"text":" ","type":"text"},{"text":"at least 1.","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when the Lanczos run on L⁺ spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" matrix–vector","type":"text"},{"text":" ","type":"text"},{"text":"products (1,000 when nil) without converging, with the products spent and the Ritz","type":"text"},{"text":" ","type":"text"},{"text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to","type":"text"},{"text":" ","type":"text"},{"text":"shift-invert rather than throwing, after 4,000 + 20√n products or ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,","type":"text"},{"text":" ","type":"text"},{"text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the","type":"text"},{"text":" ","type":"text"},{"text":"dense solver answers and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is unused. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached the default limits in the measurements.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it spends its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos","type":"text"},{"text":" ","type":"text"},{"text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ComputationInfo::NoConvergence"},{"text":"; NetworkX raises ","type":"text"},{"type":"codeVoice","code":"PowerIterationFailedConvergence"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ArpackNoConvergence"},{"text":" in the same place.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphprotocols\/noconvergence","title":"NoConvergence","type":"topic"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/fiedlerVector(normalized:tolerance:maxIterations:)":{"abstract":[{"text":"The Fiedler vector: λ₂ and a unit eigenvector of it, with the canonical sign (see","type":"text"},{"text":" ","type":"text"},{"code":"FiedlerVector","type":"codeVoice"},{"text":"); nil when the graph is not connected. NetworkX ","type":"text"},{"code":"fiedler_vector","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"fiedlerVector(normalized:tolerance:maxIterations:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fiedlerVector","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"FiedlerVector","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory13Fiedl