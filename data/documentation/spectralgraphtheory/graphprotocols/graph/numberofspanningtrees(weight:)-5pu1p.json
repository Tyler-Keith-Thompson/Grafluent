{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees(weight:)-5pu1p"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees(weight:)-5pu1p"]}],"abstract":[{"text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of","type":"text"},{"text":" ","type":"text"},{"text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem).","type":"text"},{"text":" ","type":"text"},{"text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a","type":"text"},{"text":" ","type":"text"},{"text":"disconnected one, 1 for one vertex. NetworkX ","type":"text"},{"code":"number_of_spanning_trees","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"title":"numberOfSpanningTrees(weight:)","symbolKind":"method","remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L41"},"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTrees6weightSdqd__5Edges_5IndexQZXE_tSzRd__lF","extendedModule":"GraphProtocols","role":"symbol"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Double"},{"type":"text","text":": counts pass "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed"},{"type":"text","text":" "},{"type":"text","text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of"},{"type":"text","text":" "},{"type":"text","text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶"},{"type":"text","text":" "},{"type":"text","text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it"},{"type":"text","text":" "},{"type":"text","text":"overflows only past "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"’s range, to "},{"type":"codeVoice","code":".infinity"},{"type":"text","text":". When every weight is an integer"},{"type":"text","text":" "},{"type":"text","text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two"},{"type":"text","text":" "},{"type":"text","text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded"},{"type":"text","text":" "},{"type":"text","text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/numberOfSpanningTrees(weight:)-5pu1p":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees(weight:)-5pu1p","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpa