/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" ","kind":"text"},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryInteger","preciseIdentifier":"s:Sz"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":": counts pass ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed","type":"text"},{"text":" ","type":"text"},{"text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of","type":"text"},{"text":" ","type":"text"},{"text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶","type":"text"},{"text":" ","type":"text"},{"text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it","type":"text"},{"text":" ","type":"text"},{"text":"overflows only past ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"’s range, to ","type":"text"},{"code":".infinity","type":"codeVoice"},{"text":". When every weight is an integer","type":"text"},{"text":" ","type":"text"},{"text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two","type":"text"},{"text":" ","type":"text"},{"text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded","type":"text"},{"text":" ","type":"text"},{"text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"inlineContent":[{"code":"numberOfSpanningTrees(as: UInt128.self, weight:)","type":"codeVoice"},{"type":"text","text":" returns the exact count."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Precondition"}]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of"},{"type":"text","text":" "},{"type":"text","text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem)."},{"type":"text","text":" "},{"type":"text","text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a"},{"type":"text","text":" "},{"type":"text","text":"disconnected one, 1 for one vertex."}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees(weight:)-5pu1p","interfaceLanguage":"swift"},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","abstract":[],"url":"\/documentation\/spectralgraphtheory","role":"collection","type":"topic","kind":"symbol","title":"Sp