{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sz","kind":"typeIdentifier","text":"BinaryInteger"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":": counts pass ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed","type":"text"},{"text":" ","type":"text"},{"text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of","type":"text"},{"text":" ","type":"text"},{"text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶","type":"text"},{"text":" ","type":"text"},{"text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it","type":"text"},{"text":" ","type":"text"},{"text":"overflows only past ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"’s range, to ","type":"text"},{"code":".infinity","type":"codeVoice"},{"text":". When every weight is an integer","type":"text"},{"text":" ","type":"text"},{"text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two","type":"text"},{"text":" ","type":"text"},{"text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded","type":"text"},{"text":" ","type":"text"},{"text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}]},{"type":"aside","name":"Precondition","content":[{"inlineContent":[{"text":"Every weight is finite and nonnegative.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"metadata":{"extendedModule":"GraphProtocols","title":"numberOfSpanningTrees(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"symbolKind":"method","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTrees6weightSdqd__5Edges_5IndexQZXE_tSzRd__lF","role":"symbol","remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L41"}},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees(weight:)-5pu1p"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees(weight:)-5pu1p"},"abstract":[{"text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of","type":"text"},{"text":" ","type":"text"},{"text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem).","type":"text"},{"text":" ","type":"text"},{"text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a","type":"text"},{"text":" ","type":"text"},{"text":"disconnected one, 1 for one vertex. NetworkX ","type":"text"},{"code":"number_of_spanning_trees","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"title":"SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","type":"topic","kind":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","abstract":[],"role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphThe