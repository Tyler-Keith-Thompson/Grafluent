nse Cholesky factorization of the"},{"type":"text","text":" "},{"type":"text","text":"Laplacian with one vertex removed, its pivots multiplied with the binary exponent kept apart,"},{"type":"text","text":" "},{"type":"text","text":"so the result overflows only past "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"’s range, to "},{"code":".infinity","type":"codeVoice"},{"type":"text","text":". When every weight is an"},{"type":"text","text":" "},{"type":"text","text":"integer (unweighted included) a result below 2⁵³ is rounded to the nearest integer, which is"},{"type":"text","text":" "},{"type":"text","text":"then exact; nearer to 2⁵³ and above, it is within a relative 10⁻¹² or so, not exact. O(n³) time,"},{"type":"text","text":" "},{"type":"text","text":"n² "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}],"type":"paragraph"}],"name":"Precondition","type":"aside"}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/numberOfSpanningTrees(weight:)-5pu1p":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"