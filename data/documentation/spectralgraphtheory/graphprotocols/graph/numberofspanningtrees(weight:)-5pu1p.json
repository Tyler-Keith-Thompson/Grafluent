{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"abstract":[{"text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of","type":"text"},{"text":" ","type":"text"},{"text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem).","type":"text"},{"text":" ","type":"text"},{"text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a","type":"text"},{"text":" ","type":"text"},{"text":"disconnected one, 1 for one vertex.","type":"text"}],"metadata":{"symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L44","fileName":"ElectricalNetworks.swift"},"role":"symbol","title":"numberOfSpanningTrees(weight:)","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTrees6weightSdqd__5Edges_5IndexQZXE_tSzRd__lF"},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees(weight:)-5pu1p"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryInteger","preciseIdentifier":"s:Sz"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":": counts pass ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed","type":"text"},{"text":" ","type":"text"},{"text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of","type":"text"},{"text":" ","type":"text"},{"text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶","type":"text"},{"text":" ","type":"text"},{"text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it","type":"text"},{"text":" ","type":"text"},{"text":"overflows only past ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"’s range, to ","type":"text"},{"type":"codeVoice","code":".infinity"},{"text":". When every weight is an integer","type":"text"},{"text":" ","type":"text"},{"text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two","type":"text"},{"text":" ","type":"text"},{"text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded","type":"text"},{"text":" ","type":"text"},{"text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"numberOfSpanningTrees(as: UInt128.self, weight:)","type":"codeVoice"},{"type":"text","text":" returns the exact count."}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}]}],"type":"aside"}]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees(weight:)-5pu1p","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/numberOfSpanningTrees(weight:)-5pu1p":{"role":"symbol","title":"numberOfSpanningTrees(weight:)","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningt