{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees(weight:)-5pu1p"]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees(weight:)-5pu1p"},"abstract":[{"text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of","type":"text"},{"text":" ","type":"text"},{"text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem).","type":"text"},{"text":" ","type":"text"},{"text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a","type":"text"},{"text":" ","type":"text"},{"text":"disconnected one, 1 for one vertex. NetworkX ","type":"text"},{"code":"number_of_spanning_trees","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"numberOfSpanningTrees(weight:)","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTrees6weightSdqd__5Edges_5IndexQZXE_tSzRd__lF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"extendedModule":"GraphProtocols","remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L41"},"modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}]},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryInteger","preciseIdentifier":"s:Sz"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Double"},{"type":"text","text":": counts pass "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed"},{"type":"text","text":" "},{"type":"text","text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of"},{"type":"text","text":" "},{"type":"text","text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶"},{"type":"text","text":" "},{"type":"text","text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it"},{"type":"text","text":" "},{"type":"text","text":"overflows only past "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"’s range, to "},{"type":"codeVoice","code":".infinity"},{"type":"text","text":". When every weight is an integer"},{"type":"text","text":" "},{"type":"text","text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two"},{"type":"text","text":" "},{"type":"text","text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded"},{"type":"text","text":" "},{"type":"text","text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","title":"SpectralGraphTheory","abstract":[],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/