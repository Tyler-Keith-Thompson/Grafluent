Identifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"title":"spectralOrdering(weight:normalized:tolerance:maxIterations:)","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE16spectralOrdering6weight10normalized9tolerance13maxIterationsSay6VertexQzGqd__5Edges_5IndexQZXE_SbSdSiSgtAA13NoConvergenceVYKSzRd__lF","roleHeading":"Instance Method","symbolKind":"method"},"abstract":[{"type":"text","text":"The spectral ordering (Barnard, Pothen and Simon): the components in order of their least"},{"type":"text","text":" "},{"type":"text","text":"vertex index; a component of at most two vertices in index order; a larger one ascending by"},{"type":"text","text":" "},{"type":"text","text":"the Fiedler vector of that component (for a connected graph, "},{"type":"codeVoice","code":"fiedlerVector()"},{"type":"text","text":"’s), entries"},{"type":"text","text":" "},{"type":"text","text":"within 10⁻⁸ · max|x| of their predecessor kept in index order. "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" for the empty graph."}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","kind":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","abstract":[],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"type":"topic","kind":"symbol","title":"NoConvergence","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConv