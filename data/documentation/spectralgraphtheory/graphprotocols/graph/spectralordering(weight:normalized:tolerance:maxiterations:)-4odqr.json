Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(weight:normalized:tolerance:maxIterations:)-4odqr"},"abstract":[{"type":"text","text":"The spectral ordering (NetworkX "},{"type":"codeVoice","code":"spectral_ordering"},{"type":"text","text":"; Barnard, Pothen and Simon): the"},{"type":"text","text":" "},{"type":"text","text":"components in order of their least vertex index; a component of at most two vertices in"},{"type":"text","text":" "},{"type":"text","text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected"},{"type":"text","text":" "},{"type":"text","text":"graph, "},{"type":"codeVoice","code":"fiedlerVector()"},{"type":"text","text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in"},{"type":"text","text":" "},{"type":"text","text":"index order. "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" for the empty graph."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralOrdering","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"] ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","preciseIdentifier":"s:Sz","kind":"typeIdentifier"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected","type":"text"},{"text":" ","type":"text"},{"text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"normalized"},{"text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a","type":"text"},{"text":" ","type":"text"},{"text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is","type":"text"},{"text":" ","type":"text"},{"text":"accepted when its residual is at most ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":" · λ₂, so λ₂ is relative to itself however","type":"text"},{"text":" ","type":"text"},{"text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The","type":"text"},{"text":" ","type":"text"},{"text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s (34 n from 5,000","type":"text"},{"text":" ","type":"text"},{"text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the","type":"text"},{"text":" ","type":"text"},{"text":"solver.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":". Every weight is finite and nonnegative, and"},{"type":"text","text":" "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", when given, is at least 1."}]}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when the Lanczos run on L⁺ spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" matrix–vector"},{"type":"text","text":" "},{"type":"text","text":"products (1,000 when nil) without converging, with the products spent and the Ritz"},{"type":"text","text":" "},{"type":"text","text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to"},{"type":"text","text":" "},{"type":"text","text":"shift-invert rather than throwing, after 4,000 + 20√n products or "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,"},{"type":"text","text":" "},{"type":"text","text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the"},{"type":"text","text":" "},{"type":"text","text":"dense solver answers and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" is unused. Only a tolerance below rounding has"},{"type":"text","text":" "},{"type":"text","text":"reached the default limits in the measurements."}]}],"style":"note","type":"aside","name":"Throws"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralordering(weight:normalized:tolerance:maxiterations:)-4odqr"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"role":"symbol","abstract":[{"type":"text","text":"The error an iterative method throws when it spends its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos"},{"type":"text","text":" "},{"type":"text","text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"ComputationInfo::NoConvergence"},{"type":"text","text":"; NetworkX raises "},{"type":"codeVoice","code":"PowerIterationFailedConvergence"},{"type":"text","text":" and SciPy"},{"type":"text","text":" "},{"type":"codeVoice","code":"ArpackNoConvergence"},{"type":"text","text":" in the same place."}],"kind":"symbol","title":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoConvergence"}],"navigatorTitle":[{"kind":"identifier","text":"NoConvergence"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/spectralOrdering(weight:normalized:tolerance:maxIterations:)-4odqr":{"role":"symbol","abstract":[{"type":"text","text":"The spectral ordering (NetworkX "},{"type":"codeVoice","code":"spectral_ordering"},{"type":"text","text":"; Barnard, Pothen and Simon): the"},{"type":"text","text":" "},{"type":"text","text":"components in order of their least vertex index; a component of at most two vertices in"},{"type":"text","text":" "},{"type":"text","text":"index order; a larger one ascending by the Fiedler vector of that component (for a connected"},{"type":"text","text":" "},{"type":"text","text":"graph, "},{"type":"codeVoice","code":"fiedlerVector()"},{"type":"text","text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in"},{"type":"text","text":" "},{"type":"text","text":"index order. "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" for the empty gr