xt"},{"code":"ComputationInfo::NoConvergence","type":"codeVoice"},{"text":"; NetworkX raises ","type":"text"},{"code":"PowerIterationFailedConvergence","type":"codeVoice"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"code":"ArpackNoConvergence","type":"codeVoice"},{"text":" in the same place.","type":"text"}],"title":"NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","title":"Edges","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","abstract":[],"title":"SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"kind":"symbol","identifier":"doc:\