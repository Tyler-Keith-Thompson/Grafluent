for a connected"},{"type":"text","text":" "},{"type":"text","text":"graph, "},{"type":"codeVoice","code":"fiedlerVector()"},{"type":"text","text":"’s), entries within 10⁻⁸ · max|x| of their predecessor kept in"},{"type":"text","text":" "},{"type":"text","text":"index order. "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" for the empty graph."}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralOrdering(weight:normalized:tolerance:maxIterations:)-4odqr","kind":"symbol","role":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralordering(weight:normalized:tolerance:maxiterations:)-4odqr","type":"topic","title":"spectralOrdering(weight:normalized:tolerance:maxIterations:)"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"abstract":[],"kind":"symbol","title":"SpectralGraphTheory","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","type":"topic"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/spectralgraphtheory\/graphprotocols","title":"GraphProtocols","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"symbol","role":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","title":"Edges"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it spends its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos","type":"text"},{"text":" ","type":"text"},{"text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ComputationInfo::NoConvergence"},{"text":"; NetworkX raises ","type":"text"},{"type":"codeVoice","code":"PowerIterationFailedConvergence"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ArpackNoConvergence"},{"text":" in the same place.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphprotocols\/noconvergence","title":"NoConvergence","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","title":"Vertex"}}}