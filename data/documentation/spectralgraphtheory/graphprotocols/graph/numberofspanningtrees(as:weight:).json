{"abstract":[{"text":"The number of spanning trees τ(G), weighted and exactly: the sum over spanning trees of the","type":"text"},{"text":" ","type":"text"},{"text":"product of their weights, or nil when it is 2¹²⁸ or more. Loops never lie on a tree;","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges each count. 0 for the empty graph and for a disconnected one, 1 for one","type":"text"},{"text":" ","type":"text"},{"text":"vertex.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"as"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7UInt128V","text":"UInt128"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7UInt128V","text":"UInt128"},{"kind":"text","text":"? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"UInt128.self"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"type"},{"content":[{"inlineContent":[{"type":"text","text":"The weight of the edge at each position, read once per position; a weight of 0"},{"type":"text","text":" "},{"type":"text","text":"is no edge."}],"type":"paragraph"}],"name":"weight"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"text":"The weighted τ(G), or nil when it does not fit in ","type":"text"},{"type":"codeVoice","code":"UInt128"},{"text":".","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The determinant of the Laplacian with one vertex removed, modulo two or three 62-bit primes","type":"text"},{"text":" ","type":"text"},{"text":"and recombined by the Chinese remainder theorem; the ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" elimination of","type":"text"},{"text":" ","type":"text"},{"code":"numberOfSpanningTrees(weight:)","type":"codeVoice"},{"text":" first settles whether the count fits and how many primes","type":"text"},{"text":" ","type":"text"},{"text":"it needs. Weights are reduced modulo each prime as integers, so a weight past 2⁵³ counts","type":"text"},{"text":" ","type":"text"},{"text":"exactly.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n³) time (less on sparse graphs), n² words.","type":"text"}]}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"Every weight is nonnegative, and every weighted degree is finite as a","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/n