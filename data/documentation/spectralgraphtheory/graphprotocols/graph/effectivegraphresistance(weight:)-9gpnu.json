{"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"The effective graph resistance (the Kirchhoff index of Klein and Randić): the sum of"},{"type":"text","text":" "},{"type":"codeVoice","code":"resistanceDistance"},{"type":"text","text":" over unordered pairs of vertices, n · Σ_{i≥2} 1\/λᵢ over the Laplacian"},{"type":"text","text":" "},{"type":"text","text":"spectrum; nil when the graph is not connected, 0 for zero or one vertex. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"effective_graph_resistance"},{"type":"text","text":" (which returns ∞ when disconnected)."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effectiveGraphResistance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SB","text":"BinaryFloatingPoint","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"N · tr(L_g⁻¹) − 1ᵀ L_g⁻¹ 1 with L_g the Laplacian grounded at the vertex of largest degree,"},{"type":"text","text":" "},{"type":"text","text":"from its GTH elimination (as "},{"type":"codeVoice","code":"numberOfSpanningTrees"},{"type":"text","text":"): every term is a sum of positive ones,"},{"type":"text","text":" "},{"type":"text","text":"so the result keeps a relative accuracy of about n² · 10⁻¹⁶ under any weight spread, where"},{"type":"text","text":" "},{"type":"text","text":"n · Σ 1\/λᵢ over a dense spectrum loses it. O(n³) time, n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}],"type":"paragraph"},{"name":"Precondition","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/effectivegraphresistance(weight:)-9gpnu"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","metadata":{"role":"symbol","symbolKind":"method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE09effectiveA10Resistance6weightSdSgqd__5Edges_5IndexQZXE_tSBRd__lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effectiveGraphResistance","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"