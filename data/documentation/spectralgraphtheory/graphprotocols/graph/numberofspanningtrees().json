{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":": counts pass ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" quickly (K₂₅ has 25²³). A dense Cholesky factorization of the","type":"text"},{"text":" ","type":"text"},{"text":"Laplacian with one vertex removed, its pivots multiplied with the binary exponent kept apart,","type":"text"},{"text":" ","type":"text"},{"text":"so the result overflows only past ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"’s range, to ","type":"text"},{"code":".infinity","type":"codeVoice"},{"text":". When every weight is an","type":"text"},{"text":" ","type":"text"},{"text":"integer (unweighted included) a result below 2⁵³ is rounded to the nearest integer, which is","type":"text"},{"text":" ","type":"text"},{"text":"then exact; nearer to 2⁵³ and above, it is within a relative 10⁻¹² or so, not exact. O(n³) time,","type":"text"},{"text":" ","type":"text"},{"text":"n² ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of","type":"text"},{"text":" ","type":"text"},{"text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a"},{"type":"text","text":" "},{"type":"text","text":"disconnected one, 1 for one vertex. NetworkX "},{"type":"codeVoice","code":"number_of_spanning_trees"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"metadata":{"extendedModule":"GraphProtocols","remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L16"},"role":"symbol","symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"title":"numberOfSpanningTrees()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTreesSdyF"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees()"]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"url":"\/documentation\/spectralgraphtheory\/graphproto