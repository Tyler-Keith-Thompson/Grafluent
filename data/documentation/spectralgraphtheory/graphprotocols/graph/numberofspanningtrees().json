{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"role":"symbol","remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L19"},"modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","title":"numberOfSpanningTrees()","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTreesSdyF","symbolKind":"method"},"abstract":[{"type":"text","text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of"},{"type":"text","text":" "},{"type":"text","text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem)."},{"type":"text","text":" "},{"type":"text","text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a"},{"type":"text","text":" "},{"type":"text","text":"disconnected one, 1 for one vertex."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees()"]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees()"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Double"},{"type":"text","text":": counts pass "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed"},{"type":"text","text":" "},{"type":"text","text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of"},{"type":"text","text":" "},{"type":"text","text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶"},{"type":"text","text":" "},{"type":"text","text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it"},{"type":"text","text":" "},{"type":"text","text":"overflows only past "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"’s range, to "},{"type":"codeVoice","code":".infinity"},{"type":"text","text":". When every weight is an integer"},{"type":"text","text":" "},{"type":"text","text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two"},{"type":"text","text":" "},{"type":"text","text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded"},{"type":"text","text":" "},{"type":"text","text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."},{"type":"text","text":" "},{"type":"codeVoice","code":"numberOfSpanningTrees(as: UInt128.self)"},{"type":"text","text":" returns the exact count."}]}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/numberOfSpanningTrees()":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees()","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees()","abstract":[{"type":"text","text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of"},{"type":"text","text":" "},{"type":"text","text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem)."},{"type":"text","text":" "},{"type":"text","text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a"},{"type":"text","text":" "},{"type":"text","text":"disconnected one, 1 for one vertex."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"title":"numberOfSpanningTrees()","role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","title":"Graph","role":"symbol","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","type":"topic"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","kind":"symbol","role":"collection","type":"topic","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory","abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","title":"SpectralGraphTheory","role":"collection","type":"topic"}}}