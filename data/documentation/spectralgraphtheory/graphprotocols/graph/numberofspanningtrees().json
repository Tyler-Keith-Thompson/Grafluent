{"kind":"symbol","metadata":{"remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L18"},"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTreesSdyF","role":"symbol","title":"numberOfSpanningTrees()"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of"},{"type":"text","text":" "},{"type":"text","text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem)."},{"type":"text","text":" "},{"type":"text","text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a"},{"type":"text","text":" "},{"type":"text","text":"disconnected one, 1 for one vertex. NetworkX "},{"type":"codeVoice","code":"number_of_spanning_trees"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Double"},{"type":"text","text":": counts pass "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed"},{"type":"text","text":" "},{"type":"text","text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of"},{"type":"text","text":" "},{"type":"text","text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶"},{"type":"text","text":" "},{"type":"text","text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it"},{"type":"text","text":" "},{"type":"text","text":"overflows only past "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"’s range, to "},{"type":"codeVoice","code":".infinity"},{"type":"text","text":". When every weight is an integer"},{"type":"text","text":" "},{"type":"text","text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two"},{"type":"text","text":" "},{"type":"text","text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded"},{"type":"text","text":" "},{"type":"text","text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}]}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"role":"collection","url":"\/documentation\/spectralgraphtheory","kind":"symbol","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","abstract":[],"title":"SpectralGraphTheory"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","kind":"symbol","title":"Graph","abstract":[],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/numberOfSpanningTrees()":{"type":"topic","kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"numberOfSpanningTrees","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees()","abstract":[{"text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of","type":"text"},{"text":" ","type":"text"},{"text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem).","type":"text"},{"text":" ","type":"text"},{"text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a","type":"text"},{"text":" ","type":"text"},{"text":"disconnected one, 1 for one vertex. NetworkX ","type":"text"},{"code":"number_of_spanning_trees","type":"codeVoice"},{"text":".","type":"text"}],"title":"numberOfSpanningTrees()","role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"role":"collection