{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The number of spanning trees τ(G), weighted: the sum over spanning trees of the product of"},{"type":"text","text":" "},{"type":"text","text":"their weights, which is any cofactor of the Laplacian (Kirchhoff’s matrix-tree theorem)."},{"type":"text","text":" "},{"type":"text","text":"Loops never lie on a tree; parallel edges each count. 0 for the empty graph and for a"},{"type":"text","text":" "},{"type":"text","text":"disconnected one, 1 for one vertex. NetworkX "},{"code":"number_of_spanning_trees","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Double"},{"type":"text","text":": counts pass "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" quickly (K₂₅ has 25²³). The Laplacian with one vertex removed"},{"type":"text","text":" "},{"type":"text","text":"is eliminated densely as Grassmann, Taksar and Heyman eliminate (each pivot a sum of"},{"type":"text","text":" "},{"type":"text","text":"conductances, never a difference), so the count keeps a relative accuracy of about n · 10⁻¹⁶"},{"type":"text","text":" "},{"type":"text","text":"whatever the weights; its pivots are multiplied with the binary exponent kept apart, so it"},{"type":"text","text":" "},{"type":"text","text":"overflows only past "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"’s range, to "},{"type":"codeVoice","code":".infinity"},{"type":"text","text":". When every weight is an integer"},{"type":"text","text":" "},{"type":"text","text":"(unweighted included) and the count is below 2¹⁰⁰, it is computed exactly instead (two"},{"type":"text","text":" "},{"type":"text","text":"determinants modulo 62-bit primes, combined by the Chinese remainder theorem) and rounded"},{"type":"text","text":" "},{"type":"text","text":"once, so a count below 2⁵³ is exact. O(n³) time (less on sparse graphs), n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/numberOfSpanningTrees()","interfaceLanguage":"swift"},"metadata":{"role":"symbol","title":"numberOfSpanningTrees()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"numberOfSpanningTrees"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L18","fileName":"ElectricalNetworks.swift"},"modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21numberOfSpanningTreesSdyF","symbolKind":"method"},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/numberofspanningtrees()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"abstract":[],"kind":"symbol","title":"Graph","role":"symbol","fragmen