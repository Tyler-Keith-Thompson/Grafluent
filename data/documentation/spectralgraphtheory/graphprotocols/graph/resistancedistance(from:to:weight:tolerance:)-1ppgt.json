{"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the"},{"type":"text","text":" "},{"type":"text","text":"effective resistance between them when each edge is a conductance (its weight; 1 without"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight:"},{"type":"text","text":"), (e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading"},{"type":"text","text":" "},{"type":"text","text":"any weight; nil when they lie in different components. Symmetric. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"resistance_distance"},{"type":"text","text":", whose default "},{"type":"codeVoice","code":"invert_weight=True"},{"type":"text","text":" reads weights as resistances"},{"type":"text","text":" "},{"type":"text","text":"instead: pass "},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"type":"text","text":" for that."}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/resistanceDistance(from:to:weight:tolerance:)-1ppgt","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:weight:tolerance:)-1ppgt"]}],"metadata":{"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE18resistanceDistance4from2to6weight9toleranceSdSg6VertexQz_ALqd__5Edges_5IndexQZXESdtSzRd__lF","extendedModule":"GraphProtocols","role":"symbol","roleHeading":"Instance Method","title":"resistanceDistance(from:to:weight:tolerance:)","module