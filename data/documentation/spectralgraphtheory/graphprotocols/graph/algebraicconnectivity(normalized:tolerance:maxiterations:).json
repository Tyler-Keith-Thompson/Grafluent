{"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21algebraicConnectivity10normalized9tolerance13maxIterationsSdSb_SdSiSgtAA13NoConvergenceVYKF","symbolKind":"method","title":"algebraicConnectivity(normalized:tolerance:maxIterations:)","modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","remoteSource":{"fileName":"FiedlerVector.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/FiedlerVector.swift#L88"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"role":"symbol"},"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(normalized:tolerance:maxIterations:)","interfaceLanguage":"swift"},"abstract":[{"text":"The algebraic connectivity λ₂: the second smallest eigenvalue of the Laplacian L (of the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian N with ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":"), 0 exactly when the graph is not connected (a","type":"text"},{"text":" ","type":"text"},{"text":"weight-0 edge does not connect). NetworkX ","type":"text"},{"code":"algebraic_connectivity","type":"codeVoice"},{"text":"; Fiedler 1973.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At least two vertices, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is"},{"type":"text","text":" "},{"type":"text","text":"at least 1."}]}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when the Lanczos run on L⁺ spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" matrix–vector"},{"type":"text","text":" "},{"type":"text","text":"products (1,000 when nil) without converging, with the products spent and the Ritz"},{"type":"text","text":" "},{"type":"text","text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to"},{"type":"text","text":" "},{"type":"text","text":"shift-invert rather than throwing, after 4,000 + 20√n products or "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,"},{"type":"text","text":" "},{"type":"text","text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the"},{"type":"text","text":" "},{"type":"text","text":"dense solver answers and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" is unused. Only a tolerance below rounding has"},{"type":"text","text":" "},{"type":"text","text":"reached the default limits in the measurements."}],"type":"paragraph"}],"name":"Throws","type":"aside","style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(normalized:tolerance:maxiterations:)"]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","kind":"symbol","type":"topic","abstract":[],"title":"SpectralGraphTheory","role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/algebraicConnectivity(normalized:tolerance:maxIterations:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","