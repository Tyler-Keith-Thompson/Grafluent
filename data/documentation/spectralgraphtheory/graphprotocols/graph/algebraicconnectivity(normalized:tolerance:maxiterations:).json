raphProtocols/NoConvergence":{"role":"symbol","abstract":[{"type":"text","text":"The error an iterative method throws when it spends its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos"},{"type":"text","text":" "},{"type":"text","text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"ComputationInfo::NoConvergence"},{"type":"text","text":"; NetworkX raises "},{"type":"codeVoice","code":"PowerIterationFailedConvergence"},{"type":"text","text":" and SciPy"},{"type":"text","text":" "},{"type":"codeVoice","code":"ArpackNoConvergence"},{"type":"text","text":" in the same place."}],"kind":"symbol","title":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoConvergence"}],"navigatorTitle":[{"kind":"identifier","text":"NoConvergence"}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"abstract":[],"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","title":"SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory"}}}