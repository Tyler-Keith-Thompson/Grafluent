type":"text","text":"The algebraic connectivity λ₂: the second smallest eigenvalue of the Laplacian L (of the"},{"type":"text","text":" "},{"type":"text","text":"normalized Laplacian N with "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":"), 0 exactly when the graph is not connected (a"},{"type":"text","text":" "},{"type":"text","text":"weight-0 edge does not connect). NetworkX "},{"type":"codeVoice","code":"algebraic_connectivity"},{"type":"text","text":"; Fiedler 1973."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(normalized:tolerance:maxiterations:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"algebraicConnectivity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected","type":"text"},{"text":" ","type":"text"},{"text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with","type":"text"},{"text":" ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a","type":"text"},{"text":" ","type":"text"},{"text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is","type":"text"},{"text":" ","type":"text"},{"text":"accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ₂, so λ₂ is relative to itself however","type":"text"},{"text":" ","type":"text"},{"text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The","type":"text"},{"text":" ","type":"text"},{"text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s (34 n from 5,000","type":"text"},{"text":" ","type":"text"},{"text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the","type":"text"},{"text":" ","type":"text"},{"text":"solver.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"At least two vertices, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is"},{"type":"text","text":" "},{"type":"text","text":"at least 1."}],"type":"paragraph"}],"name":"Precondition","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" when the Lanczos run on L⁺ spends ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" matrix–vector","type":"text"},{"text":" ","type":"text"},{"text":"products (1,000 when nil) without converging, with the products spent and the Ritz","type":"text"},{"text":" ","type":"text"},{"text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to","type":"text"},{"text":" ","type":"text"},{"text":"shift-invert rather than throwing, after 4,000 + 20√n products or ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,","type":"text"},{"text":" ","type":"text"},{"text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the","type":"text"},{"text":" ","type":"text"},{"text":"dense solver answers and ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" is unused. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached the default limits in the measurements.","type":"text"}],"type":"paragraph"}],"name":"Throws","type":"aside"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/algebraicConnectivity(normalized:tolerance:maxIterations:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"algebraicConnectivity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"title":"algebraicConnectivity(normalized:tolerance:maxIterations:)","kind":"symbol","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(normalized:tolerance:maxIterations:)","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(normalized:tolerance:maxiterations:)","abstract":[{"text":"The algebraic connectivity λ₂: the second smallest eigenvalue of the Laplacian L (of the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian N with ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":"), 0 exactly when the graph is not connected (a","type":"text"},{"text":" ","type":"text"},{"text":"weight-0 edge does not connect). NetworkX ","type":"text"},{"code":"algebraic_connectivity","type":"codeVoice"},{"text":"; Fiedler 1973.","type":"text"}],"role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"title":"SpectralGraphTheory","kind":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","type":"topic","url":"\/documentation\/spectralgraphtheory","abstract":[],"role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"abstract":[],"role":"collection","title":"GraphProtocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","type":"topic","url":"\/documentation\/spectralgraphtheory\/graphprotocols","kind":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"title":"Graph","kind":"symbol","navigatorTitle":[{"text":