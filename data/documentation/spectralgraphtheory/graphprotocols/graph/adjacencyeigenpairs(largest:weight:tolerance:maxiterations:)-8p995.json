ectralGraphTheory\/Eigenpairs"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SB","kind":"typeIdentifier","text":"BinaryFloatingPoint"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"largest","content":[{"type":"paragraph","inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"The weight of the edge at each position."}],"type":"paragraph"}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}]}]},{"name":"maxIterations","content":[{"inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a","type":"text"},{"text":" ","type":"text"},{"text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks","type":"text"},{"text":" ","type":"text"},{"text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual","type":"text"},{"text":" ","type":"text"},{"text":"is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors","type":"text"},{"text":" ","type":"text"},{"text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64","type":"text"},{"text":" ","type":"text"},{"text":"vertices, or when k is a third of them or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"largest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", every weight is finite,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" products without","type":"text"},{"text":" ","type":"text"},{"text":"converging, with the products spent and the largest Ritz residual on the tolerance’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"code":"adjacencySpectrum","type":"codeVoice"},{"text":" does.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"varia