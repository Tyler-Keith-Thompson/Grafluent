","type":"codeVoice"},{"text":" does.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Throws"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"The k largest eigenvalues of the adjacency matrix A ("},{"type":"codeVoice","code":"adjacencyMatrix()"},{"type":"text","text":"), k = "},{"type":"codeVoice","code":"largest"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"descending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/adjacencyeigenpairs(largest:weight:tolerance:maxiterations:)-8p995"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","type":"topic","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"title":"Edges","kind":"symbol","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","type":"topic","url":"\/documentation\/spectralgraphtheory","abstract":[],"role":"collection","title":"SpectralGraphTheory"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"url":