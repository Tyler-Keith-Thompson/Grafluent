text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","kind":"typeIdentifier","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryFloatingPoint","kind":"typeIdentifier","preciseIdentifier":"s:SB"}]}]},{"kind":"parameters","parameters":[{"name":"largest","content":[{"type":"paragraph","inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"The weight of the edge at each position."}],"type":"paragraph"}]},{"name":"tolerance","content":[{"inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n.","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragr