{"abstract":[{"type":"text","text":"The effective graph resistance (the Kirchhoff index of Klein and Randić): the sum of"},{"type":"text","text":" "},{"type":"codeVoice","code":"resistanceDistance"},{"type":"text","text":" over unordered pairs of vertices, n · Σ_{i≥2} 1\/λᵢ over the Laplacian"},{"type":"text","text":" "},{"type":"text","text":"spectrum; nil when the graph is not connected, 0 for zero or one vertex. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"effective_graph_resistance"},{"type":"text","text":" (which returns ∞ when disconnected)."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"effectiveGraphResistance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"N · tr(L_g⁻¹) − 1ᵀ L_g⁻¹ 1 with L_g the Laplacian grounded at the vertex of largest degree,","type":"text"},{"text":" ","t