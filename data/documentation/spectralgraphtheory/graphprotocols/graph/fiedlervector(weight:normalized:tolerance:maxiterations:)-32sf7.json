,"text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory13FiedlerVectorV","text":"FiedlerVector","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/FiedlerVector"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SB","text":"BinaryFloatingPoint"}]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected","type":"text"},{"text":" ","type":"text"},{"text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"normalized"},{"text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a","type":"text"},{"text":" ","type":"text"},{"text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is","type":"text"},{"text":" ","type":"text"},{"text":"accepted when its residual is at most ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":" · λ₂, so λ₂ is relative to itself however","type":"text"},{"text":" ","type":"text"},{"text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The","type":"text"},{"text":" ","type":"text"},{"text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s (34 n from 5,000","type":"text"},{"text":" ","type":"text"},{"text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the","type":"text"},{"text":" ","type":"text"},{"text":"solver.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At least two vertices, and "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":". Every weight is finite and"},{"type":"text","text":" "},{"type":"text","text":"nonnegative, and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"type":"aside","style":"note"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when the Lanczos run on L⁺ spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" matrix–vector"},{"type":"text","text":" "},{"type":"text","text":"products (1,000 when nil) without converging, with the products spent and the Ritz"},{"type":"text","text":" "},{"type":"text","text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to"},{"type":"text","text":" "},{"type":"text","text":"shift-invert rather than throwing, after 4,000 + 20√n products or "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,"},{"type":"text","text":" "},{"type":"text","text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the"},{"type":"text","text":" "},{"type":"text","text":"dense solver answers and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" is unused. Only a tolerance below rounding has"},{"type":"text","text":" "},{"type":"text","text":"reached the default limits in the measurements."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","type":"topic","url":"\/documentation\/graphprotocols\/noconvergence","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"title":"NoConvergence","kind":"symbol","abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule."}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","kind":"symbol","abstract":[],"role":"collection","title":"GraphProtocols"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","typ