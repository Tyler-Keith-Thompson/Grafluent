ectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/fiedlervector(weight:normalized:tolerance:maxiterations:)-32sf7"]}],"kind":"symbol","abstract":[{"text":"The Fiedler vector: λ₂ and a unit eigenvector of it, with the canonical sign (see","type":"text"},{"text":" ","type":"text"},{"code":"FiedlerVector","type":"codeVoice"},{"text":"); nil when the graph is not connected.","type":"text"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","title":"Graph","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/FiedlerVector":{"title":"FiedlerVector","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FiedlerVector"}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/FiedlerVector","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FiedlerVector"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The Fiedler vector of a connected graph: a unit eigenvector of λ₂, the algebraic"},{"type":"text","text":" "},{"type":"text","text":"connectivity, of the Laplacian (or of the normalized Laplacian), with one entry per vertex."}],"url":"\/documentation\/spectralgraphtheory\/fiedlervector"},"doc://GraphProtocols/docume