roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"role":"symbol","symbolKind":"method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE13fiedlerVector6weight10normalized9tolerance13maxIterationsAD07FiedlerF0VyxGSgqd__5Edges_5IndexQZXE_SbSdSiSgtAA13NoConvergenceVYKSzRd__lF","remoteSource":{"fileName":"FiedlerVector.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/FiedlerVector.swift#L231"},"title":"fiedlerVector(weight:normalized:tolerance:maxIterations:)"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"The Fiedler vector: λ₂ and a unit eigenvector of it, with the canonical sign (see"},{"type":"text","text":" "},{"type":"codeVoice","code":"FiedlerVector"},{"type":"text","text":"); nil when the graph is not connected."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fiedlerVector"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"FiedlerVector","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/FiedlerVector","preciseIdentifier":"s:19SpectralGraphTheory13FiedlerVectorV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryInteger","preciseIdentifier":"s:Sz"}]}]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"code":"normalized","type":"codeVoice"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"text":"At least two vertices, and ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":". Every weight is finite and","type":"text"},{"text":" ","type":"text"},{"text":"nonnegative, and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Precondition"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" when the Lanczos run on L⁺ spends ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" matrix–vector","type":"text"},{"text":" ","type":"text"},{"text":"products (1,000 when nil) without converging, with the products spent and the Ritz","type":"text"},{"text":" ","type":"text"},{"text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to","type":"text"},{"text":" ","type":"text"},{"text":"shift-invert rather than throwing, after 4,000 + 20√n products or ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,","type":"text"},{"text":" ","type":"text"},{"text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the","type":"text"},{"text":" ","type":"text"},{"text":"dense solver answers and ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" is unused. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached the default limits in the measurements.","type":"text"}]}],"type":"aside","name":"Throws"}],"kind":"content"}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"title":"Edges","role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","title":"Graph","role":"symbol","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","type":"topic"},"doc://SpectralGraphTheory/documentatio