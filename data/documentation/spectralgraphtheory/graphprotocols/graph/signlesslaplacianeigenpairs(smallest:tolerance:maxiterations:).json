pe":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"when given, is at least 1."}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when a Lanczos run spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"code":"adjacencySpectrum","type":"codeVoice"},{"type":"text","text":" does."}],"type":"paragraph"}],"style":"note","name":"Throws","type":"aside"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/signlesslaplacianeigenpairs(smallest:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/signlessLaplacianEigenpairs(smallest:tolerance:maxIterations:)"},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","title":"Graph"},"doc://SpectralGraphThe