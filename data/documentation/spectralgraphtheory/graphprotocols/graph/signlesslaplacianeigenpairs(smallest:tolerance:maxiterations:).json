,"text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"smallest","type":"codeVoice"},{"type":"text","text":" is in "},{"code":"0...vertexCount","type":"codeVoice"},{"type":"text","text":", "},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":", and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"when given, is at least 1."}]}],"name":"Precondition","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" products without","type":"text"},{"text":" ","type":"text"},{"text":"converging, with the products spent and the largest Ritz residual on the tolerance’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"code":"adjacencySpectrum","type":"codeVoice"},{"text":" does.","type":"text"}],"type":"paragraph"}],"name":"Throws","type":"aside"}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","type":"topic","url":"\/documentation\/spectralgraphtheory\/eigenpairs","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eigenpairs"}],"navigatorTitle":[{"kind":"identifier","text":"Eigenpairs"}],"title":"Eigenpairs","kind":"symbol","abstract":[{"type":"text","text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenva