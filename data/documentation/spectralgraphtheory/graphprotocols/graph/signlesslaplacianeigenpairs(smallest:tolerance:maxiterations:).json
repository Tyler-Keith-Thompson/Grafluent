ote","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" products without","type":"text"},{"text":" ","type":"text"},{"text":"converging, with the products spent and the largest Ritz residual on the tolerance’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"code":"adjacencySpectrum","type":"codeVoice"},{"text":" does.","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"metadata":{"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L790","fileName":"Eigenpairs.swift"},"roleHeading":"Instance Method","extendedModule":"GraphProtocols","title":"signlessLaplacianEigenpairs(smallest:tolerance:maxIterations:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signlessLaplacianEigenpairs","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"smallest"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Eigenpairs","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Sel