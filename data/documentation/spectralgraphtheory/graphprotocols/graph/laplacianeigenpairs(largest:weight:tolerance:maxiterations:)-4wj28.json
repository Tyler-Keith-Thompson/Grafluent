:"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","text":"Eigenpairs"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"largest","content":[{"inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weight of the edge at each position."}]}]},{"name":"tolerance","content":[{"inlineContent":[{"text":"The residual a Ritz pair must reach, relative as described above.","type":"text"}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a"},{"type":"text","text":" "},{"type":"text","text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks"},{"type":"text","text":" "},{"type":"text","text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual"},{"type":"text","text":" "},{"type":"text","text":"is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors"},{"type":"text","text":" "},{"type":"text","text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64"},{"type":"text","text":" "},{"type":"text","text":"vertices, or when k is a third of them or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}]},{"type":"paragraph","inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"largest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", every weight is finite"},{"type":"text","text":" "},{"type":"text","text":"and nonnegative, and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"name":"Precondition"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"