{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/laplacianEigenpairs(smallest:weight:tolerance:maxIterations:)-8c1rk","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"The k smallest eigenvalues of the Laplacian L (","type":"text"},{"type":"codeVoice","code":"laplacianMatrix()"},{"text":"), k = ","type":"text"},{"type":"codeVoice","code":"smallest"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"ascending, each with a unit eigenvector (see ","type":"text"},{"code":"Eigenpairs","type":"codeVoice"},{"type":"text","text":")."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"laplacianEigenpairs"},{"kind":"text","text":"<"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}]}]},{"kind":"parameters","parameters":[{"name":"smallest","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The number of eigenpairs, in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":"."}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The weight of the edge at each position."}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}]}]},{"name":"maxIterations","content":[{"inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for the limits"},{"type":"text","text":" "},{"type":"text","text":"under Throws."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Component by component: each component’s null vector first (eigenvalue 0, components in","type":"text"},{"text":" ","type":"text"},{"text":"order of their least vertex), then the smallest positive eigenvalues of the components","type":"text"},{"text":" ","type":"text"},{"text":"merged. On a component of at least 64 vertices, thick-restart Lanczos (Wu–Simon) with full","type":"text"},{"text":" ","type":"text"},{"text":"reorthogonalization and locking, the null vector projected out, from a fixed start vector:","type":"text"},{"text":" ","type":"text"},{"text":"on σI − M (σ Gershgorin’s bound) while σ\/λ₂ is moderate, else on M⁺ by shift-invert, each","type":"text"},{"text":" ","type":"text"},{"text":"product a conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz","type":"text"},{"text":" ","type":"text"},{"text":"pair is accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ, relative to itself as for","type":"text"},{"text":" ","type":"text"},{"code":"algebraicConnectivity","type":"codeVoice"},{"text":"; the vectors found are then rotated by Rayleigh–Ritz on M, and each","type":"text"},{"text":" ","type":"text"},{"text":"value is its vector’s Rayleigh quotient, a sum over edges. The dense solver on a smaller","type":"text"},{"text":" ","type":"text"},{"text":"component, or when k is a third of it or more.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) · products + n · k²) time, O(n · k) ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s for the vectors and n · max(30, 2k +","type":"text"},{"text":" ","type":"text"},{"text":"10) for the basis.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"smallest"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"0...vertexCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", every weight is finite"},{"type":"text","text":" "},{"type":"text","text":"and nonnegative, and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when a Lanczos run by shift-invert spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" products"},{"type":"text","text":" "},{"type":"text","text":"(1,000 when nil), or a conjugate-gradient solve inside it 20,000 + 2n iterations, without"},{"type":"text","text":" "},{"type":"text","text":"converging. A run on σI − M hands over to shift-invert rather than throwing, after 4,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n products or "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", whichever is smaller. The dense solver throws as"},{"type":"text","text":" "},{"code":"laplacianSpectrum","type":"codeVoice"},{"type":"text","text":" does."}]}]}]}],"metadata":{"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L375","fileName":"Eigenpairs.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"laplacianEigenpairs","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"smallest"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"text":"weight","kind":"