ight is finite,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}],"type":"paragraph"}],"name":"Precondition"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}],"name":"Throws"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/adjacencyeigenpairs(largest:weight:tolerance:maxiterations:)-2tyr8"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","title":"NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","role":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"abstract":[{"text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenvalues, from that end","type":"text"},{"text":" ","type":"text"},{"text":"(ascending for the smallest, descending for