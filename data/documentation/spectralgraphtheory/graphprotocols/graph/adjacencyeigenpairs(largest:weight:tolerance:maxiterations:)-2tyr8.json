ssociatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","text":"Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"largest"},{"content":[{"inlineContent":[{"type":"text","text":"The weight of the edge at each position."}],"type":"paragraph"}],"name":"weight"},{"content":[{"inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}],"type":"paragraph"}],"nam