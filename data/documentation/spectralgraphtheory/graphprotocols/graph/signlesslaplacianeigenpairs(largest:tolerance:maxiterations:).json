":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}],"type":"paragraph"},{"type":"aside","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"largest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"when given, is at least 1.","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}],"style":"note"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","type":"topic","url":"\/documentation\/graphprotocols\/noconvergence","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"title":"NoConvergence","kind":"symbol","abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","t