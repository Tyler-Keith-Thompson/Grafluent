xt":"The number of eigenpairs, in "},{"code":"0...vertexCount","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"largest"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}]}],"name":"tolerance"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +","type":"text"},{"text":" ","type":"text"},{"text":"20√n.","type":"text"}]}],"name":"maxIterations"}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a"},{"type":"text","text":" "},{"type":"text","text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks"},{"type":"text","text":" "},{"type":"text","text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual"},{"type":"text","text":" "},{"type":"text","text":"is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors"},{"type":"text","text":" "},{"type":"text","text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64"},{"type":"text","text":" "},{"type":"text","text":"vertices, or when k is a third of them or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"largest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"when given, is at least 1.","type":"text"}]}],"type":"aside"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}],"type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/signlessLaplacianEigenpairs(largest:tolerance:maxIterations:)"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it uses up its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","url":"\/documentation\/graphprotocols\/noconvergence","tit