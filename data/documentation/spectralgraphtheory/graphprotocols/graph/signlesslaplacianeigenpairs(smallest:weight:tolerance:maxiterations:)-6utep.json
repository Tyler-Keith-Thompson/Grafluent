e.","type":"text"}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"smallest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", every weight is finite","type":"text"},{"text":" ","type":"text"},{"text":"and nonnegative, and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","abstract":[{"type":"text","text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenvalues, from that end"},{"type":"text","text":" "},{"type":"text","text":"(ascending for the smallest, descending for the largest), and an orthonormal eigenvector for"},{"type":"text","text":" "},{"type":"text","text":"each, with one entry per vertex."}],"url":"\/documentation\/spectralgraphtheory\/eigenpairs","title":"Eigenpairs","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Eigenpairs"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text",