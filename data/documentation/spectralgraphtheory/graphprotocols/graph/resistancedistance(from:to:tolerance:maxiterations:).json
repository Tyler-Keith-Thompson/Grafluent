genceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the"},{"type":"text","text":" "},{"type":"text","text":"effective resistance between them when each edge is a conductance (its weight; 1 without"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight:"},{"type":"text","text":"), (e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading"},{"type":"text","text":" "},{"type":"text","text":"any weight; nil when they lie in different components. Symmetric. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"resistance_distance"},{"type":"text","text":", whose default "},{"type":"codeVoice","code":"invert_weight=True"},{"type":"text","text":" reads weights as resistances"},{"type":"text","text":" "},{"type":"text","text":"instead: pass "},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"type":"text","text":" for that."}],"role":"symbol","type":"topic","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"abstract":[],"role":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NoConvergence"}],"abstract":[{"type":"text","text":"The error an iterative method throws when it spends its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos"},{"type":"text","text":" "},{"type":"text","text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"ComputationInfo::NoConvergence"},{"type":"text","text":"; NetworkX raises "},{"type":"codeVoice","code":"PowerIterationFailedConvergence"},{"type":"text","text":" and SciPy"},{"type":"text","text":" "},{"type":"codeVoice","code":"ArpackNoConvergence"},{"type":"text","text":" in the same place."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NoConvergence"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/noconvergence","title":"NoConvergence"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"type":"topic","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","abstract":[],"url":"\/documentation\/spectralgraphtheory","title":"SpectralGraphTheory"}}}