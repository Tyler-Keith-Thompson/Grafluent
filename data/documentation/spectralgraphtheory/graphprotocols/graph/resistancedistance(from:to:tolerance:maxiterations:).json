 the right-hand side’s. No input has reached the default limit in the"},{"type":"text","text":" "},{"type":"text","text":"measurements."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"]}],"kind":"symbol","identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/resistanceDistance(from:to:tolerance:maxIterations:)","interfaceLanguage":"swift"},"abstract":[{"text":"The resistance distance between ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" (Klein and Randić 1993): the effective","type":"text"},{"text":" ","type":"text"},{"text":"resistance between them when each edge is a conductance (its weight; 1 without ","type":"text"},{"code":"weight:","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any weight;","type":"text"},{"text":" ","type":"text"},{"text":"nil when they lie in different components. Symmetric. To read weights as resistances","type":"text"},{"text":" ","type":"text"},{"text":"instead, pass ","type":"text"},{"code":"{ 1 \/ r($0) }","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","abstract":[],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex"},"doc://GraphProtocols/documentation/Grap