{"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The resistance distance between ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target"},{"text":" (Klein and Randić 1993): the","type":"text"},{"text":" ","type":"text"},{"text":"effective resistance between them when each edge is a conductance (its weight; 1 without","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"weight:"},{"text":"), (e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading","type":"text"},{"text":" ","type":"text"},{"text":"any weight; nil when they lie in different components. Symmetric. NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"resistance_distance"},{"text":", whose default ","type":"text"},{"type":"codeVoice","code":"invert_weight=True"},{"text":" reads weights as resistances","type":"text"},{"text":" ","type":"text"},{"text":"instead: pass ","type":"text"},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"text":" for that.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resistanceDistance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},