xt","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"?"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Conjugate gradients on the Laplacian grounded at "},{"code":"target","type":"codeVoice"},{"type":"text","text":", from 0, until the residual’s"},{"type":"text","text":" "},{"type":"text","text":"Euclidean norm is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" (relative to the right-hand side, which has norm 1),"},{"type":"text","text":" "},{"type":"text","text":"or, on a weight spread that puts that below rounding, until the true residual stops"},{"type":"text","text":" "},{"type":"text","text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky"},{"type":"text","text":" "},{"type":"text","text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"the factor when it is built."}]},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices of the graph, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"style":"note"},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" after ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" conjugate-gradient iterations (one","type":"text"},{"text":" ","type":"text"},{"text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm","type":"text"},{"text":" ","type":"text"},{"text":"relative to the right-hand side’s. No input has reached the default limit in the","type":"text"},{"text":" ","type":"text"},{"text":"measurements.","type":"text"}]}],"style":"note"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"]}],"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the effective"},{"type":"text","text":" "},{"type":"text","text":"resistance between them when each edge is a conductance (its weight; 1 without "},{"type":"codeVoice","code":"weight:"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any weight;"},{"type":"text","text":" "},{"type":"text","text":"nil when they lie in different components. Symmetric. To read weights as resistances"},{"type":"text","text":" "},{"type":"text","text":"instead, pass "},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"type":"text","text":"."}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"url":"\/documentation\/spectralgraphtheory","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","kind":"symbol","title":"SpectralGraphTheory","type":"topic","abstract":[],"role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"type":"topic","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","url":"\/documentation\/spectralgr