lectricalNetworks.swift#L133"},"extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"symbolKind":"method"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resistanceDistance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-10, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"?"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Conjugate gradients on the Laplacian grounded at ","type":"text"},{"code":"target","type":"codeVoice"},{"text":", from 0, until the residual’s","type":"text"},{"text":" ","type":"text"},{"text":"Euclidean norm is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" (relative to the right-hand side, which has norm 1),","type":"text"},{"text":" ","type":"text"},{"text":"or, on a weight spread that puts that below rounding, until the true residual stops","type":"text"},{"text":" ","type":"text"},{"text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky","type":"text"},{"text":" ","type":"text"},{"text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for","type":"text"},{"text":" ","type":"text"},{"text":"the factor when it is built.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"source","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" are vertices of the graph, ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" after "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" conjugate-gradient iterations (one"},{"type":"text","text":" "},{"type":"text","text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm"},{"type":"text","text":" "},{"type":"text","text":"relative to the right-hand side’s. No input has reached the default limit in the"},{"type":"text","text":" "},{"type":"text","text":"measurements."}],"type":"paragraph"}],"name":"Throws","style":"note"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/resistanceDistance(from:to:tolerance:maxIterations:)"},"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the effective"},{"type":"text","text":" "},{"text":"resistance between them when each edge is a conductance (its weight; 1 without ","type":"text"},{"type":"codeVoice","code":"weight:"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any weight;","type":"text"},{"text":" ","type":"text"},{"text":"nil when they lie in different components. Symmetric. To read weights as resistances","type":"text"},{"text":" ","type":"text"},{"text":"instead, pass ","type":"text"},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"text":".","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","abstract":[],"kind":"symbol","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://SpectralGraphTheory/documentatio