iseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"target","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-10, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Conjugate gradients on the Laplacian grounded at "},{"code":"target","type":"codeVoice"},{"type":"text","text":", from 0, until the residual’s"},{"type":"text","text":" "},{"type":"text","text":"Euclidean norm is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" (relative to the right-hand side, which has norm 1),"},{"type":"text","text":" "},{"type":"text","text":"or, on a weight spread that puts that below rounding, until the true residual stops"},{"type":"text","text":" "},{"type":"text","text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky"},{"type":"text","text":" "},{"type":"text","text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"the factor when it is built."}]},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices of the graph, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}]},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" conjugate-gradient iterations (one"},{"type":"text","text":" "},{"type":"text","text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm"},{"type":"text","text":" "},{"type":"text","text":"relative to the right-hand side’s. No input has reached the default limit in the"},{"type":"text","text":" "},{"type":"text","text":"measurements."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/resistanceDistance(from:to:tolerance:maxIterations:)":{"abstract":[{"text":"The resistance distance between ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" (Klein and Randić 1993): the","type":"te