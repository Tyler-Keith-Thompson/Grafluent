{"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/resistanceDistance(from:to:tolerance:maxIterations:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The resistance distance between "},{"code":"source","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target","type":"codeVoice"},{"type":"text","text":" (Klein and Randić 1993): the"},{"type":"text","text":" "},{"type":"text","text":"effective resistance between them when each edge is a conductance (its weight; 1 without"},{"type":"text","text":" "},{"code":"weight:","type":"codeVoice"},{"type":"text","text":"), (e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading"},{"type":"text","text":" "},{"type":"text","text":"any weight; nil when they lie in different components. Symmetric. NetworkX"},{"type":"text","text":" "},{"code":"resistance_distance","type":"codeVoice"},{"type":"text","text":", whose default "},{"code":"invert_weight=True","type":"codeVoice"},{"type":"text","text":" reads weights as resistances"},{"type":"text","text":" "},{"type":"text","text":"instead: pass "},{"code":"{ 1 \/ r($0) }","type":"codeVoice"},{"type":"text","text":" for that."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resistanceDistance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-10, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Conjugate gradients on the Laplacian grounded at "},{"code":"target","type":"codeVoice"},{"type":"text","text":", from 0, until the residual’s"},{"type":"text","text":" "},{"type":"text","text":"Euclidean norm is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" (relative to the right-hand side, which has norm 1),"},{"type":"text","text":" "},{"type":"text","text":"or, on a weight spread that puts that below rounding, until the true residual stops"},{"type":"text","text":" "},{"type":"text","text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky"},{"type":"text","text":" "},{"type":"text","text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"the factor when it is built."}]},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices of the graph, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}],"type":"aside","style":"note"},{"name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" conjugate-gradient iterations (one","type":"text"},{"text":" ","type":"text"},{"text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm","type":"text"},{"text":" ","type":"text"},{"text":"relative to the right-hand side’s. No input has reached the default limit in the","type":"text"},{"text":" ","type":"text"},{"text":"measurements.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"metadata":{"title":"resistanceDistance(from:to:tolerance:maxIterations:)","extendedModule":"GraphProtocols","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE18resistanceDistance4from2to9tolerance13maxIterationsSdSg6VertexQz_ALSdSiSgtAA13NoConvergenceVYKF","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resistanceDistance","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","te