_ALSdSiSgtAA13NoConvergenceVYKF","symbolKind":"method","extendedModule":"GraphProtocols","title":"resistanceDistance(from:to:tolerance:maxIterations:)","roleHeading":"Instance Method"},"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the effective"},{"type":"text","text":" "},{"type":"text","text":"resistance between them when each edge is a conductance (its weight; 1 without "},{"type":"codeVoice","code":"weight:"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any weight;"},{"type":"text","text":" "},{"type":"text","text":"nil when they lie in different components. Symmetric. To read weights as resistances"},{"type":"text","text":" "},{"type":"text","text":"instead, pass "},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resistanceDistance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-10, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"?"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Conjugate gradients on the Laplacian grounded at "},{"code":"target","type":"codeVoice"},{"type":"text","text":", from 0, until the residual’s"},{"type":"text","text":" "},{"type":"text","text":"Euclidean norm is at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" (relative to the right-hand side, which has norm 1),"},{"type":"text","text":" "},{"type":"text","text":"or, on a weight spread that puts that below rounding, until the true residual stops"},{"type":"text","text":" "},{"type":"text","text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky"},{"type":"text","text":" "},{"type":"text","text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"the factor when it is built."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"source","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" are vertices of the graph, ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" conjugate-gradient iterations (one"},{"type":"text","text":" "},{"type":"text","text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm"},{"type":"text","text":" "},{"type":"text","text":"relative to the right-hand side’s. No input has reached the default limit in the"},{"type":"text","text":" "},{"type":"text","text":"measurements."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"kind":"symbol","abstract":[],"url":"\/documentation\/spectralgraphtheory\/graphprotocols","type":"topic","title":"GraphProtocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/resistanceDistance(from:to:tolerance:maxIterations:)":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)","abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and 