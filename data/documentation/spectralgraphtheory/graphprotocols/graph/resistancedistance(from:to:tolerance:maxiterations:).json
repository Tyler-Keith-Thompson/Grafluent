{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE18resistanceDistance4from2to9tolerance13maxIterationsSdSg6VertexQz_ALSdSiSgtAA13NoConvergenceVYKF","title":"resistanceDistance(from:to:tolerance:maxIterations:)","role":"symbol","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L88","fileName":"ElectricalNetworks.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resistanceDistance","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"?"}],"roleHeading":"Instance Method","modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resistanceDistance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"target","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-10, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Conjugate gradients on the Laplacian grounded at "},{"type":"codeVoice","code":"target"},{"type":"text","text":", from 0, until the residual’s"},{"type":"text","text":" "},{"type":"text","text":"Euclidean norm is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" (relative to the right-hand side, which has norm 1),"},{"type":"text","text":" "},{"type":"text","text":"or, on a weight spread that puts that below rounding, until the true residual stops"},{"type":"text","text":" "},{"type":"text","text":"improving. Jacobi preconditioned for 300 iterations, then by a modified incomplete Cholesky"},{"type":"text","text":" "},{"type":"text","text":"factor in maximum-spanning-tree order. O((n + m) √κ) time; about 9 n words, and O(n + m) for"},{"type":"text","text":" "},{"type":"text","text":"the factor when it is built."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices of the graph, "},{"type":"codeVoice","code":"tolerance > 0"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at least 1."}]}]},{"type":"aside","style":"note","name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" after ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" conjugate-gradient iterations (one","type":"text"},{"text":" ","type":"text"},{"text":"matrix–vector product each; 20,000 + 2n when nil), with that count and the residual’s norm","type":"text"},{"text":" ","type":"text"},{"text":"relative to the right-hand side’s. No input has reached the default limit in the","type":"text"},{"text":" ","type":"text"},{"text":"measurements.","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/resistanceDistance(from:to:tolerance:maxIterations:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the effective"},{"type":"text","text":" "},{"type":"text","text":"resistance between them when each edge is a conductance (its weight; 1 without "},{"type":"codeVoice","code":"weight:"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"(e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading any weight;"},{"type":"text","text":" "},{"type":"text","text":"nil when they lie in different components. Symmetric. To read weights as resistances"},{"type":"text","text":" "},{"type":"text","text":"instead, pass "},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","type":"topic","kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols","abstract":[],"role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"title":"NoConvergence","role":"symbol","url":"\/documentation\/graphprotocols\/noconvergence","type":"topic","identifier":"doc:\/\/GraphProtocols\/docume