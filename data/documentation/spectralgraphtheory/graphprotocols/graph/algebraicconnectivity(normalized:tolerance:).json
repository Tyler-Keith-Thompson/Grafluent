{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"algebraicConnectivity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-8) -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}],"type":"paragraph"},{"inlineContent":[{"text":"Traps when the work limit is spent: 4,000 + 20√n products on σI − L (then shift-invert),","type":"text"},{"text":" ","type":"text"},{"text":"1,000 shift-invert products, 20,000 + 2n per solve. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached it in the measurements.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"At least two vertices, and ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"sections":[],"metadata":{"extendedModule":"GraphProtocols","title":"algebraicConnectivity(normalized:tolerance:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"algebraicConnectivity"},{"text":"(","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"symbolKind":"method","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21algebraicConnectivity10normalized9toleranceSdSb_SdtF","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/FiedlerVector.swift#L83","fileName":"FiedlerVector.swift"}},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(normalized:tolerance:)"]}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(normalized:tolerance:)","interfaceLanguage":"swift"},"abstract":[{"text":"The algebraic connectivity λ₂: the second smallest eigenvalue of the Laplacian L (of the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian N with ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":"), 0 exactly when the graph is not connected (a","type":"text"},{"text":" ","type":"text"},{"text":"weight-0 edge does not connect). NetworkX ","type":"text"},{"code":"algebraic_connectivity","type":"codeVoice"},{"text":"; Fiedler 1973.","type":"text"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"title":"GraphProtocols","url":"\/documentation\/spectralgraphtheory\/graphprotocols","type":"topic","kind":"symbol","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","abstract":[],"role":"collection"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/algebraicConnectivity(normalized:tolerance:)":{"title":"algebraicConnectivity(normalized:tolerance:)","abstract":[{"text":"The algebraic connectivity λ₂: the second smallest eigenvalue of the Laplacian L (of the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian N with ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":"), 0 exactly when the graph is not connected (a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"weight-0 edge does not connect). NetworkX "},{"typ