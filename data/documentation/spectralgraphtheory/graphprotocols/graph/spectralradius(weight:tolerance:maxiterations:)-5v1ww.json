"text":" : ","kind":"text"},{"preciseIdentifier":"s:SB","text":"BinaryFloatingPoint","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position.","type":"text"}]},{"name":"Precondition","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"tolerance > 0","type":"codeVoice"},{"type":"text","text":", every weight is finite, and "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", when given, is"},{"type":"text","text":" "},{"type":"text","text":"at least 1."}]}]},{"name":"Throws","type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" when a Lanczos run (on A, then on −A when a weight is negative)","type":"text"},{"text":" ","type":"text"},{"text":"spends ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" matrix–vector products (20,000 + 20√n when nil) without converging,","type":"text"},{"text":" ","type":"text"},{"text":"with the products spent and the Ritz residual relative to ρ. From 5,000 vertices a","type":"text"},{"text":" ","type":"text"},{"text":"polynomial-filtered step counts 10 products, so the count may pass the limit by up to 10.","type":"text"},{"text":" ","type":"text"},{"text":"Below 64 vertices the dense solver answers and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" is unused. Only a tolerance","type":"text"},{"text":" ","type":"text"},{"text":"below rounding has reached the default limit in the measurements.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralradius(weight:tolerance:maxiterations:)-5v1ww"]}],"abstract":[{"type":"text","text":"The spectral radius ρ(A), the largest magnitude of an eigenvalue of the adjacency matrix:"},{"type":"text","text":" "},{"type":"text","text":"for nonnegative weights, the largest eigenvalue (Perron–Frobenius); 0 without edges."},{"type":"text","text":" "},{"type":"text","text":"Thick-restart Lanczos on A from a fixed start vector (with −A as well when a weight is"},{"type":"text","text":" "},{"type":"text","text":"negative), the top Ritz pair tested every 5 steps, accepting it when its residual is at"},{"type":"text","text":" "},{"type":"text","text":"most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" · ρ (relative); the dense solver below 64 vertices. O((n + m) · products)"},{"type":"text","text":" "},{"type":"text","text":"time, 31 n "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s; the operator shares the graph’s rows."}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","type":"topic","title":"Graph","kind":"symbol","role":"symbol","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/spectralRadius(weight:tolerance:maxIterations:)-5v1ww":{"title":"spectralRadius(weight:tolerance:maxIterations:)","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/spectralRadius(weight:tolerance:maxIterations:)-5v1ww","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/spectralradius(weight:tolerance:maxiterations