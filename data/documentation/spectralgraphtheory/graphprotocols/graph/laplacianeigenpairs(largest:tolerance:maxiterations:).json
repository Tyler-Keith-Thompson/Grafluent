{"abstract":[{"type":"text","text":"The k largest eigenvalues of the Laplacian L ("},{"type":"codeVoice","code":"laplacianMatrix()"},{"type":"text","text":"), k = "},{"type":"codeVoice","code":"largest"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"descending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/laplacianEigenpairs(largest:tolerance:maxIterations:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"laplacianEigenpairs","kind":"identifier"},{"text":"(","kind":"text"},{"text":"largest","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/Eigenpairs","kind":"typeIdentifier","preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"parameters":[{"name":"largest","content":[{"inlineContent":[{"text":"The number of eigenpairs, in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"tolerance","content":[{"inlineContent":[{"type":"text","text":"The residual a Ritz pair must reach, relative as described above."}],"type":"paragraph"}]},{"name":"maxIterations","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The matrix–vector products each Lanczos run may spend; nil for 20,000 +"},{"type":"text","text":" "},{"type":"text","text":"20√n."}]}]}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The eigenpairs, in order from that end of the spectrum."}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization and locking on M, from a"},{"type":"text","text":" "},{"type":"text","text":"fixed start vector; once k pairs are found, a run on the complement of their vectors checks"},{"type":"text","text":" "},{"type":"text","text":"that no copy of a multiple eigenvalue was missed. A Ritz pair is accepted when its residual"},{"type":"text","text":" "},{"type":"text","text":"is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · max(|λ|, s\/1000), s Gershgorin’s bound on the spectrum; the vectors"},{"type":"text","text":" "},{"type":"text","text":"are then rotated by Rayleigh–Ritz on M, whose values are returned. The dense solver below 64"},{"type":"text","text":" "},{"type":"text","text":"vertices, or when k is a third of them or more."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) · products + n · k²) time, O(n · k) "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s for the vectors and n · max(30, 2k +"},{"type":"text","text":" "},{"type":"text","text":"10) for the basis."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"largest","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"0...vertexCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"when given, is at least 1.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"NoConvergence","type":"codeVoice"},{"type":"text","text":" when a Lanczos run spends "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"code":"adjacencySpectrum","type":"codeVoice"},{"type":"text","text":" does."}]}],"type":"aside"}],"kind":"content"}],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE19laplacianEigenpairs7largest9tolerance13maxIterationsAD0F0VyxGSi_SdSiSgtAA13NoConvergenceVYKF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"laplacianEigenpairs"},{"kind":"text","text":"("},{"kind":"externalParam","text":"largest"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","pre