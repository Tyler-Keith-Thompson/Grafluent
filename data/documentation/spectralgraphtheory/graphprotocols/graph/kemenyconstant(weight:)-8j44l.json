nt: the expected number of steps of the random walk (edge weights as"},{"type":"text","text":" "},{"type":"text","text":"transition rates, a loop taken with probability 2w\/d(v)) from a vertex to a target drawn"},{"type":"text","text":" "},{"text":"from the stationary distribution, which does not depend on the start; Σ_{i≥2} 1\/μᵢ over the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian spectrum. nil when the graph is not connected, 0 for zero or one vertex.","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX ","type":"text"},{"code":"kemeny_constant","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Vol · (Σᵢ πᵢ (L_g⁻¹)ᵢᵢ − πᵀ L_g⁻¹ π), π the stationary distribution, which is"},{"type":"text","text":" "},{"type":"text","text":"(1\/2vol) Σᵢⱼ dᵢ dⱼ R(i, j) (commute times are vol · R), with L_g the Laplacian grounded at"},{"type":"text","text":" "},{"type":"text","text":"the vertex of largest degree and eliminated as for "},{"code":"numberOfSpanningTrees","type":"codeVoice"},{"type":"text","text":". Every term is a"},{"type":"text","text":" "},{"type":"text","text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its"},{"type":"text","text":" "},{"type":"text","text":"relative accuracy under any weight spread. O(n³) time, n² "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Every weight is finite and nonnegative.","type":"text"}]}],"type":"aside"}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"role":"collection","url":"\/documentation\/spectralgraphtheory","kind":"symbol","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","abstract":[],"title":"SpectralGraphTheory"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"abstract":[],"title":"Edges"},"doc://Sp