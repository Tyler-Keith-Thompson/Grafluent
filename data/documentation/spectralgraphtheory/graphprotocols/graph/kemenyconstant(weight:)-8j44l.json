{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"kemenyConstant","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sz","kind":"typeIdentifier","text":"BinaryInteger"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vol · (Σᵢ πᵢ (L_g⁻¹)ᵢᵢ − πᵀ L_g⁻¹ π), π the stationary distribution, which is"},{"type":"text","text":" "},{"type":"text","text":"(1\/2vol) Σᵢⱼ dᵢ dⱼ R(i, j) (commute times are vol · R), with L_g the Laplacian grounded at"},{"type":"text","text":" "},{"type":"text","text":"the vertex of largest degree and eliminated as for "},{"type":"codeVoice","code":"numberOfSpanningTrees"},{"type":"text","text":". Every term is a"},{"type":"text","text":" "},{"type":"text","text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its"},{"type":"text","text":" "},{"type":"text","text":"relative accuracy under any weight spread. O(n³) time, n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"content":[{"inlineContent":[{"text":"Every weight is finite and nonnegative.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Precondition"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"The Kemeny constant: the expected number of steps of the random walk (edge weights as"},{"type":"text","text":" "},{"type":"text","text":"transition rates, a loop taken with probability 2w\/d(v)) from a vertex to a target drawn"},{"type":"text","text":" "},{"type":"text","text":"from the stationary distribution, which does not depend on the start; Σ_{i≥2} 1\/μᵢ over the"},{"type":"text","text":" "},{"type":"text","text":"normalized Laplacian spectrum. nil when the graph is not connected, 0 for zero or one vertex."}],"sections":[],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/kemenyConstant(weight:)-8j44l","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/kemenyconstant(weight:)-8j44l"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"