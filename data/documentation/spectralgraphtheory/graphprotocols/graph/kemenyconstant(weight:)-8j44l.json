 is a"},{"type":"text","text":" "},{"type":"text","text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its"},{"type":"text","text":" "},{"type":"text","text":"relative accuracy under any weight spread. O(n³) time, n² "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s."}]},{"type":"paragraph","inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/kemenyconstant(weight:)-8j44l"]}],"metadata":{"title":"kemenyConstant(weight:)","extendedModule":"GraphProtocols","roleHeading":"Instance Method","role":"symbol","symbolKind":"method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE14kemenyConstant6weightSdSgqd__5Edges_5IndexQZXE_tSzRd__lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"text":"?","kind":"text"}],"modules":[{"name":"SpectralGraphTheory","relatedModules":["Graph