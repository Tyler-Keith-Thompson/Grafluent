umentation\/spectralgraphtheory\/graphprotocols\/graph\/resistancedistance(from:to:tolerance:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The resistance distance between "},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" (Klein and Randić 1993): the"},{"type":"text","text":" "},{"type":"text","text":"effective resistance between them when each edge is a conductance (its weight; 1 without"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight:"},{"type":"text","text":"), (e_s − e_t)ᵀ L⁺ (e_s − e_t). 0 when they are the same vertex, without reading"},{"type":"text","text":" "},{"type":"text","text":"any weight; nil when they lie in different components. Symmetric. NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"resistance_distance"},{"type":"text","text":", whose default "},{"type":"codeVoice","code":"invert_weight=True"},{"type":"text","text":" reads weights as resistances"},{"type":"text","text":" "},{"type":"text","text":"instead: pass "},{"type":"codeVoice","code":"{ 1 \/ r($0) }"},{"type":"text","text":" for that."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resistanceDistance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"target"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"