icconnectivity(weight:normalized:tolerance:maxiterations:)-8c3i6"]}],"kind":"symbol","abstract":[{"text":"The algebraic connectivity λ₂ (Fiedler 1973): the second smallest eigenvalue of the","type":"text"},{"text":" ","type":"text"},{"text":"Laplacian L (of the normalized Laplacian N with ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":"), 0 exactly when the graph is","type":"text"},{"text":" ","type":"text"},{"text":"not connected (a weight-0 edge does not connect).","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"title":"NoConvergence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","role":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule."}],"url":"\/documentation\/graphprotocols\/noconvergence"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","role":"symbol","title":"Edges"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"url":"\/documentation\/spectralgraphtheory","type":"topic","abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","title":"SpectralGraphTheory","kind"