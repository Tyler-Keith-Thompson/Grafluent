\/algebraicConnectivity(weight:normalized:tolerance:maxIterations:)-8c3i6","abstract":[{"type":"text","text":"The algebraic connectivity λ₂ (Fiedler 1973): the second smallest eigenvalue of the"},{"type":"text","text":" "},{"type":"text","text":"Laplacian L (of the normalized Laplacian N with "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":"), 0 exactly when the graph is"},{"type":"text","text":" "},{"type":"text","text":"not connected (a weight-0 edge does not connect)."}],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:maxiterations:)-8c3i6"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"abstract":[],"title":"GraphProtocols","kind":"symbol","role":"collection","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","type":"topic","url":"\/documentation\/spectralgraphtheory\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"title":"Edges","role":"symbol","kind":"symbol","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype"}}}