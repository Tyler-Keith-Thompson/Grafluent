{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(weight:normalized:tolerance:maxIterations:)-8c3i6"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"algebraicConnectivity"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE21algebraicConnectivity6weight10normalized9tolerance13maxIterationsSdqd__5Edges_5IndexQZXE_SbSdSiSgtAA13NoConvergenceVYKSzRd__lF","symbolKind":"method","extendedModule":"GraphProtocols","title":"algebraicConnectivity(weight:normalized:tolerance:maxIterations:)","roleHeading":"Instance Method"},"abstract":[{"text":"The algebraic connectivity λ₂ (Fiedler 1973): the second smallest eigenvalue of the","type":"text"},{"text":" ","type":"text"},{"text":"Laplacian L (of the normalized Laplacian N with ","type":"text"},{"type":"codeVoice","code":"normalized"},{"text":"), 0 exactly when the graph is","type":"text"},{"text":" ","type":"text"},{"text":"not connected (a weight-0 edge does not connect).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"algebraicConnectivity"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-8, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sz","text":"BinaryInteger"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected","type":"text"},{"text":" ","type":"text"},{"text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with","type":"text"},{"text":" ","type":"text"},{"code":"normalized","type":"codeVoice"},{"text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a","type":"text"},{"text":" ","type":"text"},{"text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is","type":"text"},{"text":" ","type":"text"},{"text":"accepted when its residual is at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" · λ₂, so λ₂ is relative to itself however","type":"text"},{"text":" ","type":"text"},{"text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The","type":"text"},{"text":" ","type":"text"},{"text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s (34 n from 5,000","type":"text"},{"text":" ","type":"text"},{"text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the","type":"text"},{"text":" ","type":"text"},{"text":"solver.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"text":"At least two vertices, and ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":". Every weight is finite and","type":"text"},{"text":" ","type":"text"},{"text":"nonnegative, and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when the Lanczos run on L⁺ spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" matrix–vector"},{"type":"text","text":" "},{"type":"text","text":"products (1,000 when nil) without converging, with the products spent and the Ritz"},{"type":"text","text":" "},{"type":"text","text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to"},{"type":"text","text":" "},{"type":"text","text":"shift-invert rather than throwing, after 4,000 + 20√n products or "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,"},{"type":"text","text":" "},{"type":"text","text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the"},{"type":"text","text":" "},{"type":"text","text":"dense solver answers and "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" is unused. Only a tolerance below rounding has"},{"type":"text","text":" "},{"type":"text","text":"reached the default limits in the measurements."}]}],"type":"aside","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:maxiterations:)-8c3i6"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/algebraicConnectivity(weight:normalized:tolerance:maxIterations:)-8c3i6":{"kind":"symbol","abstract":[{"text":"The algebraic connectivity λ₂ (Fiedler 1973): the second smallest eigenvalue of the","type":"text"},{"text":" ","type":"text"},{"text":"Laplacian L (of the normalized Laplacian N with ","type":"text"},{"type":"codeVoice","code":"normalized"},{"text":"), 0 exactly when the graph is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"not connected (a weight-0 edge does not connect)."}],"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:maxiterations:)-8c3i6","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind"