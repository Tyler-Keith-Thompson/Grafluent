,"modules":[{"name":"SpectralGraphTheory","relatedModules":["GraphProtocols"]}]},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"The algebraic connectivity λ₂ (Fiedler 1973): the second smallest eigenvalue of the"},{"type":"text","text":" "},{"type":"text","text":"Laplacian L (of the normalized Laplacian N with "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":"), 0 exactly when the graph is"},{"type":"text","text":" "},{"type":"text","text":"not connected (a weight-0 edge does not connect)."}],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(weight:normalized:tolerance:maxIterations:)-8c3i6","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:maxiterations:)-8c3i6"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"algebraicConnectivity","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"text":"normalized","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-8, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryInteger","kind":"typeIdentifier","preciseIdentifier":"s:Sz"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Thick-restart Lanczos (Wu–Simon) with full reorthogonalization, the null space projected"},{"type":"text","text":" "},{"type":"text","text":"out, from a fixed start vector: on σI − L (σ twice the largest weighted degree; 2I − N with"},{"type":"text","text":" "},{"type":"codeVoice","code":"normalized"},{"type":"text","text":") while σ\/λ₂ is moderate, else on L⁺ by shift-invert, each product a"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient solve with L grounded at the vertex of largest degree. A Ritz pair is"},{"type":"text","text":" "},{"type":"text","text":"accepted when its residual is at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" · λ₂, so λ₂ is relative to itself however"},{"type":"text","text":" "},{"type":"text","text":"the weights spread; the value is then the vector’s Rayleigh quotient, a sum over edges. The"},{"type":"text","text":" "},{"type":"text","text":"dense solver below 64 vertices. O((n + m) · products) time; 31 n "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s (34 n from 5,000"},{"type":"text","text":" "},{"type":"text","text":"vertices, for the polynomial filter), and on the shift-invert path O(n + m) more for the"},{"type":"text","text":" "},{"type":"text","text":"solver."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"At least two vertices, and ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":". Every weight is finite and","type":"text"},{"text":" ","type":"text"},{"text":"nonnegative, and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at least 1.","type":"text"}]}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" when the Lanczos run on L⁺ spends ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" matrix–vector","type":"text"},{"text":" ","type":"text"},{"text":"products (1,000 when nil) without converging, with the products spent and the Ritz","type":"text"},{"text":" ","type":"text"},{"text":"residual relative to 1\/λ₂. The run on σI − L that may come first hands over to","type":"text"},{"text":" ","type":"text"},{"text":"shift-invert rather than throwing, after 4,000 + 20√n products or ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whichever is smaller. Each shift-invert product is a conjugate-gradient solve that throws,","type":"text"},{"text":" ","type":"text"},{"text":"with its own iterations and relative residual, after 20,000 + 2n. Below 64 vertices the","type":"text"},{"text":" ","type":"text"},{"text":"dense solver answers and ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" is unused. Only a tolerance below rounding has","type":"text"},{"text":" ","type":"text"},{"text":"reached the default limits in the measurements.","type":"text"}],"type":"paragraph"}],"name":"Throws","type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","type":"topic","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"title":"Edges","kind":"symbol","abstract":[]},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph/algebraicConnectivity(weight:normalized:tolerance:maxIterations:)-8c3i6":{"url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/algebraicconnectivity(weight:normalized:tolerance:maxiterations:)-8c3i6","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/algebraicConnectivity(weight:normalized:tolerance:maxIterations:)-8c3i6","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The algebraic connectivity λ₂ (Fiedler 1973): the second smallest eigenvalue of the"},{"type":"text","text":" "},{"type":"text","text":"Laplacian L (of the normalized Laplacian N with "},{"type":