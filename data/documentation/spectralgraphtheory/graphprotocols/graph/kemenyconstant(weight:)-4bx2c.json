{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kemenyConstant"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BinaryFloatingPoint","preciseIdentifier":"s:SB"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Vol · (Σᵢ πᵢ (L_g⁻¹)ᵢᵢ − πᵀ L_g⁻¹ π), π the stationary distribution, which is","type":"text"},{"text":" ","type":"text"},{"text":"(1\/2vol) Σᵢⱼ dᵢ dⱼ R(i, j) (commute times are vol · R), with L_g the Laplacian grounded at","type":"text"},{"text":" ","type":"text"},{"text":"the vertex of largest degree and eliminated as for ","type":"text"},{"type":"codeVoice","code":"numberOfSpanningTrees"},{"text":". Every term is a","type":"text"},{"text":" ","type":"text"},{"text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its","type":"text"},{"text":" ","type":"text"},{"text":"relative accuracy under any weight spread. O(n³) time, n² ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Every weight is finite and nonnegative.","type":"text"}]}],"type":"aside"}]}],"sections":[],"identifier":{"url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/kemenyConstant(weight:)-4bx2c","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"abstract":[{"text":"The Kemeny constant: the expected number of steps of the random walk (edge weights as","type":"text"},{"text":" ","type":"text"},{"text":"transition rates, a loop taken with probability 2w\/d(v)) from a vertex to a target drawn","type":"text"},{"text":" ","type":"text"},{"text":"from the stationary distribution, which does not depend on the start; Σ_{i≥2} 1\/μᵢ over the","type":"text"},{"text":" ","type":"text"},{"text":"normalized Laplacian spectrum. nil when the graph is not connected, 0 for zero or one vertex.","type":"text"}],"metadata":{"symbolKind":"method","role":"symbol","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE14kemenyConstant6weightSdSgqd__5Edges_5IndexQZXE_tSBRd__lF","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpectralGraphTheory"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParam