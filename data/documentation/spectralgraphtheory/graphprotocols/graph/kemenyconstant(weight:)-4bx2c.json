{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kemenyConstant","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"BinaryFloatingPoint","kind":"typeIdentifier","preciseIdentifier":"s:SB"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Vol · (Σᵢ πᵢ (L_g⁻¹)ᵢᵢ − πᵀ L_g⁻¹ π), π the stationary distribution, which is","type":"text"},{"text":" ","type":"text"},{"text":"(1\/2vol) Σᵢⱼ dᵢ dⱼ R(i, j) (commute times are vol · R), with L_g the Laplacian grounded at","type":"text"},{"text":" ","type":"text"},{"text":"the vertex of largest degree and eliminated as for ","type":"text"},{"code":"numberOfSpanningTrees","type":"codeVoice"},{"text":". Every term is a","type":"text"},{"text":" ","type":"text"},{"text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its","type":"text"},{"text":" ","type":"text"},{"text":"relative accuracy under any weight spread. O(n³) time, n² ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives the weight of the edge at each position, read once per position; a weight of","type":"text"},{"text":" ","type":"text"},{"text":"0 is no edge.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"Every weight is finite and nonnegative.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Precondition"}]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/kemenyconstant(weight:)-4bx2c"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"kemenyConstant(weight:)","role":"symbol","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P08SpectralA6TheoryE14kemenyConstant6weightSdSgqd__5Edges_5IndexQZXE_tSBRd__lF","remoteSource":{"fileName":"ElectricalNetworks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/ElectricalNetworks.swift#L270"},"extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kemenyConstant"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":