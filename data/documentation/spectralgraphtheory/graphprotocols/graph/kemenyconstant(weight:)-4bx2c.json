nary distribution, which is"},{"type":"text","text":" "},{"type":"text","text":"(1\/2vol) Σᵢⱼ dᵢ dⱼ R(i, j) (commute times are vol · R), with L_g the Laplacian grounded at"},{"type":"text","text":" "},{"type":"text","text":"the vertex of largest degree and eliminated as for "},{"type":"codeVoice","code":"numberOfSpanningTrees"},{"type":"text","text":". Every term is a"},{"type":"text","text":" "},{"type":"text","text":"sum of positive ones and the difference loses at most a factor n, so the result keeps its"},{"type":"text","text":" "},{"type":"text","text":"relative accuracy under any weight spread. O(n³) time, n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives the weight of the edge at each position, read once per position; a weight of"},{"type":"text","text":" "},{"type":"text","text":"0 is no edge."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and nonnegative."}],"type":"paragraph"}],"name":"Precondition"}],"kind":"content"}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols":{"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols","type":"topic","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","abstract":[],"role":"collection","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl",