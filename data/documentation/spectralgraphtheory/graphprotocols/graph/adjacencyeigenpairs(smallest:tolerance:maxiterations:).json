":"codeVoice"},{"text":", ","type":"text"},{"code":"tolerance > 0","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"when given, is at least 1.","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" when a Lanczos run spends ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" products without","type":"text"},{"text":" ","type":"text"},{"text":"converging, with the products spent and the largest Ritz residual on the tolerance’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"type":"codeVoice","code":"adjacencySpectrum"},{"text":" does.","type":"text"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/adjacencyeigenpairs(smallest:tolerance:maxiterations:)"]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"url":"\/documentation\/spectralgraphtheory\/eigenpairs","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Eigenpairs"}],"abstract":[{"type":"text","text":"Eigenpairs of a graph matrix at one end of its spectrum: the eigenvalues, from that end"},{"type":"text","text":" "},{"type":"text","text":"(ascending for the smallest, descending for the largest), and an orthonormal eigenvector for"},{"type":"text","text":" "},{"type":"text","text":"each, with one entry per vertex."}],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralG