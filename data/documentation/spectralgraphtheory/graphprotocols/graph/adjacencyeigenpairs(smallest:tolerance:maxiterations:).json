","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}]}],"name":"Throws"}]}],"metadata":{"symbolKind":"method","remoteSource":{"fileName":"Eigenpairs.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpectralGraphTheory\/Eigenpairs.swift#L116"},"roleHeading":"Instance Method","extendedModule":"GraphProtocols","title":"adjacencyEigenpairs(smallest:tolerance:maxIterations:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjacencyEigenpairs"},{"text":"(","kind":"text"},{"text":"smallest","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:19SpectralGraphTheory10EigenpairsV","text":"Eigenpairs","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"name":