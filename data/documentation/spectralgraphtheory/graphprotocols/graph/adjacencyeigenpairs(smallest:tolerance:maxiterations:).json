":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" products without","type":"text"},{"text":" ","type":"text"},{"text":"converging, with the products spent and the largest Ritz residual on the tolerance’s","type":"text"},{"text":" ","type":"text"},{"text":"scale. The dense solver throws as ","type":"text"},{"type":"codeVoice","code":"adjacencySpectrum"},{"text":" does.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Throws"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph\/adjacencyEigenpairs(smallest:tolerance:maxIterations:)"},"abstract":[{"text":"The k smallest eigenvalues of the adjacency matrix A (","type":"text"},{"type":"codeVoice","code":"adjacencyMatrix()"},{"text":"), k = ","type":"text"},{"type":"codeVoice","code":"smallest"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ascending, each with a unit eigenvector (see "},{"type":"codeVoice","code":"Eigenpairs"},{"type":"text","text":")."}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"kind":"symbol","references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory":{"title":"SpectralGraphTheory","url":"\/documentation\/spectralgraphtheory","abstract":[],"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","type":"topic","role":"collection","kind":"symbol"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"navigatorTitle":[{"text":"Eigenpairs","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eigenpairs","kind":"identifier"}],"title":"Eigenpairs","identifier":"doc:\/\/SpectralGraphTheory\/documentation\/S