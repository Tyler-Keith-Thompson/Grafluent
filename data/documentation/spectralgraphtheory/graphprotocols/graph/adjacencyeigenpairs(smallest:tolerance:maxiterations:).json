Convergence"},{"type":"text","text":" when a Lanczos run spends "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" products without"},{"type":"text","text":" "},{"type":"text","text":"converging, with the products spent and the largest Ritz residual on the tolerance’s"},{"type":"text","text":" "},{"type":"text","text":"scale. The dense solver throws as "},{"type":"codeVoice","code":"adjacencySpectrum"},{"type":"text","text":" does."}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols","doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph"]]},"abstract":[{"text":"The k smallest eigenvalues of the adjacency matrix A (","type":"text"},{"code":"adjacencyMatrix()","type":"codeVoice"},{"text":"), k = ","type":"text"},{"code":"smallest","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"ascending, each with a unit eigenvector (see ","type":"text"},{"code":"Eigenpairs","type":"codeVoice"},{"text":").","type":"text"}],"variants":[{"paths":["\/documentation\/spectralgraphtheory\/graphprotocols\/graph\/adjacencyeigenpairs(smallest:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/GraphProtocols/Graph":{"identifier":"doc:\/\/SpectralGraphTheory\/documentation\/SpectralGraphTheory\/GraphProtocols\/Graph","title":"Graph","role":"symbol","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/spectralgraphtheory\/graphprotocols\/graph","type":"topic"},"doc://SpectralGraphTheory/documentation/SpectralGraphTheory/Eigenpairs":{"url":"\