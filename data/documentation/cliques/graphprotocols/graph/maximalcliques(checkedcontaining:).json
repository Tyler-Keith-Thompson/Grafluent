aximal cliques containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is not a","type":"text"},{"text":" ","type":"text"},{"text":"vertex of the graph.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","kind":"symbol","title":"maximalCliques(checkedContaining:)","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}]},"doc://Cliques/documentation/Cliques/GraphProtocols":{"role":"collection","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cliques\/graphprotocols","title":"GraphProtocols"},"doc://Cliques/documentation/Cliques":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","url":"\/documentation\/cliques","title":"Cliques","abstract":[]},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","type":"topic","role":"symbol","title":"MaximalCliques"}}}