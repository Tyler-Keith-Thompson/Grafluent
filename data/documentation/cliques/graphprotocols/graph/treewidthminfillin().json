{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treewidthMinFillIn"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"TreeDecomposition","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/TreeDecomposition","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Among vertices of equal fill-in, the one of least degree, then earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":", is"},{"type":"text","text":" "},{"type":"text","text":"taken: the rule of NetworkX’s "},{"type":"codeVoice","code":"treewidth_min_fill_in"},{"type":"text","text":" for a graph whose nodes are in the"},{"type":"text","text":" "},{"type":"text","text":"same order. Self-loops and parallel edges are ignored."}],"type":"paragraph"},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n (n + Σ_v d(v)²)) in the graph as filled in."}],"type":"paragraph"}]}]}],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph"]]},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treewidthMinFillIn"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"TreeDecomposition","pr