{"kind":"symbol","abstract":[{"type":"text","text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex"},{"type":"text","text":" "},{"type":"text","text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the"},{"type":"text","text":" "},{"type":"text","text":"remaining vertices form a clique. Its "},{"type":"codeVoice","code":"width"},{"type":"text","text":" is an upper bound on the treewidth, and is"},{"type":"text","text":" "},{"type":"text","text":"the treewidth of a chordal graph."}],"metadata":{"externalID":"s:14GraphProtocols0A0P7CliquesE18treewidthMinFillInAD17TreeDecompositionVy6VertexQzGyF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinFillIn","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"name":"Cliques","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cliques\/TreeDecomposition.swift#L162","fileName":"TreeDecomposition.swift"},"title":"treewidthMinFillIn()","symbolKind":"method","extendedModule":"GraphProtocols"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens"