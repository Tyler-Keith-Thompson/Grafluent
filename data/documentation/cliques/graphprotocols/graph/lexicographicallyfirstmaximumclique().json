{"metadata":{"roleHeading":"Instance Method","title":"lexicographicallyFirstMaximumClique()","externalID":"s:14GraphProtocols0A0P7CliquesE35lexicographicallyFirstMaximumCliqueSay6VertexQzGyF","role":"symbol","symbolKind":"method","extendedModule":"GraphProtocols","modules":[{"name":"Cliques","relatedModules":["GraphProtocols"]}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"remoteSource":{"fileName":"MaximumClique.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cliques\/MaximumClique.swift#L100"}},"sections":[],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}]}],"kind":"declarations"}],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"references":{"doc://Cliques/documentation/Cliques/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","abstract":[],"url":"\/documentation\/cliques\/graphprotocols","role":"collection","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","type":"topic","title":"Graph","url":"\/documentation\/cliques\/graphprotocols\/graph","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"abstract":[]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","abstract":[],"role":"collection","type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"lexicographicallyFirstMaximumClique()","type":"topic","role":"symbol"}}}