 one of","type":"text"},{"text":" ","type":"text"},{"text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is","type":"text"},{"text":" ","type":"text"},{"text":"taken, any other is taken exactly when a search finds the rest of a clique among the common","type":"text"},{"text":" ","type":"text"},{"text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of","type":"text"},{"text":" ","type":"text"},{"text":"the best clique so far is skipped. Up to one search per vertex and candidate, each","type":"text"},{"text":" ","type":"text"},{"text":"exponential in the worst case, so it can be far slower than ","type":"text"},{"code":"maximumClique()","type":"codeVoice"},{"text":"; the search","type":"text"},{"text":" ","type":"text"},{"text":"does not check for task cancellation.","type":"text"}],"variants":[{"paths":["\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]}]}],"references":{"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"title":"lexicographicallyFirstMaximumClique()","kind":"symbol","identifier":"doc: