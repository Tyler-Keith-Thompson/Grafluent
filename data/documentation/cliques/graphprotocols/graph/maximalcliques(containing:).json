{"abstract":[{"type":"text","text":"The maximal cliques containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", once each, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order: the"},{"type":"text","text":" "},{"type":"text","text":"maximal cliques of the subgraph its neighbors induce, in "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" order there,"},{"type":"text","text":" "},{"type":"text","text":"each with "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" added; "},{"type":"codeVoice","code":"[vertex]"},{"type":"text","text":" alone when it has no neighbor. Self-loops and parallel"},{"type":"text","text":" "},{"type":"text","text":"edges are ignored. O(n + m) before the first clique; memory O(n + m + degeneracy²), however"},{"type":"text","text":" "},{"type":"text","text":"many neighbors the vertex has."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(containing:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:7Cliques07MaximalA0V","k