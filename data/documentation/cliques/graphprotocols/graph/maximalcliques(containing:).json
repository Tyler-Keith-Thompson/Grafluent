ex","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"type":"topic","abstract":[],"url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols","role":"collection"},"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/cliques","title":"Cliques","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"ur