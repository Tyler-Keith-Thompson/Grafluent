ols","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"title":"Vertex","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex"}}}