{"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph"]]},"sections":[],"kind":"symbol","metadata":{"symbolKind":"method","modules":[{"name":"Cliques","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"externalID":"s:14GraphProtocols0A0P7CliquesE12cliqueNumberSiyF","title":"cliqueNumber()","roleHeading":"Instance Method","role":"symbol","extendedModule":"GraphProtocols"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()"},"abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"type":"codeVoice","code":"coreNumbers().degeneracy + 1"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, sto