ext":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"code":"find_cliques","type":"codeVoice"},{"text":", igraph ","type":"text"},{"code":"maximal_cliques","type":"codeVoice"},{"text":", JGraphT’s Bron–Kerbosch finders).","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","references":{"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"title":"Graph","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","abstract":[],"url":"\/documentation\/cliques","kind":"symbol","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"maximalCliques()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","type":"topic","kind":"symbol","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"MaximalCliques","type":"codeVoice"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"code":"find_cliques","type":"codeVoice"},{"text":", igraph ","type":"text"},{"code":"maximal_cliques","type":"codeVoice"},{"text":", JGraphT’s Bron–Kerbosch finders).","type":"text"}],"role":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"title":"MaximalCliques","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","url":"\/documentation\/cliques\/graphprotocols","type":"topic","kind":"symbol","abstract":[],"role":"collection"}}}