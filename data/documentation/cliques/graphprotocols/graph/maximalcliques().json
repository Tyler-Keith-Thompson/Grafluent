{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"MaximalCliques"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"type":"codeVoice","code":"find_cliques"},{"text":", igraph ","type":"text"},{"type":"codeVoice","code":"maximal_cliques"},{"text":", JGraphT’s Bron–Kerbosch finders).","type":"text"}],"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()"]}],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph"]]},"metadata":{"externalID":"s:14GraphProtocols0A0P7CliquesE07maximalC0AD07MaximalC0VyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s