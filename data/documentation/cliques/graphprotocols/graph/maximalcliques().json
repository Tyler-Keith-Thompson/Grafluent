{"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"MaximalCliques"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"type":"codeVoice","code":"find_cliques"},{"type":"text","text":", igraph "},{"type":"codeVoice","code":"maximal_cliques"},{"type":"text","text":", JGraphT’s Bron–Kerbosch finders)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"maximalCliques()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"extendedModule":"GraphProtocols","remoteSource":{"fileName":"MaximalCliques.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cliques\/MaximalCliques.swift#L303"},"roleHeading":"Instance Method","modules":[{"name":"Cliques","relatedModules":["GraphProtocols"]}],"role":"symbol","symbolKind":"method","externalID":"s:14GraphProtocols0A0P7CliquesE07