{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","kind":"typeIdentifier","text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"MaximalCliques"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one."}],"sections":[],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"externalID":"s:14GraphProtocols0A0P7CliquesE07maximalC0AD07MaximalC0VyxGyF","symbolKind":"method","remoteSource":{"fileName":"MaximalCliques.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cliques\/MaximalCliques.swift#L381"},"extendedModule":"GraphProtocols","role":"symbol","roleHeading":"Instance Method","title":"maximalCliques()","modules":[{"name":"Cliques","relatedModules":["GraphProtocols"]}]},"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()"]}],"references":{"doc://Cliques/documentation/Cliques/GraphProtocols":{"type":"topic","abstract":[],"url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols","role":"collection"},"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/cliques","title":"Cliques","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","navigatorTitle":[{"