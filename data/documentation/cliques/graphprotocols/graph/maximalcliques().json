t":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"}],"references":{"doc://Cliques/documentation/Cliques/GraphProtocols":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","role":"collection","title":"GraphProtocols","abstract":[],"type":"topic","url":"\/documentation\/cliques\/graphprotocols","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","title":"maximalCliques()","abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; see "},{"code":"MaximalCliques","type":"codeVoice"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one."}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","title":"Graph","abstract":[],"url":"\/documentation\/cliques\/graphprotocols\/graph","type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","role":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"text":" ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques":{"url":"\/documentation\/cliques","kind":"symbol","title":"Cliques","type":"topic","role":"collection","identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[]}}}