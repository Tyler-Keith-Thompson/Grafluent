"text":"TrussNumbers","kind":"identifier"}],"abstract":[{"type":"text","text":"The truss decomposition of an undirected graph (Cohen; Wang–Cheng), over its simple graph. An"},{"type":"text","text":" "},{"type":"text","text":"edge’s truss number is the largest k such that it lies in a subgraph where every edge is in at"},{"type":"text","text":" "},{"type":"text","text":"least k − 2 triangles: 2 for an edge in no triangle, k for an edge of a k-clique. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges share their simple edge’s number, and a self-loop has none."}],"role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"title":"Graph","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","url":"\/documentation\/cliques\/graphprotocols\/graph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"abstract":[],"role":"symbol"}}}