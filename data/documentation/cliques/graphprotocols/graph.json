ked:)","title":"cliqueNumber(checked:)","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"averageClustering","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"abstract":[{"type":"text","text":"The mean local clustering coefficient over every vertex, zeros included, summed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; 0 when empty."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","title":"averageClustering()","type":"topic","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","title":"Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","type":"topic","abstract":[],"title":"Cliques","kind":"symbol","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"type":"topic","abstract":[{"text":"A perfect elimination ordering, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: an order of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"another. It is the reverse of "},{"type":"codeVoice","code":"maximumCardinalitySearch()"},{"type":"text","text":"."}],"kind":"symbol","title":"perfectEliminationOrdering()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perfectEliminationOrdering","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]?","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex","type":"text"},{"text":" ","type":"text"},{"text":"index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Self-loops and parallel edges are","type":"text"},{"text":" ","type":"text"},{"text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their","type":"text"},{"text":" ","type":"text"},{"text":"symmetric difference. After ","type":"text"},{"code":"cliqueNumber()","type":"codeVoice"},{"text":"‘s search, each largest clique is searched for","type":"text"},{"text":" ","type":"text"},{"text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +","type":"text"},{"text":" ","type":"text"},{"text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of","type":"text"},{"text":" ","type":"text"},{"text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is","type":"text"},{"text":" ","type":"text"},{"text":"taken, any other is taken exactly when a search finds the rest of a clique among the common","type":"text"},{"text":" ","type":"text"},{"text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of","type":"text"},{"text":" ","type":"text"},{"text":"the best clique so far is skipped. Up to one search per vertex and candidate, each","type":"text"},{"text":" ","type":"text"},{"text":"exponential in the worst case, so it can be far slower than ","type":"text"},{"code":"maximumClique()","type":"codeVoice"},{"text":"; the search","type":"text"},{"text":" ","type":"text"},{"text":"does not check for task cancellation.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","title":"lexicographicallyFirstMaximumClique()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","type":"topic","abstract":[{"text":"The maximal cliques of a chordal graph, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: at most n","type":"text"},{"text":" ","type":"text"},{"text":"of them, each a vertex with its neighbors before it in ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"the order of that search, each clique’s vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. An isolated vertex","type":"text"},{"text":" ","type":"text"},{"text":"is a clique of one.","type":"text"}],"title":"chordalGraphCliques()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphCliques","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]]?","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"role":"symbol","abstract":[{"text":"The local clustering coefficient of ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", from its neighborhood alone: 2T \/ (d(d − 1)),","type":"text"},{"text":" ","type":"text"},{"text":"0 when it has fewer than two distinct neighbors.","type":"text"}],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","title":"clusteringCoefficient(of:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficient","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/onionLayers()":{"abstract":[{"type":"text","text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once). O(n + m)."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","title":"onionLayers()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onionLayers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques11OnionLayersV","text":"OnionLayers","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","type":"topic","kind":"symbol","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","title":"allCliques(sizes:)","abstract":[{"text":"Every clique whose size is in ","type":"text"},{"code":"sizes","type":"codeVoice"},{"text":", maximal or not, once each, lazily, each in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"AllCliques"},{"type":"text","text":" for the order. Self-loops and parallel edges are ignored,"},{"type":"text","text":" "},{"type":"text","text":"and the empty set is never listed. "},{"type":"codeVoice","code":"allCliques(sizes: 3 ... 3)"},{"type":"text","text":" lists the triangles,"},{"type":"text","text":" "},{"type":"codeVoice","code":"allCliques(sizes: 1...)"},{"type":"text","text":" every clique."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"allCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sizes"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SX","kind":"typeIdentifier","text":"RangeExpression"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:7Cliques03AllA0V","kind":"typeIdentifier","text":"AllCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treewidthMinFillIn"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","kind":"typeIdentifier","text":"TreeDecomposition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex"},{"type":"text","text":" "},{"type":"text","text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the"},{"type":"text","text":" "},{"type":"text","text":"remaining vertices form a clique. Its "},{"type":"codeVoice","code":"width"},{"type":"text","text":" is an upper bound on the treewidth, and is"},{"type":"text","text":" "},{"type":"text","text":"the treewidth of a chordal graph."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","title":"treewidthMinFillIn()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The number of triangles in the simple graph. O(m^(3\/2))."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","title":"triangleCount()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightClique","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A clique of greatest total weight in the simple graph, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, with weights"},{"type":"text","text":" "},{"type":"text","text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []"},{"type":"text","text":" "},{"type":"text","text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with"},{"type":"text","text":" "},{"type":"text","text":"a positive weight is searched with its later positive neighbors (at most "},{"code":"degeneracy","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s"},{"type":"text","text":" "},{"code":"max_weight_clique","type":"codeVoice"},{"type":"text","text":") for a clique beating the best so far. Exponential in the worst case;"},{"type":"text","text":" "},{"type":"text","text":"memory O(n + m + degeneracy²)."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","title":"maximumWeightClique(weight:)","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"role":"symbol","abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","kind":"symbol","title":"cliqueNumber()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"abstract":[{"text":"Whether ","type":"text"},{"code":"decomposition","type":"codeVoice"},{"text":" is a tree decomposition of this graph: at least one bag; its","type":"text"},{"text":" ","type":"text"},{"text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the","type":"text"},{"text":" ","type":"text"},{"text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop are together in some bag; and the bags holding any one vertex form a connected","type":"text"},{"text":" ","type":"text"},{"text":"subtree.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","title":"isTreeDecomposition(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isTreeDecomposition","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","type":"topic","kind":"symbol","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(of:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(of:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(of:)","type":"topic","abstract":[{"type":"text","text":"The size of a largest clique containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" (its node clique number): 1 for a vertex"},{"type":"text","text":" "},{"type":"text","text":"with no neighbor. One more than the clique number of the subgraph its neighbors induce,"},{"type":"text","text":" "},{"type":"text","text":"found as "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":" finds it; exponential in the worst case, memory O(n + m +"},{"type":"text","text":" "},{"type":"text","text":"degeneracy²). Self-loops and parallel edges are ignored."}],"title":"cliqueNumber(of:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","type":"topic","abstract":[{"type":"text","text":"The treewidth of a chordal graph, one less than its largest clique, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph"},{"type":"text","text":" "},{"type":"text","text":"is not chordal; −1 for the empty graph."}],"title":"chordalGraphTreewidth()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphTreewidth","kind":"identifier"},{"text":"() -> ","kind":"text