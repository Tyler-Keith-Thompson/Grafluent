."}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"role":"symbol","kind":"symbol","abstract":[{"text":"The treewidth of a chordal graph, one less than its largest clique, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph","type":"text"},{"text":" ","type":"text"},{"text":"is not chordal; −1 for the empty graph.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphTreewidth"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","title":"chordalGraphTreewidth()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","title":"Graph","url":"\/documentation\/cliques\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"abstract":[],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"abstract":[{"type":"text","text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge"},{"type":"text","text":" "},{"type":"text","text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:"},{"type":"text","text":" "},{"type":"text","text":"self-loops and parallel copies change nothing."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","type":"topic","title":"isChordal","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isChordal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(checkedContaining:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(checkedContaining:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checkedContaining"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"VertexNotFound","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","title":"maximalCliques(checkedContaining:)","abstract":[{"text":"The maximal cliques containing ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", throwing instead of trapping when it is not a","type":"text"},{"text":" ","type":"text"},{"text":"vertex of the graph.","type":"text"}],"role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The core decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coreNumbers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"CoreNumbers","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques11CoreNumbersV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","title":"coreNumbers()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","title":"lexicographicallyFirstMaximumClique()","abstract":[{"text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex","type":"text"},{"text":" ","type":"text"},{"text":"index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Self-loops and parallel edges are","type":"text"},{"text":" ","type":"text"},{"text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their","type":"text"},{"text":" ","type":"text"},{"text":"symmetric difference. After ","type":"text"},{"code":"cliqueNumber()","type":"codeVoice"},{"text":"‘s search, each largest clique is searched for","type":"text"},{"text":" ","type":"text"},{"text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +","type":"text"},{"text":" ","type":"text"},{"text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of","type":"text"},{"text":" ","type":"text"},{"text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is","type":"text"},{"text":" ","type":"text"},{"text":"taken, any other is taken exactly when a search finds the rest of a clique among the common","type":"text"},{"text":" ","type":"text"},{"text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of","type":"text"},{"text":" ","type":"text"},{"text":"the best clique so far is skipped. Up to one search per vertex and candidate, each","type":"text"},{"text":" ","type":"text"},{"text":"exponential in the worst case, so it can be far slower than ","type":"text"},{"code":"maximumClique()","type":"codeVoice"},{"text":"; the search","type":"text"},{"text":" ","type":"text"},{"text":"does not check for task cancellation.","type":"text"}],"role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinDegree()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinDegree()","title":"treewidthMinDegree()","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthmindegree()","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinDegree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A tree decomposition by the minimum-degree heuristic: repeatedly eliminate a vertex of"},{"type":"text","text":" "},{"type":"text","text":"least degree in the graph as filled in so far, the vertex earliest in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" among"},{"type":"text","text":" "},{"type":"text","text":"ties, making its neighbors a clique; stop when the remaining vertices form a clique. Its"},{"type":"text","text":" "},{"code":"width","type":"codeVoice"},{"type":"text","text":" is an upper bound on the treewidth."}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","title":"cliqueNumber()","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at"},{"type":"text","text":" "},{"type":"text","text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","title":"maximumWeightClique(weight:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightClique","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"A clique of greatest total weight in the simple graph, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, with weights","type":"text"},{"text":" ","type":"text"},{"text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []","type":"text"},{"text":" ","type":"text"},{"text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with","type":"text"},{"text":" ","type":"text"},{"text":"a positive weight is searched with its later positive neighbors (at most ","type":"text"},{"type":"codeVoice","code":"degeneracy"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"max_weight_clique"},{"text":") for a clique beating the best so far. Exponential in the worst case;","type":"text"},{"text":" ","type":"text"},{"text":"memory O(n + m + degeneracy²).","type":"text"}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()","title":"trussNumbers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trussNumbers"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques12TrussNumbersV","kind":"typeIdentifier","text":"TrussNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitivity"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Three times the triangles over the connected triples; 0 when there are no triangles."}],"title":"transitivity()","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","kind":"symbol","title":"averageClustering()","abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; 0 when empty.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"decomposition"},{"type":"text","text":" is a tree decomposition of this graph: at least one bag; its"},{"type":"text","text":" "},{"type":"text","text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the"},{"type":"text","text":" "},{"type":"text","text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a"},{"type":"text","text":" "},{"type":"text","text":"self-loop are together in some bag; and the bags holding any one vertex form a connected"},{"type":"text","text":" "},{"type":"text","text":"subtree."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTreeDecomposition"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","kind":"typeIdentifier","text":"TreeDecomposition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","title":"isTreeDecomposition(_:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)"}}}