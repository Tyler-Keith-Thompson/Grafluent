)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clusteringCoefficients"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV","kind":"typeIdentifier","text":"ClusteringCoefficients"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","role":"symbol","title":"clusteringCoefficients()","type":"topic","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2))."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"title":"maximalCliques()","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"MaximalCliques"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"url":"\/documentation\/cliques\/graphprotocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","abstract":[],"kind":"symbol","role":"collection","type":"topic","title":"GraphProtocols"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"abstract":[{"type":"text","text":"Three times the triangles over the connected triples; 0 when there are no triangles."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","title":"transitivity()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","kind":"symbol","abstract":[{"type":"text","text":"A clique of greatest total weight in the simple graph, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with weights"},{"type":"text","text":" "},{"type":"text","text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []"},{"type":"text","text":" "},{"type":"text","text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with"},{"type":"text","text":" "},{"type":"text","text":"a positive weight is searched with its later positive neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"max_weight_clique"},{"type":"text","text":") for a clique beating the best so far. Exponential in the worst case;"},{"type":"text","text":" "},{"type":"text","text":"memory O(n + m + degeneracy²)."}],"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","title":"maximumWeightClique(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightClique","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"abstract":[{"text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge","type":"text"},{"text":" ","type":"text"},{"text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:","type":"text"},{"text":" ","type":"text"},{"text":"self-loops and parallel copies change nothing.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","title":"isChordal","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isChordal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","title":"isTreeDecomposition(_:)","abstract":[{"text":"Whether ","type":"text"},{"type":"codeVoice","code":"decomposition"},{"text":" is a tree decomposition of this graph: at least one bag; its","type":"text"},{"text":" ","type":"text"},{"text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the","type":"text"},{"text":" ","type":"text"},{"text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop are together in some bag; and the bags holding any one vertex form a connected","type":"text"},{"text":" ","type":"text"},{"text":"subtree.","type":"text"}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTreeDecomposition"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","kind":"typeIdentifier","text":"TreeDecomposition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphCliques"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]]?"}],"kind":"symbol","role":"symbol","title":"chordalGraphCliques()","type":"topic","abstract":[{"type":"text","text":"The maximal cliques of a chordal graph, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the graph is not chordal: at most n"},{"type":"text","text":" "},{"type":"text","text":"of them, each a vertex with its neighbors before it in "},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"the order of that search, each clique’s vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. An isolated vertex"},{"type":"text","text":" "},{"type":"text","text":"is a clique of one."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()"},"doc://Cliques/documentation/Cliques":{"role":"collection","type":"topic","title":"Cliques","url":"\/documentation\/cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","kind":"symbol","abstract":[]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"type":"topic","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/cliques\/graphprotocols\/graph","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","kind":"symbol","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","role":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","role":"symbol","title":"maximumClique()","type":"topic","abstract":[{"type":"text","text":"A largest clique of the simple graph, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph."},{"type":"text","text":" "},{"type":"text","text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is"},{"type":"text","text":" "},{"type":"text","text":"depends on the search; for one fixed by a rule, see "},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It is the clique "},{"code":"cliqueNumber()","type":"codeVoice"},{"type":"text","text":"’s search finds, so it costs the same: exponential in the"},{"type":"text","text":" "},{"type":"text","text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A perfect elimination ordering, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the graph is not chordal: an order of the"},{"type":"text","text":" "},{"type":"text","text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one"},{"type":"text","text":" "},{"type":"text","text":"another. It is the reverse of "},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","role":"symbol","title":"perfectEliminationOrdering()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"perfectEliminationOrdering"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]?"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracy + 1"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"type":"codeVoice","code":"degeneracy"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","type":"topic","title":"cliqueNumber()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","abstract":[{"text":"Every clique whose size is in ","type":"text"},{"type":"codeVoice","code":"sizes"},{"text":", maximal or not, once each, lazily, each in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"AllCliques"},{"type":"text","text":" for the order. Self-loops and parallel edges are ignored,"},{"type":"text","text":" "},{"type":"text","text":"and the empty set is never listed. "},{"type":"codeVoice","code":"allCliques(sizes: 3 ... 3)"},{"type":"text","text":" lists the triangles,"},{"type":"text","text":" "},{"code":"allCliques(sizes: 1...)","type":"codeVoice"},{"text":" every clique.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"allCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sizes"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RangeExpression","preciseIdentifier":"s:SX"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"AllCliques","preciseIdentifier":"s:7Cliques03AllA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","role":"symbol","type":"topic","title":"allCliques(sizes:)"}}}