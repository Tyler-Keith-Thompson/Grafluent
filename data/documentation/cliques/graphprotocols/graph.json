/graphprotocols\/graph\/treewidthminfillin()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","title":"treewidthMinFillIn()","abstract":[{"type":"text","text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex"},{"type":"text","text":" "},{"type":"text","text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the"},{"type":"text","text":" "},{"type":"text","text":"remaining vertices form a clique. Its "},{"type":"codeVoice","code":"width"},{"type":"text","text":" is an upper bound on the treewidth, and is"},{"type":"text","text":" "},{"type":"text","text":"the treewidth of a chordal graph."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","type":"topic","abstract":[{"text":"The number of triangles through ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","title":"triangleCount(of:)","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"kind":"symbol","abstract":[{"type":"text","text":"A largest clique of the simple graph, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph."},{"type":"text","text":" "},{"type":"text","text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is"},{"type":"text","text":" "},{"text":"depends on the search; for one fixed by a rule, see ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It is the clique ","type":"text"},{"type":"codeVoice","code":"cliqueNumber()"},{"text":"’s search finds, so it costs the same: exponential in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","type":"topic","role":"symbol","title":"maximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/findHole()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/findhole()","kind":"symbol","abstract":[{"type":"text","text":"A hole, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is chordal: a chordless cycle of four or more vertices, the"},{"type":"text","text":" "},{"type":"text","text":"witness that the graph is not chordal. It starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"and leaves it through the lesser of its two edges there; between two vertices it takes"},{"type":"text","text":" "},{"type":"text","text":"the first edge in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order of the earlier one on the cycle."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findHole","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","title":"findHole()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficients","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ClusteringCoefficients","preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","abstract":[{"text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2)).","type":"text"}],"kind":"symbol","title":"clusteringCoefficients()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(checked:)":{"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(checked:)","type":"topic","title":"cliqueNumber(checked:)","abstract":[{"type":"text","text":"The size of a largest clique containing "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", throwing instead of trapping when it is"},{"type":"text","text":" "},{"type":"text","text":"not a vertex of the graph."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","type":"topic","abstract":[{"type":"text","text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trussNumbers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques12TrussNumbersV","text":"TrussNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()","title":"trussNumbers()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"title":"chordalGraphCliques()","abstract":[{"text":"The maximal cliques of a chordal graph, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: at most n","type":"text"},{"text":" ","type":"text"},{"text":"of them, each a vertex with its neighbors before it in ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"the order of that search, each clique’s vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. An isolated vertex"},{"type":"text","text":" "},{"type":"text","text":"is a clique of one."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphCliques","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]]?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(containing:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"The maximal cliques containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", once each, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order: the","type":"text"},{"text":" ","type":"text"},{"text":"maximal cliques of the subgraph its neighbors induce, in ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":" order there,","type":"text"},{"text":" ","type":"text"},{"text":"each with ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" added; ","type":"text"},{"code":"[vertex]","type":"codeVoice"},{"text":" alone when it has no neighbor. Self-loops and parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges are ignored. O(n + m) before the first clique; memory O(n + m + degeneracy²), however","type":"text"},{"text":" ","type":"text"},{"text":"many neighbors the vertex has.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(containing:)","kind":"symbol","title":"maximalCliques(containing:)","role":"symbol"},"doc://Cliques/documentation/Cliques":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","url":"\/documentation\/cliques","title":"Cliques","abstract":[]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(of:)":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(of:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":" (its node clique number): 1 for a vertex","type":"text"},{"text":" ","type":"text"},{"text":"with no neighbor. One more than the clique number of the subgraph its neighbors induce,","type":"text"},{"text":" ","type":"text"},{"text":"found as ","type":"text"},{"type":"codeVoice","code":"cliqueNumber()"},{"text":" finds it; exponential in the worst case, memory O(n + m +","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy²). Self-loops and parallel edges are ignored.","type":"text"}],"kind":"symbol","title":"cliqueNumber(of:)","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Three times the triangles over the connected triples; 0 when there are no triangles."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","title":"transitivity()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"title":"allCliques(sizes:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"allCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sizes"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SX","kind":"typeIdentifier","text":"RangeExpression"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:7Cliques03AllA0V","kind":"typeIdentifier","text":"AllCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","kind":"symbol","abstract":[{"text":"Every clique whose size is in ","type":"text"},{"code":"sizes","type":"codeVoice"},{"text":", maximal or not, once each, lazily, each in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"AllCliques","type":"codeVoice"},{"text":" for the order. Self-loops and parallel edges are ignored,","type":"text"},{"text":" ","type":"text"},{"text":"and the empty set is never listed. ","type":"text"},{"code":"allCliques(sizes: 3 ... 3)","type":"codeVoice"},{"text":" lists the triangles,","type":"text"},{"text":" ","type":"text"},{"code":"allCliques(sizes: 1...)","type":"codeVoice"},{"text":" every clique.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","type":"topic","kind":"symbol","abstract":[{"text":"A clique of greatest total weight in the simple graph, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, with weights","type":"text"},{"text":" ","type":"text"},{"text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []","type":"text"},{"text":" ","type":"text"},{"text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with","type":"text"},{"text":" ","type":"text"},{"text":"a positive weight is searched with its later positive neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"max_weight_clique","type":"codeVoice"},{"text":") for a clique beating the best so far. Exponential in the worst case;","type":"text"},{"text":" ","type":"text"},{"text":"memory O(n + m + degeneracy²).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightClique","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","title":"maximumWeightClique(weight:)","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","title":"cliqueNumber()","abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"code":"degeneracy","type":"codeVoice"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at"},{"type":"text","text":" "},{"type":"text","text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in"},{"type":"text","text":" "},{"type":"text","text":"descending degree, branching from the highest greedy colour down. Exponential in the worst"},{"type":"text","text":" "},{"type":"text","text":"case; memory O(n + m + degeneracy²)."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChordal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge"},{"type":"text","text":" "},{"type":"text","text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:"},{"type":"text","text":" "},{"type":"text","text":"self-loops and parallel copies change nothing."}],"kind":"symbol","title":"isChordal","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","kind":"symbol","abstract":[{"type":"text","text":"The number of triangles in the simple graph. O(m^(3\/2))."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","title":"triangleCount()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(checkedContaining:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(checkedContaining:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checkedContaining"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"The maximal cliques containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is not a","type":"text"},{"text":" ","type":"text"},{"text":"vertex of the graph.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","kind":"symbol","title":"maximalCliques(checkedContaining:)","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/bronKerboschEvents()":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The Bron–Kerbosch algorithm with Tomita’s pivot, as "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" runs it, as a sequence"},{"type":"text","text":" "},{"type":"text","text":"of events: each call entered with the vertex it adds to the clique and the sizes of its"},{"type":"text","text":" "},{"type":"text","text":"candidate and excluded sets, its pivot,"},{"type":"text","text":" "},{"type":"text","text":"each maximal clique, and each backtrack. See "},{"type":"codeVoice","code":"BronKerboschEvent"},{"type":"text","text":" for the order."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/bronkerboschevents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bronKerboschEvents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques18BronKerboschEventsV","text":"BronKerboschEvents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/bronKerboschEvents()","title":"bronKerboschEvents()","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perfectEliminationOrdering","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"A perfect elimination ordering, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is not chordal: an order of the"},{"type":"text","text":" "},{"type":"text","text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one"},{"type":"text","text":" "},{"type":"text","text":"another. It is the reverse of "},{"type":"codeVoice","code":"maximumCardinalitySearch()"},{"type":"text","text":"."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","kind":"symbol","title":"perfectEliminationOrdering()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"averageClustering","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; 0 when empty.","type":"text"}],"kind":"symbol","title":"averageClustering()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/onionLayers()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onionLayers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques11OnionLayersV","text":"OnionLayers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","abstract":[{"type":"text","text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once). O(n + m)."}],"kind":"symbol","title":"onionLayers()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinDegree()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinDegree()","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthmindegree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treewidthMinDegree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"text":"A tree decomposition by the minimum-degree heuristic: repeatedly eliminate a vertex of","type":"text"},{"text":" ","type":"text"},{"text":"least degree in the graph as filled in so far, the vertex earliest in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" among","type":"text"},{"text":" ","type":"text"},{"text":"ties, making its neighbors a clique; stop when the remaining vertices form a clique. Its","type":"text"},{"text":" ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" is an upper bound on the treewidth.","type":"text"}],"kind":"symbol","title":"treewidthMinDegree()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"MaximalCliques"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","title":"maximalCliques()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphTreewidth","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","title":"chordalGraphTreewidth()","abstract":[{"type":"text","text":"The treewidth of a chordal graph, one less than its largest clique, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph"},{"type":"text","text":" "},{"type":"text","text":"is not chordal; −1 for the empty graph."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","kind":"symbol","abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"code":"cliqueNumber()","type":"codeVoice"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"code":"maximumClique()","type":"codeVoice"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","title":"lexicographicallyFirstMaximumClique()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","kind":"symbol","abstract":[{"text":"The core decomposition of the simple graph underlying this one (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m).","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreNumbers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques11CoreNumbersV","text":"CoreNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","title":"coreNumbers()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isTreeDecomposition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"TreeDecomposition","preciseIdentifier":"s:7Cliques17TreeDecompositionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"decomposition"},{"type":"text","text":" is a tree decomposition of this graph: at least one bag; its"},{"type":"text","text":" "},{"type":"text","text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the"},{"type":"text","text":" "},{"type":"text","text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a"},{"type":"text","text":" "},{"type":"text","text":"self-loop are together in some bag; and the bags holding any one vertex form a connected"},{"type":"text","text":" "},{"type":"text","text":"subtree."}],"kind":"symbol","title":"isTreeDecomposition(_:)","role":"symbol"}}}