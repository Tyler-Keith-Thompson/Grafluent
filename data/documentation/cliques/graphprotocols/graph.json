/triangleCount(of:)":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","abstract":[{"text":"The number of triangles through ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone.","type":"text"}],"kind":"symbol","title":"triangleCount(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","title":"cliqueNumber()","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]}}}