ordal","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isChordal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge","type":"text"},{"text":" ","type":"text"},{"text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:","type":"text"},{"text":" ","type":"text"},{"text":"self-loops and parallel copies change nothing.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","title":"clusteringCoefficients()","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2))."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficients","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV","text":"ClusteringCoefficients","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"type":"codeVoice","code":"coreNumbers().degeneracy + 1"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at"},{"type":"text","text":" "},{"type":"text","text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in"},{"type":"text","text":" "},{"type":"text","text":"descending degree, branching from the highest greedy colour down. Exponential in the worst"},{"type":"text","text":" "},{"type":"text","text":"case; memory O(n + m + degeneracy²)."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"cliqueNumber()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"type":"topic","title":"allCliques(sizes:)","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","abstract":[{"text":"Every clique whose size is in ","type":"text"},{"code":"sizes","type":"codeVoice"},{"text":", maximal or not, once each, lazily, each in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"AllCliques","type":"codeVoice"},{"text":" for the order. Self-loops and parallel edges are ignored,","type":"text"},{"text":" ","type":"text"},{"text":"and the empty set is never listed. "