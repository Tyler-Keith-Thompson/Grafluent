type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"abstract":[{"text":"The number of triangles in the simple graph. O(m^(3\/2)).","type":"text"}],"title":"triangleCount()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols\/graph","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","type":"topic","url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clusteringCoefficient"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","type":"topic","title":"clusteringCoefficient(of:)","abstract":[{"text":"The local clustering coefficient of ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone: 2T \/ (d(d − 1)),","type":"text"},{"text":" ","type":"text"},{"text":"0 when it has fewer than two distinct neighbors.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"title":"maximumClique()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The lexicographically least largest clique by vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the"},{"type":"text","text":" "},{"type":"text","text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree; of two cliques of one size, the lesser is the"},{"type":"text","text":" "},{"type":"text","text":"one holding the least vertex of their symmetric difference. For each v, a witness clique W"},{"type":"text","text":" "},{"type":"text","text":"(any one of the right size) guides a pass over the candidates in ascending number: a"},{"type":"text","text":" "},{"type":"text","text":"candidate in W is taken, any other is taken exactly when a search finds the rest of a clique"},{"type":"text","text":" "},{"type":"text","text":"among the common neighbors left (which then becomes W). A v whose candidates all exceed the"},{"type":"text","text":" "},{"type":"text","text":"least vertex of the best clique so far is skipped. Exponential in the worst case."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","type":"topic","title":"averageClustering()","abstract":[{"type":"text","text":"The mean local clustering coefficient over every vertex, zeros included, summed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; 0 when empty."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","type":"topic","title":"cliqueNumber()","abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","title":"Graph","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[],"url":"\/documentation\/cliques\/graphprotocols\/graph"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","type":"topic","title":"maximalCliques()","abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"MaximalCliques"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"type":"codeVoice","code":"find_cliques"},{"type":"text","text":", igraph "},{"type":"codeVoice","code":"maximal_cliques"},{"type":"text","text":", JGraphT’s Bron–Kerbosch finders)."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"abstract":[{"type":"text","text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2))."}],"title":"clusteringCoefficients()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","type":"topic","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clusteringCoefficients"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"ClusteringCoefficients","preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"title":"transitivity()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitivity"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","abstract":[{"type":"text","text":"Three times the triangles over the connected triples; 0 when there are no triangles."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","role":"symbol"}}}