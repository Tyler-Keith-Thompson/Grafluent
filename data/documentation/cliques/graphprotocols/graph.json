rgest clique is searched for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from its first vertex in degeneracy order, among that vertex’s later neighbors, so memory"},{"type":"text","text":" "},{"type":"text","text":"stays O(n + m + degeneracy²) however large a hub’s degree; of two cliques of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser is the one holding the least vertex of their symmetric difference. Exponential in the"},{"type":"text","text":" "},{"type":"text","text":"worst case."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","title":"maximumClique()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","abstract":[{"text":"The number of triangles through ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","title":"triangleCount(of:)","type":"topic","role":"symbol"},"doc://Cliques/documen