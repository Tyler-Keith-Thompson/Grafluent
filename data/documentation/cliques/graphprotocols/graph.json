bersV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","url":"\/documentation\/cliques\/graphprotocols","title":"GraphProtocols","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"abstract":[{"type":"text","text":"A largest clique of the simple graph, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph."},{"type":"text","text":" "},{"type":"text","text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is"},{"type":"text","text":" "},{"type":"text","text":"depends on the search; for one fixed by a rule, see "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It is the clique "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"’s search finds, so it costs the same: exponential in the"},{"type":"text","text":" "},{"type":"text","text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","title":"maximumClique()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"type":"topic","ki