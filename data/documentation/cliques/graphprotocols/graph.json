"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"title":"chordalGraphCliques()","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphCliques"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]]?"}],"abstract":[{"type":"text","text":"The maximal cliques of a chordal graph, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the graph is not chordal: at most n"},{"type":"text","text":" "},{"type":"text","text":"of them, each a vertex with its neighbors before it in "},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"the order of that search, each clique’s vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. An isolated vertex"},{"type":"text","text":" "},{"type":"text","text":"is a clique of one."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","abstract":[{"type":"text","text":"Three times the triangles over the connected triples; 0 when there are no triangles."}],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"type":"topic","title":"transitivity()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"title":"trussNumbers()","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trussNumbers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques12TrussNumbersV","text":"TrussNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","role":"symbol","title":"triangleCount(of:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","abstract":[{"type":"text","text":"The number of triangles through "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", from its neighborhood alone."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"lexicographicallyFirstMaximumClique()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/onionLayers()":{"kind":"symbol","type":"topic","title":"onionLayers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onionLayers"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques11OnionLayersV","kind":"typeIdentifier","text":"OnionLayers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once). O(n + m).","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","kind":"symbol","role":"symbol","title":"maximumWeightClique(weight:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","abstract":[{"text":"A clique of greatest total weight in the simple graph, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, with weights","type":"text"},{"text":" ","type":"text"},{"text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []","type":"text"},{"text":" ","type":"text"},{"text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with","type":"text"},{"text":" ","type":"text"},{"text":"a positive weight is searched with its later positive neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"max_weight_clique","type":"codeVoice"},{"text":") for a clique beating the best so far. Exponential in the worst case;","type":"text"},{"text":" ","type":"text"},{"text":"memory O(n + m + degeneracy²).","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightClique"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/findHole()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/findhole()","title":"findHole()","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","abstract":[{"text":"A hole, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when the graph is chordal: a chordless cycle of four or more vertices, the","type":"text"},{"text":" ","type":"text"},{"text":"witness that the graph is not chordal. It starts at its least vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order","type":"text"},{"text":" ","type":"text"},{"text":"and leaves it through the lesser of its two edges there; between two vertices it takes","type":"text"},{"text":" ","type":"text"},{"text":"the first edge in ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order of the earlier one on the cycle.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findHole","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","type":"topic"}}}