/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The local clustering coefficient of "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", from its neighborhood alone: 2T \/ (d(d − 1)),"},{"type":"text","text":" "},{"type":"text","text":"0 when it has fewer than two distinct neighbors."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","role":"symbol","title":"clusteringCoefficient(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficient","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"abstract":[{"type":"text","text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex"},{"type":"text","text":" "},{"type":"text","text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the"},{"type":"text","text":" "},{"type":"text","text":"remaining vertices form a clique. Its "},{"type":"codeVoice","code":"width"},{"type":"text","text":" is an upper bound on the treewidth, and is"},{"type":"text","text":" "},{"type":"text","text":"the treewidth of a chordal graph."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","title":"treewidthMinFillIn()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinFillIn","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TreeDecomposition","preciseIdentifier":"s:7Cliques17TreeDecompositionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/findHole()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findHole"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"title":"findHole()","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/findhole()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","kind":"symbol","abstract":[{"type":"text","text":"A hole, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is chordal: a chordless cycle of four or more vertices, the"},{"type":"text","text":" "},{"type":"text","text":"witness that the graph is not chordal. It starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"text":" order","type":"text"},{"text":" ","type":"text"},{"text":"and leaves it through the lesser of its two edges there; between two vertices it takes","type":"text"},{"text":" ","type":"text"},{"text":"the first edge in ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order of the earlier one on the cycle.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"abstract":[{"type":"text","text":"The treewidth of a chordal graph, one less than its largest clique, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph"},{"type":"text","text":" "},{"type":"text","text":"is not chordal; −1 for the empty graph."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","type":"topic","title":"chordalGraphTreewidth()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphTreewidth"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"abstract":[{"text":"The core decomposition of the simple graph underlying this one (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreNumbers"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques11CoreNumbersV","text":"CoreNumbers","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","role":"symbol","type":"topic","title":"coreNumbers()"},"doc: