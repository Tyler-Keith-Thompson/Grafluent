eringCoefficients()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","abstract":[{"text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2)).","type":"text"}],"type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"type":"topic","title":"triangleCount(of:)","kind":"symbol","abstract":[{"type":"text","text":"The number of triangles through "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", from its neighborhood alone."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","url":"\/documentation\/cliques\/graphprotocols","role":"collection","title":"GraphProtocols"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"type":"topic","title":"maximalCliques()","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"MaximalCliques"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"type":"codeVoice","code":"find_cliques"},{"type":"text","text":", igraph "},{"type":"codeVoice","code":"maximal_cliques"},{"type":"text","text":", JGraphT’s Bron–Kerbosch finders)."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"title":"maximumClique()","abstract":[{"type":"text","text":"The lexicographically least largest clique by vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the"},{"type":"text","text":" "},{"type":"text","text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex in degeneracy order, among that vertex’s later neighbors, so memory"},{"type":"text","text":" "},{"type":"text","text":"stays O(n + m + degeneracy²) however large a hub’s degree; of two cliques of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser is the one holding the least vertex of their symmetric difference. Exponential in the"},{"type":"text","text":" "},{"type":"text","text":"worst case."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","type":"topic"}}}