doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"A largest clique of the simple graph, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is","type":"text"},{"text":" ","type":"text"},{"text":"depends on the search; for one fixed by a rule, see ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It is the clique ","type":"text"},{"type":"codeVoice","code":"cliqueNumber()"},{"text":"’s search finds, so it costs the same: exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation.","type":"text"}],"title":"maximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"type":"topic","abstract":[{"type":"text","text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge"},{"type":"text","text":" "},{"type":"text","text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:"},{"type":"text","text":" "},{"type":"text","text":"self-loops and parallel copies change nothing."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChordal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","kind":"symbol","role":"symbol","title":"isChordal","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"abstract":[{"type":"text","text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex"},{"type":"text","text":" "},{"type":"text","text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the"},{"type":"text","text":" "},{"type":"text","text":"remaining vertices form a clique. Its "},{"type":"codeVoice","code":"width"},{"type":"text","text":" is an upper bound on the treewidth, and is"},{"type":"text","text":" "},{"type":"text","text":"the treewidth of a chordal graph."}],"type":"topic","kind":"symbol","title":"treewidthMinFillIn()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinFillIn","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinDegree()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinDegree()","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthmindegree()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treewidthMinDegree"},{"kind":"text","text":"() -> "},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A tree decomposition by the minimum-degree heuristic: repeatedly eliminate a vertex of"},{"type":"text","text":" "},{"type":"text","text":"least degree in the graph as filled in so far, the vertex earliest in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" among"},{"type":"text","text":" "},{"type":"text","text":"ties, making its neighbors a clique; stop when the remaining vertices form a clique. Its"},{"type":"text","text":" "},{"code":"width","type":"codeVoice"},{"type":"text","text":" is an upper bound on the treewidth."}],"title":"treewidthMinDegree()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightClique"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"A clique of greatest total weight in the simple graph, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, with weights"},{"type":"text","text":" "},{"type":"text","text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []"},{"type":"text","text":" "},{"type":"text","text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with"},{"type":"text","text":" "},{"type":"text","text":"a positive weight is searched with its later positive neighbors (at most "},{"code":"degeneracy","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s"},{"type":"text","text":" "},{"code":"max_weight_clique","type":"codeVoice"},{"type":"text","text":") for a clique beating the best so far. Exponential in the worst case;"},{"type":"text","text":" "},{"type":"text","text":"memory O(n + m + degeneracy²)."}],"title":"maximumWeightClique(weight:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"abstract":[{"text":"Three times the triangles over the connected triples; 0 when there are no triangles.","type":"text"}],"type":"topic","kind":"symbol","title":"transitivity()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(containing:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(containing:)","role":"symbol","title":"maximalCliques(containing:)","type":"topic","abstract":[{"type":"text","text":"The maximal cliques containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", once each, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order: the"},{"type":"text","text":" "},{"text":"maximal cliques of the subgraph its neighbors induce, in ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":" order there,","type":"text"},{"text":" ","type":"text"},{"text":"each with ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" added; ","type":"text"},{"code":"[vertex]","type":"codeVoice"},{"text":" alone when it has no neighbor. Self-loops and parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges are ignored. O(n + m) before the first clique; memory O(n + m + degeneracy²), however","type":"text"},{"text":" ","type":"text"},{"text":"many neighbors the vertex has.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"maximalCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"containing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","url":"\/documentation\/cliques\/grap