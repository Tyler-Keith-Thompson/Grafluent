ex that raises the best size as it goes, stopping at"},{"type":"text","text":" "},{"type":"text","text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in"},{"type":"text","text":" "},{"type":"text","text":"descending degree, branching from the highest greedy colour down. Exponential in the worst"},{"type":"text","text":" "},{"type":"text","text":"case; memory O(n + m + degeneracy²)."}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficients","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"ClusteringCoefficients","preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2)).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","title":"clusteringCoefficients()","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","abstract":[],"title":"GraphProtocols","role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/cliqu