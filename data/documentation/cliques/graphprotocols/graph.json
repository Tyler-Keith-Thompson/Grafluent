xt":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","title":"triangleCount()","abstract":[{"text":"The number of triangles in the simple graph. O(m^(3\/2)).","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"type":"topic","title":"averageClustering()","abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; 0 when empty.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"url":"\/documentation\/cliques\/graphprotocols","type":"topic","kind":"symbol","title":"GraphProtocols","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","type":"topic","kind":"symbol","title":"coreNumbers()","abstract":[{"text":"The core decomposition of the simple graph underlying this one (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreNumbers"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques11CoreNumbersV","kind":"typeIdentifier","text":"CoreNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"type":"topic","title":"cliqueNumber()","abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"type":"codeVoice","code":"coreNumbers().degeneracy + 1"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, pruned by"},{"type":"text","text":" "},{"type":"text","text":"counts and a greedy coloring, stopping at the degeneracy bound. Exponential in the worst"},{"type":"text","text":" "},{"type":"text","text":"case; memory O(n + m + degeneracy²)."}],"kind":"symbol","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"type":"topic","title":"maximumClique()","abstract":[{"text":"The lexicographically least largest clique by vertex index, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the","type":"text"},{"text":" ","type":"text"},{"text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for","type":"text"},{"text":" ","type":"text"},{"text":"from its first vertex in degeneracy order, among that vertex’s later neighbors, so memory","type":"text"},{"text":" ","type":"text"},{"text":"stays O(n + m + degeneracy²) however large a hub’s degree; of two cliques of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser is the one holding the least vertex of their symmetric difference. Exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"worst case.","type":"text"}]},"doc://Cliques/documentation/Cliques":{"abstract":[],"type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/cliques","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"role":"symbol","navigatorT