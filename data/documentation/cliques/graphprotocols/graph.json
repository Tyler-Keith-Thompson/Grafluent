":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is not a","type":"text"},{"text":" ","type":"text"},{"text":"vertex of the graph.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","role":"symbol","type":"topic","title":"maximalCliques(checkedContaining:)","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","title":"averageClustering()","url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; 0 when empty.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"trussNumbers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TrussNumbers","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques12TrussNumbersV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()","title":"trussNumbers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","abstract":[{"text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"memory.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightClique"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","role":"symbol","title":"maximumWeightClique(weight:)","abstract":[{"type":"text","text":"A clique of greatest total weight in the simple graph, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with weights"},{"type":"text","text":" "},{"type":"text","text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []"},{"type":"text","text":" "},{"text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with","type":"text"},{"text":" ","type":"text"},{"text":"a positive weight is searched with its later positive neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"max_weight_clique","type":"codeVoice"},{"text":") for a clique beating the best so far. Exponential in the worst case;","type":"text"},{"text":" ","type":"text"},{"text":"memory O(n + m + degeneracy²).","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphCliques","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]]?","kind":"text"}],"abstract":[{"type":"text","text":"The maximal cliques of a chordal graph, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is not chordal: at most n"},{"type":"text","text":" "},{"type":"text","text":"of them, each a vertex with its neighbors before it in "},{"type":"codeVoice","code":"maximumCardinalitySearch()"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"the order of that search, each clique’s vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. An isolated vertex","type":"text"},{"text":" ","type":"text"},{"text":"is a clique of one.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","role":"symbol","type":"topic","title":"chordalGraphCliques()","kind":"symbol"},"doc://Cliques/documentation/Cliques":{"url":"\/documentation\/cliques","kind":"symbol","role":"collection","identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","abstract":[],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","title":"cliqueNumber()","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at"},{"type":"text","text":" "},{"type":"text","text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficients","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV","text":"ClusteringCoefficients"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","role":"symbol","title":"clusteringCoefficients()","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2))."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(containing:)":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"containing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)","title":"maximalCliques(containing:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(containing:)","abstract":[{"text":"The maximal cliques containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", once each, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order: the","type":"text"},{"text":" ","type":"text"},{"text":"maximal cliques of the subgraph its neighbors induce, in ","type":"text"},{"code":"maximalCliques()","type":"codeVoice"},{"text":" order there,","type":"text"},{"text":" ","type":"text"},{"text":"each with ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" added; ","type":"text"},{"code":"[vertex]","type":"codeVoice"},{"text":" alone when it has no neighbor. Self-loops and parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges are ignored. O(n + m) before the first clique; memory O(n + m + degeneracy²), however","type":"text"},{"text":" ","type":"text"},{"text":"many neighbors the vertex has.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinFillIn","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","type":"topic","role":"symbol","title":"treewidthMinFillIn()","abstract":[{"text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex","type":"text"},{"text":" ","type":"text"},{"text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the","type":"text"},{"text":" ","type":"text"},{"text":"remaining vertices form a clique. Its ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" is an upper bound on the treewidth, and is","type":"text"},{"text":" ","type":"text"},{"text":"the treewidth of a chordal graph.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"chordalGraphTreewidth","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","title":"chordalGraphTreewidth()","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","abstract":[{"type":"text","text":"The treewidth of a chordal graph, one less than its largest clique, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph"},{"type":"text","text":" "},{"type":"text","text":"is not chordal; −1 for the empty graph."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perfectEliminationOrdering","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]?","kind":"text"}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","role":"symbol","title":"perfectEliminationOrdering()","abstract":[{"text":"A perfect elimination ordering, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when the graph is not chordal: an order of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one","type":"text"},{"text":" ","type":"text"},{"text":"another. It is the reverse of ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","title":"maximalCliques()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"MaximalCliques"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"type":"topic","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","title":"Graph","url":"\/documentation\/cliques\/graphprotocols\/graph","abstract":[]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clusteringCoefficient"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","role":"symbol","title":"clusteringCoefficient(of:)","abstract":[{"text":"The local clustering coefficient of ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", from its neighborhood alone: 2T \/ (d(d − 1)),","type":"text"},{"text":" ","type":"text"},{"text":"0 when it has fewer than two distinct neighbors.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"abstract":[{"text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex","type":"text"},{"text":" ","type":"text"},{"text":"index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Self-loops and parallel edges are","type":"text"},{"text":" ","type":"text"},{"text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their","type":"text"},{"text":" ","type":"text"},{"text":"symmetric difference. After ","type":"text"},{"code":"cliqueNumber()","type":"codeVoice"},{"text":"‘s search, each largest clique is searched for","type":"text"},{"text":" ","type":"text"},{"text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +","type":"text"},{"text":" ","type":"text"},{"text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of","type":"text"},{"text":" ","type":"text"},{"text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is","type":"text"},{"text":" ","type":"text"},{"text":"taken, any other is taken exactly when a search finds the rest of a clique among the common","type":"text"},{"text":" ","type":"text"},{"text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of","type":"text"},{"text":" ","type":"text"},{"text":"the best clique so far is skipped. Up to one search per vertex and candidate, each","type":"text"},{"text":" ","type":"text"},{"text":"exponential in the worst case, so it can be far slower than ","type":"text"},{"code":"maximumClique()","type":"codeVoice"},{"text":"; the search","type":"text"},{"text":" ","type":"text"},{"text":"does not check for task cancellation.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","role":"symbol","type":"topic","title":"lexicographicallyFirstMaximumClique()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(checked:)":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)","title":"cliqueNumber(checked:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(checked:)","abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", throwing instead of trapping when it is","type":"text"},{"text":" ","type":"text"},{"text":"not a vertex of the graph.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/onionLayers()":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onionLayers"},{"kind":"text","text":"() -> "},{"text":"OnionLayers","preciseIdentifier":"s:7Cliques11OnionLayersV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once). O(n + m)."}],"title":"onionLayers()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChordal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","title":"isChordal","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","abstract":[{"text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge","type":"text"},{"text":" ","type":"text"},{"text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:","type":"text"},{"text":" ","type":"text"},{"text":"self-loops and parallel copies change nothing.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTreeDecomposition"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TreeDecomposition","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"decomposition"},{"type":"text","text":" is a tree decomposition of this graph: at least one bag; its"},{"type":"text","text":" "},{"type":"text","text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the"},{"type":"text","text":" "},{"text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop are together in some bag; and the bags holding any one vertex form a connected","type":"text"},{"text":" ","type":"text"},{"text":"subtree.","type":"text"}],"title":"isTreeDecomposition(_:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinDegree()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinDegree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinDegree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A tree decomposition by the minimum-degree heuristic: repeatedly eliminate a vertex of"},{"type":"text","text":" "},{"type":"text","text":"least degree in the graph as filled in so far, the vertex earliest in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" among"},{"type":"text","text":" "},{"text":"ties, making its neighbors a clique; stop when the remaining vertices form a clique. Its","type":"text"},{"text":" ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" is an upper bound on the treewidth.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthmindegree()","role":"symbol","type":"topic","title":"treewidthMinDegree()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sizes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RangeExpression","preciseIdentifier":"s:SX","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"AllCliques","preciseIdentifier":"s:7Cliques03AllA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","title":"allCliques(sizes:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","abstract":[{"type":"text","text":"Every clique whose size is in "},{"type":"codeVoice","code":"sizes"},{"type":"text","text":", maximal or not, once each, lazily, each in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"AllCliques"},{"text":" for the order. Self-loops and parallel edges are ignored,","type":"text"},{"text":" ","type":"text"},{"text":"and the empty set is never listed. ","type":"text"},{"type":"codeVoice","code":"allCliques(sizes: 3 ... 3)"},{"text":" lists the triangles,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"allCliques(sizes: 1...)"},{"text":" every clique.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreNumbers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques11CoreNumbersV","text":"CoreNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","role":"symbol","title":"coreNumbers()","abstract":[{"type":"text","text":"The core decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m)."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","title":"triangleCount()","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","abstract":[{"type":"text","text":"The number of triangles in the simple graph. O(m^(3\/2))."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","type":"topic","role":"symbol","title":"triangleCount(of:)","abstract":[{"text":"The number of triangles through ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(of:)":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(of:)","title":"cliqueNumber(of:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(of:)","abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" (its node clique number): 1 for a vertex","type":"text"},{"text":" ","type":"text"},{"text":"with no neighbor. One more than the clique number of the subgraph its neighbors induce,","type":"text"},{"text":" ","type":"text"},{"text":"found as ","type":"text"},{"type":"codeVoice","code":"cliqueNumber()"},{"text":" finds it; exponential in the worst case, memory O(n + m +","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy²). Self-loops and parallel edges are ignored.","type":"text"}]}}}