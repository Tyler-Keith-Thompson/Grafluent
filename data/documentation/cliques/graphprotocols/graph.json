{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/graphprotocols\/graph"]}],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"]]},"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"typeIdentifier","text":"Graph"}],"languages":["swift"]}]}],"metadata":{"role":"symbol","title":"Graph","symbolKind":"extension","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"roleHeading":"Extended Protocol","externalID":"s:e:s:14GraphProtocols0A0P7CliquesE03allC05sizesAD03AllC0VyxGqd___tSXRd__Si5BoundRtd__lF","modules":[{"name":"Cliques","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"kind":"symbol","topicSections":[{"anchor":"Instance-Properties","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal"],"title":"Instance Properties","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(of:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(checkedContaining:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinDegree()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()"],"title":"Instance Methods","generated":true}],"references":{"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; 0 when empty.","type":"text"}],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","title":"averageClustering()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"averageClustering","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}]},"doc://Cliques/documentation/Cliques/GraphProtocols":{"type":"topic","abstract":[],"url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"abstract":[{"type":"text","text":"The local clustering coefficient of "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", from its neighborhood alone: 2T \/ (d(d − 1)),"},{"type":"text","text":" "},{"type":"text","text":"0 when it has fewer than two distinct neighbors."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","title":"clusteringCoefficient(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficient","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","title":"lexicographicallyFirstMaximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","abstract":[{"text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex","type":"text"},{"text":" ","type":"text"},{"text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the","type":"text"},{"text":" ","type":"text"},{"text":"remaining vertices form a clique. Its ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" is an upper bound on the treewidth, and is","type":"text"},{"text":" ","type":"text"},{"text":"the treewidth of a chordal graph.","type":"text"}],"kind":"symbol","title":"treewidthMinFillIn()","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinFillIn","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/onionLayers()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onionLayers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"OnionLayers","preciseIdentifier":"s:7Cliques11OnionLayersV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once). O(n + m)."}],"type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","kind":"symbol","title":"onionLayers()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","abstract":[{"text":"The maximal cliques of a chordal graph, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: at most n","type":"text"},{"text":" ","type":"text"},{"text":"of them, each a vertex with its neighbors before it in ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"the order of that search, each clique’s vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. An isolated vertex","type":"text"},{"text":" ","type":"text"},{"text":"is a clique of one.","type":"text"}],"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","title":"chordalGraphCliques()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphCliques"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]]?"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trussNumbers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"TrussNumbers","preciseIdentifier":"s:7Cliques12TrussNumbersV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()","title":"trussNumbers()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"abstract":[{"text":"A perfect elimination ordering, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: an order of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one","type":"text"},{"text":" ","type":"text"},{"text":"another. It is the reverse of ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","title":"perfectEliminationOrdering()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perfectEliminationOrdering","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; see "},{"code":"MaximalCliques","type":"codeVoice"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one."}],"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","kind":"symbol","title":"maximalCliques()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"code":"degeneracy","type":"codeVoice"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at"},{"type":"text","text":" "},{"type":"text","text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in"},{"type":"text","text":" "},{"type":"text","text":"descending degree, branching from the highest greedy colour down. Exponential in the worst"},{"type":"text","text":" "},{"type":"text","text":"case; memory O(n + m + degeneracy²)."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","title":"cliqueNumber()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"abstract":[{"text":"The number of triangles through ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","kind":"symbol","title":"triangleCount(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/findHole()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","abstract":[{"type":"text","text":"A hole, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the graph is chordal: a chordless cycle of four or more vertices, the"},{"type":"text","text":" "},{"type":"text","text":"witness that the graph is not chordal. It starts at its least vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"and leaves it through the lesser of its two edges there; between two vertices it takes"},{"type":"text","text":" "},{"type":"text","text":"the first edge in "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" order of the earlier one on the cycle."}],"kind":"symbol","title":"findHole()","url":"\/documentation\/cliques\/graphprotocols\/graph\/findhole()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findHole"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isTreeDecomposition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"decomposition"},{"type":"text","text":" is a tree decomposition of this graph: at least one bag; its"},{"type":"text","text":" "},{"type":"text","text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the"},{"type":"text","text":" "},{"type":"text","text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a"},{"type":"text","text":" "},{"type":"text","text":"self-loop are together in some bag; and the bags holding any one vertex form a connected"},{"type":"text","text":" "},{"type":"text","text":"subtree."}],"type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","title":"isTreeDecomposition(_:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"abstract":[{"text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2)).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","kind":"symbol","title":"clusteringCoefficients()","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clusteringCoefficients"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV","text":"ClusteringCoefficients","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"abstract":[{"text":"A largest clique of the simple graph, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is","type":"text"},{"text":" ","type":"text"},{"text":"depends on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It is the clique ","type":"text"},{"code":"cliqueNumber()","type":"codeVoice"},{"text":"’s search finds, so it costs the same: exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","title":"maximumClique()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"abstract":[{"text":"Three times the triangles over the connected triples; 0 when there are no triangles.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","kind":"symbol","title":"transitivity()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","abstract":[{"text":"Every clique whose size is in ","type":"text"},{"type":"codeVoice","code":"sizes"},{"text":", maximal or not, once each, lazily, each in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"AllCliques"},{"text":" for the order. Self-loops and parallel edges are ignored,","type":"text"},{"text":" ","type":"text"},{"text":"and the empty set is never listed. ","type":"text"},{"type":"codeVoice","code":"allCliques(sizes: 3 ... 3)"},{"text":" lists the triangles,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"allCliques(sizes: 1...)"},{"text":" every clique.","type":"text"}],"kind":"symbol","title":"allCliques(sizes:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sizes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RangeExpression","kind":"typeIdentifier","preciseIdentifier":"s:SX"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">) -> ","kind":"text"},{"text":"AllCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques03AllA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightClique","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"A clique of greatest total weight in the simple graph, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, with weights","type":"text"},{"text":" ","type":"text"},{"text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []","type":"text"},{"text":" ","type":"text"},{"text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with","type":"text"},{"text":" ","type":"text"},{"text":"a positive weight is searched with its later positive neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"max_weight_clique","type":"codeVoice"},{"text":") for a clique beating the best so far. Exponential in the worst case;","type":"text"},{"text":" ","type":"text"},{"text":"memory O(n + m + degeneracy²).","type":