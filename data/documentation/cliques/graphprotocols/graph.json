stract":[{"text":"The maximal cliques containing ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", once each, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order: the","type":"text"},{"text":" ","type":"text"},{"text":"maximal cliques of the subgraph its neighbors induce, in ","type":"text"},{"type":"codeVoice","code":"maximalCliques()"},{"text":" order there,","type":"text"},{"text":" ","type":"text"},{"text":"each with ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":" added; ","type":"text"},{"type":"codeVoice","code":"[vertex]"},{"text":" alone when it has no neighbor. Self-loops and parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges are ignored. O(n + m) before the first clique; memory O(n + m + degeneracy²), however","type":"text"},{"text":" ","type":"text"},{"text":"many neighbors the vertex has.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(containing:)","role":"symbol","title":"maximalCliques(containing:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(checked:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"VertexNotFound","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","role":"symbol","title":"cliqueNumber(checked:)","type":"topic","abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is","type":"text"},{"text":" ","type":"text"},{"text":"not a vertex of the graph.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(checked:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"title":"lexicographicallyFirstMaximumClique()","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","kind":"symbol","abstract":[{"type":"text","text":"The number of triangles through "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", from its neighborhood alone."}],"identifier":"doc:\/\/Cliques\/