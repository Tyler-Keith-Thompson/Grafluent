ols0A0P7CliquesE07maximalC0AD07MaximalC0VyxGyF","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"role":"symbol"},"references":{"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"abstract":[{"text":"Three times the triangles over the connected triples; 0 when there are no triangles.","type":"text"}],"title":"transitivity()","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"role":"symbol","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"MaximalCliques","type":"codeVoice"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"code":"find_cliques","type":"codeVoice"},{"text":", igraph ","type":"text"},{"code":"maximal_cliques","type":"codeVoice"},{"text":", JGraphT’s Bron–Kerbosch finders).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","kind":"symbol","title":"maximalCliques()","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The lexicographically least largest clique by vertex index, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the"},{"type":"text","text":" "},{"type":"text","text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree; of two cliques of one size, the lesser is the"},{"type":"text","text":" "},{"type":"text","text":"one holding the least vertex of their symmetric difference. For each v, a witness clique W"},{"type":"text","text":" "},{"type":"text","text":"(any one of the right size) guides a pass over the candidates in ascending number: a"},{"type":"text","text":" "},{"type":"text","text":"candidate in W is taken, any other is taken exactly when a search finds the rest of a clique"},{"type":"text","text":" "},{"type":"text","text":"among the common neighbors left (which then becomes W). A v whose candidates all exceed the"},{"type":"text","text":" "},{"type":"text","text":"least vertex of the best clique so far is skipped. Exponential in the worst case."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","title":"maximumClique()","type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"abstract":[{"text":"The local clustering coefficient of ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone: 2T \/ (d(d − 1)),","type":"text"},{"text":" ","type":"text"},{"text":"0 when it has fewer than two distinct neighbors.","type":"text"}],"type":"topic","title":"clusteringCoefficient(of:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clusteringCoefficient"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"role":"symbol","abstract":[{"type":"text","text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an"},{"type":"text","text":" "},{"type":"text","text":"edgeless one, at most "},{"type":"codeVoice","code":"coreNumbers().degeneracy + 1"},{"type":"text","text":". Branch and bound in degeneracy order,"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s later neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":", those with a high enough core number)"},{"type":"text","text":" "},{"type":"text","text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at"},{"type":"text","text":" "},{"type":"text","text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in"},{"type":"text","text":" "},{"type":"text","text":"descending degree, branching from the highest greedy colour down. Exponential in the worst"},{"type":"text","text":" "},{"type":"text","text":"case; memory O(n + m + degeneracy²)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","kind":"symbol","title":"cliqueNumber()","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"role":"collection","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","kind":"symbol","type":"topic","title":"GraphProtocols","url":"\/documentation\/cliques\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directedView","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"title":"Graph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text"