Protocols\/Graph\/maximumClique()","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","title":"maximumClique()","abstract":[{"text":"The lexicographically least largest clique by vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the","type":"text"},{"text":" ","type":"text"},{"text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for","type":"text"},{"text":" ","type":"text"},{"text":"from its first vertex in degeneracy order, among that vertex’s later neighbors, so memory","type":"text"},{"text":" ","type":"text"},{"text":"stays O(n + m + degeneracy²) however large a hub’s degree; of two cliques of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser is the one holding the least vertex of their symmetric difference. Exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"worst case.","type":"text"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques":{"abstract":[],"url":"\/documentation\/cliques","role":"collection","kind":"symbol","type":"topic","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"abstract":[],"url":"\/documentation\/cliques\/graphprotocols","role":"collection","kind":"symbol","type":"topic","title":"GraphProtocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directed","t