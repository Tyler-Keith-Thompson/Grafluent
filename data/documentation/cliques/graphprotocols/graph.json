/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","role":"symbol","title":"onionLayers()","type":"topic","abstract":[{"type":"text","text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once). O(n + m)."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onionLayers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"OnionLayers","preciseIdentifier":"s:7Cliques11OnionLayersV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/findHole()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","abstract":[{"text":"A hole, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is chordal: a chordless cycle of four or more vertices, the","type":"text"},{"text":" ","type":"text"},{"text":"witness that the graph is not chordal. It starts at its least vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"and leaves it through the lesser of its two edges there; between two vertices it takes"},{"type":"text","text":" "},{"type":"text","text":"the first edge in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order of the earlier one on the cycle."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findHole"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier","text":"Cycle"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">?"}],"title":"findHole()","url":"\/documentation\/cliques\/graphprotocols\/graph\/findhole()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","kind":"symbol","role":"collection","title":"GraphProtocols","url":"\/documentation\/cliques\/graphprotocols"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(checkedContaining:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(checkedContaining:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checkedContaining"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The maximal cliques containing "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", throwing instead of trapping when it is not a"},{"type":"text","text":" "},{"type":"text","text":"vertex of the graph."}],"title":"maximalCliques(checkedContaining:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; 0 when empty.","type":"text"}],"type":"topic","kind":"symbol","title":"averageClustering()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"abstract":[{"type":"text","text":"The maximal cliques of a chordal graph, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the graph is not chordal: at most n"},{"type":"text","text":" "},{"type":"text","text":"of them, each a vertex with its neighbors before it in "},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"the order of that search, each clique’s vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. An isolated vertex"},{"type":"text","text":" "},{"type":"text","text":"is a clique of one."}],"type":"topic","kind":"symbol","title":"chordalGraphCliques()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphCliques","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]]?","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","role":"symbol","title":"triangleCount()","type":"topic","abstract":[{"type":"text","text":"The number of triangles in the simple graph. O(m^(3\/2))."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","title":"lexicographicallyFirstMaximumClique()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(of:)":{"abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" (its node clique number): 1 for a vertex","type":"text"},{"text":" ","type":"text"},{"text":"with no neighbor. One more than the clique number of the subgraph its neighbors induce,","type":"text"},{"text":" ","type":"text"},{"text":"found as ","type":"text"},{"code":"cliqueNumber()","type":"codeVoice"},{"text":" finds it; exponential in the worst case, memory O(n + m +","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy²). Self-loops and parallel edges are ignored.","type":"text"}],"type":"topic","kind":"symbol","title":"cliqueNumber(of:)","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","type":"topic","kind":"symbol","role":"symbol","title":"isTreeDecomposition(_:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTreeDecomposition"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"decomposition"},{"type":"text","text":" is a tree decomposition of this graph: at least one bag; its"},{"type":"text","text":" "},{"type":"text","text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the"},{"type":"text","text":" "},{"type":"text","text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a"},{"type":"text","text":" "},{"type":"text","text":"self-loop are together in some bag; and the bags holding any one vertex form a connected"},{"type":"text","text":" "},{"type":"text","text":"subtree."}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()","abstract":[{"text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"memory.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"trussNumbers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TrussNumbers","preciseIdentifier":"s:7Cliques12TrussNumbersV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"trussNumbers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","role":"symbol","title":"maximalCliques()","type":"topic","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"MaximalCliques","type":"codeVoice"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sizes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SX","text":"RangeExpression","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques03AllA0V","text":"AllCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"Every clique whose size is in "},{"code":"sizes","type":"codeVoice"},{"type":"text","text":", maximal or not, once each, lazily, each in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; see "},{"code":"AllCliques","type":"codeVoice"},{"type":"text","text":" for the order. Self-loops and parallel edges are ignored,"},{"type":"text","text":" "},{"type":"text","text":"and the empty set is never listed. "},{"code":"allCliques(sizes: 3 ... 3)","type":"codeVoice"},{"type":"text","text":" lists the triangles,"},{"type":"text","text":" "},{"code":"allCliques(sizes: 1...)","type":"codeVoice"},{"type":"text","text":" every clique."}],"title":"allCliques(sizes:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracy + 1"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"type":"codeVoice","code":"degeneracy"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"type":"topic","kind":"symbol","title":"cliqueNumber()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"title":"perfectEliminationOrdering()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","abstract":[{"type":"text","text":"A perfect elimination ordering, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is not chordal: an order of the"},{"type":"text","text":" "},{"type":"text","text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one"},{"type":"text","text":" "},{"type":"text","text":"another. It is the reverse of "},{"type":"codeVoice","code":"maximumCardinalitySearch()"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perfectEliminationOrdering","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","type":"topic"},"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","kind":"symbol","role":"collection","title":"Cliques","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","role":"symbol","title":"chordalGraphTreewidth()","type":"topic","abstract":[{"type":"text","text":"The treewidth of a chordal graph, one less than its largest clique, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph"},{"type":"text","text":" "},{"type":"text","text":"is not chordal; −1 for the empty graph."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphTreewidth","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(checked:)":{"abstract":[{"type":"text","text":"The size of a largest clique containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", throwing instead of trapping when it is"},{"type":"text","text":" "},{"type":"text","text":"not a vertex of the graph."}],"type":"topic","kind":"symbol","title":"cliqueNumber(checked:)","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(checked:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"abstract":[{"type":"text","text":"The core decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m)."}],"type":"topic","kind":"symbol","title":"coreNumbers()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coreNumbers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques11CoreNumbersV","text":"CoreNumbers","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()"}}}