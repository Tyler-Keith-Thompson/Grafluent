14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"modules":[{"name":"Cliques","relatedModules":["GraphProtocols"]}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"symbolKind":"extension","roleHeading":"Extended Protocol"},"references":{"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"title":"maximumClique()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","type":"topic","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"role":"symbol","abstract":[{"text":"The lexicographically least largest clique by vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the","type":"text"},{"text":" ","type":"text"},{"text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for","type":"text"},{"text":" ","type":"text"},{"text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +","type":"text"},{"text":" ","type":"text"},{"text":"m + degeneracy²) however large a hub’s degree; of two cliques of one size, the lesser is the","type":"text"},{"text":" ","type":"text"},{"text":"one holding the least vertex of their symmetric difference. For each v, a witness clique W","type":"text"},{"text":" ","type":"text"},{"text":"(any one of the right size) guides a pass over the candidates in ascending number: a","type":"text"},{"text":" ","type":"text"},{"text":"candidate in W is taken, any other is taken exactly when a search finds the rest of a clique","type":"text"},{"text":" ","type":"text"},{"text":"among the common neighbors left (which then becomes W). A v whose candidates all exceed the","type":"text"},{"text":" ","type":"text"},{"text":"least vertex of the best clique so far is skipped. Exponential in the worst case.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"abstract":[{"type":"text","text":"The core decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m)."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","title":"coreNumbers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreNumbers"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques11CoreNumbersV","kind":"typeIdentifier","text":"CoreNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","abstract":[{"type":"text","text":"The number of triangles in the simple graph. O(m^(3\/2))."}],"kind":"symbol","title":"triangleCount()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"abstract":[{"type":"text","text":"Every maximal clique once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"MaximalCliques"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","title":"maximalCliques()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","url":"\/documentation\/cliques","role":"collection"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/cliques\/graphprotocols\/graph","type":"topic","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"role":"symbol","abstract":[]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"abstract":[{"text":"The local clustering coefficient of ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone: 2T \/ (d(d − 1)),","type":"text"},{"text":" ","type":"text"},{"text":"0 when it has fewer than two distinct neighbors.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph