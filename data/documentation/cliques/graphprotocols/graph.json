xt":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumWeightClique","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A clique of greatest total weight in the simple graph, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with weights"},{"type":"text","text":" "},{"type":"text","text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []"},{"type":"text","text":" "},{"type":"text","text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with"},{"type":"text","text":" "},{"type":"text","text":"a positive weight is searched with its later positive neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"max_weight_clique"},{"type":"text","text":") for a clique beating the best so far. Exponential in the worst case;"},{"type":"text","text":" "},{"type":"text","text":"memory O(n + m + degeneracy²)."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","title":"maximumWeightClique(weight:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/findHole()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findHole","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Cycle","preciseIdentifier":"s:5Walks5CycleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"abstract":[{"type":"text","text":"A hole, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is chordal: a chordless cycle of four or more vertices, the"},{"type":"text","text":" "},{"type":"text","text":"witness that the graph is not chordal. It starts at its least vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order"},{"type":"text","text":" "},{"type":"text","text":"and leaves it through the lesser of its two edges there; between two vertices it takes"},{"type":"text","text":" "},{"type":"text","text":"the first edge in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order of the earlier one on the cycle."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/findhole()","title":"findHole()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"abstract":[{"type":"text","text":"The mean local clustering coefficient over every vertex, zeros included, summed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; 0 when empty."}],"type":"topic","kind":"symbol","title":"averageClustering()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"title":"Graph","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","title":"maximumClique()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A largest clique of the simple graph, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph."},{"type":"text","text":" "},{"type":"text","text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is"},{"type":"text","text":" "},{"type":"text","text":"depends on the search; for one fixed by a rule, see "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It is the clique "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"’s search finds, so it costs the same: exponential in the"},{"type":"text","text":" "},{"type":"text","text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(checked:)":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(checked:)","title":"cliqueNumber(checked:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is","type":"text"},{"text":" ","type":"text"},{"text":"not a vertex of the graph.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"abstract":[],"type":"topic","kind":"symbol","title":"GraphProtocols","role":"collection","url":"\/documentation\/cliques\/graphprotocols","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols"},"doc://Cliques/documentation/Cliques":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"type":"topic","url":"\/documentation\/cliques","role":"collection","title":"Cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(containing:)":{"abstract":[{"type":"text","text":"The maximal cliques containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", once each, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order: the"},{"type":"text","text":" "},{"type":"text","text":"maximal cliques of the subgraph its neighbors induce, in "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" order there,"},{"type":"text","text":" "},{"type":"text","text":"each with "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" added; "},{"type":"codeVoice","code":"[vertex]"},{"type":"text","text":" alone when it has no neighbor. Self-loops and parallel"},{"type":"text","text":" "},{"type":"text","text":"edges are ignored. O(n + m) before the first clique; memory O(n + m + degeneracy²), however"},{"type":"text","text":" "},{"type":"text","text":"many neighbors the vertex has."}],"type":"topic","kind":"symbol","title":"maximalCliques(containing:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"containing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(containing:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"abstract":[{"text":"Three times the triangles over the connected triples; 0 when there are no triangles.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","title":"transitivity()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(checkedContaining:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(checkedContaining:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","abstract":[{"text":"The maximal cliques containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is not a","type":"text"},{"text":" ","type":"text"},{"text":"vertex of the graph.","type":"text"}],"title":"maximalCliques(checkedContaining:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedContaining","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"VertexNotFound","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(of:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"abstract":[{"type":"text","text":"The size of a largest clique containing "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":" (its node clique number): 1 for a vertex"},{"type":"text","text":" "},{"type":"text","text":"with no neighbor. One more than the clique number of the subgraph its neighbors induce,"},{"type":"text","text":" "},{"type":"text","text":"found as "},{"code":"cliqueNumber()","type":"codeVoice"},{"type":"text","text":" finds it; exponential in the worst case, memory O(n + m +"},{"type":"text","text":" "},{"type":"text","text":"degeneracy²). Self-loops and parallel edges are ignored."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(of:)","title":"cliqueNumber(of:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(of:)","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","kind":"symbol","title":"triangleCount()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"abstract":[{"text":"The number of triangles in the simple graph. O(m^(3\/2)).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphCliques"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]]?"}],"abstract":[{"text":"The maximal cliques of a chordal graph, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: at most n","type":"text"},{"text":" ","type":"text"},{"text":"of them, each a vertex with its neighbors before it in ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"the order of that search, each clique’s vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. An isolated vertex","type":"text"},{"text":" ","type":"text"},{"text":"is a clique of one.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","title":"chordalGraphCliques()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/onionLayers()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","kind":"symbol","title":"onionLayers()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onionLayers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"OnionLayers","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques11OnionLayersV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once). O(n + m)."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perfectEliminationOrdering","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"abstract":[{"text":"A perfect elimination ordering, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: an order of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one","type":"text"},{"text":" ","type":"text"},{"text":"another. It is the reverse of ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","title":"perfectEliminationOrdering()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"abstract":[],"title":"Graph","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","url":"\/documentation\/cliques\/graphprotocols\/graph","kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","kind":"symbol","title":"trussNumbers()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trussNumbers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TrussNumbers","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques12TrussNumbersV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"memory.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphTreewidth"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"abstract":[{"text":"The treewidth of a chordal graph, one less than its largest clique, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when the graph","type":"text"},{"text":" ","type":"text"},{"text":"is not chordal; −1 for the empty graph.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","title":"chordalGraphTreewidth()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinDegree()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinDegree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"abstract":[{"text":"A tree decomposition by the minimum-degree heuristic: repeatedly eliminate a vertex of","type":"text"},{"text":" ","type":"text"},{"text":"least degree in the graph as filled in so far, the vertex earliest in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" among","type":"text"},{"text":" ","type":"text"},{"text":"ties, making its neighbors a clique; stop when the remaining vertices form a clique. Its","type":"text"},{"text":" ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" is an upper bound on the treewidth.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthmindegree()","title":"treewidthMinDegree()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinDegree()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","title":"lexicographicallyFirstMaximumClique()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex","type":"text"},{"text":" ","type":"text"},{"text":"index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Self-loops and parallel edges are","type":"text"},{"text":" ","type":"text"},{"text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their","type":"text"},{"text":" ","type":"text"},{"text":"symmetric difference. After ","type":"text"},{"code":"cliqueNumber()","type":"codeVoice"},{"text":"‘s search, each largest clique is searched for","type":"text"},{"text":" ","type":"text"},{"text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +","type":"text"},{"text":" ","type":"text"},{"text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of","type":"text"},{"text":" ","type":"text"},{"text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is","type":"text"},{"text":" ","type":"text"},{"text":"taken, any other is taken exactly when a search finds the rest of a clique among the common","type":"text"},{"text":" ","type":"text"},{"text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of","type":"text"},{"text":" ","type":"text"},{"text":"the best clique so far is skipped. Up to one search per vertex and candidate, each","type":"text"},{"text":" ","type":"text"},{"text":"exponential in the worst case, so it can be far slower than ","type":"text"},{"code":"maximumClique()","type":"codeVoice"},{"text":"; the search","type":"text"},{"text":" ","type":"text"},{"text":"does not check for task cancellation.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","title":"treewidthMinFillIn()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinFillIn","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex"},{"type":"text","text":" "},{"type":"text","text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the"},{"type":"text","text":" "},{"type":"text","text":"remaining vertices form a clique. Its "},{"code":"width","type":"codeVoice"},{"type":"text","text":" is an upper bound on the treewidth, and is"},{"type":"text","text":" "},{"type":"text","text":"the treewidth of a chordal graph."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"abstract":[{"text":"The number of triangles through ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","title":"triangleCount(of:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","title":"isChordal","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChordal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge"},{"type":"text","text":" "},{"type":"text","text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:"},{"type":"text","text":" "},{"type":"text","text":"self-loops and parallel copies change nothing."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTreeDecomposition"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether "},{"code":"decomposition","type":"codeVoice"},{"type":"text","text":" is a tree decomposition of this graph: at least one bag; its"},{"type":"text","text":" "},{"type":"text","text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the"},{"type":"text","text":" "},{"type":"text","text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a"},{"type":"text","text":" "},{"type":"text","text":"self-loop are together in some bag; and the bags holding any one vertex form a connected"},{"type":"text","text":" "},{"type":"text","text":"subtree."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)","title":"isTreeDecomposition(_:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","kind":"symbol","title":"cliqueNumber()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracy + 1"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"type":"codeVoice","code":"degeneracy"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficients","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"ClusteringCoefficients","preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2))."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","title":"clusteringCoefficients()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sizes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SX","text":"RangeExpression","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques03AllA0V","text":"AllCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"Every clique whose size is in ","type":"text"},{"code":"sizes","type":"codeVoice"},{"text":", maximal or not, once each, lazily, each in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"AllCliques","type":"codeVoice"},{"text":" for the order. Self-loops and parallel edges are ignored,","type":"text"},{"text":" ","type":"text"},{"text":"and the empty set is never listed. ","type":"text"},{"code":"allCliques(sizes: 3 ... 3)","type":"codeVoice"},{"text":" lists the triangles,","type":"text"},{"text":" ","type":"text"},{"code":"allCliques(sizes: 1...)","type":"codeVoice"},{"text":" every clique.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","title":"allCliques(sizes:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","title":"maximalCliques()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"MaximalCliques"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreNumbers"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques11CoreNumbersV","kind":"typeIdentifier","text":"CoreNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The core decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m)."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","title":"coreNumbers()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clusteringCoefficient"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"abstract":[{"type":"text","text":"The local clustering coefficient of "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", from its neighborhood alone: 2T \/ (d(d − 1)),"},{"type":"text","text":" "},{"type":"text","text":"0 when it has fewer than two distinct neighbors."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","title":"clusteringCoefficient(of:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","kind":"symbol","type":"topic"}}}