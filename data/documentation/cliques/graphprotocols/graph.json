text":" when the graph"},{"type":"text","text":" "},{"type":"text","text":"is not chordal; −1 for the empty graph."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphTreewidth","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()","type":"topic","title":"chordalGraphTreewidth()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","kind":"symbol","title":"maximalCliques()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","type":"topic","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"MaximalCliques","type":"codeVoice"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"kind":"symbol","abstract":[{"type":"text","text":"A perfect elimination ordering, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the graph is not chordal: an order of the"},{"type":"text","text":" "},{"type":"text","text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one"},{"type":"text","text":" "},{"type":"text","text":"another. It is the reverse of "},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"perfectEliminationOrdering","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]?","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","type":"topic","title":"perfectEliminationOrdering()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","title":"chordalGraphCliques()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphCliques"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]]?"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","abstract":[{"type":"text","text":"The maximal cliques of a chordal graph, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is not chordal: at most n"},{"type":"text","text":" "},{"type":"text","text":"of them, each a vertex with its neighbors before it in "},{"type":"codeVoice","code":"maximumCardinalitySearch()"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"the order of that search, each clique’s vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. An isolated vertex"},{"type":"text","text":" "},{"type":"text","text":"is a clique of one."}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"kind":"symbol","abstract":[{"type":"text","text":"Every clique whose size is in "},{"type":"codeVoice","code":"sizes"},{"type":"text","text":", maximal or not, once each, lazily, each in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; see "},{"type":"codeVoice","code":"AllCliques"},{"type":"text","text":" for the order. Self-loops and parallel edges are ignored,"},{"type":"text","text":" "},{"type":"text","text":"and the empty set is never listed. "},{"type":"codeVoice","code":"allCliques(sizes: 3 ... 3)"},{"type":"text","text":" lists the triangles,"},{"type":"text","text":" "},{"type":"codeVoice","code":"allCliques(sizes: 1...)"},{"type":"text","text":" every clique."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"allCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sizes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RangeExpression","kind":"typeIdentifier","preciseIdentifier":"s:SX"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">) -> ","kind":"text"},{"text":"AllCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques03AllA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)","type":"topic","title":"allCliques(sizes:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","title":"maximumClique()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"A largest clique of the simple graph, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph.","type":"text"},{"text":" ","type":"text"},{"text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is","type":"text"},{"text":" ","type":"text"},{"text":"depends on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It is the clique ","type":"text"},{"code":"cliqueNumber()","type":"codeVoice"},{"text":"’s search finds, so it costs the same: exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation.","type":"text"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(checkedContaining:)":{"title":"maximalCliques(checkedContaining:)","abstract":[{"text":"The maximal cliques containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is not a","type":"text"},{"text":" ","type":"text"},{"text":"vertex of the graph.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedContaining","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(checkedContaining:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","title":"lexicographicallyFirstMaximumClique()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"type":"topic"},"doc://Cliques/documentation/Cliques":{"role":"collection","type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"kind":"symbol","abstract":[{"text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex","type":"text"},{"text":" ","type":"text"},{"text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the","type":"text"},{"text":" ","type":"text"},{"text":"remaining vertices form a clique. Its ","type":"text"},{"type":"codeVoice","code":"width"},{"text":" is an upper bound on the treewidth, and is","type":"text"},{"text":" ","type":"text"},{"text":"the treewidth of a chordal graph.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"treewidthMinFillIn"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"TreeDecomposition","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","type":"topic","title":"treewidthMinFillIn()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","title":"clusteringCoefficient(of:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficient","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","abstract":[{"text":"The local clustering coefficient of ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone: 2T \/ (d(d − 1)),","type":"text"},{"text":" ","type":"text"},{"text":"0 when it has fewer than two distinct neighbors.","type":"text"}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"kind":"symbol","abstract":[{"text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge","type":"text"},{"text":" ","type":"text"},{"text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:","type":"text"},{"text":" ","type":"text"},{"text":"self-loops and parallel copies change nothing.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isChordal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","type":"topic","title":"isChordal"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(checked:)":{"kind":"symbol","title":"cliqueNumber(checked:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"VertexNotFound","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is","type":"text"},{"text":" ","type":"text"},{"text":"not a vertex of the graph.","type":"text"}],"type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(checked:)"}}}