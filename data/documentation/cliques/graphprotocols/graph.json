umentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"MaximalCliques"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"type":"codeVoice","code":"find_cliques"},{"text":", igraph ","type":"text"},{"type":"codeVoice","code":"maximal_cliques"},{"text":", JGraphT’s Bron–Kerbosch finders).","type":"text"}],"title":"maximalCliques()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","abstract":[],"title":"Graph","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/cliques\/graphprotocols\/graph"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"title":"averageClustering()","url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; 0 when empty.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"role":"symbol","type":"topic","title":"transitivity()","abstract":[{"type":"text","text":"Three times the triangles over the connected triples; 0 when there are no triangles."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()"},"doc://Cliques/documentation/Cliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"title":"Cliques","role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","role":"symbol","title":"maximumClique()","type":"topic","abstract":[{"type":"text","text":"The lexicographically least largest clique by vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the"},{"type":"text","text":" "},{"type":"text","text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree; of two cliques of one size, the lesser is the"},{"type":"text","text":" "},{"type":"text","text":"one holding the least vertex of their symmetric difference. For each v, a witness clique W"},{"type":"text","text":" "},{"type":"text","text":"(any one of the right size) guides a pass over the candidates in ascending number: a"},{"type":"text","text":" "},{"type":"text","text":"candidate in W is taken, any other is taken exactly when a search finds the rest of a clique"},{"type":"text","text":" "},{"type":"text","text":"among the common neighbors left (which then becomes W). A v whose candidates all exceed the"},{"type":"text","text":" "},{"type":"text","text":"least vertex of the best clique so far is skipped. Exponential in the worst case."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directedView","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"t