tation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"languages":["swift"],"platforms":["Linux"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/graphprotocols\/graph"]}],"references":{"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"abstract":[],"url":"\/documentation\/cliques\/graphprotocols\/graph","title":"Graph","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"MaximalCliques"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","title":"maximalCliques()","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","role":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"abstract":[{"text":"The number of triangles through ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", from its neighborhood alone.","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","role":"symbol","type":"topic","title":"triangleCount(of:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumClique"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The lexicographically least largest clique by vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the"},{"type":"text","text":" "},{"type":"text","text":"empty graph. Self-loops and parallel edges are ignored. Each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree; of two cliques of one size, the lesser is the"},{"type":"text","text":" "},{"type":"text","text":"one holding the least vertex of their symmetric difference. For each v, a witness clique W"},{"type":"text","text":" "},{"type":"text","text":"(any one of the right size) guides a pass over the candidates in ascending number: a"},{"type":"text","text":" "},{"type":"text","text":"candidate in W is taken, any other is taken exactly when a search finds the rest of a clique"},{"type":"text","text":" "},{"type":"text","text":"among the common neighbors left (which then becomes W). A v whose candidates all exceed the"},{"type":"text","text":" "},{"type":"text","text":"least vertex of the best clique so far is skipped. Exponential in the worst case."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","title":"maximumClique()","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","type":"topic","title":"Graph","url":"\/documentation\/graphprotocols\/graph"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","role":"symbol","type":"topic","abstract":[{"text":"The core decomposition of the simple graph underlying this one (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m).","type":"text"}],"title":"coreNumbers()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coreNumbers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques11CoreNumbersV","text":"CoreNumbers","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"abstract":[{"type":"text","text":"The mean local clustering coefficient over every vertex, zeros included, summed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; 0 when empty."}],"kind":"symbol","title":"averageClustering()","url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","role":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"role":"collection","url":"\/documentation\/cliques","type":"topic","kind":"symbol","title":"Cliques"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficient","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The local clustering coefficient of "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", from its neighborhood alone: 2T \/ (d(d − 1)),"},{"type":"text","text":" "},{"type":"text","text":"0 when it has fewer than two distinct neighbors."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","kind":"symbol","title":"clusteringCoefficient(of:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","role":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"abstract":[{"type":"text","text":"The number of triangles in the simple graph. O(m^(3\/2))."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","role":"symbol","title":"triangleCount()","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"triangleCount"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","role":"symbol","type":"topic","abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"title":"cliqueNumber()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"doc://Cliques/documentation/Cliques/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","role":"collection","url":"\/documentation\/cliques\/graphprotocols","type":"topic","title":"GraphProtocols","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2))."}],"title":"clusteringCoefficients()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficients","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ClusteringCoefficients","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitivity"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"abstract":[{"type":"text","text":"Three times the triangles over the connected triples; 0 when there are no triangles."}],"kind":"symbol","title":"transitivity()","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","role":"symbol","type":"topic"}}}