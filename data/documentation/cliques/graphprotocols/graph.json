ques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinDegree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinDegree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques17TreeDecompositionV","text":"TreeDecomposition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthmindegree()","abstract":[{"text":"A tree decomposition by the minimum-degree heuristic: repeatedly eliminate a vertex of","type":"text"},{"text":" ","type":"text"},{"text":"least degree in the graph as filled in so far, the vertex earliest in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" among","type":"text"},{"text":" ","type":"text"},{"text":"ties, making its neighbors a clique; stop when the remaining vertices form a clique. Its","type":"text"},{"text":" ","type":"text"},{"code":"width","type":"codeVoice"},{"text":" is an upper bound on the treewidth.","type":"text"}],"title":"treewidthMinDegree()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"abstract":[{"text":"The number of triangles in the simple graph. O(m^(3\/2)).","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","title":"triangleCount()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"averageClustering"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; 0 when empty.","type":"text"}],"title":"averageClustering()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"abstract":[{"type":"text","text":"The number of triangles through "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", from its neighborhood alone."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","title":"triangleCount(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(of:)":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(of:)","abstract":[{"type":"text","text":"The size of a largest clique containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" (its node clique number): 1 for a vertex"},{"type":"text","text":" "},{"type":"text","text":"with no neighbor. One more than the clique number of the subgraph its neighbors induce,"},{"type":"text","text":" "},{"type":"text","text":"found as "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":" finds it; exponential in the worst case, memory O(n + m +"},{"type":"text","text":" "},{"type":"text","text":"degeneracy²). Self-loops and parallel edges are ignored."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"type":"topic","title":"cliqueNumber(of:)","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(of:)","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficients()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficients()","title":"clusteringCoefficients()","abstract":[{"type":"text","text":"Triangles and clustering for every vertex of the simple graph (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), in one compact-forward pass. O(m^(3\/2))."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficients()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficients","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ClusteringCoefficients","preciseIdentifier":"s:7Cliques22ClusteringCoefficientsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/lexicographicallyFirstMaximumClique()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumClique()","kind":"symbol","abstract":[{"type":"text","text":"The lexicographically first largest clique: of all the largest cliques, the least by vertex"},{"type":"text","text":" "},{"type":"text","text":"index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges are"},{"type":"text","text":" "},{"type":"text","text":"ignored. Of two cliques of one size, the lesser is the one holding the least vertex of their"},{"type":"text","text":" "},{"type":"text","text":"symmetric difference. After "},{"type":"codeVoice","code":"cliqueNumber()"},{"type":"text","text":"‘s search, each largest clique is searched for"},{"type":"text","text":" "},{"type":"text","text":"from its first vertex v in degeneracy order, among v’s later neighbors, so memory stays O(n +"},{"type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree. For each v, a witness clique W (any one of"},{"type":"text","text":" "},{"type":"text","text":"the right size) guides a pass over the candidates in ascending number: a candidate in W is"},{"type":"text","text":" "},{"type":"text","text":"taken, any other is taken exactly when a search finds the rest of a clique among the common"},{"type":"text","text":" "},{"type":"text","text":"neighbors left (which then becomes W). A v whose candidates all exceed the least vertex of"},{"type":"text","text":" "},{"type":"text","text":"the best clique so far is skipped. Up to one search per vertex and candidate, each"},{"type":"text","text":" "},{"type":"text","text":"exponential in the worst case, so it can be far slower than "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"; the search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/lexicographicallyfirstmaximumclique()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"lexicographicallyFirstMaximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/trussNumbers()":{"abstract":[{"type":"text","text":"The truss decomposition of the simple graph underlying this one (self-loops in no truss,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges sharing one number), by Wang–Cheng’s peeling. O(m^1.5 log Δ) time, O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/trussNumbers()","kind":"symbol","title":"trussNumbers()","url":"\/documentation\/cliques\/graphprotocols\/graph\/trussnumbers()","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"trussNumbers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"TrussNumbers","preciseIdentifier":"s:7Cliques12TrussNumbersV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Cliques/documentation/Cliques":{"url":"\/documentation\/cliques","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","role":"collection","abstract":[],"kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"MaximalCliques","type":"codeVoice"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","title":"maximalCliques()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/findHole()":{"abstract":[{"text":"A hole, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is chordal: a chordless cycle of four or more vertices, the","type":"text"},{"text":" ","type":"text"},{"text":"witness that the graph is not chordal. It starts at its least vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order","type":"text"},{"text":" ","type":"text"},{"text":"and leaves it through the lesser of its two edges there; between two vertices it takes","type":"text"},{"text":" ","type":"text"},{"text":"the first edge in ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order of the earlier one on the cycle.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/findHole()","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/findhole()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findHole"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Cycle","preciseIdentifier":"s:5Walks5CycleV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">?"}],"title":"findHole()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/onionLayers()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/onionLayers()","title":"onionLayers()","abstract":[{"text":"The onion decomposition of the simple graph underlying this one (self-loops ignored,","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges counted once). O(n + m).","type":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/onionlayers()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onionLayers","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"OnionLayers","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques11OnionLayersV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumWeightClique(weight:)":{"abstract":[{"type":"text","text":"A clique of greatest total weight in the simple graph, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, with weights"},{"type":"text","text":" "},{"type":"text","text":"read once per vertex. Vertices of weight zero or less are never taken, so the result is []"},{"type":"text","text":" "},{"type":"text","text":"when no weight is positive (and for the empty graph). Each vertex v in degeneracy order with"},{"type":"text","text":" "},{"type":"text","text":"a positive weight is searched with its later positive neighbors (at most "},{"type":"codeVoice","code":"degeneracy"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"ordered by descending degree among them, by Tavares et al.‘s branch and bound (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"max_weight_clique"},{"type":"text","text":") for a clique beating the best so far. Exponential in the worst case;"},{"type":"text","text":" "},{"type":"text","text":"memory O(n + m + degeneracy²)."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumWeightClique(weight:)","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumweightclique(weight:)","title":"maximumWeightClique(weight:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumWeightClique"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph","kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph","abstract":[],"title":"Graph"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/treewidthMinFillIn()":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/treewidthminfillin()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treewidthMinFillIn","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"TreeDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"A tree decomposition by the minimum fill-in heuristic: repeatedly eliminate the vertex"},{"type":"text","text":" "},{"type":"text","text":"whose neighbors lack the fewest edges to form a clique, making them one; stop when the"},{"type":"text","text":" "},{"type":"text","text":"remaining vertices form a clique. Its "},{"type":"codeVoice","code":"width"},{"type":"text","text":" is an upper bound on the treewidth, and is"},{"type":"text","text":" "},{"type":"text","text":"the treewidth of a chordal graph."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/treewidthMinFillIn()","title":"treewidthMinFillIn()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber(checked:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber(checked:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber(checked:)","abstract":[{"text":"The size of a largest clique containing ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", throwing instead of trapping when it is","type":"text"},{"text":" ","type":"text"},{"text":"not a vertex of the graph.","type":"text"}],"title":"cliqueNumber(checked:)","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphCliques()":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphCliques()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"chordalGraphCliques","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]]?","kind":"text"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphcliques()","abstract":[{"text":"The maximal cliques of a chordal graph, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when the graph is not chordal: at most n","type":"text"},{"text":" ","type":"text"},{"text":"of them, each a vertex with its neighbors before it in ","type":"text"},{"code":"maximumCardinalitySearch()","type":"codeVoice"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"the order of that search, each clique’s vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. An isolated vertex","type":"text"},{"text":" ","type":"text"},{"text":"is a clique of one.","type":"text"}],"title":"chordalGraphCliques()","type":"topic","role":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/clusteringCoefficient(of:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/clusteringCoefficient(of:)","kind":"symbol","abstract":[{"type":"text","text":"The local clustering coefficient of "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", from its neighborhood alone: 2T \/ (d(d − 1)),"},{"type":"text","text":" "},{"type":"text","text":"0 when it has fewer than two distinct neighbors."}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/clusteringcoefficient(of:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clusteringCoefficient","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"title":"clusteringCoefficient(of:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/coreNumbers()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/coreNumbers()","title":"coreNumbers()","abstract":[{"type":"text","text":"The core decomposition of the simple graph underlying this one (self-loops ignored,"},{"type":"text","text":" "},{"type":"text","text":"parallel edges counted once), by Batagelj–Zaversnik’s bucket algorithm. O(n + m)."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/corenumbers()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"coreNumbers"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques11CoreNumbersV","text":"CoreNumbers"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isTreeDecomposition(_:)":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isTreeDecomposition(_:)","abstract":[{"text":"Whether ","type":"text"},{"code":"decomposition","type":"codeVoice"},{"text":" is a tree decomposition of this graph: at least one bag; its","type":"text"},{"text":" ","type":"text"},{"text":"edges join distinct bags and form a tree on them; every vertex in a bag is a vertex of the","type":"text"},{"text":" ","type":"text"},{"text":"graph, and every vertex of the graph is in a bag; both ends of every edge other than a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop are together in some bag; and the bags holding any one vertex form a connected","type":"text"},{"text":" ","type":"text"},{"text":"subtree.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTreeDecomposition"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TreeDecomposition","preciseIdentifier":"s:7Cliques17TreeDecompositionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","title":"isTreeDecomposition(_:)","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/istreedecomposition(_:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/allCliques(sizes:)":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/allCliques(sizes:)","abstract":[{"text":"Every clique whose size is in ","type":"text"},{"type":"codeVoice","code":"sizes"},{"text":", maximal or not, once each, lazily, each in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; see ","type":"text"},{"type":"codeVoice","code":"AllCliques"},{"text":" for the order. Self-loops and parallel edges are ignored,","type":"text"},{"text":" ","type":"text"},{"text":"and the empty set is never listed. ","type":"text"},{"type":"codeVoice","code":"allCliques(sizes: 3 ... 3)"},{"text":" lists the triangles,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"allCliques(sizes: 1...)"},{"text":" every clique.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"allCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sizes"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RangeExpression","preciseIdentifier":"s:SX"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"AllCliques","preciseIdentifier":"s:7Cliques03AllA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","title":"allCliques(sizes:)","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/allcliques(sizes:)"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/isChordal":{"type":"topic","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/ischordal","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isChordal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether the graph is chordal: every cycle of four or more vertices has a chord (an edge"},{"type":"text","text":" "},{"type":"text","text":"joining two of its vertices that are not consecutive on it). Read on the simple graph:"},{"type":"text","text":" "},{"type":"text","text":"self-loops and parallel copies change nothing."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/isChordal","title":"isChordal"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/transitivity()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/transitivity()","kind":"symbol","abstract":[{"text":"Three times the triangles over the connected triples; 0 when there are no triangles.","type":"text"}],"role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/transitivity()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitivity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"title":"transitivity()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(checkedContaining:)":{"kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(checkedcontaining:)","abstract":[{"type":"text","text":"The maximal cliques containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", throwing instead of trapping when it is not a"},{"type":"text","text":" "},{"type":"text","text":"vertex of the graph."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checkedContaining"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"maximalCliques(checkedContaining:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(checkedContaining:)","type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/perfectEliminationOrdering()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/perfectEliminationOrdering()","title":"perfectEliminationOrdering()","abstract":[{"type":"text","text":"A perfect elimination ordering, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the graph is not chordal: an order of the"},{"type":"text","text":" "},{"type":"text","text":"vertices in which each vertex’s neighbors later in the order are all neighbors of one"},{"type":"text","text":" "},{"type":"text","text":"another. It is the reverse of "},{"type":"codeVoice","code":"maximumCardinalitySearch()"},{"type":"text","text":"."}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/perfecteliminationordering()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"perfectEliminationOrdering"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]?"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols":{"type":"topic","role":"collection","url":"\/documentation\/cliques\/graphprotocols","kind":"symbol","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","role":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximumClique()":{"abstract":[{"type":"text","text":"A largest clique of the simple graph, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph."},{"type":"text","text":" "},{"type":"text","text":"Self-loops and parallel edges are ignored. Deterministic, but which largest clique it is"},{"type":"text","text":" "},{"type":"text","text":"depends on the search; for one fixed by a rule, see "},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It is the clique "},{"code":"cliqueNumber()","type":"codeVoice"},{"type":"text","text":"’s search finds, so it costs the same: exponential in the"},{"type":"text","text":" "},{"type":"text","text":"worst case, memory O(n + m + degeneracy²). The search does not check for task cancellation."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximumClique()","kind":"symbol","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximumclique()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumClique","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"maximumClique()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/chordalGraphTreewidth()":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/chordalGraphTreewidth()","abstract":[{"type":"text","text":"The treewidth of a chordal graph, one less than its largest clique, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the graph"},{"type":"text","text":" "},{"type":"text","text":"is not chordal; −1 for the empty graph."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"chordalGraphTreewidth"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"type":"topic","title":"chordalGraphTreewidth()","kind":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/chordalgraphtreewidth()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","kind":"symbol","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"cliqueNumber()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques(containing:)":{"abstract":[{"type":"text","text":"The maximal cliques containing "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", once each, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order: the"},{"type":"text","text":" "},{"type":"text","text":"maximal cliques of the subgraph its neighbors induce, in "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" order there,"},{"type":"text","text":" "},{"type":"text","text":"each with "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" added; "},{"type":"codeVoice","code":"[vertex]"},{"type":"text","text":" alone when it has no neighbor. Self-loops and parallel"},{"type":"text","text":" "},{"type":"text","text":"edges are ignored. O(n + m) before the first clique; memory O(n + m + degeneracy²), however"},{"type":"text","text":" "},{"type":"text","text":"many neighbors the vertex has."}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques(containing:)","role":"symbol","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques(containing:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalCliques"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier","text":"MaximalCliques"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"maximalCliques(containing:)"}}}