type":"text","text":" "},{"type":"text","text":"m + degeneracy²) however large a hub’s degree; of two cliques of one size, the lesser is the"},{"type":"text","text":" "},{"type":"text","text":"one holding the least vertex of their symmetric difference. For each v, a witness clique W"},{"type":"text","text":" "},{"type":"text","text":"(any one of the right size) guides a pass over the candidates in ascending number: a"},{"type":"text","text":" "},{"type":"text","text":"candidate in W is taken, any other is taken exactly when a search finds the rest of a clique"},{"type":"text","text":" "},{"type":"text","text":"among the common neighbors left (which then becomes W). A v whose candidates all exceed the"},{"type":"text","text":" "},{"type":"text","text":"least vertex of the best clique so far is skipped. Exponential in the worst case."}],"type":"topic"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount(of:)":{"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount(of:)","title":"triangleCount(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount(of:)","type":"topic","kind":"symbol","abstract":[{"text":"The number of triangles through ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", from its neighborhood alone.","type":"text"}]},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/maximalCliques()":{"type":"topic","title":"maximalCliques()","abstract":[{"text":"Every maximal clique once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; see ","type":"text"},{"code":"MaximalCliques","type":"codeVoice"},{"text":" for the","type":"text"},{"text":" ","type":"text"},{"text":"order. Self-loops and parallel edges are ignored, and an isolated vertex is a clique of one","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX ","type":"text"},{"code":"find_cliques","type":"codeVoice"},{"text":", igraph ","type":"text"},{"code":"maximal_cliques","type":"codeVoice"},{"text":", JGraphT’s Bron–Kerbosch finders).","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalCliques","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/maximalCliques()","url":"\/documentation\/cliques\/graphprotocols\/graph\/maximalcliques()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/triangleCount()":{"type":"topic","title":"triangleCount()","abstract":[{"type":"text","text":"The number of triangles in the simple graph. O(m^(3\/2))."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"triangleCount","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/triangleCount()","url":"\/documentation\/cliques\/graphprotocols\/graph\/trianglecount()"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/cliqueNumber()":{"url":"\/documentation\/cliques\/graphprotocols\/graph\/cliquenumber()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"type":"topic","role":"symbol","abstract":[{"text":"The size of a largest clique of the simple graph, ω: 0 for the empty graph, 1 for an","type":"text"},{"text":" ","type":"text"},{"text":"edgeless one, at most ","type":"text"},{"code":"coreNumbers().degeneracy + 1","type":"codeVoice"},{"text":". Branch and bound in degeneracy order,","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s later neighbors (at most ","type":"text"},{"code":"degeneracy","type":"codeVoice"},{"text":", those with a high enough core number)","type":"text"},{"text":" ","type":"text"},{"text":"as the candidates, one search per vertex that raises the best size as it goes, stopping at","type":"text"},{"text":" ","type":"text"},{"text":"the degeneracy bound. Each search is San Segundo et al.’s BBMC on bitsets, candidates in","type":"text"},{"text":" ","type":"text"},{"text":"descending degree, branching from the highest greedy colour down. Exponential in the worst","type":"text"},{"text":" ","type":"text"},{"text":"case; memory O(n + m + degeneracy²).","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/cliqueNumber()","title":"cliqueNumber()","kind":"symbol"},"doc://Cliques/documentation/Cliques/GraphProtocols/Graph/averageClustering()":{"role":"symbol","title":"averageClustering()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/GraphProtocols\/Graph\/averageClustering()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"averageClustering","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/cliques\/graphprotocols\/graph\/averageclustering()","type":"topic","kind":"symbol","abstract":[{"text":"The mean local clustering coefficient over every vertex, zeros included, summed in","type":"text"},{"tex