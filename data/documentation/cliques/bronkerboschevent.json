 candidate from P to X after the call. Every call ends with a backtrack."},{"type":"text","text":" "},{"type":"text","text":"Self-loops and parallel edges are ignored."}]}],"kind":"content"}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"What the Bron–Kerbosch algorithm with pivoting reports, in order, as "},{"type":"codeVoice","code":"maximalCliques()"},{"type":"text","text":" runs"},{"type":"text","text":" "},{"type":"text","text":"it."}],"metadata":{"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BronKerboschEvent","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"BronKerboschEvent","kind":"identifier"}],"externalID":"s:7Cliques17BronKerboschEventO","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cliques\/BronKerboschEvents.swift#L16","fileName":"BronKerboschEvents.swift"},"symbolKind":"enum","modules":[{"name":"Cliques"}],"title":"BronKerboschEvent"},"topicSections":[{"title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent\/backtrack","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent\/call(adding:clique:candidates:excluded:)","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent\/maximalClique(_:)","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent\/pivot(_:)"],"anchor":"Enumeration-Cases"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent\/CustomStringConvertible-Implementations","doc:\/\/Cliques\/documentation\/Cliques\/BronKerboschEvent\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Cliques\/s8CopyableP","doc:\/\/Cliques\/s23CustomStringConvertibleP","doc:\/\/Cliques\/SQ","doc:\/\/Cliques\/s9EscapableP","doc:\/\/Cli