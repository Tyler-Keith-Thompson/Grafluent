imple graph whose size is in a range, once each, lazily,","type":"text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/allcliques","title":"AllCliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques"},"doc://Cliques/documentation/Cliques/AllCliques/enumerated()":{"abstract":[],"url":"\/documentation\/cliques\/allcliques\/enumerated()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enumerated"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EnumeratedSequence","preciseIdentifier":"s:s18EnumeratedSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/enumerated()","kind":"symbol","title":"enumerated()","type":"topic","role":"symbol"}}}