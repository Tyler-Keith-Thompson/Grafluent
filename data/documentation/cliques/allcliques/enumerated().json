ind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enumerated"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EnumeratedSequence","preciseIdentifier":"s:s18EnumeratedSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/cliques\/allcliques\/enumerated()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/enumerated()","title":"enumerated()"},"doc://Cliques/documentation/Cliques/AllCliques":{"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/allcliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"AllCliques","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,","type":"text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","title":"AllCliques"}}}