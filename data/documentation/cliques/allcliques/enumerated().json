:"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AllCliques"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllCliques"}],"kind":"symbol"},"doc://Cliques/documentation/Cliques/AllCliques/enumerated()":{"abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enumerated"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18EnumeratedSequenceV","text":"EnumeratedSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/cliques\/allcliques\/enumerated()","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/enumerated()","title":"enumerated()"},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","abstract":[],"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection","kind":"symbol"}}}