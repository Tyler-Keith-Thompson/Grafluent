text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/allcliques","title":"AllCliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques"},"doc://Cliques/documentation/Cliques/AllCliques/reversed()":{"role":"symbol","title":"reversed()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/reversed()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reversed","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/allcliques\/reversed()"}}}