:ST7ElementQa"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Result"},{"kind":"text","text":"]"}],"type":"topic","url":"\/documentation\/cliques\/allcliques\/reductions(_:_:)","title":"reductions(_:_:)","abstract":[],"role":"symbol"},"doc://Cliques/documentation/Cliques/AllCliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","title":"AllCliques","url":"\/documentation\/cliques\/allcliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"type":"topic"}}}