\/\/Cliques\/documentation\/Cliques\/AllCliques","abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}]},"doc://Cliques/documentation/Cliques/AllCliques/lazy":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/lazy","kind":"symbol","abstract":[],"type":"topic","title":"lazy","url":"\/documentation\/cliques\/allcliques\/lazy","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lazy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"LazySequence","preciseIdentifier":"s:s12LazySequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","abstract":[],"url":"\/documentation\/cliques","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques"}}}