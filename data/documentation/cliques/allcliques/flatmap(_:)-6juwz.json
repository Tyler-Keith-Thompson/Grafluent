ocumentation\/Cliques","type":"topic","url":"\/documentation\/cliques","title":"Cliques","abstract":[]},"doc://Cliques/documentation/Cliques/AllCliques":{"url":"\/documentation\/cliques\/allcliques","type":"topic","kind":"symbol","abstract":[{"text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,","type":"text"},{"text":" ","type":"text"},{"text":"each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","title":"AllCliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"role":"symbol"}}}