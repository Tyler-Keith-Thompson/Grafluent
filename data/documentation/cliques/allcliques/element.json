ntation\/Cliques\/AllCliques","abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","abstract":[],"url":"\/documentation\/cliques","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/AllCliques/Element":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/Element","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Element"}],"abstract":[],"type":"topic","title":"AllCliques.Element","url":"\/documentation\/cliques\/allcliques\/element"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"title":"Vertex","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex