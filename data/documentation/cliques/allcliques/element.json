":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"abstract":[]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","abstract":[],"role":"collection","type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques/AllCliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}],"kind":"symbol","url":"\/documentation\/cliques\/allcliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllCliques"}],"title":"AllCliques","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AllCliques"}