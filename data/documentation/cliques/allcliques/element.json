tle":[{"text":"Element","kind":"identifier"}],"title":"AllCliques.Element"},"doc://Cliques/documentation/Cliques/AllCliques":{"abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/cliques\/allcliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"title":"AllCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Cliques/documentation/Cliques":{"type":"topic","url":"\/documentation\/cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection","kind":"symbol","abstract":[],"title":"Cliques