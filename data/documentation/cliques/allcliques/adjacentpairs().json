{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Sequence.adjacentPairs()"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/AllCliques"]]},"sections":[],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:ST10AlgorithmsE13adjacentPairsAA08AdjacentC8SequenceVyxGyF::SYNTHESIZED::s:7Cliques03AllA0V","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","text":"AdjacentPairsSequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"adjacentPairs()","extendedModule":"Swift","modules":[{"relatedModules":["Swift"],"name":"Cliques"}]},"variants":[{"paths":["\/documentation\/cliques\/allcliques\/adjacentpairs()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/adjacentPairs()","interfaceLanguage":"swift"},"references":{"doc://Cliques/documentation/Cliques/AllCliques/adjacentPairs()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjacentPairs"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AdjacentPairsSequence","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"adjacentPairs()","url":"\/documentation\/cliques\/allcliques\/adjacentpairs()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/adjacentPairs()","type":"topic","abstract":[],"role":"symbol","kind":"symbol"},"doc://Cliques/documentation/Cliques":{"type":"topic","url":"\/documentation\/cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection","kind":"symbol","abstract":[],"title":"Cliques"},"doc://Cliques/documentation/Cliques/AllCliques":{"abstract":[{"type":"text","text":"Every clique of an undirected graph’s simple graph whose size is in a range, once each, lazily,"},{"type":"text","text":" "},{"type":"text","text":"each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (by vertex index). The order is by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then depth first, each clique followed by its extensions by"},{"type":"text","text":" "},{"type":"text","text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the"},{"type":"text","text":" "},{"type":"text","text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/cliques\/allcliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"title":"AllCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}]}}}