":"vertices"},{"text":" order (by vertex index). The order is by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"text":", then depth first, each clique followed by its extensions by","type":"text"},{"text":" ","type":"text"},{"text":"later vertices in ascending index. The sequence holds the graph, so iterating again gives the","type":"text"},{"text":" ","type":"text"},{"text":"same cliques. O(n + m) before the first clique, O(d) bitset words per clique for degeneracy d.","type":"text"}],"title":"AllCliques","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","url":"\/documentation\/cliques\/allcliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/AllCliques/adjacentPairs()":{"abstract":[],"type":"topic","kind":"symbol","title":"adjacentPairs()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":">"}],"url":"\/documentation\/cliques\/allcliques\/adjacentpairs()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques\/adjacentPairs()"},"doc://Cliques/documentation/Cliques":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"type":"topic","url":"\/documentation\/cliques","role":"collection","title":"Cliques"}}}