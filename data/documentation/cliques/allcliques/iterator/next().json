 + m) before the first clique, O(d) bitset words per clique for degeneracy d."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/AllCliques","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/cliques\/allcliques","navigatorTitle":[{"text":"AllCliques","kind":"identifier"}],"title":"AllCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllCliques","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"}}}