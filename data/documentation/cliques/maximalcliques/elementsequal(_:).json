seIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"modules":[{"name":"Cliques","relatedModules":["Swift"]}],"conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"elementsEqual(_:)"},"sections":[],"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Sequence.elementsEqual(_:)"},{"type":"text","text":"."}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"references":{"doc://Cliques/documentation/Cliques":{"type":"topic","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"role":"collection","kind":"symbol","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/elementsEqual(_:)":{"type":"topic","title":"elementsEqual(_:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/elementsEqual(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elementsEqual","kind":"identifier"},{"text":"<","kind":"text"},{"text":"OtherSequence","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"OtherSequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":".","type":"text"}]},"abstract":[],"role":"symbol","kind":"symbol","url":"\/documentation\/cliques\/maximalcliques\/elementsequal(_:)"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"url":"\/documentation\/cliques\/maximalcliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"title":"MaximalCliques"}}}