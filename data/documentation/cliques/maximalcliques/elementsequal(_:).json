ence"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"OtherSequence"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"OtherSequence"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"kind":"symbol","references":{"doc://Cliques/documentation/Cliques/MaximalCliques/elementsEqual(_:)":{"title":"elementsEqual(_:)","url":"\/documentation\/cliques\/maximalcliques\/elementsequal(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"elementsEqual"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"OtherSequence"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"OtherSequence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[],"conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/elementsEqual(_:)","role":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"type":"topic","title":"MaximalCliques","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"url":"\/documentation\/cliques\/maximalcliques"},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection"}}}