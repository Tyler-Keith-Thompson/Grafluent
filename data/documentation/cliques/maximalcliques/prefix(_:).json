{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/prefix(_:)"},"kind":"symbol","metadata":{"symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Cliques","relatedModules":["Swift"]}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prefix","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"PrefixSequence","kind":"typeIdentifier","preciseIdentifier":"s:s14PrefixSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"prefix(_:)","externalID":"s:STsE6prefixys14PrefixSequenceVyxGSiF::SYNTHESIZED::s:7Cliques07MaximalA0V","extendedModule":"Swift"},"abstract":[{"text":"Inherited from ","type":"text"},{"code":"Sequence.prefix(_:)","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prefix","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"maxLength","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"PrefixSequence","preciseIdentifier":"s:s14PrefixSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/maximalcliques\/prefix(_:)"]}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/prefix(_:)":{"url":"\/documentation\/cliques\/maximalcliques\/prefix(_:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/prefix(_:)","type":"topic","abstract":[],"title":"prefix(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prefix","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"PrefixSequence","kind":"typeIdentifier","preciseIdentifier":"s:s14PrefixSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Cliques/documentation/Cliques":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"kind":"symbol","role":"collection","title":"Cliques","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","title":"MaximalCliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}]}}}