ves the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques/compacted()":{"type":"topic","title":"compacted()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"compacted"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Unwrapped"},{"kind":"text","text":">() -> "},{"kind":"typeIdentifier","text":"CompactedSequence","preciseIdentifier":"s:10Algorithms17CompactedSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Unwrapped"},{"kind":"text","text":">"}],"url":"\/documentation\/cliques\/maximalcliques\/compacted()","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/compacted()"}}}