nstance Method","symbolKind":"method"},"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/interspersed(with:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/maximalcliques\/interspersed(with:)"]}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/interspersed(with:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interspersed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") -> ","kind":"text"},{"text":"InterspersedSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms20InterspersedSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/interspersed(with:)","title":"interspersed(with:)","role":"symbol","url":"\/documentation\/cliques\/maximalcliques\/interspersed(with:)","abstract":[],"type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","role":"collection","title":"Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"url":"\/documentation\/cliques\/maximalcliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"role":"symbol","type":"topic","title":"MaximalCliques","abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}]}}}