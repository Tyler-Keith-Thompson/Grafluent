{"sections":[],"kind":"symbol","metadata":{"title":"lazy","roleHeading":"Instance Property","externalID":"s:STsE4lazys12LazySequenceVyxGvp::SYNTHESIZED::s:7Cliques07MaximalA0V","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lazy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"LazySequence","preciseIdentifier":"s:s12LazySequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"name":"Cliques","relatedModules":["Swift"]}],"extendedModule":"Swift","role":"symbol"},"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/lazy","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lazy","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s12LazySequenceV","kind":"typeIdentifier","text":"LazySequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"variants":[{"paths":["\/documentation\/cliques\/maximalcliques\/lazy"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Inherited from ","type":"text"},{"type":"codeVoice","code":"Sequence.lazy"},{"text":".","type":"text"}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/lazy":{"title":"lazy","role":"symbol","url":"\/documentation\/cliques\/maximalcliques\/lazy","abstract":[],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lazy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12LazySequenceV","text":"LazySequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/lazy","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","role":"symbol","url":"\/documentation\/cliques\/maximalcliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","kind":"symbol","role":"collection","title":"Cliques","url":"\/documentation\/cliques"}}}