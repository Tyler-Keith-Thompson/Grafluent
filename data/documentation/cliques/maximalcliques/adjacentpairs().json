{"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/adjacentPairs()"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/cliques\/maximalcliques\/adjacentpairs()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:ST10AlgorithmsE13adjacentPairsAA08AdjacentC8SequenceVyxGyF::SYNTHESIZED::s:7Cliques07MaximalA0V","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","text":"AdjacentPairsSequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","symbolKind":"method","modules":[{"relatedModules":["Swift"],"name":"Cliques"}],"extendedModule":"Swift","title":"adjacentPairs()"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","abstract":[{"type":"text","text":"Inherited from "},{"code":"Sequence.adjacentPairs()","type":"codeVoice"},{"type":"text","text":"."}],"sections":[],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/adjacentPairs()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/adjacentPairs()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":">"}],"type":"topic","title":"adjacentPairs()","url":"\/documentation\/cliques\/maximalcliques\/adjacentpairs()","abstract":[],"kind":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"url":"\/documentation\/cliques\/maximalcliques","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","role":"symbol"},"doc://Cliques/documentation/Cliques":{"abstract":[],"role":"collection","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/clique