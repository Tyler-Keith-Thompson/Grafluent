{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Sequence.adjacentPairs()"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/adjacentPairs()","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"externalID":"s:ST10AlgorithmsE13adjacentPairsAA08AdjacentC8SequenceVyxGyF::SYNTHESIZED::s:7Cliques07MaximalA0V","symbolKind":"method","roleHeading":"Instance Method","role":"symbol","title":"adjacentPairs()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/external\/rules_swift_package_manager++swift_deps+swiftpkg_swift_algorithms\/Sources\/Algorithms\/AdjacentPairs.swift#L34","fileName":"AdjacentPairs.swift"},"modules":[{"name":"Cliques","relatedModules":["Swift"]}],"extendedModule":"Swift"},"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjacentPairs"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","text":"AdjacentPairsSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/maximalcliques\/adjacentpairs()"]}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/adjacentPairs()":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/adjacentPairs()","kind":"symbol","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjacentPairs"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AdjacentPairsSequence","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"text":">","kind":"text"}],"title":"adjacentPairs()","url":"\/documentation\/cliques\/maximalcliques\/adjacentpairs()"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","title":"MaximalCliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques":{"type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","abstract":[],"kind":"symbol","role":"collection","title":"Cliques","url":"\/documentation\/cliques"}}}