pe":"text","text":"degeneracy d."}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","type":"topic","role":"symbol","title":"MaximalCliques"}}}