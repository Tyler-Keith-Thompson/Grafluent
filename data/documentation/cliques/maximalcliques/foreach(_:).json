ques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"type":"topic"},"doc://Cliques/documentation/Cliques":{"kind":"symbol","title":"Cliques","role":"collection","url":"\/documentation\/cliques","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic"}}}