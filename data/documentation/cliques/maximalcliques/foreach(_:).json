"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","title":"MaximalCliques","url":"\/documentation\/cliques\/maximalcliques"},"doc://Cliques/documentation/Cliques":{"role":"collection","type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","url":"\/documentation\/cliques"}}}