t"},{"text":"rethrows","kind":"keyword"}],"title":"forEach(_:)"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Cliques/documentation/Cliques/MaximalCliques":{"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","role":"symbol","url":"\/documentation\/cliques\/maximalcliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","kind":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","kind":"symbol","role":"collection","title":"Cliques","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/forEach(_:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/forEach(_:)","type":"topic","url":"\/documentation\/cliques\/maximalcliques