:"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques":{"role":"collection","abstract":[],"title":"Cliques","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques/reductions(_:_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reductions","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":", (","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Result","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","abstract":[],"title":"reductions(_:_:)","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/reductions(_:_:)","url":"\/documentation\/cliques\/maximalcliques\/reductions(_:_:)","type":"topic"}}}