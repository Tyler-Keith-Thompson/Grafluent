ntation\/cliques\/maximalcliques\/starts(with:by:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"starts","kind":"identifier"},{"text":"<","kind":"text"},{"text":"PossiblePrefix","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PossiblePrefix","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":", ","kind":"text"},{"text":"PossiblePrefix","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"role":"symbol","title":"starts(with:by:)"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"url":"\/documentation\/cliques\/maximalcliques","abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"role":"symbol","title":"MaximalCliques"}}}