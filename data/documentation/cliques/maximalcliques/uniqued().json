{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/cliques\/maximalcliques\/uniqued()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/uniqued()","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Sequence.uniqued()"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"uniqued","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UniquedSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms15UniquedSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]}],"metadata":{"role":"symbol","title":"uniqued()","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"uniqued"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UniquedSequence","preciseIdentifier":"s:10Algorithms15UniquedSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":">"}],"roleHeading":"Instance Method","externalID":"s:ST10AlgorithmsSH7ElementRpzrlE7uniquedAA15UniquedSequenceVyxACGyF::SYNTHESIZED::s:7Cliques07MaximalA0V","extendedModule":"Swift","modules":[{"relatedModules":["Swift"],"name":"Cliques"}],"remoteSource":{"fileName":"Unique.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/external\/rules_swift_package_manager++swift_deps+swiftpkg_swift_algorithms\/Sources\/Algorithms\/Unique.swift#L87"},"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]}},"kind":"symbol","references":{"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/cliques","title":"Cliques","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maxim