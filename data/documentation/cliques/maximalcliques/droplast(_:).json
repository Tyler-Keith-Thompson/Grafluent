type":"topic","role":"symbol","title":"dropLast(_:)"},"doc://Cliques/documentation/Cliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","abstract":[],"role":"collection","kind":"symbol","title":"Cliques","type":"topic"}}}