 the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/flatMap(_:)-62mbo":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/flatMap(_:)-62mbo","abstract":[],"kind":"symbol","title":"flatMap(_:)","url":"\/documentation\/cliques\/maximalcliques\/flatmap(_:)-62mbo","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"flatMap"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"ElementOfResult"},{"kind":"text","text":">(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"ElementOfResult"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"ElementOfResult"},{"kind":"text","text":"]"}],"type":"topic","role":"symbol","deprecated":true}}}