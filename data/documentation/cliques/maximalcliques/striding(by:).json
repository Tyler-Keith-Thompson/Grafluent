xt":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}]},"doc://Cliques/documentation/Cliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","type":"topic","abstract":[],"title":"Cliques","kind":"symbol","role":"collection"}}}