 in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"kind":"symbol","title":"MaximalCliques","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques/minAndMax(by:)":{"url":"\/documentation\/cliques\/maximalcliques\/minandmax(by:)","title":"minAndMax(by:)","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/minAndMax(by:)","role":"symbol","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minAndMax","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{