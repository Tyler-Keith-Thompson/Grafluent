ailable","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">((","kind":"text"},{"text":"UnsafeBufferPointer","preciseIdentifier":"s:SR","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Instance Method","role":"symbol","title":"withContiguousStorageIfAvailable(_:)","symbolKind":"method"},"references":{"doc://Cliques/documentation/Cliques":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","url":"\/documentation\/cliques","abstract":[],"role":"collection","title":"Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/withContiguousStorageIfAvailable(_:)":{"abstract":[],"title":"withContiguousStorageIfAvailable(_:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"withContiguousStorageIfAvailable"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":">(("},{"preciseIdentifier":"s:SR","kind":"typeIdentifier","text":"UnsafeBufferPointer"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"url":"\/documentation\/cliques\/maximalcliques\/withcontiguousstorageifavailable(_:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/withContiguousStorageIfAvailable(_:)"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","title":"MaximalCliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}]}}}