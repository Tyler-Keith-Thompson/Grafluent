liques07MaximalA0V","modules":[{"relatedModules":["Swift"],"name":"Cliques"}],"role":"symbol"},"kind":"symbol","abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Sequence.contains(where:)"},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/contains(where:)","interfaceLanguage":"swift"},"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/contains(where:)":{"abstract":[],"title":"contains(where:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/contains(where:)","type":"topic","kind":"symbol","url":"\/documentation\/cliques\/maximalcliques\/contains(where:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"text":"where","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"type":"topic","title":"MaximalCliques","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"url":"\/documentation\/cliques\/maximalcliques"}}}