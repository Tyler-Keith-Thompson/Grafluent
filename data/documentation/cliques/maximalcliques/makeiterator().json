ype":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}]},"doc://Cliques/documentation/Cliques/MaximalCliques/makeIterator()":{"role":"symbol","abstract":[],"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques\/makeiterator()","title":"makeIterator()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Cliques07MaximalA0V","text":"MaximalCliques","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:7Cliques07MaximalA0V8IteratorV","text":"Iterator","kind":"typeIdentifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/makeIterator()"}}}