aximalA0V8IteratorV","text":"Iterator"}],"roleHeading":"Instance Method","symbolKind":"method"},"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/makeIterator()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Iterator","preciseIdentifier":"s:7Cliques07MaximalA0V8IteratorV","kind":"typeIdentifier"}],"title":"makeIterator()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/makeIterator()","url":"\/documentation\/cliques\/maximalcliques\/makeiterator()","type":"topic","kind":"symbol","abstract":[],"role":"symbol"},"doc://Cliques/documentation/Cliques":{"title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","abstract":[],"url":"\/documentation\/cliques","kind":"symbol","role":"collection"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"title":"MaximalCliques","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/MaximalCliques/Iterator":{"title":"MaximalCliques.Iterator","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/Iterator","type":"topic","abstract":[],"url":"\/documentation\/cliques\/maximalcliques\/iterator","kind":"symbol","navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}]}}}