rited from "},{"type":"codeVoice","code":"Sequence.makeIterator()"},{"type":"text","text":"."}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/makeIterator()":{"type":"topic","title":"makeIterator()","abstract":[],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"MaximalCliques","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Iterator","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V8IteratorV"}],"url":"\/documentation\/cliques\/maximalcliques\/makeiterator()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/makeIterator()"},"doc://Cliques/documentation/Cliques":{"url":"\/documentation\/cliques","type":"topic","abstract":[],"kind":"symbol","role":"collection","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/Iterator":{"url":"\/documentation\/cliques\/maximalcliques\/iterator","type":"topic","navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"title":"MaximalCliques.Iterator","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/Iterator"}}}