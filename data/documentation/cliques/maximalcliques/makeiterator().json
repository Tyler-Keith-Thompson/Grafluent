dentifier":"s:7Cliques07MaximalA0V8IteratorV"}],"platforms":["Linux"]}],"kind":"declarations"}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/makeIterator()":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/makeIterator()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeIterator"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"MaximalCliques","preciseIdentifier":"s:7Cliques07MaximalA0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"text":">.","kind":"text"},{"text":"Iterator","kind":"typeIdentifier","preciseIdentifier":"s:7Cliques07MaximalA0V8IteratorV"}],"type":"topic","title":"makeIterator()","role":"symbol","abstract":[],"url":"\/documentation\/cliques\/maximalcliques\/makeiterator()"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"type":"topic","title":"MaximalCliques","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"url":"\/documentation\/cliques\/maximalcliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/Iterator":{"title":"MaximalCliques.Iterator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/maximalcliques\/iterator","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/Iterator","role":"symbol"},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","role":"collection"}}}