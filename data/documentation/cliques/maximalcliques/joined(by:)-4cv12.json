xt":"Inherited from ","type":"text"},{"code":"Sequence.joined(by:)","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques":{"url":"\/documentation\/cliques","type":"topic","abstract":[],"kind":"symbol","role":"collection","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/joined(by:)-4cv12":{"type":"topic","kind":"symbol","url":"\/documentation\/cliques\/maximalcliques\/joined(by:)-4cv12","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"iden