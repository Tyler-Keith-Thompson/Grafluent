ng","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","abstract":[],"url":"\/documentation\/cliques","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques"}}}