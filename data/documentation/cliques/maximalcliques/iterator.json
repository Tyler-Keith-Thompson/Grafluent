ct":[]},"doc://Cliques/documentation/Cliques/MaximalCliques/Iterator/next()":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/Iterator\/next()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"next","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"type":"topic","url":"\/documentation\/cliques\/maximalcliques\/iterator\/next()","abstract":[],"kind":"symbol","title":"next()","role":"symbol"},"doc://Cliques/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Cliques\/s8SendableP","title":"Swift.Sendable"},"doc://Cliques/St":{"type":"unresolvable","identifier":"doc:\/\/Cliques\/St","title":"Swift.IteratorProtocol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentatio