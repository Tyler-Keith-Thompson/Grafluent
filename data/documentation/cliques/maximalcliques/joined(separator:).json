or"},{"kind":"text","text":">("},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Separator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"JoinedSequence","preciseIdentifier":"s:s14JoinedSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":"."}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"symbolKind":"method","extendedModule":"Swift","modules":[{"relatedModules":["Swift"],"name":"Cliques"}],"title":"joined(separator:)","externalID":"s:STsST7ElementRpzrlE6joined9separators14JoinedSequenceVyxGqd___tSTRd__AA_AAQZAARtd__lF::SYNTHESIZED::s:7Cliques07MaximalA0V","role":"symbol"},"kind":"symbol","abstract":[{"type":"text","text":"Inherited from "},{"code":"Sequence.joined(separator:)","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://Cliques/documentation/Cliques":{"role":"collection","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","title":"Cliques","kind":"symbol","abstract":[],"type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques/joined(separator:)":{"abstract":[],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"joined"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Separator"},{"kind":"text","text":">("},{"kind":"externalParam","text":"separator"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Separator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"JoinedSequence","preciseIdentifier":"s:s14JoinedSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques\/joined(separator:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"joined(separator:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/joined(separator:)"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"type":"topic"}}}