ice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques":{"url":"\/documentation\/cliques","type":"topic","abstract":[],"kind":"symbol","role":"collection","title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques/partitioned(by:)":{"type":"topic","abstract":[],"kind":"symbol","url":"\/documentation\/cliques\/maximalcliques\/partitioned(by:)","title":"partitioned(by:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"partitioned"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> (falseElements"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"tex