ext":"G"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":"] "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SG","kind":"typeIdentifier","text":"RandomNumberGenerator"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/randomSample(count:using:)"},"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"variants":[{"paths":["\/documentation\/cliques\/maximalcliques\/randomsample(count:using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Cliques/documentation/Cliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","abstract":[],"role":"collection","kind":"symbol","title":"Cliques","type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques/randomSample(count:using:)":{"abstract":[],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"randomSample"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"externalParam","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":"]"}],"url":"\/documentation\/cliques\/maximalcliques\/randomsample(count:using:)","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/randomSample(count:using:)","title":"randomSample(count:using:)"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","kind":"symbol","title":"MaximalCliques","type":"topic"}}}