umentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"role":"symbol","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://Cliques/documentation/Cliques/MaximalCliques/Element":{"url":"\/documentation\/cliques\/maximalcliques\/element","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/Element","abstract":[],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"Element","kind":"identifier"}],"title":"MaximalCliques.Element"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"url":"\/documentation\/cliques\/maximalcliques","kind":"symbol","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","title":"MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"type":"topic"}}}