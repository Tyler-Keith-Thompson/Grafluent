"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","title":"MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}]},"doc://Cliques/documentation/Cliques":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","url":"\/documentation\/cliques","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","title":"Vertex"},"doc://Cliques/documentation/Cliques/MaximalCliques/Element":{"abstract":[],"navigatorTitle":[{"text":"Element","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliqu