{"metadata":{"title":"MaximalCliques.Element","role":"symbol","symbolKind":"typealias","externalID":"s:7Cliques07MaximalA0V7Elementa","roleHeading":"Type Alias","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"Element","kind":"identifier"}],"navigatorTitle":[{"text":"Element","kind":"identifier"}],"modules":[{"name":"Cliques"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Cliques\/MaximalCliques.swift#L260","fileName":"MaximalCliques.swift"}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/maximalcliques\/element"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"},{"kind":"text","text":" = ["},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"platforms":["Linux"]}],"kind":"declarations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/Element"},"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"abstract":[{"text":"Inherited from ","type":"text"},{"type":"codeVoice","code":"Sequence.Element"},{"text":".","type":"text"}],"sections":[],"kind":"symbol","references":{"doc://Cliques/documentation/Cliques/MaximalCliques":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","kind":"symbol","role":"symbol","title":"MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"abstract":[]},"doc://Cliques/documentation/Cliques":{"title":"Cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","abstract":[],"role":"collection","type":"topic","kind":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques/Element":{"navigatorTitle":[{"kind":"identifier","text":"Element"}],"kind":"symbol","type":"topic","title":"MaximalCliques.Element","url":"\/documentation\/cliques\/maximalcliques\/element","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/Element","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"abstract":[]}}}