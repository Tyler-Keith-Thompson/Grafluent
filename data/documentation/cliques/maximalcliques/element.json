nd":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","type":"topic"}}}