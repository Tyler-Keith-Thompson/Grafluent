":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}]},"doc://Cliques/documentation/Cliques/MaximalCliques/grouped(by:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/grouped(by:)","title":"grouped(by:)","url":"\/documentation\/cliques\/maximalcliques\/grouped(by:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grouped","kind":"identifier"},{"text":"<","kind":"text"},{"text":"GroupKey","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"GroupKey","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"GroupKey","kind":"typeIdentifier"},{"text":" : [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"kind":"symbol","type":"topic","abstract":[],"role":"symbol"},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","kind":"symbol","abstract":[],"role":"collection"}}}