code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"coreNumbers().degeneracyOrdering","type":"codeVoice"},{"text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least","type":"text"},{"text":" ","type":"text"},{"text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating","type":"text"},{"text":" ","type":"text"},{"text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for","type":"text"},{"text":" ","type":"text"},{"text":"degeneracy d.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/cliques\/maximalcliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"title":"MaximalCliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/MaximalCliques/reversed()":{"abstract":[],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/cliques\/maximalcliques\/reversed()","title":"reversed()","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/reversed()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reversed","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"kind":"text","text":"]"}]}}}