{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/reversed()"},"abstract":[{"type":"text","text":"Inherited from "},{"code":"Sequence.reversed()","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/cliques\/maximalcliques\/reversed()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reversed","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":"]","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/Cliques\/documentation\/Cliques","doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"]]},"metadata":{"externalID":"s:STsE8reversedSay7ElementQzGyF::SYNTHESIZED::s:7Cliques07MaximalA0V","roleHeading":"Instance Method","modules":[{"name":"Cliques","relatedModules":["Swift"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reversed","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":"]","kind":"text"}],"symbolKind":"method","extendedModule":"Swift","title":"reversed()","role":"symbol"},"references":{"doc://Cliques/documentation/Cliques":{"role":"collection","type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques","title":"Cliques","kind":"symbol","url":"\/documentation\/cliques"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques","title":"MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}]},"doc://Cliques/documentation/Cliques/MaximalCliques/reversed()":{"role":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/reversed()","kind":"symbol","title":"reversed()","url":"\/documentation\/cliques\/maximalcliques\/reversed()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reversed"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"text":"]","kind":"text"}]}}}