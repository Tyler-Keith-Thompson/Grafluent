"uniqued"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Subject"},{"kind":"text","text":">("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Subject"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":"]"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/external\/rules_swift_package_manager++swift_deps+swiftpkg_swift_algorithms\/Sources\/Algorithms\/Unique.swift#L115","fileName":"Unique.swift"},"roleHeading":"Instance Method","title":"uniqued(on:)","role":"symbol"},"sections":[],"identifier":{"url":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/uniqued(on:)","interfaceLanguage":"swift"},"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/uniqued(on:)":{"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/uniqued(on:)","url":"\/documentation\/cliques\/maximalcliques\/uniqued(on:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"uniqued","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Subject","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Subject","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":"]","kind":"text"}],"abstract":[],"role":"symbol","title":"uniqued(on:)","type":"topic"},"doc://Cliques/documentation/Cliques":{"role":"collection","abstract":[],"title":"Cliques","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques","url":"\/documentation\/cliques","type":"topic"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"title":"MaximalCliques","url":"\/documentation\/cliques\/maximalcliques","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"}}}