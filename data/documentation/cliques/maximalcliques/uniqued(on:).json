xt":"on","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Subject","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"Cliques","relatedModules":["Swift"]}],"extendedModule":"Swift","externalID":"s:ST10AlgorithmsE7uniqued2onSay7ElementQzGqd__AEKXE_tKSHRd__lF::SYNTHESIZED::s:7Cliques07MaximalA0V"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cliques\/maximalcliques\/uniqued(on:)"]}],"references":{"doc://Cliques/documentation/Cliques/MaximalCliques/uniqued(on:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"uniqued"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Subject"},{"kind":"text","text":">("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Subject"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":"]"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/uniqued(on:)","url":"\/documentation\/cliques\/maximalcliques\/uniqued(on:)","abstract":[],"title":"uniqued(on:)","role":"symbol","type":"topic"},"doc://Cliques/documentation/Cliques":{"title":"Cliques","url":"\/documentation\/cliques","identifier":"doc:\/\/Cliques\/documentation\/Cliques","type":"topic","role":"collection","abstract":[],"kind":"symbol"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"abstract":[{"text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of","type":"text"},{"text":" ","type":"text"},{"text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaximalCliques"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MaximalCliques"}],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"}}}