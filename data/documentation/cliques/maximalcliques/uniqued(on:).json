text":"Subject","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Subject","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":"]","kind":"text"}],"modules":[{"relatedModules":["Swift"],"name":"Cliques"}],"externalID":"s:ST10AlgorithmsE7uniqued2onSay7ElementQzGqd__AEKXE_tKSHRd__lF::SYNTHESIZED::s:7Cliques07MaximalA0V","extendedModule":"Swift","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/external\/rules_swift_package_manager++swift_deps+swiftpkg_swift_algorithms\/Sources\/Algorithms\/Unique.swift#L115","fileName":"Unique.swift"}},"kind":"symbol","references":{"doc://Cliques/documentation/Cliques/MaximalCliques/uniqued(on:)":{"url":"\/documentation\/cliques\/maximalcliques\/uniqued(on:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"uniqued","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Subject","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Subject","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[],"identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques\/uniqued(on:)","role":"symbol","kind":"symbol","title":"uniqued(on:)"},"doc://Cliques/documentation/Cliques/MaximalCliques":{"type":"topic","abstract":[{"type":"text","text":"Every maximal clique of an undirected graph’s simple graph once, lazily, each in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (by vertex index): an isolated vertex, or one whose only edges are loops, is a clique of"},{"type":"text","text":" "},{"type":"text","text":"one. The order is Eppstein–Löffler–Strash’s: by the cliques’ first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"coreNumbers().degeneracyOrdering"},{"type":"text","text":", then as Bron–Kerbosch with Tomita’s pivot (ties to the least"},{"type":"text","text":" "},{"type":"text","text":"index) and branches in ascending index meets them. The sequence holds the graph, so iterating"},{"type":"text","text":" "},{"type":"text","text":"again gives the same cliques. O(n + m) before the first clique, O(d·n·3^(d\/3)) in all for"},{"type":"text","text":" "},{"type":"text","text":"degeneracy d."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaximalCliques","kind":"identifier"}],"url":"\/documentation\/cliques\/maximalcliques","title":"MaximalCliques","navigatorTitle":[{"text":"MaximalCliques","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques\/MaximalCliques"},"doc://Cliques/documentation/Cliques":{"type":"topic","abstract":[],"role":"collection","url":"\/documentation\/cliques","title":"Cliques","kind":"symbol","identifier":"doc:\/\/Cliques\/documentation\/Cliques"}}}