able-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"kind":"symbol","abstract":[{"type":"text","text":"A partition of the elements "},{"type":"codeVoice","code":"0..<count"},{"type":"text","text":" into disjoint sets, with union by size and path"},{"type":"text","text":" "},{"type":"text","text":"halving: O(α(n)) amortized per operation. The interface is that of Boost’s "},{"type":"codeVoice","code":"disjoint_sets"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"petgraph’s "},{"type":"codeVoice","code":"UnionFind"},{"type":"text","text":" and scipy’s "},{"type":"codeVoice","code":"DisjointSet"},{"type":"text","text":"; the linking rule is scipy’s (Boost and"},{"type":"text","text":" "},{"type":"text","text":"petgraph link by rank)."}],"relationshipsSections":[{"identifiers":["doc:\/\/DisjointSetModule\/s8CopyableP","doc:\/\/DisjointSetModule\/s28CustomDebugStringConvertibleP","doc:\/\/DisjointSetModule\/s23CustomStringConvertibleP","doc:\/\/DisjointSetModule\/SQ","doc:\/\/DisjointSetModule\/s9EscapableP","doc:\/\/DisjointSetModule\/SH","doc:\/\/DisjointSetModule\/s8SendableP","doc:\/\/DisjointSetModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/disjointsetmodule\/disjointset"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DisjointSetModule\/documentation\/DisjointSetModule\/DisjointSet"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DisjointSet"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each set’s representative is one of its members. ","type":"text"},{"type":"codeVoice","code":"union(a, b)"},{"text":" keeps the representative of","type":"text"},{"text":" ","type":"text"},{"text":"the larger set, or, for sets of the same size, the smaller of the two representatives, whatever","type":"text"},{"text":" ","type":"text"},{"text":"the order of the arguments. Neither ","type":"text"},{"type":"codeVoice","code":"find"},{"text":" nor a union of elements already in one set changes","type":"text"},{"text":" ","type":"text"},{"text":"a representative, so representatives depend only on the sequence of unions that merged sets.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two disjoint sets are equal when they have the same elements, partitioned the same way. The"},{"type":"text","text":" "},{"type":"text","text":"representative "},{"type":"codeVoice","code":"find"},{"type":"text","text":" returns is not part of the value: equal disjoint sets can name the same"},{"type":"text","text":" "},{"type":"text","text":"set by different representatives."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is one array of "},{"type":"codeVoice","code":"count"},{"type":"text","text":" integers, copied on write. "},{"type":"codeVoice","code":"find"},{"type":"text","text":" and "},{"type":"codeVoice","code":"union(_:_:)"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"codeVoice","code":"mutating"},{"type":"text","text":" because they shorten paths; every other query works on a "},{"type":"codeVoice","code":"let"},{"type":"text","text":", walking at most"},{"type":"text","text":" "},{"type":"text","text":"⌊log₂ count⌋ steps (union by size bounds the height)."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"DisjointSetModule"}],"title":"DisjointSet","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/DisjointSetModule\/DisjointSet.swift#L19","fileName":"DisjointSet.swift"},"navigatorTitle":[{"kind"