e":"text","text":" "},{"type":"text","text":"O(n) expected hashing when "},{"code":"graph","type":"codeVoice"},{"type":"text","text":" has no vertex indices."}]},"doc://FunctionalGraphs/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/FunctionalGraphs\/SQ"},"doc://FunctionalGraphs/s28CustomDebugStringConvertibleP":{"type":"unresolvable","identifier":"doc:\/\/FunctionalGraphs\/s28CustomDebugStringConvertibleP","title":"Swift.CustomDebugStringConvertible"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/successor(checked:)":{"kind":"symbol","title":"successor(checked:)","type":"topic","abstract":[{"type":"codeVoice","code":"successor(of: vertex)"},{"type":"text","text":", throwing instead of trapping when "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" is not in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". O(1)."}],"role":"symbol","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/successor(checked:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"successor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"VertexNotFound","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/successor(checked:)"},"doc://FunctionalGraphs/SE":{"type":"unresolvable","title":"Swift.Encodable","identifier":"doc:\/\/FunctionalGraphs\/SE"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/successor(checked:steps:)":{"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/successor(checked:steps:)","abstract":[{"type":"codeVoice","code":"successor(of: vertex, steps: steps)"},{"text":", throwing instead of trapping when ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":" is not","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":". O(min(k, n)).","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"successor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"steps","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"VertexNotFound","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/successor(checked:steps:)","title":"successor(checked:steps:)","kind":"symbol"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/Encodable-Implementations":{"role":"collectionGroup","title":"Encodable Implementations","abstract":[],"type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/encodable-implementations","kind":"article","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/Encodable-Implementations"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"FunctionalGraph","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"CycleDecomposition","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV"}],"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","kind":"symbol","type":"topic","abstract":[{"text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no","type":"text"},{"text":" ","type":"text"},{"text":"allocation per vertex. The result holds 5n + 3 ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s (two ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" arrays for the preimage","type":"text"},{"text":" ","type":"text"},{"text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder","type":"text"},{"text":" ","type":"text"},{"text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest","type":"text"},{"text":" ","type":"text"},{"text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex).","type":"text"}],"role":"symbol","title":"cycleDecomposition()"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CustomDebugStringConvertible-Implementations":{"kind":"article","title":"CustomDebugStringConvertible Implementations","type":"topic","abstract":[],"role":"collectionGroup","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CustomDebugStringConvertible-Implementations","url":"\/documentation\/functionalgraphs\/functionalgraph\/customdebugstringconvertible-implementations"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/successor(of:steps:)":{"type":"topic","title":"successor(of:steps:)","kind":"symbol","url":"\/documentation\/functionalgraphs\/functionalgraph\