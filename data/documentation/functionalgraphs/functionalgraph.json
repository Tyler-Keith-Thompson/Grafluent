ls, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"LabeledGraph<Label, FunctionalGraph>"},{"type":"text","text":"; "},{"type":"codeVoice","code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)"},{"type":"text","text":" "},{"type":"text","text":"gives a graph "},{"type":"codeVoice","code":"g"},{"type":"text","text":" its labels back."}]},{"type":"paragraph","inlineContent":[{"text":"The graph is immutable: build a new one to change f.","type":"text"}]}]}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/Equatable-Implementations":{"url":"\/documentation\/functionalgraphs\/functionalgraph\/equatable-implementations","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/Equatable-Implementations","title":"Equatable Implementations","role":"collectionGroup","type":"topic","abstract":[],"kind":"article"},"doc://FunctionalGraphs/s23CustomStringConvertibleP":{"type":"unresolvable","identifier":"doc:\/\/FunctionalGraphs\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible"},"doc://FunctionalGraphs/SQ":{"identifier":"doc:\/\/FunctionalGraphs\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/Encodable-Implementations":{"url":"\/documentation\/functionalgraphs\/functionalgraph\/encodable-implementations","type":"topic","kind":"article","role":"collectionGroup","abstract":[],"title":"Encodable Implementations","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/Encodable-Implementations"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","type":"topic","title":"FunctionalGraph","abstract":[{"type":"text","text":"The graph of a function f on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":": e