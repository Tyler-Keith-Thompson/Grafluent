ifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/init(_:)","abstract":[{"type":"text","text":"The functional graph of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" unless every vertex has out-degree exactly 1"},{"type":"text","text":" "},{"type":"text","text":"(parallel edges counted). Vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"i"},{"type":"text","text":"th vertex of "},{"type":"codeVoice","code":"graph.vertices"},{"type":"text","text":". O(n + m), and"},{"type":"text","text":" "},{"type":"text","text":"O(n) expected hashing when "},{"type":"codeVoice","code":"graph"},{"type":"text","text":" has no vertex indices."}],"role":"symbol","title":"init(_:)","type":"topic","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"?<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/init(_:)"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/generation":{"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/generation","abstract":[{"text":"The generation of this graph, which never changes: the graph is immutable. A structure","type":"text"},{"text":" ","type":"text"},{"text":"derived from this graph is current for it and its copies, and for no other graph.","type":"text"}],"role":"symbol","title":"generation","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"generation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GraphGeneration","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A10GenerationV"}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/generation"},"doc://Functional