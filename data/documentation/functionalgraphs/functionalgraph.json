","text":" "},{"type":"text","text":"mapping statistics”, EUROCRYPT ’89). "},{"type":"codeVoice","code":"cycleDecomposition()"},{"type":"text","text":" finds every cycle and tree in O(n);"},{"type":"text","text":" "},{"type":"codeVoice","code":"successor(of:steps:)"},{"type":"text","text":" answers f^k(v) for any k."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For f given as a closure over a state space too large to store, use "},{"type":"codeVoice","code":"floydCycleDetection"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"brentCycleDetection"},{"type":"text","text":", which need only "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" states and O(1) memory."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Storage."}]},{"text":" One ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" per vertex, ","type":"text"},{"code":"f(v)","type":"codeVoice"},{"text":". The edge leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" has position ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", so edge","type":"text"},{"text":" ","type":"text"},{"text":"positions and edge indices are both the source. For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" vertex labels, use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<Label, FunctionalGraph>","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"gives a graph ","type":"text"},{"code":"g","type":"codeVoice"},{"text":" its labels back.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The graph is immutable: build a new one to change f."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/functionalgraphs\/functionalgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy"