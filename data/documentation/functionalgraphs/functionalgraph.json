nd":"struct"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FunctionalGraph","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Following any vertex’s edges eventually repeats, so each weakly connected component holds","type":"text"},{"text":" ","type":"text"},{"text":"exactly one cycle, with rooted trees hanging off its vertices (Flajolet and Odlyzko, “Random","type":"text"},{"text":" ","type":"text"},{"text":"mapping statistics”, EUROCRYPT ’89). ","type":"text"},{"code":"cycleDecomposition()","type":"codeVoice"},{"text":" finds every cycle and tree in O(n);","type":"text"},{"text":" ","type":"text"},{"code":"successor(of:steps:)","type":"codeVoice"},{"text":" answers f^k(v) for any k.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For f given as a closure over a state space too large to store, use ","type":"text"},{"code":"floydCycleDetection","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"brentCycleDetection","type":"codeVoice"},{"text":", which need only ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" states and O(1) memory.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Storage.","type":"text"}]},{"type":"text","text":" One "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" per vertex, "},{"type":"codeVoice","code":"f(v)"},{"type":"text","text":". The edge leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":" has position "},{"type":"codeVoice","code":"v"},{"type":"text","text":", so edge"},{"type":"text","text":" "},{"type":"text","text":"positions and edge indices are both the source. For "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" vertex labels, use"},{"type":"text","text":" "},{"type":"codeVoice","code":"LabeledGraph<Label, FunctionalGraph>"},{"type":"text","text":"; "},{"type":"codeVoice","code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)"},{"type":"text","text":" "},{"type":"text","text":"gives a graph "},{"type":"codeVoice","code":"g"},{"type":"text","text":" its labels back."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is immutable: build a new one to change f."}]}],"kind":"content"}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph"},"abstract":[{"type":"text","text":"The graph of a function f on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":": every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" has exactly one out-edge,"},{"type":"text","text":" "},{"type":"codeVoice","code":"v → f(v)"},{"type":"text","text":", and a fixed point is a self-loop. Also called a successor graph (Laaksonen,"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Competitive Programmer’s Handbook"}]},{"type":"text","text":", §16.3)."}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","text":"FunctionalGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","text":"CycleDecomposition"}],"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","kind":"symbol","abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s (two "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"type":"text","text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder"},{"type":"text","text":" "},{"type":"text","text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","type":"topic","title":"cycleDecomposition()","role":"symbol"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CustomStringConvertible-Implementations":{"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CustomStringConvertible-Implementations","type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/customstringconvertible-implementations","role":"collectionGroup","abstract":[],"kind":"article","title":"CustomStringConvertible Implementations"},"doc://FunctionalGraphs/documentation/FunctionalGraphs":{"url":"\/documentation\/functionalgraphs","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","kind":"symbol","title":"FunctionalGraphs","role":"collection","type":"topic","abstract":[]},"doc://FunctionalGraphs/s8CopyableP":{"identifier":"doc:\/\/FunctionalGraphs\/s8CopyableP","title":"Swift.Copyable","type":"unresolvable"},"doc://FunctionalGraphs/Se":{"identifier":"doc:\/\/FunctionalGraphs\/Se","title":"Swift.Decodable","type":"unresolvable"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/outEdges(checked:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" "