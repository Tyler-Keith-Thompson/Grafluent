","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"code":"brentCycleDetection","type":"codeVoice"},{"type":"text","text":", which need only "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" states and O(1) memory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph stores one "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" per vertex, "},{"code":"f(v)","type":"codeVoice"},{"type":"text","text":". The edge leaving "},{"code":"v","type":"codeVoice"},{"type":"text","text":" has position "},{"code":"v","type":"codeVoice"},{"type":"text","text":", so edge"},{"type":"text","text":" "},{"type":"text","text":"positions and edge indices are both the source. For "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" vertex labels, use"},{"type":"text","text":" "},{"code":"LabeledGraph<Label, FunctionalGraph>","type":"codeVoice"},{"type":"text","text":"; "},{"code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"gives a graph "},{"code":"g","type":"codeVoice"},{"type":"text","text":" its labels back."}]},{"type":"paragraph","inlineContent":[{"text":"The graph is immutable: build a new one to change f.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/functionalgraphs\/functionalgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/PropertyGraph-Implementations":{"role":"collectionGroup","title":"PropertyGraph Implementations","abstract":[],"type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/propertygraph-implementations","kind":"article","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/PropertyGraph-Implementations"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/successor(of:)":{"kind":"symbol","title":"successor(of:)","type":"topic