{"abstract":[{"type":"text","text":"The graph of a function f on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":": every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" has exactly one out-edge,"},{"type":"text","text":" "},{"type":"codeVoice","code":"v → f(v)"},{"type":"text","text":", and a fixed point is a self-loop. Also called a successor graph (Laaksonen,"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Competitive Programmer’s Handbook","type":"text"}]},{"type":"text","text":", §16.3)."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/FunctionalGraphs\/s8CopyableP","doc:\/\/FunctionalGraphs\/s28CustomDebugStringConvertibleP","doc:\/\/FunctionalGraphs\/s23CustomStringConvertibleP","doc:\/\/FunctionalGraphs\/Se","doc:\/\/FunctionalGraphs\/SE","doc:\/\/FunctionalGraphs\/SQ","doc:\/\/FunctionalGraphs\/SH","doc:\/\/FunctionalGraphs\/s8SendableP","doc:\/\/FunctionalGraphs\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph"},"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"FunctionalGraph"}],"externalID":"s:16FunctionalGraphs0A5GraphV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}],"remoteSource":{"fileName":"FunctionalGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/FunctionalGraphs\/FunctionalGraph.swift#L22"},"modules":[{"name":"FunctionalGraphs"}],"role":"symbol","title":"FunctionalGraph","roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Following any vertex’s edges eventually repeats, so each weakly connected component holds"},{"type":"text","text":" "},{"type":"text","text":"exactly one cycle, with rooted trees hanging off its vertices (Flajolet and Odlyzko, “Random"},{"type":"text","text":" "},{"type":"text","text":"mapping statistics”, EUROCRYPT ’89). "},{"code":"cycleDecomposition()","type":"codeVoice"},{"type":"text","text":" finds every cycle and tree in O(n);"},{"type":"text","text":" "},{"code":"successor(of:steps:)","type":"codeVoice"},{"type":"text","text":" answers f^k(v) for any k."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For f given as a closure over a state space too large to store, use "},{"type":"codeVoice","code":"floydCycleDetection"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"brentCycleDetection"},{"type":"text","text":", which need only "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" states and O(1) memory."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Storage.","type":"text"}],"type":"strong"},{"text":" One ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" per vertex, ","type":"text"},{"code":"f(v)","type":"codeVoice"},{"text":". The edge leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" has position ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", so edge","type":"text"},{"text":" ","type":"text"},{"text":"positions and edge indices are both the source. For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" vertex labels, use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<Label, FunctionalGraph>","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"gives a graph ","type":"text"},{"code":"g","type":"codeVoice"},{"text":" its labels back.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The graph is immutable: build a new one to change f."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/functionalgraphs\/functionalgraph"]}],"kind":"symbol","topicSections":[{"title":"Structures","identifiers":["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/init(_:)","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/init(successors:)","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/init(vertexCount:successor:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/successor(of:)","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/successor(of:steps:)"],"anchor":"Instance-Methods","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CustomDebugStringConvertible-Implementations","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CustomStringConvertible-Implementations","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/Decodable-Implementations","doc:\/\/FunctionalGraphs\/document