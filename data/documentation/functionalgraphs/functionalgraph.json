ot and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s (two "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"type":"text","text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder"},{"type":"text","text":" "},{"type":"text","text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}]},"doc://FunctionalGraphs/s28CustomDebugStringConvertibleP":{"identifier":"doc:\/\/FunctionalGraphs\/s28CustomDebugStringConvertibleP","title":"Swift.CustomDebugStringConvertible","type":"unresolvable"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/Encodable-Implementations":{"url":"\/documentation\/functionalgraphs\/functionalgraph\/encodable-implementations","role":"collectionGroup","title":"Encodable Implementations","abstract":[],"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/Encodable-Implementations","kind":"article","type":"topic"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/init(vertexCount:successor:)":{"role":"symbol","title":"init(vertexCount:successor:)","url":"\/documentation\/functionalgraphs\/functionalgraph\/init(vertexcount:successor:)","type":"topic","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"successor","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"tex