:["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Following any vertex’s edges eventually repeats, so each weakly connected component holds"},{"type":"text","text":" "},{"type":"text","text":"exactly one cycle, with rooted trees hanging off its vertices (Flajolet and Odlyzko, “Random"},{"type":"text","text":" "},{"type":"text","text":"mapping statistics”, EUROCRYPT ’89). "},{"type":"codeVoice","code":"cycleDecomposition()"},{"type":"text","text":" finds every cycle and tree in O(n);"},{"type":"text","text":" "},{"type":"codeVoice","code":"successor(of:steps:)"},{"type":"text","text":" answers f^k(v) for any k."}]},{"type":"paragraph","inlineContent":[{"text":"For f given as a closure over a state space too large to store, use ","type":"text"},{"type":"codeVoice","code":"floydCycleDetection"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"brentCycleDetection"},{"text":", which need only ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" states and O(1) memory.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Storage.","type":"text"}],"type":"strong"},{"type":"text","text":" One "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" per vertex, "},{"code":"f(v)","type":"codeVoice"},{"type":"text","text":". The edge leaving "},{"code":"v","type":"codeVoice"},{"type":"text","text":" has position "},{"code":"v","type":"codeVoice"},{"type":"text","text":", so edge"},{"type":"text","text":" "},{"type":"text","text":"positions and edge indices are both the source. For "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" vertex labels, use"},{"type":"text","text":" "},{"code":"LabeledGraph<Label, FunctionalGraph>","type":"codeVoice"},{"type":"text","text":"; "},{"code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"gives a graph "},{"code":"g","type":"codeVoice"},{"type":"text","text":" its labels back."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is immutable: build a new one to change f."}]}]}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s (two "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"type":"text","text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder"},{"type":"text","text":" "},{"type":"text","text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","text":"FunctionalGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","text":"CycleDecomposition"}],"title":"cycleDecomposition()","kind":"symbol","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/cyc