 + 3 "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s (two "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"type":"text","text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder"},{"type":"text","text":" "},{"type":"text","text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","kind":"symbol","type":"topic","title":"cycleDecomposition()"},"doc://FunctionalGraphs/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/FunctionalGraphs\/SH"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/init(_:)":{"role":"symbol","type":"topic","title":"init(_:)","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":")"}],"abstract":[{"text":"The functional graph of ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" unless every vertex has out-degree exactly 1","type":"text"},{"text":" ","type":"text"},{"text":"(parallel edges counted). Vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"th vertex of ","type":"text"},{"code":"graph.vertices","type":"codeVoice"},{"text":". O(n + m), and","type":"text"},{"text":" ","type":"text"},{"text":"O(n) expected hashing when ","type":"text"},{"code":"graph","type":"codeVoice"},{"text":" has no vertex indices.","type":"text"}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/init(_:)","kind":"symbol"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CycleDecomposition":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CycleDecomposition"}],"type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition","title":"FunctionalGraph.CycleDecomposition","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CycleDecomposition"}],"abstract":[{"type":"text","text":"Every cycle of a functional graph, and for each vertex its tail and the cycle it reaches, in"},{"type":"text","text":" "},{"type":"text","text":"Flajolet and Odlyzko’s terms: walking from "},{"type":"codeVoice","code":"v"},{"type":"text","text":", the first vertex on a cycle is "},{"type":"codeVoice","code":"root(of: v)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"tailLength(of: v)"},{"type":"text","text":" steps away (Sage’s “preperiod”), on a cycle of "},{"type":"codeVoice","code":"cycleLength(of: v)"},{"type":"text","text":" "},{"type":"text","text":"vertices. For a permutation, "},{"type":"codeVoice","code":"cycles"},{"type":"text","text":" is its cycle decomposition and every tail is zero."}],"kind":"symbol","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition"},"doc://FunctionalGraphs/s28CustomDebugStringConvertibleP":{"identifier":"doc:\/\/FunctionalGraphs\/s28CustomDebugStringConvertibleP","type":"unresolvable","title":"Swift.CustomDebugStringConvertible"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph":{"kind":"symbol","url":"\/documentation\/functionalgraphs\/functionalgraph","title":"FunctionalGraph","abstract":[{"type":"text","text":"The graph of a function f on the vertices "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":": every vertex "},{"code":"v","type":"codeVoice"},{"type":"text",