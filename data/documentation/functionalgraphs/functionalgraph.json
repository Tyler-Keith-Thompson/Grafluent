"type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" states and O(1) memory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The graph stores one ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" per vertex, ","type":"text"},{"type":"codeVoice","code":"f(v)"},{"text":". The edge leaving ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" has position ","type":"text"},{"type":"codeVoice","code":"v"},{"text":", so edge","type":"text"},{"text":" ","type":"text"},{"text":"positions and edge indices are both the source. For ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" vertex labels, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LabeledGraph<Label, FunctionalGraph>"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)"},{"text":" ","type":"text"},{"text":"gives a graph ","type":"text"},{"type":"codeVoice","code":"g"},{"text":" its labels back.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The graph is immutable: build a new one to change f."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs"]]},"abstract":[{"type":"text","text":"The graph of a function f on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":": every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" has exactly one out-edge,"},{"type":"text","text":" "},{"type":"codeVoice","code":"v → f(v)"},{"type":"text","text":", and a fixed point is a self-loop. Also called a successor graph."}],"identifier":{"url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","d