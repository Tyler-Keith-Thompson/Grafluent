,{"text":". The edge leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" has position ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", so edge","type":"text"},{"text":" ","type":"text"},{"text":"positions and edge indices are both the source. For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" vertex labels, use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<Label, FunctionalGraph>","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"gives a graph ","type":"text"},{"code":"g","type":"codeVoice"},{"text":" its labels back.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is immutable: build a new one to change f."}]}],"kind":"content"}],"metadata":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FunctionalGraph"}],"modules":[{"name":"FunctionalGraphs"}],"remoteSource":{"fileName":"FunctionalGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/FunctionalGraphs\/FunctionalGraph.swift#L21"},"symbolKind":"struct","externalID":"s:16FunctionalGraphs0A5GraphV","roleHeading":"Structure","title":"FunctionalGraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}]},"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/DirectedGraph-Implementations":{"abstract":[],"url":"\/documentation\/functionalgraphs\/functionalgraph\/directedgraph-implementations","role":"collectionGroup","kind":"article","type":"topic","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/DirectedGraph-Implementations","title":"DirectedGraph Implementations"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CycleDecomposition":{"kind":"symbol","identifier":"doc:\/\/FunctionalGr