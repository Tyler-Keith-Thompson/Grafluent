{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/FunctionalGraphs\/s8CopyableP","doc:\/\/FunctionalGraphs\/s28CustomDebugStringConvertibleP","doc:\/\/FunctionalGraphs\/s23CustomStringConvertibleP","doc:\/\/FunctionalGraphs\/Se","doc:\/\/FunctionalGraphs\/SE","doc:\/\/FunctionalGraphs\/SQ","doc:\/\/FunctionalGraphs\/s9EscapableP","doc:\/\/FunctionalGraphs\/SH","doc:\/\/FunctionalGraphs\/s8SendableP","doc:\/\/FunctionalGraphs\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"identifier":{"url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Following any vertex’s edges eventually repeats, so each weakly connected component holds","type":"text"},{"text":" ","type":"text"},{"text":"exactly one cycle, with rooted trees hanging off its vertices (Flajolet and Odlyzko, “Random","type":"text"},{"text":" ","type":"text"},{"text":"mapping statistics”, EUROCRYPT ’89). ","type":"text"},{"code":"cycleDecomposition()","type":"codeVoice"},{"text":" finds every cycle and tree in O(n);","type":"text"},{"text":" ","type":"text"},{"code":"successor(of:steps:)","type":"codeVoice"},{"text":" answers f^k(v) for any k.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For f given as a closure over a state space too large to store, use "},{"type":"codeVoice","code":"floydCycleDetection"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"brentCycleDetection"},{"type":"text","text":", which need only "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" states and O(1) memory."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Storage.","type":"text"}]},{"text":" One ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" per vertex, ","type":"text"},{"type":"codeVoice","code":"f(v)"},{"text":". The edge leaving ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" has position ","type":"text"},{"type":"codeVoice","code":"v"},{"text":", so edge","type":"text"},{"text":" ","type":"text"},{"text":"positions and edge indices are both the source. For ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" vertex labels, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LabeledGraph<Label, FunctionalGraph>"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"LabeledGraph(FunctionalGraph(g)!, labels: g.vertices)"},{"text":" ","type":"text"},{"text":"gives a graph ","type":"text"},{"type":"codeVoice","code":"g"},{"text":" its labels back.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The graph is immutable: build a new one to change f.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"The graph of a function f on the vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":": every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" has exactly one out-edge,","type":"text"},{"text":" ","type":"text"},{"code":"v → f(v)","type":"codeVoice"},{"text":", and a fixed point is a self-loop. Also called a successor graph (Laaksonen,","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Competitive Programmer’s Handbook"}],"type":"emphasis"},{"text":", §16.3).","type":"text"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs