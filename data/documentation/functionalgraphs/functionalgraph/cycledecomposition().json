{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s (two "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"type":"text","text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder"},{"type":"text","text":" "},{"type":"text","text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleDecomposition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"FunctionalGraph","kind":"typeIdentifier","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV"},{"text":".","kind":"text"},{"text":"CycleDecomposition","kind":"typeIdentifier","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A counting sort of f gives the preimage rows and the in-degrees. Peeling the vertices of"},{"type":"text","text":" "},{"type":"text","text":"in-degree zero, repeatedly, visits the tree vertices leaves first, summing subtree sizes on"},{"type":"text","text":" "},{"type":"text","text":"the way, and leaves exactly the cyclic ones; each cycle is then walked from its least"},{"type":"text","text":" "},{"type":"text","text":"vertex. Revisiting the peeled vertices in reverse, parents first, gives every tail length"},{"type":"text","text":" "},{"type":"text","text":"and root and a preorder numbering of the trees from the subtree sizes; a counting sort by"},{"type":"text","text":" "},{"type":"text","text":"depth then lays out the level-ancestor table. Nothing recurses or chases a chain of"},{"type":"text","text":" "},{"type":"text","text":"dependent reads, so a tail of 10⁷ vertices needs no call stack."}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"The graph has fewer than 2³¹ vertices."}],"type":"paragraph"}]}]}],"kind":"symbol","metadata":{"externalID":"s:16FunctionalGraphs0A5GraphV18cycleDecompositionAC05CycleE0VyF","title":"cycleDecomposition()","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/FunctionalGraphs\/CycleDecomposition.swift#L269","fileName":"CycleDecomposition.swift"},"roleHeading":"Instance Method","modules":[{"name":"FunctionalGraphs"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","kind":"typeIdentifier","text":"FunctionalGraph"},{"kind":"text","text":"."},{"preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","kind":"typeIdentifier","text":"CycleDecomposition"}],"extendedModule":"FunctionalGraphs"},"hierarchy":{"paths":[["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph"]]},"sections":[],"variants":[{"paths":["\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CycleDecomposition":{"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CycleDecomposition"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CycleDecomposition"}],"abstract":[{"type":"text","text":"Every cycle of a functional graph, and for each vertex its tail and the cycle it reaches, in"},{"type":"text","text":" "},{"type":"text","text":"Flajolet and Odlyzko’s terms: walking from "},{"code":"v","type":"codeVoice"},{"type":"text","text":", the first vertex on a cycle is "},{"code":"root(of: v)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"tailLength(of: v)","type":"codeVoice"},{"type":"text","text":" steps away (Sage’s “preperiod”), on a cycle of "},{"code":"cycleLength(of: v)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"vertices. For a permutation, "},{"code":"cycles","type":"codeVoice"},{"type":"text","text":" is its cycle decomposition and every tail is zero."}],"title":"FunctionalGraph.CycleDecomposition","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","type":"topic","title":"FunctionalGraph","abstract":[{"type":"text","text":"The graph of a function f on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":": every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" has exactly one out-edge,"},{"type":"text","text":" "},{"type":"codeVoice","code":"v → f(v)"},{"type":"text","text":", and a fixed point is a self-loop. Also called a successor graph (Laaksonen,"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Competitive Programmer’s Handbook"}]},{"type":"text","text":", §16.3)."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FunctionalGraph","kind":"identifier"}],"url":"\/documentation\/functionalgraphs\/functionalgraph","navigatorTitle":[{"text":"FunctionalGraph","kind":"identifier"}]},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","title":"cycleDecomposition()","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleDecomposition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"FunctionalGraph","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"CycleDecomposition","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","kind":"typeIdentifier"}],"abstract":[{"text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no","type":"text"},{"text":" ","type":"text"},{"text":"allocation per vertex. The result holds 5n + 3 ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s (two ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" arrays for the preimage","type":"text"},{"text":" ","type":"text"},{"text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder","type":"text"},{"text":" ","type":"text"},{"text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest","type":"text"},{"text":" ","type":"text"},{"text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex).","type":"text"}],"kind":"symbol"},"doc://FunctionalGraphs/documentation/FunctionalGraphs":{"url":"\/documentation\/functionalgraphs","type":"topic","kind":"symbol","role":"collection","abstract":[],"title":"FunctionalGraphs","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs"}}}