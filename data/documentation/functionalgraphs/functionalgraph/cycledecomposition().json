unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph":{"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph","abstract":[{"text":"The graph of a function f on the vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":": every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" has exactly one out-edge,","type":"text"},{"text":" ","type":"text"},{"code":"v → f(v)","type":"codeVoice"},{"text":", and a fixed point is a self-loop. Also called a successor graph.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FunctionalGraph","kind":"identifier"}],"title":"FunctionalGraph","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"FunctionalGraph","kind":"identifier"}]},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleDecomposition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"FunctionalGraph","kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV"},{"text":".","kind":"text"},{"text":"CycleDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV"}],"type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","title":"cycleDecomposition()","abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s (two "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"type":"text","text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder"},{"type":"text","text":" "},{"type":"text","text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}],"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CycleDecomposition":{"kind":"symbol","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CycleDecomposition","kind":"identifier"}],"title":"FunctionalGraph.CycleDecomposition","url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition","role":"symbol","type":"topic","navigatorTitle":[{"text":"CycleDecomposition","kind":"identifier"}],"abstract":[{"text":"Every cycle of a functional graph, and for each vertex its tail and the cycle it reaches, in","type":"text"},{"text":" ","type":"text"},{"text":"Flajolet and Odlyzko’s terms: walking from ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", the first vertex on a cycle is ","type":"text"},{"code":"root(of: v)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"tailLength(of: v)","type":"codeVoice"},{"text":" steps away, on a cycle of ","type":"text"},{"code":"cycleLength(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"vertices. For a permutation, ","type":"text"},{"code":"cycles","type":"codeVoice"},{"text":" is its cycle decomposition and every tail is zero.","type":"text"}]},"doc://FunctionalGraphs/documentation/FunctionalGra