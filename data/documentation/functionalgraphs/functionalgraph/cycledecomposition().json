ame":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph has fewer than 2³¹ vertices."}]}]}]}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph":{"role":"symbol","kind":"symbol","title":"FunctionalGraph","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","abstract":[{"type":"text","text":"The graph of a function f on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":": every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" has exactly one out-edge,"},{"type":"text","text":" "},{"type":"codeVoice","code":"v → f(v)"},{"type":"text","text":", and a fixed point is a self-loop. Also called a successor graph (Laaksonen,"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Competitive Programmer’s Handbook"}]},{"type":"text","text":", §16.3)."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}],"navigatorTitle":[{"kind":"identifier","text":"FunctionalGraph"}],"url":"\/documentation\/functionalgraphs\/functionalgraph"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","text":"FunctionalGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","text":"CycleDecomposition"}],"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","kind":"symbol","abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","