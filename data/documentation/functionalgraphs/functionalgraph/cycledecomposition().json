s ","type":"text"},{"type":"codeVoice","code":"0..<n"},{"text":": every vertex ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" has exactly one out-edge,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v → f(v)"},{"text":", and a fixed point is a self-loop. Also called a successor graph.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"FunctionalGraph","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FunctionalGraph","kind":"identifier"}],"url":"\/documentation\/functionalgraphs\/functionalgraph"},"doc://FunctionalGraphs/documentation/FunctionalGraphs":{"title":"FunctionalGraphs","type":"topic","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/functionalgraphs"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CycleDecomposition":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CycleDecomposition","kind":"identifier"}],"navigatorTitle":[{"text":"CycleDecomposition","kind":"identifier"}],"abstract":[{"text":"Every cycle of a functional graph, and for each vertex its tail and the cycle it reaches, in","type":"text"},{"text":" ","type":"text"},{"text":"Flajolet and Odlyzko’s terms: walking from ","type":"text"},{"type":"codeVoice","code":"v"},{"text":", the first vertex on a cycle is ","type":"text"},{"type":"codeVoice","code":"root(of: v)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"tailLength(of: v)"},{"text":" steps away, on a cycle of ","type":"text"},{"type":"codeVoice","code":"cycleLength(of: v)"},{"text":" ","type":"text"},{"text":"vertices. For a permutation, ","type":"text"},{"type":"codeVoice","code":"cycles"},{"text":" is its cycle decomposition and every tail is zero.","type":"text"}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledeco