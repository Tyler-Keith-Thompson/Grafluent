{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","text":"FunctionalGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition","text":"CycleDecomposition"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"A counting sort of f gives the preimage rows and the in-degrees. Peeling the vertices of","type":"text"},{"text":" ","type":"text"},{"text":"in-degree zero, repeatedly, visits the tree vertices leaves first, summing subtree sizes on","type":"text"},{"text":" ","type":"text"},{"text":"the way, and leaves exactly the cyclic ones; each cycle is then walked from its least","type":"text"},{"text":" ","type":"text"},{"text":"vertex. Revisiting the peeled vertices in reverse, parents first, gives every tail length","type":"text"},{"text":" ","type":"text"},{"text":"and root and a preorder numbering of the trees from the subtree sizes; a counting sort by","type":"text"},{"text":" ","type":"text"},{"text":"depth then lays out the level-ancestor table. Nothing recurses or chases a chain of","type":"text"},{"text":" ","type":"text"},{"text":"dependent reads, so a tail of 10⁷ vertices needs no call stack.","type":"text"}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"text":"The graph has fewer than 2³¹ vertices.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()"]}],"kind":"symbol","sections":[],"metadata":{"extendedModule":"FunctionalGraphs","role":"symbol","externalID":"s:16FunctionalGraphs0A5GraphV18cycleDecompositionAC05CycleE0VyF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleDecomposition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"FunctionalGraph","kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV"},{"text":".","kind":"text"},{"text":"CycleDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/FunctionalGraphs\/CycleDecomposition.swift#L347","fileName":"CycleDecomposition.swift"},"title":"cycleDecomposition()","modules":[{"name":"FunctionalGraphs"}],"roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no","type":"text"},{"text":" ","type":"text"},{"text":"allocation per vertex. The result holds 5n + 3 ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":"s (two ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" arrays for the preimage","type":"text"},{"text":" ","type":"text"},{"text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder","type":"text"},{"text":" ","type":"text"},{"text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest","type":"text"},{"text":" ","type":"text"},{"text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex).","type":"text"}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CycleDecomposition":{"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition","abstract":[{"type":"text","text":"Every cycle of a functional graph, and for each vertex its tail and the cycle it reaches, in"},{"type":"text","text":" "},{"type":"text","text":"Flajolet and Odlyzko’s terms: walking from "},{"type":"codeVoice","code":"v"},{"type":"text","text":", the first vertex on a cycle is "},{"type":"codeVoice","code":"root(of: v)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"tailLength(of: v)"},{"type":"text","text":" steps away (Sage’s “preperiod”), on a cycle of "},{"type":"codeVoice","code":"cycleLength(of: v)"},{"type":"text","text":" "},{"type":"text","text":"vertices. For a permutation, "},{"type":"codeVoice","code":"cycles"},{"type":"text","text":" is its cycle decomposition and every tail is zero."}],"kind":"symbol","type":"topic","title":"FunctionalGraph.CycleDecomposition","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CycleDecomposition","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"CycleDecomposition","kind":"identifier"}]},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph":{"url":"\/documentation\/functionalgraphs\/functionalgraph","abstract":[{"text":"The graph of a function f on the vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":": every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" has exactly one out-edge,","type":"text"},{"text":" ","type":"text"},{"code":"v → f(v)","type":"codeVoice"},{"text":", and a fixed point is a self-loop. Also called a successor graph (Laaksonen,","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Competitive Programmer’s Handbook","type":"text"}],"type":"emphasis"},{"text":", §16.3).","type":"text"}],"kind":"symbol","type":"topic","title":"FunctionalGraph","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FunctionalGraph"}]},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","abstract":[{"text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no","type":"text"},{"text":" ","type":"text"},{"text":"allocation per vertex. The result holds 5n + 3 ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s (two ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" arrays for the preimage","type":"text"},{"text":" ","type":"text"},{"text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder","type":"text"},{"text":" ","type":"text"},{"text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest","type":"text"},{"text":" ","type":"text"},{"text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex).","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"cycleDecomposition()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","text":"FunctionalGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","text":"CycleDecomposition"}]},"doc://FunctionalGraphs/documentation/FunctionalGraphs":{"url":"\/documentation\/functionalgraphs","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","abstract":[],"role":"collection","type":"topic","kind":"symbol","title":"FunctionalGraphs"}}}