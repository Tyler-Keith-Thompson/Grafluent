v","type":"codeVoice"},{"type":"text","text":" has exactly one out-edge,"},{"type":"text","text":" "},{"code":"v → f(v)","type":"codeVoice"},{"type":"text","text":", and a fixed point is a self-loop. Also called a successor graph."}],"kind":"symbol","title":"FunctionalGraph","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","type":"topic"},"doc://FunctionalGraphs/documentation/FunctionalGraphs":{"role":"collection","abstract":[],"url":"\/documentation\/functionalgraphs","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","kind":"symbol","title":"FunctionalGraphs","type":"topic"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"type":"topic","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleDecomposition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"FunctionalGraph","kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV"},{"text":".","kind":"text"},{"text":"CycleDecomposition","kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV"}],"url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s (two "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"type":"text","text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder"},{"type":"text","text":" "},{"type":"text","text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest"},{"type":"text","text":" "},{"type":"text","text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex)."}],"title":"cycleDecomposition()"}}}