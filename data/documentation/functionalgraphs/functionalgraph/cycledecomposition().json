{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleDecomposition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"FunctionalGraph","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"CycleDecomposition","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A counting sort of f gives the preimage rows and the in-degrees. Peeling the vertices of","type":"text"},{"text":" ","type":"text"},{"text":"in-degree zero, repeatedly, visits the tree vertices leaves first, summing subtree sizes on","type":"text"},{"text":" ","type":"text"},{"text":"the way, and leaves exactly the cyclic ones; each cycle is then walked from its least","type":"text"},{"text":" ","type":"text"},{"text":"vertex. Revisiting the peeled vertices in reverse, parents first, gives every tail length","type":"text"},{"text":" ","type":"text"},{"text":"and root and a preorder numbering of the trees from the subtree sizes; a counting sort by","type":"text"},{"text":" ","type":"text"},{"text":"depth then lays out the level-ancestor table. Nothing recurses or chases a chain of","type":"text"},{"text":" ","type":"text"},{"text":"dependent reads, so a tail of 10⁷ vertices needs no call stack.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The graph has fewer than 2³¹ vertices."}],"type":"paragraph"}],"name":"Precondition","style":"note","type":"aside"}],"kind":"content"}],"identifier":{"url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cycleDecomposition","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","text":"FunctionalGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","text":"CycleDecomposition"}],"remoteSource":{"fileName":"CycleDecomposition.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/FunctionalGraphs\/CycleDecomposition.swift#L346"},"role":"symbol","externalID":"s:16FunctionalGraphs0A5GraphV18cycleDecompositionAC05CycleE0VyF","modules":[{"name":"FunctionalGraphs"}],"title":"cycleDecomposition()","extendedModule":"FunctionalGraphs","symbolKind":"method","roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph"]]},"sections":[],"abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s (two "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" arrays for the preimage"},{"type":"text","text":" "},{"text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder","type":"text"},{"text":" ","type":"text"},{"text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest","type":"text"},{"text":" ","type":"text"},{"text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex).","type":"text"}],"references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/cycleDecomposition()":{"abstract":[{"type":"text","text":"The cycles of the graph, and every vertex’s tail, root and preimages. O(n) time, with no"},{"type":"text","text":" "},{"type":"text","text":"allocation per vertex. The result holds 5n + 3 "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s (two "},{"code":"Int","type":"codeVoice"},{"text":" arrays for the preimage","type":"text"},{"text":" ","type":"text"},{"text":"rows, one for the vertices by depth, a 12-byte record per vertex and a 4-byte preorder","type":"text"},{"text":" ","type":"text"},{"text":"number beside each vertex by depth), plus one per cycle and one per unit of the longest","type":"text"},{"text":" ","type":"text"},{"text":"tail; building it takes 3n more for a moment (two 12-byte entries per vertex).","type":"text"}],"title":"cycleDecomposition()","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/cycleDecomposition()","type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cycleDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV","text":"FunctionalGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:16FunctionalGraphs0A5GraphV18CycleDecompositionV","text":"CycleDecomposition"}],"role":"symbol"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph/CycleDecomposition":{"navigatorTitle":[{"text":"CycleDecomposition","kind":"identifier"}],"abstract":[{"text":"Every cycle of a functional graph, and for each vertex its tail and the cycle it reaches, in","type":"text"},{"text":" ","type":"text"},{"text":"Flajolet and Odlyzko’s terms: walking from ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", the first vertex on a cycle is ","type":"text"},{"code":"root(of: v)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"tailLength(of: v)","type":"codeVoice"},{"text":" steps away, on a cycle of ","type":"text"},{"code":"cycleLength(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"vertices. For a permutation, ","type":"text"},{"code":"cycles","type":"codeVoice"},{"text":" is its cycle decomposition and every tail is zero.","type":"text"}],"title":"FunctionalGraph.CycleDecomposition","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph\/CycleDecomposition","kind":"symbol","type":"topic","url":"\/documentation\/functionalgraphs\/functionalgraph\/cycledecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CycleDecomposition","kind":"identifier"}],"role":"symbol"},"doc://FunctionalGraphs/documentation/FunctionalGraphs":{"url":"\/documentation\/functionalgraphs","abstract":[],"type":"topic","role":"collection","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","kind":"symbol","title":"FunctionalGraphs"},"doc://FunctionalGraphs/documentation/FunctionalGraphs/FunctionalGraph":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FunctionalGraph"}],"url":"\/documentation\/functionalgraphs\/functionalgraph","navigatorTitle":[{"kind":"identifier","text":"FunctionalGraph"}],"abstract":[{"text":"The graph of a function f on the vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":": every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" has exactly one out-edge,","type":"text"},{"text":" ","type":"text"},{"code":"v → f(v)","type":"codeVoice"},{"text":", and a fixed point is a self-loop. Also called a successor graph.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/FunctionalGraph","kind":"symbol","title":"FunctionalGraph"}}}