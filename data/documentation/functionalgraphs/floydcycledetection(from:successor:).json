inux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Returns "},{"type":"codeVoice","code":"tailLength"},{"type":"text","text":", the number of steps from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" to the first vertex on the cycle (μ,"},{"type":"text","text":" "},{"type":"text","text":"Sage’s “preperiod”), "},{"type":"codeVoice","code":"cycleLength"},{"type":"text","text":" (λ), and that first cyclic vertex, "},{"type":"codeVoice","code":"root"},{"type":"text","text":". The closure is"},{"type":"text","text":" "},{"type":"text","text":"called exactly 3ν + 2μ + λ times, where ν is the least multiple of λ that is at least"},{"type":"text","text":" "},{"type":"text","text":"max(μ, 1); that count includes calling it on "},{"type":"codeVoice","code":"start"},{"type":"text","text":" twice, once for each runner’s first step"},{"type":"text","text":" "},{"type":"text","text":"(Knuth’s formulation, kept as pinned). "},{"type":"codeVoice","code":"brentCycleDetection(from:successor:)"},{"type":"text","text":" calls it less"},{"type":"text","text":" "},{"type":"text","text":"often."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"The orbit of ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" is eventually periodic (always so on a finite state","type":"text"},{"text":" ","type":"text"},{"text":"space). On an infinite orbit the function does not return.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://FunctionalGraphs/documentation/FunctionalGraphs":{"type":"topic","url":"\/documentation\/functionalgraphs","title":"FunctionalGraphs","role":"collection","abstract":[],"identifier":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs","kind":"symbol"},"doc://FunctionalGraphs/documentati