eriod”), ","type":"text"},{"code":"cycleLength","type":"codeVoice"},{"text":" (λ), and that first cyclic vertex, ","type":"text"},{"code":"root","type":"codeVoice"},{"text":". The closure is","type":"text"},{"text":" ","type":"text"},{"text":"called exactly 3ν + 2μ + λ times, where ν is the least multiple of λ that is at least","type":"text"},{"text":" ","type":"text"},{"text":"max(μ, 1); that count includes calling it on ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" twice, once for each runner’s first step","type":"text"},{"text":" ","type":"text"},{"text":"(Knuth’s formulation, kept as pinned). ","type":"text"},{"code":"brentCycleDetection(from:successor:)","type":"codeVoice"},{"text":" calls it less","type":"text"},{"text":" ","type":"text"},{"text":"often.","type":"text"}]},{"content":[{"inlineContent":[{"text":"The orbit of ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" is eventually periodic (always so on a finite state","type":"text"},{"text":" ","type":"text"},{"text":"space). On an infinite orbit the function does not return.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Precondition"}]}],"hierarchy":{"paths":[["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs"]]},"variants":[{"paths":["\/documentation\/functionalgraphs\/floydcycledetection(from:successor:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"remoteSource":{"fileName":"CycleDetection.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/FunctionalGraphs\/CycleDetection.swift#L19"},"role":"symbol","modules":[{"name":"FunctionalGraphs"}],"title":"floydCycleDetection(from:successor:)","roleHeading":"Function","externalID":"s:16FunctionalGraphs19floydCycleDetection4from9successorSi10tailLength_Si05cycleI0x4roottx_xxXEtSQRzlF","symbolKind":"func","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"floydCycleDetection","kind":"identifier"},{"