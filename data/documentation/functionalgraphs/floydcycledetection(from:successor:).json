{"abstract":[{"type":"text","text":"The tail and cycle of the orbit of "},{"type":"codeVoice","code":"start"},{"type":"text","text":" under "},{"type":"codeVoice","code":"successor"},{"type":"text","text":", by Floyd’s algorithm (Knuth,"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"The Art of Computer Programming"}]},{"type":"text","text":", vol. 2, §3.1, exercise 6): a tortoise and a hare at twice its"},{"type":"text","text":" "},{"type":"text","text":"speed meet on the cycle; a second pass from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" finds the first cyclic vertex, and a third"},{"type":"text","text":" "},{"type":"text","text":"lap measures the cycle. O(μ + λ) time, O(1) memory, and states need only be "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs"]]},"identifier":{"url":"doc:\/\/FunctionalGraphs\/documentation\/FunctionalGraphs\/floydCycleDetection(from:successor:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/functionalgraphs\/floydcycledetection(from:successor:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"floydCycleDetection","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"start","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"successor","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"f","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text"