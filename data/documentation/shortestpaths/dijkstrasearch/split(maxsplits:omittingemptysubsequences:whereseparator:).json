aSearch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearch","kind":"identifier"}],"url":"\/documentation\/shortestpaths\/dijkstrasearch","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearch","kind":"symbol","abstract":[{"type":"text","text":"Dijkstra’s algorithm as a sequence of "},{"type":"codeVoice","code":"DijkstraSearchEvent"},{"type":"text","text":"s, pulled one at a time. It holds a"},{"type":"text","text":" "},{"type":"text","text":"copy of the graph and the weight closure, so later changes to the original do not affect it,"},{"type":"text","text":" "},{"type":"text","text":"and it can be iterated more than once. Vertices are numbered once, and the search keeps its"},{"type":"text","text":" "},{"type":"text","text":"distances in arrays over that numbering."}],"navigatorTitle":[{"text":"DijkstraSearch","kind":"identifier"}],"type":"topic","role":"symbol"}}}