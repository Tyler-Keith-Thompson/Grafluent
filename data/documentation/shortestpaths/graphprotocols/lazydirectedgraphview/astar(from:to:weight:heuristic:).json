text","text":" "},{"type":"text","text":"examined, and "},{"code":"heuristic","type":"codeVoice"},{"type":"text","text":" once per vertex, when it is discovered, never for "},{"code":"target","type":"codeVoice"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"text","text":"estimate is zero. With an admissible heuristic the target’s distance when it is examined is"},{"type":"text","text":" "},{"type":"text","text":"the shortest; see "},{"code":"aStarShortestPath(from:to:weight:heuristic:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices. While iterating: every examined weight"},{"type":"text","text":" "},{"type":"text","text":"is at least "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" and not NaN, no estimate is NaN, and the sums fit in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O((V + E) log V) to iterate every event with a consistent heuristic, as for"},{"type":"text","text":" "},{"code":"aStarShortestPath","type":"codeVoice"},{"type":"text","text":"; O(V) to make the search and each iterator."}]}],"type":"aside","style":"note"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/lazydirectedgraphview\/astar(from:to:weight:heuristic:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A* from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" toward "},{"type":"codeVoice","code":"target"},{"type":"text","text":", guided by "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":", 