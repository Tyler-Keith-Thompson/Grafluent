type":"text"},{"text":"the shortest; see ","type":"text"},{"code":"aStarShortestPath(from:to:weight:heuristic:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target","type":"codeVoice"},{"type":"text","text":" are vertices. While iterating: every examined weight"},{"type":"text","text":" "},{"type":"text","text":"is at least "},{"code":".zero","type":"codeVoice"},{"type":"text","text":" and not NaN, no estimate is NaN, and the sums fit in "},{"code":"W","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O((V + E) log V) to iterate every event with a consistent heuristic, as for","type":"text"},{"text":" ","type":"text"},{"code":"aStarShortestPath","type":"codeVoice"},{"text":"; O(V) to make the search and each iterator.","type":"text"}]}]}]}],"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A* from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" toward "},{"type":"codeVoice","code":"target"},{"type":"text","text":", guided by "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":", as a sequence of events: each"},{"type":"text","text":" "},{"type":"text","text":"vertex discovered, examined (closed), reopened and finished, and each examined edge relaxed"},{"type":"text","text":" "},{"type":"text","text":"or not, with the distances and estimates involved. See "},{"type":"codeVoice","code":"AStarSearchEvent"},{"type":"text","text":" for the order."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/LazyDirectedGraphView\/aStar(from:to:weight:heuristic:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"me