Identifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s length from its position; "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":" estimates a vertex’s"},{"type":"text","text":" "},{"type":"text","text":"distance to "},{"type":"codeVoice","code":"target"},{"type":"text","text":". The search keeps both. It calls "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" once each time an edge is"},{"type":"text","text":" "},{"type":"text","text":"examined, and "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":" once per vertex, when it is discovered, never for "},{"type":"codeVoice","code":"target"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"text","text":"estimate is zero. With an admissible heuristic the target’s distance when it is examined is"},{"type":"text","text":" "},{"type":"text","text":"the shortest; see "},{"type":"codeVoice","code":"aStarShortestPath(from:to:weight:heuristic:)"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target"},{"type":"text","text":" are vertices. While iterating: every examined weight"},{"type":"text","text":" "},{"type":"text","text":"is at least "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" and not NaN, no estimate is NaN, and the sums fit in "},{"type":"codeVoice","code":"W"},{"type":"text","text":"."}]}],"type":"aside","name":"Precondition","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":"O((V + E) log V) to iterate every event with a consistent heuristic, as for"},{"type":"text","text":" "},{"type":"codeVoice","code":"aStarShortestPath"},{"type":"t