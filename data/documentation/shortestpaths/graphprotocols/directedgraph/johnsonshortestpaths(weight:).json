s":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Weights may be negative. Bellman–Ford from a virtual source joined to every vertex gives","type":"text"},{"text":" ","type":"text"},{"text":"each vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" a potential h(v), and Dijkstra’s algorithm runs from every vertex over the","type":"text"},{"text":" ","type":"text"},{"text":"reduced weights h(u) + w - h(v), which are nonnegative. Parallel edges count by their","type":"text"},{"text":" ","type":"text"},{"text":"cheapest. ","type":"text"},{"code":"findNegativeCycle(weight:)","type":"codeVoice"},{"text":" gives a negative cycle when this is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". On sparse","type":"text"},{"text":" ","type":"text"},{"text":"graphs this is faster than ","type":"text"},{"code":"floydWarshallShortestPaths(weight:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(nm) for Bellman–Ford in the worst case (about one pass when no weight is"},{"type":"text","text":" "},{"type":"text","text":"negative), then O(n · (n + m) log n); O(n²) space."}],"type":"paragraph"}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"inlineContent":[{"text":"No weight is NaN; every sum fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":", the reduced weights and the","type":"text"},{"text":" ","type":"text"},{"text":"reduced distances included. With floating point, distances are converted back from the","type":"text"},{"text":" ","type":"text"},{"text":"reduced ones and can differ from Floyd–Warshall’s by rounding.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition"}],"kind":"content"}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/DistanceMatrix":{"abstract":[{"text":"All-pa