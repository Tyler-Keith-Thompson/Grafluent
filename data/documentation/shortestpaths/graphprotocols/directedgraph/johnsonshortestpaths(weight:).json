nd":"text"}],"extendedModule":"GraphProtocols","title":"johnsonShortestPaths(weight:)"},"variants":[{"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/johnsonshortestpaths(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/johnsonShortestPaths(weight:)"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"johnsonShortestPaths"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"DistanceMatrix","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DistanceMatrix","preciseIdentifier":"s:13ShortestPaths14DistanceMatrixV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Weights may be negative. Bellman–Ford from a virtual source joined to every vertex gives"},{"type":"text","text":" "},{"type":"text","text":"each vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" a potential h(v), and Dijkstra’s algorithm runs from every vertex over the"},{"type":"text","text":" "},{"type":"text","text":"reduced weights h(u) + w - h(v), which are nonnegative. Parallel edges count by their"},{"type":"text","text":" "},{"type":"text","text":"cheapest. "},{"type":"codeVoice","code":"findNegativeCycle(weight:)"},{"type":"text","text":" gives a negative cycle when this is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". On sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs this is faster than "},{"type":"codeVoice","code":"floydWarshallShortestPaths(weight:)"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(nm) for Bellman–Ford in the worst case (about one pass when no weight is"},{"type":"text","text":" "},{"type":"text","text":"negative), then O(n · (n + m) log n); O(n²) space."}]}],"name":"Complexity","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"No weight is NaN; every sum fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":", the reduced weights and the","type":"text"},{"text":" ","type":"text"},{"text":"reduced distances included. With floating point, distances are converted back from the","type":"text"},{"text":" ","type":"text"},{"text":"reduced ones and can differ from Floyd–Warshall’s by rounding.","type":"text"}]}],"name":"Precondition","type":"aside"}],"kind":"content"}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"type":"topic","kind":"symb