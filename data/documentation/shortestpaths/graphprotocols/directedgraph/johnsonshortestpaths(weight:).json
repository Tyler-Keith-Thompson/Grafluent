Protocols08DirectedA0P13ShortestPathsE07johnsondE06weightAD14DistanceMatrixVyxqd__GSgqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","roleHeading":"Instance Method","remoteSource":{"fileName":"Johnson.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/Johnson.swift#L115"},"symbolKind":"method","title":"johnsonShortestPaths(weight:)","role":"symbol"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"johnsonShortestPaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths14DistanceMatrixV","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DistanceMatrix","text":"DistanceMatrix","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Weights may be negative. Bellman–Ford from a virtual source joined to every vertex gives"},{"type":"text","text":" "},{"type":"text","text":"each vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" a potential h(v), and Dijkstra’s algorithm runs from every vertex over the"},{"type":"text","text":" "},{"type":"text","text":"reduced weights h(u) + w - h(v), which are nonnegative. Parallel edges count by their"},{"type":"text","text":" "},{"type":"text","text":"cheapest. "},{"type":"codeVoice","code":"findNegativeCycle(weight:)"},{"type":"text","text":" gives a negative cycle when this is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". On sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs this is faster than "},{"type":"codeVoice","code":"floydWarshallShortestPaths(weight:)"},{"type":"text","text":"."}]},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(nm) for Bellman–Ford in the worst case (about one pass when no weight is"},{"type":"text","text":" "},{"type":"text","text":"negative), then O(n · (n + m) log n); O(n²) space."}]}],"style":"note"},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is NaN; every sum fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":", the reduced weights and the"},{"type":"text","text":" "},{"type":"text","text":"reduced distances included. With floating point, distances are converted back from the"},{"type":"text","text":" "},{"type":"text","text":"reduced ones and can differ from Floyd–Warshall’s by rounding."}]}],"style":"note"}]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/johnsonShortest