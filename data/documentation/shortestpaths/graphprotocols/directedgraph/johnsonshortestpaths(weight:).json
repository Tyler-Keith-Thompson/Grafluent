xt","text":"Shortest paths between every ordered pair of vertices by Johnson’s algorithm, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the graph has a negative cycle anywhere (a negative loop counts)."}],"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/johnsonshortestpaths(weight:)","role":"symbol","title":"johnsonShortestPaths(weight:)"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"kind":"symbol","abstract":[],"type":"topic","title":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","role":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths":{"kind":"symbol","abstract":[],"type":"topic","title":"ShortestPaths","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","url":"\/documentation\/shortestpaths","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths/DistanceMatrix":{"url":"\/documentation\/shortestpaths\/distancematrix","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DistanceMatrix","title":"DistanceMatrix","role":"symbol","abstract":[{"type":"text","text":"All-pairs distances, from Floyd–Warshall, Johnson’s algorithm or all-pairs Dijkstra: for each"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertices, the distance of a best path and the last edge on it, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"path(from:to:)"},{"type":"text","text":" walks back from the target."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Dist