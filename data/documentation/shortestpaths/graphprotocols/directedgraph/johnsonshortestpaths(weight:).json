{"metadata":{"roleHeading":"Instance Method","externalID":"s:14GraphProtocols08DirectedA0P13ShortestPathsE07johnsondE06weightAD14DistanceMatrixVyxqd__GSgqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/Johnson.swift#L115","fileName":"Johnson.swift"},"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"johnsonShortestPaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths14DistanceMatrixV","text":"DistanceMatrix","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"modules":[{"name":"ShortestPaths","relatedModules":["GraphProtocols"]}],"title":"johnsonShortestPaths(weight:)","symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"sections":[],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/johnsonShortestPaths(weight:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Shortest paths between every ordered pair of vertices by Johnson’s algorithm, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"the graph has a negative cycle anywhere (a negative loop counts).","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"johnsonShortestPaths"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13ShortestPaths14DistanceMatrixV","kind":"typeIdentifier","text":"DistanceMatrix","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DistanceMatrix"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Weights may be negative. Bellman–Ford from a virtual source joined to every vertex gives"},{"type":"text","text":" "},{"type":"text","text":"each vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" a potential h(v), and Dijkstra’s algorithm runs from every vertex over the"},{"type":"text","text":" "},{"type":"text","text":"reduced weights h(u) + w - h(v), which are nonnegative. Parallel edges count by their"},{"type":"text","text":" "},{"type":"text","text":"cheapest. "},{"type":"codeVoice","code":"findNegativeCycle(weight:)"},{"type":"text","text":" gives a negative cycle when this is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". On sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs this is faster than "},{"type":"codeVoice","code":"floydWarshallShortestPaths(weight:)"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O(nm) for Bellman–Ford in the worst case (about one pass when no weight is"},{"type":"text","text":" "},{"type":"text","text":"negative), then O(n · (n + m) log n); O(n²) space."}],"type":"paragraph"}],"type":"aside","name":"Complexity"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"No weight is NaN; every sum fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":", the reduced weights and the","type":"text"},{"text":" ","type":"text"},{"text":"reduced distances included. With floating point, distances are converted back from the","type":"text"},{"text":" ","type":"text"},{"text":"reduced ones and can differ from Floyd–Warshall’s by rounding.","type":"text"}]}],"type":"aside","name":"Precondition"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/johnsonshortestpaths(weight:)"]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths":{"identifier":"doc:\/\/ShortestPaths\/docum