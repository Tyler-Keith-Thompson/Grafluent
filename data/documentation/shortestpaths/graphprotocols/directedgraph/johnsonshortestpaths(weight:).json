s algorithm, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the graph has a negative cycle anywhere (a negative loop counts)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"johnsonShortestPaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"DistanceMatrix","kind":"typeIdentifier","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DistanceMatrix","preciseIdentifier":"s:13ShortestPaths14DistanceMatrixV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Weights may be negative. Bellman–Ford from a virtual source joined to every vertex gives"},{"type":"text","text":" "},{"type":"text","text":"each vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" a potential h(v), and Dijkstra’s algorithm runs from every vertex over the"},{"type":"text","text":" "},{"type":"text","text":"reduced weights h(u) + w - h(v), which are nonnegative. Parallel edges count by their"},{"type":"text","text":" "},{"type":"text","text":"cheapest. "},{"type":"codeVoice","code":"findNegativeCycle(weight:)"},{"type":"text","text":" gives a negative cycle when this is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". On sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs this is faster than "},{"type":"codeVoice","code":"floydWarshallShortestPaths(weight:)"},{"type":"text","text":"."}]},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(nm) for Bellman–Ford in the worst case (about one pass when no weight is"},{"type":"text","text":" "},{"type":"text","text":"negative), then O(n · (n + m) log n); O(n²) space."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"No weight is NaN; every sum fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":", the reduced weights and the"},{"type":"text","text":" "},{"type":"text","text":"reduced distances included. With floating point, distances are converted back from the"},{"type":"text","text":" "},{"type":"text","text":"reduced ones and can differ from Floyd–Warshall’s by rounding."}],"type":"paragraph"}],"type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/johnsonShortestPaths(weight:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/johnsonShortest