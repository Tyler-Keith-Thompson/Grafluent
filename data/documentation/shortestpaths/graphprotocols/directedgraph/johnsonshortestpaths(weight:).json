{"abstract":[{"type":"text","text":"Shortest paths between every ordered pair of vertices by Johnson’s algorithm, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the graph has a negative cycle anywhere (a negative loop counts)."}],"kind":"symbol","metadata":{"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"johnsonShortestPaths"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths14DistanceMatrixV","text":"DistanceMatrix"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">?"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"ShortestPaths"}],"role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P13ShortestPathsE07johnsondE06weightAD14DistanceMatrixVyxqd__GSgqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","symbolKind":"method","extendedModule":"GraphProtocols","remoteSource":{"fileName":"Johnson.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/Johnson.swift#L115"},"title":"johnsonShortestPaths(weight:)"},"variants":[{"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/johnsonshortestpaths(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"johnsonShortestPaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DistanceMatrix","text":"DistanceMatrix","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths14DistanceMatrixV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Weights may be negative. Bellman–Ford from a virtual source joined to every vertex gives"},{"type":"text","text":" "},{"type":"text","text":"each vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":" a potential h(v), and Dijkstra’s algorithm runs from every vertex over the"},{"type":"text","text":" "},{"type":"text","text":"reduced weights h(u) + w - h(v), which are nonnegative. Parallel edges count by their"},{"type":"text","text":" "},{"type":"text","text":"cheapest. "},{"type":"codeVoice","code":"findNegativeCycle(weight:)"},{"type":"text","text":" gives a negative cycle when this is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". On sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs this is faster than "},{"type":"codeVoice","code":"floydWarshallShortestPaths(weight:)"},{"type":"text","text":"."}]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(nm) for Bellman–Ford in the worst case (about one pass when no weight is"},{"type":"text","text":" "},{"type":"text","text":"negative), then O(n · (n + m) log n); O(n²) space."}],"type":"paragraph"}]},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"No weight is NaN; every sum fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":", the reduced weights and the"},{"type":"text","text":" "},{"type":"text","text":"reduced distances included. With floating point, distances are converted back from the"},{"type":"text","text":" "},{"type":"text","text":"reduced ones and can differ from Floyd–Warshall’s by rounding."}],"type":"paragraph"}]}]}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/johnsonShortestPaths(weight:)","interfaceLanguage":"swift"},"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/johnsonShortest