veArithmeticRd__SLRd__lF","symbolKind":"method"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"ALT landmarks over the graph with these weights, for repeated shortest-path queries","type":"text"},{"text":" ","type":"text"},{"text":"between arbitrary pairs of vertices by A* search.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"altLandmarks","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 8, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths12ALTLandmarksV","text":"ALTLandmarks","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"How many landmarks to choose, at most the vertex count."}],"type":"paragraph"}],"name":"count"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}],"name":"weight"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"count"},{"type":"text","text":" landmarks are chosen farthest from one another (the first farthest from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, each next one farthest from those chosen, a vertex no landmark reaches first), and"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra’s algorithm runs from and to each; the build is 2 × "},{"type":"codeVoice","code":"count"},{"type":"text","text":" searches over the"},{"type":"text","text":" "},{"type":"text","text":"graph. More landmarks give tighter estimates and cost more memory, two distances per"},{"type":"text","text":" "},{"type":"text","text":"landmark and vertex. Parallel edges count by their cheapest; self-loops are ignored."},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge and the weights are kept."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(count (n + m) log n), plus O(n + m) to copy the arcs."}]}],"name":"Complexity"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"Every weight is at least ","type":"text"},{"code":".zero","type":"codeVoice"},{"text":" and not NaN; every sum fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" is at least zero.","type":"text"}],"type":"paragraph"}],"name":"Precondition"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/altlandmarks(count:weight:)"]}],"kind":"symbol","references":{"doc://ShortestPaths/documentation/ShortestPaths":{"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/shortestpaths","title":"ShortestPaths"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/altLandmarks(count:weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"altLandmarks","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ALTLandmarks","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths12ALTLandmarksV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"ALT landmarks over the graph with these weights, for repeated shortest-path queries"},{"type":"text","text":" "},{"type":"text","text":"between arbitrary pairs of vertices by A* search."}],"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/G