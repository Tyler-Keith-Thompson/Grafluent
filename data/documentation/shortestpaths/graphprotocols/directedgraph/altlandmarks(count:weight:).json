{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"abstract":[{"text":"ALT landmarks over the graph with these weights, for repeated shortest-path queries","type":"text"},{"text":" ","type":"text"},{"text":"between arbitrary pairs of vertices by A* search.","type":"text"}],"metadata":{"remoteSource":{"fileName":"ALTLandmarks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ALTLandmarks.swift#L348"},"title":"altLandmarks(count:weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"altLandmarks","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths12ALTLandmarksV","text":"ALTLandmarks","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols08DirectedA0P13ShortestPathsE12altLandmarks5count6weightAD12ALTLandmarksVyxqd__GSi_qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__lF","modules":[{"name":"ShortestPaths","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","role":"symbol","symbolKind":"method"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"altLandmarks","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 8, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ALTLandmarks","preciseIdentifier":"s:13ShortestPaths12ALTLandmarksV","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"How many landmarks to choose, at most the vertex count.","type":"text"}],"type":"paragraph"}],"name":"count"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}],"name":"weight"}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"count"},{"type":"text","text":" landmarks are chosen farthest from one another (the first farthest from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, each next one farthest from those chosen, a vertex no landmark reaches first), and"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra’s algorithm runs from and to each; the build is 2 × "},{"type":"codeVoice","code":"count"},{"type":"text","text":" searches over the"},{"type":"text","text":" "},{"type":"text","text":"graph. More landmarks give tighter estimates and cost more memory, two distances per"},{"type":"text","text":" "},{"type":"text","text":"landmark and vertex. Parallel edges count by their cheapest; self-loops are ignored."},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge and the weights are kept."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(count (n + m) log n), plus O(n + m) to copy the arcs."}]}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every weight is at least "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" and not NaN; every sum fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is at least zero."}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/altLandmarks(count:weight:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/altlandmarks(count:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/ALTLandmarks":{"role":"symbol","abstract":[{"type":"text","text":"Landmarks for A* search by the ALT method (Goldberg and Harrelson, “Computing the shortest"},{"type":"text","text":" "},{"type":"text","text":"path: A* search meets graph theory”, SODA 2005): a few vertices chosen far apart, the distance"},{"type":"text","text":" "},{"type":"text","text":"from and to each of them stored for every vertex, and each query an A* search whose estimate of"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s remaining distance is the largest lower bound the triangle inequality gives from"},{"type":"text","text":" "},{"type":"text","text":"any landmark, "},{"type":"codeVoice","code":"d(L, t) − d(L, v)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"d(v, L) − d(t, L)"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ALTLandmarks"}],"url":"\/documentation\/shortestpaths\/altlandmarks","kind":"symbol","title":"ALTLandmarks","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks","navigatorTitle":[{"kind":"identifier","text":"ALTLandmarks"}],"type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/altLandmarks(count:weight:)":{"type":"topic","abstract":[{"text":"ALT landmarks over the graph with these weights, for repeated shortest-path queries","type":"text"},{"text":" ","type":"text"},{"text":"between arbitrary pairs of vertices by A* search.","type":"text"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/altLandmarks(count:weight:)","url":"\/documentation\/sh