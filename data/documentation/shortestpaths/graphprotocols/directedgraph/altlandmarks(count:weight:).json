en far apart, the distance"},{"type":"text","text":" "},{"type":"text","text":"from and to each of them stored for every vertex, and each query an A* search whose estimate of"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s remaining distance is the largest lower bound the triangle inequality gives from"},{"type":"text","text":" "},{"type":"text","text":"any landmark, "},{"type":"codeVoice","code":"d(L, t) − d(L, v)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"d(v, L) − d(t, L)"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/shortestpaths\/altlandmarks","title":"ALTLandmarks"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"abstract":[],"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","title":"GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/shortestpaths\/graphprotocols"}}}