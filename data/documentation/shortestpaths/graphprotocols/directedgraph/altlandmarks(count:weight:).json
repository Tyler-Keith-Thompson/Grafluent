/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"altLandmarks"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"count"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 8, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks","preciseIdentifier":"s:13ShortestPaths12ALTLandmarksV","kind":"typeIdentifier","text":"ALTLandmarks"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"count","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How many landmarks to choose, at most the vertex count."}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"count"},{"type":"text","text":" landmarks are chosen farthest from one another (the first farthest from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, each next one farthest from those chosen, a vertex no landmark reaches first), and"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra’s algorithm runs from and to each; the build is 2 × "},{"type":"codeVoice","code":"count"},{"type":"text","text":" searches over the"},{"type":"text","text":" "},{"type":"text","text":"graph. More landmarks give tighter estimates and cost more memory, two distances per"},{"type":"text","text":" "},{"type":"text","text":"landmark and vertex. Parallel edges count by their cheapest; self-loops are ignored."},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge and the weights are kept."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(count (n + m) log n), plus O(n + m) to copy the arcs."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is at least "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" and not NaN; every sum fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"count"},{"type":"text","text":" is at least zero."}]}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/altlandmarks(count:weight:)"]}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/altLandmarks(count:weight:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://ShortestPaths/documentation/ShortestPaths":{"url":"\/documentation\/shortestpaths","kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","title":"ShortestPaths","abstract":[],"type":"topic","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/altLandmarks(count:weight:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"altLandmarks","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths12ALTLandmarksV","text":"ALTLandmarks","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"altLandmarks(count:weight:)","type":"topic","role":"symbol","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/altlandmarks(count:weight:)","abstract":[{"type":"text","text":"ALT landmarks over the graph with these weights, for repeated shortest-path queries"},{"