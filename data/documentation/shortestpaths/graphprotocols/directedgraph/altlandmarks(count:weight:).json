{"abstract":[{"text":"ALT landmarks over the graph with these weights, for repeated shortest-path queries","type":"text"},{"text":" ","type":"text"},{"text":"between arbitrary pairs of vertices by A* search.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"altLandmarks","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 8, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ALTLandmarks","preciseIdentifier":"s:13ShortestPaths12ALTLandmarksV","kind":"typeIdentifier","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"How many landmarks to choose, at most the vertex count.","type":"text"}]}],"name":"count"},{"content":[{"inlineContent":[{"text":"The length of the edge at a position.","type":"text"}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"code":"count","type":"codeVoice"},{"type":"text","text":" landmarks are chosen farthest from one another (the first farthest from the first"},{"type":"text","text":" "},{"type":"text","text":"vertex, each next one farthest from those chosen, a vertex no landmark reaches first), and"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra’s algorithm runs from and to each; the build is 2 × "},{"code":"count","type":"codeVoice"},{"type":"text","text":" searches over the"},{"type":"text","text":" "},{"type":"text","text":"graph. More landmarks give tighter estimates and cost more memory, two distances per"},{"type":"text","text":" "},{"type":"text","text":"landmark and vertex. Parallel edges count by their cheapest; self-loops are ignored."},{"type":"text","text":" "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per edge and the weights are kept."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O(count (n + m) log n), plus O(n + m) to copy the arcs."}],"type":"paragraph"}],"name":"Complexity","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Every weight is at least ","type":"text"},{"code":".zero","type":"codeVoice"},{"text":" and not NaN; every sum fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" is at least zero.","type":"text"}]}],"name":"Precondition","style":"note","type":"aside"}],"kind":"co