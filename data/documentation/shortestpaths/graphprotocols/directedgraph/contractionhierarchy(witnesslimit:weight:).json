{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)"},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"abstract":[{"type":"text","text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path"},{"type":"text","text":" "},{"type":"text","text":"queries between arbitrary pairs of vertices."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contractionHierarchy","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"witnessLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 500, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy","kind":"typeIdentifier","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The vertices a witness search may settle before giving up on ruling a","type":"text"},{"text":" ","type":"text"},{"text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each","type":"text"},{"text":" ","type":"text"},{"text":"contraction then costing more than the last; the default suits road-like and grid","type":"text"},{"text":" ","type":"text"},{"text":"graphs.","type":"text"}]}],"name":"witnessLimit"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The length of the edge at a position.","type":"text"}]}],"name":"weight"}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the","type":"text"},{"text":" ","type":"text"},{"text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already","type":"text"},{"text":" ","type":"text"},{"text":"joins its endpoints at its weight or less, or by a witness search that settles at most","type":"text"},{"text":" ","type":"text"},{"code":"witnessLimit","type":"codeVoice"},{"text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges count by their cheapest; self-loops are ignored. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge","type":"text"},{"text":" ","type":"text"},{"text":"and the weights are kept.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each"},{"type":"text","text":" "},{"type":"text","text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and"},{"type":"text","text":" "},{"type":"text","text":"a small multiple of m on road-like graphs."}]}],"type":"aside","name":"Complexity","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":"Every weight is at least "},{"code":".zero","type":"codeVoice"},{"type":"text","text":" and not NaN; every sum fits in "},{"code":"W","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"code":"witnessLimit","type":"codeVoice"},{"type":"text","text":" is at least zero."}],"type":"paragraph"}],"type":"aside","name":"Precondition","style":"note"}],"kind":"content"}],"metadata":{"externalID":"s:14GraphProtocols08DirectedA0P13ShortestPathsE20contractionHierarchy12witnessLimit6weightAD011ContractionG0Vyxqd__GSi_qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__lF","remoteSource":{"fileName":"ContractionHierarchy.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ContractionHierarchy.swift#L495"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contractionHierarchy","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"witnessLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"ShortestPaths"}],"roleHeading":"Instance Method","role":"symbol","extendedModule":"GraphProtocols","title":"contractionHierarchy(witnessLimit:weight:)","symbolKind":"method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"kind":"symbol","abstract":[{"type":"text","text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:"},{"type":"text","text":" "},{"type":"text","text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its"},{"type":"text","text":" "},{"type":"text","text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding"},{"type":"text","text":" "},{"type":"text","text":"the shortcuts that keep every distance among the vertices still to come, and each query two"},{"type":"text","text":" "},{"type":"text","text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the"},{"type":"text","text":" "},{"type":"text","text":"target backward along arcs from higher-ranked ones, meeting on a shortest path."}],"url":"\/documentation\/shortestpaths\/contractionhierarchy","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContractionHierarchy","kind":"identifier"}],"navigatorTitle":[{"text":"ContractionHierarchy","kind":"identifier"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","title":"ContractionHierarchy"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"type":"topic","abstract":[],"title":"DirectedGraph","kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/contractionHierarchy(witnessLimit:weight:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV"},{"kind":"text","text":"<"},{"kind":"typeIde