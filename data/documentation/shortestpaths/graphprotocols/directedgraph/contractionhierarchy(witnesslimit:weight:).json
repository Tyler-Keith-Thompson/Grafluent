: ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"kind":"symbol","navigatorTitle":[{"text":"ContractionHierarchy","kind":"identifier"}],"title":"ContractionHierarchy","abstract":[{"type":"text","text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:"},{"type":"text","text":" "},{"type":"text","text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its"},{"type":"text","text":" "},{"type":"text","text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding"},{"type":"text","text":" "},{"text":"the shortcuts that keep every distance among the vertices still to come, and each query two","type":"text"},{"text":" ","type":"text"},{"text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the","type":"text"},{"text":" ","type":"text"},{"text":"target backward along arcs from higher-ranked ones, meeting on a shortest path.","type":"text"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","type":"topic","url":"\/documentation\/shortestpaths\/contractionhierarchy","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContractionHierarchy","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","role":"collection","abstract":[],"url":"\/documentation\/shortestpaths\/graphprotocols","kind":"symbol","title":"GraphProtocols","type":"topic"}}}