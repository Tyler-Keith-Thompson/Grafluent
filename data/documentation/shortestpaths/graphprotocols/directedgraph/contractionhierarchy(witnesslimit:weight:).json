{"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contractionHierarchy","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"witnessLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 500, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The vertices a witness search may settle before giving up on ruling a","type":"text"},{"text":" ","type":"text"},{"text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each","type":"text"},{"text":" ","type":"text"},{"text":"contraction then costing more than the last; the default suits road-like and grid","type":"text"},{"text":" ","type":"text"},{"text":"graphs.","type":"text"}]}],"name":"witnessLimit"},{"content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the"},{"type":"text","text":" "},{"type":"text","text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already"},{"type":"text","text":" "},{"type":"text","text":"joins its endpoints at its weight or less, or by a witness search that settles at most"},{"type":"text","text":" "},{"type":"codeVoice","code":"witnessLimit"},{"type":"text","text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges count by their cheapest; self-loops are ignored. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge"},{"type":"text","text":" "},{"type":"text","text":"and the weights are kept."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each"},{"type":"text","text":" "},{"type":"text","text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and"},{"type":"text","text":" "},{"type":"text","text":"a small multiple of m on road-like graphs."}]}],"name":"Complexity"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Every weight is at least ","type":"text"},{"code":".zero","type":"codeVoice"},{"text":" and not NaN; every sum fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"witnessLimit","type":"codeVoice"},{"text":" is at least zero.","type":"text"}]}],"name":"Precondition"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)"},"abstract":[{"type":"text","text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path"},{"type":"text","text":" "},{"type":"text","text":"queries between arbitrary pairs of vertices."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"metadata":{"externalID":"s:14GraphProtocols08DirectedA0P13ShortestPathsE20contractionHierarchy12witnessLimit6weightAD011ContractionG0Vyxqd__GSi_qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__lF","title":"contractionHierarchy(witnessLimit:weight:)","remoteSource":{"fileName":"ContractionHierarchy.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ContractionHierarchy.swift#L495"},"roleHeading":"Instance Method","modules":[{"name":"ShortestPaths","relatedModules":["GraphProtocols"]}],"role":"symbol","extendedModule":"GraphProtocols","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contractionHierarchy","kind":"identifier"},{"text":"<","kind":"text"},{"