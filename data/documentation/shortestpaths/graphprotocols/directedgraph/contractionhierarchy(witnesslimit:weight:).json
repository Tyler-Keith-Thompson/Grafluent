{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","abstract":[{"text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"queries between arbitrary pairs of vertices.","type":"text"}],"variants":[{"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 500, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","kind":"typeIdentifier","text":"ContractionHierarchy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"witnessLimit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices a witness search may settle before giving up on ruling a"},{"type":"text","text":" "},{"type":"text","text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each"},{"type":"text","text":" "},{"type":"text","text":"contraction then costing more than the last; the default suits road-like and grid"},{"type":"text","text":" "},{"type":"text","text":"graphs."}]}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the"},{"type":"text","text":" "},{"type":"text","text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already"},{"type":"text","text":" "},{"type":"text","text":"joins its endpoints at its weight or less, or by a witness search that settles at most"},{"type":"text","text":" "},{"code":"witnessLimit","type":"codeVoice"},{"type":"text","text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges count by their cheapest; self-loops are ignored. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per edge"},{"type":"text","text":" "},{"type":"text","text":"and the weights are kept."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each","type":"text"},{"text":" ","type":"text"},{"text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and","type":"text"},{"text":" ","type":"text"},{"text":"a small multiple of m on road-like graphs.","type":"text"}]}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"Every weight is at least ","type":"text"},{"type":"codeVoice","code":".zero"},{"text":" and not NaN; every sum fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":";","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"witnessLimit"},{"text":" is at least zero.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"metadata":{"extendedModule":"GraphProtocols","title":"contractionHierarchy(witnessLimit:weight:)","roleHeading":"Instance Method","externalID":"s:14GraphProtocols08DirectedA0P13ShortestPathsE20contractionHierarchy12witnessLimit6weightAD011ContractionG0Vyxqd__GSi_qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__lF","symbolKind":"method","remoteSource":{"fileName":"ContractionHierarchy.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ContractionHierarchy.swift#L495"},"modules":[{"relatedModules":["GraphProtocols"],"name":"ShortestPaths"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}]},"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/contractionHierarchy(witnessLimit:weight:)":{"type":"topic","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)","role":"symbol","kind":"symbol","abstract":[{"text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"queries between arbitrary pairs of vertices.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contractionHierarchy","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"witnessLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"contractionHierarchy(witnessLimit:weight:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)"},"doc://ShortestPaths/documentation/ShortestPaths":{"url":"\/documentation\/shortestpaths","kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","title":"ShortestPaths","abstract":[],"type":"topic","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"abstract":[{"text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:","type":"text"},{"text":" ","type":"text"},{"text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its","type":"text"},{"text":" ","type":"text"},{"text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding","type":"text"},{"text":" ","type":"text"},{"text":"the shortcuts that keep every distance among the vertices still to come, and each query two","type":"text"},{"text":" ","type":"text"},{"text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the","type":"text"},{"text":" ","type":"text"},{"text":"target backward along arcs from higher-ranked ones, meeting on a shortest path.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","k