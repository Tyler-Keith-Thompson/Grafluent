seIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","type":"topic","title":"contractionHierarchy(witnessLimit:weight:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)","abstract":[{"type":"text","text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path"},{"type":"text","text":" "},{"type":"text","text":"queries between arbitrary pairs of vertices."}],"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"},"doc://ShortestPaths/documentation/ShortestPaths":{"kind":"symbol","role":"collection","type":"topic","title":"ShortestPaths","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","abstract":[],"url":"\/documentation\/shortestpaths"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"role":"symbol","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","kind":"symbol","title":"DirectedGraph","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContractionHierarchy"}],"role":"symbol","type":"topic","title":"ContractionHierarchy","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","abstract":[{"type":"text","text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:"},{"type":"text","text":" "},{"type":"text","text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its"},{"type":"text","text":" "},{"type":"text","text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding"},{"type":"text","text":" "},{"type":"text","text":"the shortcuts that keep every distance among the vertices still to come, and each query two"},{"type":"text","text":" "},{"type":"text","text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the"},{"type":"text","text":" "},{"type":"text","text":"target backward along arcs from higher-ranked ones, meeting on a shortest path."}],"url":"\/documentation\/shortestpaths\/contractionhierarchy","navigatorTitle":[{"kind":"identifier","text":"ContractionHierarchy"}]},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"role":"collection","abstract":[],"url":"\/documentation\/shortestpaths\/graphprotocols","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","type":"topic"}}}