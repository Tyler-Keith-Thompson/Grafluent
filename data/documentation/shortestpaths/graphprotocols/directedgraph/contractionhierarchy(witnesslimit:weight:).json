{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)"},"abstract":[{"text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"queries between arbitrary pairs of vertices.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 500, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The vertices a witness search may settle before giving up on ruling a","type":"text"},{"text":" ","type":"text"},{"text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each","type":"text"},{"text":" ","type":"text"},{"text":"contraction then costing more than the last; the default suits road-like and grid","type":"text"},{"text":" ","type":"text"},{"text":"graphs.","type":"text"}],"type":"paragraph"}],"name":"witnessLimit"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}],"name":"weight"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the","type":"text"},{"text":" ","type":"text"},{"text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already","type":"text"},{"text":" ","type":"text"},{"text":"joins its endpoints at its weight or less, or by a witness search that settles at most","type":"text"},{"text":" ","type":"text"},{"code":"witnessLimit","type":"codeVoice"},{"text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges count by their cheapest; self-loops are ignored. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge","type":"text"},{"text":" ","type":"text"},{"text":"and the weights are kept.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each","type":"text"},{"text":" ","type":"text"},{"text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and","type":"text"},{"text":" ","type":"text"},{"text":"a small multiple of m on road-like graphs.","type":"text"}]}],"style":"note","type":"aside"},{"name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every weight is at least "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" and not NaN; every sum fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"witnessLimit"},{"type":"text","text":" is at least zero."}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"variants":[{"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:14GraphProtocols08DirectedA0P13ShortestPathsE20contractionHierarchy12witnessLimit6weightAD011ContractionG0Vyxqd__GSi_qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contractionHierarchy","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"witnessLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","roleHeading":"Instance Method","title":"contractionHierarchy(witnessLimit:weight:)","role":"symbol","extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"ShortestPaths"}],"remoteSource":{"fileName":"ContractionHierarchy.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ContractionHierarchy.swift#L495"}},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"title":"Edges","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}]},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/contractionHierarchy(witnessLimit:weight:)":{"role":"symbol","title":"contractionHierarchy(witnessLimit:weight:)","abstract":[{"type":"text","text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path"},{"type":"text","text":" "},{"type":"text","text":"queries between arbitrary pairs of vertices."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","abstract":[],"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"kind":"symbol","title":"DirectedGraph","type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"kind":"symbol","url":"\/documentation\/shortestpaths\/graphprotocols","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","abstract":[],"title":"GraphProtocols","role":"collection","type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"role":"symbol","title":"ContractionHierarchy","abstract":[{"text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:","type":"text"},{"text":" ","type":"text"},{"text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its","type":"text"},{"text":" ","type":"text"},{"text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding","type":"text"},{"text":" ","type":"text"},{"text":"the shortcuts that keep every distance among the vertices still to come, and each query two","type":"text"},{"text":" ","type":"text"},{"text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the","type":"text"},{"text":" ","type":"text"},{"text":"target backward along arcs from higher-ranked ones, meeting on a shortest path.","type":"text"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContractionHierarchy","kind":"identifier"}],"url":"\/documentation\/shortestpaths\/contractionhierarchy","navigatorTitle":[{"text":"ContractionHierarchy","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths":{"type":"topic","kind":"symbol","abstract":[],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","title":"ShortestPaths","url":"\/documentation\/shortestpaths","role":"collection"}}}