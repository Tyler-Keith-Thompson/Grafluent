s20ContractionHierarchyV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"kind":"symbol","abstract":[{"text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"queries between arbitrary pairs of vertices.","type":"text"}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 500, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"witnessLimit","content":[{"inlineContent":[{"text":"The vertices a witness search may settle before giving up on ruling a","type":"text"},{"text":" ","type":"text"},{"text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each","type":"text"},{"text":" ","type":"text"},{"text":"contraction then costing more than the last; the default suits road-like and grid","type":"text"},{"text":" ","type":"text"},{"text":"graphs.","type":"text"}],"type":"paragraph"}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The length of the edge at a position."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the","type":"text"},{"text":" ","type":"text"},{"text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already","type":"text"},{"text":" ","type":"text"},{"text":"joins its endpoints at its weight or less, or by a witness search that settles at most","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"witnessLimit"},{"text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges count by their cheapest; self-loops are ignored. ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is called once per edge","type":"text"},{"text":" ","type":"text"},{"text":"and the weights are kept.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"inlineContent":[{"text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each","type":"text"},{"text":" ","type":"text"},{"text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and","type":"text"},{"text":" ","type":"text"},{"text":"a small multiple of m on road-like graphs.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is at least "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" and not NaN; every sum fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"witnessLimit"},{"type":"text","text":" is at least zero."}]}],"style":"note","type":"aside"}]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/contractionHierarchy(witnessLimit:weight:)":{"role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"queries between arbitrary pairs of vertices.","type":"text"}],"title":"contractionHierarchy(witnessLimit:weight:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"url":"\/documentation\/shortestpaths\/contractionhierarchy","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","navigatorTitle":[{"kind":"identifier","text":"ContractionHierarchy"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContractionHierarchy"}],"title":"ContractionHierarchy","abstract":[{"type":"text","text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:"},{"type":"text","text":" "},{"type":"text","text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its"},{"type":"text","text":" "},{"type":"text","text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding"},{"type":"text","text":" "},{"text":"the shortcuts that keep every distance among the vertices still to come, and each query two","type":"text"},{"text":" ","type":"text"},{"text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the","type":"text"},{"text":" ","type":"text"},{"text":"target backward along arcs from higher-ranked ones, meeting on a shortest path.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"url":"\/documentation\/shortestpaths\/graphprotocols","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","title":"GraphProtocols","abstract":[],"type":"topic","kind":"symbol","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths":{"role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","type":"topic","title":"ShortestPaths","url":"\/documentation\/shortestpaths"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","title":"DirectedGraph","abstract":[],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"role":"symbol","type":"topic","kind":"symbol","title":"Edges","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype"}}}