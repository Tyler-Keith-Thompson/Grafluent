4GraphProtocols08DirectedA0P13ShortestPathsE20contractionHierarchy12witnessLimit6weightAD011ContractionG0Vyxqd__GSi_qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__lF"},"variants":[{"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path"},{"type":"text","text":" "},{"type":"text","text":"queries between arbitrary pairs of vertices."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 500, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}]},{"kind":"parameters","parameters":[{"name":"witnessLimit","content":[{"type":"paragraph","inlineContent":[{"text":"The vertices a witness search may settle before giving up on ruling a","type":"text"},{"text":" ","type":"text"},{"text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each","type":"text"},{"text":" ","type":"text"},{"text":"contraction then costing more than the last; the default suits road-like and grid","type":"text"},{"text":" ","type":"text"},{"text":"graphs.","type":"text"}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"text":"The length of the edge at a position.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the"},{"type":"text","text":" "},{"type":"text","text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already"},{"type":"text","text":" "},{"type":"text","text":"joins its endpoints at its weight or less, or by a witness search that settles at most"},{"type":"text","text":" "},{"type":"codeVoice","code":"witnessLimit"},{"type":"text","text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges count by their cheapest; self-loops are ignored. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge"},{"type":"text","text":" "},{"type":"text","text":"and the weights are kept."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each","type":"text"},{"text":" ","type":"text"},{"text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and","type":"text"},{"text":" ","type":"text"},{"text":"a small multiple of m on road-like graphs.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is at least "},{"type":"codeVoice","code":".zero"},{"type":"text","text":" and not NaN; every sum fits in "},{"type":"codeVoice","code":"W"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"witnessLimit"},{"type":"text","text":" is at least zero."}]}],"name":"Precondition","type":"aside"}]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","role":"symbol","abstract":[],"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","title":"DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","role":"collection","abstract":[],"type":"topic","title":"ShortestPaths","url":"\/documentation\/shortestpaths","kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/contractionHierarchy(witnessLimit:weight:)":{"title":"contractionHierarchy(witnessLimit:weight:)","kind":"symbol","identifier":"d