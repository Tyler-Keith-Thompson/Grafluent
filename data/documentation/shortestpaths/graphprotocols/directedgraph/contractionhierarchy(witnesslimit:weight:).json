"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 500, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","text":"ContractionHierarchy","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The vertices a witness search may settle before giving up on ruling a"},{"type":"text","text":" "},{"type":"text","text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each"},{"type":"text","text":" "},{"type":"text","text":"contraction then costing more than the last; the default suits road-like and grid"},{"type":"text","text":" "},{"type":"text","text":"graphs."}],"type":"paragraph"}],"name":"witnessLimit"},{"content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}],"name":"weight"}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the"},{"type":"text","text":" "},{"type":"text","text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already"},{"type":"text","text":" "},{"type":"text","text":"joins its endpoints at its weight or less, or by a witness search that settles at most"},{"type":"text","text":" "},{"type":"codeVoice","code":"witnessLimit"},{"type":"text","text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel"},{"type":"text","text":" "},{"type":"text","text":"edges count by their cheapest; self-loops are ignored. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per edge"},{"type":"text","text":" "},{"type":"text","text":"and the weights are kept."}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each","type":"text"},{"text":" ","type":"text"},{"text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and","type":"text"},{"text":" ","type":"text"},{"text":"a small multiple of m on road-like graphs.","type":"text"}]}]},{"name":"Precondition","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Every weight is at least ","type":"text"},{"type":"codeVoice","code":".zero"},{"text":" and not NaN; every sum fits in ","type":"text"},{"type":"codeVoice","code":"W"},{"text":";","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"witnessLimit"},{"text":" is at least zero.","type":"text"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)"]}],"sections":[],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph/contractionHierarchy(witnessLimit:weight:)":{"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/contractionHierarchy(witnessLimit:weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"witnessLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV","text":"ContractionHierarchy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path"},{"type":"text","text":" "},{"type":"text","text":"queries between arbitrary pairs of vertices."}],"type":"topic","role":"symbol","title":"contractionHierarchy(witnessLimit:weight:)","kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"abstract":[],"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","title":"GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/shortestpaths\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sl","kind":"typeIdentifier","text":"Collection"}],"type":"topic","title":"Edges","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","role":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContractionHierarchy"}],"navigatorTitle":[{"text":"ContractionHierarchy","kind":"identifier"}],"abstract":[{"text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:","type":"text"},{"text":" ","type":"text"},{"text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its","type":"text"},{"text":" ","type":"text"},{"text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the shortcuts that keep every distance among the vertices still to come, and each query two"},{"type":"text","text":" "},{"type":"text","text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the"},{"type":"text","text":" "},{"type":"text","text":"target backward along arcs from higher-ranked ones, meeting on a shortest path."}],"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","title":"ContractionHierarchy","kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/contractionhierarchy"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"type":"topic","role":"symbol","title":"DirectedGraph"},"doc://ShortestPaths/documentation/ShortestPaths":{"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/shortestpaths","title":"ShortestPaths"}}}