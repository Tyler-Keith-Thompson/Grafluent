"keyword"},{"text":" ","kind":"text"},{"text":"contractionHierarchy","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"witnessLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ContractionHierarchy","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://ShortestPaths/documentation/ShortestPaths":{"abstract":[],"role":"collection","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","type":"topic","kind":"symbol","title":"ShortestPaths","url":"\/documentation\/shortestpaths"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","abstract":[],"role":"symbol","title":"DirectedGraph","kind":"symbol","type":"topic","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","type":"topic","kind":"symbol","title":"Edges","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"abstract":[{"text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:","type":"text"},{"text":" ","type":"text"},{"text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its","type":"text"},{"text":" ","type":"text"},{"text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding","type":"text"},{"text":" ","type":"text"},{"text":"the shortcuts that keep every distance among the vertices still to come, and each query two","type":"text"},{"text":" ","type":"text"},{"text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the","type":"text"},{"text":" ","type":"text"},{"text":"target backward along arcs from higher-ranked ones, meeting on a shortest path.","type":"text"}],"navigatorTitle":[{"text":"ContractionHierarchy","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContractionHierarchy","kind":"identifier"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","type":"topic","kind":"symbol","title":"ContractionHierarchy","url":"\/documentation\/shortestpaths\/contractionhierarchy"}}}