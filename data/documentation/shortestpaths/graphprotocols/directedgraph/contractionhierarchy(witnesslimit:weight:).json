d":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"witnessLimit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices a witness search may settle before giving up on ruling a"},{"type":"text","text":" "},{"type":"text","text":"shortcut out. A budget too small for the graph’s structure lets shortcuts pile up, each"},{"type":"text","text":" "},{"type":"text","text":"contraction then costing more than the last; the default suits road-like and grid"},{"type":"text","text":" "},{"type":"text","text":"graphs."}]}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"The length of the edge at a position."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Building it contracts every vertex, each contraction adding the shortcuts that keep the","type":"text"},{"text":" ","type":"text"},{"text":"distances among the vertices still to come; a shortcut is ruled out by an arc that already","type":"text"},{"text":" ","type":"text"},{"text":"joins its endpoints at its weight or less, or by a witness search that settles at most","type":"text"},{"text":" ","type":"text"},{"code":"witnessLimit","type":"codeVoice"},{"text":" vertices, so a smaller limit builds faster and adds more shortcuts. Parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges count by their cheapest; self-loops are ignored. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge","type":"text"},{"text":" ","type":"text"},{"text":"and the weights are kept.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(n log n + m) plus the witness searches, O(witnessLimit · log n) for each","type":"text"},{"text":" ","type":"text"},{"text":"pair of arcs through a contracted vertex; the shortcuts are O(n²) in the worst case and","type":"text"},{"text":" ","type":"text"},{"text":"a small multiple of m on road-like graphs.","type":"text"}]}],"name":"Complexity","style":"note"},{"type":"aside","content":[{"inlineContent":[{"text":"Every weight is at least ","type":"text"},{"code":".zero","type":"codeVoice"},{"text":" and not NaN; every sum fits in ","type":"text"},{"code":"W","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"witnessLimit","type":"codeVoice"},{"text":" is at least zero.","type":"text"}],"type":"paragraph"}],"name":"Precondition","style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"queries between arbitrary pairs of vertices.","type":"text"}],"metadata":{"modules":[{"name":"ShortestPaths","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contractionHierarchy"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"witnessLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"