text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ContractionHierarchy","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths20ContractionHierarchyV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"contractionHierarchy(witnessLimit:weight:)","type":"topic","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/contractionhierarchy(witnesslimit:weight:)","abstract":[{"type":"text","text":"A contraction hierarchy over the graph with these weights, for repeated shortest-path"},{"type":"text","text":" "},{"type":"text","text":"queries between arbitrary pairs of vertices."}]},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","url":"\/documentation\/shortestpaths\/graphprotocols","title":"GraphProtocols","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContractionHierarchy","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ContractionHierarchy"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","abstract":[{"text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:","type":"text"},{"text":" ","type":"text"},{"text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its","type":"text"},{"text":" ","type":"text"},{"text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding","type":"text"},{"text":" ","type":"text"},{"text":"the shortcuts that keep every distance among the vertices still to come, and each query two","type":"text"},{"text":" ","type":"text"},{"text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the","type":"text"},{"text":" ","type":"text"},{"text":"target backward along arcs from higher-ranked ones, meeting on a shortest path.","type":"text"}],"kind":"symbol","title":"ContractionHierarchy","url":"\/documentation\/shortestpaths\/contractionhierarchy","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","abstract":[],"kind":"symbol","title":"Edges","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","role":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths":{"abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","url":"\/documentation\/shortestpaths","title":"ShortestPaths","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"title":"DirectedGraph","type":"topic","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[]}}}