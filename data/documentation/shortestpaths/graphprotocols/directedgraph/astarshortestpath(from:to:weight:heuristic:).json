e","code":"AStarShortestPath"},{"type":"text","text":", NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"astar_path"},{"type":"text","text":"), guided by "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":", an estimate of each vertex’s distance to "},{"type":"codeVoice","code":"target"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when "},{"type":"codeVoice","code":"target"},{"type":"text","text":" is not reachable. The result is as for "},{"type":"codeVoice","code":"dijkstraShortestPath"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph\/aStarShortestPath(from:to:weight:heuristic:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/astarshortestpath(from:to:weight:heuristic:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph"]]},"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","role":"symbol","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","title":"Vertex","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/