ortestPath(from:to:weight:)","type":"codeVoice"},{"text":"; no estimate is NaN.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Precondition"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"A shortest path from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":" by A* (JGraphT’s "},{"type":"codeVoice","code":"AStarShortestPath"},{"type":"text","text":", NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"astar_path"},{"type":"text","text":"), guided by "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":", an estimate of each vertex’s distance to "},{"type":"codeVoice","code":"target"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when "},{"type":"codeVoice","code":"target"},{"type":"text","text":" is not reachable. The result is as for "},{"type":"codeVoice","code":"dijkstraShortestPath"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/shortestpaths\/graphprotocols\/directedgraph\/astarshortestpath(from:to:weight:heuristic:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"type":"topic","kind":"symbol","role":"collection","abstract":[],"title":"GraphProtocols","url":"\/documentation\/shortestpaths\/graphprotocols","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols"},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","precise