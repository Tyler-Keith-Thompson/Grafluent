text":"AStarSearch","kind":"typeIdentifier","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearch"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives each edge’s length from its position; ","type":"text"},{"type":"codeVoice","code":"heuristic"},{"text":" estimates a vertex’s","type":"text"},{"text":" ","type":"text"},{"text":"distance to ","type":"text"},{"type":"codeVoice","code":"target"},{"text":". The search keeps both. It calls ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" once each time an edge is","type":"text"},{"text":" ","type":"text"},{"text":"examined, and ","type":"text"},{"type":"codeVoice","code":"heuristic"},{"text":" once per vertex, when it is discovered, never for ","type":"text"},{"type":"codeVoice","code":"target"},{"text":", whose","type":"text"},{"text":" ","type":"text"},{"text":"estimate is zero. With an admissible heuristic the target’s distance when it is examined is","type":"text"},{"text":" ","type":"text"},{"text":"the shortest; see ","type":"text"},{"type":"codeVoice","code":"aStarShortestPath(from:to:weight:heuristic:)"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target","type":"codeVoice"},{"type":"text","text":" are vertices. While iterating: every examined weight"},{"type":"text","text":" "},{"type":"text","text":"is at least "},{"code":".zero","type":"codeVoice"},{"type":"text","text":" and not NaN, no estimate is NaN, and the sums fit in "},{"code":"W","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O((V + E) log V) to iterate every event with a consistent heuristic, as for","type":"text"},{"text":" ","type":"text"},{"code":"aStarShortestPath","type":"codeVoice"},{"text":"; O(V) to make the search and each iterator.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/shortestpaths\/graphprotocols","type":"topic","title":"GraphProtocols"},"doc://ShortestPaths/documentation/ShortestPaths/AStarSearch":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearch","abstract":[{"text":"A* as a sequence of ","type":"text"},{"type":"codeVoice","code":"AStarSearchEvent"},{"text":"s, pulled one at a time. It holds a copy of the graph,","type":"text"},{"text":" ","type":"text"},{"text":"the weight closure and the heuristic, so later changes to the original do not affect it, and it","type":"text"},{"text":" ","type":"text"},{"text":"can be iterated more than once. It reads rows as ","type":"text"},{"type":"codeVoice","code":"DijkstraSearch"},{"text":" does.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/astarsearch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AStarSearch","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"AStarSearch","kind":"