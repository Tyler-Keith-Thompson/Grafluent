{"abstract":[{"type":"text","text":"Best paths from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" over a selective semiring by Bellman–Ford, which allows weights"},{"type":"text","text":" "},{"type":"text","text":"better than "},{"type":"codeVoice","code":".one"},{"type":"text","text":" (negative tropical weights), or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when a cycle whose product is"},{"type":"text","text":" "},{"type":"text","text":"better than "},{"type":"codeVoice","code":".one"},{"type":"text","text":" is reachable from "},{"type":"codeVoice","code":"source"},{"type":"text","text":". Such a cycle is a negative cycle in the"},{"type":"text","text":" "},{"type":"text","text":"tropical semiring and cannot exist in the bottleneck or Boolean ones. A vertex is reached"},{"type":"text","text":" "},{"type":"text","text":"exactly when its distance is not "},{"type":"codeVoice","code":".zero"},{"type":"text","text":". O(VE) in the worst case; about one pass when no"},{"type":"text","text":" "},{"type":"text","text":"weight is better than "},{"type":"codeVoice","code":".one"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bellmanFordShortestPaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"