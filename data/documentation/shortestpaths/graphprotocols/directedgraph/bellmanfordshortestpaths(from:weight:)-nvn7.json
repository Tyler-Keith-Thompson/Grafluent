hs from "},{"code":"source","type":"codeVoice"},{"type":"text","text":" over a selective semiring by Bellman–Ford, which allows weights"},{"type":"text","text":" "},{"type":"text","text":"better than "},{"code":".one","type":"codeVoice"},{"type":"text","text":" (negative tropical weights), or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when a cycle whose product is"},{"type":"text","text":" "},{"type":"text","text":"better than "},{"code":".one","type":"codeVoice"},{"type":"text","text":" is reachable from "},{"code":"source","type":"codeVoice"},{"type":"text","text":". Such a cycle is a negative cycle in the"},{"type":"text","text":" "},{"type":"text","text":"tropical semiring and cannot exist in the bottleneck or Boolean ones. A vertex is reached"},{"type":"text","text":" "},{"type":"text","text":"exactly when its distance is not "},{"code":".zero","type":"codeVoice"},{"type":"text","text":". O(VE) in the worst case; about one pass when no"},{"type":"text","text":" "},{"type":"text","text":"weight is better than "},{"code":".one","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","references":{"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols/DirectedGraph":{"type":"topic","role":"symbol","url":"\/documentation\/shortestpaths\/graphprotocols\/directedgraph","abstract":[],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"kind":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"role":"collection","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","kind":"symbol","url":"\/documentation\/shortestpaths\/graphprotocols","title":"GraphProtocols","abstract":[],"t