aths/ContractionHierarchy":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ContractionHierarchy"}],"role":"symbol","type":"topic","title":"ContractionHierarchy","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","abstract":[{"type":"text","text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:"},{"type":"text","text":" "},{"type":"text","text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its"},{"type":"text","text":" "},{"type":"text","text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding"},{"type":"text","text":" "},{"type":"text","text":"the shortcuts that keep every distance among the vertices still to come, and each query two"},{"type":"text","text":" "},{"type":"text","text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the"},{"type":"text","text":" "},{"type":"text","text":"target backward along arcs from higher-ranked ones, meeting on a shortest path."}],"url":"\/documentation\/shortestpaths\/contractionhierarchy","navigatorTitle":[{"kind":"identifier","text":"ContractionHierarchy"}]},"doc://ShortestPaths/documentation/ShortestPaths":{"kind":"symbol","role":"collection","type":"topic","title":"ShortestPaths","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","abstract":[],"url":"\/documentation\/shortestpaths"}}}