{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"symbol","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"}],"title":"ShortestPathTree","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L26","fileName":"ShortestPathTree.swift"},"externalID":"s:13ShortestPaths0A8PathTreeV","modules":[{"name":"ShortestPaths"}],"navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"],"anchor":"Instance-Methods","title":"Instance Methods"}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/shortestpaths\/shortestpathtree"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree"},{"type":"text","text":" "},{"type":"text","text":"(forest)”)."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ties.","type":"text"}]},{"type":"text","text":" The first relaxation to a vertex’s final distance wins. So "},{"type":"codeVoice","code":"parent(of: v)"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"shortest-path predecessor of "},{"type":"codeVoice","code":"v"},{"type":"text","text":" settled first. Vertices at equal distance settle in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order, so when several vertices at the same smallest distance lead to "},{"type":"codeVoice","code":"v"},{"type":"text","text":" along"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,"},{"type":"text","text":" "},{"type":"text","text":"the parent edge is the cheapest, and the first in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" order among equals."}],"type":"paragraph"},{"inlineContent":[{"text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation","type":"text"},{"text":" ","type":"text"},{"text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies","type":"text"},{"text":" ","type":"text"},{"text":"it; a tree of a graph about to change should be read and dropped first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Several sources.","type":"text"}]},{"type":"text","text":" Each source starts at distance zero with no parent. Dijkstra’s algorithm"},{"type":"text","text":" "},{"type":"text","text":"and breadth-first search never improve on that, so a source keeps no parent even when another"},{"type":"text","text":" "},{"type":"text","text":"source reaches it. Bellman–Ford treats the sources as one super-source (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"_bellman_ford"},{"type":"text","text":"): a negative path from one source to another improves the second, which then"},{"type":"text","text":" "},{"type":"text","text":"has that distance, a parent and a path from the first."}],"type":"paragraph"},{"inlineContent":[{"text":"Not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":": two correct trees can choose different parents on ties.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree":{"url":"\/documentation\/shortestpaths\/shortestpathtree","abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree"},{"type":"text","text":" "},{"type":"text","text":"(forest)”)."}],"type":"topic","title":"ShortestPathTree","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","navigatorTitle":[{"text":"ShortestPathTree","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"}],"kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree/hasPath(to:)":{"url":"\/documentation\/shortestpaths\/shortestpathtree\/haspath(to:)","abstract":[{"text":"Whether a path from a source reaches ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Shortest