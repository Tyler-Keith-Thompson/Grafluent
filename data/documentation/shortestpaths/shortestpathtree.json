{"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"}],"navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"externalID":"s:13ShortestPaths0A8PathTreeV","modules":[{"name":"ShortestPaths"}],"title":"ShortestPathTree","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L29","fileName":"ShortestPathTree.swift"},"symbolKind":"struct"},"kind":"symbol","sections":[],"topicSections":[{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"variants":[{"paths":["\/documentation\/shortestpaths\/shortestpathtree"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and","type":"text"},{"text":" ","type":"text"},{"text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(forest)”)."}],"relationshipsSections":[{"identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier","text":"DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ties.","type":"text"}]},{"type":"text","text":" The first relaxation to a vertex’s final distance wins. So "},{"type":"codeVoice","code":"parent(of: v)"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"shortest-path predecessor of "},{"type":"codeVoice","code":"v"},{"type":"text","text":" settled first. Vertices at equal distance settle in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order, so when several vertices at the same smallest distance lead to "},{"type":"codeVoice","code":"v"},{"type":"text","text":" along"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,"},{"type":"text","text":" "},{"type":"text","text":"the parent edge is the cheapest, and the first in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" order among equals."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Several sources.","type":"text"}]},{"text":" Each source starts at distance zero (","type":"text"},{"type":"codeVoice","code":".one"},{"text":" over a semiring) with no parent. Dijkstra’s algorithm","type":"text"},{"text":" ","type":"text"},{"text":"and breadth-first search never improve on that, so a source keeps no parent even when another","type":"text"},{"text":" ","type":"text"},{"text":"source reaches it. Bellman–Ford treats the sources as one super-source (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_bellman_ford"},{"text":"): a negative path from one source to another improves the second, which then","type":"text"},{"text":" ","type":"text"},{"text":"has that distance, a parent and a path from the first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Semirings."}],"type":"strong"},{"type":"text","text":" Over a "},{"type":"codeVoice","code":"SelectiveSemiring"},{"type":"text","text":" a distance is the ⊗-product of a path’s weights, the"},{"type":"text","text":" "},{"type":"text","text":"best by the natural order "},{"type":"codeVoice","code":"<"},{"type":"text","text":", and a vertex is reached exactly when its distance is not "},{"type":"codeVoice","code":".zero"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":": two correct trees can choose different parents on ties.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree"},"references":{"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree/hasPath(to:)":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasPath"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","abstract":[{"text":"Whether a path from a source reaches ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/shortestpaths\/shortestpathtree\/haspath(to:)","kind":"symbol","title":"hasPath(to:)"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree/parent(of:)":{"abstract":[{"text":"The vertex before ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" on its shortest path, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for a source and for a vertex not","type":"text"},{"text":" ","type":"text"},{"text":"reached. On ties, and on a source that Bellman–Ford reached from another, see the type’s","type":"text"},{"text":" ","type":"text"},{"text":"documentation.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind"