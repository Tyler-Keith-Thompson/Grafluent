:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"metadata":{"title":"ShortestPathTree","externalID":"s:13ShortestPaths0A8PathTreeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"}],"remoteSource":{"fileName":"ShortestPathTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L29"},"roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"ShortestPathTree","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"ShortestPaths"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier","text":"DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The first relaxation to a vertex’s final distance wins. So ","type":"text"},{"code":"parent(of: v)","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"shortest-path predecessor of ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" settled first. Vertices at equal distance settle in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order, so when several vertices at the same smallest distance lead to ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" along","type":"text"},{"text":" ","type":"text"},{"text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,","type":"text"},{"text":" ","type":"text"},{"text":"the parent edge is the cheapest, and the first in ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" order among equals.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation","type":"text"},{"text":" ","type":"text"},{"text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies","type":"text"},{"text":" ","type":"text"},{"text":"it; a tree of a graph about to change should be read and dropped first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"With several sources, each starts at distance zero (","type":"text"},{"type":"codeVoice","code":".one"},{"text":" over a semiring) with no parent.","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra’s algorithm and breadth-first search never improve on that, so a source keeps no","type":"text"},{"text":" ","type":"text"},{"text":"parent even when another source reaches it. Bellman–Ford treats the sources as one","type":"text"},{"text":" ","type":"text"},{"text":"super-source: a negative path from one source to another improves the second, which then","type":"text"},{"text":" ","type":"text"},{"text":"has that distance, a parent and a path from the first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Over a "},{"type":"codeVoice","code":"SelectiveSemiring"},{"type":"text","text":" a distance is the ⊗-product of a path’s weights, the"},{"type":"text","text":" "},{"type":"text","text":"best by the natural order "},{"type":"codeVoice","code":"<"},{"type":"text","text":", and a vertex is reached exactly when its distance is not "},{"type":"codeVoice","code":".zero"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":": two correct trees can choose different parents on ties.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","interfaceLanguage":"swift"},"references":{"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"}],"title":"ShortestPathTree","navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","role":"symbol","url":"\/documentation\/shortestpaths\/shortestpathtree","abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources)."}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"doc://ShortestPaths/documentation/ShortestPaths/Sho