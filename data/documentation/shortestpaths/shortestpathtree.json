{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and","type":"text"},{"text":" ","type":"text"},{"text":"the edge from the parent (a forest when there are several sources).","type":"text"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"metadata":{"role":"symbol","symbolKind":"struct","externalID":"s:13ShortestPaths0A8PathTreeV","navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"modules":[{"name":"ShortestPaths"}],"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"}],"title":"ShortestPathTree","remoteSource":{"fileName":"ShortestPathTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L29"}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/shortestpathtree"]}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The first relaxation to a vertex’s final distance wins. So ","type":"text"},{"code":"parent(of: v)","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"shortest-path predecessor of ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" settled first. Vertices at equal distance settle in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order, so when several vertices at the same smallest distance lead to ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" along","type":"text"},{"text":" ","type":"text"},{"text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,","type":"text"},{"text":" ","type":"text"},{"text":"the parent edge is the cheapest, and the first in ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" order among equals.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}]},{"type":"paragraph","inlineContent":[{"text":"With several sources, each starts at distance zero (","type":"text"},{"code":".one","type":"codeVoice"},{"text":" over a semiring) with no parent.","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra’s algorithm and breadth-first search never improve on that, so a source keeps no","type":"text"},{"text":" ","type":"text"},{"text":"parent even when another source reaches it. Bellman–Ford treats the sources as one","type":"text"},{"text":" ","type":"text"},{"text":"super-source: a negative path from one source to another improves the second, which then","type":"text"},{"text":" ","type":"text"},{"text":"has that distance, a parent and a path from the first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Over a ","type":"text"},{"code":"SelectiveSemiring","type":"codeVoice"},{"text":" a distance is the ⊗-product of a path’s weights, the","type":"text"},{"text":" ","type":"text"},{"text":"best by the natural order ","type":"text"},{"code":"<","type":"codeVoice"},{"text":", and a vertex is reached exactly when its distance is not ","type":"text"},{"code":".zero","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":": two correct trees can choose different parents on ties.","type":"text"}]}],"kind":"content"}],"topicSections":[{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(checkedTo:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(checkedTo:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(checked:)","doc:\/\/Sh