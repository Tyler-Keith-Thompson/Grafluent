{"sections":[],"abstract":[{"text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and","type":"text"},{"text":" ","type":"text"},{"text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree","type":"text"},{"text":" ","type":"text"},{"text":"(forest)”).","type":"text"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"],"title":"Instance Methods","anchor":"Instance-Methods"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/shortestpathtree"]}],"relationshipsSections":[{"identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"metadata":{"role":"symbol","title":"ShortestPathTree","symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"}],"externalID":"s:13ShortestPaths0A8PathTreeV","navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"remoteSource":{"fileName":"ShortestPathTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L29"},"modules":[{"name":"ShortestPaths"}]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ties."}]},{"text":" The first relaxation to a vertex’s final distance wins. So ","type":"text"},{"code":"parent(of: v)","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"shortest-path predecessor of ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" settled first. Vertices at equal distance settle in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order, so when several vertices at the same smallest distance lead to ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" along","type":"text"},{"text":" ","type":"text"},{"text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,","type":"text"},{"text":" ","type":"text"},{"text":"the parent edge is the cheapest, and the first in ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" order among equals.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Several sources.","type":"text"}]},{"text":" Each source starts at distance zero (","type":"text"},{"type":"codeVoice","code":".one"},{"text":" over a semiring) with no parent. Dijkstra’s algorithm","type":"text"},{"text":" ","type":"text"},{"text":"and breadth-first search never improve on that, so a source keeps no parent even when another","type":"text"},{"text":" ","type":"text"},{"text":"source reaches it. Bellman–Ford treats the sources as one super-source (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_bellman_ford"},{"text":"): a negative path from one source to another improves the second, which then","type":"text"},{"text":" ","type":"text"},{"text":"has that distance, a parent and a path from the first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Semirings."}],"type":"strong"},{"text":" Over a ","type":"text"},{"code":"SelectiveSemiring","type":"codeVoice"},{"text":" a distance is the ⊗-product of a path’s weights, the","type":"text"},{"text":" ","type":"text"},{"text":"best by the natural order ","type":"text"},{"code":"<","type":"codeVoice"},{"text":", and a vertex is reached exactly when its distance is not ","type":"text"},{"code":".zero","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":": two correct trees can choose different parents on ties.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"references":{"doc://ShortestPaths/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://ShortestPaths/documentation/ShortestPaths":{"title":"ShortestPaths","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","url":"\/documentation\/shortestpaths","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"}],"navigatorTitle":[{"text":"ShortestPathTree","kind":"identifier"}],"title":"ShortestPathTree","abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree"},{"type":"text","text":" "},{"type":"text","text":"(forest)”)."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","url":"\/documentation\/shortestpaths\/shortestpathtree","role":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree/path(to:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"path","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"G","kind":"typeIdentifier"},