{"topicSections":[{"anchor":"Instance-Properties","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"generated":true,"title":"Instance Properties"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"],"generated":true,"title":"Instance Methods"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ties.","type":"text"}]},{"text":" The first relaxation to a vertex’s final distance wins. So ","type":"text"},{"code":"parent(of: v)","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"shortest-path predecessor of ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" settled first. Vertices at equal distance settle in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order, so when several vertices at the same smallest distance lead to ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" along","type":"text"},{"text":" ","type":"text"},{"text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,","type":"text"},{"text":" ","type":"text"},{"text":"the parent edge is the cheapest, and the first in ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" order among equals.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Several sources."}],"type":"strong"},{"type":"text","text":" Each source starts at distance zero with no parent. Dijkstra’s algorithm"},{"type":"text","text":" "},{"type":"text","text":"and breadth-first search never improve on that, so a source keeps no parent even when another"},{"type":"text","text":" "},{"type":"text","text":"source reaches it. Bellman–Ford treats the sources as one super-source (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"_bellman_ford"},{"type":"text","text":"): a negative path from one source to another improves the second, which then"},{"type":"text","text":" "},{"type":"text","text":"has that distance, a parent and a path from the first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":": two correct trees can choose different parents on ties."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L26","fileName":"ShortestPathTree.swift"},"role":"symbol","modules":[{"name":"ShortestPaths"}],"symbolKind":"struct","roleHeading":"Structure","externalID":"s:13ShortestPaths0A8PathTreeV","title":"ShortestPathTree","navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"}]},"kind":"symbol","identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree"},{"type":"text","text":" "},{"type":"text","text":"(forest)”)."}],"variants":[{"paths":["\/documentation\/shortestpaths\/shortestpathtree"],"traits":[{"interfaceL