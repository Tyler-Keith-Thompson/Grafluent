{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree"},{"type":"text","text":" "},{"type":"text","text":"(forest)”)."}],"metadata":{"remoteSource":{"fileName":"ShortestPathTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L29"},"externalID":"s:13ShortestPaths0A8PathTreeV","symbolKind":"struct","navigatorTitle":[{"text":"ShortestPathTree","kind":"identifier"}],"title":"ShortestPathTree","role":"symbol","modules":[{"name":"ShortestPaths"}],"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ShortestPathTree","kind":"identifier"}]},"kind":"symbol","topicSections":[{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ties."}]},{"type":"text","text":" The first relaxation to a vertex’s final distance wins. So "},{"type":"codeVoice","code":"parent(of: v)"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"shortest-path predecessor of "},{"type":"codeVoice","code":"v"},{"type":"text","text":" settled first. Vertices at equal distance settle in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order, so when several vertices at the same smallest distance lead to "},{"type":"codeVoice","code":"v"},{"type":"text","text":" along"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,"},{"type":"text","text":" "},{"type":"text","text":"the parent edge is the cheapest, and the first in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" order among equals."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Several sources.","type":"text"}],"type":"strong"},{"text":" Each source starts at distance zero (","type":"text"},{"code":".one","type":"codeVoice"},{"text":" over a semiring) with no parent. Dijkstra’s algorithm","type":"text"},{"text":" ","type":"text"},{"text":"and breadth-first search never improve on that, so a source keeps no parent even when another","type":"text"},{"text":" ","type":"text"},{"text":"source reaches it. Bellman–Ford treats the sources as one super-source (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"_bellman_ford","type":"codeVoice"},{"text":"): a negative path from one source to another improves the second, which then","type":"text"},{"text":" ","type":"text"},{"text":"has that distance, a parent and a path from the first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Semirings."}]},{"type":"text","text":" Over a "},{"type":"codeVoice","code":"SelectiveSemiring"},{"type":"text","text":" a distance is the ⊗-product of a path’s weights, the"},{"type":"text","text":" "},{"type":"text","text":"best by the natural order "},{"type":"codeVoice","code":"<"},{"type":"text","text":", and a vertex is reached exactly when its distance is not "},{"type":"codeVoice","code":".zero"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Not "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":": two correct trees can choose different parents on ties."}],"type":"paragraph"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/shortestpathtree"]}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"type":"conformsTo"}],"references":{"doc://ShortestPaths/s8SendableP":{"identifier":"doc:\/\/ShortestPaths\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://ShortestPaths/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/ShortestPaths\/s16SendableMetatypeP"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree/distance(to:)":{"title":"distance(to:)","url":"\/documentation\/shortestpaths\/shortestpathtree\/distance(to:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","abstract":[{"type":"text","text":"The length of a shortest path from a source to "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no path reaches it"},{"type":"text","text":" "},{"text":"(or every path is longer than the cutoff).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"distance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree/hasPath(to:)":{"identifier":"doc:\/\/ShortestPat