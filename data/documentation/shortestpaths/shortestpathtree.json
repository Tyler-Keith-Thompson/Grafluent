{"metadata":{"role":"symbol","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"ShortestPaths"}],"title":"ShortestPathTree","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L29","fileName":"ShortestPathTree.swift"},"externalID":"s:13ShortestPaths0A8PathTreeV","navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/shortestpathtree"]}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(checkedTo:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(checkedTo:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(checked:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(checked:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(checkedTo:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"],"generated":true}],"abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources)."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}]},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The first relaxation to a vertex’s final distance wins. So ","type":"text"},{"code":"parent(of: v)","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"shortest-path predecessor of ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" settled first. Vertices at equal distance settle in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order, so when several vertices at the same smallest distance lead to ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" along","type":"text"},{"text":" ","type":"text"},{"text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,","type":"text"},{"text":" ","type":"text"},{"text":"the parent edge is the cheapest, and the first in ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" order among equals.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With several sources, each starts at distance zero ("},{"code":".one","type":"codeVoice"},{"type":"text","text":" over a semiring) with no parent."},{"type":"text","text":" "},{"type":"text","text":"Dijkstra’s algorithm and breadth-first search never improve on that, so a source keeps no"},{"type":"text","text":" "},{"type":"text","text":"parent even when another source reaches it. Bellman–Ford treats the sources as one"},{"type":"text","text":" "},{"type":"text","text":"super-source: a negative path from one source to another improves the second, which then"},{"type":"text","text":" "},{"type":"text","text":"has that distance, a parent and a path from the first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Over a "},{"type":"codeVoice","code":"SelectiveSemiring"},{"type":"text","text":" a distance is the ⊗-product of a path’s weights, the"},{"type":"text","text":" "},{"type":"text","text":"best by the natural order "},{"type":"codeVoice","code":"<"},{"type":"text","text":", and a vertex is reached exactly when its distance is not "},{"type":"codeVoice","code":".zero"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":": two correct trees can choose different parents on ties.","type":"text"}]}],"kind":"content"}],"references":{"doc://ShortestPaths/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s16SendableMetatypeP"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree/distance(checkedTo:)":{"title":"distance(checkedTo:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(checkedTo:)","abstract":[{"code":"distance(to: vertex)","type":"codeVoice"},{"text":", throwing instead of trapping when ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" is not a vertex of the","type":"text"},{"text":" ","type":"text"},{"text":"graph: nil still means no path reaches it.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"distance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checkedTo"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":"?"}],"url":"\/documentation\/short