{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree"},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"],"anchor":"Instance-Methods","generated":true}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree"},{"type":"text","text":" "},{"type":"text","text":"(forest)”)."}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ties.","type":"text"}]},{"type":"text","text":" The first relaxation to a vertex’s final distance wins. So "},{"type":"codeVoice","code":"parent(of: v)"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"shortest-path predecessor of "},{"type":"codeVoice","code":"v"},{"type":"text","text":" settled first. Vertices at equal distance settle in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order, so when several vertices at the same smallest distance lead to "},{"type":"codeVoice","code":"v"},{"type":"text","text":" along"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,"},{"type":"text","text":" "},{"type":"text","text":"the parent edge is the cheapest, and the first in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" order among equals."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Several sources."}]},{"type":"text","text":" Each source starts at distance zero with no parent. Dijkstra’s algorithm"},{"type":"text","text":" "},{"type":"text","text":"and breadth-first search never improve on that, so a source keeps no parent even when another"},{"type":"text","text":" "},{"type":"text","text":"source reaches it. Bellman–Ford treats the sources as one super-source (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"_bellman_ford"},{"type":"text","text":"): a negative path from one source to another improves the second, which then"},{"type":"text","text":" "},{"type":"text","text":"has that distance, a parent and a path from the first."}]},{"type":"paragraph","inlineContent":[{"text":"Not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":": two correct trees can choose different parents on ties.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/shortestpaths\/shortestpathtree"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"struct","modules":[{"name":"ShortestPaths"}],"navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"remoteSource":{"fileName":"ShortestPathTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L26"},"role":"symbol","roleHeading":"Structure","title":"ShortestPathTree","externalID":"s:13ShortestPaths0A8PathTreeV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Shorte