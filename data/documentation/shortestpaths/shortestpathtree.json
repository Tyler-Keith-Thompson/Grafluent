{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parent(ofIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/parentEdge(of:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/path(to:)"],"generated":true,"anchor":"Instance-Methods"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"kind":"relationships"}],"abstract":[{"type":"text","text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and"},{"type":"text","text":" "},{"type":"text","text":"the edge from the parent (a forest when there are several sources, LEMON’s “shortest path tree"},{"type":"text","text":" "},{"type":"text","text":"(forest)”)."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ties."}]},{"type":"text","text":" The first relaxation to a vertex’s final distance wins. So "},{"type":"codeVoice","code":"parent(of: v)"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"shortest-path predecessor of "},{"type":"codeVoice","code":"v"},{"type":"text","text":" settled first. Vertices at equal distance settle in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order, so when several vertices at the same smallest distance lead to "},{"type":"codeVoice","code":"v"},{"type":"text","text":" along"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,"},{"type":"text","text":" "},{"type":"text","text":"the parent edge is the cheapest, and the first in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" order among equals."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Several sources."}]},{"text":" Each source starts at distance zero with no parent. Dijkstra’s algorithm","type":"text"},{"text":" ","type":"text"},{"text":"and breadth-first search never improve on that, so a source keeps no parent even when another","type":"text"},{"text":" ","type":"text"},{"text":"source reaches it. Bellman–Ford treats the sources as one super-source (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_bellman_ford"},{"text":"): a negative path from one source to another improves the second, which then","type":"text"},{"text":" ","type":"text"},{"text":"has that distance, a parent and a path from the first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Not "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":": two correct trees can choose different parents on ties."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Structure","title":"ShortestPathTree","modules":[{"name":"ShortestPaths"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"}],"navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"externalID":"s:13ShortestPaths0A8PathTreeV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L26","fileName":"ShortestPathTree.swift"},"role":"symbol","symbolKind":"struct"},"variants":[{"paths":["\/documentation\/shortestpaths\/shortestpathtree"],"traits"