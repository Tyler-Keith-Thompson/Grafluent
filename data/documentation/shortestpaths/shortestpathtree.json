{"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:13ShortestPaths0A8PathTreeV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L29","fileName":"ShortestPathTree.swift"},"symbolKind":"struct","roleHeading":"Structure","role":"symbol","modules":[{"name":"ShortestPaths"}],"title":"ShortestPathTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"}],"navigatorTitle":[{"text":"ShortestPathTree","kind":"identifier"}]},"sections":[],"abstract":[{"text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and","type":"text"},{"text":" ","type":"text"},{"text":"the edge from the parent (a forest when there are several sources).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestPathTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"The first relaxation to a vertex’s final distance wins. So ","type":"text"},{"code":"parent(of: v)","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"shortest-path predecessor of ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" settled first. Vertices at equal distance settle in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order, so when several vertices at the same smallest distance lead to ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" along","type":"text"},{"text":" ","type":"text"},{"text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,","type":"text"},{"text":" ","type":"text"},{"text":"the parent edge is the cheapest, and the first in ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" order among equals.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation"},{"type":"text","text":" "},{"type":"text","text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies"},{"type":"text","text":" "},{"type":"text","text":"it; a tree of a graph about to change should be read and dropped first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With several sources, each starts at distance zero ("},{"type":"codeVoice","code":".one"},{"type":"text","text":" over a semiring) with no parent."},{"type":"text","text":" "},{"type":"text","text":"Dijkstra’s algorithm and breadth-first search never improve on that, so a source keeps no"},{"type":"text","text":" "},{"type":"text","text":"parent even when another source reaches it. Bellman–Ford treats the sources as one"},{"type":"text","text":" "},{"type":"text","text":"super-source: a negative path from one source to another improves the second, which then"},{"type":"text","text":" "},{"type":"text","text":"has that distance, a parent and a path from the first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Over a "},{"type":"codeVoice","code":"SelectiveSemiring"},{"type":"text","text":" a distance is the ⊗-product of a path’s weights, the"},{"type":"text","text":" "},{"type":"text","text":"best by the natural order "},{"type":"codeVoice","code":"<"},{"type":"text","text":", and a vertex is reached exactly when its distance is not "},{"type":"codeVoice","code":".zero"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Not "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":": two correct trees can choose different parents on ties."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/shortestpathtree"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/sources"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(checkedTo:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/distance(toIndex:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(checkedTo:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/hasPath(to:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree\/p