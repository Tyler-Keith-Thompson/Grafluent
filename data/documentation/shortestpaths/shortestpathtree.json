{"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The first relaxation to a vertex’s final distance wins. So "},{"code":"parent(of: v)","type":"codeVoice"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"shortest-path predecessor of "},{"code":"v","type":"codeVoice"},{"type":"text","text":" settled first. Vertices at equal distance settle in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order, so when several vertices at the same smallest distance lead to "},{"code":"v","type":"codeVoice"},{"type":"text","text":" along"},{"type":"text","text":" "},{"type":"text","text":"shortest paths, which one is the parent is unspecified. Among parallel edges from the parent,"},{"type":"text","text":" "},{"type":"text","text":"the parent edge is the cheapest, and the first in "},{"code":"outEdges(of:)","type":"codeVoice"},{"type":"text","text":" order among equals."}],"type":"paragraph"},{"inlineContent":[{"text":"A tree holds a copy of the graph, so looking a vertex up never hashes on a representation","type":"text"},{"text":" ","type":"text"},{"text":"with cheap vertex indices. While the tree is alive, the next mutation of the original copies","type":"text"},{"text":" ","type":"text"},{"text":"it; a tree of a graph about to change should be read and dropped first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With several sources, each starts at distance zero (","type":"text"},{"type":"codeVoice","code":".one"},{"text":" over a semiring) with no parent.","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra’s algorithm and breadth-first search never improve on that, so a source keeps no","type":"text"},{"text":" ","type":"text"},{"text":"parent even when another source reaches it. Bellman–Ford treats the sources as one","type":"text"},{"text":" ","type":"text"},{"text":"super-source: a negative path from one source to another improves the second, which then","type":"text"},{"text":" ","type":"text"},{"text":"has that distance, a parent and a path from the first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Over a "},{"code":"SelectiveSemiring","type":"codeVoice"},{"type":"text","text":" a distance is the ⊗-product of a path’s weights, the"},{"type":"text","text":" "},{"type":"text","text":"best by the natural order "},{"code":"<","type":"codeVoice"},{"type":"text","text":", and a vertex is reached exactly when its distance is not "},{"code":".zero","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Not "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":": two correct trees can choose different parents on ties."}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"modules":[{"name":"ShortestPaths"}],"remoteSource":{"fileName":"ShortestPathTree.swift","url":"