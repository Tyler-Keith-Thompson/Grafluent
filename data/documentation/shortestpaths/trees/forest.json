ext"},{"text":"Forest","kind":"identifier"}],"title":"Forest","type":"topic","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"code":"trees","type":"codeVoice"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"role":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"type":"topic","kind":"symbol","title":"init(_:)","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]},"abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"code":"Arborescence(_:)","type":"codeVoice"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"text":" ","type":"text"},{"text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k","type":"text"},{"text":" ","type":"text"},{"text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays","type":"text"},{"text":" ","type":"text"},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"text":". The tree holds a copy of its graph, so none is passed, unlike","type":"text"},{"type":"text","text":" "},{"code":"Forest(_:in:)","type":"codeVoice"},{"type":"text","text":" for a spanning forest. O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"ShortestPathTree","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","role":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest":{"url":"\/documentation\/shortestpaths\/trees\/forest","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest","kind":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest","preciseIdentifier":"s:5Trees6ForestV"}],"title":"Forest","type":"topic","abstract":[],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Forest"}]},"doc://ShortestPaths/documentation/ShortestPaths/Trees":{"url":"\/documentation\/shortestpaths\/trees","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees","kind":"symbol","title":"Trees","type":"topic","abstract":[],"role":"collection"}}}