ph’s edge stays","type":"text"},{"text":" ","type":"text"},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"text":". The tree holds a copy of its graph, so none is passed, unlike","type":"text"},{"type":"text","text":" "},{"code":"Forest(_:in:)","type":"codeVoice"},{"type":"text","text":" for a spanning forest. O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<k","type":"codeVoice"},{"text":" in order.","type":"text"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:5Trees6ForestV","text":"Forest"}],"kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest","title":"Forest","abstract":[],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"role":"symbol","url":"\/documentation\/shortestpaths\/trees\/forest"},"doc://ShortestPaths/documentation/ShortestPaths":{"kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","title":"ShortestPaths","abstract":[],"type":"topic","role":"collection","url":"\/documentation\/shortestpaths"},"doc://ShortestPaths/documentation/ShortestPaths/Trees":{"type":"topic","role":"collection","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees","abstract":[],"title":"Trees","kind":"symbol","url":"\/documentation\/shortestpaths\/trees"}}}