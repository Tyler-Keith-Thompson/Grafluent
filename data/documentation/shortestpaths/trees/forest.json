"},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"ShortestPathTree","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}],"role":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","kind":"symbol","title":"init(_:)","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier","preciseIdentifier":"s:5Trees6ForestV"}],"navigatorTitle":[{"text":"Forest","kind":"identifier"}],"abstract":[],"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest","title":"Forest","kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/trees\/forest"},"doc://Trees/documentation/Trees/Forest":{"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"url":"\/documentation\/trees\/forest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","role":"symbol","title":"Forest","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths":{"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/shortestpaths","title":"ShortestPaths"}}}