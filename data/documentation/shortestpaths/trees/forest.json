"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"role":"symbol","type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths":{"kind":"symbol","type":"topic","role":"collection","title":"ShortestPaths","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","abstract":[],"url":"\/documentation\/shortestpaths"},"doc://ShortestPaths/documentation/ShortestPaths/Trees":{"url":"\/documentation\/shortestpaths\/trees","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees","kind":"symbol","role":"collection","title":"Trees","abstract":[]}}}