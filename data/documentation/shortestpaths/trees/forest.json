e","code":"Hashable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","kind":"typeIdentifier","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}],"title":"init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)"},"doc://Trees/documentation/Trees/Forest":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"type":"codeVoice","code":"trees"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"role":"symbol","title":"Forest","type":"topic","url":"\/documentation\/trees\/forest","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","navigatorTitle":[{"kind":"identifier","text":"Forest"}]}}}