graph’s vertex indices when it has them), unreached ones left out, so the source need not","type":"text"},{"text":" ","type":"text"},{"text":"come first. Edge positions are the arborescence’s own, in vertex order: edge k leads to","type":"text"},{"text":" ","type":"text"},{"text":"the k-th listed vertex other than the root, counting from 0. The graph’s edge into a","type":"text"},{"text":" ","type":"text"},{"text":"vertex stays ","type":"text"},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"text":". O(n); the vertices are hashed once, into the","type":"text"},{"text":" ","type":"text"},{"text":"arborescence’s lookup table, unless they are the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<k","type":"codeVoice"},{"text":" in order.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"tree.sources.count == 1","type":"codeVoice"},{"text":". Several sources make a forest; use ","type":"text"},{"code":"Forest(_:)","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"note","name":"Precondition","type":"aside"}]}],"variants":[{"paths":["\/documentation\/shortestpaths\/trees\/arborescence\/init(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"type":"topic"},"doc://ShortestPaths/documentation/ShortestPaths/Trees