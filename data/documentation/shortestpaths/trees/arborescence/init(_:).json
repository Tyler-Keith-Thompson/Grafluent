{"kind":"symbol","identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence\/init(_:)","interfaceLanguage":"swift"},"abstract":[{"text":"The shortest-path tree of a one-source search, as an arborescence rooted at the source:","type":"text"},{"text":" ","type":"text"},{"text":"every reached vertex, each with its ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"text":" as parent.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"tree"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ShortestPathTree","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentatio