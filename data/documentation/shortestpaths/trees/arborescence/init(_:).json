":"text","text":"every reached vertex, each with its "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":" as parent."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"tree"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ShortestPathTree","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertices are listed in the tree’s index order (the indices of "},{"type":"codeVoice","code":"distance(toIndex:)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"graph’s vertex indices when it has them), unreached ones left out, so the source need not"},{"type":"text","text":" "},{"type":"text","text":"come first. Edge positions are the arborescence’s own, in vertex order: edge k leads to"},{"type":"text","text":" "},{"type":"text","text":"the k-th listed vertex other than the root, counting from 0. The graph’s edge into a"},{"type":"text","text":" "},{"type":"text","text":"vertex stays "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"arborescence’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}]},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"tree.sources.count == 1"},{"type":"text","text":". Several sources make a forest; use "},{"type":"codeVoice","code":"Forest(_:)"},{"type":"text","text":"."}]}],"style":"note"}]}],"references":{"doc://ShortestPaths/documentation/ShortestPaths":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","title":"ShortestPaths","type":"topic","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/shortestpaths"},"doc://ShortestPaths/documentation/ShortestPaths/Trees":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees","kind":"symbol","type":"topic","abstract":[],"title":"Trees","role":"collection","url":"\/documentation\/shortestpaths\/trees"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Arborescence":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s