(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"arborescence’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"tree.sources.count == 1"},{"type":"text","text":". Several sources make a rooted forest, which"},{"type":"text","text":" "},{"type":"text","text":"Trees has no type for; the source count is the caller’s own argument to the search, so"},{"type":"text","text":" "},{"type":"text","text":"asking for one root with several is a programming error, not a lookup that may miss."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Precondition"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence\/init(_:)"},"abstract":[{"type":"text","text":"The shortest-path tree of a one-source search, as an arborescence rooted at the source:"},{"type":"text","text":" "},{"type":"text","text":"every reached vertex, each with its "},{"type":"codeVoice","code":"parent(of:)"},{"text":" as parent (the tree LEMON’s ","type":"text"},{"type":"codeVoice","code":"predMap"},{"text":" ","type":"text"},{"text":"encodes).","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/trees\/arborescence\/init(_:)"]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph\/vertex",