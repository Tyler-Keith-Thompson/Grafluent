,{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Vertices are listed in the tree’s index order (the indices of ","type":"text"},{"type":"codeVoice","code":"distance(toIndex:)"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"graph’s vertex indices when it has them), unreached ones left out, so the source need not","type":"text"},{"text":" ","type":"text"},{"text":"come first. Edge positions are the arborescence’s own, in vertex order: edge k leads to","type":"text"},{"text":" ","type":"text"},{"text":"the k-th listed vertex other than the root, counting from 0. The graph’s edge into a","type":"text"},{"text":" ","type":"text"},{"text":"vertex stays ","type":"text"},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"text":". O(n); the vertices are hashed once, into the","type":"text"},{"text":" ","type":"text"},{"text":"arborescence’s lookup table, unless they are the ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":"s ","type":"text"},{"type":"codeVoice","code":"0..<k"},{"text":" in order.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"code":"tree.sources.count == 1","type":"codeVoice"},{"type":"text","text":". Several sources make a forest; use "},{"code":"Forest(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence"]]},"abstract":[{"text":"The shortest-path tree of a one-source search, as an arborescence rooted at the source:","type":"text"},{"text":" ","type":"text"},{"text":"every reached vertex, each with its ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"text":" as parent.","type":"text"}],"metadata":{"symbol