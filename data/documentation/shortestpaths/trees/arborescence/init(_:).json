orest, which"},{"type":"text","text":" "},{"type":"text","text":"Trees has no type for; the source count is the caller’s own argument to the search, so"},{"type":"text","text":" "},{"type":"text","text":"asking for one root with several is a programming error, not a lookup that may miss."}]}]}],"kind":"content"}],"metadata":{"conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"ShortestPathTree","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}],"externalID":"s:5Trees12ArborescenceV13ShortestPathsEyACyxGAD0C8PathTreeVyqd__qd_0_Gc6VertexQyd__Rsz14GraphProtocols08DirectedH0Rd__SLRd_0_r0_lufc","roleHeading":"Initializer","modules":[{"name":"ShortestPaths","relatedModules":["Trees"]}],"title":"init(_:)","extendedModule":"Trees","role":"symbol","remoteSource":{"fileName":"ShortestPathTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestPathTree.swift#L156"},"symbolKind":"init"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"kind":"symbol","url":"\/documentation\/graphprotocols