{"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"fileName":"ShortestSimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestSimplePaths.swift#L326"},"title":"ShortestSimplePaths","symbolKind":"struct","roleHeading":"Structure","externalID":"s:13ShortestPaths0a6SimpleB0V","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestSimplePaths"}],"modules":[{"name":"ShortestPaths"}],"navigatorTitle":[{"text":"ShortestSimplePaths","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestSimplePaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each path is a "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" with the edges it takes, paired with its length. Paths are told apart by"},{"type":"text","text":" "},{"type":"text","text":"their edges, so parallel edges give distinct paths. Paths of equal length come in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order. The out-edges and their weights are copied when the sequence is made; each"},{"type":"text","text":" "},{"type":"text","text":"path after the first then costs up to one shortest-path search per vertex on the path before"},{"type":"text","text":" "},{"type":"text","text":"it. Taking a prefix, "},{"type":"codeVoice","code":"prefix(k)"},{"type":"text","text":", gives the k shortest simple paths."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each iterator starts over from the first path. Holds a copy of the graph, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"ShortestPathTree"},{"type":"text","text":" does."}]}]}],"kind":"symbol","sections":[],"abstract":[{"text":"The simple paths from a source to a target in order of length, shortest first, listed lazily","type":"text"},{"text":" ","type":"text"},{"text":"by Yen’s algorithm with Lawler’s refinement.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Iterator"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/makeIterator()"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Sequence-Implementations"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","ty