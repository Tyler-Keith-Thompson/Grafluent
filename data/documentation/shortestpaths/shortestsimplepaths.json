eading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each path is a ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" with the edges it takes, paired with its length. Paths are told apart by","type":"text"},{"text":" ","type":"text"},{"text":"their edges, so parallel edges give distinct paths. Paths of equal length come in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order. The out-edges and their weights are copied when the sequence is made; each","type":"text"},{"text":" ","type":"text"},{"text":"path after the first then costs up to one shortest-path search per vertex on the path before","type":"text"},{"text":" ","type":"text"},{"text":"it. Taking a prefix, ","type":"text"},{"code":"prefix(k)","type":"codeVoice"},{"text":", gives the k shortest simple paths.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each iterator starts over from the first path. Holds a copy of the graph, as","type":"text"},{"text":" ","type":"text"},{"code":"ShortestPathTree","type":"codeVoice"},{"text":" does.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/shortestsimplepaths"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths"},"abstract":[{"text":"The simple paths from a source to a target in order of length, shortest first, listed lazily","type":"text"},{"text":" ","type":"text"},{"text":"by Yen’s algorithm with Lawler’s refinement.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"metadata":{"externalID":"s:13ShortestPaths0a6SimpleB0V","title":"ShortestSimplePaths","remoteSource":{"fileName":"ShortestSimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestSimplePath