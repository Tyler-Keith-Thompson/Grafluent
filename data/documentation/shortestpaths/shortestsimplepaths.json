}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Each path is a "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" with the edges it takes, paired with its length. Paths are told apart by"},{"type":"text","text":" "},{"type":"text","text":"their edges, so parallel edges give distinct paths. Paths of equal length come in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order. The out-edges and their weights are copied when the sequence is made; each"},{"type":"text","text":" "},{"type":"text","text":"path after the first then costs up to one shortest-path search per vertex on the path before"},{"type":"text","text":" "},{"type":"text","text":"it. Taking a prefix, "},{"type":"codeVoice","code":"prefix(k)"},{"type":"text","text":", gives the k shortest simple paths."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each iterator starts over from the first path. Holds a copy of the graph, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"ShortestPathTree"},{"type":"text","text":" does."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths"},"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ShortestSimplePaths","kind":"identifier"}],"role":"symbol","title":"ShortestSimplePaths","navigatorTitle":[{"text":"ShortestSimplePaths","kind":"identifier"}],"externalID":"s:13ShortestPaths0a6SimpleB0V","symbolKind":"struct","remoteSource":{"fileName":"ShortestSimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestSimplePaths.swift#L326"},"roleHeading":"Structure","modules":[{"name":"ShortestPaths"}]},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"sections":[],"relationshipsSections":[{