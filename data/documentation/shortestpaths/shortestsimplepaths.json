{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"abstract":[{"type":"text","text":"The simple paths from a source to a target in order of length, shortest first, listed lazily"},{"type":"text","text":" "},{"type":"text","text":"by Yen’s algorithm with Lawler’s refinement."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestSimplePaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Each path is a "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" with the edges it takes, paired with its length. Paths are told apart by"},{"type":"text","text":" "},{"type":"text","text":"their edges, so parallel edges give distinct paths. Paths of equal length come in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order. The out-edges and their weights are copied when the sequence is made; each"},{"type":"text","text":" "},{"type":"text","text":"path after the first then costs up to one shortest-path search per vertex on the path before"},{"type":"text","text":" "},{"type":"text","text":"it. Taking a prefix, "},{"type":"codeVoice","code":"prefix(k)"},{"type":"text","text":", gives the k shortest simple paths."}],"type":"paragraph"},{"inlineContent":[{"text":"Each iterator starts over from the first path. Holds a copy of the graph, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ShortestPathTree"},{"text":" does.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"symbol","roleHeading":"Structure","symbolKind":"struct","externalID":"s:13ShortestPaths0a6SimpleB0V","title":"ShortestSimplePaths","remoteSource":{"fileName":"ShortestSimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestSimplePaths.swift#L326"},"navigatorTitle":[{"kind":"identifier","text":"ShortestSimplePaths"}],"modules":[{"name":"ShortestPaths"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestSimplePaths","kind":"identifier"}]},"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP","doc:\/\/ShortestPaths\/ST"]}],"topicSections":[{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Iterator"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/makeIterator()"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"anchor":"D