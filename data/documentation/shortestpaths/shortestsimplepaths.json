{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each path is a "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" with the edges it takes, paired with its length. Paths are told apart by"},{"type":"text","text":" "},{"type":"text","text":"their edges, so parallel edges give distinct paths. Paths of equal length come in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order. The out-edges and their weights are copied when the sequence is made; each"},{"type":"text","text":" "},{"type":"text","text":"path after the first then costs up to one shortest-path search per vertex on the path before"},{"type":"text","text":" "},{"type":"text","text":"it. Taking a prefix, "},{"type":"codeVoice","code":"prefix(k)"},{"type":"text","text":", gives the k shortest simple paths."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each iterator starts over from the first path. Holds a copy of the graph, as"},{"type":"text","text":" "},{"type":"codeVoice","code":"ShortestPathTree"},{"type":"text","text":" does."}]}]}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePath