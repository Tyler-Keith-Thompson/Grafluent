{"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths","interfaceLanguage":"swift"},"abstract":[{"text":"The simple paths from a source to a target in order of length, shortest first, listed lazily","type":"text"},{"text":" ","type":"text"},{"text":"by Yen’s algorithm with Lawler’s refinement.","type":"text"}],"kind":"symbol","topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Iterator"],"generated":true,"title":"Structures"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/makeIterator()"],"generated":true,"title":"Instance Methods"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Sequence-Implementations"],"generated":true,"title":"Default Implementations"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP","doc:\/\/ShortestPaths\/ST"],"title":"Conforms To","kind":"relationships"}],"sections":[],"variants":[{"paths":["\/documentation\/shortestpaths\/shortestsimplepaths"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"struct","roleHeading":"Structure","role":"symbol","modules":[{"name":"ShortestPaths"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestSimplePaths.swift#L326","fileName":"ShortestSimplePaths.swift"},"externalID":"s:13ShortestPaths0a6SimpleB0V","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestSimplePaths"}],"navigatorTitle":[{"text":"ShortestSimplePaths","kind":"identifier"}],"title":"ShortestSimplePaths"},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestSimplePaths"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"typeIdentifier","text":"DirectedGraph"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Each path is a "},{"code":"Path","type":"codeVoice"},{"type":"text","text":" with the edges it takes, paired with its length. Paths are told apart by"},{"type":"text","text":" "},{"type":"text","text":"their edges, so parallel edges give distinct paths. Paths of equal length come in an"},{"type":"text","text":" "},{"type":"text","text":"unspecified order. The out-edges and their weights are copied when the sequence is made; each"},{"type":"text","text":" "},{"type":"text","text":"path after the first then costs up to one shortest-path search per vertex on the path before"},{"type":"text","text":" "},{"type":"text","text":"it. Taking a prefix, "},{"code":"prefix(k)","type":"codeVoice"},{"type":"text","text":", gives the k shortest simple paths."}],"type":"paragraph"},{"inlineContent":[{"text":"Each iterator starts over from the first path. Holds a copy of the graph, as","type":"text"},{"text":" ","type":"text"},{"code":"ShortestPathTree","type":"codeVoice"},{"text":" does.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://ShortestPaths/ST":{"type":"unresolvable","title":"Swift.Sequence","identifier":"doc:\/\/ShortestPaths\/ST"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestSimplePaths/Sequence-Implementations":{"abstract":[],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Sequence-Implementations","type":"topic","kind":"article","url":"\/documentation\/shortestpaths\/shortestsimplepaths\/sequence-implementations","role":"collectionGroup","title":"Sequence Implementations"},"doc://ShortestPaths/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/ShortestPaths\/s16SendableMetatypeP"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestSimplePaths":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths","abstract":[{"type":"text","text":"The simple paths from a source to a target in order of length, shortest first, listed lazily"},{"type":"text","text":" "},{"type":"text","text":"by Yen’s algorithm with Lawler’s refinement."}],"kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/shortestsimplepaths","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestSimplePaths","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ShortestSimplePaths","kind":"identifier"}],"title":"ShortestSimplePaths"},"doc://ShortestPaths/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/ShortestPaths\/s8SendableP"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestSimplePaths/Iterator":{"kind":"symbol","url":"\/documentation\/shortestpaths\/short