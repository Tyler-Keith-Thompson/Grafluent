refix(k)"},{"text":", gives the k shortest simple paths.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each iterator starts over from the first path. Holds a copy of the graph, as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ShortestPathTree"},{"text":" does.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/shortestpaths\/shortestsimplepaths"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"metadata":{"title":"ShortestSimplePaths","navigatorTitle":[{"kind":"identifier","text":"ShortestSimplePaths"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestSimplePaths"}],"role":"symbol","roleHeading":"Structure","externalID":"s:13ShortestPaths0a6SimpleB0V","modules":[{"name":"ShortestPaths"}],"remoteSource":{"fileName":"ShortestSimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestSimplePaths.swift#L326"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP","doc:\/\/ShortestPaths\/ST"],"type":"conformsTo","title":"Conforms To"}],"topicSections":[{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Iterator"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/makeIterator()"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Sequence-Implementations"],"t