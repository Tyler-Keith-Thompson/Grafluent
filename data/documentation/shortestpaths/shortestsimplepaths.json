{"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShortestSimplePaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Each path is a ","type":"text"},{"type":"codeVoice","code":"Path"},{"text":" with the edges it takes, paired with its length. Paths are told apart by","type":"text"},{"text":" ","type":"text"},{"text":"their edges, so parallel edges give distinct paths. Paths of equal length come in an","type":"text"},{"text":" ","type":"text"},{"text":"unspecified order. The out-edges and their weights are copied when the sequence is made; each","type":"text"},{"text":" ","type":"text"},{"text":"path after the first then costs up to one shortest-path search per vertex on the path before","type":"text"},{"text":" ","type":"text"},{"text":"it. Taking a prefix, ","type":"text"},{"type":"codeVoice","code":"prefix(k)"},{"text":", gives the k shortest simple paths.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each iterator starts over from the first path. Holds a copy of the graph, as","type":"text"},{"text":" ","type":"text"},{"code":"ShortestPathTree","type":"codeVoice"},{"text":" does.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/shortestsimplepaths"]}],"abstract":[{"text":"The simple paths from a source to a target in order of length, shortest first, listed lazily","type":"text"},{"text":" ","type":"text"},{"text":"by Yen’s algorithm with Lawler’s refinement.","type":"text"}],"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Iterator"],"anchor":"Structures"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/makeIterator()"],"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestSimplePaths\/Sequence-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"symbol","remoteSource":{"fileName":"ShortestSimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/ShortestSimplePaths.swift#L326"},"symbolKind":"struct","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestSimplePaths"}],"modules":[{"name":"ShortestPaths"}],"title":"ShortestSimplePaths","navigatorTitle":[{"te