:"text"},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"text":": it bounds","type":"text"},{"text":" ","type":"text"},{"text":"the distance from ","type":"text"},{"type":"codeVoice","code":"start"},{"text":", not the distance plus the estimate, so the answer does not depend","type":"text"},{"text":" ","type":"text"},{"text":"on the heuristic.","type":"text"}],"type":"paragraph"}],"name":"cutoff"}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"With an admissible heuristic (never more than the true remaining cost, and so zero or less at a"},{"type":"text","text":" "},{"type":"text","text":"goal) the path is a shortest one, even when the heuristic is not consistent, since a state whose"},{"type":"text","text":" "},{"type":"text","text":"distance improves after it was expanded is expanded again. With a consistent one"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"h(u) <= cost(u, v) + h(v)","type":"codeVoice"},{"type":"text","text":") no state is expanded twice. A heuristic of zero is Dijkstra’s"},{"type":"text","text":" "},{"type":"text","text":"algorithm."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"As for "},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"type":"text","text":"; no priority"},{"type":"text","text":" "},{"type":"text","text":"(a distance plus its state’s estimate) is NaN, so no estimate is NaN, and no estimate is an"},{"type":"text","text":" "},{"type":"text","text":"infinity opposite to an infinite distance."}]}],"type":"aside","style":"note","name":"Precondition"}],"kind":"content"}],"references":{"doc://ShortestPaths/documentation/ShortestPaths":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/shortestpaths","title":"Shortes