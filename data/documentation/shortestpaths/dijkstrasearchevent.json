{"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/discover(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examine(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/finish(_:distance:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/Equatable-Implementations"]}],"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Weight","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Each source is discovered first, at distance zero. Then, while a discovered vertex is not yet"},{"type":"text","text":" "},{"type":"text","text":"settled, the one with the smallest distance is examined (settled at that distance), and each"},{"type":"text","text":" "},{"type":"text","text":"of its out-edges is examined in turn with the distance it offers its target: the examined"},{"type":"text","text":" "},{"type":"text","text":"vertex’s distance plus the edge’s weight. An edge into an unsettled target is then relaxed,"},{"type":"text","text":" "},{"type":"text","text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or"},{"type":"text","text":" "},{"type":"text","text":"not relaxed. A relaxed edge to an undiscovered target is followed by that target’s discovery."},{"type":"text","text":" "},{"type":"text","text":"An edge into a settled vertex, a self-loop included, is examined and nothing more. After its"},{"type":"text","text":" "},{"type":"text","text":"last out-edge the examined vertex is finished. Vertices the sources do not reach are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/dijkstrasearchevent"]}],"metadata":{"role":"symbol","title":"DijkstraSearchEvent","navigatorTitle":[{"text":"DijkstraSearchEvent","kind":"identifier"}],"externalID":"s:13ShortestPaths19DijkstraSearchEventO","roleHeading":"Enumeration","symbolKind":"enum","remoteSource":{"fileName":"DijkstraSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/DijkstraSearch.swift#L17"},"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"}],"modules":[{"name":"ShortestPaths"}]},"kind":"symbol","abstract":[{"type":"text","text":"What a Dijkstra search reports, in order, with the events of the Boost Graph Library’s"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra visitor."}],"references":{"doc://ShortestPaths/s8CopyableP":{"identifier":"doc:\/\/ShortestPaths\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://ShortestPaths/documentation/ShortestPaths":{"url":"\/documentation\/shortestpaths","abstract":[],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","type":"topic","title":"ShortestPaths","kind":"symbol","role":"collection"},"doc://ShortestPaths/documentation/ShortestPaths/DijkstraSearchEvent/edgeNotRelaxed(_:distance:)":{"abstract":[{"type":"text","text":"The edge’s offer did not beat its target’s distance, which stays "},{"type":"codeVoice","code":"distance"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/shortestpaths\/dijkstrasearchevent\/edgenotrelaxed(_:distance:)","role":"symbol","title":"DijkstraSearchEvent.edgeNotRelaxed(_:distance:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeNotRelaxed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind