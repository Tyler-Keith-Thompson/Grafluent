{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Weight","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Each source is discovered first, at distance zero. Then, while a discovered vertex is not yet","type":"text"},{"text":" ","type":"text"},{"text":"settled, the one with the smallest distance is examined (settled at that distance), and each","type":"text"},{"text":" ","type":"text"},{"text":"of its out-edges is examined in turn with the distance it offers its target: the examined","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s distance plus the edge’s weight. An edge into an unsettled target is then relaxed,","type":"text"},{"text":" ","type":"text"},{"text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or","type":"text"},{"text":" ","type":"text"},{"text":"not relaxed. A relaxed edge to an undiscovered target is followed by that target’s discovery.","type":"text"},{"text":" ","type":"text"},{"text":"An edge into a settled vertex, a self-loop included, is examined and nothing more. After its","type":"text"},{"text":" ","type":"text"},{"text":"last out-edge the examined vertex is finished. Vertices the sources do not reach are never","type":"text"},{"text":" ","type":"text"},{"text":"reported.","type":"text"}]}],"kind":"content"}],"metadata":{"remoteSource":{"fileName":"DijkstraSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/DijkstraSearch.swift#L17"},"roleHeading":"Enumeration","symbolKind":"enum","externalID":"s:13ShortestPaths19DijkstraSearchEventO","role":"symbol","title":"DijkstraSearchEvent","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"}],"navigatorTitle":[{"text":"DijkstraSearchEvent","kind":"identifier"}],"modules":[{"name":"ShortestPaths"}]},"abstract":[{"type":"text","text":"What a Dijkstra search reports, in order, with the events of the Boost Graph Library’s"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra visitor."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent"},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"sections":[],"topicSections":[{"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/discover(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/do