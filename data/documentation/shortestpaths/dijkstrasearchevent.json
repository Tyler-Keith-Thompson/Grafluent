{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent"},"abstract":[{"text":"What a Dijkstra search reports, in order, with the events of the Boost Graph Library’s","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra visitor.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DijkstraSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Weight"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Each source is discovered first, at distance zero. Then, while a discovered vertex is not yet","type":"text"},{"text":" ","type":"text"},{"text":"settled, the one with the smallest distance is examined (settled at that distance), and each","type":"text"},{"text":" ","type":"text"},{"text":"of its out-edges is examined in turn with the distance it offers its target: the examined","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s distance plus the edge’s weight. An edge into an unsettled target is then relaxed,","type":"text"},{"text":" ","type":"text"},{"text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or","type":"text"},{"text":" ","type":"text"},{"text":"not relaxed. A relaxed edge to an undiscovered target is followed by that target’s discovery.","type":"text"},{"text":" ","type":"text"},{"text":"An edge into a settled vertex, a self-loop included, is examined and nothing more. After its","type":"text"},{"text":" ","type":"text"},{"text":"last out-edge the examined vertex is finished. Vertices the sources do not reach are never","type":"text"},{"text":" ","type":"text"},{"text":"reported.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"generated":true,"anchor":"Enumeration-Cases","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/discover(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examine(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/finish(_:distance:)"],"title":"Enumeration Cases"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/Equatable-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/Sh