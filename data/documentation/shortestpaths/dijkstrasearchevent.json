{"relationshipsSections":[{"identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Weight","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Each source is discovered first, at distance zero. Then, while a discovered vertex is not yet"},{"type":"text","text":" "},{"type":"text","text":"settled, the one with the smallest distance is examined (settled at that distance), and each"},{"type":"text","text":" "},{"type":"text","text":"of its out-edges is examined in turn with the distance it offers its target: the examined"},{"type":"text","text":" "},{"type":"text","text":"vertex’s distance plus the edge’s weight. An edge into an unsettled target is then relaxed,"},{"type":"text","text":" "},{"type":"text","text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or"},{"type":"text","text":" "},{"type":"text","text":"not relaxed. A relaxed edge to an undiscovered target is followed by that target’s discovery."},{"type":"text","text":" "},{"type":"text","text":"An edge into a settled vertex, a self-loop included, is examined and nothing more. After its"},{"type":"text","text":" "},{"type":"text","text":"last out-edge the examined vertex is finished. Vertices the sources do not reach are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"generated":true,"title":"Enumeration Cases","anchor":"Enumeration-Cases","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/discover(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examine(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/finish(_:distance:)"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/Equatable-Implementations"]}],"variants":[{"paths":["\/documentation\/shortestpaths\/dijkstrasearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"