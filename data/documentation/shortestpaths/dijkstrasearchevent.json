{"abstract":[{"text":"What a Dijkstra search reports, in order, with the events of the Boost Graph Library’s","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra visitor.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent"},"metadata":{"modules":[{"name":"ShortestPaths"}],"symbolKind":"enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DijkstraSearchEvent"}],"title":"DijkstraSearchEvent","remoteSource":{"fileName":"DijkstraSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/DijkstraSearch.swift#L17"},"roleHeading":"Enumeration","externalID":"s:13ShortestPaths19DijkstraSearchEventO","navigatorTitle":[{"kind":"identifier","text":"DijkstraSearchEvent"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/discover(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examine(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/finish(_:distance:)"],"anchor":"Enumeration-Cases"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"kind":"symbol","variants":[{"paths":["\/documentation\/shortestpaths\/dijkstrasearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Weight","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Each source is discovered first, at distance zero. Then, while a discovered vertex is not yet","type":"text"},{"text":" ","type":"text"},{"text":"settled, the one with the smallest distance is examined (settled at that distance), and each","type":"text"},{"text":" ","type":"text"},{"text":"of its out-edges is examined in turn with the distance it offers its target: the examined","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s distance plus the edge’s weight. An edge into an unsettled target is then relaxed,","type":"text"},{"text":" ","type":"text"},{"text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or","type":"text"},{"text":" ","type":"text"},{"text":"not relaxed. A relaxed edge to an undiscovered target is followed by that target’s discovery.","type":"text"},{"text":" ","type":"text"},{"text":"An edge into a settled vertex, a self-loop included, is examined and nothing more. After its","type":"text"},{"text":" ","type":"text"},{"text":"last out-edge the examined vertex is finished. Vertices the sources do not reach are never","type":"text"},{"text":" ","type":"text"},{"text":"reported.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"references":{"doc://ShortestPaths/documentation/ShortestPaths":{"kind":"symbol","role":"collection","type":"topic","title":"ShortestPaths","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","abstract":[],"url":"\/documentation\/shortestpaths"},"doc://ShortestPaths/SQ":{"type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/SQ","title":"Swift.Equatable"},"doc://ShortestPaths/s23CustomStringConvertibleP":{"type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible"},"doc://ShortestPaths/documentation/ShortestPaths/DijkstraSearchEvent/edgeNotRelaxed(_:distance:)":{"role":"symbol","abstract":[{"type":"text","text":"The edge’s offer did not beat its target’s distance, which stays "},{"type":"codeVoice","code":"distance"},{"type":"text","text":"."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeNotRelaxed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/shortestpaths\/dijkstrasearchevent\/edgenotrelaxed(_:distance:)","kind":"symbol","title":"DijkstraSearchEvent.edgeNotRelaxed(_:distance:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","type":"topic"},"doc://ShortestPaths/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s8SendableP","title":"Swift.Sendable"},"doc://ShortestPaths/documentation/ShortestPaths/DijkstraSearchEvent/edgeRelaxed(_:distance:)":{"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeRelaxed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","type":"topic","title":"DijkstraSearchEvent.edgeRelaxed(_:distance:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeRelaxed(_:distance:)","abstract":[{"type":"text","text":"The edge’s offer beat its target’s distance, which is now "},{"type":"codeVoice","code":"distance"},{"type":"text","text":"."}],"url":"\/documentation\/shortestpaths\/dijkstrasearchevent\/edgerelaxed(_:distance:)"},"doc://ShortestPaths/documentation/ShortestPaths/DijkstraSearchEvent/examine(_:distance:)":{"kind":"symbol","title":"DijkstraSearchEvent.examine(_:distance:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"examine","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"A vertex leaves the queue: its distance is final."}],"identifier":"doc:\/\/ShortestPaths\/documentatio