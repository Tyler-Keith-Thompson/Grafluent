","type":"text"},{"text":" ","type":"text"},{"text":"not relaxed. A relaxed edge to an undiscovered target is followed by that target’s discovery.","type":"text"},{"text":" ","type":"text"},{"text":"An edge into a settled vertex, a self-loop included, is examined and nothing more. After its","type":"text"},{"text":" ","type":"text"},{"text":"last out-edge the examined vertex is finished. Vertices the sources do not reach are never","type":"text"},{"text":" ","type":"text"},{"text":"reported.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/shortestpaths\/dijkstrasearchevent"]}],"kind":"symbol","identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent","interfaceLanguage":"swift"},"references":{"doc://ShortestPaths/s9EscapableP":{"identifier":"doc:\/\/ShortestPaths\/s9EscapableP","title":"Swift.Escapable","type":"unresolvable"},"doc://ShortestPaths/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s16SendableMetatypeP"},"doc://ShortestPaths/documentation/ShortestPaths/DijkstraSearchEvent/examine(_:distance:)":{"role":"symbol","type":"topic","kind":"symbol","title":"DijkstraSearchEvent.examine(_:distance:)","abstract":[{"type":"text","text":"A vertex leaves the queue: its distance is final."}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examine(_:distance:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"examine","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"distance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Weight"},{"kind":"text","text":")"}],"url":"\/documentation\/shortestpaths\/dijkstrasearchevent\/examine(_:distance:)"},"doc://ShortestPaths/documentation/ShortestPaths/Dijkstr