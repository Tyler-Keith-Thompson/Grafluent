{"sections":[],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"kind":"relationships"}],"metadata":{"navigatorTitle":[{"text":"DijkstraSearchEvent","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DijkstraSearchEvent"}],"remoteSource":{"fileName":"DijkstraSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/DijkstraSearch.swift#L17"},"externalID":"s:13ShortestPaths19DijkstraSearchEventO","role":"symbol","roleHeading":"Enumeration","symbolKind":"enum","modules":[{"name":"ShortestPaths"}],"title":"DijkstraSearchEvent"},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"What a Dijkstra search reports, in order, with the events of the Boost Graph Library’s","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra visitor.","type":"text"}],"topicSections":[{"title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/discover(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examine(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/finish(_:distance:)"],"anchor":"Enumeration-Cases"},{"title":"D