{"abstract":[{"type":"text","text":"What a Dijkstra search reports, in order, with the events of the Boost Graph Library’s"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra visitor."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DijkstraSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Weight"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each source is discovered first, at distance zero. Then, while a discovered vertex is not yet"},{"type":"text","text":" "},{"type":"text","text":"settled, the one with the smallest distance is examined (settled at that distance), and each"},{"type":"text","text":" "},{"type":"text","text":"of its out-edges is examined in turn with the distance it offers its target: the examined"},{"type":"text","text":" "},{"type":"text","text":"vertex’s distance plus the edge’s weight. An edge into an unsettled target is then relaxed,"},{"type":"text","text":" "},{"type":"text","text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or"},{"type":"text","text":" "},{"type":"text","text":"not relaxed. A relaxed edge to an undiscovered target is followed by that target’s discovery."},{"type":"text","text":" "},{"type":"text","text":"An edge into a settled vertex, a self-loop included, is examined and nothing more. After its"},{"type":"text","text":" "},{"type":"text","text":"last out-edge the examined vertex is finished. Vertices the sources do not reach are never"},{"type":"text","text":" "},{"type":"text","text":"reported."}]}],"kind":"content"}],"sections":[],"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"}],"externalID":"s:13ShortestPaths19DijkstraSearchEventO","navigatorTitle":[{"kind":"identifier","text":"DijkstraSearchEvent"}],"title":"DijkstraSearchEvent","remoteSource":{"fileName":"DijkstraSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/DijkstraSearch.swift#L17"},"role":"symbol","modules":[{"name":"ShortestPaths"}],"roleHeading":"Enumeration","symbolKind":"enum"},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/discover(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examine(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/finish(_:distance:)"],"anchor":"Enumeration-Cases","title":"Enumeration Cases","generated":true},{"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent\/Equatable-Implemen