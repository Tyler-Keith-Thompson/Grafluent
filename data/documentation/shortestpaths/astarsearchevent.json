{"variants":[{"paths":["\/documentation\/shortestpaths\/astarsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"title":"AStarSearchEvent","roleHeading":"Enumeration","externalID":"s:13ShortestPaths16AStarSearchEventO","modules":[{"name":"ShortestPaths"}],"symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AStarSearchEvent"}],"navigatorTitle":[{"kind":"identifier","text":"AStarSearchEvent"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/AStarSearch.swift#L18","fileName":"AStarSearch.swift"}},"sections":[],"abstract":[{"type":"text","text":"What an A* search reports, in order, with the events of the Boost Graph Library’s A* visitor."}],"topicSections":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/discover(_:distance:estimate:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/examine(_:distance:estimate:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/finish(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/reopen(_:distance:estimate:)"],"generated":true,"title":"Enumeration Cases"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/Equatable-Implementations"],"generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarati