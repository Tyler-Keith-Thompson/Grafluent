","type":"text"},{"text":"one to a closed vertex, which only an inconsistent heuristic allows, by its reopening (the","type":"text"},{"text":" ","type":"text"},{"text":"Boost Graph Library’s black target), after which it is examined again. After its last out-edge","type":"text"},{"text":" ","type":"text"},{"text":"the examined vertex is finished. When the target is never reached the search ends once no","type":"text"},{"text":" ","type":"text"},{"text":"vertex is open.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"title":"Conforms To"}],"references":{"doc://ShortestPaths/documentation/ShortestPaths/AStarSearchEvent/edgeRelaxed(_:distance:)":{"role":"symbol","abstract":[{"text":"The edge’s offer beat its target’s distance, which is now ","type":"text"},{"type":"codeVoice","code":"distance"},{"text":".","type":"text"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/edgeRelaxed(_:distance:)","title":"AStarSearchEvent.edgeRelaxed(_:distance:)","url":"\/documentation\/shortestpaths\/astarsearchevent\/edgerelaxed(_:distance:)","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"edgeRelaxed"},{"kind":"text","text":"("},{"text":"Edge","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdenti