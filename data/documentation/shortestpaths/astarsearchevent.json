tarSearchEvent/discover(_:distance:estimate:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"discover"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"distance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Weight"},{"kind":"text","text":", "},{"kind":"externalParam","text":"estimate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Weight"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"A vertex is reached for the first time, at "},{"type":"codeVoice","code":"distance"},{"type":"text","text":", with its estimate."}],"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/discover(_:distance:estimate:)","title":"AStarSearchEvent.discover(_:distance:estimate:)","kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/astarsearchevent\/discover(_:distance:estimate:)"},"doc://ShortestPaths/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/ShortestPaths\/SQ"},"doc://ShortestPaths/s8CopyableP":{"identifier":"doc:\/\/ShortestPaths\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://ShortestPaths/documentation/ShortestPaths/AStarSearchEvent/edgeNotRelaxed(_:distance:)":{"abstract":[{"text":"The edge’s offer did not beat its target’s distance, which stays ","type":"text"},{"type":"codeVoice","code":"distance"},{"text":".","type":"text"}],"url":"\/documentation\/shortestpaths\/astarsearchevent\/edgenotrelaxed(_:distance:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeNotRelaxed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"distance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Sho