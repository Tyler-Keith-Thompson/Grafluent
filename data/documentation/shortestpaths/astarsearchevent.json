{"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/discover(_:distance:estimate:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/examine(_:distance:estimate:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/finish(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/reopen(_:distance:estimate:)"],"anchor":"Enumeration-Cases"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent"},"abstract":[{"text":"What an A* search reports, in order, with the events of the Boost Graph Library’s A* visitor.","type":"text"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AStarSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Weight"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The source is discovered first, at distance zero, with its estimate: the heuristic’s guess at"},{"type":"text","text":" "},{"type":"text","text":"its distance to the target (zero for the target itself). Then, while a vertex is open, the one"},{"type":"text","text":" "},{"type":"text","text":"with the smallest distance plus estimate is examined (closed). When that is the target the"},{"type":"text","text":" "},{"type":"text","text":"search ends there. Otherwise each of its out-edges is examined in turn with the distance it"},{"type":"text","text":" "},{"type":"text","text":"offers its target, the examined vertex’s distance plus the edge’s weight, and is then relaxed,"},{"type":"text","text":" "},{"type":"text","text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or"},{"type":"text","text":" "},{"type":"text","text":"not relaxed. A relaxed edge to an undiscovered vertex is followed by that vertex’s discovery;"},{"type":"text","text":" "},{"type":"text","text":"one to a closed vertex, which only an inconsistent heuristic allows, by its reopening (the"},{"type":"text","text":" "},{"type":"text","text":"Boost Graph Library’s black target), after which it is examined again. After its last out-edge"},{"type":"text","text":" "},{"type":"text","text":"the examined vertex is finished. When the target is never reached the search ends once no"},{"type":"text","text":" "},{"type":"text","text":"vertex is open."}]}]}],"variants":[{"paths":["\/documentation\/shortestpaths\/astarsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AStarSearchEvent","kind":"identifier"}],"symbolKind":"enum","roleHeading":"Enumeration","role":"symbol","remoteSource":{"fileName":"AStarSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/AStarSearch.swift#L18"},"externalID":"s:13ShortestPaths16AStarSearchEventO","modules":[{"name":"ShortestPaths"}],"navigatorTitle":[{"text":"AStarSearchEvent","kind":"identifier"}],"title":"AStarSearchEvent"},"references":{"doc://ShortestPaths/documentation/ShortestPaths":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths","url":"\/documentation\/shortestpaths","kind":"symbol","abstract":[],"role":"collection","title":"ShortestPaths","type":"topic"},"doc://ShortestPaths/s23CustomStringConvertibleP":{"title":"Swift.CustomStringConvertible","type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s23CustomStringConvertibleP"},"doc://ShortestPaths/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s8CopyableP"},"doc://ShortestPaths/documentation/ShortestPaths/AStarSearchEvent/Equatable-Implementations":{"role":"collectionGroup","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/Equatable-Implementations","url":"\/documentation\/shortestpaths\/astarsearchevent\/equ