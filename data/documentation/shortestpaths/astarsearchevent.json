{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent"},"sections":[],"abstract":[{"text":"What an A* search reports, in order, with the events of the Boost Graph Library’s A* visitor.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/ShortestPaths\/s8CopyableP","doc:\/\/ShortestPaths\/s23CustomStringConvertibleP","doc:\/\/ShortestPaths\/SQ","doc:\/\/ShortestPaths\/s9EscapableP","doc:\/\/ShortestPaths\/SH","doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"topicSections":[{"generated":true,"anchor":"Enumeration-Cases","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/discover(_:distance:estimate:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/edgeNotRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/edgeRelaxed(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/examine(_:distance:estimate:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/examineEdge(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/finish(_:distance:)","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/reopen(_:distance:estimate:)"],"title":"Enumeration Cases"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearchEvent\/Equatable-Implementations"],"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/ShortestPaths\/documentation\/ShortestPaths"]]},"variants":[{"paths":["\/documentation\/shortestpaths\/astarsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"roleHeading":"Enumeration","modules":[{"name":"ShortestPaths"}],"title":"AStarSearchEvent","navigatorTitle":[{"text":"AStarSearchEvent","kind":"identifier"}],"remoteSource":{"fileName":"AStarSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ShortestPaths\/AStarSearch.swift#L18"},"symbolKind":"enum","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AStarSearchEvent"}],"externalID":"s:13ShortestPaths16AStarSearchEventO"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AStarSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Weight"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The source is discovered first, at distance zero, with its estimate: the heuristic’s guess at"},{"type":"text","text":" "},{"type":"text","text":"its distance to the target (zero for the target itself). Then, while a vertex is open, the one"},{"type":"text","text":" "},{"type":"text","text":"with the smallest distance plus estimate is examined (closed). When that is the target the"},{"type":"text","text":" "},{"type":"text","text":"search ends there. Otherwise each of its out-edges is examined in turn with the distance it"},{"type":"text","text":" "},{"type":"text","text":"offers its target, the examined vertex’s distance plus the edge’s weight, and is then relaxed,"},{"type":"text","text":" "},{"type":"text","text":"when the offer is smaller than the target’s distance or the target was not yet discovered, or"},{"type":"text","text":" "},{"type":"text","text":"not relaxed. A relaxed edge to an undiscovered vertex is followed by that vertex’s discovery;"},{"type":"text","text":" "},{"type":"text","text":"one to a closed vertex, which only an inconsistent heuristic allows, by its reopening (the"},{"type":"text","text":" "},{"type":"text","text":"Boost Graph Library’s black target), after which it is examined again. After its last out-edge"},{"type":"text","text":" "},{"type":"text","text":"the examined vertex is finished. When the target is never reached the search ends once no"},{"type":"text","text":" "},{"type":"text","text":"vertex is open."}],"type":"paragraph"}]}],"references":{"doc://ShortestPaths/SQ":{"type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/SQ","title":"Swift.Equatable"},"doc://ShortestPaths/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/ShortestPaths\/SH"},"doc://ShortestPaths/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://ShortestPaths/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/ShortestPaths\/s8CopyableP"},"doc://ShortestPaths/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/ShortestPaths\/s9EscapableP","title":"Swift.Escapable"},"doc://ShortestPaths/documentation/ShortestPaths/AStarSearchEvent/Equatable-Implementations":{"role":"collectionGroup","type":"topic","title":"Equatable Implementations","abstract":[],"url":"\/documentation\