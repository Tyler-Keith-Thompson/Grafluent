{"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Landmarks for A* search by the ALT method (Goldberg and Harrelson, “Computing the shortest"},{"type":"text","text":" "},{"type":"text","text":"path: A* search meets graph theory”, SODA 2005): a few vertices chosen far apart, the distance"},{"type":"text","text":" "},{"type":"text","text":"from and to each of them stored for every vertex, and each query an A* search whose estimate of"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s remaining distance is the largest lower bound the triangle inequality gives from"},{"type":"text","text":" "},{"type":"text","text":"any landmark, "},{"code":"d(L, t) − d(L, v)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"d(v, L) − d(t, L)","type":"codeVoice"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/ShortestPaths\/s8SendableP","doc:\/\/ShortestPaths\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ALTLandmarks","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","