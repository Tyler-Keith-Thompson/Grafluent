{"abstract":[{"type":"text","text":"A shortest path from "},{"code":"start","type":"codeVoice"},{"type":"text","text":" to the nearest state satisfying "},{"code":"success","type":"codeVoice"},{"type":"text","text":", by Dijkstra’s algorithm"},{"type":"text","text":" "},{"type":"text","text":"over a successor function, for state spaces that are not stored graphs."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dijkstraShortestPath","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"start","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cutoff","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"successors","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"success","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") -> (path","kind":"text"},{"text":": [","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":"], distance","kind":"text"},{"text":": ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":")? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":" == (","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":")","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When given, states other than ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" are reached only at distance at most","type":"text"},{"text":" ","type":"text"},{"code":"cutoff","type":"codeVoice"},{"text":" (inclusive, as for ","type":"text"},{"code":"dijkstraShortestPaths(from:cutoff:weight:)","type":"codeVoice"},{"text":"), and ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" is returned when no goal is that close. The search then ends","type":"text"},{"text":" ","type":"text"},{"text":"whenever finitely many states are within the cutoff, even on an infinite space. ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"always reached, at zero, and expanded, even under a negative cutoff.","type":"text"}]}],"name":"cutoff"}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"code":"successors(v)","type":"codeVoice"},{"type":"text","text":" lists each state reachable in one step from "},{"code":"v","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the step’s cost, and is called once per expanded state; states need only be "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":", and are"},{"type":"text","text":" "},{"type":"text","text":"numbered in a dictionary as they are reached."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Returns the path’s states from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" to the goal, both included ("},{"type":"codeVoice","code":"[start]"},{"type":"text","text":" when "},{"type":"codeVoice","code":"start"},{"type":"text","text":" "},{"type":"text","text":"satisfies "},{"type":"codeVoice","code":"success"},{"type":"text","text":", without calling "},{"type":"codeVoice","code":"successors"},{"type":"text","text":"), and its cost; "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when the reachable space"},{"type":"text","text":" "},{"type":"text","text":"is finite and holds no goal. On an infinite space with no reachable goal it does not return."},{"type":"text","text":" "},{"type":"text","text":"A goal is recognized when it is settled, so the distance is the shortest even when step costs"},{"type":"text","text":" "},{"type":"text","text":"depend on both ends of the step. Among equal-cost paths, which one is returned is unspecified."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Inside an extension of "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", the methods of the same name hide this function; call it"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"ShortestPaths.dijkstraShortestPath(from:cutoff:successors:success:)"},{"type":"text","text":" there."}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"E