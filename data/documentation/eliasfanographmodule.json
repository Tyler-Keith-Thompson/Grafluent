pe":"text"},{"text":" ","type":"text"},{"code":"EFGraph","type":"codeVoice"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"code":"l","type":"codeVoice"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" targets below ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/CompressedSparseRowModule":{"identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/CompressedSparseRowModule","type":"topic","abstract":[],"title":"CompressedSparseRowModule","role":"collection","url":"\/documentation\/eliasfanographmodule\/compressedsparserowmodule","kind":"symbol"}}}