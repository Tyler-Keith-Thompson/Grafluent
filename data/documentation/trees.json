,{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"url":"\/documentation\/trees\/tree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"type":"topic","title":"Tree","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","kind":"symbol"},"doc://Trees/documentation/Trees/BinaryTree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","type":"topic","abstract":[{"type":"text","text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,"},{"type":"text","text":" "},{"type":"text","text":"by position. A vertex with only a left child is a different tree from one with only a right"},{"type":"text","text":" "},{"type":"text","text":"child. Two binary trees are equal when they have the same root and every vertex has the same"},{"type":"text","text":" "},{"type":"text","text":"left and right children."}],"url":"\/documentation\/trees\/binarytree","title":"BinaryTree","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BinaryTree"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryTree"}]},"doc://Trees/documentation/Trees/GraphProtocols":{"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/trees\/graphprotocols","abstract":[]},"doc://Trees/documentation/Trees/NotATree":{"navigatorTitle":[{"text":"NotATree","kind":"identifier"}],"url":"\/documentation\/trees\/notatree","kind":"symbol","abstract":[{"type":"text","text":"The error a checked conversion throws when its input is not one tree, such as a shortest-path"},{"type":"text","text":" "},{"type":"text","text":"forest grown from several sources given to "},{"code":"Arborescence(checked:)","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/NotATree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NotATree","kind":"identifier"}],"role":"symbol","type":"topic","title":"NotATree"},"doc://Trees/documentation/Trees/Arborescence":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"title":"Arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"type":"topic"},"doc://Trees/documentation/Trees/RootedTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","url":"\/documentation\/trees\/rootedtree","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/PrefixTree":{"role":"symbol","type":"topic","title":"PrefixTree","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/PrefixTree","url":"\/documentation\/trees\/prefixtree","abstract":[{"type":"text","text":"The prefix tree (trie) of some sequences: an arborescence on "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" rooted at 0, the empty"},{"type":"text","text":" "},{"type":"text","text":"prefix, in which each vertex is a distinct prefix of a sequence and each edge appends one"},{"type":"text","text":" "},{"text":"symbol. ","type":"text"},{"type":"codeVoice","code":"prefixTree(of:)"},{"text":" builds it.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrefixTree"}],"navigatorTitle":[{"kind":"identifier","text":"PrefixTree"}]},"doc://Trees/documentation/Trees/AllBinaryTrees":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllBinaryTrees"}],"navigatorTitle":[{"kind":"identifier","text":"AllBinaryTrees"}],"title":"AllBinaryTrees","identifier":"doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","url":"\/documentation\/trees\/allbinarytrees","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Every binary tree on "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" in Knuth’s Algorithm B order, its vertices numbered in preorder:"},{"type":"text","text":" "},{"type":"codeVoice","code":"BinaryTree.allBinaryTrees(vertexCount:)"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/OrderedTree":{"role":"symbol","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"url":"\/documentation\/trees\/orderedtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","title":"OrderedTree","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","kind":"symbol"}}}