pic","url":"\/documentation\/trees\/notatree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NotATree","kind":"identifier"}],"abstract":[{"text":"The error a checked conversion throws when its input is not one tree, such as a shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"forest grown from several sources given to ","type":"text"},{"code":"Arborescence(checked:)","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","type":"topic","url":"\/documentation\/trees\/orderedtree","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"title":"OrderedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}]},"doc://Trees/documentation/Trees/BinaryTree":{"role":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","kind":"symbol","url":"\/documentation\/trees\/binarytree","abstract":[{"type":"text","text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,"},{"type":"text","text":" "},{"type":"text","text":"by position. A vertex with only a left child is a different tree from one with only a right"},{"type":"text","text":" "},{"type":"text","text":"child. Two binary trees are equal when they have the same root and every vertex has the same"},{"type":"text","text":" "},{"type":"text","text":"left and right children."}],"navigatorTitle":[{"text":"BinaryTree","kind":"identifier"}],"title":"BinaryTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryTree","kind":"identifier"}]},"doc://Trees/documentation/Trees/Tree":{"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","role":"symbol","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"navigatorTitle":[{"text":"Tree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"url":"\/documentation\/trees\/tree","kind":"symbol","title":"Tree"},"doc://Trees/documentation/Trees/Arborescence":{"role":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","kind":"symbol","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"title":"Arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}]},"doc://Trees/documentation/Trees/AllBinaryTrees":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllBinaryTrees"}],"url":"\/documentation\/trees\/allbinarytrees","title":"AllBinaryTrees","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AllBinaryTrees"}],"abstract":[{"type":"text","text":"Every binary tree on "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" in Knuth’s Algorithm B order, its vertices numbered in preorder:"},{"type":"text","text":" "},{"code":"BinaryTree.allBinaryTrees(vertexCount:)","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","kind":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"url":"\/documentation\/trees\/rootedtree","type":"topic","title":"RootedTree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},"doc://Trees/documentation/Trees/PrefixTree":{"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/PrefixTree","navigatorTitle":[{"kind":"identifier","text":"PrefixTree"}],"url":"\/documentation\/trees\/prefixtree","abstract":[{"text":"The prefix tree (trie) of some sequences: an arborescence on ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" rooted at 0, the empty","type":"text"},{"text":" ","type":"text"},{"text":"prefix, in which each vertex is a distinct prefix of a sequence and each edge appends one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"symbol. "},{"type":"codeVoice","code":"prefixTree(of:)"},{"type":"text","text":" builds it."}],"kind":"symbol","role":"symbol","title":"PrefixTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrefixTree"}]},"doc://Trees/documentation/Trees/GraphProtocols":{"role":"collection","identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","title":"GraphProtocols","type":"topic","url":"\/documentation\/trees\/graphprotocols","abstract":[],"kind":"symbol"}}}