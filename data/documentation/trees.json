e: a shortest-path forest","type":"text"},{"text":" ","type":"text"},{"text":"grown from several sources, given to ","type":"text"},{"code":"Arborescence(checked:)","type":"codeVoice"},{"text":". Named after","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s ","type":"text"},{"code":"NotATree","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/NotATree","title":"NotATree","navigatorTitle":[{"text":"NotATree","kind":"identifier"}],"url":"\/documentation\/trees\/notatree","type":"topic"},"doc://Trees/documentation/Trees/RootedTree":{"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/rootedtree","title":"RootedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}]},"doc://Trees/documentation/Trees/GraphProtocols":{"kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/Trees\/documentation\/