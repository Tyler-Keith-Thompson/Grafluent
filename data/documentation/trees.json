xt":" "},{"kind":"identifier","text":"RootedTree"}],"kind":"symbol","type":"topic","title":"RootedTree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}]},"doc://Trees/documentation/Trees/Tree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","title":"Tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"kind":"symbol","url":"\/documentation\/trees\/tree","type":"topic"},"doc://Trees/documentation/Trees/Forest":{"role":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"type":"codeVoice","code":"trees"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":" says which one a vertex is in.","type":"text"}],"type":"topic","url":"\/documentation\/trees\/forest","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"title":"Forest","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},"doc://Trees/documentation/Trees/GraphProtocols":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","kind":"symbol","url":"\/documentation\/trees\/graphprotocols","title":"GraphProtocols","