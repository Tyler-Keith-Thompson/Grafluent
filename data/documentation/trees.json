ier":"doc:\/\/Trees\/documentation\/Trees","type":"topic","kind":"symbol","role":"collection","title":"Trees","abstract":[],"url":"\/documentation\/trees"},"doc://Trees/documentation/Trees/Forest":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"title":"Forest","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","type":"topic","kind":"symbol","url":"\/documentation\/trees\/forest","navigatorTitle":[{"kind":"identifier","text":"Forest"}]},"doc://Trees/documentation/Trees/OrderedTree":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"title":"OrderedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","type":"topic","url":"\/documentation\/trees\/orderedtree","kind":"symbol","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}]},"doc://Trees/documentation/Trees/prefixTree(of:)":{"identifier":"doc:\/\/Trees\/documentation\/Tr