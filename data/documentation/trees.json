l when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}]},"doc://Trees/documentation/Trees/Tree":{"kind":"symbol","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"role":"symbol","title":"Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"url":"\/documentation\/trees\/tree","type":"topic","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://Trees/documentation/Trees/NotATree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NotATree"}],"navigatorTitle":[{"kind":"identifier","text":"NotATree"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/NotATree","title":"NotATree","url":"\/documentation\/trees\/notatree","abstract":[{"text":"The error a checked conversion throws when its input is not one tree, such as a shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"forest grown from several sources given to ","type":"text"},{"code":"Arborescence(checked:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://Trees/documentation/Trees/prefixTree(of:)":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/p