{"metadata":{"title":"Trees","roleHeading":"Framework","externalID":"Trees","symbolKind":"module","modules":[{"name":"Trees"}],"role":"collection"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trees"]}],"kind":"symbol","identifier":{"url":"doc:\/\/Trees\/documentation\/Trees","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/Trees\/documentation\/Trees\/Arborescence","doc:\/\/Trees\/documentation\/Trees\/Forest","doc:\/\/Trees\/documentation\/Trees\/RootedTree","doc:\/\/Trees\/documentation\/Trees\/Tree"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/Trees\/documentation\/Trees\/GraphProtocols"],"anchor":"Extended-Modules","generated":true,"title":"Extended Modules"}],"references":{"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"navigatorTitle":[{"kind":"identifier","text":"Forest"}],"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"title":"Forest","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","role":"symbol","kind":"symbol"},"doc://Trees/documentation/Trees/Tree":{"title":"Tree","url":"\/documentation\/trees\/tree","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"kind":"symbol","type":"topic"},"doc://Trees/documentation/Trees/GraphProtocols":{"type":"topic","url":"\/documentation\/trees\/graphprotocols","title":"GraphProtocols","role":"collection","abstract":[],"identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","kind":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","kind":"symbol","role":"symbol","url":"\/documentation\/trees\/rootedtree","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree"},"doc://Trees/documentation/Trees/Arborescence":{"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","title":"Arborescence","type":"topic"},"doc://Trees/documentation/Trees":{"identifier":"doc:\/\/Trees\/documentation\/Trees","url":"\/documentation\/trees","abstract":[],"kind":"symbol","role":"collection","title":"Trees","type":"topic"}}}