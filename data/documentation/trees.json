entifier"}],"url":"\/documentation\/trees\/binarytree","title":"BinaryTree","abstract":[{"text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,","type":"text"},{"text":" ","type":"text"},{"text":"by position. A vertex with only a left child is a different tree from one with only a right","type":"text"},{"text":" ","type":"text"},{"text":"child. Two binary trees are equal when they have the same root and every vertex has the same","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"left and right children."}],"role":"symbol","kind":"symbol"},"doc://Trees/documentation/Trees/Forest":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"title":"Forest","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"url":"\/documentation\/trees\/forest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},"doc://Trees/documentation/Trees/Arborescence":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/trees\/arborescence","type":"topic","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}]},"doc://Trees/documentation/Trees/GraphProtocols":{"kind":"symbol","abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","type":"topic","url":"\/documentation\/trees\/graphprotocols","role":"collection"},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","title":"Tree","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/trees\/tree","type":"topic","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}]},"doc://Trees/documentation/Trees/OrderedTree":{"title":"OrderedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","url":"\/documentation\/trees\/orderedtree","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"kind":"symbol","role":"symbol"},"doc://Trees/documentation/Trees/NotATree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NotATree"}],"kind":"symbol","type":"topic","url":"\/documentation\/trees\/notatree","title":"NotATree","navigatorTitle":[{"kind":"identifier","text":"NotATree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/NotATree","abstract":[{"text":"The error a checked conversion throws when its input is not one tree, such as a shortest-path","type":"text"},{"text":" ","type":"text"},{"text":"forest grown from several sources given to ","type":"text"},{"code":"Arborescence(checked:)","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/rootedtree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},"doc://Trees/documentation/Trees/PrefixTree":{"title":"PrefixTree","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"PrefixTree","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/PrefixTree","abstract":[{"type":"text","text":"The prefix tree (trie) of some sequences: an arborescence on "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" rooted at 0, the empty"},{"type":"text","text":" "},{"type":"text","text":"prefix, in which each vertex is a distinct prefix of a sequence and each edge appends one"},{"type":"text","text":" "},{"text":"symbol. ","type":"text"},{"code":"prefixTree(of:)","type":"codeVoice"},{"text":" builds it.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PrefixTree","kind":"identifier"}],"url":"\/documentation\/trees\/prefixtree"}}}