{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[[]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","doc:\/\/Trees\/documentation\/Trees\/Arborescence","doc:\/\/Trees\/documentation\/Trees\/BinaryTree","doc:\/\/Trees\/documentation\/Trees\/Forest","doc:\/\/Trees\/documentation\/Trees\/NotATree","doc:\/\/Trees\/documentation\/Trees\/OrderedTree","doc:\/\/Trees\/documentation\/Trees\/PrefixTree","doc:\/\/Trees\/documentation\/Trees\/RootedTree","doc:\/\/Trees\/documentation\/Trees\/Tree"],"title":"Structures","anchor":"Structures"},{"generated":true,"identifiers":["doc:\/\/Trees\/documentation\/Trees\/prefixTree(of:)"],"title":"Functions","anchor":"Functions"},{"generated":true,"identifiers":["doc:\/\/Trees\/documentation\/Trees\/GraphProtocols"],"title":"Extended Modules","anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/trees"]}],"metadata":{"externalID":"Trees","roleHeading":"Framework","title":"Trees","symbolKind":"module","modules":[{"name":"Trees"}],"role":"collection"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trees\/documentation\/Trees"},"sections":[],"references":{"doc://Trees/documentation/Trees/AllBinaryTrees":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllBinaryTrees"}],"navigatorTitle":[{"kind":"identifier","text":"AllBinaryTrees"}],"title":"AllBinaryTrees","kind":"symbol","type":"topic","url":"\/documentation\/trees\/allbinarytrees","identifier":"doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","role":"symbol","abstract":[{"text":"Every binary tree on ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in Knuth’s Algorithm B order, its vertices numbered in preorder:","type":"text"},{"text":" ","type":"text"},{"code":"BinaryTree.allBinaryTrees(vertexCount:)","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Trees/documentation/Trees/GraphProtocols":{"role":"collection","url":"\/documentation\/trees\/graphprotocols","identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","type":"topic","abstract":[],"title":"GraphProtocols","kind":"symbol"},"doc://Trees/documentation/Trees/prefixTree(of:)":{"title":"prefixTree(of:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"prefixTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"PrefixTree","preciseIdentifier":"s:5Trees10PrefixTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The prefix tree of "},{"type":"codeVoice","code":"sequences"},{"type":"text","text":": one vertex per distinct prefix (the root, 0, is the empty"},{"type":"text","text":" "},{"type":"text","text":"one), one edge per vertex but the root, labelled with the symbol it appends, and the vertex"},{"type":"text","text":" "},{"type":"text","text":"where each sequence ends. Repeated sequences end at the same vertex, and an empty sequence at"},{"type":"text","text":" "},{"type":"text","text":"the root."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/prefixTree(of:)","url":"\/documentation\/trees\/prefixtree(of:)"},"doc://Trees/documentation/Trees/OrderedTree":{"title":"OrderedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","kind":"symbol","url":"\/documentation\/trees\/orderedtree"},"doc://Trees/documentation/Trees/BinaryTree":{"title":"BinaryTree","url":"\/documentation\/trees\/binarytree","role":"symbol","abstract":[{"type":"text","text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,"},{"type":"text","text":" "},{"type":"text","text":"by position. A vertex with only a left child is a different tree from one with only a right"},{"type":"text","text":" "},{"type":"text","text":"child. Two binary trees are equal when they have the same root and every vertex has the same"},{"type":"text","text":" "},{"text":"left and right children.","type":"text"}],"navigatorTitle":[{"text":"BinaryTree","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryTree","kind":"identifier"}]},"doc://Trees/documentation/Trees/NotATree":{"type":"topic","abstract":[{"type":"text","text":"The error a checked conversion throws when its input is not one tree, such as a shortest-path"},{"type":"text","text":" "},{"type":"text","text":"forest grown from several sources given to "},{"type":"codeVoice","code":"Arborescence(checked:)"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"NotATree","kind":"identifier"}],"title":"NotATree","url":"\/documentation\/trees\/notatree","identifier":"doc:\/\/Trees\/documentation\/Trees\/NotATree","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NotATree","kind":"identifier"}],"role":"symbol"},"doc://Trees/documentation/Trees/Forest":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"navigatorTitle":[{"kind":"identifier","text":"Forest"}],"title":"Forest","kind":"symbol","type":"topic","url":"\/documentation\/trees\/forest","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","role":"symbol","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}]},"doc://Trees/documentation/Trees/Tree":{"title":"Tree","url":"\/documentation\/trees\/tree","role":"symbol","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"navigatorTitle":[{"kind":"identifier","text":"Tree"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}]},"doc://Trees/documentation/Trees":{"title":"Trees","kind":"symbol","type":"topic","url":"\/documentation\/trees","identifier":"doc:\/\/Trees\/documentation\/Trees","role":"collection","abstract":[]},"doc://Trees/documentation/Trees/RootedTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","kind":"symbol","type":"topic","url":"\/documentation\/trees\/rootedtree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","role":"symbol","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/Arborescence":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","url":"\/documentation\/trees\/arborescence","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"title":"Arborescence"},"doc://Trees/documentation/Trees/PrefixTree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/PrefixTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrefixTree"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PrefixTree"}],"title":"PrefixTree","abstract":[{"type":"text","text":"The prefix tree (trie) of some sequences: an arborescence on "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" rooted at 0, the empty"},{"type":"text","text":" "},{"type":"text","text":"prefix, in which each vertex is a distinct prefix of a sequence and each edge appends one"},{"type":"text","text":" "},{"text":"symbol. ","type":"text"},{"type":"codeVoice","code":"prefixTree(of:)"},{"text":" builds it.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/trees\/prefixtree"}}}