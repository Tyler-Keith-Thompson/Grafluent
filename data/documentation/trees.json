xt":" ","type":"text"},{"text":"left and right children.","type":"text"}],"kind":"symbol","url":"\/documentation\/trees\/binarytree","identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BinaryTree"}]},"doc://Trees/documentation/Trees/Tree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}],"title":"Tree","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"topic","kind":"symbol","url":"\/documentation\/trees\/tree","navigatorTitle":[{"kind":"identifier","text":"Tree"}]},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"title":"RootedTree","url":"\/documentation\/trees\/rootedtree","type":"topic","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}]},"doc://Trees/documentation/Trees/Arborescence":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"title":"Arborescence","type":"topic"},"doc://Trees/documentation/Trees/PrefixTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrefixTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/PrefixTree","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PrefixTree"}],"title":"PrefixTree","abstract":[{"type":"text","text":"The prefix tree (trie) of some sequences: an arborescence on "},