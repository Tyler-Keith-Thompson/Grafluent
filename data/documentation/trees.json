ree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"role":"symbol","type":"topic","url":"\/documentation\/trees\/tree","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"kind":"symbol","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}]},"doc://Trees/documentation/Trees/RootedTree":{"title":"RootedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/trees\/rootedtree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"root"},{"text":", ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/Arborescence":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"type":"topic","url":"\/documentation\/trees\/arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence","role":"symbol","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/GraphProtocols":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","url":"\/documentation\/trees\/graphprotocols","title":"GraphProtocols","role":"collection","abstract":[]}}}