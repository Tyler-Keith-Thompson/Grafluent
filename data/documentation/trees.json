ight children."}],"url":"\/documentation\/trees\/binarytree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","title":"BinaryTree"},"doc://Trees/documentation/Trees/GraphProtocols":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","title":"GraphProtocols","role":"collection","kind":"symbol","url":"\/documentation\/trees\/graphprotocols","type":"topic","abstract":[]},"doc://Trees/documentation/Trees/PrefixTree":{"url":"\/documentation\/trees\/prefixtree","type":"topic","title":"PrefixTree","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"PrefixTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/PrefixTree","abstract":[{"type":"text","text":"The prefix tree (trie) of some sequences: an arborescence on "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" rooted at 0, the empty"},{"type":"text","text":" "},{"type":"text","text":"prefix, in which each vertex is a distinct prefix of a sequence and each edge appends one"},{"type":"text","text":" "},{"type":"text","text":"symbol. "},{"type":"codeVoice","code":"prefixTree(of:)"},{"type":"text","text":" builds it."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PrefixTree","kind":"identifier"}]}}}