{"metadata":{"modules":[{"name":"Trees"}],"roleHeading":"Framework","title":"Trees","symbolKind":"module","role":"collection","externalID":"Trees"},"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","doc:\/\/Trees\/documentation\/Trees\/Arborescence","doc:\/\/Trees\/documentation\/Trees\/BinaryTree","doc:\/\/Trees\/documentation\/Trees\/Forest","doc:\/\/Trees\/documentation\/Trees\/NotATree","doc:\/\/Trees\/documentation\/Trees\/OrderedTree","doc:\/\/Trees\/documentation\/Trees\/PrefixTree","doc:\/\/Trees\/documentation\/Trees\/RootedTree","doc:\/\/Trees\/documentation\/Trees\/Tree"]},{"title":"Functions","generated":true,"anchor":"Functions","identifiers":["doc:\/\/Trees\/documentation\/Trees\/prefixTree(of:)"]},{"title":"Extended Modules","generated":true,"anchor":"Extended-Modules","identifiers":["doc:\/\/Trees\/documentation\/Trees\/GraphProtocols"]}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/trees"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Trees\/documentation\/Trees"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Trees/documentation/Trees/OrderedTree":{"kind":"symbol","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"type":"topic","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"title":"OrderedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","url":"\/documentation\/trees\/orderedtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"role":"symbol"},"doc://Trees/documentation/Trees/prefixTree(of:)":{"title":"prefixTree(of:)","kind":"symbol","abstract":[{"type":"text","text":"The prefix tree of "},{"code":"sequences","type":"codeVoice"},{"type":"text","text":": one vertex per distinct prefix (the root, 0, is the empty"},{"type":"text","text":" "},{"type":"text","text":"one), one edge per vertex but the root, labelled with the symbol it appends, and the vertex"},{"type":"text","text":" "},{"type":"text","text":"where each sequence ends. Repeated sequences end at the same vertex, and an empty sequence at"},{"type":"text","text":" "},{"type":"text","text":"the root."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prefixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"PrefixTree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees10PrefixTreeV"},{"text":"<","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":">","kind":"text"}],"url":"\/documentation\/trees\/prefixtree(of:)","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/prefixTree(of:)","type":"topic"},"doc://Trees/documentation/Trees/BinaryTree":{"type":"topic","url":"\/documentation\/trees\/binarytree","navigatorTitle":[{"text":"BinaryTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,"},{"type":"text","text":" "},{"type":"text","text":"by position. A vertex with only a left child is a different tree from one with only a right"},{"type":"text","text":" "},{"type":"text","text":"child. Two binary trees are equal when they have the same root and every vertex has the same"},{"type":"text","text":" "},{"type":"text","text":"left and right children."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree","title":"BinaryTree","kind":"symbol","role":"symbol"},"doc://Trees/documentation/Trees/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/trees\/graphprotocols","kind":"symbol"},"doc://Trees/documentation/Trees/AllBinaryTrees":{"type":"topic","url":"\/documentation\/trees\/allbinarytrees","navigatorTitle":[{"kind":"identifier","text":"AllBinaryTrees"}],"abstract":[{"text":"Every binary tree on ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in Knuth’s Algorithm B order, its vertices numbered in preorder:","type":"text"},{"text":" ","type":"text"},{"code":"BinaryTree.allBinaryTrees(vertexCount:)","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllBinaryTrees"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","title":"AllBinaryTrees","kind":"symbol","role":"symbol"},"doc://Trees/documentation/Trees/Forest":{"kind":"symbol","url":"\/documentation\/trees\/forest","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"type":"topic","title":"Forest","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"ty