{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","topicSections":[{"title":"Structures","identifiers":["doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","doc:\/\/Trees\/documentation\/Trees\/Arborescence","doc:\/\/Trees\/documentation\/Trees\/BinaryTree","doc:\/\/Trees\/documentation\/Trees\/Forest","doc:\/\/Trees\/documentation\/Trees\/NotATree","doc:\/\/Trees\/documentation\/Trees\/OrderedTree","doc:\/\/Trees\/documentation\/Trees\/PrefixTree","doc:\/\/Trees\/documentation\/Trees\/RootedTree","doc:\/\/Trees\/documentation\/Trees\/Tree"],"generated":true,"anchor":"Structures"},{"title":"Functions","identifiers":["doc:\/\/Trees\/documentation\/Trees\/prefixTree(of:)"],"generated":true,"anchor":"Functions"},{"title":"Extended Modules","identifiers":["doc:\/\/Trees\/documentation\/Trees\/GraphProtocols"],"generated":true,"anchor":"Extended-Modules"}],"metadata":{"title":"Trees","role":"collection","externalID":"Trees","modules":[{"name":"Trees"}],"roleHeading":"Framework","symbolKind":"module"},"identifier":{"url":"doc:\/\/Trees\/documentation\/Trees","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/trees"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Trees/documentation/Trees":{"identifier":"doc:\/\/Trees\/documentation\/Trees","abstract":[],"title":"Trees","url":"\/documentation\/trees","kind":"symbol","type":"topic","role":"collection"},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}],"navigatorTitle":[{"kind":"identifier","text":"Tree"}],"title":"Tree","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"kind":"symbol","type":"topic","url":"\/documentation\/trees\/tree"},"doc://Trees/documentation/Trees/Arborescence":{"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","title":"Arborescence","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent. As a ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}]},"doc://Trees/documentation/Trees/BinaryTree":{"kind":"symbol","navigatorTitle":[{"text":"BinaryTree","kind":"identifier"}],"type":"topic","title":"BinaryTree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BinaryTree","kind":"identifier"}],"url":"\/documentation\/trees\/binarytree","abstract":[{"type":"text","text":"A binary tree: a rooted tree in which each vertex has at most a left child and a right child,"},{"type":"text","text":" "},{"type":"text","text":"by position. A vertex with only a left child is a different tree from one with only a right"},{"type":"text","text":" "},{"type":"text","text":"child. Two binary trees are equal when they have the same root and every vertex has the same"},{"type":"text","text":" "},{"type":"text","text":"left and right children."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/BinaryTree"},"doc://Trees/documentation/Trees/AllBinaryTrees":{"role":"symbol","url":"\/documentation\/trees\/allbinarytrees","identifier":"doc:\/\/Trees\/documentation\/Trees\/AllBinaryTrees","type":"topic","kind":"symbol","title":"AllBinaryTrees","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllBinaryTrees","kind":"identifier"}],"navigatorTitle":[{"text":"AllBinaryTrees","kind":"identifier"}],"abstract":[{"text":"Every binary tree on ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" in Knuth’s Algorithm B order, its vertices numbered in preorder:","type":"text"},{"text":" ","type":"text"},{"code":"BinaryTree.allBinaryTrees(vertexCount:)","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Trees/documentation/Trees/Forest":{"kind":"symbol","title":"Forest","abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","url":"\/documentation\/trees\/forest","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"type":"topic"},"doc://Trees/documentation/Trees/prefixTree(of:)":{"title":"prefixTree(of:)","role":"symbol","abstract":[{"text":"The prefix tree of ","type":"text"},{"type":"codeVoice","code":"sequences"},{"text":": one vertex per distinct prefix (the root, 0, is the empty","type":"text"},{"text":" ","type":"text"},{"text":"one), one edge per vertex but the root, labelled with the symbol it appends, and the vertex","type":"text"},{"text":" ","type":"text"},{"text":"where each sequence ends. Repeated sequences end at the same vertex, and an empty sequence at","type":"text"},{"text":" ","type":"text"},{"text":"the root.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/prefixTree(of:)","url":"\/documentation\/trees\/prefixtree(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prefixTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"PrefixTree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees10PrefixTreeV"},{"text":"<","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":">","kind":"text"}],"type":"topic","kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","type":"topic","role":"symbol","url":"\/documentation\/trees\/orderedtree","title":"OrderedTree","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}]},"doc://Trees/documentation/Trees/PrefixTree":{"title":"PrefixTree","abstract":[{"type":"text","text":"The prefix tree (trie) of some sequences: an arborescence on "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" rooted at 0, the empty"},{"type":"text","text":" "},{"type":"text","text":"prefix, in which each vertex is a distinct prefix of a sequence and each edge appends one"},{"type":"text","text":" "},{"type":"text","text":"symbol. "},{"type":"codeVoice","code":"prefixTree(of:)"},{"type":"text","text":" builds it."}],"navigatorTitle":[{"text":"PrefixTree","kind":"identifier"}],"url":"\/documentation\/trees\/prefixtree","type":"topic","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/PrefixTree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PrefixTree","kind":"identifier"}]},"doc://Trees/documentation/Trees/NotATree":{"abstract":[{"type":"text","text":"The error a checked conversion throws when its input is not one tree, such as a shortest-path"},{"type":"text","text":" "},{"type":"text","text":"forest grown from several sources given to "},{"type":"codeVoice","code":"Arborescence(checked:)"},{"type":"text","text":"."}],"title":"NotATree","identifier":"doc:\/\/Trees\/documentation\/Trees\/NotATree","type":"topic","url":"\/documentation\/trees\/notatree","navigatorTitle":[{"kind":"identifier","text":"NotATree"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NotATree"}],"kind":"symbol"},"doc://Trees/documentation/Trees/GraphProtocols":{"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/GraphProtocols","title":"GraphProtocols","abstract":[],"url":"\/documentation\/trees\/graphprotocols","role":"collection","type":"topic"},"doc://Trees/documentation/Trees/RootedTree":{"title":"RootedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/trees\/rootedtree"}}}