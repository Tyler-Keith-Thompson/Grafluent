{"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"It is a lawful ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs on it, including those that need","type":"text"},{"text":" ","type":"text"},{"text":"the whole vertex set (components, centrality), with no edge storage.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"text":". For ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"text":". A grid is numbered row-major.","type":"text"}]},{"level":2,"type":"heading","text":"The closure","anchor":"The-closure"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"successors(v)"},{"type":"text","text":" lists the targets of the edges leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":", once per edge, as any"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sequence<Int>"},{"type":"text","text":", such as an array or a lazy filter over a fixed neighbor list. A specialized"},{"type":"text","text":" "},{"type":"text","text":"build inlines it with no type erasure. Each read of a row calls it once. "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" call it once each, and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" once per vertex."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure must return the same sequence each time it is asked about the same vertex. This is"},{"type":"text","text":" "},{"type":"text","text":"not checked, and a closure that breaks it breaks every algorithm. Each target is checked to be a"},{"type":"text","text":" "},{"type":"text","text":"vertex when it is read, not when the row is formed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and yields"},{"type":"text","text":" "},{"type":"text","text":"them by count. A "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" calls its predicate per element and carries the unfiltered"},{"type":"text","text":" "},{"type":"text","text":"iterator’s state, which costs more per edge."}]},{"level":2,"type":"heading","text":"Positions","anchor":"Positions"},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":", which holds its source, its rank in the source’s row, and","type":"text"},{"text":" ","type":"text"},{"text":"its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", which is unique even among","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges and self-loops. Because the position carries the target, ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense","type":"text"},{"text":" ","type":"text"},{"text":"edge indices.","type":"text"}]},{"level":2,"type":"heading","text":"Attached values","anchor":"Attached-values"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is not a "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":", because "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":" has a dense offset only after every"},{"type":"text","text":" "},{"type":"text","text":"earlier row is counted. Keep vertex values in an array of "},{"type":"codeVoice","code":"vertexCount"},{"type":"text","text":" indexed by vertex, and"},{"type":"text","text":" "},{"type":"text","text":"compute edge values from the position ("},{"type":"codeVoice","code":"$0.source"},{"type":"text","text":", "},{"type":"codeVoice","code":"$0.target"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is not "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", because a closure has no"},{"type":"text","text":" "},{"type":"text","text":"identity and is not "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":"."}]}]}],"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"metadata":{"modules":[{"name":"ImplicitGraphs"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L48"},"externalID":"s:14ImplicitGraphs0A13DirectedGraphV","symbolKind":"struct","roleHeading":"Structure","title":"ImplicitDirectedGraph"},"kind":"symbol","relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"kind":"relationships","type":"conformsTo"}],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","type":"topic","navigatorTitle":[{"text":"Successors","kind":"identifier"}],"abstract":[{"text":"The closure’s row for one vertex, each target checked to be a vertex as it is read.","type":"text"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","kind":"symbol","title":"Implicit