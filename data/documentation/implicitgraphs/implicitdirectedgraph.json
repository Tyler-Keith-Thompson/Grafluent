{"sections":[],"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"type":"codeVoice","code":"grid_graph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GridGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FullGraph"},{"type":"text","text":"). It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"ImplicitDirectedGraph","modules":[{"name":"ImplicitGraphs"}],"navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"symbolKind":"struct","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","roleHeading":"Structure","remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L38"},"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}]},"topicSections":[{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" == "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure"},{"type":"text","text":" "},{"type":"text","text":"searches instead: Traversal’s "},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"type":"text","text":" and ShortestPaths’"},{"type":"text","text":" "},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"type":"text","text":". For "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" states over a finite set, number them and use"},{"type":"text","text":" "},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"type":"text","text":"; a grid is numbered row-major."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"The closure.","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(v)"},{"type":"text","text":" lists the targets of the edges leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":", once per edge, as"},{"type":"text","text":" "},{"type":"text","text":"any "},{"type":"codeVoice","code":"Sequence<Int>"},{"type":"text","text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build"},{"type":"text","text":" "},{"type":"text","text":"inlines it with no type erasure. Each read of a row calls it once: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" once each, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"text","text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a"},{"type":"text","text":" "},{"type":"text","text":"closure that breaks it breaks every algorithm, as a mutating "},{"type":"codeVoice","code":"=="},{"type":"text","text":" breaks "},{"type":"codeVoice","code":"Set"},{"type":"text","text":". Each target is"},{"type":"text","text":" "},{"type":"text","text":"checked to be a vertex when it is read, not when the row is formed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and"},{"type":"text","text":" "},{"type":"text","text":"yields them by count, rather than a "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" over a fixed neighbor list: the filter calls"},{"type":"text","text":" "},{"type":"text","text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a"},{"type":"text","text":" "},{"type":"text","text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra)."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Positions.","type":"text"}],"type":"strong"},{"type":"text","text":" An edge’s position is "},{"code":"Edges.Index","type":"codeVoice"},{"type":"text","text":": its source, its rank in the source’s row,"},{"type":"text","text":" "},{"type":"text","text":"and its target. Equality, order and hashing use "},{"code":"(source, rank)","type":"codeVoice"},{"type":"text","text":", unique even among parallel"},{"type":"text","text":" "},{"type":"text","text":"edges and self-loops; the target rides along, so "},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"type":"text","text":"weight closure reading "},{"code":"$0.target","type":"codeVoice"},{"type":"text","text":" call nothing. There are no dense edge indices."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":": a closure has no identity and is not"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":"."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"type":"topic","title":"ImplicitDirectedGraph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}]},"doc://ImplicitGraphs/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/ImplicitGraphs\/s8CopyableP"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","title":"DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/directedgraph"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"type":"topic","title":"ImplicitDirectedGraph.Successors","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/init(vertexCount:successors:)":{"type":"topic","abstract":[{"type":"text","text":"The graph on "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors of "},{"type":"codeVoice","code":"v"},{"type":"text","text":" are "},{"type":"codeVoice","code":"successors(v)"},{"text":". O(1): calls","type":"text"},{"text":" ","type":"text"},{"text":"nothing.","type":"text"}],"title":"init(vertexCount:successors:)","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/init(vertexcount:successors:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"successors","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)","role":"symbol","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"abstract":[],"role":"collection","url":"\/documentation\/implicitgraphs","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","kind":"symbol","title":"ImplicitGraphs","type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"kind":"symbol","title":"ImplicitDirectedGraph.OutEdges","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The positions of the edges leaving one vertex, in row order: ranks 0, 1, …, each with its"},{"type":"text","text":" "},{"type":"text","text":"target, checked to be a vertex as it is read."}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/outedges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}],"navigatorTitle":[{"text":"OutEdges","kind":"identifier"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/DirectedGraph-Implementations":{"type":"topic","kind":"article","title":"DirectedGraph Implementations","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/directedgraph-implementations","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations","role":"collectionGroup","abstract":[]},"doc://ImplicitGraphs/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/ImplicitGraphs\/s9EscapableP","title":"Swift.Escapable"}}}