{"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"text":". For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"text":"; a grid is numbered row-major.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The closure.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"successors(v)","type":"codeVoice"},{"text":" lists the targets of the edges leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", once per edge, as","type":"text"},{"text":" ","type":"text"},{"text":"any ","type":"text"},{"code":"Sequence<Int>","type":"codeVoice"},{"text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build","type":"text"},{"text":" ","type":"text"},{"text":"inlines it with no type erasure. Each read of a row calls it once: ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" once each, ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the","type":"text"},{"text":" ","type":"text"},{"text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a","type":"text"},{"text":" ","type":"text"},{"text":"closure that breaks it breaks every algorithm, as a mutating ","type":"text"},{"code":"==","type":"codeVoice"},{"text":" breaks ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":". Each target is","type":"text"},{"text":" ","type":"text"},{"text":"checked to be a vertex when it is read, not when the row is formed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and"},{"type":"text","text":" "},{"type":"text","text":"yields them by count, rather than a "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" over a fixed neighbor list: the filter calls"},{"type":"text","text":" "},{"type":"text","text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a"},{"type":"text","text":" "},{"type":"text","text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra)."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positions."}]},{"text":" An edge’s position is ","type":"text"},{"type":"codeVoice","code":"Edges.Index"},{"text":": its source, its rank in the source’s row,","type":"text"},{"text":" ","type":"text"},{"text":"and its target. Equality, order and hashing use ","type":"text"},{"type":"codeVoice","code":"(source, rank)"},{"text":", unique even among parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges and self-loops; the target rides along, so ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"text":"weight closure reading ","type":"text"},{"type":"codeVoice","code":"$0.target"},{"text":" call nothing. There are no dense edge indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":": a closure has no identity and is not","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"text":".","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"type":"codeVoice","code":"grid_graph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GridGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FullGraph"},{"type":"text","text":"). It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"metadata":{"modules":[{"name":"ImplicitGraphs"}],"symbolKind":"struct","title":"ImplicitDirectedGraph","remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L38"},"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"externalID":"s:14ImplicitGraphs0A13DirectedGraphV","roleHeading":"Structure"},"sections":[],"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP"]}],"variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","title":"ImplicitGraphs","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/implicitgraphs","role":"collection"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"code":"grid_graph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GridGraph"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"FullGraph"},{"text":"). It is a lawful ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirected