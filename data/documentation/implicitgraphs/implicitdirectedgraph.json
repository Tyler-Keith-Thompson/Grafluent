{"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"type":"codeVoice","code":"grid_graph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GridGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FullGraph"},{"type":"text","text":"). It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure"},{"type":"text","text":" "},{"type":"text","text":"searches instead: Traversal’s "},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"type":"text","text":" and ShortestPaths’"},{"type":"text","text":" "},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"type":"text","text":". For "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" states over a finite set, number them and use"},{"type":"text","text":" "},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"type":"text","text":"; a grid is numbered row-major."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"The closure.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"successors(v)","type":"codeVoice"},{"text":" lists the targets of the edges leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", once per edge, as","type":"text"},{"text":" ","type":"text"},{"text":"any ","type":"text"},{"code":"Sequence<Int>","type":"codeVoice"},{"text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build","type":"text"},{"text":" ","type":"text"},{"text":"inlines it with no type erasure. Each read of a row calls it once: ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" once each, ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the","type":"text"},{"text":" ","type":"text"},{"text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a","type":"text"},{"text":" ","type":"text"},{"text":"closure that breaks it breaks every algorithm, as a mutating ","type":"text"},{"code":"==","type":"codeVoice"},{"text":" breaks ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":". Each target is","type":"text"},{"text":" ","type":"text"},{"text":"checked to be a vertex when it is read, not when the row is formed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and"},{"type":"text","text":" "},{"type":"text","text":"yields them by count, rather than a "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" over a fixed neighbor list: the filter calls"},{"type":"text","text":" "},{"type":"text","text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a"},{"type":"text","text":" "},{"type":"text","text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra)."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Positions.","type":"text"}],"type":"strong"},{"text":" An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":": its source, its rank in the source’s row,","type":"text"},{"text":" ","type":"text"},{"text":"and its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", unique even among parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges and self-loops; the target rides along, so ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"text":"weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense edge indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":": a closure has no identity and is not","type":"text"},{"text":" ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"externalID":"s:14ImplicitGraphs0A13DirectedGraphV","symbolKind":"struct","role":"symbol","remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L38"},"roleHeading":"Structure","title":"ImplicitDirectedGraph","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"modules":[{"name":"ImplicitGraphs"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGrap