{"metadata":{"title":"ImplicitDirectedGraph","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L48","fileName":"ImplicitDirectedGraph.swift"},"role":"symbol","roleHeading":"Structure","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","modules":[{"name":"ImplicitGraphs"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"It is a lawful ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", so every generic algorithm runs on it, including those that need","type":"text"},{"text":" ","type":"text"},{"text":"the whole vertex set (components, centrality), with no edge storage.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"text":". For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"text":". A grid is numbered row-major.","type":"text"}]},{"level":2,"anchor":"The-closure","type":"heading","text":"The closure"},{"type":"paragraph","inlineContent":[{"code":"successors(v)","type":"codeVoice"},{"type":"text","text":" lists the targets of the edges leaving "},{"code":"v","type":"codeVoice"},{"type":"text","text":", once per edge, as any"},{"type":"text","text":" "},{"code":"Sequence<Int>","type":"codeVoice"},{"type":"text","text":", such as an array or a lazy filter over a fixed neighbor list. A specialized"},{"type":"text","text":" "},{"type":"text","text":"build inlines it with no type erasure. Each read of a row calls it once. "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"outEdges(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"outDegree(of:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"contains(edge:)","type":"codeVoice"},{"type":"text","text":" call it once each, and "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" once per vertex."}]},{"type":"paragraph","inlineContent":[{"text":"The closure must return the same sequence each time it is asked about the same vertex. This is","type":"text"},{"text":" ","type":"text"},{"text":"not checked, and a closure that breaks it breaks every algorithm. Each target is checked to be a","type":"text"},{"text":" ","type":"text"},{"text":"vertex when it is read, not when the row is formed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On a hot path, return a small struct that computes the row up front into fixed slots and yields","type":"text"},{"text":" ","type":"text"},{"text":"them by count. A ","type":"text"},{"code":"lazy.filter","type":"codeVoice"},{"text":" calls its predicate per element and carries the unfiltered","type":"text"},{"text":" ","type":"text"},{"text":"iterator’s state, which costs more per edge.","type":"text"}]},{"level":2,"anchor":"Positions","type":"heading","text":"Positions"},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":", which holds its source, its rank in the source’s row, and","type":"text"},{"text":" ","type":"text"},{"text":"its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", which is unique even among","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges and self-loops. Because the position carries the target, ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense","type":"text"},{"text":" ","type":"text"},{"text":"edge indices.","type":"text"}]},{"level":2,"anchor":"Attached-values","type":"heading","text":"Attached values"},{"type":"paragraph","inlineContent":[{"text":"The graph is not a ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":", because ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":" has a dense offset only after every","type":"text"},{"text":" ","type":"text"},{"text":"earlier row is counted. Keep vertex values in an array of ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" indexed by vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"compute edge values from the position (","type":"text"},{"code":"$0.source","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph is not "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", because a closure has no"},{"type":"text","text":" "},{"type":"text","text":"identity and is not "},{"code":"@Sendable","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked: