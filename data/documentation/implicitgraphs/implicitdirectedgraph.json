"kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/init(vertexcount:successors:)","abstract":[{"type":"text","text":"The graph on "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors of "},{"code":"v","type":"codeVoice"},{"type":"text","text":" are "},{"code":"successors(v)","type":"codeVoice"},{"type":"text","text":". O(1): calls"},{"type":"text","text":" "},{"type":"text","text":"nothing."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/outedges","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","title":"ImplicitDirectedGraph.OutEdges","abstract":[{"type":"text","text":"The positions of the edges leaving one vertex, in row order: ranks 0, 1, …, each with its"},{"type":"text","text":" "},{"type":"text","text":"target, checked to be a vertex as it is read."}],"navigatorTitle":[{"text":"OutEdges","kind":"identifier"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/DirectedGraph-Implementations":{"role":"collectionGroup","title":"DirectedGraph Implementations","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations","kind":"article","type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/directedgraph-implementations","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","typ