 is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"type":"topic"},"doc://ImplicitGraphs/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/ImplicitGraphs\/s8CopyableP"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/vertexIndex(checked:)":{"title":"vertexIndex(checked:)","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertexIndex"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/vertexindex(checked:)","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Row","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sequence","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Row.Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}]},"abstract":[{"type":"codeVoice","code":"vertexIndex(of: vertex)"},{"type":"text","text":", throwing instead o