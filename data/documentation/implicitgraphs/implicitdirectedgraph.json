{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","title":"ImplicitDirectedGraph","roleHeading":"Structure","symbolKind":"struct","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","modules":[{"name":"ImplicitGraphs"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L43"}},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"text":". For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"text":"; a grid is numbered row-major.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"The closure.","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(v)"},{"type":"text","text":" lists the targets of the edges leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":", once per edge, as"},{"type":"text","text":" "},{"type":"text","text":"any "},{"type":"codeVoice","code":"Sequence<Int>"},{"type":"text","text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build"},{"type":"text","text":" "},{"type":"text","text":"inlines it with no type erasure. Each read of a row calls it once: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" once each, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"text","text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a"},{"type":"text","text":" "},{"type":"text","text":"closure that breaks it breaks every algorithm, as a mutating "},{"type":"codeVoice","code":"=="},{"type":"text","text":" breaks "},{"type":"codeVoice","code":"Set"},{"type":"text","text":". Each target is"},{"type":"text","text":" "},{"type":"text","text":"checked to be a vertex when it is read, not when the row is formed."}]},{"type":"paragraph","inlineContent":[{"text":"On a hot path, return a small struct that computes the row up front into fixed slots and","type":"text"},{"text":" ","type":"text"},{"text":"yields them by count, rather than a ","type":"text"},{"code":"lazy.filter","type":"codeVoice"},{"text":" over a fixed neighbor list: the filter calls","type":"text"},{"text":" ","type":"text"},{"text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a","type":"text"},{"text":" ","type":"text"},{"text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra).","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Positions."}],"type":"strong"},{"text":" An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":": its source, its rank in the source’s row,","type":"text"},{"text":" ","type":"text"},{"text":"and its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", unique even among parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges and self-loops; the target rides along, so ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"text":"weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense edge indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No attached maps."}]},{"type":"text","text":" It is not a "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":": an edge map needs a dense offset for each"},{"type":"text","text":" "},{"type":"text","text":"position, which "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":" has only after counting every earlier row. Vertex values fit"},{"type":"text","text":" "},{"type":"text","text":"an array of "},{"type":"codeVoice","code":"vertexCount"},{"type":"text","text":" indexed by vertex, which nothing ever invalidates, and edge values"},{"type":"text","text":" "},{"type":"text","text":"come from the position ("},{"type":"codeVoice","code":"$0.source"},{"type":"text","text":", "},{"type":"codeVoice","code":"$0.target"},{"type":"text","text":"), as a grid’s weights do."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":": a closure has no identity and is not"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"sections":[],"variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"code":"grid_graph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"GridGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FullGraph","type":"codeVoice"},{"text":"). It is a lawful ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"title":"Structures"},{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documenta