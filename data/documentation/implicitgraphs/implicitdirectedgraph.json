{"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"kind":"symbol","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"type":"codeVoice","code":"grid_graph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GridGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FullGraph"},{"type":"text","text":"). It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"]}],"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","modules":[{"name":"ImplicitGraphs"}],"title":"ImplicitDirectedGraph","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L38","fileName":"ImplicitDirectedGraph.swift"}},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":" == ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure"},{"type":"text","text":" "},{"type":"text","text":"searches instead: Traversal’s "},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"type":"text","text":" and ShortestPaths’"},{"type":"text","text":" "},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"type":"text","text":". For "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" states over a finite set, number them and use"},{"type":"text","text":" "},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"type":"text","text":"; a grid is numbered row-major."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"The closure.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(v)"},{"type":"text","text":" lists the targets of the edges leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":", once per edge, as"},{"type":"text","text":" "},{"type":"text","text":"any "},{"type":"codeVoice","code":"Sequence<Int>"},{"type":"text","text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build"},{"type":"text","text":" "},{"type":"text","text":"inlines it with no type erasure. Each read of a row calls it once: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" once each, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"text","text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a"},{"type":"text","text":" "},{"type":"text","text":"closure that breaks it breaks every algorithm, as a mutating "},{"type":"codeVoice","code":"=="},{"type":"text","text":" breaks "},{"type":"codeVoice","code":"Set"},{"type":"text","text":". Each target is"},{"type":"text","text":" "},{"type":"text","text":"checked to be a vertex when it is read, not when the row is formed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and"},{"type":"text","text":" "},{"type":"text","text":"yields them by count, rather than a "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" over a fixed neighbor list: the filter calls"},{"type":"text","text":" "},{"type":"text","text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a"},{"type":"text","text":" "},{"type":"text","text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra)."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Positions."}],"type":"strong"},{"text":" An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":": its source, its rank in the source’s row,","type":"text"},{"text":" ","type":"text"},{"text":"and its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", unique even among parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges and self-loops; the target rides along, so ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"text":"weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense edge indices.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":": a closure has no identity and is not","type":"text"},{"text":" ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"]}],"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"kind":"symbol","type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","abstract":[{"text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not","type":"text"},{"text":" ","type":"text"},{"text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an","type":"text"},{"text":" ","type":"text"},{"text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"title":"ImplicitDirectedGraph.Successors","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"},"doc://ImplicitGrap