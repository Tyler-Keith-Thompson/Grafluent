{"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored."}],"topicSections":[{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"It is a lawful ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs on it, including those that need","type":"text"},{"text":" ","type":"text"},{"text":"the whole vertex set (components, centrality), with no edge storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure"},{"type":"text","text":" "},{"type":"text","text":"searches instead: Traversal’s "},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"type":"text","text":" and ShortestPaths’"},{"type":"text","text":" "},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"type":"text","text":". For "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" states over a finite set, number them and use"},{"type":"text","text":" "},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"type":"text","text":". A grid is numbered row-major."}],"type":"paragraph"},{"text":"The closure","level":2,"anchor":"The-closure","type":"heading"},{"inlineContent":[{"code":"successors(v)","type":"codeVoice"},{"text":" lists the targets of the edges leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", once per edge, as any","type":"text"},{"text":" ","type":"text"},{"code":"Sequence<Int>","type":"codeVoice"},{"text":", such as an array or a lazy filter over a fixed neighbor list. A specialized","type":"text"},{"text":" ","type":"text"},{"text":"build inlines it with no type erasure. Each read of a row calls it once. ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" call it once each, and ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" once per vertex.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The closure must return the same sequence each time it is asked about the same vertex. This is","type":"text"},{"text":" ","type":"text"},{"text":"not checked, and a closure that breaks it breaks every algorithm. Each target is checked to be a","type":"text"},{"text":" ","type":"text"},{"text":"vertex when it is read, not when the row is formed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and yields"},{"type":"text","text":" "},{"type":"text","text":"them by count. A "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" calls its predicate per element and carries the unfiltered"},{"type":"text","text":" "},{"type":"text","text":"iterator’s state, which costs more per edge."}],"type":"paragraph"},{"text":"Positions","level":2,"anchor":"Positions","type":"heading"},{"inlineContent":[{"type":"text","text":"An edge’s position is "},{"code":"Edges.Index","type":"codeVoice"},{"type":"text","text":", which holds its source, its rank in the source’s row, and"},{"type":"text","text":" "},{"type":"text","text":"its target. Equality, order and hashing use "},{"code":"(source, rank)","type":"codeVoice"},{"type":"text","text":", which is unique even among"},{"type":"text","text":" "},{"type":"text","text":"parallel edges and self-loops. Because the position carries the target, "},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" and a weight closure reading "},{"code":"$0.target","type":"codeVoice"},{"type":"text","text":" call nothing. There are no dense"},{"type":"text","text":" "},{"type":"text","text":"edge indices."}],"type":"paragraph"},{"text":"Attached values","level":2,"anchor":"Attached-values","type":"heading"},{"inlineContent":[{"type":"text","text":"The graph is not a "},{"code":"PropertyGraph","type":"codeVoice"},{"type":"text","text":", because "},{"code":"(source, rank)","type":"codeVoice"},{"type":"text","text":" has a dense offset only after every"},{"type":"text","text":" "},{"type":"text","text":"earlier row is counted. Keep vertex values in an array of "},{"code":"vertexCount","type":"codeVoice"},{"type":"text","text":" indexed by vertex, and"},{"type":"text","text":" "},{"type":"text","text":"compute edge values from the position ("},{"code":"$0.source","type":"codeVoice"},{"type":"text","text":", "},{"code":"$0.target","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"The graph is not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":", because a closure has no","type":"text"},{"text":" ","type":"text"},{"text":"identity and is not ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L48"},"symbolKind":"struct","roleHeading":"Structure","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","title":"ImplicitDirectedGraph","modules":[{"name":"ImplicitGraphs"}]},"sections":[],"variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/init(vertexCount:successors:)":{"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"successors"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":")"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/init(vertexcount:successors:)","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)","kind":"symbol","role":"symbol","title":"init(vertexCount:successors:)","abstract":[{"type":"text","text":"The graph on "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" in which the out-neighbors of "},{"code":"v","type":"codeVoice"},{"type":"text","text":" are "},{"code":"successors(v)","type":"codeVoice"},{"type":"text","text":". O(1)."},{"type":"text","text":" "},{"type":"text","text":"The closure is not called."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read."}],"navigatorTitle":[{"text":"Successors","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","title":"ImplicitDirectedGraph.Successors","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/outDegree(checked:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","role":"symbol","abstract":[{"type":"codeVoice","code":"outDegree(of: vertex)"},{"type":"text","text":", throwing instead of trapping when "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" is not in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". One call, O(d)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outDegree"},{"kind":"text","text":