{"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored."}],"topicSections":[{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"It is a lawful ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs on it, including those that need","type":"text"},{"text":" ","type":"text"},{"text":"the whole vertex set (components, centrality), with no edge storage.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"text":". For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"text":". A grid is numbered row-major.","type":"text"}]},{"type":"heading","text":"The closure","level":2,"anchor":"The-closure"},{"type":"paragraph","inlineContent":[{"code":"successors(v)","type":"codeVoice"},{"type":"text","text":" lists the targets of the edges leaving "},{"code":"v","type":"codeVoice"},{"type":"text","text":", once per edge, as any"},{"type":"text","text":" "},{"code":"Sequence<Int>","type":"codeVoice"},{"type":"text","text":", such as an array or a lazy filter over a fixed neighbor list. A specialized"},{"type":"text","text":" "},{"type":"text","text":"build inlines it with no type erasure. Each read of a row calls it once. "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"outEdges(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"outDegree(of:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"contains(edge:)","type":"codeVoice"},{"type":"text","text":" call it once each, and "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" once per vertex."}]},{"type":"paragraph","inlineContent":[{"text":"The closure must return the same sequence each time it is asked about the same vertex. This is","type":"text"},{"text":" ","type":"text"},{"text":"not checked, and a closure that breaks it breaks every algorithm. Each target is checked to be a","type":"text"},{"text":" ","type":"text"},{"text":"vertex when it is read, not when the row is formed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and yields"},{"type":"text","text":" "},{"type":"text","text":"them by count. A "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" calls its predicate per element and carries the unfiltered"},{"type":"text","text":" "},{"type":"text","text":"iterator’s state, which costs more per edge."}]},{"type":"heading","text":"Positions","level":2,"anchor":"Positions"},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":", which holds its source, its rank in the source’s row, and","type":"text"},{"text":" ","type":"text"},{"text":"its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", which is unique even among","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges and self-loops. Because the position carries the target, ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense","type":"text"},{"text":" ","type":"text"},{"text":"edge indices.","type":"text"}]},{"type":"heading","text":"Attached values","level":2,"anchor":"Attached-values"},{"type":"paragraph","inlineContent":[{"text":"The graph is not a ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":", because ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":" has a dense offset only after every","type":"text"},{"text":" ","type":"text"},{"text":"earlier row is counted. Keep vertex values in an array of ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" indexed by vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"compute edge values from the position (","type":"text"},{"code":"$0.source","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The graph is not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":", because a closure has no","type":"text"},{"text":" ","type":"text"},{"text":"identity and is not ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"text":".","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"kind":"symbol","metadata":{"modules":[{"name":"ImplicitGraphs"}],"title":"ImplicitDirectedGraph","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L48","fileName":"ImplicitDirectedGraph.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"externalID":"s:14ImplicitGraphs0A13DirectedGraphV","roleHeading":"Structure","role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}]},"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"references":{"doc://ImplicitGraphs/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/ImplicitGraphs\/s8CopyableP"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","title":"ImplicitDirectedGraph","abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitD