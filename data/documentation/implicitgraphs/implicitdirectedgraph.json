{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"symbol","roleHeading":"Structure","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"title":"ImplicitDirectedGraph","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L48","fileName":"ImplicitDirectedGraph.swift"},"externalID":"s:14ImplicitGraphs0A13DirectedGraphV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"modules":[{"name":"ImplicitGraphs"}]},"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored."}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"title":"Structures","generated":true},{"anchor":"Initializers","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"title":"Instance Properties","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"title":"Instance Methods","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"title":"Default Implementations","generated":true}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"title":"Conforms To","type":"conformsTo"}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs on it, including those that need"},{"type":"text","text":" "},{"type":"text","text":"the whole vertex set (components, centrality), with no edge storage."}]},{"type":"paragraph","inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"text":". For ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"text":". A grid is numbered row-major.","type":"text"}]},{"anchor":"The-closure","type":"heading","level":2,"text":"The closure"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"successors(v)"},{"type":"text","text":" lists the targets of the edges leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":", once per edge, as any"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sequence<Int>"},{"type":"text","text":", such as an array or a lazy filter over a fixed neighbor list. A specialized"},{"type":"text","text":" "},{"type":"text","text":"build inlines it with no type erasure. Each read of a row calls it once. "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" call it once each, and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" once per vertex."}]},{"type":"paragraph","inlineContent":[{"text":"The closure must return the same sequence each time it is asked about the same vertex. This is","type":"text"},{"text":" ","type":"text"},{"text":"not checked, and a closure that breaks it breaks every algorithm. Each target is checked to be a","type":"text"},{"text":" ","type":"text"},{"text":"vertex when it is read, not when the row is formed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On a hot path, return a small struct that computes the row up front into fixed slots and yields","type":"text"},{"text":" ","type":"text"},{"text":"them by count. A ","type":"text"},{"code":"lazy.filter","type":"codeVoice"},{"text":" calls its predicate per element and carries the unfiltered","type":"text"},{"text":" ","type":"text"},{"text":"iterator’s state, which costs more per edge.","type":"text"}]},{"anchor":"Positions","type":"heading","level":2,"text":"Positions"},{"type":"paragraph","inlineContent":[{"text":"An edge’s position is ","type":"text"},{"type":"codeVoice","code":"Edges.Index"},{"text":", which holds its source, its rank in the source’s row, and","type":"text"},{"text":" ","type":"text"},{"text":"its target. Equality, order and hashing use ","type":"text"},{"type":"codeVoice","code":"(source, rank)"},{"text":", which is unique even among","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges and self-loops. Because the position carries the target, ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"text":" and a weight closure reading ","type":"text"},{"type":"codeVoice","code":"$0.target"},{"text":" call nothing. There are no dense","type":"text"},{"text":" ","type":"text"},{"text":"edge indices.","type":"text"}]},{"anchor":"Attached-values","type":"heading","level":2,"text":"Attached values"},{"type":"paragraph","inlineContent":[{"text":"The graph is not a ","type":"text"},{"type":"codeVoice","code":"PropertyGraph"},{"text":", because ","type":"text"},{"type":"codeVoice","code":"(source, rank)"},{"text":" has a dense offset only after every","type":"text"},{"text":" ","type":"text"},{"text":"earlier row is counted. Keep vertex values in an array of ","type":"text"},{"type":"codeVoice","code":"vertexCount"},{"text":" indexed by vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"compute edge values from the position (","type":"text"},{"type":"codeVoice","code":"$0.source"},{"text":", ","type":"text"},{"type":"codeVoice","code":"$0.target"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The graph is not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", because a closure has no","type":"text"},{"text":" ","type":"text"},{"text":"identity and is not ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":".","type":"text"}]}]}],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/successors(checked:)":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","title":"successors(checked:)","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors(checked:)","type":"topic","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Row"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sequence"},{"type"