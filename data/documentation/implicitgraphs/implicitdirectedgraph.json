{"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L38","fileName":"ImplicitDirectedGraph.swift"},"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"modules":[{"name":"ImplicitGraphs"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"externalID":"s:14ImplicitGraphs0A13DirectedGraphV","title":"ImplicitDirectedGraph","roleHeading":"Structure"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"text":". For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"text":"; a grid is numbered row-major.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"The closure.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(v)"},{"type":"text","text":" lists the targets of the edges leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":", once per edge, as"},{"type":"text","text":" "},{"type":"text","text":"any "},{"type":"codeVoice","code":"Sequence<Int>"},{"type":"text","text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build"},{"type":"text","text":" "},{"type":"text","text":"inlines it with no type erasure. Each read of a row calls it once: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" once each, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"text","text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a"},{"type":"text","text":" "},{"type":"text","text":"closure that breaks it breaks every algorithm, as a mutating "},{"type":"codeVoice","code":"=="},{"type":"text","text":" breaks "},{"type":"codeVoice","code":"Set"},{"type":"text","text":". Each target is"},{"type":"text","text":" "},{"type":"text","text":"checked to be a vertex when it is read, not when the row is formed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and"},{"type":"text","text":" "},{"type":"text","text":"yields them by count, rather than a "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" over a fixed neighbor list: the filter calls"},{"type":"text","text":" "},{"type":"text","text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a"},{"type":"text","text":" "},{"type":"text","text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra)."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positions."}]},{"type":"text","text":" An edge’s position is "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":": its source, its rank in the source’s row,"},{"type":"text","text":" "},{"type":"text","text":"and its target. Equality, order and hashing use "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":", unique even among parallel"},{"type":"text","text":" "},{"type":"text","text":"edges and self-loops; the target rides along, so "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"type":"text","text":"weight closure reading "},{"type":"codeVoice","code":"$0.target"},{"type":"text","text":" call nothing. There are no dense edge indices."}],"type":"paragraph"},{"inlineContent":[{"text":"Not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":": a closure has no identity and is not","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"generated":true,"anchor":"Structures"},{"title":"Initializers","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"generated":true,"anchor":"Initializers"},{"title":"Default Implementations","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"kind":"symbol","abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"code":"grid_graph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"GridGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FullGraph","type":"codeVoice"},{"text":"). It is a lawful ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"sections":[],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","abstract":[],"url":"\/documentation\/implicitgraphs","title":"ImplicitGraphs","role":"collection","kind":"symbol","type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OutEdges"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutEdges"}],"title":"ImplicitDirectedGraph.OutEdges","type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/outedges","abstract":[{"type":"text","text":"The positions of the edges leaving one vertex, in row order: ranks 0, 1, …, each with its"},{"type":"text","text":" "},{"type":"text","text":"target, checked to be a vertex as it is read."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":