{"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"title":"ImplicitDirectedGraph","role":"symbol","remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L38"},"externalID":"s:14ImplicitGraphs0A13DirectedGraphV","roleHeading":"Structure","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"modules":[{"name":"ImplicitGraphs"}],"symbolKind":"struct"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure"},{"type":"text","text":" "},{"type":"text","text":"searches instead: Traversal’s "},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"type":"text","text":" and ShortestPaths’"},{"type":"text","text":" "},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"type":"text","text":". For "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" states over a finite set, number them and use"},{"type":"text","text":" "},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"type":"text","text":"; a grid is numbered row-major."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The closure."}],"type":"strong"},{"text":" ","type":"text"},{"code":"successors(v)","type":"codeVoice"},{"text":" lists the targets of the edges leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", once per edge, as","type":"text"},{"text":" ","type":"text"},{"text":"any ","type":"text"},{"code":"Sequence<Int>","type":"codeVoice"},{"text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build","type":"text"},{"text":" ","type":"text"},{"text":"inlines it with no type erasure. Each read of a row calls it once: ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" once each, ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the","type":"text"},{"text":" ","type":"text"},{"text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a","type":"text"},{"text":" ","type":"text"},{"text":"closure that breaks it breaks every algorithm, as a mutating ","type":"text"},{"code":"==","type":"codeVoice"},{"text":" breaks ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":". Each target is","type":"text"},{"text":" ","type":"text"},{"text":"checked to be a vertex when it is read, not when the row is formed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On a hot path, return a small struct that computes the row up front into fixed slots and","type":"text"},{"text":" ","type":"text"},{"text":"yields them by count, rather than a ","type":"text"},{"type":"codeVoice","code":"lazy.filter"},{"text":" over a fixed neighbor list: the filter calls","type":"text"},{"text":" ","type":"text"},{"text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a","type":"text"},{"text":" ","type":"text"},{"text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra).","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Positions.","type":"text"}],"type":"strong"},{"type":"text","text":" An edge’s position is "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":": its source, its rank in the source’s row,"},{"type":"text","text":" "},{"type":"text","text":"and its target. Equality, order and hashing use "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":", unique even among parallel"},{"type":"text","text":" "},{"type":"text","text":"edges and self-loops; the target rides along, so "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"type":"text","text":"weight closure reading "},{"type":"codeVoice","code":"$0.target"},{"type":"text","text":" call nothing. There are no dense edge indices."}]},{"type":"paragraph","inlineContent":[{"text":"Not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":": a closure has no identity and is not","type":"text"},{"text":" ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":".","type":"text"}]}]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP"]}],"sections":[],"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"]},{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"type":"codeVoice","code":"grid_graph"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GridGraph"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"FullGraph"},{"text":"). It is a lawful ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/outedges","role":"symbol","abstract":[{"text":"The positions of the edges leaving one vertex, in row order: ranks 0, 1, …, each with its","type":"text"},{"text":" ","type":"text"},{"text":"target, checked to be a vertex as it is read.","type":"text"}],"type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","title":"ImplicitDirectedGraph.OutEdges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutEdges"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"OutEdges"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/DirectedGraph-Implementations":{"kind":"article","title":"DirectedGraph Implementations","role":"collectionGroup","abstract":[],"type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/directedgraph-implementations"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","title":"ImplicitGraphs","kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/implicitgraphs","role":"collection"},"doc://ImplicitGraphs/documentation/I