{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}]},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"text":". For ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"text":"; a grid is numbered row-major.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The closure."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(v)"},{"type":"text","text":" lists the targets of the edges leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":", once per edge, as"},{"type":"text","text":" "},{"type":"text","text":"any "},{"type":"codeVoice","code":"Sequence<Int>"},{"type":"text","text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build"},{"type":"text","text":" "},{"type":"text","text":"inlines it with no type erasure. Each read of a row calls it once: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" once each, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"text","text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the"},{"type":"text","text":" "},{"type":"text","text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a"},{"type":"text","text":" "},{"type":"text","text":"closure that breaks it breaks every algorithm, as a mutating "},{"type":"codeVoice","code":"=="},{"type":"text","text":" breaks "},{"type":"codeVoice","code":"Set"},{"type":"text","text":". Each target is"},{"type":"text","text":" "},{"type":"text","text":"checked to be a vertex when it is read, not when the row is formed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and"},{"type":"text","text":" "},{"type":"text","text":"yields them by count, rather than a "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" over a fixed neighbor list: the filter calls"},{"type":"text","text":" "},{"type":"text","text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a"},{"type":"text","text":" "},{"type":"text","text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra)."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positions."}]},{"type":"text","text":" An edge’s position is "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":": its source, its rank in the source’s row,"},{"type":"text","text":" "},{"type":"text","text":"and its target. Equality, order and hashing use "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":", unique even among parallel"},{"type":"text","text":" "},{"type":"text","text":"edges and self-loops; the target rides along, so "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"type":"text","text":"weight closure reading "},{"type":"codeVoice","code":"$0.target"},{"type":"text","text":" call nothing. There are no dense edge indices."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"No attached maps."}],"type":"strong"},{"text":" It is not a ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":": an edge map needs a dense offset for each","type":"text"},{"text":" ","type":"text"},{"text":"position, which ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":" has only after counting every earlier row. Vertex values fit","type":"text"},{"text":" ","type":"text"},{"text":"an array of ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" indexed by vertex, which nothing ever invalidates, and edge values","type":"text"},{"text":" ","type":"text"},{"text":"come from the position (","type":"text"},{"code":"$0.source","type":"codeVoice"},{"text":", ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":"), as a grid’s weights do.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":": a closure has no identity and is not","type":"text"},{"text":" ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"]}],"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"sections":[],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGrap