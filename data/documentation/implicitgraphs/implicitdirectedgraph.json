 vertex)"},{"type":"text","text":", throwing instead of trapping when "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" is not in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". One call, O(d)."}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outDegree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","title":"ImplicitDirectedGraph","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"kind":"symbol","title":"ImplicitDirectedGraph.OutEdges","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirected