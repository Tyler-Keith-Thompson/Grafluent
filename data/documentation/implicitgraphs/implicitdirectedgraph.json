hs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutEdges"}],"abstract":[{"text":"The positions of the edges leaving one vertex, in row order: ranks 0, 1, …, each with its","type":"text"},{"text":" ","type":"text"},{"text":"target, checked to be a vertex as it is read.","type":"text"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/outedges","navigatorTitle":[{"kind":"identifier","text":"OutEdges"}],"title":"ImplicitDirectedGraph.OutEdges","type":"topic","role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"navigatorTitle":[{"text":"Successors","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","title":"ImplicitDirectedGraph.Successors","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Successors","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"url":"\/documentation\/graphprotocols\/directedgraph","title":"DirectedGraph","type":"topic","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"}}}