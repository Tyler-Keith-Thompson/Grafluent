{"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"type":"codeVoice","code":"grid_graph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GridGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FullGraph"},{"type":"text","text":"). It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"title":"Conforms To"}],"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L38","fileName":"ImplicitDirectedGraph.swift"},"title":"ImplicitDirectedGraph","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"modules":[{"name":"ImplicitGraphs"}]},"topicSections":[{"anchor":"Structures","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"title":"Structures"},{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"title":"Initializers"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"title":"Instance Methods"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"title":"Default Implementations"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"text":". For ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"text":"; a grid is numbered row-major.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The closure.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"successors(v)","type":"codeVoice"},{"text":" lists the targets of the edges leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", once per edge, as","type":"text"},{"text":" ","type":"text"},{"text":"any ","type":"text"},{"code":"Sequence<Int>","type":"codeVoice"},{"text":" (an array, a lazy filter over a fixed neighbor list), so a specialized build","type":"text"},{"text":" ","type":"text"},{"text":"inlines it with no type erasure. Each read of a row calls it once: ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" once each, ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"per vertex. It must return the same sequence each time it is asked about the same vertex (the","type":"text"},{"text":" ","type":"text"},{"text":"protocol’s “asking again gives the same answer”); this is documented, not checked, and a","type":"text"},{"text":" ","type":"text"},{"text":"closure that breaks it breaks every algorithm, as a mutating ","type":"text"},{"code":"==","type":"codeVoice"},{"text":" breaks ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":". Each target is","type":"text"},{"text":" ","type":"text"},{"text":"checked to be a vertex when it is read, not when the row is formed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On a hot path, return a small struct that computes the row up front into fixed slots and"},{"type":"text","text":" "},{"type":"text","text":"yields them by count, rather than a "},{"type":"codeVoice","code":"lazy.filter"},{"type":"text","text":" over a fixed neighbor list: the filter calls"},{"type":"text","text":" "},{"type":"text","text":"its predicate per element and keeps the unfiltered iterator’s state, and in the benchmarks on a"},{"type":"text","text":" "},{"type":"text","text":"1000 × 1000 grid it cost 1.2–1.8× the precomputed row (breadth-first layers, components,"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra)."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Positions."}],"type":"strong"},{"text":" An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":": its source, its rank in the source’s row,","type":"text"},{"text":" ","type":"text"},{"text":"and its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", unique even among parallel","type":"text"},{"text":" ","type":"text"},{"text":"edges and self-loops; the target rides along, so ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"text":"weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense edge indices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":": a closure has no identity and is not"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":"."}]}]}],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}],"navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/outedges","kind":"symbol","type":"topic","title":"ImplicitDirectedGraph.OutEdges","abstract":[{"type":"text","text":"The positions of the edges leaving one vertex, in row order: ranks 0, 1, …, each with its"},{"type":"text","text":" "},{"type":"text","text":"target, checked to be a vertex as it is read."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"navigatorTitle":[{"kind":"identifier","text":"Successors"}],"url":"\/documentation\/implicitgraphs\/implic