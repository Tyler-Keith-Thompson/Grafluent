{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"metadata":{"remoteSource":{"fileName":"ImplicitDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/ImplicitGraphs\/ImplicitDirectedGraph.swift#L48"},"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"role":"symbol","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"title":"ImplicitDirectedGraph","roleHeading":"Structure","modules":[{"name":"ImplicitGraphs"}],"symbolKind":"struct"},"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored."}],"variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"],"type":"conformsTo","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs on it, including those that need"},{"type":"text","text":" "},{"type":"text","text":"the whole vertex set (components, centrality), with no edge storage."}],"type":"paragraph"},{"inlineContent":[{"text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure","type":"text"},{"text":" ","type":"text"},{"text":"searches instead: Traversal’s ","type":"text"},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"text":" and ShortestPaths’","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff:successors:success:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)"},{"text":". For ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" states over a finite set, number them and use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>"},{"text":". A grid is numbered row-major.","type":"text"}],"type":"paragraph"},{"anchor":"The-closure","type":"heading","text":"The closure","level":2},{"inlineContent":[{"code":"successors(v)","type":"codeVoice"},{"text":" lists the targets of the edges leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", once per edge, as any","type":"text"},{"text":" ","type":"text"},{"code":"Sequence<Int>","type":"codeVoice"},{"text":", such as an array or a lazy filter over a fixed neighbor list. A specialized","type":"text"},{"text":" ","type":"text"},{"text":"build inlines it with no type erasure. Each read of a row calls it once. ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" call it once each, and ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" once per vertex.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The closure must return the same sequence each time it is asked about the same vertex. This is"},{"type":"text","text":" "},{"type":"text","text":"not checked, and a closure that breaks it breaks every algorithm. Each target is checked to be a"},{"type":"text","text":" "},{"type":"text","text":"vertex when it is read, not when the row is formed."}],"type":"paragraph"},{"inlineContent":[{"text":"On a hot path, return a small struct that computes the row up front into fixed slots and yields","type":"text"},{"text":" ","type":"text"},{"text":"them by count. A ","type":"text"},{"type":"codeVoice","code":"lazy.filter"},{"text":" calls its predicate per element and carries the unfiltered","type":"text"},{"text":" ","type":"text"},{"text":"iterator’s state, which costs more per edge.","type":"text"}],"type":"paragraph"},{"anchor":"Positions","type":"heading","text":"Positions","level":2},{"inlineContent":[{"text":"An edge’s position is ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":", which holds its source, its rank in the source’s row, and","type":"text"},{"text":" ","type":"text"},{"text":"its target. Equality, order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":", which is unique even among","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges and self-loops. Because the position carries the target, ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" and a weight closure reading ","type":"text"},{"code":"$0.target","type":"codeVoice"},{"text":" call nothing. There are no dense","type":"text"},{"text":" ","type":"text"},{"text":"edge indices.","type":"text"}],"type":"paragraph"},{"anchor":"Attached-values","type":"heading","text":"Attached values","level":2},{"inlineContent":[{"type":"text","text":"The graph is not a "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":", because "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":" has a dense offset only after every"},{"type":"text","text":" "},{"type":"text","text":"earlier row is counted. Keep vertex values in an array of "},{"type":"codeVoice","code":"vertexCount"},{"type":"text","text":" indexed by vertex, and"},{"type":"text","text":" "},{"type":"text","text":"compute edge values from the position ("},{"type":"codeVoice","code":"$0.source"},{"type":"text","text":", "},{"type":"codeVoice","code":"$0.target"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"The graph is not ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":", because a closure has no","type":"text"},{"text":" ","type":"text"},{"text":"identity and is not ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/outDegree(checked:)":{"type":"topic","kind":"symbol","title":"outDegree(checked:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outDegree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound"}