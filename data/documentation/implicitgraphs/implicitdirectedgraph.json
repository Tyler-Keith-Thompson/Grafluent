{"kind":"symbol","topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/init(vertexCount:successors:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outDegree(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/outEdges(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/successors(checked:)","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/vertexIndex(checked:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/DirectedGraph-Implementations"],"anchor":"Default-Implementations"}],"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored."}],"hierarchy":{"paths":[["doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"]]},"variants":[{"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/ImplicitGraphs\/s8CopyableP","doc:\/\/ImplicitGraphs\/s9EscapableP"]}],"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Row"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Row"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" == "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs on it, including those that need"},{"type":"text","text":" "},{"type":"text","text":"the whole vertex set (components, centrality), with no edge storage."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a state space with no vertex collection (an unbounded grid, a puzzle), use the closure"},{"type":"text","text":" "},{"type":"text","text":"searches instead: Traversal’s "},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"type":"text","text":" and ShortestPaths’"},{"type":"text","text":" "},{"code":"dijkstraShortestPath(from:cutoff:successors:success:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"aStarShortestPath(from:cutoff: successors:heuristic:success:)","type":"codeVoice"},{"type":"text","text":". For "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" states over a finite set, number them and use"},{"type":"text","text":" "},{"code":"LabeledGraph<State, ImplicitDirectedGraph<Row>>","type":"codeVoice"},{"type":"text","text":". A grid is numbered row-major."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"The-closure","text":"The closure"},{"inlineContent":[{"type":"codeVoice","code":"successors(v)"},{"text":" lists the targets of the edges leaving ","type":"text"},{"type":"codeVoice","code":"v"},{"text":", once per edge, as any","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sequence<Int>"},{"text":", such as an array or a lazy filter over a fixed neighbor list. A specialized","type":"text"},{"text":" ","type":"text"},{"text":"build inlines it with no type erasure. Each read of a row calls it once. ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"outEdges(of:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"outDegree(of:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"contains(edge:)"},{"text":" call it once each, and ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":" once per vertex.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The closure must return the same sequence each time it is asked about the same vertex. This is","type":"text"},{"text":" ","type":"text"},{"text":"not checked, and a closure that breaks it breaks every algorithm. Each target is checked to be a","type":"text"},{"text":" ","type":"text"},{"text":"vertex when it is read, not when the row is formed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"On a hot path, return a small struct that computes the row up front into fixed slots and yields","type":"text"},{"text":" ","type":"text"},{"text":"them by count. A ","type":"text"},{"code":"lazy.filter","type":"codeVoice"},{"text":" calls its predicate per element and carries the unfiltered","type":"text"},{"text":" ","type":"text"},{"text":"iterator’s state, which costs more per edge.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Positions","text":"Positions"},{"inlineContent":[{"text":"An edge’s position is ","type":"text"},{"type":"codeVoice","code":"Edges.Index"},{"text":", which holds its source, its rank in the source’s row, and","type":"text"},{"text":" ","type":"text"},{"text":"its target. Equality, order and hashing use ","type":"text"},{"type":"codeVoice","code":"(source, rank)"},{"text":", which is unique even among","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges and self-loops. Because the position carries the target, ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"text":" and a weight closure reading ","type":"text"},{"type":"codeVoice","code":"$0.target"},{"text":" call nothing. There are no dense","type":"text"},{"text":" ","type":"text"},{"text":"edge indices.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Attached-values","text":"Attached values"},{"inlineContent":[{"type":"text","text":"The graph is not a "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":", because "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":" has a dense offset only after every"},{"type":"text","text":" "},{"type":"text","text":"earlier row is counted. Keep vertex values in an array of "},{"type":"codeVoice","code":"vertexCount"},{"type":"text","text":" indexed by vertex, and"},{"type":"text","text":" "},{"type":"text","text":"compute edge values from the position ("},{"type":"codeVoice","code":"$0.source"},{"type":"text","text":", "},{"type":"codeVoice","code":"$0.target"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"The graph is not ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", because a closure has no","type":"text"},{"text":" ","type":"text"},{"text":"identity and is not ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"symbolKind":"struct","externalID":"s:14ImplicitGraphs0A13DirectedGraphV","role":"symbol","title":"ImplicitDirectedGraph","modules":[{"name":"ImplicitGraphs"}],"navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"roleHeading":"Structure"},"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"title":"ImplicitDirectedGraph.Successors","abstract":[{"text":"The closure’s row for one vertex, each target checked to be a vertex as it is read.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"navigatorTitle":[{"kind":"identifier","text":"Successors"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/successors(checked:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":