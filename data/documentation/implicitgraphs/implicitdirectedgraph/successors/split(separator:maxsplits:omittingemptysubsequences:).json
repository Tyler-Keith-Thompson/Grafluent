ccessors","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"kind":"symbol","title":"ImplicitGraphs","url":"\/documentation\/implicitgraphs","abstract":[],"role":"collection","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","title":"ImplicitDirectedGraph","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}]}}}