lled on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"url":"\/documentation\/implicitgraphs","abstract":[],"role":"collection","kind":"symbol","title":"ImplicitGraphs","type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"}}}