"kind":"text","text":"?"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"title":"ImplicitDirectedGraph","type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","kind":"symbol","abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"code":"grid_graph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GridGraph"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"FullGraph"},{"text":"). It is a lawful ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"type":"topic","role":"collection","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","kind":"symbol","title":"ImplicitGraphs","abstract":[],"url":"\/documentation\/implicitgraphs"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"}],"navigatorTitle":[{"text":"Successors","kind":"identifier"}],"title":"ImplicitDirectedGraph.Successors","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}]}}}