:"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","abstract":[{"text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not","type":"text"},{"text":" ","type":"text"},{"text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an","type":"text"},{"text":" ","type":"text"},{"text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"title":"ImplicitDirectedGraph.Successors","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"kind":"symbol","type":"topic","url":"\/documentation\/implicitgraphs","abstract":[],"role":"collection","title":"ImplicitGraphs","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","abstract":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"code":"grid_graph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"GridGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FullGraph","type":"codeVoice"},{"text":"). It is a lawful ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (compo