,"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Sequence.forEach(_:)"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/forEach(_:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","kind":"symbol","role":"symbol","title":"ImplicitDirectedGraph.Successors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Successors"}],"type":"topic","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","navigatorTitle":[{"kind":"identifier","text":"Successors"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/forEach(_:)":{"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/foreach(_:)","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/forEach(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forEach"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentif