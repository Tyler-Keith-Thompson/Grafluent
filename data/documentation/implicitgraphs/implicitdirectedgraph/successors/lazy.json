l":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/lazy","kind":"symbol","title":"lazy","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lazy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"LazySequence","kind":"typeIdentifier","preciseIdentifier":"s:s12LazySequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/lazy","abstract":[]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"role":"symbol","title":"ImplicitDirectedGraph.Successors","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"kind":"symbol","title":"ImplicitGraphs","url":"\/documentation\/implicitgraphs","abstract":[],"role":"collection","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","title":"ImplicitDirectedGraph","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"