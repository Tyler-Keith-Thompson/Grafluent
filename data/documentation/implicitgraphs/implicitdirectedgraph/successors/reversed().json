"},{"kind":"identifier","text":"reversed"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":"]"}],"role":"symbol","type":"topic","kind":"symbol","title":"reversed()","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/reversed()","abstract":[],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/reversed()"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","abstract":[],"title":"ImplicitGraphs","url":"\/documentation\/implicitgraphs","role":"collection","type":"topic","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"type":"codeVoice","code":"grid_graph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GridGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FullGraph"},{"type":"text","text":"). It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"kind":"symbol","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"title":"ImplicitDirectedGraph"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"abstract":[{"text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not","type":"text"},{"text":" ","type":"text"},{"text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an","type":"text"},{"text":" ","type":"text"},{"text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it.","type":"text"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","title":"ImplicitDirectedGraph.Successors","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"}],"navigatorTitle":[{"text":"Successors","kind":"identifier"}],"kind":"symbol"}}}