","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"code":"grid_graph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GridGraph"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"FullGraph"},{"text":"). It is a lawful ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"title":"ImplicitDirectedGraph","type":"topic","role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/makeIterator()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ImplicitDirectedGraph","preciseIdentifier":"s:14ImplicitGraphs0A13DirectedGraphV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Successors","preciseIdentifier":"s:14ImplicitGraphs0A13DirectedGraphV10SuccessorsV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Iterator","preciseIdentifier":"s:14ImplicitGraphs0A13DirectedGraphV10SuccessorsV8IteratorV","kind":"typeIdentifier"}],"abstract":[],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/makeiterator()","title":"makeIterator()","type":"topic","ro