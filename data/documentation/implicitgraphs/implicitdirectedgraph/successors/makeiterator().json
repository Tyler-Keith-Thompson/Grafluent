ertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/makeIterator()":{"type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/makeIterator()","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/makeiterator()","kind":"symbol","title":"makeIterator()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:14ImplicitGraphs0A13DirectedGraphV","text":"ImplicitDirectedGraph","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Row","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:14ImplicitGraphs0A13DirectedGraphV10SuccessorsV","text":"Successors","kind":"typeIdentifier"},{"text":".","kind":"text"},{"precis