":[{"text":"A finite directed graph on the vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"code":"grid_graph","type":"codeVoice"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"code":"GridGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FullGraph","type":"codeVoice"},{"text":"). It is a lawful ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"title":"ImplicitDirectedGraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/Iterator":{"navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"type":"topic","title":"ImplicitDirectedGraph.Successors.Iterator","abstract":[{"type":"text","text":"Holds no more than the row’s iterator and the vertex count: Tarjan’s algorithm keeps one"},{"type":"text","text":" "},{"type":"text","text":"per vertex on its search path, and a word more each cost it measurably."}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/Iterator","kind":"symbol","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgra