 it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Successors","kind":"identifier"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/max()":{"kind":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/max()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"max","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[],"type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/max()","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Element","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Comparable","type":"codeVoice"},{"type":"text","text":"."}]},"title":"max()"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","title":"ImplicitGraphs","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/implicitgraphs","role":"collection"}}}