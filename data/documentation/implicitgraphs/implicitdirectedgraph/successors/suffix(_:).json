xt"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"title":"ImplicitDirectedGraph","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"kind":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","abstract":[{"text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not","type":"text"},{"text":" ","type":"text"},{"text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an","type":"text"},{"text":" ","type":"text"},{"text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it.","type":"text"}],"role":"symbol","type":"topic","title":"ImplicitDirectedGraph.Successors","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"navigatorTitle":[{"kind":"identifier","text":"Successors"}]}}}