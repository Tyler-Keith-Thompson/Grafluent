gorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"title":"ImplicitDirectedGraph","type":"topic","role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/adjacentPairs()":{"abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/adjacentPairs()","title":"adjacentPairs()","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/adjacentpairs()"}}}