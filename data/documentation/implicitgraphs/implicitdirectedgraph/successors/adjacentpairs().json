ad (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/adjacentPairs()":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/adjacentPairs()","type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/adjacentpairs()","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","title":"adjacentPairs()","role":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"url":"\/documentation\/implicitgraphs","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","role":"collection","type":"topic","abstract":[],"kind":"symbol","title":"ImplicitGraphs"}}}