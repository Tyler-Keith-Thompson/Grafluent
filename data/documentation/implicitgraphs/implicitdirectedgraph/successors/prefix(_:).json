"swift"}],"paths":["\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/prefix(_:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"references":{"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","kind":"symbol","role":"symbol","title":"ImplicitDirectedGraph.Successors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Successors"}],"type":"topic","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","navigatorTitle":[{"kind":"identifier","text":"Successors"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/implicitgraphs","title":"ImplicitGraphs","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/prefix(_:)":{"type":"topic","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/prefix(_:)","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/prefix(_:)","kind":"symbol","abstract":[],"title":"prefix(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"prefix"},{"kind":"text","text":"("},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s14P