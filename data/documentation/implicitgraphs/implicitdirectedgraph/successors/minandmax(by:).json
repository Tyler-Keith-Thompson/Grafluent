":[{"text":"A finite directed graph on the vertices ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" whose out-neighbors come from a","type":"text"},{"text":" ","type":"text"},{"text":"closure, called on demand and never stored: an implicit graph (Boost’s ","type":"text"},{"type":"codeVoice","code":"grid_graph"},{"text":", LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GridGraph"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"FullGraph"},{"text":"). It is a lawful ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", so every generic algorithm runs","type":"text"},{"text":" ","type":"text"},{"text":"on it, including those that need the whole vertex set (components, centrality), with no edge","type":"text"},{"text":" ","type":"text"},{"text":"storage.","type":"text"}],"navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"type":"topic","title":"ImplicitDirectedGraph.Successors","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","role":"symbol","kind":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"navigatorTitle":[{"kind":"identifier","text":"Successors"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"type":"topic","title":"ImplicitGraphs","url":"\/documentation\/implicitgraphs","role"