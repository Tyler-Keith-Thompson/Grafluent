xt","text":"storage."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors":{"title":"ImplicitDirectedGraph.Successors","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Successors"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/firstNonNil(_:)":{"title":"firstNonNil(_:)","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/firstnonnil(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"firstNonNil","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Result","kind":"genericParameter"},{"text":">((","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Result"},{"kind"