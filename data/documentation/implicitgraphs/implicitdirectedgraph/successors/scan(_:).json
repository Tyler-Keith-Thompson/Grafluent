icitDirectedGraph":{"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","role":"symbol","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"type":"codeVoice","code":"grid_graph"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"GridGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FullGraph"},{"type":"text","text":"). It is a lawful "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"title":"ImplicitDirectedGraph","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","type":"topic"}}}