entifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors","abstract":[{"type":"text","text":"The closure’s row for one vertex, each target checked to be a vertex as it is read (not"},{"type":"text","text":" "},{"type":"text","text":"when the row is formed). A struct rather than a lazy map, so an algorithm that keeps an"},{"type":"text","text":" "},{"type":"text","text":"iterator per vertex on its stack (Tarjan’s) allocates nothing for it."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Successors/scan(_:)":{"title":"scan(_:)","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/successors\/scan(_:)","deprecated":true,"type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Successors\/scan(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scan"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":"]"}],"role":"symbol","abstract":[],"kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","title":"ImplicitDirectedGraph","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","kind":"symbol"}}}