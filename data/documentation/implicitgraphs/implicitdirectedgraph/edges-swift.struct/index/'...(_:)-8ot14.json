":"ImplicitDirectedGraph.Edges.Index","kind":"symbol","abstract":[{"text":"An edge’s position: its source, its rank in the source’s row, and its target. Equality,","type":"text"},{"text":" ","type":"text"},{"text":"order and hashing use ","type":"text"},{"code":"(source, rank)","type":"codeVoice"},{"text":"; the target is a function of them under the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"closure’s determinism law, and is carried so that reading it calls nothing."}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/edges-swift.struct\/index"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Edges-swift.struct":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Edges-swift.struct","kind":"symbol","navigatorTitle":[{"text":"Edges","kind":"identifier"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Row","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sequence","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Row.Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":".","type":"text"}]},"role":"symbol","title":"ImplicitDirectedGraph.Edges","abstract":[{"text":"Every edge, row by row from vertex 0, each row in the closure’s order.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}],"type":"topic","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/edges-swift.struct"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"kind":"symbol","title":"ImplicitDirectedGraph","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"abstract":