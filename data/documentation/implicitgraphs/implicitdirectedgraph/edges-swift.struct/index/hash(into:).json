t":")"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Edges-swift.struct\/Index\/hash(into:)","abstract":[]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Edges-swift.struct/Index":{"type":"topic","role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/edges-swift.struct\/index","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Index","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Edges-swift.struct\/Index","abstract":[{"type":"text","text":"An edge’s position: its source, its rank in the source’s row, and its target. Equality,"},{"type":"text","text":" "},{"type":"text","text":"order and hashing use "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":"; the target is a function of them under the"},{"type":"text","text":" "},{"type":"text","text":"closure’s determinism law, and is carried so that reading it calls nothing."}],"kind":"symbol","navigatorTitle":[{"text":"Index","kind":"identifier"}],"title":"ImplicitDirectedGraph.Edges.Index"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","title":"ImplicitDirectedGraph","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"url":"\/documentation\/implicitgraphs","abstract":[],"role":"collection","kind":"symbol","title":"ImplicitGraphs","type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"}}}