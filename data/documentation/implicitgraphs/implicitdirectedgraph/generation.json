plicitGraphs\/documentation\/ImplicitGraphs","doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration":{"abstract":[{"type":"text","text":"A graph’s generation: which state of which graph it is. Every structural mutation (an"},{"type":"text","text":" "},{"type":"text","text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and"},{"type":"text","text":" "},{"type":"text","text":"writing attached map values do not. A structure derived from a graph stores the graph’s"},{"type":"text","text":" "},{"code":"generation","type":"codeVoice"},{"type":"text","text":" and asks "},{"code":"isCurrent(for:)","type":"codeVoice"},{"type":"text","text":" before it relies on the graph again."}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"navigatorTitle":[{"text":"GraphGeneration","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graphgeneration","title":"GraphGeneration","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/generation":{"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/generation","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"generation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GraphGeneration","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A10GenerationV"}],"role":"symbol","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/generation","kind":"symbol","title":"generation","abstract":[{"text":"The generation of this graph, which never changes: the graph is immutable, and its closure","type":"text"},{"text":" ","type":"text"},{"text":"must answer the same each time. A structure derived from this graph is current for it and","type":"text"},{"text":" ","type":"text"},{"text":"its copies, and for no other graph, even one built from the same closure.","type":"text"}],"type":"topic"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","title":"ImplicitDirectedGraph","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImplicitDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"ImplicitDirectedGraph"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","kind":"symbol"},"doc://ImplicitGraphs/documentation/ImplicitGraphs":{"url":"\/documentation\/implicitgraphs","abstract":[],"role":"collection","kind":"symbol","title":"ImplicitGraphs","type":"topic","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs"}}}