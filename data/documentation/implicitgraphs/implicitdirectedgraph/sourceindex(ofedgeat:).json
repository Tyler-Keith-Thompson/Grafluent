d":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Edges-swift.struct\/Index","role":"symbol","abstract":[{"type":"text","text":"An edge’s position: its source, its rank in the source’s row, and its target. Equality,"},{"type":"text","text":" "},{"type":"text","text":"order and hashing use "},{"type":"codeVoice","code":"(source, rank)"},{"type":"text","text":"; the target is a function of them under the"},{"type":"text","text":" "},{"type":"text","text":"closure’s determinism law, and is carried so that reading it calls nothing."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/Edges-swift.struct":{"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Row"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Row.Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"."}]},"type":"topic","title":"ImplicitDirectedGraph.Edges","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}],"role":"symbol","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/edges-swift.struct","navigatorTitle":[{"text":"Edges","kind":"identifier"}],"identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/Edges-swift.struct","abstract":[{"type":"text","text":"Every edge, row by row from vertex 0, each row in the closure’s order."}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"type":"topic","title":"ImplicitDirectedGraph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}],"role":"symbol","url":"\/documentation\/implicitgr