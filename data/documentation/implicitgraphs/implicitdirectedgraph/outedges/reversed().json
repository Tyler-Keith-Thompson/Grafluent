"kind":"symbol","role":"collection","url":"\/documentation\/implicitgraphs"},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph":{"type":"topic","title":"ImplicitDirectedGraph","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph","abstract":[{"type":"text","text":"A finite directed graph on the vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" whose out-neighbors come from a"},{"type":"text","text":" "},{"type":"text","text":"closure, called on demand and never stored: an implicit graph (Boost’s "},{"code":"grid_graph","type":"codeVoice"},{"type":"text","text":", LEMON’s"},{"type":"text","text":" "},{"code":"GridGraph","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FullGraph","type":"codeVoice"},{"type":"text","text":"). It is a lawful "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":", so every generic algorithm runs"},{"type":"text","text":" "},{"type":"text","text":"on it, including those that need the whole vertex set (components, centrality), with no edge"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"ImplicitDirectedGraph","kind":"identifier"}],"url":"\/documentation\/implicitgraphs\/implicitdirectedgraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImplicitDirectedGraph","kind":"identifier"}]},"doc://ImplicitGraphs/documentation/ImplicitGraphs/ImplicitDirectedGraph/OutEdges":{"kind":"symbol","title":"ImplicitDirectedGraph.OutEdges","url":"\/documentation\/implicitgraphs\/implicitdirectedgraph\/outedges","identifier":"doc:\/\/ImplicitGraphs\/documentation\/ImplicitGraphs\/ImplicitDirectedGraph\/OutEdges","navigatorTitle":[{"kind":"identifier","text":"OutEdges"}],"role":"symbol","abstract":[{"type":"text","text":"The positions of the edges leaving one vertex, in row order: ranks 0, 1, …, each with its"},{"type":"text","text