{"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(from:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(from:alongEdgeAt:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/CustomStringConvertible-Implementations"]}],"variants":[{"paths":["\/documentation\/planarity\/planarembedding"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of","type":"text"},{"text":" ","type":"text"},{"text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2.","type":"text"},{"text":" ","type":"text"},{"text":"Each clockwise order starts at the first edge of ","type":"text"},{"type":"codeVoice","code":"incidentEdges(of:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Faces.","type":"text"}],"type":"strong"},{"text":" The face after the half-edge from u along edge e to w continues with the half-edge","type":"text"},{"text":" ","type":"text"},{"text":"before e in the clockwise order at w, so a face lies to the right of each of its half-edges.","type":"text"},{"text":" ","type":"text"},{"text":"Faces are counted per connected component, and an isolated vertex has none: two disjoint","type":"text"},{"text":" ","type":"text"},{"text":"triangles have four faces.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph"},{"type":"text","text":" "},{"type":"text","text":"afterwards does not change it. When a graph has several embeddings, which one is returned is"},{"type":"text","text":" "},{"type":"text","text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same"},{"type":"text","text":" "},{"type":"text","text":"edge positions and the same incidence order get the same embedding."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"struct","modules":[{"name":"Planarity"}],"roleHeading":"Structure","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"externalID":"s:9Planarity15PlanarEmbeddingV","role":"symbol","title":"PlanarEmbedding","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L66","fileName":"PlanarEmbedding.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"abstract":[{"type":"text","text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each"},{"type":"text","text":" "},{"type":"text","text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge."}],"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Planarity\/s8CopyableP","doc:\/\/Planarity\/s23CustomStringConvertibleP","doc:\/\/Planarity\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"]}],"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding/clockwiseNeighborIndices(ofIndex:)":{"url":"\/documentation\/planarity\/planarembedding\/clockwise