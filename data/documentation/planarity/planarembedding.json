ding\/clockwiseneighbors","abstract":[{"text":"The vertices across the edges at a vertex, in clockwise order.","type":"text"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","title":"PlanarEmbedding.ClockwiseNeighbors","role":"symbol","navigatorTitle":[{"text":"ClockwiseNeighbors","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClockwiseNeighbors","kind":"identifier"}]},"doc://Planarity/documentation/Planarity/PlanarEmbedding/faces-swift.property":{"role":"symbol","title":"faces","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"faces"},{"kind":"text","text":": "},{"preciseIdentifier":"s:9Planarity15PlanarEmbeddingV","kind":"typeIdentifier","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":">."},{"preciseIdentifier":"s:9Planarity15PlanarEmbeddingV5FacesV","kind":"typeIdentifier","text":"Faces"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property","abstract":[{"type":"text","text":"The faces, each a closed walk along the half-edges with the face on their right, in the"},{"type":"text","text":" "},{"type":"text","text":"order a walk of the vertices in order, and of each clockwise order in order, first reaches"},{"type":"text","text":" "},{"type":"text","text":"them; each starts at the tail of that first half-edge. Every edge position is on two sides"},{"type":"text","text":" "},{"type":"text","text":"of faces, once on each, or twice on one face (a bridge)."}],"url":"\/documentation\/planarity\/planarembedding\/faces-swift.property"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"