{"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/Planarity\/s8CopyableP","doc:\/\/Planarity\/s23CustomStringConvertibleP","doc:\/\/Planarity\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"metadata":{"symbolKind":"struct","title":"PlanarEmbedding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"roleHeading":"Structure","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"modules":[{"name":"Planarity"}],"externalID":"s:9Planarity15PlanarEmbeddingV","role":"symbol","remoteSource":{"fileName":"PlanarEmbedding.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L66"}},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding"},"topicSections":[{"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(from:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(from:alongEdgeAt:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/CustomStringConvertible-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of","type":"text"},{"text":" ","type":"text"},{"text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2.","type":"text"},{"text":" ","type":"text"},{"text":"Each clockwise order starts at the first edge of ","type":"text"},{"type":"codeVoice","code":"incidentEdges(of:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Faces.","type":"text"}],"type":"strong"},{"text":" The face after the half-edge from u along edge e to w continues with the half-edge","type":"text"},{"text":" ","type":"text"},{"text":"before e in the clockwise order at w, so a face lies to the right of each of its half-edges.","type":"text"},{"text":" ","type":"text"},{"text":"Faces are counted per connected component, and an isolated vertex has none: two disjoint","type":"text"},{"text":" ","type":"text"},{"text":"triangles have four faces.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph","type":"text"},{"text":" ","type":"text"},{"text":"afterwards does not change it. When a graph has several embeddings, which one is returned is","type":"text"},{"text":" ","type":"text"},{"text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same","type":"text"},{"text":" ","type":"text"},{"text":"edge positions and the same incidence order get the same embedding.","type":"text"}]}]}],"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding"]}],"references":{"doc://Planarity/s23CustomStringConvertibleP":{"identifier":"doc:\/\/Planarity\