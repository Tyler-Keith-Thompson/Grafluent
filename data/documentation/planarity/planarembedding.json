{"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"metadata":{"externalID":"s:9Planarity15PlanarEmbeddingV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"role":"symbol","roleHeading":"Structure","title":"PlanarEmbedding","modules":[{"name":"Planarity"}],"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L67","fileName":"PlanarEmbedding.swift"},"navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}]},"abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position (NetworkX’s ","type":"text"},{"code":"PlanarEmbedding","type":"codeVoice"},{"text":", LEMON’s ","type":"text"},{"code":"PlanarEmbedding","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"OGDF’s ","type":"text"},{"code":"CombinatorialEmbedding","type":"codeVoice"},{"text":"). Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(from:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(from:alongEdgeAt:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/CustomStringConvertible-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"kind":"symbol","relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Planarity\/s8CopyableP","doc:\/\/Planarity\/s23CustomStringConvertibleP","doc:\/\/Planarity\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of","type":"text"},{"text":" ","type":"text"},{"text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2.","type":"text"},{"text":" ","type":"text"},{"text":"Each clockwise order starts at the first edge of ","type":"text"},{"code":"incidentEdges(of:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Faces."}],"type":"strong"},{"text":" The face after the half-edge from u along edge e to w continues with the half-edge","type":"text"},{"text":" ","type":"text"},{"text":"before e in the clockwise order at w (NetworkX’s ","type":"text"},{"code":"next_face_half_edge","type":"codeVoice"},{"text":"), so a face lies to the","type":"text"},{"text":" ","type":"text"},{"text":"right of each of its half-edges. Faces are counted per connected component, and an isolated","type":"text"},{"text":" ","type":"text"},{"text":"vertex has none: two disjoint triangles have four faces.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph","type":"text"},{"text":" ","type":"text"},{"text":"afterwards does not change it. When a graph has several embeddings, which one is returned is","type":"text"},{"text":" ","type":"text"},{"text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same","type":"text"},{"text":" ","type":"text"},{"text":"edge positions and the same incidence order get the same embedding.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding"]}],"sections":[],"references":{"doc://Planarity/documentation/Planarity":{"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/planarity","title":"Planarity","abstract":[],"identifier":"doc:\/\/Planarity\/documentation\/Planarity"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/clockwiseNeighborIndices(ofIndex:)":{"role":"symbol","abstract":[{"type":"codeVoice","code":"clockwiseNeighbors(of:)"},{"type":"text","text":" in index space: the numbers of the neighbours of vertex number"},{"type":"text","text":" "},{"type":"codeVoice","code":"index"},{"type":"text","text":". A vertex’s number is its vertex index, or, for a graph without vertex indices, its"},{"type":"text","text":" "},{"type":"text","text":"position in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":". O(1)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clockwiseNeighborIndices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:9Planarity15PlanarEmbeddingV","kind":"typeIdentifier","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":">."},{"preciseIdentifier":"s:9Planarity15PlanarEmbeddingV24ClockwiseNeighborIndicesV","kind":"typeIdentifier","text":"ClockwiseNeighborIndices"}],"url":"\/documentation\/planarity\/planarembedding\/clockwiseneighborindices(ofindex:)","type":"topic","title":"clockwiseNeighborIndices(ofIndex:)","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","kind":"symbol"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/ClockwiseNeighbors":{"navigatorTitle":[{"kind":"identifier","text":"ClockwiseNeighbors"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The vertices across the edges at a vertex, in clockwise order."}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","url":"\/documentation\/planarity\/planarembedding\/clockwiseneighbors","title":"PlanarEmbedding.ClockwiseNeighbors","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClockwiseNeighbors"}],"role":"symbol"},"doc://Planarity/documentation/Planarity/PlanarEmbedding":{"navigatorTitle":[{"kind":"identifier","text":"PlanarEmbedding"}],"type":"topic","kind":"symbol","abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position (NetworkX’s ","type":"text"},{"code":"PlanarEmbedding","type":"codeVoice"},{"text":", LEMON’s ","type":"text"},{"code":"PlanarEmbedding","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"OGDF’s ","type":"text"},{"code":"CombinatorialEmbedding","type":"codeVoice"},{"text":"). Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","url":"\/documentation\/planarity\/planarembedding","title":"PlanarEmbedding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"role":"symbol"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/face(from:alongEdgeAt:)":{"title":"face(from:alongEdgeAt:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"face"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifi