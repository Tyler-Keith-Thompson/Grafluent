{"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"metadata":{"roleHeading":"Structure","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L63","fileName":"PlanarEmbedding.swift"},"externalID":"s:9Planarity15PlanarEmbeddingV","title":"PlanarEmbedding","symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"modules":[{"name":"Planarity"}]},"abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position (NetworkX’s ","type":"text"},{"type":"codeVoice","code":"PlanarEmbedding"},{"text":", LEMON’s ","type":"text"},{"type":"codeVoice","code":"PlanarEmbedding"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"OGDF’s ","type":"text"},{"type":"codeVoice","code":"CombinatorialEmbedding"},{"text":"). Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Planarity\/s8CopyableP","doc:\/\/Planarity\/s23CustomStringConvertibleP","doc:\/\/Planarity\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"]