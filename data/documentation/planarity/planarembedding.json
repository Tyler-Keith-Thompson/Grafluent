{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"],"anchor":"Structures","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(safe:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(safe:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(from:alongEdgeAt:)"],"anchor":"Instance-Methods","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/CustomStringConvertible-Implementations"],"anchor":"Default-Implementations","generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding"},"variants":[{"paths":["\/documentation\/planarity\/planarembedding"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Planarity\/s8CopyableP","doc:\/\/Planarity\/s23CustomStringConvertibleP","doc:\/\/Planarity\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"PlanarEmbedding"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"title":"PlanarEmbedding","modules":[{"name":"Planarity"}],"remoteSource":{"fileName":"PlanarEmbedding.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L63"},"role":"symbol","roleHeading":"Structure","externalID":"s:9Planarity15PlanarEmbeddingV","symbolKind":"struct"},"abstract":[{"type":"text","text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each"},{"type":"text","text":" "},{"type":"text","text":"vertex, over every edge position (NetworkX’s "},{"type":"codeVoice","code":"PlanarEmbedding"},{"type":"text","text":", LEMON’s "},{"type":"codeVoice","code":"PlanarEmbedding"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"OGDF’s "},{"type":"codeVoice","code":"CombinatorialEmbedding"},{"type":"text","text":"). Its faces satisfy Euler’s formula, n − m + f = 2, in every"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of"},{"type":"text","text":" "},{"type":"text","text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2."},{"type":"text","text":" "},{"type":"text","text":"Each clockwise order starts at the first edge of "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Faces."}]},{"type":"text","text":" The face after the half-edge from u along edge e to w continues with the half-edge"},{"type":"text","text":" "},{"type":"text","text":"before e in the clockwise order at w (NetworkX’s "},{"type":"codeVoice","code":"next_face_half_edge"},{"type":"text","text":"), so a face lies to the"},{"type":"text","text":" "},{"type":"text","text":"right of each of its half-edges. Faces are counted per connected component, and an isolated"},{"type":"text","text":" "},{"type":"text","text":"vertex has none: two disjoint triangles have four faces."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph"},{"type":"text","text":" "},{"type":"text","text":"afterwards does not change it. When a graph has several embeddings, which one is returned is"},{"type":"text","text":" "},{"type":"text","text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same"},{"type":"text","text":" "},{"type":"text","text":"edge positions and the same incidence order get the same embedding."}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","kind":"symbol","type":"topic"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/face(from:alongEdgeAt:)":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"face"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"alongEdgeAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Walk","preciseIdentifier":"s:5Walks4WalkV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(from:alongEdgeAt:)","title":"face(from:alongEdgeAt:)","url":"\/documentation\/planarity\/planarembedding\/face(from:alongedgeat:)","abstract":[{"text":"The face to the right of edge ","type":"text"},{"code":"position","type":"codeVoice"},{"text":" crossed from ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"traverse_face(v, w)","type":"codeVoice"},{"text":"): a closed walk starting and ending at ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":". For a self-loop, the","type":"text"},{"text":" ","type":"text"},{"text":"end listed first in ","type":"text"},{"code":"clockwiseIncidentEdges(of: vertex)","type":"codeVoice"},{"text":". O(face length).","type":"text"}],"role":"symbol"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/ClockwiseNeighbors":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClockwiseNeighbors"}],"url":"\/documentation\/planarity\/planarembedding\/clockwiseneighbors","kind":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","title":"PlanarEmbedding.ClockwiseNeighbors","role":"symbol","abstract":[{"text":"The vertices across the edges at a vertex, in clockwise order.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ClockwiseNeighbors"}]},"doc://Planarity/documentation/Planarity/PlanarEmbedding/clockwiseIncidentEdges(safe:)":{"title":"clockwiseIncidentEdges(safe:)","abstract":[{"type":"codeVoice","code":"clockwiseIncidentEdges(of:)"},{"type":"text","text":", or nil when "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" is not a vertex of the graph."}],"url":"\/