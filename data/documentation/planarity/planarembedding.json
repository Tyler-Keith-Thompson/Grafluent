{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Planarity\/s8CopyableP","doc:\/\/Planarity\/s23CustomStringConvertibleP","doc:\/\/Planarity\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"],"type":"conformsTo"}],"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/planarity\/planarembedding"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"PlanarEmbedding","roleHeading":"Structure","symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"externalID":"s:9Planarity15PlanarEmbeddingV","modules":[{"name":"Planarity"}],"remoteSource":{"fileName":"PlanarEmbedding.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L66"}},"abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"],"generated":true,"anchor":"Structures"},{"title":"Instance Properties","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(from:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(from:alongEdgeAt:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/CustomStringConvertible-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Graph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of"},{"type":"text","text":" "},{"type":"text","text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2."},{"type":"text","text":" "},{"type":"text","text":"Each clockwise order starts at the first edge of "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Faces.","type":"text"}]},{"type":"text","text":" The face after the half-edge from u along edge e to w continues with the half-edge"},{"type":"text","text":" "},{"type":"text","text":"before e in the clockwise order at w, so a face lies to the right of each of its half-edges."},{"type":"text","text":" "},{"type":"text","text":"Faces are counted per connected component, and an isolated vertex has none: two disjoint"},{"type":"text","text":" "},{"type":"text","text":"triangles have four faces."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph"},{"type":"text","text":" "},{"type":"text","text":"afterwards does not change it. When a graph has several embeddings, which one is returned is"},{"type":"text","text":" "},{"type":"text","text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same"},{"type":"text","text":" "},{"type":"text","text":"edge positions and the same incidence order get the same embedding."}],"type":"paragraph"}]}],"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding/clockwiseNeighborIndic