ype":"text"}],"sections":[],"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","abstract":[{"type":"text","text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each"},{"type":"text","text":" "},{"type":"text","text":"vertex, over every edge position (NetworkX’s "},{"type":"codeVoice","code":"PlanarEmbedding"},{"type":"text","text":", LEMON’s "},{"type":"codeVoice","code":"PlanarEmbedding"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"OGDF’s "},{"type":"codeVoice","code":"CombinatorialEmbedding"},{"type":"text","text":"). Its faces satisfy Euler’s formula, n − m + f = 2, in every"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge."}],"kind":"symbol","title":"PlanarEmbedding","role":"symbol","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"url":"\/documentation\/planarity\/planarembedding","type":"topic"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/rightFace(from:alongEdgeAt:)":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(from:alongEdgeAt:)","abstract":[{"text":"The position in ","type":"text"},{"type":"codeVoice","code":"faces"},{"text":" of the face to the right of edge ","type":"text"},{"type":"codeVoice","code":"position"},{"text":" crossed from ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":" ","type":"text"},{"text":"(OGDF’s ","type":"text"},{"type":"codeVoice","code":"rightFace"},{"text":"): the face ","type":"text"},{"type":"codeVoice","code":"face(from:alongEdgeAt:)"},{"text":" walks. Crossed from its other end,","type":"text"},{"text":" ","type":"text"},{"text":"an edge has the face on its other side, the same one for a bridge. For a self-loop, th