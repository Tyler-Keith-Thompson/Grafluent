{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of"},{"type":"text","text":" "},{"type":"text","text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2."},{"type":"text","text":" "},{"type":"text","text":"Each clockwise order starts at the first edge of "},{"code":"incidentEdges(of:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Faces."}],"type":"strong"},{"type":"text","text":" The face after the half-edge from u along edge e to w continues with the half-edge"},{"type":"text","text":" "},{"type":"text","text":"before e in the clockwise order at w, so a face lies to the right of each of its half-edges."},{"type":"text","text":" "},{"type":"text","text":"Faces are counted per connected component, and an isolated vertex has none: two disjoint"},{"type":"text","text":" "},{"type":"text","text":"triangles have four faces."}]},{"type":"paragraph","inlineContent":[{"text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph","type":"text"},{"text":" ","type":"text"},{"text":"afterwards does not change it. When a graph has several embeddings, which one is returned is","type":"text"},{"text":" ","type":"text"},{"text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same","type":"text"},{"text":" ","type":"text"},{"text":"edge positions and the same incidence order get the same embedding.","type":"text"}]}],"kind":"content"}],"sections":[],"abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding"]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"],"generated":true,"anchor":"Structures"},{"title":"Instance Properties","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarit