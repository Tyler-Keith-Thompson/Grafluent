{"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"],"anchor":"Structures"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(from:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(from:alongEdgeAt:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/CustomStringConvertible-Implementations"],"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding"]}],"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P"}]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of","type":"text"},{"text":" ","type":"text"},{"text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2.","type":"text"},{"text":" ","type":"text"},{"text":"Each clockwise order starts at the first edge of ","type":"text"},{"code":"incidentEdges(of:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Faces.","type":"text"}],"type":"strong"},{"text":" The face after the half-edge from u along edge e to w continues with the half-edge","type":"text"},{"text":" ","type":"text"},{"text":"before e in the clockwise order at w, so a face lies to the right of each of its half-edges.","type":"text"},{"text":" ","type":"text"},{"text":"Faces are counted per connected component, and an isolated vertex has none: two disjoint","type":"text"},{"text":" ","type":"text"},{"text":"triangles have four faces.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph","type":"text"},{"text":" ","type":"text"},{"text":"afterwards does not change it. When a graph has several embeddings, which one is returned is","type":"text"},{"text":" ","type":"text"},{"text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same","type":"text"},{"text":" ","type":"text"},{"text":"edge positions and the same incidence order get the same embedding.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Planarity\/s8CopyableP","doc:\/\/Planarity\/s23CustomStringConvertibleP","doc:\/\/Planarity\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"metadata":{"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"PlanarEmbedding","modules":[{"name":"Planarity"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"externalID":"s:9Planarity15PlanarEmbeddingV","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}]},"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding/clockwiseIncidentEdges(of:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clockwiseIncidentEdges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind