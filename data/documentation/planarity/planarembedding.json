y\/s9EscapableP","doc:\/\/Planarity\/s8SendableP","doc:\/\/Planarity\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each"},{"type":"text","text":" "},{"type":"text","text":"vertex, over every edge position (NetworkX’s "},{"code":"PlanarEmbedding","type":"codeVoice"},{"type":"text","text":", LEMON’s "},{"code":"PlanarEmbedding","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"OGDF’s "},{"code":"CombinatorialEmbedding","type":"codeVoice"},{"type":"text","text":"). Its faces satisfy Euler’s formula, n − m + f = 2, in every"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge."}],"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"sections":[],"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"PlanarEmbedding"}],"roleHeading":"Structure","role":"symbol","modules":[{"name":"Planarity"}],"title":"PlanarEmbedding","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L67","fileName":"PlanarEmbedding.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"externalID":"s:9Planarity15PlanarEmbeddingV"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of"},{"type":"text","text":" "},{"type":"text","text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2."},{"type":"text","text":" "},{"type":"text","text":"Each clockwise order starts at the first edge of "},{"code":"incidentEdges(of:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Faces."}]},{"type":"text","text":" The face after the half-edge from u along edge e to w continues with the half-edge"},{"type":"text","text":" "},{"type":"text","text":"before e in the clockwise order at w (NetworkX’s "},{"type":"codeVoice","code":"next_face_half_edge"},{"type":"text","text":"), so a face lies to the"},{"type":"text","text":" "},{"type":"text","text":"right of each of its half-edges. Faces are counted per connected component, and an isolated"},{"type":"text","text":" "},{"type":"text","text":"vertex has none: two disjoint triangles have four faces."}],"type":"paragraph"},{"inlineContent":[{"text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph","type":"text"},{"text":" ","type":"text"},{"text":"afterwards does not change it. When a graph has several embeddings, which one is returned is","type":"text"},{"text":" ","type":"text"},{"text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same","type":"text"},{"text":" ","type":"text"},{"text":"edge positions and the same incidence order get the same embedding.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding/faceCount":{"abstract":[{"text":"The number of faces: Σ (2 − n_c + m_c) over the connected components with an edge.","type":"text"}],"role":"symbol","title":"faceCount","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","url":"\/documentation\/planarity\/planarembedding\/facecount","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"faceCount","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://Planarity/s23CustomStringConvertibleP":{"title":"Swift.CustomStringConvertible","type":"unresolvable","identifier":"doc:\/\/Planarity\/s23CustomStringConvertibleP"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/rightFace(checkedFrom:alongEdgeAt:)":{"abstract":[{"code":"rightFace(from: vertex, alongEdgeAt: position)","type":"codeVoice"},{"type":"text","text":", throwing instead of trapping when the"},{"type":"text","text":" "},{"type":"text","text":"pair names no half-edge, as "},{"code":"face(checkedFrom:alongEdgeAt:)","type":"codeVoice"},{"type":"text","text":" does. O(degree)."}],"role":"symbol","title":"rightFace(checkedFrom:alongEdgeAt:)","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/rightFace(checkedFrom:alongEdgeAt:)","type":"topic","kind":"symbol","url":"\/documentation\/planarity\/planarembedding\/rightface(checkedfrom:alongedgeat:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rightFace"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checkedFrom"},{"kind":"text","text":": "},{"kind":"typeIdentifier"