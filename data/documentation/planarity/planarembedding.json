{"metadata":{"modules":[{"name":"Planarity"}],"symbolKind":"struct","title":"PlanarEmbedding","role":"symbol","roleHeading":"Structure","externalID":"s:9Planarity15PlanarEmbeddingV","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L66","fileName":"PlanarEmbedding.swift"}},"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/face(checkedFrom:alongEdgeAt:)","doc:\/\/Planarity\/documentation\/