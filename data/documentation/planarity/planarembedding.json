{"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A self-loop appears twice in its vertex’s order, its two ends adjacent, enclosing a face of","type":"text"},{"text":" ","type":"text"},{"text":"length 1. Parallel copies sit side by side, each consecutive pair enclosing a face of length 2.","type":"text"},{"text":" ","type":"text"},{"text":"Each clockwise order starts at the first edge of ","type":"text"},{"type":"codeVoice","code":"incidentEdges(of:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Faces.","type":"text"}]},{"type":"text","text":" The face after the half-edge from u along edge e to w continues with the half-edge"},{"type":"text","text":" "},{"type":"text","text":"before e in the clockwise order at w, so a face lies to the right of each of its half-edges."},{"type":"text","text":" "},{"type":"text","text":"Faces are counted per connected component, and an isolated vertex has none: two disjoint"},{"type":"text","text":" "},{"type":"text","text":"triangles have four faces."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph"},{"type":"text","text":" "},{"type":"text","text":"afterwards does not change it. When a graph has several embeddings, which one is returned is"},{"type":"text","text":" "},{"type":"text","text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same"},{"type":"text","text":" "},{"type":"text","text":"edge positions and the same incidence order get the same embedding."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/planarity\/planarembedding"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseIncidentEdges","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighborIndices","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/ClockwiseNeighbors","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/Faces-swift.struct"],"title":"Structures","anchor":"Structures"},{"generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faceCount","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/faces-swift.property"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseIncidentEdges(of:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighborIndices(ofIndex:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(checked:)","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/clockwiseNeighbors(of:)","doc:\/\/Planarity\/documentation