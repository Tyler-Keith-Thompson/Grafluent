":"text","text":" "},{"type":"text","text":"Each clockwise order starts at the first edge of "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Faces.","type":"text"}],"type":"strong"},{"text":" The face after the half-edge from u along edge e to w continues with the half-edge","type":"text"},{"text":" ","type":"text"},{"text":"before e in the clockwise order at w, so a face lies to the right of each of its half-edges.","type":"text"},{"text":" ","type":"text"},{"text":"Faces are counted per connected component, and an isolated vertex has none: two disjoint","type":"text"},{"text":" ","type":"text"},{"text":"triangles have four faces.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The embedding keeps the graph it was made from (copy-on-write, so O(1)); mutating the graph"},{"type":"text","text":" "},{"type":"text","text":"afterwards does not change it. When a graph has several embeddings, which one is returned is"},{"type":"text","text":" "},{"type":"text","text":"not specified, but it depends only on the graph’s rows: graphs with the same vertices, the same"},{"type":"text","text":" "},{"type":"text","text":"edge positions and the same incidence order get the same embedding."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/PlanarEmbedding.swift#L66","fileName":"PlanarEmbedding.swift"},"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"Planarity"}],"symbolKind":"struct","externalID":"s:9Planarity15PlanarEmbeddingV","title":"PlanarEmbedding","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}]},"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding/dualGraph()":{"url":"\