{"sections":[],"metadata":{"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"G","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dualGraph"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs11PseudographV","text":"Pseudograph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}],"role":"symbol","externalID":"s:9Planarity15PlanarEmbeddingV9dualGraph11Multigraphs11PseudographVySiGyF","remoteSource":{"fileName":"DualGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/DualGraph.swift#L20"},"modules":[{"name":"Planarity"}],"title":"dualGraph()","roleHeading":"Instance Method","extendedModule":"Planarity","symbolKind":"method"},"variants":[{"paths":["\/documentation\/planarity\/planarembedding\/dualgraph()"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding"]]},"kind":"symbol","abstract":[{"type":"text","text":"The dual graph of the embedding: a vertex for each face, and for each edge an edge joining"},{"type":"text","text":" "},{"type":"text","text":"the two faces it separates."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dualGraph","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11Multigraphs11PseudographV","text":"Pseudograph","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A pseudograph on ","type":"text"},{"code":"0..<faceCount","type":"codeVoice"},{"text":" with one edge per edge of the graph.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Vertex "},{"type":"codeVoice","code":"f"},{"type":"text","text":" is the face at position "},{"type":"codeVoice","code":"f"},{"type":"text","text":" in "},{"type":"codeVoice","code":"faces"},{"type":"text","text":". The edge at position "},{"type":"codeVoice","code":"k"},{"type":"text","text":" is the dual of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th edge of the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": it joins the face to the right of that edge crossed"},{"type":"text","text":" "},{"type":"text","text":"from its end with the lower vertex number (for a self-loop, its end listed first) and the"},{"type":"text","text":" "},{"type":"text","text":"face to its right crossed from the other end, in that order. A bridge has one face on both"},{"type":"text","text":" "},{"type":"text","text":"sides, so its dual is a self-loop; the edges around a vertex of degree d become d edges"},{"type":"text","text":" "},{"type":"text","text":"around its dual face, parallel when two of them separate the same two faces. Faces are"},{"type":"text","text":" "},{"type":"text","text":"counted per connected component, so the dual of a disconnected graph is the disjoint union"},{"type":"text","text":" "},{"type":"text","text":"of its components’ duals, and an isolated vertex contributes nothing."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"O(n + m).","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Complexity"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Planarity/documentation/Planarity":{"role":"collection","type":"topic","abstract":[],"kind":"symbol","title":"Planarity","identifier":"doc:\/\/Planarity\/documentation\/Planarity","url":"\/documentation\/planarity"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/dualGraph()":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"G"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}]},"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The dual graph of the embedding: a vertex for each face, and for each edge an edge joining"},{"type":"text","text":" "},{"type":"text","text":"the two faces it separates."}],"kind":"symbol","title":"dualGraph()","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","url":"\/documentation\/planarity\/planarembedding\/dualgraph()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dualGraph"},{"kind":"text","text":"() -> "},{"text":"Pseudograph","preciseIdentifier":"s:11Multigraphs11PseudographV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Multigraphs/documentation/Multigraphs/Pseudograph":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Pseudograph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph that allows parallel edges and self-loops."}],"identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph","navigatorTitle":[{"text":"Pseudograph","kind":"identifier"}],"type":"topic","url":"\/documentation\/multigraphs\/pseudograph","kind":"symbol","title":"Pseudograph"},"doc://Planarity/documentation/Planarity/PlanarEmbedding":{"title":"PlanarEmbedding","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PlanarEmbedding"}],"type":"topic","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"url":"\/documentation\/planarity\/planarembedding"}}}