{"sections":[],"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding"]]},"metadata":{"role":"symbol","externalID":"s:9Planarity15PlanarEmbeddingV9dualGraph11Multigraphs11PseudographVySiGyF","title":"dualGraph()","extendedModule":"Planarity","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"G"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dualGraph"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs11PseudographV","text":"Pseudograph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}],"remoteSource":{"fileName":"DualGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/DualGraph.swift#L20"},"modules":[{"name":"Planarity"}],"roleHeading":"Instance Method","symbolKind":"method"},"kind":"symbol","abstract":[{"text":"The dual graph of the embedding: a vertex for each face, and for each edge an edge joining","type":"text"},{"text":" ","type":"text"},{"text":"the two faces it separates.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dualGraph"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Pseudograph","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph","preciseIdentifier":"s:11Multigraphs11PseudographV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"A pseudograph on ","type":"text"},{"code":"0..<faceCount","type":"codeVoice"},{"text":" with one edge per edge of the graph.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Vertex "},{"type":"codeVoice","code":"f"},{"type":"text","text":" is the face at position "},{"type":"codeVoice","code":"f"},{"type":"text","text":" in "},{"type":"codeVoice","code":"faces"},{"type":"text","text":". The edge at position "},{"type":"codeVoice","code":"k"},{"type":"text","text":" is the dual of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th edge of the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": it joins the face to the right of that edge crossed"},{"type":"text","text":" "},{"type":"text","text":"from its end with the lower vertex number (for a self-loop, its end listed first) and the"},{"type":"text","text":" "},{"type":"text","text":"face to its right crossed from the other end, in that order. A bridge has one face on both"},{"type":"text","text":" "},{"type":"text","text":"sides, so its dual is a self-loop; the edges around a vertex of degree d become d edges"},{"type":"text","text":" "},{"type":"text","text":"around its dual face, parallel when two of them separate the same two faces. Faces are"},{"type":"text","text":" "},{"type":"text","text":"counted per connected component, so the dual of a disconnected graph is the disjoint union"},{"type":"text","text":" "},{"type":"text","text":"of its components’ duals, and an isolated vertex contributes nothing."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O(n + m)."}],"type":"paragraph"}],"name":"Complexity","type":"aside"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding\/dualgraph()"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding":{"title":"PlanarEmbedding","type":"topic","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"abstract":[{"type":"text","text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each"},{"type":"text","text":" "},{"type":"text","text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge."}],"url":"\/documentation\/planarity\/planarembedding","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Planarity/documentation/Planarity":{"url":"\/documentation\/planarity","kind":"symbol","title":"Planarity","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/Planarity\/documentation\/Planarity"},"doc://Multigraphs/documentation/Multigraphs/Pseudograph":{"kind":"symbol","title":"Pseudograph","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Pseudograph"}],"navigatorTitle":[{"kind":"identifier","text":"Pseudograph"}],"url":"\/documentation\/multigraphs\/pseudograph","abstract":[{"text":"An undirected graph that allows parallel edges and self-loops.","type":"text"}],"type":"topic"},"doc://Planarity/documentation/Planarity/PlanarEmbedding/dualGraph()":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","kind":"symbol","url":"\/documentation\/planarity\/planarembedding\/dualgraph()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dualGraph","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Pseudograph","kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs11PseudographV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"title":"dualGraph()","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"G","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":".","type":"text"}]},"type":"topic","abstract":[{"type":"text","text":"The dual graph of the embedding: a vertex for each face, and for each edge an edge joining"},{"type":"text","text":" "},{"type":"text","text":"the two faces it separates."}],"role":"symbol"}}}