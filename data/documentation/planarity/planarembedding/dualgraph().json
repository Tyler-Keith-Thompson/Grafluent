{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Planarity\/documentation\/Planarity","doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dualGraph"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11Multigraphs11PseudographV","kind":"typeIdentifier","text":"Pseudograph","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pseudograph on "},{"type":"codeVoice","code":"0..<faceCount"},{"type":"text","text":" with one edge per edge of the graph."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Vertex "},{"type":"codeVoice","code":"f"},{"type":"text","text":" is the face at position "},{"type":"codeVoice","code":"f"},{"type":"text","text":" in "},{"type":"codeVoice","code":"faces"},{"type":"text","text":". The edge at position "},{"type":"codeVoice","code":"k"},{"type":"text","text":" is the dual of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th edge of the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":": it joins the face to the right of that edge crossed"},{"type":"text","text":" "},{"type":"text","text":"from its end with the lower vertex number (for a self-loop, its end listed first) and the"},{"type":"text","text":" "},{"type":"text","text":"face to its right crossed from the other end, in that order. A bridge has one face on both"},{"type":"text","text":" "},{"type":"text","text":"sides, so its dual is a self-loop; the edges around a vertex of degree d become d edges"},{"type":"text","text":" "},{"type":"text","text":"around its dual face, parallel when two of them separate the same two faces. Faces are"},{"type":"text","text":" "},{"type":"text","text":"counted per connected component, so the dual of a disconnected graph is the disjoint union"},{"type":"text","text":" "},{"type":"text","text":"of its components’ duals, and an isolated vertex contributes nothing."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n + m).","type":"text"}]}],"type":"aside"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/planarity\/planarembedding\/dualgraph()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"dualGraph()","roleHeading":"Instance Method","externalID":"s:9Planarity15PlanarEmbeddingV9dualGraph11Multigraphs11PseudographVySiGyF","modules":[{"name":"Planarity"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dualGraph","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11Multigraphs11PseudographV","text":"Pseudograph","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","conformance":{"constraints":[{"code":"G","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"extendedModule":"Planarity","role":"symbol","remoteSource":{"fileName":"DualGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/DualGraph.swift#L20"}},"abstract":[{"text":"The dual graph of the embedding: a vertex for each face, and for each edge an edge joining","type":"text"},{"text":" ","type":"text"},{"text":"the two faces it separates.","type":"text"}],"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","interfaceLanguage":"swift"},"references":{"doc://Planarity/documentation/Planarity":{"abstract":[],"role":"collection","identifier":"doc:\/\/Planarity\/documentation\/Planarity","type":"topic","title":"Planarity","kind":"symbol","url":"\/documentation\/planarity"},"doc://Multigraphs/documentation/Multigraphs/Pseudograph":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Pseudograph"}],"title":"Pseudograph","type":"topic","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Pseudograph"}],"url":"\/documentation\/multigraphs\/pseudograph","abstract":[{"type":"text","text":"An undirected graph that allows parallel edges and self-loops."}]},"doc://Planarity/documentation/Planarity/PlanarEmbedding/dualGraph()":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dualGraph"},{"kind":"text","text":"() -> "},{"text":"Pseudograph","kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs11PseudographV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"url":"\/documentation\/planarity\/planarembedding\/dualgraph()","abstract":[{"type":"text","text":"The dual graph of the embedding: a vertex for each face, and for each edge an edge joining"},{"type":"text","text":" "},{"type":"text","text":"the two faces it separates."}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"G","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"kind":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","title":"dualGraph()","role":"symbol"},"doc://Planarity/documentation/Planarity/PlanarEmbedding":{"title":"PlanarEmbedding","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","url":"\/documentation\/planarity\/planarembedding","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"abstract":[{"type":"text","text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each"},{"type":"text","text":" "},{"type":"text","text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"role":"symbol"}}}