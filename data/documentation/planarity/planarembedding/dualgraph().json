tation\/Multigraphs\/Pseudograph","preciseIdentifier":"s:11Multigraphs11PseudographV","text":"Pseudograph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pseudograph on "},{"type":"codeVoice","code":"0..<faceCount"},{"type":"text","text":" with one edge per edge of the graph."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertex "},{"code":"f","type":"codeVoice"},{"type":"text","text":" is the face at position "},{"code":"f","type":"codeVoice"},{"type":"text","text":" in "},{"code":"faces","type":"codeVoice"},{"type":"text","text":". The edge at position "},{"code":"k","type":"codeVoice"},{"type":"text","text":" is the dual of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"k","type":"codeVoice"},{"type":"text","text":"th edge of the graph’s "},{"code":"edges","type":"codeVoice"},{"type":"text","text":": it joins the face to the right of that edge crossed"},{"type":"text","text":" "},{"type":"text","text":"from its end with the lower vertex number (for a self-loop, its end listed first) and the"},{"type":"text","text":" "},{"type":"text","text":"face to its right crossed from the other end, in that order. A bridge has one face on both"},{"type":"text","text":" "},{"type":"text","text":"sides, so its dual is a self-loop; the edges around a vertex of degree d become d edges"},{"type":"text","text":" "},{"type":"text","text":"around its dual face, parallel when two of them separate the same two faces. Faces are"},{"type":"text","text":" "},{"type":"text","text":"counted per connected component, so the dual of a disconnected graph is the disjoint union"},{"type":"text","text":" "},{"type":"text","text":"of its components’ duals, and an isolated vertex contributes nothing."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m)."}]}]}]}],"references":{"doc://Planarity/documentation/Planarity/PlanarEmbedding":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlanarEmbedding","kind":"identifier"}],"navigatorTitle":[{"text":"PlanarEmbedding","kind":"identifier"}],"abstract":[{"text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each","type":"text"},{"text":" ","type":"text"},{"text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every","type":"text"},{"text":" ","type":"text"},{"text":"connected component with an edge.","type":"text"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","type":"topic","title":"PlanarEmbedding","url":"\/documentation\/planarity\/planarembedding","kind":"symbol"},"doc://Multigraphs/documentation/Multigraphs/Pseudograph":{"navigatorTitle":[{"text":"Pseudograph","kind":"identifier"}],"identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/Pseudograph","abstract":[{"type":"text","text":"An undirected graph that allows parallel edges and self-loops."}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/multigraphs\/pseudograph","title":"Pseudograph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Pseudograph","kind":"identifier"}]},"doc://Planarity/documentation/Planarity/PlanarEmbedding/dualGraph()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dualGraph"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs11PseudographV","text":"Pseudograph"},{"kind":"tex