xt":" ","type":"text"},{"text":"around its dual face, parallel when two of them separate the same two faces. Faces are","type":"text"},{"text":" ","type":"text"},{"text":"counted per connected component, so the dual of a disconnected graph is the disjoint union","type":"text"},{"text":" ","type":"text"},{"text":"of its components’ duals, and an isolated vertex contributes nothing.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m)."}]}],"name":"Complexity","style":"note","type":"aside"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/planarembedding\/dualgraph()"]}],"identifier":{"url":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding\/dualGraph()","interfaceLanguage":"swift"},"metadata":{"title":"dualGraph()","remoteSource":{"fileName":"DualGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Planarity\/DualGraph.swift#L20"},"extendedModule":"Planarity","externalID":"s:9Planarity15PlanarEmbeddingV9dualGraph11Multigraphs11PseudographVySiGyF","modules":[{"name":"Planarity"}],"role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"G","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":".","type":"text"}]},"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dualGraph","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Pseudograph","kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs11PseudographV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}]},"abstract":[{"text":"The dual graph of the embedding: a vertex for 