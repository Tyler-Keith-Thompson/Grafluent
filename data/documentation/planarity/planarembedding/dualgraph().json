ct":[{"type":"text","text":"The dual graph of the embedding: a vertex for each face, and for each edge an edge joining"},{"type":"text","text":" "},{"type":"text","text":"the two faces it separates."}],"title":"dualGraph()"},"doc://Planarity/documentation/Planarity/PlanarEmbedding":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/PlanarEmbedding","abstract":[{"type":"text","text":"A planar embedding of a graph: a rotation system, the clockwise order of the edges around each"},{"type":"text","text":" "},{"type":"text","text":"vertex, over every edge position. Its faces satisfy Euler’s formula, n − m + f = 2, in every"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge."}],"kind":"symbol","type":"topic","url":"\/documentation\/planarity\/planarembedding","title":"PlanarEmbedding","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlanarEmbedding"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PlanarEmbedding"}]}}}