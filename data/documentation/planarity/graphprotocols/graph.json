{"abstract":[{"type":"text","text":"Planarity on undirected graphs. Self-loops and parallel edges never change an answer: the tests"},{"type":"text","text":" "},{"type":"text","text":"run on the underlying simple graph, read once through the rows in index space. A directed"},{"type":"text","text":" "},{"type":"text","text":"graph’s planarity is that of "},{"type":"codeVoice","code":"graph.undirectedView"},{"type":"text","text":"."}],"topicSections":[{"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isOuterplanar","doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isPlanar"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/findKuratowskiSubgraph()","doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/planarEmbedding()"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"metadata":{"modules":[{"name":"Planarity","relatedModules":["GraphProtocols"]}],"role":"symbol","title":"Graph","roleHeading":"Extended Protocol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"extendedModule":"GraphProtocols","externalID":"s:e:s:14GraphProtocols0A0P9PlanarityE16_planarEdgeLimitSivp","symbolKind":"extension","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/planarity\/graphprotocols\/graph"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"typeIdentifier"}]}],"kind"