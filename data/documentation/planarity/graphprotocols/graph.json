).","type":"text"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isPlanar","title":"isPlanar","kind":"symbol","url":"\/documentation\/planarity\/graphprotocols\/graph\/isplanar","type":"topic","role":"symbol"},"doc://Planarity/documentation/Planarity/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols","title":"GraphProtocols","kind":"symbol","url":"\/documentation\/planarity\/graphprotocols","type":"topic","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"type":"topic","kind":"symbol","title":"Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}]},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph":{"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/planarity\/graphprotocols\/graph","abstract":[{"type":"text","text":"Planarity on undirected graphs. Self-loops and parallel edges never change an answer: the tests"},{"type":"text","text":" "},{"type":"text","text":"run on the underlying simple graph, read once through the rows in index space. A directed"},{"type":"text","text":" "},{"type":"text","text":"graph’s planarity is that of "},{"type":"codeVoice","code":"graph.undirectedView"},{"type":"text","text":"."}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Gr