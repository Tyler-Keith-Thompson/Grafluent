/graph\/findkuratowskisubgraph()","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/findKuratowskiSubgraph()","kind":"symbol"},"doc://Planarity/documentation/Planarity":{"title":"Planarity","role":"collection","abstract":[],"type":"topic","url":"\/documentation\/planarity","identifier":"doc:\/\/Planarity\/documentation\/Planarity","kind":"symbol"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/isOuterplanar":{"title":"isOuterplanar","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isOuterplanar","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether the graph has a planar embedding with every vertex on one face: whether the graph"},{"type":"text","text":" "},{"type":"text","text":"plus a new vertex joined to every vertex is planar. A simple graph with more than 2n − 3"},{"type":"text","text":" "},{"type":"text","text":"edges is not. O(n + m)."}],"type":"topic","url":"\/documentation\/planarity\/graphprotocols\/graph\/isouterplanar","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isOuterplanar","kind":"symbol"}}}