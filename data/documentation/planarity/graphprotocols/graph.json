rity\/graphprotocols\/graph","title":"Graph","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"kind":"symbol"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/planarEmbedding()":{"abstract":[{"type":"text","text":"A planar embedding of the graph, over every edge position (loops and parallel copies"},{"type":"text","text":" "},{"type":"text","text":"included), or nil when the graph is not planar: the witness of planarity (NetworkX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"check_planarity"},{"type":"text","text":", Boost’s "},{"type":"codeVoice","code":"embedding"},{"type":"text","text":" output). O(n + m), faces included."}],"role":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/planarEmbedding()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarEmbedding"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:9Planarity15PlanarEmbeddingV","text":"PlanarEmbedding"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"url":"\/documentation\/planarity\/graphprotocols\/graph\/planarembedding()","title":"planarEmbedding()","type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","role":"symbol","url":"\/documentation\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Planarity/documentation/Planarity/GraphProtocols":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols","abstract":[],"title":"GraphProtocols","role":"collection","url":"\/documentation\/planarity\/graphprotocols"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/isOuterplanar":{"abstract":[{"type":"text","text":"Whether the graph has a planar embedding with every vertex on one face (Mathematica’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"OuterplanarGraphQ"},{"type":"text","text":"): whether the graph plus a new vertex joined to every vertex is planar."},{"type":"text","text":" "},{"type":"text","text":"A simple graph with more than 2n − 3 edges is not. O(n + m)."}],"role":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isOuterplanar","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isOuterplanar"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/planarity\/graphprotocols\/graph\/isouterplanar","title":"isOuterplanar","type":"topic","kind":"symbol"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/isPlanar":{"title":"isPlanar","role":"symbol","url":"\/documentation\/planarity\/graphprotocols\/graph\/isplanar","type":"topic","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isPlanar","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPlanar","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Whether the graph can be drawn in the plane without crossing edges (NetworkX’s "},{"type":"codeVoice","code":"is_planar"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Boost’s "},{"type":"codeVoice","code":"boyer_myrvold_planarity_test"},{"type":"text","text":"). A simple graph with more than 3n − 6 edges is not,"},{"type":"text","text":" "},{"type":"text","text":"which is answered after counting distinct pairs, before any search. O(n + m)."}]},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/findKuratowskiSubgraph()":{"abstract":[{"type":"text","text":"A subdivision of K₅ or K₃,₃ made of the graph’s edges, or nil when the graph is planar: the"},{"type":"text","text":" "},{"type":"text","text":"witness of non-planarity (Boost’s "},{"type":"codeVoice","code":"kuratowski_subgraph"},{"type":"text","text":", JGraphT’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"getKuratowskiSubdivision()"},{"type":"text","text":"). A dense graph is searched on its first 3n − 5 distinct pairs"},{"type":"text","text":" "},{"type":"text","text":"only, which already hold one. O(n + m)."}],"role":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/findKuratowskiSubgraph()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"findKuratowskiSubgraph"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"KuratowskiSubgraph","preciseIdentifier":"s:9Planarity18KuratowskiSubgraphV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">?"}],"url":"\/documentation\/planarity\/graphprotocols\/graph\/findkuratowskisubgraph()","title":"findKuratowskiSubgraph()","type":"topic","kind":"symbol"},"doc://Planarity/documentation/Planarity":