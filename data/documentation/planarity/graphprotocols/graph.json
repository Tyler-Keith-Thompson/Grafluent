t","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"url":"\/documentation\/graphprotocols\/graph","type":"topic","title":"Graph"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph","abstract":[{"text":"Planarity on undirected graphs. Self-loops and parallel edges never change an answer: the tests","type":"text"},{"text":" ","type":"text"},{"text":"run on the underlying simple graph, read once through the rows in index space. A directed","type":"text"},{"text":" ","type":"text"},{"text":"graph’s planarity is that of ","type":"text"},{"code":"graph.undirected","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/planarity\/graphprotocols\/graph","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"title":"Graph"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/isOuterplanar":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isOuterplanar","abstract":[{"type":"text","text":"Whether the graph has a planar embedding with every vertex on one face (Mathematica’s"},{"type":"text","text":" "},{"code":"OuterplanarGraphQ","type":"codeVoice"},{"type":"text","text":"): whether the graph plus a new vertex joined to every vertex is planar."},{"type":"text","text":" "},{"type":"text","text":"A simple graph with more than 2n − 3 edges is not. O(n + m)."}],"url":"\/documentation\/planarity\/graphprotocols\/graph\/isouterplanar","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isOuterplanar","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"isOuterplanar"},"doc://Planarity/documentation/Planarity":{"role":"collection","title":"Planarity","url":"\/documentation\/planarity","type":"topic","identifier":"doc:\/\/Planarity\/documentation\/Planarity","kind":"symbol","abstract":[]},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/findKuratowskiSubgraph()":{"kind":"symbol","abstract":[{"text":"A subdivision of K₅ or K₃,₃ made of the graph’s edges, or nil when the graph is planar: the","type":"text"},{"text":" ","type":"text"},{"text":"witness of non-planarity (Boost’s ","type":"text"},{"type":"codeVoice","code":"kuratowski_subgraph"},{"text":", JGraphT’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"getKuratowskiSubdivision()"},{"text":"). A dense graph is searched on its first 3n − 5 distinct pairs","type":"text"},{"text":" ","type":"text"},{"text":"only, which already hold one. O(n + m).","type":"text"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/findKuratowskiSubgraph()","title":"findKuratowskiSubgraph()","role":"symbol","type":"topic","url":"\/documentation\/planarity\/graphprotocols\/graph\/findkuratowskisubgraph()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findKuratowskiSubgraph","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KuratowskiSubgraph","preciseIdentifier":"s:9Planarity18KuratowskiSubgraphV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://Planarity/documentation/Planarity/GraphProtocols":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols","abstract":[],"title":"GraphProtocols","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/planarity\/graphprotocols"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/isPlanar":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isPlanar","abstract":[{"text":"Whether the graph can be drawn in the plane without crossing edges (NetworkX’s ","type":"text"},{"type":"codeVoice","code":"is_planar"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Boost’s ","type":"text"},{"type":"codeVoice","code":"boyer_myrvold_planarity_test"},{"text":"). A simple graph with more than 3n − 6 edges is not,","type":"text"},{"text":" ","type":"text"},{"text":"which is answered after counting distinct pairs, before any search. O(n + m).","type":"text"}],"url":"\/documentation\/planarity\/graphprotocols\/graph\/isplanar","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isPlanar","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isPlanar"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/planarEmbedding()":{"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/planarEmbedding()","abstract":[{"text":"A planar embedding of the graph, over every edge position (loops and parallel copies","type":"text"},{"text":" ","type":"text"},{"text":"included), or nil when the graph is not planar: the witness of planarity (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"check_planarity","type":"codeVoice"},{"text":", Boost’s ","type":"text"},{"code":"embedding","type":"codeVoice"},{"text":" output). O(n + m), faces included.","type":"text"}],"title":"planarEmbedding()","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/planarity\/graphprotocols\/graph\/planarembedding()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarEmbedding"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":