le graph with more"},{"type":"text","text":" "},{"type":"text","text":"than 3n − 6 edges is not, which is answered after counting distinct pairs, before any"},{"type":"text","text":" "},{"type":"text","text":"search. O(n + m)."}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/isPlanar","title":"isPlanar","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isPlanar"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","role":"symbol","url":"\/documentation\/planarity\/graphprotocols\/graph\/isplanar"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"title":"Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"type":"topic","kind":"symbol"}}}