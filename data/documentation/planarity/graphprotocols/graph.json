irst 3n − 5 distinct pairs only,","type":"text"},{"text":" ","type":"text"},{"text":"which already hold one. O(n + m).","type":"text"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/findKuratowskiSubgraph()"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/planarEmbedding()":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarEmbedding","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"PlanarEmbedding","preciseIdentifier":"s:9Planarity15PlanarEmbeddingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"url":"\/documentation\/planarity\/graphprotocols\/graph\/planarembedding()","abstract":[{"text":"A planar embedding of the graph, over every edge position (loops and parallel copies","type":"text"},{"text":" ","type":"text"},{"text":"included), or nil when the graph is not planar: the witness of planarity. O(n + m), faces","type":"text"},{"text":" ","type":"text"},{"text":"included.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/planarEmbedding()","title":"planarEmbedding()","role":"symbol"}}}