fore any"},{"type":"text","text":" "},{"type":"text","text":"search. O(n + m)."}],"url":"\/documentation\/planarity\/graphprotocols\/graph\/isplanar","role":"symbol","kind":"symbol"},"doc://Planarity/documentation/Planarity/GraphProtocols/Graph/findKuratowskiSubgraph()":{"url":"\/documentation\/planarity\/graphprotocols\/graph\/findkuratowskisubgraph()","kind":"symbol","title":"findKuratowskiSubgraph()","type":"topic","role":"symbol","abstract":[{"text":"A subdivision of K₅ or K₃,₃ made of the graph’s edges, or nil when the graph is planar: the","type":"text"},{"text":" ","type":"text"},{"text":"witness of non-planarity. A dense graph is searched on its first 3n − 5 distinct pairs only,","type":"text"},{"text":" ","type":"text"},{"text":"which already hold one. O(n + m).","type":"text"}],"identifier":"doc:\/\/Planarity\/documentation\/Planarity\/GraphProtocols\/Graph\/findKuratowskiSubgraph()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"findKuratowskiSubgraph","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KuratowskiSubgraph","kind":"typeIdentifier","preciseIdentifier":"s:9Planarity18KuratowskiSubgraphV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic","title":"Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphprotocols\/graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol"},"doc://Planarity/documentation/Planarity":{"url":"\/documentation\/planarity","kind":"symbol","title":"Planarity","t