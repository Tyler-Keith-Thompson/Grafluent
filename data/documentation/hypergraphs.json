ct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","type":"topic","role":"symbol","title":"UndirectedIncidenceList","abstract":[{"text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a","type":"text"},{"text":" ","type":"text"},{"text":"row per vertex of its memberships. The undirected counterpart of ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":", named as","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedAdjacencyList","type":"codeVoice"},{"text":" is. (","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", the bit-matrix representation, is the","type":"text"},{"text":" ","type":"text"},{"text":"undirected one of its pair, because “oriented incidence matrix” is the established name of the","type":"text"},{"text":" ","type":"text"},{"text":"other.)","type":"text"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"}],"navigatorTitle":[{"kind":"identifier","text":"UndirectedIncidenceList"}]}}}