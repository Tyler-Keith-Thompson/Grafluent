","type":"codeVoice"},{"type":"text","text":" of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" and "},{"code":"n + p → j","type":"codeVoice"},{"type":"text","text":" for each target "},{"code":"j","type":"codeVoice"},{"type":"text","text":". A vertex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","kind":"symbol","type":"topic","title":"DirectedIncidenceGraphView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"url":"\/documentation\/hypergraphs\/graphprotocols","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","type":"topic","abstract":[],"title":"GraphProtocols","kind":"symbol","role":"collection"},"doc://Hypergraphs/documentation/Hypergraphs":{"kind":"symbol","abstract":[],"url":"\/documentation\/hypergraphs","type":"topic","role":"collection","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs"}}}