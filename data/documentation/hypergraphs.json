encegraphview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"type":"topic","role":"collection","title":"GraphProtocols","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols","abstract":[]}}}