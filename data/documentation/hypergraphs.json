{"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList"]},{"anchor":"Extended-Modules","title":"Extended Modules","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols"]}],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"Hypergraphs"}],"roleHeading":"Framework","role":"collection","title":"Hypergraphs","externalID":"Hypergraphs","symbolKind":"module"},"references":{"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs","role":"collection","type":"topic","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList":{"abstract":[{"type":"text","text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a"},{"type":"text","text":" "},{"type":"text","text":"row per vertex of its memberships. The undirected counterpart of "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", named as"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":" is. ("},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", the bit-matrix representation, is the"},{"type":"text","text":" "},{"type":"text","text":"undirected one of its pair, because “oriented incidence matrix” is the established name of the"},{"type":"text","text":" "},{"type":"text","text":"other.)"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","title":"UndirectedIncidenceList","role":"symbol","type":"topic","navigatorTitle":[{"text":"UndirectedIncidenceList","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0 ..< n + m"},{"text":" whose vertex ","type":"text"},{"type":"codeVoice","code":"i < n"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" and whose vertex ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", with an edge ","type":"text"},{"type":"codeVoice","code":"{i, n + p}"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"title":"DirectedIncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","kind":"symbol","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","role":"collection","kind":"symbol","abstract":[],"type":"topic","title":"GraphProtocols","url":"\/documen