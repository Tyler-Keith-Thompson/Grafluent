ited from ","type":"text"},{"type":"codeVoice","code":"Collection.subscript(_:)"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"url":"\/documentation\/graphprotocols\/directededge","type":"topic","abstract":[{"text":"An edge of a directed graph: the ordered pair (source, target), directed from ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"target","type":"codeVoice"},{"text":".","type":"text"}],"title":"DirectedEdge","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedEdge","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"DirectedEdge","kind":"identifier"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"type":"topic","role":"collection","kind":"symbol","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","abstract":[],"url":"\/documentation\/eliasfanographmodule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph":{"abstract":[{"type":"text","text":"An immutable directed graph on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" whose rows of successors are Elias–Fano"},{"type":"text","text":" "},{"type":"text","text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EFGraph"},{"type":"text","text":" stores them: each row’s ascending targets split into "},{"type":"codeVoice","code":"l"},{"type":"text","text":" low bits, packed, and the"},{"type":"text","text":" "},{"type":"text","text":"high parts written in unary, so a row of "},{"type":"codeVoice","code":"d"},{"type":"text","text":" targets below "},{"type":"codeVoice","code":"n"},{"type":"text","text":" takes about "},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"type":"text","text":" "},{"type":"text","text":"bits instead of "},{"type":"codeVoice","code":"64 d"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","role":"symbol","title":"EliasFanoGraph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct":{"navigatorTitle":[{"kind":"identifier","text":"Edges"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"type":"topic","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct","role":"symbol","abstract":[{"type":"text","text":"The edges of a graph, or a contiguous run of them. Positions are edge indices. Iterating"},{"type":"text","text":" "},{"type":"text","text":"decodes each row once, O(1) amortized per edge; subscripting one position is O(log n +"},{"type":"text","text":" "},{"type":"text","text":"out-degree), so prefer iteration to index loops."}],"kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","title":"EliasFanoGraph.Edges"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/subscript(_:)-7w6qz":{"fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentif