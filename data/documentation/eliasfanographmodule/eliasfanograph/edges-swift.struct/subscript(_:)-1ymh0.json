text":" "},{"type":"text","text":"out-degree), so prefer iteration to index loops."}],"kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","title":"EliasFanoGraph.Edges"}}}