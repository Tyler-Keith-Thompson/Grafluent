er iteration to index loops."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Edges"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct"}}}