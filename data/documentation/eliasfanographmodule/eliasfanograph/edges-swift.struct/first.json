t":"EliasFanoGraph"}],"abstract":[{"text":"An immutable directed graph on the vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" whose rows of successors are Elias–Fano","type":"text"},{"text":" ","type":"text"},{"text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s","type":"text"},{"text":" ","type":"text"},{"code":"EFGraph","type":"codeVoice"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"code":"l","type":"codeVoice"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" targets below ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"abstract":[],"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/eliasfanographmodule","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule"}}}