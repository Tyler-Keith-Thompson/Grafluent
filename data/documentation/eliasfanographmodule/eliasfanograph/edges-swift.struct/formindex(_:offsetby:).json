ebGraph’s","type":"text"},{"text":" ","type":"text"},{"code":"EFGraph","type":"codeVoice"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"code":"l","type":"codeVoice"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" targets below ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","title":"EliasFanoGraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"kind":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/formIndex(_:offsetBy:)":{"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/formindex(_:offsetby:)","title":"formIndex(_:offsetBy:)","abstract":[],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"formIndex"},{"kind":"text","text":"("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":", "},{"kind":"externalParam","text":"offsetBy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":")"}],"role":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct\/formIndex(_:offsetBy:)"},"doc://EliasFanoGraphModule/documentation/Elia