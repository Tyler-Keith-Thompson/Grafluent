 Iterating","type":"text"},{"text":" ","type":"text"},{"text":"decodes each row once, O(1) amortized per edge; subscripting one position is O(log n +","type":"text"},{"text":" ","type":"text"},{"text":"out-degree), so prefer iteration to index loops.","type":"text"}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","title":"EliasFanoGraph.Edges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}],"kind":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"role":"collection","abstract":[],"url":"\/documentation\/eliasfanographmodule","kind":"symbol","type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","title":"EliasFanoGraphModule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/subscript(_:)-88mok":{"abstract":[],"title":"subscript(_:)","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/subscript(_:)-88mok","kind":"symbol","fragments":[{"text":"subscript","kind":"keyword"},{"text":"((","kind":"text"},{"text":"UnboundedRange_","preciseIdentifier":"s:s15UnboundedRange_O","kind":"typeIdentifier"},{"text":") -> ()) -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"SubSequence","preciseIdentifier":"s:Sl11SubSequenceQa","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct\/subscript(_:)-88mok","role":"symbol"}}}