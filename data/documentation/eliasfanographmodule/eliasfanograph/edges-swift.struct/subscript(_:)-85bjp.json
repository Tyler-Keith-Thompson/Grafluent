iasfanograph\/edges-swift.struct","type":"topic","navigatorTitle":[{"text":"Edges","kind":"identifier"}],"title":"EliasFanoGraph.Edges","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}]}}}