FanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/Iterator":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"abstract":[{"text":"Walks the rows in order from one search for the first source, decoding each row once","type":"text"},{"text":" ","type":"text"},{"text":"and skipping the targets before the first position.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"title":"EliasFanoGraph.Edges.Iterator","role":"symbol","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/iterator","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct\/Iterator"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct":{"kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}],"abstract":[{"text":"The edges of a graph, or a contiguous run of them. Positions are edge indices. Iterating","type":"text"},{"text":" ","type":"text"},{"text":"decodes each row once, O(1) amortized per edge; subscripting one position is O(log n +","type":"text"},{"text":" ","type":"text"},{"text":"out-degree), so prefer iteration to index loops.","type":"text"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct","navigatorTitle":[{"text":"Edges","kind":"identifier"}],"type":"topic","role":"symbol","title":"EliasFanoGraph.Edges"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph":{"abstract":[{"type":"text","text":"An immutable directed graph on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" whose rows of successors are Elias–Fano"},{"type":"text","text":" "},{"type":"text","text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EFGraph"},{"type":"text","text":" stores them: each row’s ascending targets split into "},{"type":"codeVoice","code":"l"},{"type":"text","text":" low bits, packed, and the"},{"type":"text","text":" "},{"type":"text","text":"high parts written in unary, so a row of "},{"type":"codeVoice","code":"d"},{"type":"text","text":" targets below "},{"type":"codeVoice","code":"n"},{"type":"text","text":" takes about "},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"type":"text","text":" "},{"type":"text","text":"bits instead of "},{"type":"codeVoice","code":"64 d"},{"type":"text","text":"."}],"title":"EliasFanoGraph","type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}]}}}