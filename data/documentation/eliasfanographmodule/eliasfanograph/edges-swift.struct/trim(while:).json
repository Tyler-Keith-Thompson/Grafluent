es-swift.struct","role":"symbol","abstract":[{"type":"text","text":"The edges of a graph, or a contiguous run of them. Positions are edge indices. Iterating"},{"type":"text","text":" "},{"type":"text","text":"decodes each row once, O(1) amortized per edge; subscripting one position is O(log n +"},{"type":"text","text":" "},{"type":"text","text":"out-degree), so prefer iteration to index loops."}],"kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","title":"EliasFanoGraph.Edges"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"type":"topic","role":"collection","kind":"symbol","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","abstract":[],"url":"\/documentation\/eliasfanographmodule"}}}