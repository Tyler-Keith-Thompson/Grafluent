","abstract":[{"type":"text","text":"The edges of a graph, or a contiguous run of them. Positions are edge indices. Iterating"},{"type":"text","text":" "},{"type":"text","text":"decodes each row once, O(1) amortized per edge; subscripting one position is O(log n +"},{"type":"text","text":" "},{"type":"text","text":"out-degree), so prefer iteration to index loops."}],"kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","title":"EliasFanoGraph.Edges"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"type":"topic","role":"collection","kind":"symbol","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","abstract":[],"url":"\/documentation\/eliasfanographmodule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/indices(of:)":{"title":"indices(of:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s8RangeSetV","text":"RangeSet","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/indices(of:)","conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Avai