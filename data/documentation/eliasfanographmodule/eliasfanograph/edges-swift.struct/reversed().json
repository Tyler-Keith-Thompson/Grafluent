,"type":"text"},{"code":"d","type":"codeVoice"},{"text":" targets below ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","title":"EliasFanoGraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"kind":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/reversed()":{"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/reversed()","abstract":[],"title":"reversed()","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reversed","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ReversedCollection","preciseIdentifier":"s:s18ReversedCollectionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct\/reversed()"}}}