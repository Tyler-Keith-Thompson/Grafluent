"text":"EliasFanoGraph"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EliasFanoGraph"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph","kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","title":"EliasFanoGraph","abstract":[{"text":"An immutable directed graph on the vertices ","type":"text"},{"type":"codeVoice","code":"0..<n"},{"text":" whose rows of successors are Elias–Fano","type":"text"},{"text":" ","type":"text"},{"text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EFGraph"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"type":"codeVoice","code":"l"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"type":"codeVoice","code":"d"},{"text":" targets below ","type":"text"},{"type":"codeVoice","code":"n"},{"text":" takes about ","type":"text"},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"type":"codeVoice","code":"64 d"},{"text":".","type":"text"}],"role":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"kind":"symbol","title":"EliasFanoGraphModule","type":"topic","role":"collection","abstract":[],"url":"\/documentation\/eliasfanographmodule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct":{"kind":"symbol","title":"EliasFanoGraph.Edges","navigatorTitle":[{"kind":"identifier","text":"Edges"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The edges of a graph, or a contiguous run of them. Positions are edge indices. Iterating"},{"type":"text","text":" "},{"type":"text","text":"decodes each row once, O(1) amortized per edge; subscripting one position is O(log n +"},{"type":"text","text":" "},{"type":"text","text":"out-degree), so prefer iteration to index loops."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Edges"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/Indices-swift.typealias":{"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Indices","kind":"identifier"}],"navigatorTitle":[{"text":"Indices","kind":"identifier"}],"title":"EliasFanoGraph.Edges.Indices","abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/indices-swift.typealias","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct\/Indices-swift.typealias"}}}