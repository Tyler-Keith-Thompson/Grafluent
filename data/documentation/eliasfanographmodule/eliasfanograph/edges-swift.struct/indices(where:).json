:"text"},{"text":"decodes each row once, O(1) amortized per edge; subscripting one position is O(log n +","type":"text"},{"text":" ","type":"text"},{"text":"out-degree), so prefer iteration to index loops.","type":"text"}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct","title":"EliasFanoGraph.Edges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}],"kind":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"role":"collection","abstract":[],"url":"\/documentation\/eliasfanographmodule","kind":"symbol","type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","title":"EliasFanoGraphModule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/indices(where:)":{"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/indices(where:)","title":"indices(where:)","abstract":[],"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"where","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"RangeSet","kind":"typeIdentifier","preciseIdentifier":"s:s8RangeSetV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct\/indices(where:)"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph":{"role":"symbol","navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph","abstract":[{"text":"An immutable directed graph on the vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"text":" whose rows of successors are Elias–Fano","type":"text"},{"text":" ","type":"text"},{"text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s","type":"text"},{"text":" ","type":"text"},{"code":"EFGraph","type":"codeVoice"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"code":"l","type":"codeVoice"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" targets below ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","title":"EliasFanoGraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"kind":"symbol"}}}