},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","title":"EliasFanoGraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"kind":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Edges-swift.struct/firstRange(of:)-1v3ry":{"kind":"symbol","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.struct\/firstrange(of:)-1v3ry","title":"firstRange(of:)","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Edges-swift.struct\/firstRange(of:)-1v3ry","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"firstRange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Range","kind":"typeIdentifier","preciseIdentifier":"s:Sn"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">?","kind":"text"}],"abstract":[],"conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Comparable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"type":"topic","role":"symbol"}}}