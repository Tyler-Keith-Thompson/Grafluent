hModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors":{"abstract":[{"type":"text","text":"A row of successors, decoded as it is iterated. It holds the two bit arrays, not the graph,"},{"type":"text","text":" "},{"type":"text","text":"so making one costs two retains. "},{"code":"underestimatedCount","type":"codeVoice"},{"type":"text","text":" is the exact count, O(1);"},{"type":"text","text":" "},{"type":"text","text":"everything else walks the row."}],"title":"EliasFanoGraph.Successors","type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Successors","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors/lexicographicallyPrecedes(_:by:)":{"identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors\/lexicographicallyPrecedes(_:by:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyPrecedes"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"OtherSequence"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"OtherSequence"},{"kind":"text","text":", "},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kin