its, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"type":"codeVoice","code":"d"},{"text":" targets below ","type":"text"},{"type":"codeVoice","code":"n"},{"text":" takes about ","type":"text"},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"type":"codeVoice","code":"64 d"},{"text":".","type":"text"}],"role":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"kind":"symbol","title":"EliasFanoGraphModule","type":"topic","role":"collection","abstract":[],"url":"\/documentation\/eliasfanographmodule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule"}}}