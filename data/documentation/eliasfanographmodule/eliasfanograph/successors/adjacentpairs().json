liasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"type":"topic","title":"EliasFanoGraph.Successors","navigatorTitle":[{"kind":"identifier","text":"Successors"}],"kind":"symbol","abstract":[{"type":"text","text":"A row of successors, decoded as it is iterated. It holds the two bit arrays, not the graph,"},{"type":"text","text":" "},{"type":"text","text":"so making one costs two retains. "},{"type":"codeVoice","code":"underestimatedCount"},{"type":"text","text":" is the exact count, O(1);"},{"type":"text","text":" "},{"type":"text","text":"everything else walks the row."}],"identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","role":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph":{"navigatorTitle":[{"kind":"identifier","text":"EliasFanoGraph"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EliasFanoGraph"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph","kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","title":"EliasFanoGraph","abstract":[{"text":"An immutable directed graph on the vertices ","type":"text"},{"type":"codeVoice","code":"0..<n"},{"text":" whose rows of successors are Elias–Fano","type":"text"},{"text":" ","type":"text"},{"text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EFGraph"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"type":"codeVoice","code":"l"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"type":"codeVoice","code":"d"},{"text":" targets below ","type":"text"},{"type":"codeVoice","code":"n"},{"text":" takes about ","type":"text"},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"type":"codeVoice","code":"64 d"},{"text":".","type":"text"}],"role":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"kind":"symbol","title":"EliasFanoGraphModule","type":"topic","role":"collection","abstract":[],"url":"\/documentation\/eliasfanographmodule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors/adjacentPairs()":{"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors\/adjacentpairs()","abstract":[],"title":"adjacentPairs()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjacentPairs"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","text":"AdjacentPairsSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors\/adjacentPairs()"}}}