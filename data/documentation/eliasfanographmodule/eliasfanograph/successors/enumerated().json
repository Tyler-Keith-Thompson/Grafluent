ated()","type":"topic","kind":"symbol","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors\/enumerated()","abstract":[]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors":{"type":"topic","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","navigatorTitle":[{"text":"Successors","kind":"identifier"}],"abstract":[{"text":"A row of successors, decoded as it is iterated. It holds the two bit arrays, not the graph,","type":"text"},{"text":" ","type":"text"},{"text":"so making one costs two retains. ","type":"text"},{"code":"underestimatedCount","type":"codeVoice"},{"text":" is the exact count, O(1);","type":"text"},{"text":" ","type":"text"},{"text":"everything else walks the row.","type":"text"}],"title":"EliasFanoGraph.Successors","role":"symbol","kind":"symbol","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"type":"topic","role":"collection","kind":"symbol","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","abstract":[],"url":"\/documentation\/eliasfanographmodule"}}}