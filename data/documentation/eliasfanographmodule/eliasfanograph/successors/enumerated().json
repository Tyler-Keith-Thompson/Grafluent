,{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","type":"topic","abstract":[]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"abstract":[],"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/eliasfanographmodule","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors":{"title":"EliasFanoGraph.Successors","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"navigatorTitle":[{"kind":"identifier","text":"Successors"}],"type":"topic","kind":"symbol","abstract":[{"text":"A row of successors, decoded as it is iterated. It holds the two bit arrays, not the graph,","type":"text"},{"text":" ","type":"text"},{"text":"so making one costs two retains. ","type":"text"},{"type":"codeVoice","code":"underestimatedCount"},{"text":" is the exact count, O(1);","type":"text"},{"text":" ","type":"text"},{"text":"everything else walks the row.","type":"text"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors"}}}