ns. ","type":"text"},{"type":"codeVoice","code":"underestimatedCount"},{"text":" is the exact count, O(1);","type":"text"},{"text":" ","type":"text"},{"text":"everything else walks the row.","type":"text"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors/Iterator":{"type":"topic","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors\/iterator","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors\/Iterator","kind":"symbol","abstract":[{"text":"Decodes one target per step: the next set bit of the row’s unary section and the","type":"text"},{"text":" ","type":"text"},{"text":"next ","type":"text"},{"code":"l","type":"codeVoice"},{"text":" low bits.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"role":"symbol","title":"EliasFanoGraph.Successors.Iterator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}]}}}