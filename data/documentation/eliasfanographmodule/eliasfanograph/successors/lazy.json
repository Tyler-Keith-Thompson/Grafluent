entifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","kind":"symbol","type":"topic","role":"collection","abstract":[],"url":"\/documentation\/eliasfanographmodule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors":{"abstract":[{"type":"text","text":"A row of successors, decoded as it is iterated. It holds the two bit arrays, not the graph,"},{"type":"text","text":" "},{"type":"text","text":"so making one costs two retains. "},{"code":"underestimatedCount","type":"codeVoice"},{"type":"text","text":" is the exact count, O(1);"},{"type":"text","text":" "},{"type":"text","text":"everything else walks the row."}],"title":"EliasFanoGraph.Successors","type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Successors","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors/lazy":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lazy","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s12LazySequenceV","text":"LazySequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors\/lazy","type":"topic","title":"lazy","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors\/lazy","abstract":[],"kind":"symbol","role":"symbol"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph":{"abstract":[{"type":"text","text":"An immutable directed graph on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" whose rows of successors are Elias–Fano"},{"type":"text","text":" "},{"type":"text","text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EFGraph"},{"type":"text","text":" stores them: each row’s ascending targets split into "},{"type":"codeVoice","code":"l"},{"type":"text","text":" low bits, packed, and the"},{"type":"text","text":" "},{"type":"text","text":"high parts written in unary, so a row of "},{"type":"codeVoice","code":"d"},{"type":"text","text":" targets below "},{"type":"codeVoice","code":"n"},{"type":"text","text":" takes about "},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"type":"text","text":" "},{"type":"text","text":"bits instead of "},{"type":"codeVoice","code":"64 d"},{"type":"text","text":"."}],"title":"EliasFanoGraph","type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}]}}}