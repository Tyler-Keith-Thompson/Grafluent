"},{"type":"text","text":" "},{"type":"codeVoice","code":"EFGraph"},{"type":"text","text":" stores them: each row’s ascending targets split into "},{"type":"codeVoice","code":"l"},{"type":"text","text":" low bits, packed, and the"},{"type":"text","text":" "},{"type":"text","text":"high parts written in unary, so a row of "},{"type":"codeVoice","code":"d"},{"type":"text","text":" targets below "},{"type":"codeVoice","code":"n"},{"type":"text","text":" takes about "},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"type":"text","text":" "},{"type":"text","text":"bits instead of "},{"type":"codeVoice","code":"64 d"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","role":"symbol","title":"EliasFanoGraph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"type":"topic","role":"collection","kind":"symbol","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","abstract":[],"url":"\/documentation\/eliasfanographmodule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors":{"type":"topic","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","navigatorTitle":[{"text":"Successors","kind":"identifier"}],"abstract":[{"text":"A row of successors, decoded as it is iterated. It holds the two bit arrays, not the graph,","type":"text"},{"text":" ","type":"text"},{"text":"so making one costs two retains. ","type":"text"},{"code":"underestimatedCount","type":"codeVoice"},{"text":" is the exact count, O(1);","type":"text"},{"text":" ","type":"text"},{"text":"everything else walks the row.","type":"text"