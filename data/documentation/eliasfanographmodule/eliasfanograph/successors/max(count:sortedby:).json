xt":" ","type":"text"},{"code":"EFGraph","type":"codeVoice"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"code":"l","type":"codeVoice"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" targets below ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/Successors":{"title":"EliasFanoGraph.Successors","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"}],"navigatorTitle":[{"kind":"identifier","text":"Successors"}],"type":"topic","kind":"symbol","abstract":[{"text":"A row of successors, decoded as it is iterated. It holds the two bit arrays, not the graph,","type":"text"},{"text":" ","type":"text"},{"text":"so making one costs two retains. ","type":"text"},{"type":"codeVoice","code":"underestimatedCount"},{"text":" is the exact count, O(1);","type":"text"},{"text":" ","type":"text"},{"text":"everything else walks the row.","type":"text"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/successors","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/Successors"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"abstract":[],"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/eliasfanographmodule","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule"}}}