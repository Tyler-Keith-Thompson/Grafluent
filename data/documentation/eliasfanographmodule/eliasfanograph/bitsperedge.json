xt","text":"offsets and the per-row starts, which are O(n) words. NaN with no edges."}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/bitsperedge","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bitsPerEdge"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"title":"bitsPerEdge"}}}