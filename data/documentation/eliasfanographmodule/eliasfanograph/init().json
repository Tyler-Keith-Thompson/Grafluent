 so a row of "},{"type":"codeVoice","code":"d"},{"type":"text","text":" targets below "},{"type":"codeVoice","code":"n"},{"type":"text","text":" takes about "},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"type":"text","text":" "},{"type":"text","text":"bits instead of "},{"type":"codeVoice","code":"64 d"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","role":"symbol","title":"EliasFanoGraph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/init()":{"identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/init()","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/init()","title":"init()","kind":"symbol","abstract":[{"type":"text","text":"The graph with no vertices. Allocates nothing, so it has no generation."}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"type":"topic","role":"collection","kind":"symbol","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","abstract":[],"url":"\/documentation\/eliasfanographmodule"}}}