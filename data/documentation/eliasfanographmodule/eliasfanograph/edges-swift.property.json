text":" ","type":"text"},{"code":"EFGraph","type":"codeVoice"},{"text":" stores them: each row’s ascending targets split into ","type":"text"},{"code":"l","type":"codeVoice"},{"text":" low bits, packed, and the","type":"text"},{"text":" ","type":"text"},{"text":"high parts written in unary, so a row of ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" targets below ","type":"text"},{"code":"n","type":"codeVoice"},{"text":" takes about ","type":"text"},{"code":"d · (2 + log₂(n\/d))","type":"codeVoice"},{"text":" ","type":"text"},{"text":"bits instead of ","type":"text"},{"code":"64 d","type":"codeVoice"},{"text":".","type":"text"}]},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"abstract":[],"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/eliasfanographmodule","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/edges-swift.property":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"edges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:20EliasFanoGraphModule0abC0V","text":"EliasFanoGraph"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:20EliasFanoGraphModule0abC0V5EdgesV","text":"Edges"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/edges-swift.property","abstract":[{"text":"Every edge in row-major order; the position of an edge is its index.","type":"text"}],"title":"edges","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/edges-swift.property"}}}