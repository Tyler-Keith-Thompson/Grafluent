{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/customMirror","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Shows the offsets, the row widths and the two bit arrays, so a debugger can browse them."}],"hierarchy":{"paths":[["doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph"]]},"metadata":{"modules":[{"name":"EliasFanoGraphModule"}],"title":"customMirror","extendedModule":"EliasFanoGraphModule","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customMirror","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6MirrorV","text":"Mirror","kind":"typeIdentifier"}],"role":"symbol","roleHeading":"Instance Property","symbolKind":"property","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/EliasFanoGraphModule\/EliasFanoGraph.swift#L613","fileName":"EliasFanoGraph.swift"},"externalID":"s:20EliasFanoGraphModule0abC0V12customMirrors0F0Vvp"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customMirror","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6MirrorV","text":"Mirror","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"}],"kind":"symbol","variants":[{"paths":["\/documentation\/eliasfanographmodule\/eliasfanograph\/custommirror"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule":{"type":"topic","role":"collection","kind":"symbol","title":"EliasFanoGraphModule","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule","abstract":[],"url":"\/documentation\/eliasfanographmodule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph/customMirror":{"identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph\/customMirror","kind":"symbol","abstract":[{"text":"Shows the offsets, the row widths and the two bit arrays, so a debugger can browse them.","type":"text"}],"title":"customMirror","url":"\/documentation\/eliasfanographmodule\/eliasfanograph\/custommirror","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customMirror","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6MirrorV","text":"Mirror","kind":"typeIdentifier"}],"role":"symbol","type":"topic"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph":{"abstract":[{"type":"text","text":"An immutable directed graph on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" whose rows of successors are Elias–Fano"},{"type":"text","text":" "},{"type":"text","text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EFGraph"},{"type":"text","text":" stores them: each row’s ascending targets split into "},{"type":"codeVoice","code":"l"},{"type":"text","text":" low bits, packed, and the"},{"type":"text","text":" "},{"type":"text","text":"high parts written in unary, so a row of "},{"type":"codeVoice","code":"d"},{"type":"text","text":" targets below "},{"type":"codeVoice","code":"n"},{"type":"text","text":" takes about "},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"type":"text","text":" "},{"type":"text","text":"bits instead of "},{"type":"codeVoice","code":"64 d"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","role":"symbol","title":"EliasFanoGraph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph"}}}