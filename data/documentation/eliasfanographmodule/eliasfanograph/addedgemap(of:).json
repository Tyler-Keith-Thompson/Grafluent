/documentation\/eliasfanographmodule"},"doc://EliasFanoGraphModule/documentation/EliasFanoGraphModule/EliasFanoGraph":{"abstract":[{"type":"text","text":"An immutable directed graph on the vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" whose rows of successors are Elias–Fano"},{"type":"text","text":" "},{"type":"text","text":"coded (Elias 1974, Fano 1971; Vigna, “Quasi-succinct indices”, WSDM 2013), as WebGraph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"EFGraph"},{"type":"text","text":" stores them: each row’s ascending targets split into "},{"type":"codeVoice","code":"l"},{"type":"text","text":" low bits, packed, and the"},{"type":"text","text":" "},{"type":"text","text":"high parts written in unary, so a row of "},{"type":"codeVoice","code":"d"},{"type":"text","text":" targets below "},{"type":"codeVoice","code":"n"},{"type":"text","text":" takes about "},{"type":"codeVoice","code":"d · (2 + log₂(n\/d))"},{"type":"text","text":" "},{"type":"text","text":"bits instead of "},{"type":"codeVoice","code":"64 d"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/EliasFanoGraphModule\/documentation\/EliasFanoGraphModule\/EliasFanoGraph","role":"symbol","title":"EliasFanoGraph","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EliasFanoGraph","kind":"identifier"}],"navigatorTitle":[{"text":"EliasFanoGraph","kind":"identifier"}],"url":"\/documentation\/eliasfanographmodule\/eliasfanograph"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeMap"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EdgeMap"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","type":"topic","title":"EdgeMap","abstract":[{"type":"text","text":"A handle to a map from edge positions to "},{"type":"codeVoice","code":"Value"},{"type":"te