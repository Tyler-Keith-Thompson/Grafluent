{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"girvanNewmanCommunities"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18CommunityDetection20GirvanNewmanSequenceV","text":"GirvanNewmanSequence","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The partitions, coarsest first: each time the number of components grows, the"},{"type":"text","text":" "},{"type":"text","text":"components; ending with every vertex alone."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(m) to start. Each removal recomputes the betweenness of the removed edge’s","type":"text"},{"text":" ","type":"text"},{"text":"component C alone, O(n_C · m_C); every split builds a partition in O(n). The whole","type":"text"},{"text":" ","type":"text"},{"text":"sequence is O(m² n) in the worst case.","type":"text"}]}],"type":"aside","name":"Complexity","style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/CommunityDetection\/documentation\/CommunityDetection","doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols","doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/communitydetection\/graphprotocols\/graph\/girvannewmancommunities()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Girvan–Newman communities: the successively finer partitions found by removing, again and","type":"text"},{"text":" ","type":"text"},{"text":"again, the edge of greatest betweenness (","type":"text"},{"code":"edgeBetweennessCentrality()","type":"codeVoice"},{"text":"), recomputed after","type":"text"},{"text":" ","type":"text"},{"text":"each removal. A tie goes to the least edge position; parallel copies share their pairs’","type":"text"},{"text":" ","type":"text"},{"text":"paths, and self-loops are never removed and never matter. The sequence is lazy: each","type":"text"},{"text":" ","type":"text"},{"text":"partition is computed when iteration reaches it.","type":"text"}],"identifier":{"url":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/girvanNewmanCommunities()","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"externalID":"s:14GraphProtocols0A0P18CommunityDetectionE23girvanNewmanCommunitiesAD06GirvanF8SequenceVyxGyF","title":"girvanNewmanCommunities()","roleHeading":"Instance Method","extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"girvanNewmanCommunities","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"GirvanNewmanSequence","kind":"typeIdentifier","preciseIdentifier":"s:18CommunityDetection20GirvanNewmanSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/CommunityDetection\/GirvanNewman.swift#L264","fileName":"GirvanNewman.swift"},"symbolKind":"method","modules":[{"name":"CommunityDetection","relatedModules":["GraphProtocols"]}],"role":"symbol"},"references":{"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/girvanNewmanCommunities()":{"abstract":[{"type":"text","text":"Girvan–Newman communities: the successively finer partitions found by removing, again and"},{"type":"text","text":" "},{"type":"text","text":"again, the edge of greatest betweenness ("},{"type":"codeVoice","code":"edgeBetweennessCentrality()"},{"type":"text","text":"), recomputed after"},{"type":"text","text":" "},{"type":"text","text":"each removal. A tie goes to the least edge position; parallel copies share their pairs’"},{"type":"text","text":" "},{"type":"text","text":"paths, and self-loops are never removed and never matter. The sequence is lazy: each"},{"type":"text","text":" "},{"type":"text","text":"partition is computed when iteration reaches it."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"girvanNewmanCommunities"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"GirvanNewmanSequence","preciseIdentifier":"s:18CommunityDetection20GirvanNewmanSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/girvanNewmanCommunities()","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/girvannewmancommunities()","title":"girvanNewmanCommunities()"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols","abstract":[],"kind":"symbol","url":"\/documentation\/communitydetection\/graphprotocols","role":"collection","type":"topic"},"doc://CommunityDetection/documentation/CommunityDetection":{"title":"CommunityDetection","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection","abstract":[],"kind":"symbol","url":"\/documentation\/communitydetection","role":"collection","type":"topic"},"doc://CommunityDetection/documentation/CommunityDetection/GirvanNewmanSequence":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifie