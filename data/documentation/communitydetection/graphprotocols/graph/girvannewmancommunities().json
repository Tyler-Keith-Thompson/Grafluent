xt":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The partitions, coarsest first: each time the number of components grows, the"},{"type":"text","text":" "},{"type":"text","text":"components; ending with every vertex alone."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(m) to start. Each removal recomputes the betweenness of the removed edge’s"},{"type":"text","text":" "},{"type":"text","text":"component C alone, O(n_C · m_C); every split builds a partition in O(n). The whole"},{"type":"text","text":" "},{"type":"text","text":"sequence is O(m² n) in the worst case."}],"type":"paragraph"}],"name":"Complexity"}],"kind":"content"}],"abstract":[{"type":"text","text":"Girvan–Newman communities: the successively finer partitions found by removing, again and"},{"type":"text","text":" "},{"type":"text","text":"again, the edge of greatest betweenness ("},{"code":"edgeBetweennessCentrality()","type":"codeVoice"},{"type":"text","text":"), recomputed after"},{"type":"text","text":" "},{"type":"text","text":"each removal. A tie goes to the least edge position; parallel copies share their pairs’"},{"type":"text","text":" "},{"type":"text","text":"paths, and self-loops are never removed and never matter. The sequence is lazy: each"},{"type":"text","text":" "},{"type":"text","text":"partition is computed when iteration reaches it."}],"references":{"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentif