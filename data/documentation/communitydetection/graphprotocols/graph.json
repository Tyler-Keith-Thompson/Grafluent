 is exact; with others, near-ties depend on summation order."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"louvainCommunities","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"resolution","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":") -> ","kind":"text"},{"text":"Partition","kind":"typeIdentifier","preciseIdentifier":"s:18CommunityDetection9PartitionV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"role":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/louvainCommunities(weight:resolution:threshold:)","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/louvaincommunities(weight:resolution:threshold:)"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/asynchronousLabelPropagationCommunities(using:)":{"kind":"symbol","type":"topic","title":"asynchronousLabelPropagationCommunities(using:)","abstract":[{"text":"Asynchronous label propagation with each sweep’s order shuffled by ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":" (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"seed"},{"text":"): each sweep shuffles a fresh ","type":"text"},{"type":"codeVoice","code":"0 ..< n"},{"text":" by Fisher–Yates (as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"louvainCommunities(using:)"},{"text":"), and every vertex not holding a most-voted label draws once,","type":"text"},{"text":" ","type":"text"},{"text":"even when one label is most voted, taking the ","type":"text"},{"type":"codeVoice","code":"generator.next(upperBound: t)"},{"text":"-th of the t","type":"text"},{"text":" ","type":"text"},{"text":"most-voted labels in order of first vote.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"asynchronousLabelPropagationCommunities","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"Partition","kind":"typeIdentifier","preciseIdentifier":"s:18CommunityDetection9PartitionV"},{"text":"<","kind":"text"},{"text":"DirectedView","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"role":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/asynchronousLabelPropagationCommunities(using:)","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/asynchronouslabelpropagationcommunities(using:)"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/labelPropagationCommunities()":{"abstract":[{"type":"text","text":"Label propagation communities, semi-synchronous (Cordasco and Gargano; NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"label_propagation_communities"},{"type":"text","text":"): every vertex starts with its own label and repeatedly"},{"type":"text","text":" "},{"type":"text","text":"takes the label most of its edges lead to (each parallel edge votes; self-loops vote for"},{"type":"text","text":" "},{"type":"text","text":"nothing), keeping its own on a tie, otherwise taking the greatest; vertices of one color of a"},{"type":"text","text":" "},{"type":"text","text":"greedy coloring update together. Deterministic."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"labelPropagationCommunities"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:18CommunityDetection9PartitionV","kind":"typeIdentifier","text":"Partition"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"kind":"symbol","title":"labelPropagationCommunities()","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/labelpropagationcommunities()","type":"topic","role":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/labelPropagationCommunities()"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/louvainCommunities(resolution:threshold:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"louvainCommunities"},{"kind":"text","text":"("},{"kind":"externalParam","text":"resolution"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18CommunityDetection9PartitionV","text":"Partition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"title":"louvainCommunities(resolution:threshold:)","kind":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/louvainCommunities(resolution:threshold:)","type":"topic","abstract":[{"type":"text","text":"Louvain communities (Blondel et al.; NetworkX "},{"type":"codeVoice","code":"louvain_communities"},{"type":"text","text":"): each level moves"},{"type":"text","text":" "},{"type":"text","text":"vertices, in index order, to the neighboring community of greatest modularity gain (staying"},{"type":"text","text":" "},{"type":"text","text":"on a tie, otherwise the greatest community label), then merges each community into a vertex,"},{"type":"text","text":" "},{"type":"text","text":"while the modularity rises by more than "},{"type":"codeVoice","code":"threshold"},{"type":"text","text":". Deterministic: a function of the graph’s"},{"type":"text","text":" "},{"type":"text","text":"vertex numbering and weights. Parallel edges add; a self-loop counts in degrees and never"},{"type":"text","text":" "},{"type":"text","text":"moves a vertex. O(m) per sweep."}],"url":"\/documentation\/communitydetection\/graphprotocols\/graph\/louvaincommunities(resolution:threshold:)","role":"symbol"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/partitionQuality(of:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"partitionQuality","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"