eciseIdentifier":"s:18CommunityDetection9PartitionV","text":"Partition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"abstract":[{"type":"text","text":"Louvain communities (Blondel et al.; NetworkX "},{"type":"codeVoice","code":"louvain_communities"},{"type":"text","text":"): each level moves"},{"type":"text","text":" "},{"type":"text","text":"vertices, in index order, to the neighboring community of greatest modularity gain (staying"},{"type":"text","text":" "},{"type":"text","text":"on a tie, otherwise the greatest community label), then merges each community into a vertex,"},{"type":"text","text":" "},{"type":"text","text":"while the modularity rises by more than "},{"type":"codeVoice","code":"threshold"},{"type":"text","text":". Deterministic: a function of the graph’s"},{"type":"text","text":" "},{"type":"text","text":"vertex numbering and weights. Parallel edges add; a self-loop counts in degrees and never"},{"type":"text","text":" "},{"type":"text","text":"moves a vertex. O(m) per sweep."}],"type":"topic","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/louvainCommunities(resolution:threshold:)","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/louvaincommunities(resolution:threshold:)","kind":"symbol"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/greedyModularityCommunities(weight:resolution:)":{"title":"greedyModularityCommunities(weight:resolution:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"greedyModularityCommunities"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"resolution"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Partition","preciseIdentifier":"s:18CommunityDetection9PartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"abstract":[{"text":"Weighted greedy modularity communities; ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per edge, in position order.","type":"text"}],"type":"topic","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/greedyModularityCommunities(weight:resolution:)","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/greedymodularitycommunities(weight:resolution:)","kind":"symbol"}}}