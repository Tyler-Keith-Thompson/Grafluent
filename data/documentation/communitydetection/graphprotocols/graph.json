ices (NetworkX "},{"type":"codeVoice","code":"partition_quality"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"O(n + m log m)."}],"role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directedView","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"title":"Graph","role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/louvainCommunities(resolution:threshold:)":{"identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/louvainCommunities(resolution:threshold:)","title":"louvainCommunities(resolution:threshold:)","abstract":[{"type":"text","text":"Louvain communities (Blondel et al.; NetworkX "},{"type":"codeVoice","code":"louvain_communities"},{"type":"text","text":"): each level moves"},{"type":"text","text":" "},{"type":"text","text":"vertices, in index order, to the neighboring community of greatest modularity gain (staying"},{"type":"text","text":" "},{"text":"on a tie, otherwise the greatest community label), then merges each community into a vertex,","type":"text"},{"text":" ","type":"text"},{"text":"while the modularity rises by more than ","type":"text"},{"type":"codeVoice","code":"threshold"},{"text":". Deterministic: a function of the graph’s","type":"text"},{"text":" ","type":"text"},{"text":"vertex numbering and weights. Parallel edges add; a self-loop counts in degrees and never","type":"text"},{"text":" ","type":"text"},{"text":"moves a vertex. O(m) per sweep.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"louvainCommunities","kind":"identifier"},{"text":"(","kind":"text"},{"text":"resolution","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:18CommunityDetection9PartitionV","text":"Partition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"url":"\/documentation\/communitydetection\/graphprotocols\/graph\/louvaincommunities(resolution:threshold:)","kind":"symbol"}}}