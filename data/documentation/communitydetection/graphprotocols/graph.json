ity communities (Clauset, Newman and Moore; NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"greedy_modularity_communities","type":"codeVoice"},{"text":"): from singletons, repeatedly merge the two adjacent","type":"text"},{"text":" ","type":"text"},{"text":"communities whose merge raises modularity most (ties to the least pair of vertex numbers),","type":"text"},{"text":" ","type":"text"},{"text":"while it does not lower it. Deterministic. O(m d log n), d the depth of the merge tree.","type":"text"}]},"doc://CommunityDetection/documentation/CommunityDetection":{"role":"collection","kind":"symbol","abstract":[],"url":"\/documentation\/communitydetection","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection","type":"topic","title":"CommunityDetection"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/partitionQuality(of:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"partitionQuality"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18CommunityDetection16PartitionQualityV","text":"PartitionQuality"}],"abstract":[{"text":"Coverage and performance of a grouping of the vertices (NetworkX ","type":"text"},{"code":"partition_quality","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m log m).","type":"text"}],"kind":"symbol","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/partitionquality(of:)","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/partitionQuality(of:)","type":"topic","title":"partitionQuality(of:)"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph":{"role":"sym