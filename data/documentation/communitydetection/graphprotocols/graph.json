e":"text","text":" "},{"type":"text","text":"vertices, in index order, to the neighboring community of greatest modularity gain (staying"},{"type":"text","text":" "},{"type":"text","text":"on a tie, otherwise the greatest community label), then merges each community into a vertex,"},{"type":"text","text":" "},{"type":"text","text":"while the modularity rises by more than "},{"type":"codeVoice","code":"threshold"},{"type":"text","text":". Deterministic: a function of the graph’s"},{"type":"text","text":" "},{"type":"text","text":"vertex numbering and weights. Parallel edges add; a self-loop counts in degrees and never"},{"type":"text","text":" "},{"type":"text","text":"moves a vertex. O(m) per sweep."}],"role":"symbol","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/louvaincommunities(resolution:threshold:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"louvainCommunities"},{"kind":"text","text":"("},{"kind":"externalParam","text":"resolution"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Partition","preciseIdentifier":"s:18CommunityDetection9PartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}]},"doc://CommunityDetection/documentation/CommunityDetection":{"kind":"symbol","title":"CommunityDetection","abstract":[],"type":"topic","role":"collection","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection","url":"\/documentation\/communitydetection"},"doc://CommunityDetection/documentation/CommunityDetection/Graph