:" views it as one when an algorithm needs arcs."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","title":"Graph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"url":"\/documentation\/communitydetection\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","title":"Graph","type":"topic","role":"symbol"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/asynchronousLabelPropagationCommunities(using:)":{"identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/asynchronousLabelPropagationCommunities(using:)","abstract":[{"text":"Asynchronous label propagation with each sweep’s order shuffled by ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":" (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"seed"},{"text":"): each sweep shuffles a fresh ","type":"text"},{"type":"codeVoice","code":"0 ..< n"},{"text":" by Fisher–Yates (as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"louvainCommunities(using:)"},{"text":"), and every vertex not holding a most-voted label draws once,","type":"text"},{"text":" ","type":"text"},{"text":"even when one label is most voted, taking the ","type":"text"},{"type":"codeVoice","code":"generator.next(upperBound: t)"},{"text":"-th of the t","type":"text"},{"text":" ","type":"text"},{"text":"most-voted labels in order of first vote.","type":"text"}],"url":"\/documentati