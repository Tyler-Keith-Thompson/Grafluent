":"symbol"},"doc://CommunityDetection/documentation/CommunityDetection":{"abstract":[],"role":"collection","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection","url":"\/documentation\/communitydetection","title":"CommunityDetection","kind":"symbol","type":"topic"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/labelPropagationCommunities()":{"abstract":[{"type":"text","text":"Label propagation communities, semi-synchronous (Cordasco and Gargano): every vertex starts"},{"type":"text","text":" "},{"type":"text","text":"with its own label and repeatedly takes the label most of its edges lead to (each parallel"},{"type":"text","text":" "},{"type":"text","text":"edge votes; self-loops vote for nothing), keeping its own on a tie, otherwise taking the"},{"type":"text","text":" "},{"text":"greatest; vertices of one color of a greedy coloring update together. Deterministic.","type":"text"}],"role":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/labelPropagationCommunities()","title":"labelPropagationCommunities()","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/labelpropagationcommunities()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"labelPropagationCommunities","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Partition","preciseIdentifier":"s:18CommunityDetection9PartitionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"type":"topic","kind":"symbol"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols":{"abstract":[],"role":"collection","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols","title":"GraphProtocols","url":"\/do