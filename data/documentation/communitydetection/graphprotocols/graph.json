ction\/GraphProtocols\/Graph\/modularity(of:resolution:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"modularity"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"resolution"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"title":"modularity(of:resolution:)","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/modularity(of:resolution:)","abstract":[{"type":"text","text":"Modularity (Newman and Girvan; NetworkX "},{"code":"modularity","type":"codeVoice"},{"type":"text","text":", with Reichardt and Bornholdt’s"},{"type":"text","text":" "},{"type":"text","text":"resolution γ): Σ_c [L_c\/m − γ (d_c\/2m)²], L_c the number of edges inside community c, d_c"},{"type":"text","text":" "},{"type":"text","text":"its degree sum (a self-loop counts twice), m the number of edges. 0 without edges. Takes any"},{"type":"text","text":" "},{"type":"text","text":"grouping of the vertices, such as a "},{"code":"Partition","type":"codeVoice"},{"type":"text","text":" or "},{"code":"connectedComponents()","type":"codeVoice"},{"type":"text","text":". O(n + m) after"},{"type":"text","text":" "},{"type":"text","text":"looking the vertices up."}],"kind":"symbol","type":"topic"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/greedyModularityCommunities(resolution:)":{"role":"symbol","title":"greedyModularityCommunities(resolution:)","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/greedyModularityCommunities(resolution:)","abstract":[{"text":"Greedy modularity communities (Clauset, Newman