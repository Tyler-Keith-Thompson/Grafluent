ection/documentation/CommunityDetection/GraphProtocols/Graph/asynchronousLabelPropagationCommunities(weight:using:)":{"identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/asynchronousLabelPropagationCommunities(weight:using:)","type":"topic","abstract":[{"type":"text","text":"Weighted asynchronous label propagation with shuffled sweeps and random ties."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"asynchronousLabelPropagationCommunities","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Partition","preciseIdentifier":"s:18CommunityDetection9PartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"url":"\/documentation\/communitydetection\/graphprotocols\/graph\/asynchronouslabelpropagationcommunities(weight:using:)","title":"asynchronousLabelPropagationCommunities(weight:using:)"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/