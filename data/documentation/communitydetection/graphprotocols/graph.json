mber of edges inside community c, d_c","type":"text"},{"text":" ","type":"text"},{"text":"its degree sum (a self-loop counts twice), m the number of edges. 0 without edges. Takes any","type":"text"},{"text":" ","type":"text"},{"text":"grouping of the vertices, such as a ","type":"text"},{"type":"codeVoice","code":"Partition"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"connectedComponents()"},{"text":". O(n + m) after","type":"text"},{"text":" ","type":"text"},{"text":"looking the vertices up.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"modularity","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"resolution","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"kind":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/modularity(of:resolution:)","title":"modularity(of:resolution:)","type":"topic","role":"symbol"}}}