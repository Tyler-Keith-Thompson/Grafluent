ble"},{"kind":"text","text":", "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18CommunityDetection9PartitionV","text":"Partition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","text":"DirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"abstract":[{"type":"text","text":"Weighted Louvain communities with shuffled visit orders."}],"kind":"symbol","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/louvaincommunities(weight:resolution:threshold:using:)","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/louvainCommunities(weight:resolution:threshold:using:)"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/louvainCommunities(resolution:threshold:)":{"kind":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/louvainCommunities(resolution:threshold:)","type":"topic","abstract":[{"type":"text","text":"Louvain communities (Blondel et al.; NetworkX "},{"type":"codeVoice","code":"louvain_communities"},{"type":"text","text":"): each level moves"},{"type":"text","text":" "},{"type":"text","text":"vertices, in index order, to the neighboring community of greatest modularity gain (staying"},{"type":"text","text":" "},{"type":"text","text":"on a tie, otherwise the greatest community label), then merges each community into a vertex,"},{"type":