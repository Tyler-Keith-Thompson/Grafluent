n/documentation/CommunityDetection/GraphProtocols/Graph/louvainCommunities(resolution:threshold:using:)":{"identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/louvainCommunities(resolution:threshold:using:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"louvainCommunities"},{"kind":"text","text":"("},{"kind":"externalParam","text":"resolution"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Partition","preciseIdentifier":"s:18CommunityDetection9PartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">>"}],"kind":"symbol","abstract":[{"type":"text","text":"Louvain communities with each level’s visit order shuffled by "},{"type":"codeVoice","code":"generator"},{"type":"text","text":": one Fisher–Yates"},{"type":"text","text":" "},{"type":"text","text":"shuffle per level, position i (from the last down to 1) swapped with"},{"type":"text","text":" "},{"type":"codeVoice","code":"generator.next(upperBound: i + 1)"},{"type":"text","text":"."}],"title":"louvainCommunities(resolution:threshold:using:)","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/louvaincommunities(resolution:threshold:using:)","type":"topic","role":"symbol"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/asynchronousLabelPropagationCommunities(using:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"asynchronousLabelPropagationCommunities","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Partition","preciseIdentifier":"s:18CommunityDetection9PartitionV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">>","kind":"text"}],"identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/asynchronousLabelPropagationCommunities(using:)","type":"topic","abstract":[{"text":"Asynchronous label propagation with each sweep’s order shuffled by ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":": each sweep","type":"text"},{"text":" ","type":"text"},{"text":"shuffles a fresh ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" by Fisher–Yates (as ","type":"text"},{"code":"louvainCommunities(using:)","type":"codeVoice"},{"text":"), and every","type":"text"},{"text":" ","type":"text"},{"text":"vertex not holding a most-voted label draws once, even when one label is most voted, taking","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"generator.next(upperBound: t)","type":"codeVoice"},{"text":"-th of the t most-voted labels in order of first vote.","type":"text"}],"role":"symbol","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/asynchr