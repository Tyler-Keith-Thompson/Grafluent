 and every"},{"type":"text","text":" "},{"type":"text","text":"vertex not holding a most-voted label draws once, even when one label is most voted, taking"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"generator.next(upperBound: t)"},{"type":"text","text":"-th of the t most-voted labels in order of first vote."}],"type":"topic","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/asynchronousLabelPropagationCommunities(using:)"},"doc://CommunityDetection/documentation/CommunityDetection/GraphProtocols/Graph/modularity(of:resolution:)":{"role":"symbol","url":"\/documentation\/communitydetection\/graphprotocols\/graph\/modularity(of:resolution:)","kind":"symbol","title":"modularity(of:resolution:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"modularity","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"resolution","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"abstract":[{"type":"text","text":"Modularity (Newman and Girvan, with Reichardt and Bornholdt’s resolution γ): Σ_c [L_c\/m − γ"},{"type":"text","text":" "},{"type":"text","text":"(d_c\/2m)²], L_c the number of edges inside community c, d_c its degree sum (a self-loop"},{"type":"text","text":" "},{"type":"text","text":"counts twice), m the number of edges. 0 without edges. Takes any grouping of the vertices,"},{"type":"text","text":" "},{"type":"text","text":"such as a "},{"type":"codeVoice","code":"Partition"},{"type":"text","text":" or "},{"type":"codeVoice","code":"connectedComponents()"},{"type":"text","text":". O(n + m) after looking the vertices up."}],"type":"topic","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GraphProtocols\/Graph\/modularity(of:resolution:)"}}}