{"identifier":{"url":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent","interfaceLanguage":"swift"},"abstract":[{"text":"What the Louvain method reports, in order.","type":"text"}],"metadata":{"title":"LouvainEvent","symbolKind":"enum","externalID":"s:18CommunityDetection12LouvainEventO","navigatorTitle":[{"text":"LouvainEvent","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"LouvainEvent","kind":"identifier"}],"remoteSource":{"fileName":"LouvainEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/CommunityDetection\/LouvainEvents.swift#L15"},"role":"symbol","modules":[{"name":"CommunityDetection"}],"roleHeading":"Enumeration"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/communitydetection\/louvainevent"]}],"hierarchy":{"paths":[["doc:\/\/CommunityDetection\/documentation\/CommunityDetection"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LouvainEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each level starts with local moving: level vertices are taken in number order, sweep after"},{"type":"text",