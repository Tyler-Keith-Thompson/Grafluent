er (their vertex"},{"type":"text","text":" "},{"type":"text","text":"indices when the graph has them). The method ends after a level whose modularity did not rise"},{"type":"text","text":" "},{"type":"text","text":"enough, or after an aggregation whose local moving moved nothing."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://CommunityDetection/s23CustomStringConvertibleP":{"identifier":"doc:\/\/CommunityDetection\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible","type":"unresolvable"},"doc://CommunityDetection/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/CommunityDetection\/s9EscapableP"},"doc://CommunityDetection/SQ":{"identifier":"doc:\/\/CommunityDetection\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://CommunityDetection/documentation/CommunityDetection/LouvainEvent/move(_:from:to:gain:)":{"abstract":[{"text":"Level vertex ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" moved from community ","type":"text"},{"code":"from","type":"codeVoice"},{"text":" to community ","type":"text"},{"code":"to","type":"codeVoice"},{"text":", raising the modularity","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"gain","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","title":"LouvainEvent.move(_:from:to:gain:)","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/move(_:from:to:gain:)","role":"symbol","url":"\/documentation\/communitydetection\/louvainevent\/move(_:from:to:gain:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"to",