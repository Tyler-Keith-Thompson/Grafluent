eVoice"},{"text":" order (their vertex","type":"text"},{"text":" ","type":"text"},{"text":"indices when the graph has them). The method ends after a level whose modularity did not rise","type":"text"},{"text":" ","type":"text"},{"text":"enough, or after an aggregation whose local moving moved nothing.","type":"text"}]}]}],"references":{"doc://CommunityDetection/documentation/CommunityDetection/LouvainEvent/Equatable-Implementations":{"kind":"article","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/Equatable-Implementations","type":"topic","url":"\/documentation\/communitydetection\/louvainevent\/equatable-implementations","title":"Equatable Implementations","abstract":[],"role":"collectionGroup"},"doc://CommunityDetection/documentation/CommunityDetection/LouvainEvent/aggregate(vertexCount:)":{"title":"LouvainEvent.aggregate(vertexCount:)","abstract":[{"text":"The communities became the next level’s ","type":"text"},{"type":"codeVoice","code":"vertexCount"},{"text":" vertices.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/communitydetection\/louvainevent\/aggregate(vertexcount:)","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/aggregate(vertexCount:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"aggregate"},{"kind":"text","text":"("},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://CommunityDetection/s8CopyableP":{"type":"unresolvable","title":"Swift.Copyable","identifier":"doc:\/\/CommunityDetection\/s8CopyableP"},"doc://CommunityDetection/documentation/CommunityDetection/LouvainEvent/CustomStringConvertible-Implementations":{"kind":"article","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/CustomStringConvertible-Impl