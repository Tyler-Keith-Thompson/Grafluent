se local moving moved nothing.","type":"text"}]}]}],"abstract":[{"type":"text","text":"What the Louvain method reports, in order."}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent","interfaceLanguage":"swift"},"references":{"doc://CommunityDetection/documentation/CommunityDetection/LouvainEvent/Equatable-Implementations":{"identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/Equatable-Implementations","abstract":[],"role":"collectionGroup","title":"Equatable Implementations","type":"topic","kind":"article","url":"\/documentation\/communitydetection\/louvainevent\/equatable-implementations"},"doc://CommunityDetection/s8CopyableP":{"identifier":"doc:\/\/CommunityDetection\/s8CopyableP","type":"unresolvable","title":"Swift.Copyable"},"doc://CommunityDetection/s8SendableP":{"identifier":"doc:\/\/CommunityDetection\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://CommunityDetection/SQ":{"identifier":"doc:\/\/CommunityDetection\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://CommunityDetection/documentation/CommunityDetection/LouvainEvent":{"url":"\/documentation\/communitydetection\/louvainevent","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LouvainEvent"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LouvainEvent"}],"abstract":[{"type":"text","text":"What the Louvain method reports, in order."}],"kind":"symbol","identifier":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent","title":"LouvainEvent"},"doc://CommunityDetection/s9EscapableP":{"identifier":"doc:\/\/CommunityDetection\/s9EscapableP","title":"Swift.Escapable","type":"unresolvable"},"doc://CommunityDetection/documentation/CommunityDetection/LouvainEvent/aggregate(vertexCount:)":{"url":"\/documentation\/communitydetect