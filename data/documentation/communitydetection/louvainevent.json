{"sections":[],"abstract":[{"type":"text","text":"What the Louvain method reports, in order."}],"kind":"symbol","metadata":{"symbolKind":"enum","role":"symbol","title":"LouvainEvent","modules":[{"name":"CommunityDetection"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/CommunityDetection\/LouvainEvents.swift#L15","fileName":"LouvainEvents.swift"},"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LouvainEvent","kind":"identifier"}],"navigatorTitle":[{"text":"LouvainEvent","kind":"identifier"}],"externalID":"s:18CommunityDetection12LouvainEventO"},"identifier":{"url":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/aggregate(vertexCount:)","doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/levelFinished(_:modularity:)","doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/move(_:from:to:gain:)"],"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases"},{"identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/CustomStringConvertible-Implementations","doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/LouvainEvent\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/CommunityDetection\/documentation\/CommunityDetection"]]},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/CommunityDetection\/s8CopyableP","doc:\/\/CommunityDetection\/s23CustomStringConvertibleP","doc:\/\/CommunityDetection\/SQ","doc:\/\/CommunityDetection\/s9EscapableP","doc:\/\/CommunityDetection\/s8SendableP","doc:\/\/CommunityDetection\/s16Sendable