{"abstract":[{"text":"The partitions of the Girvan–Newman method (Girvan and Newman 2002), coarsest first: repeatedly","type":"text"},{"text":" ","type":"text"},{"text":"remove an edge of greatest betweenness, and list the components each time their number grows.","type":"text"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Iterator"],"anchor":"Structures","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/makeIterator()"],"anchor":"Instance-Methods","generated":true},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Element"],"anchor":"Type-Aliases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Sequence-Implementations"],"anchor":"Default-Implementations"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/CommunityDetection\/documentation\/CommunityDetection"]]},"metadata":{"externalID":"s:18CommunityDetection20GirvanNewmanSequenceV","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/CommunityDetection\/GirvanNewman.swift#L34","fileName":"GirvanNewman.swift"},"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GirvanNewmanSequence","kind":"identifier"}],"navigatorTitle":[{"text":"GirvanNewmanSequence","kind":"identifier"}],"symbolKind":"struct","title":"GirvanNewmanSequence","modules":[{"name":"CommunityDetection"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"te