{"abstract":[{"type":"text","text":"The partitions of the Girvan–Newman method (Girvan and Newman 2002), coarsest first: repeatedly"},{"type":"text","text":" "},{"type":"text","text":"remove an edge of greatest betweenness, and list the components each time their number grows."}],"identifier":{"url":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence","interfaceLanguage":"swift"},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Iterator"],"generated":true,"anchor":"Structures"},{"title":"Instance Methods","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/makeIterator()"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Aliases","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Element"],"generated":true,"anchor":"Type-Aliases"},{"title":"Default Implementations","identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Sequence-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GirvanNewmanSequence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Returned by "},{"type":"codeVoice","code":"girvanNewmanCommunities()"},{"type":"text","text":". Iterating it does the work, one split at a time: the"},{"type":"text","text":" "},{"type":"text","text":"first partition has one more community than the graph has components, each later one splits"},{"type":"text","text":" "},{"type":"text","text":"one community in two, and the last is every vertex alone. A graph with no edges other than"},{"type":"text","text":" "},{"type":"text","text":"self-loops lists its components once. Each partition keeps a copy-on-write copy of the graph,"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"Partition"},{"type":"text","text":" does."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/communitydetection\/girvannewmansequence"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/CommunityDetection\/documentation\/CommunityDetection"]]},"kind":"symbol","metadata":{"role":"symbol","title":"GirvanNewmanSequence","externalID":"s:18CommunityDetection20GirvanNewmanSequenceV","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/CommunityDetection\/GirvanNewman.swift#L34","fileName":"GirvanNewman.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GirvanNewmanSequence","kind":"identifier"}],"navigatorTitle":[{"text":"GirvanNewmanSequence","kind":"identifier"}],"modules":[{"name":"CommunityDetection"}],"roleHeading":"Structure"},"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/CommunityDetection\/s8SendableP","doc:\/\/CommunityDetection\/s16SendableMetatypeP","doc:\/\/CommunityDetection\/ST"],"type":"conformsTo"}],"references":{"doc://CommunityDetection/documentation/CommunityDetection":{"abstract":[],"title":"CommunityDetection","identifier":"d