{"kind":"symbol","abstract":[{"text":"The partitions of the Girvan–Newman method (Girvan and Newman 2002), coarsest first: repeatedly","type":"text"},{"text":" ","type":"text"},{"text":"remove an edge of greatest betweenness, and list the components each time their number grows.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/CommunityDetection\/documentation\/CommunityDetection"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Iterator"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/makeIterator()"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Element"],"anchor":"Type-Aliases","title":"Type Aliases"},{"generated":true,"identifiers":["doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence\/Sequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GirvanNewmanSequence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned by "},{"type":"codeVoice","code":"girvanNewmanCommunities()"},{"type":"text","text":". Iterating it does the work, one split at a time: the"},{"type":"text","text":" "},{"type":"text","text":"first partition has one more community than the graph has components, each later one splits"},{"type":"text","text":" "},{"type":"text","text":"one community in two, and the last is every vertex alone. A graph with no edges other than"},{"type":"text","text":" "},{"type":"text","text":"self-loops lists its components once. Each partition keeps a copy-on-write copy of the graph,"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"Partition"},{"type":"text","text":" does."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CommunityDetection\/documentation\/CommunityDetection\/GirvanNewmanSequence"},"relationshipsSections":[{"identifiers":["doc:\/\/CommunityDetection\/s8SendableP","doc:\/\/CommunityDetection\/s16SendableMetatypeP","doc:\/\/CommunityDetection\/ST"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"sections":[],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GirvanNewmanSequence","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"CommunityDetection"}],"role":"symbol","symbolKind":"struct","externalID":"s:18CommunityDetection20GirvanNewmanSequenceV","remoteSource":{"fileName":"GirvanNewman.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/CommunityDetection\/GirvanNewman.swift#L34"},"title":"GirvanNewmanSequence","navigatorTitle":[{"text":"GirvanNewmanSequence","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/communitydetection\/girvannewmansequence"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://CommunityDetection/documentation/CommunityDetection/GirvanNewmanSequence":{"url":"\/documentation\/communitydete