ntation\/CommunityDetection\/GirvanNewmanSequence\/Iterator","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/communitydetection\/girvannewmansequence\/iterator","type":"topic","abstract":[{"type":"text","text":"The state of the method: the graph left after the removals so far, its components, and the"},{"type":"text","text":" "},{"type":"text","text":"betweenness of every edge left. Removing an edge recomputes the betweenness of its component"},{"type":"text","text":" "},{"type":"text","text":"only (of both parts when it splits), since no other edge’s shortest paths change."}],"title":"GirvanNewmanSequence.Iterator","navigatorTitle":[{"text":"Iterator","kind":"identifier"}]}}}