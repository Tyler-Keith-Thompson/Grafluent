{"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"Grafluent"}],"roleHeading":"Framework","role":"collection","title":"Grafluent","externalID":"Grafluent","symbolKind":"module"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Grafluent provides graph representations as copy-on-write value types, graph classes that"},{"type":"text","text":" "},{"type":"text","text":"enforce their invariants, and generic algorithms that specialize for the concrete graph and weight"},{"type":"text","text":" "},{"type":"text","text":"types they run on. Vertices can be any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" type. Lookups trap on a missing vertex, and"},{"type":"text","text":" "},{"type":"text","text":"their "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" spellings throw a typed "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import Grafluent"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}],"type":"paragraph"},{"syntax":"swift","code":["import Grafluent","","let steps = [\"fetch\", \"compile\", \"test\", \"package\"]","var build = AdjacencyList<String> {","    for (step, next) in zip(steps, steps.dropFirst()) {","        DirectedEdge(from: step, to: next)","    }","    DirectedEdge(from: \"compile\", to: \"package\")","}","build.insert(edge: DirectedEdge(from: \"package\", to: \"publish\"))","","let next = Array(build.successors(of: \"compile\"))  \/\/ [\"test\", \"package\"]","let order = build.topologicalSort()                \/\/ [\"fetch\", \"compile\", \"test\", \"package\", \"publish\"]"],"type":"codeListing"},{"anchor":"Modules","text":"Modules","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Vocabulary:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"GraphProtocols","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Walks","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Semirings","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Data structures:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"PriorityQueueModule","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DisjointSetModule","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Representations:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyListModule"},{"type":"text","text":", "},{"type":"codeVoice","code":"AdjacencyMatrixModule"},{"type":"text","text":", "},{"type":"codeVoice","code":"IncidenceMatrixModule"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"CompressedSparseRowModule"},{"type":"text","text":", "},{"type":"codeVoice","code":"EdgeListModule"},{"type":"text","text":", "},{"type":"codeVoice","code":"ImplicitGraphs"},{"type":"text","text":", "},{"type":"codeVoice","code":"LabeledGraphs"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Structures:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"DirectedAcyclicGraphModule"},{"type":"text","text":", "},{"type":"codeVoice","code":"Trees"},{"type":"text","text":", "},{"type":"codeVoice","code":"BipartiteGraphs"},{"type":"text","text":", "},{"type":"codeVoice","code":"Multigraphs"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"StableGraphs"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hy