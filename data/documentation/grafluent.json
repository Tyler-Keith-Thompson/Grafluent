{"hierarchy":{"paths":[[]]},"abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Grafluent provides graph representations as copy-on-write value types, graph classes that"},{"type":"text","text":" "},{"type":"text","text":"enforce their invariants, and generic algorithms that specialize for the concrete graph and weight"},{"type":"text","text":" "},{"type":"text","text":"types they run on. Vertices can be any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" type. Lookups trap on a missing vertex, and"},{"type":"text","text":" "},{"type":"text","text":"their "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" spellings throw a typed "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"import Grafluent"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Grafluent","","let steps = [\"fetch\", \"compile\", \"test\", \"package\"]","var build = AdjacencyList<String> {","    for (step, next) in zip(steps, steps.dropFirst()) {","        DirectedEdge(from: step, to: next)","    }","    DirectedEdge(from: \"compile\", to: \"package\")","}","build.insert(edge: DirectedEdge(from: \"package\", to: \"publish\"))","","let next = Array(build.successors(of: \"compile\"))  \/\/ [\"test\", \"package\"]","let order = build.topologicalSort()                \/\/ [\"fetch\", \"compile\", \"test\", \"package\", \"publish\"]"]},{"text":"Modules","anchor":"Modules","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":