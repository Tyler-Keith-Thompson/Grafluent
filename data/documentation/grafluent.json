{"kind":"symbol","identifier":{"url":"doc:\/\/Grafluent\/documentation\/Grafluent","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Grafluent provides graph representations as copy-on-write value types, graph classes that","type":"text"},{"text":" ","type":"text"},{"text":"enforce their invariants, and generic algorithms that specialize for the concrete graph and weight","type":"text"},{"text":" ","type":"text"},{"text":"types they run on. Vertices can be any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" type. Lookups trap on a missing vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"their ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" spellings throw a typed ","type":"text"},{"type":"codeVoice","code":"VertexNotFound"},{"text":" instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Grafluent"},{"type":"text","text":" imports every module. Each module also has its own documentation and can be"},{"type":"text","text":" "},{"type":"text","text":"imported on its own."}]},{"syntax":"swift","type":"codeListing","code":["import Grafluent","","let steps = [\"fetch\", \"compile\", \"test\", \"package\"]","var build = AdjacencyList<String> {","    for (step, next) in zip(steps, steps.dropFirst()) {","        DirectedEdge(from: step, to: next)","    }","    DirectedEdge(from: \"compile\", to: \"package\")","}","build.insert(edge: DirectedEdge(from: \"package\", to: \"publish\"))","","let next = Array(build.successors(of: \"compile\"))  \/\/ [\"test\", \"package\"]","let order = build.topologicalSort()                \/\/ [\"fetch\", \"compile\", \"test\", \"package\", \"publish\"]"]},{"level":3,"type":"heading","text":"Modules","anchor":"Modules"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"t