{"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Grafluent provides graph representations as copy-on-write value types, graph classes that","type":"text"},{"text":" ","type":"text"},{"text":"enforce their invariants, and generic algorithms that specialize for the concrete graph and weight","type":"text"},{"text":" ","type":"text"},{"text":"types they run on. Vertices can be any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" type. Lookups trap on a missing vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"their ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" spellings throw a typed ","type":"text"},{"type":"codeVoice","code":"VertexNotFound"},{"text":" instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"import Grafluent","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation and can be","type":"text"},{"text":" ","type":"text"},{"text":"imported on its own.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Grafluent","","let steps = [\"fetch\", \"compile\", \"test\", \"package\"]","var build = AdjacencyList<String> {","    for (step, next) in zip(steps, steps.dropFirst()) {","        DirectedEdge(from: step, to: next)","    }","    DirectedEdge(from: \"compile\", to: \"package\")","}","build.insert(edge: DirectedEdge(from: \"package\", to: \"publish\"))","","let next = Array(build.successors(of: \"compile\"))  \/\/ [\"test\", \"package\"]","let order = build.topologicalSort()                \/\/ [\"fetch\", \"compile\", \"test\", \"package\", \"publish\"]"]},{"type":"heading","text":"Modules","level":3,"anchor":"Modules"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vocabulary:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice"