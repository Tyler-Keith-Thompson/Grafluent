{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Grafluent provides graph representations as copy-on-write value types, graph classes that","type":"text"},{"text":" ","type":"text"},{"text":"enforce their invariants, and generic algorithms that specialize for the concrete graph and weight","type":"text"},{"text":" ","type":"text"},{"text":"types they run on. Vertices can be any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" type. Lookups trap on a missing vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"their ","type":"text"},{"code":"checked:","type":"codeVoice"},{"text":" spellings throw a typed ","type":"text"},{"code":"VertexNotFound","type":"codeVoice"},{"text":" instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"import Grafluent","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation and can be","type":"text"},{"text":" ","type":"text"},{"text":"imported on its own.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Grafluent","","let steps = [\"fetch\", \"compile\", \"test\", \"package\"]","var build = AdjacencyList<String> {","    for (step, next) in zip(steps, steps.dropFirst()) {","        DirectedEdge(from: step, to: next)","    }","    DirectedEdge(from: \"compile\", to: \"package\")","}","build.insert(edge: DirectedEdge(from: \"package\", to: \"publish\"))","","let next = Array(build.successors(of: \"compile\"))  \/\/ [\"test\", \"package\"]","let order = build.topologicalSort()                \/\/ [\"fetch\", \"compile\", \"test\", \"package\", \"publish\"]"]},{"type":"heading","anchor":"Modules","level":3,"text":"Modules"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Vocabulary:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"GraphProtocols","type":"codeVoice"},{"type"