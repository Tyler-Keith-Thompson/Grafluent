{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"abstract":[{"type":"text","text":"What an edge breadth-first search reports, in order: the events of "},{"type":"codeVoice","code":"BreadthFirstSearchEvent"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"with each edge given by its position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", so parallel edges are told apart."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeBreadthFirstSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each source is discovered first. Then, for each vertex in the order discovered, its out-edges"},{"type":"text","text":" "},{"type":"text","text":"are reported as tree edges (to an undiscovered vertex, which is then discovered) or non-tree"},{"type":"text","text":" "},{"type":"text","text":"edges (to a discovered one); then the vertex is finished. In a directed graph every out-edge of"},{"type":"text","text":" "},{"type":"text","text":"an explored vertex is reported. In an undirected graph each edge is reported once, from the"},{"type":"text","text":" "},{"type":"text","text":"end whose edges are examined first: the tree edge is not reported again from the vertex it"},{"type":"text","text":" "},{"type":"text","text":"discovered, but a parallel edge to the parent is a non-tree edge, and a self-loop is one"},{"type":"text","text":" "},{"type":"text","text":"non-tree edge."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/edgebreadthfirstsearchevent"]}],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearchEvent","interfaceLanguage":"swift"},"metadata":{"externalID":"s:9Traversal27EdgeBreadthFirstSearchEventO","title":"EdgeBreadthFirstSearchEvent","role":"symbol","modules":[{"name":"Traversal"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeBreadthFirstSearchEvent"}],"navigatorTitle":[{"text":"EdgeBreadthFirstSearchEvent","kind":"identifier"}],"roleHeading":"Enumeration","symbolKind":"enum","remoteSource":{"fileName":"EdgeSearchEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/EdgeSearchEvents.swift#L14"}},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearchEvent\/nonTreeEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirst