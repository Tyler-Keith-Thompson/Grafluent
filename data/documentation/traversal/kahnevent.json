","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"First every vertex without in-edges is ready, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Then, while a vertex is"},{"type":"text","text":" "},{"type":"text","text":"ready, the one that became ready first is emitted: it is next in the order. Each edge out of"},{"type":"text","text":" "},{"type":"text","text":"it is removed, with the number of in-edges its target has left; a target left with none is"},{"type":"text","text":" "},{"type":"text","text":"ready. The order emitted is "},{"type":"codeVoice","code":"topologicalGenerations()"},{"type":"text","text":" read generation by generation. When the"},{"type":"text","text":" "},{"type":"text","text":"graph has a cycle (a self-loop is one) the vertices on it, and those after it, are never ready."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"topicSections":[{"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/KahnEvent\/emit(_:)","doc:\/\/Traversal\/documentation\/Traversal\/KahnEvent\/ready(_:)","doc:\/\/Traversal\/documentation\/Traversal\/KahnEvent\/removeEdge(_:inDegree:)"],"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/KahnEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/KahnEvent\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"references":{"doc://Traversal/documentation/Traversal/KahnEvent/emit(_:)":{"type":"topic","title":"KahnEvent.emit(_:)","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/KahnEvent\/emit(_:)","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emit","k