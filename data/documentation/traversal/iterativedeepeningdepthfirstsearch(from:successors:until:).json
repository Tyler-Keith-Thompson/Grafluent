nly be "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" and memory stays proportional to the path. A path never revisits a"},{"type":"text","text":" "},{"type":"text","text":"state on itself. Returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no goal is reachable and the space is finite; on an"},{"type":"text","text":" "},{"type":"text","text":"infinite space without a goal, it does not return."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With no record of visited states, every path is enumerated again at each depth, which is"},{"type":"text","text":" "},{"type":"text","text":"exponential in the depth on graphs with many routes between states (a grid). Use "},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"type":"text","text":" when states are "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" "},{"type":"text","text":"and memory allows."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"kind":"symbol","sections":[],"abstract":[{"text":"A shortest path by edge count from ","type":"text"},{"type":"codeVoice","code":"start"},{"text":" to the first state satisfying ","type":"text"},{"type":"codeVoice","code":"isGoal"},{"text":", by iterative","type":"text"},{"text":" ","type":"text"},{"text":"deepening.","type":"text"}],"references":{"doc://Traversal/documentation/Traversal":{"url":"\/documentation\/traversal","type":"topic","abstract":[],"kind":"symbol","title":"Traversal","role":"collection","identifier":"doc:\/\/Traversal\/documentation\/Traversal"},"doc://Traversal/documentation/Traversal/iterativeDeepeningDepthFirstSearch(from:successors:until:)":{"url":"\/documentation\/traversal\/iterativedeepeningdepthfirstsearch(from:successors:until:)","type":"topic","abstract":[{"type":"text","text":"A shortest path by edge count from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" to the first state satisfying "},{"type