h, so states","type":"text"},{"text":" ","type":"text"},{"text":"need only be ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" and memory stays proportional to the path. A path never revisits a","type":"text"},{"text":" ","type":"text"},{"text":"state on itself. Returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when no goal is reachable and the space is finite; on an","type":"text"},{"text":" ","type":"text"},{"text":"infinite space without a goal, it does not return.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With no record of visited states, every path is enumerated again at each depth, which is"},{"type":"text","text":" "},{"type":"text","text":"exponential in the depth on graphs with many routes between states (a grid). Use "},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"type":"text","text":" when states are "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" "},{"type":"text","text":"and memory allows."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/iterativedeepeningdepthfirstsearch(from:successors:until:)"]}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://Traversal/documentation/Traversal/iterativeDeepeningDepthFirstSearch(from:successors:until:)":{"kind":"symbol","role":"symbol","type":"topic","title":"iterativeDeepeningDepthFirstSearch(from:successors:until:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"iterativeDeepeningDepthFirstSearch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Successors","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":