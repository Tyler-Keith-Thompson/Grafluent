d":"func","title":"iterativeDeepeningDepthFirstSearch(from:successors:until:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"iterativeDeepeningDepthFirstSearch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Successors"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"start"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"successors"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Successors"},{"kind":"text","text":", "},{"kind":"externalParam","text":"until"},{"kind":"text","text":" "},{"kind":"internalParam","text":"isGoal"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SQ","text":"Equatable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Successors"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Successors"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Runs depth-first searches with a growing depth limit that keep only the current path, so states"},{"type":"text","text":" "},{"type":"text","text":"need only be "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" and memory stays proportional to the path. A path never revisits a"},{"type":"text","text":" "},{"type":"text","text":"state on itself. Returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no goal is reachable and the space is finite; on an"},{"type":"text","text":" "},{"type":"text","text":"infinite space without a goal, it does not return."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With no record of visited states, every path is enumerated again at each depth, which is"},{"type":"text","text":" "},{"type":"text","text":"exponential in the depth on graphs with many routes between states (a grid). Use "},{"type":"codeVoice","code":"breadthFirstSearch(from:successors:)"},{"type":"text","text":" when states are "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" "},{"type":"text","text":"and memory allows."}]}]}],"variants":[{"paths":["\/documentation\/traversal\/iterativedeepeningdepthfirstsearch(from:successors:until:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://Traversal/documentation/Traversal":{"kind":"symbol","abstract":[],"title":"Traversal","identifier":"doc:\/\/Traversal\/documentation\/Traversal","role":"collection","url":"\/documentation\/traversal","type":"topic"},"doc://Traversal/documentation/Traversal/iterativeDeepeningDepthFirstSearch(from:successors:until:)":{"abstract":[{"text":"A shortest path by edge count from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" to the first state satisfying ","type":"text"},{"code":"isGoal","type":"codeVoice"},{"text":", by iterative","type":"text"},{"text":" ","type":"text"},{"text":"dee