ussion","type":"heading"},{"inlineContent":[{"text":"Runs depth-first searches with a growing depth limit that keep only the current path, so states","type":"text"},{"text":" ","type":"text"},{"text":"need only be ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" and memory stays proportional to the path. A path never revisits a","type":"text"},{"text":" ","type":"text"},{"text":"state on itself. Returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when no goal is reachable and the space is finite; on an","type":"text"},{"text":" ","type":"text"},{"text":"infinite space without a goal, it does not return.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With no record of visited states, every path is enumerated again at each depth, which is","type":"text"},{"text":" ","type":"text"},{"text":"exponential in the depth on graphs with many routes between states (a grid). Use ","type":"text"},{"code":"breadthFirstSearch(from:successors:)","type":"codeVoice"},{"text":" when states are ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and memory allows.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/iterativeDeepeningDepthFirstSearch(from:successors:until:)","interfaceLanguage":"swift"},"references":{"doc://Traversal/documentation/Traversal/iterativeDeepeningDepthFirstSearch(from:successors:until:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"iterativeDeepeningDepthFirstSearch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Successors"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"successors"},{"kind":"