{"abstract":[{"type":"text","text":"A shortest path by edge count from "},{"type":"codeVoice","code":"start"},{"type":"text","text":" to the first state satisfying "},{"type":"codeVoice","code":"isGoal"},{"type":"text","text":", by iterative"},{"type":"text","text":" "},{"type":"text","text":"deepening."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/iterativedeepeningdepthfirstsearch(from:successors:until:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"iterativeDeepeningDepthFirstSearch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Successors","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"start","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"successors","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Successors","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"until","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"isGoal","kind":"internalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":"]? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Equatable","preciseIdentifier":"s:SQ","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Successors","kind":"typeIdentifier"},{"text":"."