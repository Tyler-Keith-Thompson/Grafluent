"abstract":[{"type":"text","text":"A breadth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeBreadthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"BreadthFirstSearch"},{"type":"text","text":" reports them. Parallel edges"},{"text":" ","type":"text"},{"text":"are told apart, and a weight or other per-edge value is read at the position given. It holds a","type":"text"},{"text":" ","type":"text"},{"text":"copy of the graph, so later changes to the original do not affect it, and it can be iterated","type":"text"},{"text":" ","type":"text"},{"text":"more than once.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearch","title":"EdgeBreadthFirstSearch","navigatorTitle":[{"kind":"identifier","text":"EdgeBreadthFirstSearch"}],"url":"\/documentation\/traversal\/edgebreadthfirstsearch","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeBreadthFirstSearch"}]},"doc://Traversal/documentation/Traversal/EdgeBreadthFirstSearch/lazy":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearch\/lazy","title":"lazy","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lazy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12LazySequenceV","text":"LazySequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/traversal\/edgebreadthfirstsearch\/lazy","role":"symbol"}}}