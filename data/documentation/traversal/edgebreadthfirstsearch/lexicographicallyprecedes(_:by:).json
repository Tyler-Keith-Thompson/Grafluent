aversal\/edgebreadthfirstsearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeBreadthFirstSearch"}],"abstract":[{"type":"text","text":"A breadth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeBreadthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"BreadthFirstSearch"},{"type":"text","text":" reports them. Parallel edges"},{"text":" ","type":"text"},{"text":"are told apart, and a weight or other per-edge value is read at the position given. It holds a","type":"text"},{"text":" ","type":"text"},{"text":"copy of the graph, so later changes to the original do not affect it, and it can be iterated","type":"text"},{"text":" ","type":"text"},{"text":"more than once.","type":"text"}],"kind":"symbol"}}}