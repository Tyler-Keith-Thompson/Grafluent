{"abstract":[{"type":"text","text":"A depth-first search: a lazy sequence of "},{"code":"DepthFirstSearchEvent","type":"codeVoice"},{"type":"text","text":"s, with every edge classified as"},{"type":"text","text":" "},{"type":"text","text":"a tree, back, forward or cross edge. It holds a copy of the graph and can be iterated more than"},{"type":"text","text":" "},{"type":"text","text":"once. The search keeps its own stack, so a deep graph cannot overflow the call stack."}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP","doc:\/\/Traversal\/ST"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DepthFirstSearch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Two ways to consume it. "},{"type":"codeVoice","code":"for event in search"},{"type":"text","text":" pulls events one at a time, lazily, so stopping"},{"type":"text","text":" "},{"type":"text","text":"the loop stops the search; to skip a vertex’s out-edges, iterate by hand and call "},{"type":"codeVoice","code":"prune()"},{"type":"text","text":" "},{"type":"text","text":"right after its "},{"type":"codeVoice","co