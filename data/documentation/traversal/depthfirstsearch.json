{"sections":[],"abstract":[{"text":"A depth-first search: a lazy sequence of ","type":"text"},{"type":"codeVoice","code":"DepthFirstSearchEvent"},{"text":"s, with every edge classified as","type":"text"},{"text":" ","type":"text"},{"text":"a tree, back, forward or cross edge. It holds a copy of the graph and can be iterated more than","type":"text"},{"text":" ","type":"text"},{"text":"once. The search keeps its own stack, so a deep graph cannot overflow the call stack.","type":"text"}],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/depthfirstsearch"]}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/Iterator"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/postorder","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/preorder"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/forEach(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/makeIterator()"]},{"anchor":"Type-Aliases","generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/Element"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/Sequence-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"st