{"sections":[],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"abstract":[{"type":"text","text":"A depth-first search: a lazy sequence of "},{"type":"codeVoice","code":"DepthFirstSearchEvent"},{"type":"text","text":"s, with every edge classified as"},{"type":"text","text":" "},{"type":"text","text":"a tree, back, forward or cross edge. It holds a copy of the graph and can be iterated more than"},{"type":"text","text":" "},{"type":"text","text":"once. The search keeps its own stack, so a deep graph cannot overflow the call stack."}],"kind":"symbol","metadata":{"modules":[{"name":"Traversal"}],"roleHeading":"Structure","remoteSource":{"fileName":"DepthFirstSearch.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/DepthFirstSearch.swift#L15"},"symbolKind":"struct","title":"DepthFirstSearch","role":"symbol","externalID":"s:9Traversal16DepthFirstSearchV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearch"}],"navigatorTitle":[{"kind":"identifier","text":"DepthFirstSearch"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP","doc:\/\/Traversal\/ST"],"type":"conformsTo"}],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/Iterator"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/postorder","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/preorder"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearch\/forEach(