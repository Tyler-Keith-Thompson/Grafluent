ied as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"text":"call stack.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","kind":"symbol"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/randomSample(count:using:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"randomSample","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/randomSample(count:using:)","abstract":[],"title":"randomSample(count:using:)","kind":"symbol","role":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch\/randomsample(count:using:)"}}}