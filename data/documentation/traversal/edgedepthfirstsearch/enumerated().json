:[{"text":"A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"text":"s, in the order ","type":"text"},{"code":"DepthFirstSearch","type":"codeVoice"},{"text":" reports them, with every edge","type":"text"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","title":"EdgeDepthFirstSearch","role":"symbol","type":"topic"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/enumerated()":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enumerated","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"EnumeratedSequence","kind":"typeIdentifier","preciseIdentifier":"s:s18EnumeratedSequenceV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"enumerated()","role":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch\/enumerated()","abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/enumerated()"},"doc://Traversal/documentation/Traversal":{"kind":"symbol","abstract":[],"title":"Traversal","identifier":"doc:\/\/Traversal\/documentation\/Traversal","role":"collection","url":"\/documentation\/traversal","type":"topic"}}}