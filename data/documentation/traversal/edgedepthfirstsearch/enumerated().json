bol","kind":"symbol","abstract":[{"type":"text","text":"A depth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"DepthFirstSearch"},{"type":"text","text":" reports them, with every edge"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}]},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/enumerated()":{"title":"enumerated()","type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/enumerated()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"enumerated"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"EnumeratedSequence","preciseIdentifier":"s:s18EnumeratedSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch\/enumerated()","abstract":[]},"doc://Traversal/documentation/Traversal":{"role":"collection","abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal","kind":"symbol","title":"Traversal","type":"topic","url":"\/documentation\/traversal"}}}