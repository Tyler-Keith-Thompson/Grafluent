"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"text":"call stack.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","kind":"symbol"}}}