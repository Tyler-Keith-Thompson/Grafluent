ot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","type":"topic","title":"EdgeDepthFirstSearch","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","role":"symbol"}}}