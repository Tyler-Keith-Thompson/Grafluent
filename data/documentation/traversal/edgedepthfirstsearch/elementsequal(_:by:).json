":"text","text":" "},{"type":"text","text":"call stack."}],"kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","title":"EdgeDepthFirstSearch","role":"symbol","type":"topic"},"doc://Traversal/documentation/Traversal":{"kind":"symbol","abstract":[],"title":"Traversal","identifier":"doc:\/\/Traversal\/documentation\/Traversal","role":"collection","url":"\/documentation\/traversal","type":"topic"}}}