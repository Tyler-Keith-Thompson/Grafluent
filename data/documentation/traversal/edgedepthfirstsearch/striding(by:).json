y edge","type":"text"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}]},"doc://Traversal/documentation/Traversal":{"kind":"symbol","type":"topic","title":"Traversal","identifier":"doc:\/\/Traversal\/documentation\/Traversal","abstract":[],"role":"collection","url":"\/documentation\/traversal"}}}