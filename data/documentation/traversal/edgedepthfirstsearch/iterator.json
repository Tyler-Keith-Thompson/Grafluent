h","abstract":[{"type":"text","text":"A depth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"DepthFirstSearch"},{"type":"text","text":" reports them, with every edge"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/Iterator/prune()":{"abstract":[{"text":"Skips the out-edges of the vertex just discovered; it is still finished.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/Iterator\/prune()","kind":"symbol","type":"topic","url":"\/documentation\/traversal\/edgedepthfirstsearch\/iterator\/prune()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prune","kind":"identifier"},{"text":"()","kind":"text"}],"title":"prune()"},"doc://Traversal/s16SendableMetatypeP":{"identifier":"doc:\/\/Traversal\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"}}}