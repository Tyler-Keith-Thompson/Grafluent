d":"text"},{"preciseIdentifier":"s:s12LazySequenceV","text":"LazySequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch\/lazy","type":"topic","kind":"symbol","title":"lazy","abstract":[]},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"url":"\/documentation\/traversal\/edgedepthfirstsearch","title":"EdgeDepthFirstSearch","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"text":"s, in the order ","type":"text"},{"code":"DepthFirstSearch","type":"codeVoice"},{"text":" reports them, with every edge","type":"text"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch"},"doc://Traversal/documentation/Traversal":{"role":"collection","identifier":"doc:\/\/Traversal\/documentation\/Traversal","url":"\/documentation\/traversal","type":"topic","kind":"symbol","title":"Traversal","abstract":[]}}}