ind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch\/lazy","kind":"symbol","role":"symbol","title":"lazy","abstract":[],"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/lazy"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","kind":"symbol","role":"symbol","title":"EdgeDepthFirstSearch","abstract":[{"type":"text","text":"A depth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"DepthFirstSearch"},{"type":"text","text":" reports them, with every edge"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch"},"doc://Traversal/documentation/Traversal":{"role":"collection","title":"Traversal","url":"\/documentation\/traversal","abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal","kind":"symbol","type":"topic"}}}