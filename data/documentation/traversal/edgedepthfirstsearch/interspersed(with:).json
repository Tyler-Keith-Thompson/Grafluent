raph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","type":"topic","title":"EdgeDepthFirstSearch","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","role":"symbol"},"doc://Traversal/documentation/Traversal":{"abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal","type":"topic","title":"Traversal","kind":"symbol","url":"\/documentation\/traversal","role":"collection"}}}