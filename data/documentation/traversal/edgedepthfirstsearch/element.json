type":"text","text":" "},{"type":"text","text":"each edge given by its position in "},{"type":"codeVoice","code":"edges"},{"text":", so parallel edges are told apart.","type":"text"}],"role":"symbol"},"doc://Traversal/documentation/Traversal":{"role":"collection","type":"topic","url":"\/documentation\/traversal","identifier":"doc:\/\/Traversal\/documentation\/Traversal","abstract":[],"kind":"symbol","title":"Traversal"}}}