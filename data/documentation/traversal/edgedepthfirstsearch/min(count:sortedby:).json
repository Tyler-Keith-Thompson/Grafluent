n\/traversal\/edgedepthfirstsearch\/min(count:sortedby:)","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"min"},{"kind":"text","text":"("},{"kind":"externalParam","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"text":", ","kind":"text"},{"text":"sortedBy","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","title":"min(count:sortedBy:)","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/min(count:sortedBy:)"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","title":"EdgeDepthFirstSearch","abstract":[{"type":"text","text":"A depth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"type":"text","text":"s, in the order "},{"code":"DepthFirstSearch","type":"codeVoice"},{"type":"text","text":" reports them, with every edge"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"text":"call stack.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","kind":"symbol"}}}