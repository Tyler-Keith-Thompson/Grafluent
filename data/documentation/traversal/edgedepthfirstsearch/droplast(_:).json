al/documentation/Traversal/EdgeDepthFirstSearch/dropLast(_:)":{"kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch\/droplast(_:)","type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/dropLast(_:)","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dropLast","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ST7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","title":"dropLast(_:)"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"abstract":[{"type":"text","text":"A depth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"DepthFirstSearch"},{"type":"text","text":" reports them, with every edge"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","type":"topic","title":"EdgeDepthFirstSearch","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"url":"\/documentation\/travers