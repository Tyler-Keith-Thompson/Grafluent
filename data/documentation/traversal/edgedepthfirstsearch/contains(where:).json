archEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"DepthFirstSearch"},{"type":"text","text":" reports them, with every edge"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch"},"doc://Traversal/documentation/Traversal":{"role":"collection","title":"Traversal","url":"\/documentation\/traversal","abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal","kind":"symbol","type":"topic"}}}