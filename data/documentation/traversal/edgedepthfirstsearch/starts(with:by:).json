vent"},{"text":"s, in the order ","type":"text"},{"type":"codeVoice","code":"DepthFirstSearch"},{"text":" reports them, with every edge","type":"text"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"call stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","role":"symbol","kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}]},"doc://Traversal/documentation/Traversal":{"title":"Traversal","type":"topic","abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal","role":"collection","url":"\/documentation\/traversal","kind":"symbol"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/starts(with:by:)":{"type":"topic","title":"starts(with:by:)","abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/starts(with:by:)","role":"symbol","kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch\/starts(with:by:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"starts","kind":"identifier"},{"text":"<","kind":"text"},{"text":"PossiblePrefix","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PossiblePrefix","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind"