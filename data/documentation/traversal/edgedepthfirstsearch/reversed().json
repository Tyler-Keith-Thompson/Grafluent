A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"text":"s, in the order ","type":"text"},{"type":"codeVoice","code":"DepthFirstSearch"},{"text":" reports them, with every edge","type":"text"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"title":"EdgeDepthFirstSearch","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}]},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/reversed()":{"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/reversed()","role":"symbol","title":"reversed()","url":"\/documentation\/traversal\/edgedepthfirstsearch\/reversed()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reversed"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":"]"}],"abstract":[],"kind":"symbol"}}}