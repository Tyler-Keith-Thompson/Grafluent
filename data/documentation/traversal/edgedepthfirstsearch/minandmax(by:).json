 ","type":"text"},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"text":"s, in the order ","type":"text"},{"type":"codeVoice","code":"DepthFirstSearch"},{"text":" reports them, with every edge","type":"text"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"title":"EdgeDepthFirstSearch","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}]},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/minAndMax(by:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minAndMax"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> (min"},{"kind":"text","text":": "},{"kin