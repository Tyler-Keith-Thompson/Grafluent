/Traversal":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal","role":"collection","kind":"symbol","abstract":[],"url":"\/documentation\/traversal","type":"topic","title":"Traversal"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"abstract":[{"text":"A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"text":"s, in the order ","type":"text"},{"code":"DepthFirstSearch","type":"codeVoice"},{"text":" reports them, with every edge","type":"text"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"title":"EdgeDepthFirstSearch","kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","role":"symbol","type":"topic"}}}