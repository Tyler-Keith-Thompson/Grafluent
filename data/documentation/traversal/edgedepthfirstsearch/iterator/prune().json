 a sequence of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"text":"s, in the order ","type":"text"},{"type":"codeVoice","code":"DepthFirstSearch"},{"text":" reports them, with every edge","type":"text"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"text":"call stack.","type":"text"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","title":"EdgeDepthFirstSearch","url":"\/documentation\/traversal\/edgedepthfirstsearch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}]},"doc://Traversal/documentation/Traversal":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal","kind":"symbol","type":"topic","title":"Traversal","role":"collection","abstract":[],"url":"\/documentation\/traversal"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/Iterator":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/Iterator","role":"symbol","abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch\/iterator","type":"topic","navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"title":"EdgeDepthFirstSearch.Iterator"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/Iterator/prune()":{"identifier":"doc