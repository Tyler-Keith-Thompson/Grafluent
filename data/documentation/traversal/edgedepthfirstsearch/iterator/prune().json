earch whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"DepthFirstSearch"},{"type":"text","text":" reports them, with every edge"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","url":"\/documentation\/traversal\/edgedepthfirstsearch","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"title":"EdgeDepthFirstSearch"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/Iterator":{"url":"\/documentation\/traversal\/edgedepthfirstsearch\/iterator","kind":"symbol","abstract":[],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"title":"EdgeDepthFirstSearch.Iterator","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/Iterator","type":"topic"},"doc://Traversal/documentation/Traversal":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal","type":"topic","title":"Traversal","abstract":[],"role":"collection","url":"\/documentation\/traversal","kind":"symbol"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/Iterator/prune()":{"identifier":"doc