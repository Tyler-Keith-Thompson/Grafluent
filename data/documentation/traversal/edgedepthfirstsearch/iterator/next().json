\/documentation\/traversal\/edgedepthfirstsearch","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"type":"topic","abstract":[{"text":"A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"text":"s, in the order ","type":"text"},{"type":"codeVoice","code":"DepthFirstSearch"},{"text":" reports them, with every edge","type":"text"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"role":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","title":"EdgeDepthFirstSearch"},"doc://Traversal/documentation/Traversal":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal","kind":"symbol","role":"collection","abstract":[],"title":"Traversal","url":"\/documentation\/traversal","type":"topic"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/Element":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/Element","kind":"symbol","navigatorTitle":[{"text":"Element","kind":"identifier"}],"role":"symbol","abstract":[],"title":"EdgeDepthFirstSearch.Element","url":"\/documentation\/traversal\/edgedepthfirstsearch\/element","type":"topic"}}}