word","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"ElementOfResult"},{"kind":"text","text":"]"}],"kind":"symbol","title":"flatMap(_:)","role":"symbol","abstract":[],"type":"topic"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"title":"EdgeDepthFirstSearch","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","url":"\/documentation\/traversal\/edgedepthfirstsearch","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A depth-first search whose edge events carry edge positions: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s, in the order "},{"type":"codeVoice","code":"DepthFirstSearch"},{"type":"text","text":" reports them, with every edge"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"type":"topic","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}]}}}