ion\/Traversal"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","title":"EdgeDepthFirstSearch","kind":"symbol","abstract":[{"text":"A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"text":"s, in the order ","type":"text"},{"code":"DepthFirstSearch","type":"codeVoice"},{"text":" reports them, with every edge","type":"text"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"url":"\/documentation\/traversal\/edgedepthfirstsearch","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"type":"topic"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch/adjacentPairs()":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch\/adjacentPairs()","url":"\/documentation\/traversal\/edgedepthfirstsearch\/adjacentpairs()","title":"adjacentPairs()","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","text":"AdjacentPairsSequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdenti