{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Edge"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vertex is discovered, then its out-edges are reported, then it is finished. An edge to an"},{"type":"text","text":" "},{"type":"text","text":"undiscovered vertex is a tree edge, and the search continues from that vertex before the next"},{"type":"text","text":" "},{"type":"text","text":"edge. An edge to a vertex discovered but not yet finished is a back edge; a self-loop is one."},{"type":"text","text":" "},{"type":"text","text":"An edge to a finished vertex is a forward edge when that vertex was discovered later than the"},{"type":"text","text":" "},{"type":"text","text":"vertex being explored, and a cross edge otherwise."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a directed graph every out-edge of an explored vertex is reported. In an undirected graph"},{"type":"text","text":" "},{"type":"text","text":"each edge is reported once, from the end that reaches it first: the tree edge is not"},{"type":"text","text":" "},{"type":"text","text":"reported again from the vertex it discovered, but a parallel edge to the parent is a back edge,"},{"type":"text","text":" "},{"type":"text","text":"and a self-loop is one back edge. Without pruning or a depth limit an undirected search has"},{"type":"text","text":" "},{"type":"text","text":"only tree and back edges; an edge to a finished vertex whose edges were not explored is a"},{"type":"text","text":" "},{"type":"text","text":"forward or cross edge."}]}]}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"sections":[],"variants":[{"paths":["\/documentation\/traversal\/edgedepthfirstsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"What an edge depth-first search reports, in order: the events of "},{"type":"codeVoice","code":"DepthFirstSearchEvent"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"each edge given by its position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", so parallel edges are told apart."}],"kind":"symbol","topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/treeEdge(_:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/Equatable-Implementations"],"generated":true}],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"fileName":"EdgeSearchEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/EdgeSearchEvents.swift#L37"},"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearchEvent"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}],"roleHeading":"Enumeration","modules":[{"name":"Traversal"}],"title":"EdgeDepthFirstSearchEvent","symbolKind":"enum","role":"symbol","externalID":"s:9Traversal25EdgeDepthFirstSearchEventO"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearchEvent/CustomStringConvertible-Implementations":{"type":"topic","kind":"article","title":"CustomStringConvertible Implementations","role":"collectionGroup","url":"\/documentation\/traversal\/edgedepthfirstsearchevent\/customstringconvertible-implementations","abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/CustomStringConvertible-Implementations"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearchEvent/finish(_:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"finish","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/traversal\/edgedepthfirstsearchevent\/finish(_:)","abstract":[],"title":"EdgeDepthFirstSearchEvent.finish(_:)","kind