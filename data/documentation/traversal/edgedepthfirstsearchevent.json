{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/edgedepthfirstsearchevent"]}],"metadata":{"symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearchEvent"}],"externalID":"s:9Traversal25EdgeDepthFirstSearchEventO","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/EdgeSearchEvents.swift#L37","fileName":"EdgeSearchEvents.swift"},"modules":[{"name":"Traversal"}],"roleHeading":"Enumeration","navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearchEvent"}],"title":"EdgeDepthFirstSearchEvent","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent"},"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vertex is discovered, then its out-edges are reported, then it is finished. An edge to an"},{"type":"text","text":" "},{"type":"text","text":"undiscovered vertex is a tree edge, and the search continues from that vertex before the next"},{"type":"text","text":" "},{"type":"text","text":"edge. An edge to a vertex discovered but not yet finished is a back edge; a self-loop is one."},{"type":"text","text":" "},{"type":"text","text":"An edge to a finished vertex is a forward edge when that vertex was discovered later than the"},{"type":"text","text":" "},{"type":"text","text":"vertex being explored, and a cross edge otherwise."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a directed graph every out-edge of an explored vertex is reported. In an undirected graph"},{"type":"text","text":" "},{"type":"text","text":"each edge is reported once, from the end that reaches it first: the tree edge is not"},{"type":"text","text":" "},{"type":"text","text":"reported again from the vertex it discovered, but a parallel edge to the parent is a back edge,"},{"type":"text","text":" "},{"type":"text","text":"and a self-loop is one back edge. Without pruning or a depth limit an undirected search has"},{"type":"text","text":" "},{"type":"text","text":"only tree and back edges; an edge to a finished vertex whose edges were not explored is a"},{"type":"text","text":" "},{"type":"text","text":"forward or cross edge."}]}],"kind":"content"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/treeEdge(_:)"],"title":"Enumeration Cases","anchor":"Enumeration-Cases"},{"generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"What an edge depth-first search reports, in order: the events of "},{"type":"codeVoice","code":"DepthFirstSearchEvent"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"each edge given by its position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", so parallel edges are told apart."}],"references":{"doc://Traversal/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Traversal\/s8SendableP","title":"Swift.Sendable"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearchEvent/backEdge(_:)":{"kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearchevent\/backedge(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"backEdge"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":")"}],"title":"EdgeDepthFirstSearchEvent.backEdge(_:)","abstract":[],"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/backEdge(_:)","role":"symbol"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearchEvent/Equatable-Implementations":{"url":"\/documentation\/traversal\/edgedepthfirstsearchevent\/equatable-implementations","ty