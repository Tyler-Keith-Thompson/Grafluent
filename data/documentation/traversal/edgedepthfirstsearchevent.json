{"variants":[{"paths":["\/documentation\/traversal\/edgedepthfirstsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"remoteSource":{"fileName":"EdgeSearchEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/EdgeSearchEvents.swift#L37"},"modules":[{"name":"Traversal"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}],"role":"symbol","title":"EdgeDepthFirstSearchEvent","symbolKind":"enum","externalID":"s:9Traversal25EdgeDepthFirstSearchEventO","roleHeading":"Enumeration","navigatorTitle":[{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}]},"relationshipsSections":[{"identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vertex is discovered, then its out-edges are reported, then it is finished. An edge to an"},{"type":"text","text":" "},{"type":"text","text":"undiscovered vertex is a tree edge, and the search continues from that vertex before the next"},{"type":"text","text":" "},{"type":"text","text":"edge. An edge to a vertex discovered but not yet finished is a back edge; a self-loop is one."},{"type":"text","text":" "},{"type":"text","text":"An edge to a finished vertex is a forward edge when that vertex was discovered later than the"},{"type":"text","text":" "},{"type":"text","text":"vertex being explored, and a cross edge otherwise."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a directed graph every out-edge of an explored vertex is reported. In an undirected graph"},{"type":"text","text":" "},{"type":"text","text":"each edge is reported once, from the end that reaches it first: the tree edge is not"},{"type":"text","text":" "},{"type":"text","text":"reported again from the vertex it discovered, but a parallel edge to the parent is a back edge,"},{"type":"text","text":" "},{"type":"text","text":"and a self-loop is one back edge. Without pruning or a depth limit an undirected search has"},{"type":"text","text":" "},{"type":"text","text":"only tree and back edges; an edge to a finished vertex whose edges were not explored is a"},{"type":"text","text":" "},{"type":"text","text":"forward or cross edge."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"kind":"symbol","abstract":[{"text":"What an edge depth-first search reports, in order: the events of ","type":"text"},{"type":"codeVoice","code":"DepthFirstSearchEvent"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"each 