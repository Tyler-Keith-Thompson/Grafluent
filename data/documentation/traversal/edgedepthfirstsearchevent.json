{"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"metadata":{"role":"symbol","externalID":"s:9Traversal25EdgeDepthFirstSearchEventO","symbolKind":"enum","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/EdgeSearchEvents.swift#L37","fileName":"EdgeSearchEvents.swift"},"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearchEvent"}],"navigatorTitle":[{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}],"modules":[{"name":"Traversal"}],"title":"EdgeDepthFirstSearchEvent","roleHeading":"Enumeration"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A vertex is discovered, then its out-edges are reported, then it is finished. An edge to an"},{"type":"text","text":" "},{"type":"text","text":"undiscovered vertex is a tree edge, and the search continues from that vertex before the next"},{"type":"text","text":" "},{"type":"text","text":"edge. An edge to a vertex discovered but not yet finished is a back edge; a self-loop is one."},{"type":"text","text":" "},{"type":"text","text":"An edge to a finished vertex is a forward edge when that vertex was discovered later than the"},{"type":"text","text":" "},{"type":"text","text":"vertex being explored, and a cross edge otherwise."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In a directed graph every out-edge of an explored vertex is reported. In an undirected graph"},{"type":"text","text":" "},{"type":"text","text":"each edge is reported once, from the end that reaches it first: the tree edge is not"},{"type":"text","text":" "},{"type":"text","text":"reported again from the vertex it discovered, but a parallel edge to the parent is a back edge,"},{"type":"text","text":" "},{"type":"text","text":"and a self-loop is one back edge. Without pruning or a depth limit an undirected search has"},{"type":"text","text":" "},{"type":"text","text":"only tree and back edges; an edge to a finished vertex whose edges were not explored is a"},{"type":"text","text":" "},{"type":"text","text":"forward or cross edge."}],"type":"paragraph"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/edgedepthfirstsearchevent"]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"generated":true,"title":"Enumeration Cases","anchor":"Enumeration-Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\