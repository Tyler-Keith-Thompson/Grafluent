{"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/treeEdge(_:)"],"anchor":"Enumeration-Cases","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true}],"abstract":[{"text":"What an edge depth-first search reports, in order: the events of ","type":"text"},{"code":"DepthFirstSearchEvent","type":"codeVoice"},{"text":", with","type":"text"},{"text":" ","type":"text"},{"text":"each edge given by its position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", so parallel edges are told apart.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vertex is discovered, then its out-edges are reported, then it is finished. An edge to an"},{"type":"text","text":" "},{"type":"text","text":"undiscovered vertex is a tree edge, and the search continues from that vertex before the next"},{"type":"text","text":" "},{"type":"text","text":"edge. An edge to a vertex discovered but not yet finished is a back edge; a self-loop is one."},{"type":"text","text":" "},{"type":"text","text":"An edge to a finished vertex is a forward edge when that vertex was discovered later than the"},{"type":"text","text":" "},{"type":"text","text":"vertex being explored, and a cross edge otherwise."}]},{"type":"paragraph","inlineContent":[{"text":"In a directed graph every out-edge of an explored vertex is reported. In an undirected graph","type":"text"},{"text":" ","type":"text"},{"text":"each edge is reported once, from the end that reaches it first: the tree edge is not","type":"text"},{"text":" ","type":"text"},{"text":"reported again from the vertex it discovered, but a parallel edge to the parent is a back edge,","type":"text"},{"text":" ","type":"text"},{"text":"and a self-loop is one back edge. Without pruning or a depth limit an undirected search has","type":"text"},{"text":" ","type":"text"},{"text":"only tree and back edges; an edge to a finished vertex whose edges were not explored is a","type":"text"},{"text":" ","type":"text"},{"text":"forward or cross edge.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/edgedepthfirstsearchevent"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"],"kind":"relationships"}],"metadata":{"externalID":"s:9Traversal25EdgeDepthFirstSearchEventO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}],"roleHeading":"Enumeration","remoteSource":{"fileName":"EdgeSearchEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/EdgeSearchEvents.swift#L37"},"navigatorTitle":[{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}],"modules":[{"name":"Traversal"}],"title":"EdgeDepthFirstSearchEvent","role":"symbol","symbolKind":"enum"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent"},"references":{"doc://Traversal/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/Traversal\/SQ"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearchEvent/forwardEdge(_:)":{"kind":"symbol","title":"EdgeDepthFirstSearchEvent.forwardEdge(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"forwardEdge"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/forwardEdge(_:)","url":"\/documentation\/traversal\/edgedepthfirstsearchevent\/forwardedge(_:)","abstract":[],"type":"topic"},"doc://Traversal/s23CustomStringConvertibleP":{"title":"Swift.CustomStringConvertible","type":"unresolvable","identifier":"doc:\/\/Traversal\/s23CustomStringConvertibleP"},"doc://Traversal/