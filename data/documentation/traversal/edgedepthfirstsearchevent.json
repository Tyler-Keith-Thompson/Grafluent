{"metadata":{"roleHeading":"Enumeration","title":"EdgeDepthFirstSearchEvent","externalID":"s:9Traversal25EdgeDepthFirstSearchEventO","role":"symbol","symbolKind":"enum","navigatorTitle":[{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}],"remoteSource":{"fileName":"EdgeSearchEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/EdgeSearchEvents.swift#L37"},"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"}],"modules":[{"name":"Traversal"}]},"abstract":[{"type":"text","text":"What an edge depth-first search reports, in order: the events of "},{"type":"codeVoice","code":"DepthFirstSearchEvent"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"each edge given by its position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", so parallel edges are told apart."}],"topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/treeEdge(_:)"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/Equatable-Implementations"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A vertex is discovered, then its out-edges are reported, then it is finished. An edge to an","type":"text"},{"text":" ","type":"text"},{"text":"undiscovered vertex is a tree edge, and the search continues from that vertex before the next","type":"text"},{"text":" ","type":"text"},{"text":"edge. An edge to a vertex discovered but not yet finished is a back edge; a self-loop is one.","type":"text"},{"text":" ","type":"text"},{"text":"An edge to a finished vertex is a forward edge when that vertex was discovered later than the","type":"text"},{"text":" ","type":"text"},{"text":"vertex being explored, and a cross edge otherwise.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a directed graph every out-edge of an explored vertex is reported. In an undirected graph"},{"type":"text","text":" "},{"type":"text","text":"each edge is reported once, from the end that reaches it first: the tree edge is not"},{"type":"text","text":" "},{"type":"text","text":"reported again from the vertex it discovered, but a parallel edge to the parent is a back edge,"},{"type":"text","text":" "},{"type":"text","text":"and a self-loop is one back edge. Without pruning or a depth limit an undirected search has"},{"type":"text","text":" "},{"type":"text","text":"only tree and back edges; an edge to a finished vertex whose edges were not explored is a"},{"type":"text","text":" "},{"type":"text","text":"forward or cross edge."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/traversal\/edgedepthfirstsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"references":{"doc://Traversal/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Traversal\/s8SendableP"},"doc://Traversal/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/Traversal\/s8CopyableP","title":"Swift.Copyable"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearchEvent/discover(_:)":{"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent\/discover(_:)","kind":"symbol","abstract":[],"role":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearchevent\/discover(_:)","title":"EdgeDepthFirstSearchEvent.discover(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"discover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearc