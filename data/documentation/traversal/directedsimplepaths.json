{"metadata":{"roleHeading":"Structure","title":"DirectedSimplePaths","externalID":"s:9Traversal19DirectedSimplePathsV","symbolKind":"struct","role":"symbol","navigatorTitle":[{"text":"DirectedSimplePaths","kind":"identifier"}],"remoteSource":{"fileName":"SimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SimplePaths.swift#L222"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimplePaths","kind":"identifier"}],"modules":[{"name":"Traversal"}]},"abstract":[{"text":"Every simple path of a directed graph from a source to any of a set of targets, lazily, in the","type":"text"},{"text":" ","type":"text"},{"text":"order a depth-first search from the source, taking out-edges in ","type":"text"},{"type":"codeVoice","code":"outEdges"},{"text":" order, reaches them.","type":"text"}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Iterator"],"generated":true,"anchor":"Structures"},{"title":"Instance Properties","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/maxLength"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/makeIterator()"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Aliases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Element"],"generated":true,"anchor":"Type-Aliases"},{"title":"Default Implementations","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Sequence-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","kind":"r