type":"text","text":" "},{"type":"text","text":"so the time between two paths is not bounded by a polynomial in n + m."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","references":{"doc://Traversal/documentation/Traversal/DirectedSimplePaths/Element":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Element","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"abstract":[],"type":"topic","title":"DirectedSimplePaths.Element","navigatorTitle":[{"kind":"identifier","text":"Element"}],"kind":"symbol","url":"\/documentation\/traversal\/directedsimplepaths\/element"},"doc://Traversal/ST":{"identifier":"doc:\/\/Traversal\/ST","title":"Swift.Sequence","type":"unresolvable"},"doc://Traversal/s16SendableMetatypeP":{"identifier":"doc:\/\/Traversal\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Traversal/s8SendableP":{"identifier":"doc:\/\/Traversal\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Traversal/documentation/Traversal/DirectedSimplePaths/Sequence-Implementations":{"title":"Sequence Implementations","kind":"article","abstract":[],"role":"collectionGroup","url":"\/documentation\/traversal\/directedsimplepaths\/sequence-implementations","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Sequence-Implementations","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"type":"topic","title":"DirectedGraph","navigatorTitle":[{"tex