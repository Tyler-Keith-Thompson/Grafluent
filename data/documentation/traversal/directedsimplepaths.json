ericParameter","text":"G"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"typeIdentifier","text":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each copy of a parallel edge gives a different path. A path reaching one target continues to"},{"type":"text","text":" "},{"type":"text","text":"the others, so a path through a target to another is listed after the shorter one. The source"},{"type":"text","text":" "},{"type":"text","text":"itself, when it is a target, gives the trivial path first."}]},{"type":"paragraph","inlineContent":[{"text":"The sequence holds the graph (a value), so iterating again gives the same paths. The first","type":"text"},{"text":" ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" copies the rows the source reaches, O(n + m). A vertex that reaches no target is never","type":"text"},{"text":" ","type":"text"},{"text":"entered, but a partial path can still end where every way on is blocked by its own vertices,","type":"text"},{"text":" ","type":"text"},{"text":"so the time between two paths is not bounded by a polynomial in n + m.","type":"text"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/traversal\/directedsimplepaths"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Every simple path of a directed graph from a source to any of a set of targets, lazily, in the"},{"type":"text","text":" "}