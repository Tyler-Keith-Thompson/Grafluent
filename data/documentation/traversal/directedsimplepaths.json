{"metadata":{"roleHeading":"Structure","externalID":"s:9Traversal19DirectedSimplePathsV","modules":[{"name":"Traversal"}],"title":"DirectedSimplePaths","symbolKind":"struct","remoteSource":{"fileName":"SimplePaths.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SimplePaths.swift#L222"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimplePaths","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedSimplePaths"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/directedsimplepaths"]}],"sections":[],"abstract":[{"type":"text","text":"Every simple path of a directed graph from a source to any of a set of targets, lazily, in the"},{"type":"text","text":" "},{"type":"text","text":"order a depth-first search from the source, taking out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, reaches them."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimplePaths","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","text":"DirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Each copy of a parallel edge gives a different path. A path reaching one target continues to","type":"text"},{"text":" ","type":"text"},{"text":"the others, so a path through a target to another is listed after the shorter one. The source","type":"text"},{"text":" ","type":"text"},{"text":"itself, when it is a target, gives the trivial path first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The sequence holds the graph (a value), so iterating again gives the same paths. The first","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" copies the rows the source reaches, O(n + m). A vertex that reaches no target is never","type":"text"},{"text":" ","type":"text"},{"text":"entered, but a partial path can still end where every way on is blocked by its own vertices,","type":"text"},{"text":" ","type":"text"},{"text":"so the time between two paths is not bounded by a polynomial in n + m.","type":"text"}],"type":"paragraph"}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Iterator"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/maxLength"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/makeIterator()"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Element"],"anchor":"Type-Aliases","title":"Type Aliases"},{"generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths\/Sequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"kin