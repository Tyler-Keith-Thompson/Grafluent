oop, with two ends there, is twice as","type":"text"},{"text":" ","type":"text"},{"text":"likely as another edge, and each copy of a parallel edge is on its own), or with the","type":"text"},{"text":" ","type":"text"},{"text":"node2vec bias of Grover and Leskovec when ","type":"text"},{"code":"returnParameter","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"inOutParameter","type":"codeVoice"},{"text":" is not 1:","type":"text"},{"text":" ","type":"text"},{"text":"after the first step, an edge back to the previous vertex is weighted 1\/p, an edge to a","type":"text"},{"text":" ","type":"text"},{"text":"neighbor of the previous vertex 1, and any other 1\/q.","type":"text"}],"kind":"symbol"},"doc://Traversal/documentation/Traversal/GraphProtocols/Graph/lexicographicBreadthFirstSearch()":{"url":"\/documentation\/traversal\/graphprotocols\/graph\/lexicographicbreadthfirstsearch()","kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols\/Graph\/lexicographicBreadthFirstSearch()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicBreadthFirstSearch"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"title":"lexicographicBreadthFirstSearch()","type":"topic","abstract":[{"type":"text","text":"Every vertex in an order a lexicographic breadth-first search (LexBFS; Rose, Tarjan and"},{"type":"text","text":" "},{"type":"text","text":"Lueker) can visit them, starting at the first vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. A vertex’s label"},{"type":"text","text":" "},{"type":"text","text":"is the visit positions of its visited neighbors, in increasing order; each next vertex has"},{"type":"text","text":" "},{"type":"text","text":"a greatest label