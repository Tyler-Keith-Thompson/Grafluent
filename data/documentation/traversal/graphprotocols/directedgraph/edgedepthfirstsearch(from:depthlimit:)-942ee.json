,"text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/traversal\/graphprotocols\/directedgraph\/edgedepthfirstsearch(from:depthlimit:)-942ee","abstract":[{"code":"lazy.edgeDepthFirstSearch(from:depthLimit:)","type":"codeVoice"},{"text":".","type":"text"}],"title":"edgeDepthFirstSearch(from:depthLimit:)","kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols\/DirectedGraph\/edgeDepthFirstSearch(from:depthLimit:)-942ee","type":"topic","role":"symbol"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"abstract":[{"text":"A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"text":"s, in the order ","type":"text"},{"code":"DepthFirstSearch","type":"codeVoice"},{"text":" reports them, with every edge","type":"text"},{"type":"text","text":" "},{"type":"text","text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated"},{"type":"text","text":" "},{"type":"text","text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be"},{"type":"text","text":" "},{"type":"text","text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the"},{"type":"text","text":" "},{"type":"text","text":"call stack."}],"kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","title":"EdgeDepthFirstSearch","role":"symbol","type":"topic"},"doc://Traversal/documentation/Traversal":{"kind":"symbol","abstract":[],"title":"Traversal","identifier":"doc:\/\/Traversal\/documentation\/Traversal","role":"collection","url":"\/