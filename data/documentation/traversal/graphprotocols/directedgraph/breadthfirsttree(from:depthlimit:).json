 so "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" lists the tree edges in the"},{"type":"text","text":" "},{"type":"text","text":"order "},{"code":"breadthFirstSearch(from:)","type":"codeVoice"},{"type":"text","text":" reports them. O(n + m) over the reached part; the"},{"type":"text","text":" "},{"type":"text","text":"vertices are hashed once, into the arborescence’s lookup table, unless they come out as"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<k","type":"codeVoice"},{"type":"text","text":" in order."}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" is a vertex; "},{"type":"codeVoice","code":"depthLimit"},{"type":"text","text":" is not negative."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal","doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols","doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols\/DirectedGraph"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"Traversal"}],"roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"breadthFirstTree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"depthLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Arborescence","preciseIdentifier":"s:5Trees12ArborescenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">"}],"externalID":"s:14GraphProtocols08DirectedA0P9TraversalE16breadthFirstTree4from10depthLimit5Trees12ArborescenceVy6VertexQzGAL_SiSgtF","title":"breadthFirstTree(from:depthLimit:)","extendedModule":"GraphProtocols"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols\/DirectedGraph\/breadthFirstTree(from:depthLimit:)"},"kind":"symbol","abstract":[{"type":"text","text":"The breadth-first search tree from "},{"type":"codeVoice","code":"source"},{"type":"text","text":", as an arborescence rooted there: every vertex"},{"type":"text","text":" "},{"type":"text","text":"the search reaches, each with the vertex it was discovered from as parent. Each parent is a"},{"type":"text","text":" "},{"type":"text","text":"vertex one edge closer to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", so a tree path is a shortest path by edge count."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/graphprotocols\/directedgraph\/breadthfirsttree(from:depthlimit:)"]}],"sections":[],"references":{"doc://Traversal/documentation/Traversal":{"kind":"symbol","url":"\/documentation\/traversal","title":"Traversal","abstract":[],"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal","role":"collection"},"doc://Traversal/documentation/Traversal/GraphProtocols":{"type":"topic","title":"GraphProtocols","kind":"symbol","abstract":[],"url":"\/documentation\/traversal\/graphprotocols","role":"collection","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","role":"symbol","navigatorTitle":[{"kind":"identifier","text