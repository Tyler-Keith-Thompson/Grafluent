 to the vertex at offset k + 1, so "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists the tree edges in the"},{"type":"text","text":" "},{"type":"text","text":"order "},{"type":"codeVoice","code":"lazy.breadthFirstSearch(from:)"},{"type":"text","text":" reports them. O(n + m) over the reached part; the"},{"type":"text","text":" "},{"type":"text","text":"vertices are hashed once, into the arborescence’s lookup table, unless they come out as"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" is a vertex; "},{"code":"depthLimit","type":"codeVoice"},{"type":"text","text":" is not negative."}],"type":"paragraph"}],"type":"aside"}]}],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols\/DirectedGraph\/breadthFirstTree(from:depthLimit:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"remoteSource":{"fileName":"SearchTrees.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SearchTrees.swift#L19"},"modules":[{"name":"Traversal","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols08DirectedA0P9TraversalE16breadthFirstTree4from10depthLimit5Trees12ArborescenceVy6VertexQzGAL_SiSgtF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"breadthFirstTree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":