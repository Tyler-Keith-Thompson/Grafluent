","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" is a vertex; "},{"code":"depthLimit","type":"codeVoice"},{"type":"text","text":" is not negative."}],"type":"paragraph"}],"type":"aside"}]}],"abstract":[{"type":"text","text":"The breadth-first search tree from "},{"type":"codeVoice","code":"source"},{"type":"text","text":", as an arborescence rooted there: every vertex"},{"type":"text","text":" "},{"type":"text","text":"the search reaches, each with the vertex it was discovered from as parent. Each parent is a"},{"type":"text","text":" "},{"type":"text","text":"vertex one edge closer to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", so a tree path is a shortest path by edge count."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal","doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols","doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols\/DirectedGraph"]]},"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols\/DirectedGraph\/breadthFirstTree(from:depthLimit:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/traversal\/graphprotocols\/directedgraph\/breadthfirsttree(from:depthlimit:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"title":"Vertex","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/Grap