:{"navigatorTitle":[{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}],"title":"UndirectedEdgeDepthFirstSearch","abstract":[{"type":"text","text":"The edge depth-first search of an undirected graph: a sequence of "},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"that reports each edge once, by its position, from the end that reaches it first. The tree"},{"type":"text","text":" "},{"type":"text","text":"edge into a vertex is not reported again from it, so a parallel edge to the parent is a back"},{"type":"text","text":" "},{"type":"text","text":"edge. It holds a copy of the graph and can be iterated more than once, and keeps its own stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch","url":"\/documentation\/traversal\/undirectededgedepthfirstsearch"},"doc://Traversal/documentation/Traversal":{"abstract":[],"identifier":"doc:\/\/Traversal\/documentation\/Traversal","type":"topic","title":"Traversal","kind":"symbol","url":"\/documentation\/traversal","role":"collection"}}}