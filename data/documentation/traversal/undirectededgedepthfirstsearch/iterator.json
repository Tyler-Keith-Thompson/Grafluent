le":[{"text":"UndirectedEdgeDepthFirstSearch","kind":"identifier"}],"title":"UndirectedEdgeDepthFirstSearch","url":"\/documentation\/traversal\/undirectededgedepthfirstsearch","abstract":[{"text":"The edge depth-first search of an undirected graph: a sequence of ","type":"text"},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"that reports each edge once, by its position, from the end that reaches it first. The tree","type":"text"},{"text":" ","type":"text"},{"text":"edge into a vertex is not reported again from it, so a parallel edge to the parent is a back","type":"text"},{"text":" ","type":"text"},{"text":"edge. It holds a copy of the graph and can be iterated more than once, and keeps its own stack.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdgeDepthFirstSearch","kind":"identifier"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch","kind":"symbol","type":"topic"},"doc://Traversal/St":{"title":"Swift.IteratorProtocol","identifier":"doc:\/\/Traversal\/St","type":"unresolvable"},"doc://Traversal/documentation/Traversal/UndirectedEdgeDepthFirstSearch/Iterator/prune()":{"type":"topic","url":"\/documentation\/traversal\/undirectededgedepthfirstsearch\/iterator\/prune()","kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch\/Iterator\/prune()","role":"symbol","abstract":[{"type":"text","text":"Skips the edges of the vertex just discovered; it is still finished, and its edges to"},{"type":"text","text":" "},{"type":"text","text":"vertices explored later are reported from their other ends."}],"title":"prune()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prune","kind":"identifier"},{"text":"()","kind":"text"}]}}}