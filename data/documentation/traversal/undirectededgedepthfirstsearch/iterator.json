ent"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"that reports each edge once, by its position, from the end that reaches it first. The tree"},{"type":"text","text":" "},{"type":"text","text":"edge into a vertex is not reported again from it, so a parallel edge to the parent is a back"},{"type":"text","text":" "},{"type":"text","text":"edge. It holds a copy of the graph and can be iterated more than once, and keeps its own stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}],"url":"\/documentation\/traversal\/undirectededgedepthfirstsearch","title":"UndirectedEdgeDepthFirstSearch","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}]},"doc://Traversal/St":{"type":"unresolvable","identifier":"doc:\/\/Traversal\/St","title":"Swift.IteratorProtocol"},"doc://Traversal/documentation/Traversal/UndirectedEdgeDepthFirstSearch/Iterator/prune()":{"url":"\/documentation\/traversal\/undirectededgedepthfirstsearch\/iterator\/prune()","type":"topic","abstract":[{"type":"text","text":"Skips the edges of the vertex just discovered; it is still finished, and its edges to"},{"type":"text","text":" "},{"type":"text","text":"vertices explored later are reported from their other ends."}],"kind":"symbol","title":"prune()","role":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch\/Iterator\/prune()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"prune","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://Traversal/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Traversal\/s8SendableP"}}}