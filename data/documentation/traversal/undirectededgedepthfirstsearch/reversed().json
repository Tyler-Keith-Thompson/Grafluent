"The edge depth-first search of an undirected graph: a sequence of ","type":"text"},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"that reports each edge once, by its position, from the end that reaches it first. The tree","type":"text"},{"text":" ","type":"text"},{"text":"edge into a vertex is not reported again from it, so a parallel edge to the parent is a back","type":"text"},{"text":" ","type":"text"},{"text":"edge. It holds a copy of the graph and can be iterated more than once, and keeps its own stack.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdgeDepthFirstSearch","kind":"identifier"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch","kind":"symbol","type":"topic"},"doc://Traversal/documentation/Traversal/UndirectedEdgeDepthFirstSearch/reversed()":{"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch\/reversed()","title":"reversed()","role":"symbol","url":"\/documentation\/traversal\/undirectededgedepthfirstsearch\/reversed()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reversed"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":"]"}],"kind":"symbol","abstract":[]},"doc://Traversal/documentation/Traversal":{"url":"\/documentation\/traversal","abstract":[],"kind":"symbol","title":"Traversal","role":"collection","type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal"}}}