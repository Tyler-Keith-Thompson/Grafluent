{"kind":"symbol","abstract":[{"text":"What a depth-first search reports, in order, with the classification of CLRS §22.3.","type":"text"}],"topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/treeEdge(_:)"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/Equatable-Implementations"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchEvent"}],"modules":[{"name":"Traversal"}],"navigatorTitle":[{"text":"DepthFirstSearchEvent","kind":"identifier"}],"roleHeading":"Enumeration","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SearchEvents.swift#L25","fileName":"SearchEvents.swift"},"role":"symbol","title":"DepthFirstSearchEvent","externalID":"s:9Traversal21DepthFirstSearchEventO"},"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchE