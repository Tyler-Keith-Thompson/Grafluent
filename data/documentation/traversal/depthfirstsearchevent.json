{"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Enumeration","role":"symbol","modules":[{"name":"Traversal"}],"symbolKind":"enum","title":"DepthFirstSearchEvent","externalID":"s:9Traversal21DepthFirstSearchEventO","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SearchEvents.swift#L25","fileName":"SearchEvents.swift"},"navigatorTitle":[{"kind":"identifier","text":"DepthFirstSearchEvent"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchEvent"}]},"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/treeEdge(_:)"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/Equatable-Implementations"],"generated":true}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc: