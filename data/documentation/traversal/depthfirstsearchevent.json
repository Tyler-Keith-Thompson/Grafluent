{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchEvent"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SearchEvents.swift#L25","fileName":"SearchEvents.swift"},"title":"DepthFirstSearchEvent","externalID":"s:9Traversal21DepthFirstSearchEventO","roleHeading":"Enumeration","modules":[{"name":"Traversal"}],"role":"symbol","symbolKind":"enum","navigatorTitle":[{"text":"DepthFirstSearchEvent","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"topicSections":[{"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/treeEdge(_:)"],"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"abstract":[{"type":"text","text":"What a depth-first search reports, in order, with the classification of CLRS §22.3."}],"variants":[{"paths":["\/documentation\/traversal\/depthfirstsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DepthFirstSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vertex is discovered, then every edge out of it is reported once per copy, then it is"},{"type":"text","text":" "},{"type":"text","text":"finished. An edge to an undiscovered vertex is a tree edge, and the search continues from that"},{"type":"text","text":" "},{"type":"text","text":"vertex before the next edge. An edge to a vertex discovered but not yet finished is a back"},{"type":"text","text":" "},{"type":"text","text":"edge; a self-loop is one. An edge to a finished vertex is a forward edge when that vertex was"},{"type":"text","text":" "},{"type":"text","text":"discovered later than the edge’s source (a descendant; a repeated tree edge is one), and a cross"},{"type":"text","text":" "},{"type":"text","text":"edge otherwise."}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://Traversal/s23CustomStringConvertibleP":{"identifier":"doc:\/\/Traversal\/s23CustomStringConvertibleP","title":"Swift.CustomStringConve