text"},{"text":" ","type":"text"},{"text":"vertex before the next edge. An edge to a vertex discovered but not yet finished is a back","type":"text"},{"text":" ","type":"text"},{"text":"edge; a self-loop is one. An edge to a finished vertex is a forward edge when that vertex was","type":"text"},{"text":" ","type":"text"},{"text":"discovered later than the edge’s source (a descendant; a repeated tree edge is one), and a cross","type":"text"},{"text":" ","type":"text"},{"text":"edge otherwise.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/traversal\/depthfirstsearchevent"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"abstract":[{"type":"text","text":"What a depth-first search reports, in order, with the classification of CLRS §22.3."}],"kind":"symbol","topicSections":[{"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/treeEdge(_:)"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/Equatable-Implementations"]}],"references":{"doc://Traversal/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/Traversal\/SQ","type":"unresolvable"},"doc://Traversal/documentation/Tr