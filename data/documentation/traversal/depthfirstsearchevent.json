" ","type":"text"},{"text":"finished. An edge to an undiscovered vertex is a tree edge, and the search continues from that","type":"text"},{"text":" ","type":"text"},{"text":"vertex before the next edge. An edge to a vertex discovered but not yet finished is a back","type":"text"},{"text":" ","type":"text"},{"text":"edge; a self-loop is one. An edge to a finished vertex is a forward edge when that vertex was","type":"text"},{"text":" ","type":"text"},{"text":"discovered later than the edge’s source (a descendant; a repeated tree edge is one), and a cross","type":"text"},{"text":" ","type":"text"},{"text":"edge otherwise.","type":"text"}]}],"kind":"content"}],"sections":[],"kind":"symbol","metadata":{"symbolKind":"enum","modules":[{"name":"Traversal"}],"title":"DepthFirstSearchEvent","navigatorTitle":[{"text":"DepthFirstSearchEvent","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchEvent"}],"externalID":"s:9Traversal21DepthFirstSearchEventO","role":"symbol","roleHeading":"Enumeration","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SearchEvents.swift#L25","fileName":"SearchEvents.swift"}},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"],"kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent"},"abstract":[{"type":"text","text":"What a depth-first search reports, in order, with the classification of CLRS §22.3."}],"references":{"doc://Traversal/documentation/Traversal/DepthFirstSearchEvent/Equatable-Implementations":{"url":"\/documentation\/traversal\/depthfirstsearc