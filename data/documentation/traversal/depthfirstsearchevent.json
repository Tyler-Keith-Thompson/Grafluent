{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DepthFirstSearchEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A vertex is discovered, then every edge out of it is reported once per copy, then it is","type":"text"},{"text":" ","type":"text"},{"text":"finished. An edge to an undiscovered vertex is a tree edge, and the search continues from that","type":"text"},{"text":" ","type":"text"},{"text":"vertex before the next edge. An edge to a vertex discovered but not yet finished is a back","type":"text"},{"text":" ","type":"text"},{"text":"edge; a self-loop is one. An edge to a finished vertex is a forward edge when that vertex was","type":"text"},{"text":" ","type":"text"},{"text":"discovered later than the edge’s source (a descendant; a repeated tree edge is one), and a cross","type":"text"},{"text":" ","type":"text"},{"text":"edge otherwise.","type":"text"}]}]}],"topicSections":[{"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/finish(_:)","doc: