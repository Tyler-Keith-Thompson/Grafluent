{"hierarchy":{"paths":[["doc:\/\/Traversal\/documentation\/Traversal"]]},"sections":[],"kind":"symbol","relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"metadata":{"roleHeading":"Enumeration","symbolKind":"enum","navigatorTitle":[{"text":"DepthFirstSearchEvent","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchEvent"}],"externalID":"s:9Traversal21DepthFirstSearchEventO","remoteSource":{"fileName":"SearchEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SearchEvents.swift#L25"},"role":"symbol","modules":[{"name":"Traversal"}],"title":"DepthFirstSearchEvent"},"abstract":[{"type":"text","text":"What a depth-first search reports, in order, with the classification of CLRS §22.3."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A vertex is discovered, then every edge out of it is reported once per copy, then it is"},{"type":"text","text":" "},{"type":"text","text":"finished. An edge to