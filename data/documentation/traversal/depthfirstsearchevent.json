{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DepthFirstSearchEvent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A vertex is discovered, then every edge out of it is reported once per copy, then it is","type":"text"},{"text":" ","type":"text"},{"text":"finished. An edge to an undiscovered vertex is a tree edge, and the search continues from that","type":"text"},{"text":" ","type":"text"},{"text":"vertex before the next edge. An edge to a vertex discovered but not yet finished is a back","type":"text"},{"text":" ","type":"text"},{"text":"edge; a self-loop is one. An edge to a finished vertex is a forward edge when that vertex was","type":"text"},{"text":" ","type":"text"},{"text":"discovered later than the edge’s source (a descendant; a repeated tree edge is one), and a cross","type":"text"},{"text":" ","type":"text"},{"text":"edge otherwise.","type":"text"}]}]}],"kind":"symbol","topicSections":[{"generated":true,"anchor":"Enumeration-Cases","identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEve