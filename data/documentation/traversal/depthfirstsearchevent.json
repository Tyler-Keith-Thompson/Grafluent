{"abstract":[{"text":"What a depth-first search reports, in order, with the classification of CLRS §22.3.","type":"text"}],"metadata":{"externalID":"s:9Traversal21DepthFirstSearchEventO","modules":[{"name":"Traversal"}],"title":"DepthFirstSearchEvent","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DepthFirstSearchEvent","kind":"identifier"}],"navigatorTitle":[{"text":"DepthFirstSearchEvent","kind":"identifier"}],"roleHeading":"Enumeration","symbolKind":"enum","remoteSource":{"fileName":"SearchEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Traversal\/SearchEvents.swift#L25"}},"topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/backEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/crossEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/discover(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/finish(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/forwardEdge(_:)","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/treeEdge(_:)"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/CustomStringConvertible-Implementations","doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent\/Equatable-Implementations"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Traversal\/s8CopyableP","doc:\/\/Traversal\/s23CustomStringConvertibleP","doc:\/\/Traversal\/SQ","doc:\/\/Traversal\/s9EscapableP","doc:\/\/Traversal\/SH","doc:\/\/Traversal\/s8SendableP","doc:\/\/Traversal\/s16SendableMetatypeP"]}],"sections":[],"primaryContentSections":[{"declara