\/Multigraphs\/documentation\/Multigraphs\/DirectedMultigraph\/undirectedView"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://Multigraphs/documentation/Multigraphs/DirectedMultigraph":{"role":"symbol","type":"topic","title":"DirectedMultigraph","url":"\/documentation\/multigraphs\/directedmultigraph","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedMultigraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedMultigraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedMultigraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph with parallel edges and no self-loops (JGraphT’s "},{"type":"codeVoice","code":"DirectedMultigraph"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Inserting an edge always adds a copy, and each copy has its own position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"type":"text","text":"its identity. Opposite edges, "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v→u"},{"type":"text","text":", are allowed."}],"kind":"symbol"},"doc://Multigraphs/documentation/Multigraphs/DirectedMultigraph/undirectedView":{"title":"undirectedView","url":"\/documentation\/multigraphs\/directedmultigraph\/undirectedview","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedMultigraph\/undirectedView","type":"topic","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"undirectedView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols14UndirectedViewV","text":"UndirectedView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"text":">","kind":"text"}]},"doc://Multigraphs/documentation/Multigraphs":{"role":"collection","type":"topic","title":"Multigraphs","url":"\/documentation\/multigraphs","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs","abstract":[],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","kind":"symbol","abstract":[{"type":"text","text":"A bidirectional directed graph read as an undirected graph: each arc "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" is the edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" at the arc’s position, so "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" is "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" then "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"degree"},{"type":"text","text":" is the base’s. Two opposite arcs are two parallel edges."}],"navigatorTitle":[{"text":"UndirectedView","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedView","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/undirectedview","title":"UndirectedView","type":"topic"}}}