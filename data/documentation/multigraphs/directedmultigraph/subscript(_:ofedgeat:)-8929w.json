cumentation\/Multigraphs\/DirectedMultigraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedMultigraph","kind":"identifier"}],"abstract":[{"text":"A directed graph with parallel edges and no self-loops (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"DirectedMultigraph"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Inserting an edge always adds a copy, and each copy has its own position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", which is","type":"text"},{"text":" ","type":"text"},{"text":"its identity. Opposite edges, ","type":"text"},{"type":"codeVoice","code":"u→v"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"v→u"},{"text":", are allowed.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"abstract":[{"type":"text","text":"A handle to a map from edge positions to "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" attached to a graph (LEMON’s "},{"type":"codeVoice","code":"ArcMap"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"returned by "},{"type":"codeVoice","code":"PropertyGraph.addEdgeMap(default:)"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"type":"codeVoice","code":"graph[handle, ofEdgeAt: position]"},{"type":"text","text":". It is valid on the graph that added it"},{"type":"text","text":" "},{"type":"text","text":"and on every copy of that graph, until "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":"; on another graph it traps."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeMap"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeMap"}],"url":"\/documentation\/graphprotocols\/edgemap","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","type":"topic",