Map(default:)"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"type":"codeVoice","code":"graph[handle, ofEdgeAt: position]"},{"type":"text","text":". It is valid on the graph that added it"},{"type":"text","text":" "},{"type":"text","text":"and on every copy of that graph, until "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":"; on another graph it traps."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeMap"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeMap"}],"url":"\/documentation\/graphprotocols\/edgemap","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","type":"topic","title":"EdgeMap","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeValues":{"navigatorTitle":[{"text":"EdgeValues","kind":"identifier"}],"title":"EdgeValues","url":"\/documentation\/graphprotocols\/edgevalues","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeValues","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeValues","kind":"identifier"}],"abstract":[{"type":"text","text":"A snapshot of an edge map’s values, read by edge position like an array: what"},{"type":"text","text":" "},{"code":"PropertyGraph.values(of:)","type":"codeVoice"},{"type":"text","text":" returns, after "},{"code":"Dictionary.Values","type":"codeVoice"},{"type":"text","text":". It holds the map’s storage, not"},{"type":"text","text":" "},{"type":"text","text":"the graph, so later mutations of the graph or the map do not show through."}]}}}