eration":{"title":"GraphGeneration","url":"\/documentation\/graphprotocols\/graphgeneration","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration","type":"topic","abstract":[{"type":"text","text":"A graph’s generation: which state of which graph it is. Every structural mutation (an"},{"type":"text","text":" "},{"type":"text","text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and"},{"type":"text","text":" "},{"type":"text","text":"writing attached map values do not. A structure derived from a graph stores the graph’s"},{"type":"text","text":" "},{"code":"generation","type":"codeVoice"},{"type":"text","text":" and asks "},{"code":"isCurrent(for:)","type":"codeVoice"},{"type":"text","text":" before it relies on the graph again."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"navigatorTitle":[{"text":"GraphGeneration","kind":"identifier"}]},"doc://Multigraphs/documentation/Multigraphs":{"role":"collection","type":"topic","title":"Multigraphs","url":"\/documentation\/multigraphs","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs","abstract":[],"kind":"symbol"},"doc://Multigraphs/documentation/Multigraphs/DirectedMultigraph/generation":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedMultigraph\/generation","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"generation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14GraphProtocols0A10GenerationV","kind":"typeIdentifier","text":"GraphGeneration"}],"abstract":[],"url":"\/documentation\/multigraphs\/directedmultigraph\/generation","title":"generation"},"doc://Multigraphs/documentation/Multigraphs/DirectedMultigraph":{"role":"symbol","type":"topic","title":"DirectedMultigraph","url":"\/documentation\/multi