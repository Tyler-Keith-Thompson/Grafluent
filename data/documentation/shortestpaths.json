ord","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BellmanFordEvent"}],"navigatorTitle":[{"kind":"identifier","text":"BellmanFordEvent"}]},"doc://ShortestPaths/documentation/ShortestPaths/BellmanFordSearch":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/BellmanFordSearch","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BellmanFordSearch","kind":"identifier"}],"navigatorTitle":[{"text":"BellmanFordSearch","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Bellman–Ford as a sequence of ","type":"text"},{"type":"codeVoice","code":"BellmanFordEvent"},{"text":"s, pulled one at a time. It holds a copy of","type":"text"},{"text":" ","type":"text"},{"text":"the graph and the weight closure, so later changes to the original do not affect it, and it","type":"text"},{"text":" ","type":"text"},{"text":"can be iterated more than once. The rounds, relaxations and distances are those of","type":"text"},{"text":" ","type":"text"},{"code":"bellmanFordShortestPaths(from:weight:)","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","url":"\/documentation\/shortestpaths\/bellmanfordsearch","title":"BellmanFordSearch"},"doc://ShortestPaths/documentation/ShortestPaths/AllShortestPaths":{"url":"\/documentation\/shortestpaths\/allshortestpaths","kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AllShortestPaths","type":"topic","abstract":[{"type":"text","text":"Every shortest path from a source to a target, listed lazily from the shortest-path DAG: each"},{"type":"text","text":" "},{"type":"text","text":"path walks back from the target over tight in-edges, depth first, to the source."}],"title":"AllShortestPaths","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllShortestPaths","kind":"identifier"}],"navigatorTitle":[{"text":"AllShortestPaths","kind":"identifier"}]},"doc://ShortestPaths/docum