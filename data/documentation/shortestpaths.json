ate satisfying "},{"type":"codeVoice","code":"success"},{"type":"text","text":", by A* over a successor"},{"type":"text","text":" "},{"type":"text","text":"function, guided by "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":", an estimate of each state’s cost to the nearest goal. Returns as "},{"type":"codeVoice","code":"dijkstraShortestPath(from:cutoff: successors:success:)"},{"type":"text","text":" does, and calls "},{"type":"codeVoice","code":"heuristic"},{"type":"text","text":" once each time a state is queued."}]},"doc://ShortestPaths/documentation/ShortestPaths/ShortestPathTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestPathTree"}],"url":"\/documentation\/shortestpaths\/shortestpathtree","type":"topic","title":"ShortestPathTree","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ShortestPathTree","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ShortestPathTree"}],"abstract":[{"text":"Shortest paths from one or more sources: for each reached vertex, its distance, its parent and","type":"text"},{"text":" ","type":"text"},{"text":"the edge from the parent (a forest when there are several sources).","type":"text"}],"role":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/DirectedAcyclicGraphModule":{"type":"topic","role":"collection","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DirectedAcyclicGraphModule","abstract":[],"url":"\/documentation\/shortestpaths\/directedacyclicgraphmodule","title":"DirectedAcyclicGraphModule","kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/ShortestSimplePaths":{"navigatorTitle":[{"text":"ShortestSimplePaths","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/shortestsimplepaths","abstract":[{"type":"text","text":"The simple paths from a source to a target in order of length, shortest first, listed lazily"},{"type":"text","text":"