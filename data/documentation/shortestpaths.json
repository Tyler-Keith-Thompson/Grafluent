":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"ShortestPaths"}],"externalID":"ShortestPaths","role":"collection","symbolKind":"module","roleHeading":"Framework","title":"ShortestPaths"},"references":{"doc://ShortestPaths/documentation/ShortestPaths/ALTLandmarks":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ALTLandmarks","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Landmarks for A* search by the ALT method (Goldberg and Harrelson, “Computing the shortest"},{"type":"text","text":" "},{"type":"text","text":"path: A* search meets graph theory”, SODA 2005): a few vertices chosen far apart, the distance"},{"type":"text","text":" "},{"type":"text","text":"from and to each of them stored for every vertex, and each query an A* search whose estimate of"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s remaining distance is the largest lower bound the triangle inequality gives from"},{"type":"text","text":" "},{"type":"text","text":"any landmark, "},{"type":"codeVoice","code":"d(L, t) − d(L, v)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"d(v, L) − d(t, L)"},{"type":"text","text":"."}],"title":"ALTLandmarks","kind":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks","url":"\/documentation\/shortestpaths\/altlandmarks","role":"symbol","navigatorTitle":[{"text":"ALTLandmarks","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/ShortestSimplePaths":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShortestSimplePaths"}],"kind":"symbol","abstract":[{"type":"text","text":"The simple paths from a source to a target in order of length, shortest first, listed lazily"},{"type":"text","text":" "},{"type":"text","text":"by Yen’s algorithm with Lawler’s refinement."}],"title":"ShortestSimplePaths","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPat