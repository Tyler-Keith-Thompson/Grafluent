:"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/AllShortestPaths":{"abstract":[{"text":"Every shortest path from a source to a target, listed lazily from the shortest-path DAG: each","type":"text"},{"text":" ","type":"text"},{"text":"path walks back from the target over tight in-edges, depth first, to the source.","type":"text"}],"title":"AllShortestPaths","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AllShortestPaths","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AllShortestPaths","kind":"identifier"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AllShortestPaths","type":"topic","url":"\/documentation\/shortestpaths\/allshortestpaths"},"doc://ShortestPaths/documentation/ShortestPaths/BellmanFordEvent":{"type":"topic","role":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/BellmanFordEvent","abstract":[{"type":"text","text":"What Bellman–Ford reports, in order, as "},{"type":"codeVoice","code":"bellmanFordShortestPaths(from:weight:)"},{"type":"text","text":" runs it."}],"url":"\/documentation\/shortestpaths\/bellmanfordevent","title":"BellmanFordEvent","navigatorTitle":[{"kind":"identifier","text":"BellmanFordEvent"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BellmanFordEvent"}]},"doc://ShortestPaths/documentation/ShortestPaths/GraphProtocols":{"type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/GraphProtocols","title":"GraphProtocols","role":"collection","kind":"symbol","url":"\/documentation\/shortestpaths\/graphprotocols","abstract":[]},"doc://ShortestPaths/documentation/ShortestPaths/ALTLandmarks":{"navigatorTitle":[{"text":"ALTLandmarks","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/altlandmarks","abstract":[{"text":"Landmarks for A* search by the ALT method (Goldberg and Harrelson, “Computing the shortest","type":"text"},{"text":" ","type":"text"},{"text":"path: A* search meets graph theory”, SODA 2005): a few vertices chosen far apart, the distance","type":"text"},{"text":" ","type":"text"},{"text":"from and to each of them stored for every vertex, and each query an A* search whose estimate of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a vertex’s remaining distance is the largest lower bound the triangle inequality gives from"},{"type":"text","text":" "},{"type":"text","text":"any landmark, "},{"type":"codeVoice","code":"d(L, t) − d(L, v)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"d(v, L) − d(t, L)"},{"type":"text","text":"."}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ALTLandmarks","title":"ALTLandmarks","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ALTLandmarks","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/ContractionHierarchy":{"navigatorTitle":[{"text":"ContractionHierarchy","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/contractionhierarchy","abstract":[{"text":"A contraction hierarchy (Geisberger, Sanders, Schultes and Delling, “Contraction hierarchies:","type":"text"},{"text":" ","type":"text"},{"text":"faster and simpler hierarchical routing in road networks”, WEA 2008) over a graph and its","type":"text"},{"text":" ","type":"text"},{"text":"weights: the vertices contracted one at a time in a heuristic order, each contraction adding","type":"text"},{"text":" ","type":"text"},{"text":"the shortcuts that keep every distance among the vertices still to come, and each query two","type":"text"},{"text":" ","type":"text"},{"text":"searches that only climb, from the source along arcs to higher-ranked vertices and from the","type":"text"},{"text":" ","type":"text"},{"text":"target backward along arcs from higher-ranked ones, meeting on a shortest path.","type":"text"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/ContractionHierarchy","type":"topic","title":"ContractionHierarchy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContractionHierarchy","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/AStarSearch":{"kind":"symbol","title":"AStarSearch","abstract":[{"type":"text","text":"A* as a sequence of "},{"type":"codeVoice","code":"AStarSearchEvent"},{"type":"text","text":"s, pulled one at a time. It holds a copy of the graph,"},{"type":"text","text":" "},{"type":"text","text":"the weight closure and the heuristic, so later changes to the original do not affect it, and it"},{"type":"text","text":" "},{"type":"text","text":"can be iterated more than once. It reads rows as "},{"type":"codeVoice","code":"DijkstraSearch"},{"type":"text","text":" does."}],"role":"symbol","navigatorTitle":[{"text":"AStarSearch","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AStarSearch","kind":"identifier"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/AStarSearch","type":"topic","url":"\/documentation\/shortestpaths\/astarsearch"},"doc://ShortestPaths/documentation/ShortestPaths/DijkstraSearchEvent":{"navigatorTitle":[{"text":"DijkstraSearchEvent","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/shortestpaths\/dijkstrasearchevent","abstract":[{"type":"text","text":"What a Dijkstra search reports, in order, with the events of the Boost Graph Library’s"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra visitor."}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/DijkstraSearchEvent","title":"DijkstraSearchEvent","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DijkstraSearchEvent","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/aStarShortestPat