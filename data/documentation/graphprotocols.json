pe":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"title":"Hypergraph","type":"topic","url":"\/documentation\/graphprotocols\/hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","kind":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","title":"SparselyIndexedDirectedGraph","type":"topic","kind":"symbol","abstract":[{"text":"A directed graph whose vertices and edges sit at integer positions in ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":" that may have holes: petgraph’s ","type":"text"},{"code":"NodeIndexable","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"EdgeIndexable","type":"codeVoice"},{"type":"text","text":", whose "},{"code":"node_bound()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"edge_bound()","type":"codeVoice"},{"type":"text","text":" are “an upper bound of the indices,"},{"type":"text","text":" "},{"type":"text","text":"suitable for the size of a bitmap”, as against "},{"code":"NodeCompactIndexable","type":"codeVoice"},{"type":"text","text":", whose indices have no"},{"type":"text","text":" "},{"type":"text","text":"holes. "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":" and "},{"code":"edgeIndexBound","type":"codeVoice"},{"type":"text","text":" are the compact kind and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws; a conformer reports them only while it has no holes."}],"role":"symbol","navigatorTitle":[{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/EdgeNotFound":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeNotFound","abstract":[{"type":"text","text":"The error a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" call throws when an edge position it was given doesn’t name an edge in"},{"type":"text","text":" "},{"type":"text","text":"the graph, because it is out of range or its edge was removed. The vertex counterpart is"},{"type":"text","text":" "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","type":"reference","isActive":true},{"type":"text","text":"."}],"kind":"symbol","type":"topic","title":"EdgeNotFound","role":"symbol","url":"\/documentation\/graphprotocols\/edgenotfound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeNotFound","kind":"identifier"}],"navigatorTitle":[{"text":"EdgeNotFound","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedEdge":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdge"}],"url":"\/documentation\/graphprotocols\/undirectededge","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","title":"UndirectedEdge","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An edge of an undirected graph: the unordered pair {u, v}. "},{"type":"codeVoice","code":"UndirectedEdge(1, 2)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(2, 1)"},{"type":"text","text":" are equal and hash alike."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndirectedEdge"}]},"doc://GraphProtocols/documentation/GraphProtocols/GraphBuilder":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphBuilder"}],"url":"\/documentation\/graphprotocols\/graphbuilder","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder","title":"GraphBuilder","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Builds the vertices and edges of an undirected graph from a list of statements."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GraphBuilder"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","abstract":[{"type":"text","text":"A bidirectional directed graph read as an undirected graph: each arc "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" is the edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" at the arc’s position, so "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" is "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" then "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"degree"},{"type":"text","text":" is the base’s. Two opposite arcs are two parallel edges."}],"kind":"symbol","type":"topic","title":"UndirectedView","role":"symbol","url":"\/documentation\/graphprotocols\/undirectedview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedView","kind":"identifier"}],"navigatorTitle":[{"text":"UndirectedView","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedView"}],"url":"\/documentation\/graphprotocols\/directedview","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","title":"DirectedView","type":"topic","kind":"symbol","abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" is the two arcs ","type":"text"},{"code":"u→v","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"v→u","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"successors","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"predecessors","type":"codeVoice"},{"text":" are both ","type":"text"},{"code":"neighbors","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" is twice the","type":"text"},{"text":" ","type":"text"},{"text":"base’s.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedView"}]},"doc://GraphProtocols/documentation/GraphProtocols/ElementNotFound":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElementNotFound","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/elementnotfound","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/ElementNotFound","title":"ElementNotFound","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The error a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" call throws when it can fail both ways: an edge position that doesn’t"},{"type":"text","text":" "},{"type":"text","text":"name an edge, or a vertex that isn’t in the graph. “Element” is the collective term for vertices"},{"type":"text","text":" "},{"type":"text","text":"and edges, as in GraphML’s graph elements and the BGL’s descriptors."}],"role":"symbol","navigatorTitle":[{"text":"ElementNotFound","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"text":"The error an iterative method throws when it spends its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos","type":"text"},{"text":" ","type":"text"},{"text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ComputationInfo::NoConvergence"},{"text":"; NetworkX raises ","type":"text"},{"type":"codeVoice","code":"PowerIterationFailedConvergence"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ArpackNoConvergence"},{"text":" in the same place.","type":"text"}],"title":"NoConvergence","type":"topic","url":"\/documentation\/graphprotocols\/noconvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"symbol","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"url":"\/documentation\/graphprotocols\/directedhypergraph","title":"DirectedHypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","role":"symbol","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}]},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"type":"text","text":" allows both)."}],"type":"topic","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","abstract":[{"type":"text","text":"The error a "},{"type":"codeVoice","code":"checked:"},{"type":"text","text":" call throws when a vertex it was given isn’t in the graph. Named after"},{"type":"text","text":" "},{"type":"text","text":"NetworkX’s "},{"type":"codeVoice","code":"NodeNotFound"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","title":"VertexNotFound","role":"symbol","url":"\/documentation\/graphprotocols\/vertexnotfound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexNotFound","kind":"identifier"}],"navigatorTitle":[{"text":"VertexNotFound","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"code":"MutableGraph","type":"codeVoice"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"add_vertex","type":"codeVoice"},{"type":"text","text":", "},{"code":"add_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_vertex","type":"codeVoice"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"kind":"symbol","type":"topic","title":"MutableDirectedGraph","role":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","title":"BidirectionalDirectedGraph","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"code":"BidirectionalGraph","type":"codeVoice"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","abstract":[],"kind":"symbol","type":"topic","title":"GraphProtocols","role":"collection","url":"\/documentation\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text