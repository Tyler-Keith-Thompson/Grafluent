{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols"},"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Protocols","generated":true,"anchor":"Protocols","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphDelegator","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"]},{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeNotFound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeValues","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexMap","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexValues"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraphBuilder","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/ElementNotFound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder"]}],"metadata":{"title":"GraphProtocols","role":"collection","externalID":"GraphProtocols","symbolKind":"module","modules":[{"name":"GraphProtocols"}],"roleHeading":"Framework"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","url":"\/documentation\/graphprotocols\/directedview","type":"topic","navigatorTitle":[{"text":"DirectedView","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"DirectedView","abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" is the two arcs ","type":"text"},{"code":"u→v","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"v→u","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"successors","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"predecessors","type":"codeVoice"},{"text":" are both ","type":"text"},{"code":"neighbors","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" is twice the","type":"text"},{"text":" ","type":"text"},{"text":"base’s.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/GraphAdaptor":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphAdaptor","kind":"identifier"}],"navigatorTitle":[{"text":"GraphAdaptor","kind":"identifier"}],"title":"GraphAdaptor","url":"\/documentation\/graphprotocols\/graphadaptor","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor","abstract":[{"type":"text","text":"A type that wraps a base graph and passes its positions through: a BGL or LEMON "},{"inlineContent":[{"type":"text","text":"graph"},{"type":"text","text":" "},{"type":"text","text":"adaptor"}],"type":"emphasis"},{"type":"text","text":". Views (a transposed view, a subgraph view, a directed or undirected view) and"},{"type":"text","text":" "},{"type":"text","text":"wrappers that add rules (a multigraph, an acyclic graph) are adaptors."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/GraphDelegator":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphDelegator"}],"navigatorTitle":[{"kind":"identifier","text":"GraphDelegator"}],"title":"GraphDelegator","url":"\/documentation\/graphprotocols\/graphdelegator","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphDelegator","abstract":[{"type":"text","text":"A wrapper that owns its base, keeps the base’s vertices, edges and positions, and adds only"},{"type":"text","text":" "},{"type":"text","text":"rules: JGraphT’s "},{"code":"GraphDelegator","type":"codeVoice"},{"type":"text","text":". Every read requirement of "},{"code":"Graph","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SparselyIndexedDirectedGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":" has a default","type":"text"},{"text":" ","type":"text"},{"text":"that forwards to the base, ","type":"text"},{"code":"@inlinable","type":"codeVoice"},{"text":" and with the base’s own types, so algorithms run at the","type":"text"},{"text":" ","type":"text"},{"text":"base’s speed and data kept by position stays valid through the wrapper. The wrapper implements","type":"text"},{"text":" ","type":"text"},{"text":"every mutation itself (that is where its rules are), and its non-requirement members.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeValues":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeValues"}],"navigatorTitle":[{"kind":"identifier","text":"EdgeValues"}],"title":"EdgeValues","url":"\/documentation\/graphprotocols\/edgevalues","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeValues","abstract":[{"type":"text","text":"A snapshot of an edge map’s values, read by edge position like an array: what"},{"type":"text","text":" "},{"type":"codeVoice","code":"PropertyGraph.values(of:)"},{"type":"text","text":" returns, after "},{"type":"codeVoice","code":"Dictionary.Values"},{"type":"text","text":". It holds the map’s storage, not"},{"type":"text","text":" "},{"type":"text","text":"the graph, so later mutations of the graph or the map do not show through."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphGeneration"}],"title":"GraphGeneration","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration","abstract":[{"text":"A graph’s generation: which state of which graph it is. Every structural mutation (an","type":"text"},{"text":" ","type":"text"},{"text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and","type":"text"},{"text":" ","type":"text"},{"text":"writing attached map values do not. A structure derived from a graph stores the graph’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"generation"},{"text":" and asks ","type":"text"},{"type":"codeVoice","code":"isCurrent(for:)"},{"text":" before it relies on the graph again.","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"GraphGeneration"}],"url":"\/documentation\/graphprotocols\/graphgeneration","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidenceGraphView"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","role":"symbol","title":"Hypergraph","kind":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/VertexMap":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VertexMap"}],"title":"VertexMap","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexMap","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A handle to a map from vertex positions to "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" attached to a graph (LEMON’s "},{"type":"codeVoice","code":"NodeMap"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"returned by "},{"type":"codeVoice","code":"PropertyGraph.addVertexMap(default:)"},{"type":"text","text":"; read and write values through"},{"type":"text","text":" "},{"type":"codeVoice","code":"graph[handle, ofVertexAt: position]"},{"type":"text","text":" or "},{"type":"codeVoice","code":"graph[handle, of: vertex]"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"VertexMap"}],"url":"\/documentation\/graphprotocols\/vertexmap","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"}],"title":"PropertyGraph","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","url":"\/documentation\/graphprotocols\/propertygraph","abstract":[{"text":"A graph that keeps maps from its vertices and edges to values: the BGL ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"PropertyGraph","type":"text"}]},{"text":" ","type":"text"},{"text":"concept (“a graph that has some property associated with each vertex or edge”), with LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NodeMap"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ArcMap"},{"type":"text","text":" attached to the graph and kept in step by it. The graph owns the values"},{"type":"text","text":" "},{"type":"text","text":"and the caller holds a small handle, "},{"type":"codeVoice","code":"VertexMap<Value>"},{"text":" or ","type":"text"},{"code":"EdgeMap<Value>","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"title":"SparselyIndexedDirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","kind":"symbol","abstract":[{"text":"A directed graph whose vertices and edges sit at integer positions in ","type":"text"},{"code":"0..<vertexPositionBound","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"0..<edgePositionBound","type":"codeVoice"},{"text":" that may have holes: petgraph’s ","type":"text"},{"code":"NodeIndexable","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"node_bound()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edge_bound()","type":"codeVoice"},{"text":" are “an upper bound of the indices,","type":"text"},{"text":" ","type":"text"},{"text":"suitable for the size of a bitmap”, as against ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":", whose indices have no","type":"text"},{"text":" ","type":"text"},{"text":"holes. ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":" are the compact kind and keep","type":"text"},{"text":" ","type":"text"},{"text":"their laws; a conformer reports them only while it has no holes.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/GraphBuilder":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphBuilder","kind":"identifier"}],"title":"GraphBuilder","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Builds the vertices and edges of an undirected graph from a list of statements."}],"navigatorTitle":[{"text":"GraphBuilder","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graphbuilder","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeMap"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","kind":"symbol","abstract":[{"text":"A handle to a map from edge positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"ArcMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"returned by ","type":"text"},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"text":". It holds no values: read and write them","type":"text"},{"text":" ","type":"text"},{"text":"through the graph, ","type":"text"},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"text":". It is valid on the graph that added it","type":"text"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":"; on another graph it traps.","type":"text"}],"title":"EdgeMap","role":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/edgemap","navigatorTitle":[{"kind":"identifier","text":"EdgeMap"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"title":"MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"code":"add_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_vertex","type":"codeVoice"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraphBuilder":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraphBuilder","kind":"identifier"}],"title":"DirectedGraphBuilder","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraphBuilder","url":"\/documentation\/graphprotocols\/directedgraphbuilder","abstract":[{"type":"text","text":"Builds the vertices and edges of a directed graph from a list of statements."}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"DirectedGraphBuilder","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"title":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/noconvergence","kind":"symbol","abstract":[{"text":"The error an iterative method throws when it spends its iteration limit without meeting its","type":"text"},{"text":" ","type":"text"},{"text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos","type":"text"},{"text":" ","type":"text"},{"text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ComputationInfo::NoConvergence"},{"type":"text","text":"; NetworkX raises "},{"type":"codeVoice","code":"PowerIterationFailedConvergence"},{"type":"text","text":" and SciPy"},{"type":"text","text":" "},{"type":"codeVoice","code":"ArpackNoConvergence"},{"type":"text","text":" in the same place."}],"navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"code":"directedView","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedEdge":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdge"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","kind":"symbol","abstract":[{"text":"An edge of an undirected graph: the unordered pair {u, v}. ","type":"text"},{"type":"codeVoice","code":"UndirectedEdge(1, 2)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UndirectedEdge(2, 1)"},{"text":" are equal and hash alike.","type":"text"}],"title":"UndirectedEdge","role":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/undirectededge","navigatorTitle":[{"kind":"identifier","text":"UndirectedEdge"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedView"}],"title":"UndirectedView","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","kind":"symbol","abstract":[{"text":"A bidirectional directed graph read as an undirected graph: each arc ","type":"text"},{"code":"u→v","type":"codeVoice"},{"text":" is the edge","type":"text"},{"text":" ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" at the arc’s position, so ","type":"text"},{"type":"codeVoice","code":"neighbors"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"successors"},{"text":" then ","type":"text"},{"type":"codeVoice","code":"predecessors"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"degree"},{"text":" is the base’s. Two opposite arcs are two parallel edges.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"UndirectedView"}],"url":"\/documentation\/graphprotocols\/undirectedview","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"title":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"title":"BidirectionalDirectedGraph","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"type":"codeVoice","code":"BidirectionalGraph"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexNotFound","kind":"identifier"}],"title":"VertexNotFound","abstract":[{"text":"The error a ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" call throws when a vertex it was given isn’t in the graph. Named after","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s ","type":"text"},{"type":"codeVoice","code":"NodeNotFound"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","navigatorTitle":[{"text":"VertexNotFound","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/vertexnotfound","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}],"title":"MutableGraph","url":"\/documentation\/graphprotocols\/mutablegraph","navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}],"abstract":[{"text":"An undirected graph that generic code can fill: the undirected counterpart of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MutableDirectedGraph"},{"text":" (Boost’s ","type":"text"},{"type":"codeVoice","code":"MutableGraph"},{"text":" concept, ","type":"text"},{"type":"codeVoice","code":"add_vertex"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"add_edge"},{"text":"), with the","type":"text"},{"text":" ","type":"text"},{"text":"members a reader needs to build a graph by key.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/ElementNotFound":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElementNotFound"}],"title":"ElementNotFound","abstract":[{"text":"The error a ","type":"text"},{"type":"codeVoice","code":"checked:"},{"text":" call throws when it can fail both ways: an edge position that doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"name an edge, or a vertex that isn’t in the graph. “Element” is the collective term for vertices","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and edges, as in GraphML’s graph elements and the BGL’s descriptors."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/ElementNotFound","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ElementNotFound"}],"url":"\/documentation\/graphprotocols\/elementnotfound","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexValues":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VertexValues"}],"navigatorTitle":[{"kind":"identifier","text":"VertexValues"}],"title":"VertexValues","url":"\/documentation\/graphprotocols\/vertexvalues","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexValues","abstract":[{"text":"A snapshot of a vertex map’s values, read by vertex position like an array: what","type":"text"},{"text":" ","type":"text"},{"code":"PropertyGraph.values(of:)","type":"codeVoice"},{"text":" returns. As ","type":"text"},{"code":"EdgeValues","type":"codeVoice"},{"text":", a read at a removed position reads an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"unspecified value and never traps there."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeNotFound":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeNotFound","kind":"identifier"}],"title":"EdgeNotFound","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeNotFound","url":"\/documentation\/graphprotocols\/edgenotfound","abstract":[{"type":"text","text":"The error a "},{"code":"checked:","type":"codeVoice"},{"type":"text","text":" call throws when an edge position it was given doesn’t name an edge in"},{"type":"text","text":" "},{"type":"text","text":"the graph, because it is out of range or its edge was removed. The vertex counterpart is"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"EdgeNotFound","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols":{"title":"GraphProtocols","url":"\/documentation\/graphprotocols","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedEdge"}],"title":"DirectedEdge","abstract":[{"type":"text","text":"An edge of a directed graph: the ordered pair (source, target), directed from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","navigatorTitle":[{"kind":"identifier","text":"DirectedEdge"}],"url":"\/documentation\/graphprotocols\/directededge","role":"symbol"}}}