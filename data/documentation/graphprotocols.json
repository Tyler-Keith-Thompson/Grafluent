Bound"},{"text":" are the compact kind and keep","type":"text"},{"text":" ","type":"text"},{"text":"their laws; a conformer reports them only while it has no holes.","type":"text"}],"navigatorTitle":[{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","title":"DirectedView","url":"\/documentation\/graphprotocols\/directedview","abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the two arcs "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"v→u"},{"type":"text","text":", so "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" and "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":" are both "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"navigatorTitle":[{"text":"DirectedView","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"}}}