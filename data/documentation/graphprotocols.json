{"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols"]}],"metadata":{"modules":[{"name":"GraphProtocols"}],"roleHeading":"Framework","externalID":"GraphProtocols","symbolKind":"module","role":"collection","title":"GraphProtocols"},"hierarchy":{"paths":[[]]},"topicSections":[{"anchor":"Protocols","generated":true,"title":"Protocols","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"]},{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView"]},{"anchor":"Enumerations","generated":true,"title":"Enumerations","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraphBuilder","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","title":"GraphProtocols","role":"collection","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"url":"\/documentation\/graphprotocols\/hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","title":"Hypergraph","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph":{"url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","title":"SparselyIndexedDirectedGraph","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph whose vertices and edges sit at integer positions in "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":" that may have holes: petgraph’s "},{"type":"codeVoice","code":"NodeIndexable"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"node_bound()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edge_bound()"},{"type":"text","text":" are “an upper bound of the indices,"},{"type":"text","text":" "},{"type":"text","text":"suitable for the size of a bitmap”, as against "},{"type":"codeVoice","code":"NodeCompactIndexable"},{"type":"text","text":", whose indices have no"},{"type":"text","text":" "},{"type":"text","text":"holes. "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" are the compact kind and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws; a conformer reports them only while it has no holes."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"url":"\/documentation\/graphprotocols\/mutablegraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","title":"MutableGraph","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept, "},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":" and "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":"), with the"},{"type":"text","text":" "},{"type":"text","text":"members a reader needs to build a graph by key."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","title":"MutableDirectedGraph","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","type":"topic","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","title":"DirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","title":"DirectedHypergraph","role":"symbol","kind":"symbol","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedhypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"url":"\/documentation\/graphprotocols\/directededge","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"DirectedEdge","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","title":"DirectedEdge","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"DirectedEdge","kind":"identifier"}],"abstract":[{"type":"text","text":"An edge of a directed graph: the ordered pair (source, target), directed from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraphBuilder":{"title":"DirectedGraphBuilder","abstract":[{"type":"text","text":"Builds the vertices and edges of a directed graph from a list of statements."}],"kind":"symbol","navigatorTitle":[{"text":"DirectedGraphBuilder","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraphbuilder","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraphBuilder","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraphBuilder","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","title":"BidirectionalDirectedGraph","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedEdge":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdge","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/undirectededge","kind":"symbol","type":"topic","abstract":[{"text":"An edge of an undirected graph: the unordered pair {u, v}. ","type":"text"},{"code":"UndirectedEdge(1, 2)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(2, 1)","type":"codeVoice"},{"text":" are equal and hash alike.","type":"text"}],"navigatorTitle":[{"text":"UndirectedEdge","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","role":"symbol","title":"UndirectedEdge"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","kind":"symbol","type":"topic","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directed"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","title":"Graph"},"doc://GraphProtocols/documentation/GraphProtocols/GraphBuilder":{"navigatorTitle":[{"kind":"identifier","text":"GraphBuilder"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder","title":"GraphBuilder","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Builds the vertices and edges of an undirected graph from a list of statements."}],"type":"topic","url":"\/documentation\/graphprotocols\/graphbuilder","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphBuilder"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedView","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/undirectedview","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A bidirectional directed graph read as an undirected graph: each arc "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" is the edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" at the arc’s position, so "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" is "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" then "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"degree"},{"type":"text","text":" is the base’s. Two opposite arcs are two parallel edges."}],"navigatorTitle":[{"text":"UndirectedView","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","role":"symbol","title":"UndirectedView"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"url":"\/documentation\/graphprotocols\/directedview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedView"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","title":"DirectedView","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedView"}],"abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"code":"{u, v}","type":"codeVoice"},{"type":"text","text":" is the two arcs "},{"code":"u→v","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"v→u","type":"codeVoice"},{"type":"text","text":", so "},{"code":"successors","type":"codeVoice"},{"type":"text","text":" and "},{"code":"predecessors","type":"codeVoice"},{"type":"text","text":" are both "},{"code":"neighbors","type":"codeVoice"},{"type":"text","text":", and "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"type":"topic"}}}