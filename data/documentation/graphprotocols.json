hbors"},{"type":"text","text":" is "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" then "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"degree"},{"type":"text","text":" is the base’s. Two opposite arcs are two parallel edges."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedView","kind":"identifier"}],"title":"UndirectedView","url":"\/documentation\/graphprotocols\/undirectedview","role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"text":"UndirectedView","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"title":"DirectedEdge","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","abstract":[{"text":"An edge of a directed graph: the ordered pair (source, target), directed from ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"target"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedEdge"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DirectedEdge"}],"url":"\/documentation\/graphprotocols\/directededge","type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"text":" because in-adjacency usually costs extra storage, and many algorithms only","type":"text"},{"text":" ","type":"text"},{"text":"go forward.","type":"text"}],"identifier":"doc:\/\/Graph