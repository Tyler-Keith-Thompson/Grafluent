rtices and edges of a directed graph from a list of statements."}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraphBuilder","url":"\/documentation\/graphprotocols\/directedgraphbuilder","navigatorTitle":[{"text":"DirectedGraphBuilder","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"navigatorTitle":[{"kind":"identifier","text":"DirectedEdge"}],"title":"DirectedEdge","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","url":"\/documentation\/graphprotocols\/directededge","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DirectedEdge"}],"abstract":[{"text":"An edge of a directed graph: the ordered pair (source, target), directed from ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"target","type":"codeVoice"},{"text":".","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"navigatorTitle":[{"