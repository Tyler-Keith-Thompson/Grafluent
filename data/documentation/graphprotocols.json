 mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"title":"MutableDirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the two arcs ","type":"text"},{"type":"codeVoice","code":"u→v"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v→u"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"successors"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"predecessors"},{"text":" are both ","type":"text"},{"type":"codeVoice","code":"neighbors"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":" is twice the","type":"text"},{"text":" ","type":"text"},{"text":"base’s.","type":"text"}],"url":"\/documentation\/graphprotocols\/directedview","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","kind":"symbol","navigatorTitle":[{"text":"DirectedView","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}],"title":"DirectedView"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"type":"topic","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","title":"BidirectionalDirectedGraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}]},"doc://GraphProtocols/documentation/GraphProtocols":{"type":"topic","role":"collection","abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","url":"\/documentation\/graphprotocols","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedEdge":{"abstract":[{"type":"text","text":"An edge of an undirected graph: the unordered pair {u, v}. "},{"code":"UndirectedEdge(1, 2)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"UndirectedEdge(2, 1)","type":"codeVoice"},{"type":"text","text":" are equal and hash alike."}],"type":"topic","navigatorTitle":[{"text":"UndirectedEdge","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/graphprotocols\/undirectededge","title":"UndirectedEdge","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdge","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"Hypergraph","url":"\/documentation\/graphprotocols\/hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"Graph","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/GraphBuilder":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphBuilder","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Builds the vertices and edges of an undirected graph from a list of statements.","type":"text"}],"title":"GraphBuilder","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder","url":"\/documentation\/graphprotocols\/graphbuilder","navigatorTitle":[{"text":"GraphBuilder","kind":"identifier"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraphBuilder":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/directedgraphbuilder","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraphBuilder"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraphBuilder"}],"title":"DirectedGraphBuilder","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraphBuilder","abstract":[{"text":"Builds the vertices and edges of a directed graph from a list of statements.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"type":"topic","abstract":[{"type":"text","text":"An edge of a directed graph: the ordered pair (source, target), directed from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"DirectedEdge"}],"kind":"symbol","role":"symbol","title":"DirectedEdge","url":"\/documentation\/graphprotocols\/directededge","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedEdge"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"url":"\/documentation\/graphprotocols\/mutablegraph","navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"MutableGraph"},