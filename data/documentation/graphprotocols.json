{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol","title":"DirectedGraph","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"}],"kind":"symbol","title":"PropertyGraph","abstract":[{"text":"A graph that keeps maps from its vertices and edges to values: the BGL ","type":"text"},{"inlineContent":[{"text":"PropertyGraph","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"concept (“a graph that has some property associated with each vertex or edge”), with LEMON’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NodeMap"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ArcMap"},{"type":"text","text":" attached to the graph and kept in step by it. The graph owns the values"},{"type":"text","text":" "},{"type":"text","text":"and the caller holds a small handle, "},{"type":"codeVoice","code":"VertexMap<Value>"},{"type":"text","text":" or "},{"code":"EdgeMap<Value>","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","url":"\/documentation\/graphprotocols\/propertygraph","navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"kind":"symbol","title":"Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directedView","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedhypergraph","role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","title":"DirectedHypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"abstract":[{"text":"A bidirectional directed graph read as an undirected graph: each arc ","type":"text"},{"code":"u→v","type":"codeVoice"},{"text":" is the edge","type":"text"},{"text":" ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" at the arc’s position, so ","type":"text"},{"code":"neighbors","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"successors","type":"codeVoice"},{"text":" then ","type":"text"},{"code":"predecessors","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"degree","type":"codeVoice"},{"text":" is the base’s. Two opposite arcs are two parallel edges.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"UndirectedView"}],"type":"topic","url":"\/documentation\/graphprotocols\/undirectedview","role":"symbol","title":"UndirectedView","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedView"}]},"doc://GraphProtocols/documentation/GraphProtocols/VertexValues":{"abstract":[{"text":"A snapshot of a vertex map’s values, read by vertex position like an array: what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PropertyGraph.values(of:)"},{"text":" returns. As ","type":"text"},{"type":"codeVoice","code":"EdgeValues"},{"text":", a read at a removed position reads an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"unspecified value and never traps there."}],"navigatorTitle":[{"kind":"identifier","text":"VertexValues"}],"type":"topic","url":"\/documentation\/graphprotocols\/vertexvalues","role":"symbol","kind":"symbol","title":"VertexValues","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexValues","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VertexValues"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"role":"symbol","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"code":"BidirectionalGraph","type":"codeVoice"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"code":"DirectedGraph","type":"codeVoice"},{"text":" because in-adjacency usually costs extra storage, and many algorithms only","type":"text"},{"text":" ","type":"text"},{"text":"go forward.","type":"text"}],"title":"BidirectionalDirectedGraph","type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/GraphBuilder":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphBuilder"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder","navigatorTitle":[{"kind":"identifier","text":"GraphBuilder"}],"url":"\/documentation\/graphprotocols\/graphbuilder","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Builds the vertices and edges of an undirected graph from a list of statements."}],"title":"GraphBuilder","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeValues":{"abstract":[{"text":"A snapshot of an edge map’s values, read by edge position like an array: what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PropertyGraph.values(of:)"},{"text":" returns, after ","type":"text"},{"type":"codeVoice","code":"Dictionary.Values"},{"text":". It holds the map’s storage, not","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the graph, so later mutations of the graph or the map do not show through."}],"navigatorTitle":[{"kind":"identifier","text":"EdgeValues"}],"type":"topic","url":"\/documentation\/graphprotocols\/edgevalues","role":"symbol","kind":"symbol","title":"EdgeValues","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeValues","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeValues"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"code":"{u, v}","type":"codeVoice"},{"text":" is the two arcs ","type":"text"},{"code":"u→v","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"v→u","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"successors","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"predecessors","type":"codeVoice"},{"text":" are both ","type":"text"},{"code":"neighbors","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" is twice the","type":"text"},{"text":" ","type":"text"},{"text":"base’s.","type":"text"}],"navigatorTitle":[{"text":"DirectedView","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedview","role":"symbol","title":"DirectedView","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/GraphDelegator":{"navigatorTitle":[{"kind":"identifier","text":"GraphDelegator"}],"title":"GraphDelegator","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphDelegator","kind":"symbol","url":"\/documentation\/graphprotocols\/graphdelegator","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphDelegator"}],"abstract":[{"type":"text","text":"A wrapper that owns its base, keeps the base’s vertices, edges and positions, and adds only"},{"type":"text","text":" "},{"type":"text","text":"rules: JGraphT’s "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":". Every read requirement of "},{"type":"codeVoice","code":"Graph"},{"text":", ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SparselyIndexedDirectedGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":" has a default","type":"text"},{"text":" ","type":"text"},{"text":"that forwards to the base, ","type":"text"},{"code":"@inlinable","type":"codeVoice"},{"text":" and with the base’s own types, so algorithms run at the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"base’s speed and data kept by position stays valid through the wrapper. The wrapper implements"},{"type":"text","text":" "},{"type":"text","text":"every mutation itself (that is where its rules are), and its non-requirement members."}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedEdge":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdge"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","navigatorTitle":[{"kind":"identifier","text":"UndirectedEdge"}],"url":"\/documentation\/graphprotocols\/undirectededge","role":"symbol","type":"topic","title":"UndirectedEdge","abstract":[{"type":"text","text":"An edge of an undirected graph: the unordered pair {u, v}. "},{"type":"codeVoice","code":"UndirectedEdge(1, 2)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(2, 1)"},{"type":"text","text":" are equal and hash alike."}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexMap":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexMap","kind":"identifier"}],"kind":"symbol","title":"VertexMap","abstract":[{"text":"A handle to a map from vertex positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"NodeMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"returned by "},{"type":"codeVoice","code":"PropertyGraph.addVertexMap(default:)"},{"type":"text","text":"; read and write values through"},{"type":"text","text":" "},{"type":"codeVoice","code":"graph[handle, ofVertexAt: position]"},{"type":"text","text":" or "},{"type":"codeVoice","code":"graph[handle, of: vertex]"},{"type":"text","text":"."}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexMap","url":"\/documentation\/graphprotocols\/vertexmap","navigatorTitle":[{"text":"VertexMap","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeMap","kind":"identifier"}],"navigatorTitle":[{"text":"EdgeMap","kind":"identifier"}],"abstract":[{"type":"text","text":"A handle to a map from edge positions to "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" attached to a graph (LEMON’s "},{"type":"codeVoice","code":"ArcMap"},{"type":"text","text":"),"},{"type":"text","text":" "},{"text":"returned by ","type":"text"},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"text":". It holds no values: read and write them","type":"text"},{"text":" ","type":"text"},{"text":"through the graph, ","type":"text"},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"text":". It is valid on the graph that added it","type":"text"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":"; on another graph it traps.","type":"text"}],"url":"\/documentation\/graphprotocols\/edgemap","role":"symbol","title":"EdgeMap","type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/ElementNotFound":{"kind":"symbol","type":"topic","abstract":[{"text":"The error a ","type":"text"},{"code":"checked:","type":"codeVoice"},{"text":" call throws when it can fail both ways: an edge position that doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"name an edge, or a vertex that isn’t in the graph. “Element” is the collective term for vertices","type":"text"},{"text":" ","type":"text"},{"text":"and edges, as in GraphML’s graph elements and the BGL’s descriptors.","type":"text"}],"role":"symbol","url":"\/documentation\/graphprotocols\/elementnotfound","navigatorTitle":[{"kind":"identifier","text":"ElementNotFound"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElementNotFound"}],"title":"ElementNotFound","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/ElementNotFound"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"title":"MutableDirectedGraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","role":"symbol","fragments":[{"kind":"keyword","text":"p