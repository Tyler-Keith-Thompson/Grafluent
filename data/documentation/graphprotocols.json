ropertyGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexMap":{"type":"topic","role":"symbol","title":"VertexMap","abstract":[{"text":"A handle to a map from vertex positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"NodeMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"returned by ","type":"text"},{"code":"PropertyGraph.addVertexMap(default:)","type":"codeVoice"},{"text":"; read and write values through","type":"text"},{"text":" ","type":"text"},{"code":"graph[handle, ofVertexAt: position]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"graph[handle, of: vertex]","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/graphprotocols\/vertexmap","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexMap","navigatorTitle":[{"text":"VertexMap","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexMap","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"title":"MutableGraph","navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}],"abstract":[{"text":"An undirected graph that generic code can fill: the undirected counterpart of","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept, ","type":"text"},{"type":"codeVoice","code":"add_vertex"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"add_edge"},{"text":"), with the","type":"text"},{"text":" ","type":"text"},{"text":"members a reader needs to build a graph by key.","type":"text"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","url":"\/documentation\/graphprotocols\/mutablegraph","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/EdgeNotFound":{"url":"\/documentation\/graphprotocols\/edgenotfound","type":"topic","navigatorTitle":[{"text":"EdgeNotFound","kind":"identifier"}],"title":"EdgeNotFound","abstract":[{"text":"The error a ","type":"text"},{"code":"checked:","type":"codeVoice"},{"text":" call throws when an edge position it was given doesn’t name an edge in","type":"text"},{"text":" ","type":"text"},{"text":"the graph, because it is out of range or its edge was removed. The vertex counterpart is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","type":"reference","isActive":true},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeNotFound","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeNotFound","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"title":"Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Hypergraphs","type":"text"}]},{"text":", 1989). Not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/GraphDelegator":{"type":"topic","role":"symbol","title":"GraphDelegator","abstract":[{"text":"A wrapper that owns its base, keeps the base’s vertices, edges and positions, and adds only","type":"text"},{"text":" ","type":"text"},{"text":"rules: JGraphT’s ","type":"text"},{"code":"GraphDelegator","type":"codeVoice"},{"text":". Every read requirement of ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SparselyIndexedDirectedGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":" has a default","type":"text"},{"text":" ","type":"text"},{"text":"that forwards to the base, ","type":"text"},{"code":"@inlinable","type":"codeVoice"},{"text":" and with the base’s own types, so algorithms run at the","type":"text"},{"text":" ","type":"text"},{"text":"base’s speed and data kept by position stays valid through the wrapper. The wrapper implements","type":"text"},{"text":" ","type":"text"},{"text":"every mutation itself (that is where its rules are), and its non-requirement members.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphDelegator","url":"\/documentation\/graphprotocols\/graphdelegator","navigatorTitle":[{"text":"GraphDelegator","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphDelegator","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedEdge":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","type":"topic","abstract":[{"text":"An edge of an undirected graph: the unordered pair {u, v}. ","type":"text"},{"code":"UndirectedEdge(1, 2)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(2, 1)","type":"codeVoice"},{"text":" are equal and hash alike.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdge","kind":"identifier"}],"title":"UndirectedEdge","role":"symbol","navigatorTitle":[{"text":"UndirectedEdge","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/undirectededge"},"doc://GraphProtocols/documentation/GraphProtocols/ElementNotFound":{"url":"\/documentation\/graphprotocols\/elementnotfound","type":"topic","abstract":[{"type":"text","text":"The error a "},{"code":"checked:","type":"codeVoice"},{"type":"text","text":" call throws when it can fail both ways: an edge position that doesn’t"},{"type":"text","text":" "},{"type":"text","text":"name an edge, or a vertex that isn’t in the graph. “Element” is the collective term for vertices"},{"type":"text","text":" "},{"text":"and edges, as in GraphML’s graph elements and the BGL’s descriptors.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElementNotFound","kind":"identifier"}],"title":"ElementNotFound","role":"symbol","navigatorTitle":[{"text":"ElementNotFound","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/ElementNotFound"},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"url":"\/documentation\/graphprotocols\/undirectedview","type":"topic","navigatorTitle":[{"text":"UndirectedView","kind":"identifier"}],"title":"UndirectedView","abstract":[{"type":"text","text":"A bidirectional directed graph read as an undirected graph: each arc "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" is the edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" at the arc’s position, so "},{"type":"codeVoice","code":"neighbors"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"successors"},{"text":" then ","type":"text"},{"type":"codeVoice","code":"predecessors"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"degree"},{"text":" is the base’s. Two opposite arcs are two parallel edges.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedView","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}]},"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph":{"url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"title":"SparselyIndexedDirectedGraph","abstract":[{"text":"A directed graph whose vertices and edges sit at integer positions in ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":" that may have holes: petgraph’s ","type":"text"},{"type":"codeVoice","code":"NodeIndexable"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"node_bound()"},{"type":"text","text":" and "},{"code":"edge_bound()","type":"codeVoice"},{"text":" are “an upper bound of the indices,","type":"text"},{"text":" ","type":"text"},{"text":"suitable for the size of a bitmap”, as against ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":", whose indices have no","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"holes. "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" are the compact kind and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws; a conformer reports them only while it has no holes."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","type":"topic","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"title":"BidirectionalDirectedGraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/EdgeMap":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeMap","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeMap"}],"title":"EdgeMap","url":"\/documentation\/graphprotocols\/edgemap","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EdgeMap"}],"abstract":[{"text":"A handle to a map from edge positions to ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" attached to a graph (LEMON’s ","type":"text"},{"code":"ArcMap","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"returned by "},{"type":"codeVoice","code":"PropertyGraph.addEdgeMap(default:)"},{"type":"text","text":". It holds no values: read and write them"},{"type":"text","text":" "},{"type":"text","text":"through the graph, "},{"type":"codeVoice","code":"graph[handle, ofEdgeAt: position]"},{"type":"text","text":". It is valid on the graph that added it"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"text":"; on another graph it traps.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/VertexValues":{"url":"\/documentation\/graphprotocols\/vertexvalues","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexValues","abstract":[{"type":"text","text":"A snapshot of a vertex map’s values, read by vertex position like an array: what"},{"type":"text","text":" "},{"type":"codeVoice","code":"PropertyGraph.values(of:)"},{"type":"text","text":" returns. As "},{"type":"codeVoice","code":"EdgeValues"},{"type":"text","text":", a read at a removed position reads an"},{"text":" ","type":"text"},{"text":"unspecified value and never traps there.","type":"text"}],"title":"VertexValues","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexValues","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"VertexValues","kind":"identifier"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"type":"topic","role":"symbol","title":"MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","kind":"symbol","title":"GraphProtocols","type":"topic","url":"\/documentation\/graphprotocols","role":"collection","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/GraphBuilder":{"type":"topic","role":"symbol","title":"GraphBuilder","abstract":[{"type":"text","text":"Builds the vertices and edges of an undirected graph from a list of statements."}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphBuilder","url":"\/documentation\/graphprotocols\/graphbuilder","navigatorTitle":[{"kind":"identifier","text":"GraphBuilder"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphBuilder"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"type":"topic","role":"symbol","title":"DirectedHypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/graphprotocols\/graph","type":"topic","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directedView","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}]},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration":{"url":"\/documentation\/graphprotocols\/graphgeneration","type":"topic","navigatorTitle":[{"text":"GraphGeneration","kind":"identifier"}],"title":"GraphGeneration","abstract":[{"type":"text","text":"A graph’s generation: which state of which graph it is. Every structural mutation (an"},{"type":"text","text":" "},{"type":"text","text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and"},{"type":"text","text":" "},{"type":"text","text":"writing attached map values do not. A structure derived from a graph stores the graph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"generation"},{"type":"text","text":" and asks "},{"type":"codeVoice","code":"isCurrent(for:)"},{"type":"text","text":" before it relies on the graph again."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"url":"\/documentation\/graphprotocols\/noconvergence","title":"NoConvergence","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","abstract":[{"type":"text","text":"The error an iterative method throws when it spends its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule: a power iteration (eigenvector and Katz centrality, PageRank, HITS), a Lanczos"},{"type":"text","text":" "},{"type":"text","text":"or conjugate-gradient run, or a QL eigenvalue iteration. Named after Eigen’s"},{"type":"text","text":" "},{"code":"ComputationInfo::NoConvergence","type":"codeVoice"},{"text":"; NetworkX raises ","type":"text"},{"code":"PowerIterationFailedConvergence","type":"codeVoice"},{"text":" and SciPy","type":"text"},{"text":" ","type":"text"},{"code":"ArpackNoConvergence","type":"codeVoice"},{"text":" in the same place.","type":"text"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/VertexNotFound":{"title":"VertexNotFound","navigatorTitle":[{"text":"VertexNotFound","kind":"identifier"}],"abstract":[{"text":"The error a ","type":"text"},{"code":"checked:","type":"codeVoice"},{"text":" call throws when a vertex it was given isn’t in the graph. Named after","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX’s ","type":"text"},{"code":"NodeNotFound","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/VertexNotFound","url":"\/documentation\/graphprotocols\/vertexnotfound","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VertexNotFound","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/GraphAdaptor":{"type":"topic","role":"symbol","title":"GraphAdaptor","abstract":[{"text":"A type that wraps a base graph and passes its positions through: a BGL or LEMON ","type":"text"},{"inlineContent":[{"text":"graph","type":"text"},{"text":" ","type":"text"},{"text":"adaptor","type":"text"}],"type":"emphasis"},{"text":". Views (a transposed view, a subgraph view, a directed or undirected view) and","type":"text"},{"text":" ","type":"text"},{"text":"wrappers that add rules (a multigraph, an acyclic graph) are adaptors.","type":"text"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graphadaptor","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor","navigatorTitle":[{"text":"GraphAdaptor","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphAdaptor","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}],"title":"DirectedView","type":"topic","url":"\/documentation\/graphprotocols\/directedview","role":"symbol","navigatorTitle":[{"text":"DirectedView","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the two arcs "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"v→u"},{"type":"text","text":", so "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" and "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":" are both "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}]}}}