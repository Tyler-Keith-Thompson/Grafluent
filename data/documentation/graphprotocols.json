{"text":".","type":"text"}],"navigatorTitle":[{"text":"EdgeNotFound","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/edgenotfound","role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/EdgeNotFound","title":"EdgeNotFound","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeNotFound","kind":"identifier"}]}}}