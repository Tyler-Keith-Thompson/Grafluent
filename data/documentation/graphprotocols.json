,"role":"symbol","url":"\/documentation\/graphprotocols\/graphbuilder","navigatorTitle":[{"text":"GraphBuilder","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Builds the vertices and edges of an undirected graph from a list of statements."}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"code":"BidirectionalGraph","type":"codeVoice"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" because in-adjacency usually costs extra storage, and many algorithms only","type":"text"},{"text":" ","type":"text"},{"text":"go forward.","type":"text"}],"type":"topic","title":"BidirectionalDirectedGraph","kind":"symbol","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"url":"\/documentation\/graphprotocols\/directedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"title":"DirectedGraph","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"type":"topic","title":"MutableDirectedGraph","role":"symbol","kind":"symbol","abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":", ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_vertex","type":"codeVoice"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"url":"\/documentation\/graphprotocols\/directedview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}],"type":"topic","title":"DirectedView","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the two arcs "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"v→u"},{"type":"text","text":", so "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" and "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":" are both "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"navigatorTitle":[{"text":"DirectedView","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"url":"\/documentation\/graphprotocols\/directedhypergraph","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"type":"topic","kind":"symbol","title":"DirectedHypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"title":"SparselyIndexedDirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","role":"symbol","url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph","navigatorTitle":[{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"A directed graph whose vertices and edges sit at integer positions in ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":" that may have holes: petgraph’s ","type":"text"},{"code":"NodeIndexable","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"node_bound()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edge_bound()","type":"codeVoice"},{"text":" are “an upper bound of the indices,","type":"text"},{"text":" ","type":"text"},{"text":"suitable for the size of a bitmap”, as against ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":", whose indices have no","type":"text"},{"text":" ","type":"text"},{"text":"holes. ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":" are the compact kind and keep","type":"text"},{"text":" ","type":"text"},{"text":"their laws; a conformer reports them only while it has no holes.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"type":"topic","title":"Graph","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directed"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"url":"\/documentation\/graphprotocols\/undirectedview","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedView"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","abstract":[{"type":"text","text":"A bidirectional directed graph read as an undirected graph: each arc "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" is the edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" at the arc’s position, so "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" is "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" then "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"degree"},{"type":"text","text":" is the base’s. Two opposite arcs are two parallel edges."}],"type":"topic","title":"UndirectedView","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndirectedView"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedEdge"}],"title":"DirectedEdge","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","role":"symbol","url":"\/documentation\/graphprotocols\/directededge","navigatorTitle":[{"kind":"identifier","text":"DirectedEdge"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An edge of a directed graph: the ordered pair (source, target), directed from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraphBuilder":{"url":"\/documentation\/graphprotocols\/directedgraphbuilder","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraphBuilder"}],"title":"DirectedGraphBuilder","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Builds the vertices and edges of a directed graph from a list of statements."}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraphBuilder"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraphBuilder"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"title":"Hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","role":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedEdge":{"url":"\/documentation\/graphprotocols\/undirectededge","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedEdge","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedEdge","abstract":[{"text":"An edge of an undirected graph: the unordered pair {u, v}. ","type":"text"},{"code":"UndirectedEdge(1, 2)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(2, 1)","type":"codeVoice"},{"text":" are equal and hash alike.","type":"text"}],"type":"topic","title":"UndirectedEdge","kind":"symbol","navigatorTitle":[{"text":"UndirectedEdge","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","role":"collection","url":"\/documentation\/graphprotocols","kind":"symbol","type":"topic","abstract":[]}}}