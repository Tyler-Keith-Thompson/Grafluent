es and ","type":"text"},{"code":"c","type":"codeVoice"},{"text":" connected components has ","type":"text"},{"code":"n − c","type":"codeVoice"},{"text":" edges. It never","type":"text"},{"text":" ","type":"text"},{"text":"contains a self-loop, and holds at most one of a set of parallel edges.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The forest holds no copy of the graph. Its positions stay valid until the graph is mutated."}],"type":"paragraph"}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SpanningTrees\/s8CopyableP","doc:\/\/SpanningTrees\/SQ","doc:\/\/SpanningTrees\/s9EscapableP","doc:\/\/SpanningTrees\/SH","doc:\/\/SpanningTrees\/s8SendableP","doc:\/\/SpanningTrees\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest\/edges","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest\/weight"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest\/Equatable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},"metadata":{"roleHeading":"Structure","symbolKind":"struct","role":"symbol","title":"SpanningForest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanningForest","kind":"identifier"}],"navigatorTitle":[{"text":"SpanningForest","kind":"identifier"}],"modules":[{"name":"SpanningTrees"}],"externalID":"s:13SpanningTrees0A6ForestV"},"abstract":[{"text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in the graph’s ","type":"text"},{"typ