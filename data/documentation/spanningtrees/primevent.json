{"abstract":[{"type":"text","text":"What Prim’s algorithm reports, in order, with the events of the Boost Graph Library’s"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra visitor, which its Prim uses."}],"variants":[{"paths":["\/documentation\/spanningtrees\/primevent"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees"]]},"sections":[],"metadata":{"roleHeading":"Enumeration","title":"PrimEvent","role":"symbol","externalID":"s:13SpanningTrees9PrimEventO","modules":[{"name":"SpanningTrees"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/PrimEvents.swift#L16","fileName":"PrimEvents.swift"},"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrimEvent"}],"symbolKind":"enum","navigatorTitle":[{"text":"PrimEvent","kind":"identifier"}]},"topicSections":[{"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/edgeNotRelaxed(_:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/edgeRelaxed(_:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/examine(_:edge:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/examineEdge(_:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/finish(_:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/startVertex(_:)"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/CustomStringConvertible-Implementations","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/Equatable-Implementations"]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/