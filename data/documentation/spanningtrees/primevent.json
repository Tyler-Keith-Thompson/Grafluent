{"type":"text","text":" "},{"type":"text","text":"vertex is finished. Over every component, the next tree starts at the first vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order that is not spanned."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"text":"What Prim’s algorithm reports, in order, with the events of the Boost Graph Library’s","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra visitor, which its Prim uses.","type":"text"}],"references":{"doc://SpanningTrees/s16SendableMetatypeP":{"identifier":"doc:\/\/SpanningTrees\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://SpanningTrees/documentation/SpanningTrees":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","role":"collection","url":"\/documentation\/spanningtrees","type":"topic","kind":"symbol","abstract":[],"title":"SpanningTrees"},"doc://SpanningTrees/documentation/SpanningTrees/PrimEvent/edgeRelaxed(_:weight:)":{"title":"PrimEvent.edgeRelaxed(_:weight:)","url":"\/documentation\/spanningtrees\/primevent\/edgerelaxed(_:weight:)","role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/edgeRelaxed(_:weight:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The edge is lighter than its far end’s key, or the far end was not waiting: the far end now"},{"type":"text","text":" "},{"type":"text","text":"waits with key "},{"type":"codeVoice","code":"weight"},{"type":"text","text":", through this edge."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeRelaxed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://SpanningTrees/documentation/Spann