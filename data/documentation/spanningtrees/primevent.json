{"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"SpanningTrees"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PrimEvent","kind":"identifier"}],"externalID":"s:13SpanningTrees9PrimEventO","title":"PrimEvent","navigatorTitle":[{"text":"PrimEvent","kind":"identifier"}],"roleHeading":"Enumeration","remoteSource":{"fileName":"PrimEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/PrimEvents.swift#L16"},"symbolKind":"enum"},"relationshipsSections":[{"identifiers":["doc:\/\/SpanningTrees\/s8CopyableP","doc:\/\/SpanningTrees\/s23CustomStringConvertibleP","doc:\/\/SpanningTrees\/SQ","doc:\/\/SpanningTrees\/s9EscapableP","doc:\/\/SpanningTrees\/SH","doc:\/\/SpanningTrees\/s8SendableP","doc:\/\/SpanningTrees\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PrimEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Weight","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A tree is started at a vertex not yet spanned. Then, while a vertex is waiting to join, the","type":"text"},{"text":" ","type":"text"},{"text":"one with the lightest key is examined: it joins the tree through the edge that gave it that","type":"text"},{"text":" ","type":"text"},{"text":"key (none for the start). Each of its edges whose far end is not yet spanned is examined with","type":"text"},{"text":" ","type":"text"},{"text":"its weight, then relaxed, when the weight is below the far end’s key or the far end was not","type":"text"},{"text":" ","type":"text"},{"text":"yet waiting, or not relaxed. An edge whose far end is already spanned, a self-loop included,","type":"text"},{"text":" ","type":"text"},{"text":"is skipped without an event and without being weighed. After its last edge the examined","type":"text"},{"text":" ","type":"text"},{"text":"vertex is finished. Over every component, the next tree starts at the first vertex in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order that is not spanned.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"What Prim’s algorithm reports, in order, with the events of the Boost Graph Library’s","type":"text"},{"text":" ","type":"text"},{"text":"Dijkstra visitor, which its Prim uses.","type":"text"}],"topicSections":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/edgeNotRelaxed(_:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/edgeRelaxed(_:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/examine(_:edge:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/examineEdge(_:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/finish(_:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\