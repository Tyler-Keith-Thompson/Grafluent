 self-loop included,"},{"type":"text","text":" "},{"type":"text","text":"is skipped without an event and without being weighed. After its last edge the examined"},{"type":"text","text":" "},{"type":"text","text":"vertex is finished. Over every component, the next tree starts at the first vertex in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order that is not spanned."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees/PrimEvent/examineEdge(_:weight:)":{"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"examineEdge","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/examineEdge(_:weight:)","title":"PrimEvent.examineEdge(_:weight:)","abstract":[{"text":"An edge of the vertex being examined, to a vertex not yet spanned, is read with its weight.","type":"text"}],"url":"\/documentation\/spanningtrees\/primevent\/examineedge(_:weight:)","kind":"symbol","role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/PrimEvent/edgeRelaxed(_:weight:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"edgeRelaxed"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Edge"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Weight"},{"text":")","kind":"text"}],"title":"PrimEvent.edgeRelaxed(_:weight:)","type":"topic","kind":"symbol","abstract":[{"text":"The edge is lighter than its far end’s key, or the far end was not waiting: the far end now","type":"text"},{"text":" ","type":"text"},{"text":"waits with key ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":", through this edge.","type":"text"}],"role":"symbol","url":"\/documentation\/spanningtrees\/primevent\/edgerelaxed(_:weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/edgeRelaxed(_:weight:)"},"doc://SpanningTrees/SQ":{"identifier":"doc:\/\/SpanningTrees\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://SpanningTrees/documentation/SpanningTrees/PrimEvent/examine(_:edge:weight:)":{"url":"\/documentation\/spanningtrees\/primevent\/examine(_:edge:weight:)","title":"PrimEvent.examine(_:edge:weight:)","abstract":[{"type":"text","text":"The vertex leaves the queue and joins the tree through "},{"type":"codeVoice","code":"edge"},{"type":"text","text":", whose weight is "},{"type":"codeVoice","code":"weight"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"edge"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is zero for the vertex a tree started at."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"examine","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"edge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Edge","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Weight","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvent\/examine(_:edge:weight:)","type":"topic"},"doc://SpanningTrees/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/SpanningTrees\/SH"},"doc://SpanningTrees/documentation/SpanningTre