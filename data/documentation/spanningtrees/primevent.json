{"abstract":[{"type":"text","text":"What Prim’s algorithm reports, in order, with the events of the Boost Graph Library’s"},{"type":"text","text":" "},{"type":"text","text":"Dijkstra visitor, which its Prim uses."}],"metadata":{"roleHeading":"Enumeration","symbolKind":"enum","modules":[{"name":"SpanningTrees"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrimEvent"}],"title":"PrimEvent","remoteSource":{"fileName":"PrimEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/PrimEvents.swift#L16"},"externalID":"s:13SpanningTrees9PrimEventO","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PrimEvent"}]},"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/spanningtrees\/primevent"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"identifiers":["doc:\/\/SpanningTrees\/s8CopyableP","doc:\/\/SpanningTrees\/s23CustomStringConvertibleP","doc:\/\/SpanningTrees\/SQ","doc:\/\/SpanningTrees\/s9EscapableP","doc:\/\/SpanningTrees\/SH","doc:\/\/SpanningTrees\/s8SendableP","doc:\/\/SpanningTrees\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PrimEvent","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Edge","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Weight","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"pre