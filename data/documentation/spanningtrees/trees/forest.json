ier","text":"Forest"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"code":"trees","type":"codeVoice"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":" says which one a vertex is in."}]},"doc://SpanningTrees/documentation/SpanningTrees/Trees":{"type":"topic","title":"Trees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees","url":"\/documentation\/spanningtrees\/trees","kind":"symbol","abstract":[],"role":"collection"},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest":{"kind":"symbol","title":"Forest","url":"\/documentation\/spanningtrees\/trees\/forest","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest","type":"topic","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier","preciseIdentifier":"s:5Trees6ForestV"}],"abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)","type":"topic","title":"init(_:in:)","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","fragments":[{"text":"init","kind