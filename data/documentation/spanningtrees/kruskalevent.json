{"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/SpanningTrees\/s8CopyableP","doc:\/\/SpanningTrees\/s23CustomStringConvertibleP","doc:\/\/SpanningTrees\/SQ","doc:\/\/SpanningTrees\/s9EscapableP","doc:\/\/SpanningTrees\/SH","doc:\/\/SpanningTrees\/s8SendableP","doc:\/\/SpanningTrees\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/kruskalevent"]}],"metadata":{"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KruskalEvent","kind":"identifier"}],"modules":[{"name":"SpanningTrees"}],"externalID":"s:13SpanningTrees12KruskalEventO","symbolKind":"enum","role":"symbol","navigatorTitle":[{"text":"KruskalEvent","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/KruskalEvents.swift#L13","fileName":"KruskalEvents.swift"},"title":"KruskalEvent"},"sections":[],"topicSections":[{"title":"Enumeration Cases","generated":true,"identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/KruskalEvent\/examineEdge(_:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/KruskalEvent\/nonTreeEdge(_:root:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/KruskalEvent\/treeEdge(_:merging:into:)"],"anchor":"Enumeration-Cases"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/KruskalEvent\/CustomStringConvertible-Implementations","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/KruskalEvent\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum