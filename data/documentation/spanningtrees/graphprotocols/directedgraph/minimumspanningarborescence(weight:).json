\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(weight:)"},"abstract":[{"text":"A minimum spanning arborescence over every choice of root, by Edmonds’ algorithm; nil when","type":"text"},{"text":" ","type":"text"},{"text":"no vertex reaches every other (or the graph has no vertices).","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningArborescence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Branching","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","preciseIdentifier":"s:13SpanningTrees9BranchingV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The arborescence’s edges, in position order, and their total weight. Its root is"},{"type":"text","text":" "},{"type":"text","text":"the one vertex no edge enters."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The search runs once, from an added root joined to every vertex by an edge that costs more"},{"type":"text","text":" "},{"type":"text","text":"than any set of real edges, so the answer uses exactly one of them when a spanning"},{"type":"text","text":" "},{"type":"text","text":"arborescence exists. Self-loops are never weighed; every other edge is weighed once."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(m log m + n log n)."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite; the differences between weights do not overflow;"},{"type":"text","text":" "},{"type":"text","text":"for a weight type that is not "},{"type":"codeVoice","code":"SignedNumeric"},{"type":"text","text":", the sum of all the weights fits."}],"type":"paragraph"}]}]}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/DirectedGraph/minimumSpanningArborescence(weight:)":{"abstract":[{"text":"A minimum spanning arborescence over every choice of root, by Edmonds’ algorithm; nil when","type":"text"},{"text":" ","type":"text"},{"text":"no vertex reaches every other (or the graph has no vertices).","type":"text"}],"kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/directedgraph\/minimumspanningarborescence(weight:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":