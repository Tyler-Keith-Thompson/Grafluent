{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(weight:)"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningArborescence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","text":"Branching","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees9BranchingV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The arborescence’s edges, in position order, and their total weight. Its root is","type":"text"},{"text":" ","type":"text"},{"text":"the one vertex no edge enters.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The search runs once, from an added root joined to every vertex by an edge that costs more","type":"text"},{"text":" ","type":"text"},{"text":"than any set of real edges, so the answer uses exactly one of them when a spanning","type":"text"},{"text":" ","type":"text"},{"text":"arborescence exists. Self-loops are never weighed; every other edge is weighed once.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(m log m + n log n)."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is finite; the differences between weights do not overflow;"},{"type":"text","text":" "},{"type":"text","text":"for a weight type that is not "},{"code":"SignedNumeric","type":"codeVoice"},{"type":"text","text":", the sum of all the weights fits."}]}],"type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/directedgraph\/minimumspanningarborescence(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"remoteSource":{"fileName":"Edmonds.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Edmonds.swift#L89"},"modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","title":"minimumSpanningArborescence(weight:)","role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P13SpanningTreesE07minimumD12Arborescence6weightAD9BranchingVyxqd__GSgqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":"