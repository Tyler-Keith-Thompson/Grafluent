 has no vertices).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningArborescence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees9BranchingV","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","text":"Branching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"The arborescence’s edges, in position order, and their total weight. Its root is","type":"text"},{"text":" ","type":"text"},{"text":"the one vertex no edge enters.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The search runs once, from an added root joined to every vertex by an edge that costs more","type":"text"},{"text":" ","type":"text"},{"text":"than any set of real edges, so the answer uses exactly one of them when a spanning","type":"text"},{"text":" ","type":"text"},{"text":"arborescence exists. Self-loops are never weighed; every other edge is weighed once.","type":"text"}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(m log m + n log n)."}],"type":"paragraph"}]},{"style":"note","name":"Precondition","type":"aside","content":[{"inlineContent":[{"text":"Every weight is finite; the differences between weights do not overflow;","type":"text"},{"text":" ","type":"text"},{"text":"for a weight type that is not ","type":"text"},{"code":"SignedNumeric","type":"codeVoice"},{"text":", the sum of all the weights fits.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(weight:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/directedgraph\/minimumspanningarborescence(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"title":"Edges","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier