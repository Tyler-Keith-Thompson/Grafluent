gesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Branching","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees9BranchingV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees/Branching":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Branching","kind":"identifier"}],"role":"symbol","type":"topic","title":"Branching","url":"\/documentation\/spanningtrees\/branching","navigatorTitle":[{"text":"Branching","kind":"identifier"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","abstract":[{"type":"text","text":"A branching of a directed graph: edges with no two into the same vertex and no cycle, so a"},{"type":"text","text":" "},{"type":"text","text":"forest of arborescences. A spanning arborescence is the branching with exactly one root that"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"role":"collection","url":"\/documentation\/spanningtrees\/graphprotocols","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","type":"topic","abstract":[]}}}