{"sections":[],"abstract":[{"text":"A minimum spanning arborescence over every choice of root, by Edmonds’ algorithm; nil when","type":"text"},{"text":" ","type":"text"},{"text":"no vertex reaches every other (or the graph has no vertices).","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/directedgraph\/minimumspanningarborescence(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph"]]},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(weight:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningArborescence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees9BranchingV","text":"Branching","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The arborescence’s edges, in position order, and their total weight. Its root is"},{"type":"text","text":" "},{"type":"text","text":"the one vertex no edge enters."}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The search runs once, from an added root joined to every vertex by an edge that costs more"},{"type":"text","text":" "},{"type":"text","text":"than any set of real edges, so the answer uses exactly one of them when a spanning"},{"type":"text","text":" "},{"type":"text","text":"arborescence exists. Self-loops are never weighed; every other edge is weighed once."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(m log m + n log n).","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite; the differences between weights do not overflow;"},{"type":"text","text":" "},{"type":"text","text":"for a weight type that is not "},{"type":"codeVoice","code":"SignedNumeric"},{"type":"text","text":", the sum of all the weights fits."}],"type":"paragraph"}]}]}],"metadata":{"role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P13Spa