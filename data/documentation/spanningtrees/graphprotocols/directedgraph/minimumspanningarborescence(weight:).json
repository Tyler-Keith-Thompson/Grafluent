}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The search runs once, from an added root joined to every vertex by an edge that costs more","type":"text"},{"text":" ","type":"text"},{"text":"than any set of real edges, so the answer uses exactly one of them when a spanning","type":"text"},{"text":" ","type":"text"},{"text":"arborescence exists. Self-loops are never weighed; every other edge is weighed once.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m + n log n)."}]}],"type":"aside","style":"note","name":"Complexity"},{"content":[{"inlineContent":[{"type":"text","text":"Every weight is finite; the differences between weights do not overflow;"},{"type":"text","text":" "},{"type":"text","text":"for a weight type that is not "},{"type":"codeVoice","code":"SignedNumeric"},{"type":"text","text":", the sum of all the weights fits."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Precondition"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph"]]},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(weight:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A minimum spanning arborescence over every choice of root, by Edmonds’ algorithm; nil when"},{"type":"text","text":" "},{"type":"text","text":"no vertex reaches every other (or the graph has no vertices)."}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningArborescence","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":