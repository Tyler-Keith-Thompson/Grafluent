aphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"type":"topic","kind":"symbol","title":"Edges","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/Branching":{"kind":"symbol","type":"topic","title":"Branching","url":"\/documentation\/spanningtrees\/branching","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Branching","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Branching","kind":"identifier"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","abstract":[{"text":"A branching of a directed graph: edges with no two into the same vertex and no cycle, so a","type":"text"},{"text":" ","type":"text"},{"text":"forest of arborescences. A spanning arborescence is the branching with exactly one root that","type":"text"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}]}}}