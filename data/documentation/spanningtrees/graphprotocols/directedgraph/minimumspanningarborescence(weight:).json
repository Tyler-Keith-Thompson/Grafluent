":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningArborescence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Branching","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","preciseIdentifier":"s:13SpanningTrees9BranchingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The arborescence’s edges, in position order, and their total weight. Its root is"},{"type":"text","text":" "},{"type":"text","text":"the one vertex no edge enters."}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"The search runs once, from an added root joined to every vertex by an edge that costs more"},{"type":"text","text":" "},{"type":"text","text":"than any set of real edges, so the answer uses exactly one of them when a spanning"},{"type":"text","text":" "},{"type":"text","text":"arborescence exists. Self-loops are never weighed; every other edge is weighed once."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(m log m + n log n).","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite; the differences between weights do not overflow;"},{"type":"text","text":" "},{"type":"text","text":"for a weight type that is not "},{"code":"SignedNumeric","type":"codeVoice"},{"type":"text","text":", the sum of all the weights fits."}],"type":"paragraph"}]}],"kind":"content"}],"abstract":[{"text":"A minimum spanning arborescence over every choice of root, by Edmonds’ algorithm; nil when","type":"text"},{"text":" ","type":"text"},{"text":"no vertex reaches every other (or the graph has no vertices).","type":"text"}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(weight:)","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"abstract":[],"role":"collection","url":"\/documentation\/spanningtrees","type":"topic","kind":"symbol","title":"SpanningTrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/DirectedGraph":{"abstract":[],"type":"topic","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGr