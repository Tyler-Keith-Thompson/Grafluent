he same answer. Edges into "},{"type":"codeVoice","code":"root"},{"type":"text","text":" "},{"type":"text","text":"and self-loops are never weighed; every other edge is weighed once. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is not kept."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The algorithm is Chu–Liu\/Edmonds with Tarjan’s contraction over mergeable heaps (skew heaps"},{"type":"text","text":" "},{"type":"text","text":"with lazy offsets) and a union–find with rollback to expand the contracted cycles."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"name":"Complexity"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"root"},{"text":" is a vertex; every weight is finite (not NaN or infinite); the","type":"text"},{"text":" ","type":"text"},{"text":"differences between weights do not overflow.","type":"text"}]}],"name":"Precondition"}],"kind":"content"}],"sections":[],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/DirectedGraph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"role":"symbol","type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/directedgraph","title":"DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph","abstract":[],"kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees":{"role":"collection","type":"topic","title":"SpanningTrees","url":"\/documentation\/spanningtrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","kind":"symb