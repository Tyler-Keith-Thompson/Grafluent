},{"text":"minimumSpanningArborescence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"root","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees9BranchingV","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","text":"Branching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"root","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertex every edge points away from."}]}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"Each edge’s weight, from its position."}],"type":"paragraph"}]}]},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The arborescence’s edges, in position order, and their total weight; nil when a","type":"text"},{"text":" ","type":"text"},{"text":"vertex cannot be reached from ","type":"text"},{"type":"codeVoice","code":"root"},{"text":".","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The arborescence has one edge into every vertex but "},{"code":"root","type":"codeVoice"},{"type":"text","text":", all of them pointing away from"},{"type":"text","text":" "},{"type":"text","text":"it, and the least total weight of any such set. Among equal-weight optima, which one is"},{"type":"text","text":" "},{"type":"text","text":"returned is unspecified, but the same input always gives the same answer. Edges into "},{"code":"root","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and self-loops are never weighed; every other edge is weighed once. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is not kept."}],"type":"paragraph"},{"inlineContent":[{"text":"The algorithm is Chu–Liu\/Edmonds with Tarjan’s contraction over mergeable heaps (skew heaps","type":"text"},{"text":" ","type":"text"},{"text":"with lazy offsets) and a union–find with rollback to expand the contracted cycles.","type":"text"},{"text":" ","type":"text"},{"text":"Negative and zero weights are ordinary weights.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"root"},{"type":"text","text":" is a vertex; every weight is finite (not NaN or infinite); the"},{"type":"text","text":" "},{"type":"text","text":"differences between weights do not overflow."}]}],"type":"aside","style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(from:weight:)"},"abstract":[{"type":"text","text":"A minimum spanning arborescence rooted at "},{"type":"codeVoice","code":"root"},{"type":"text","text":", by Edmonds’ algorithm; nil unless "},{"type":"codeVoice","code":"root"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph"]]},"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/directedgraph\/minimumspanningarborescence(from:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://SpanningTrees/documentation/SpanningTrees":{"kind":"symbol","title":"SpanningTrees","abstract":[],"type":"topic","url":"\/documentation\/spanningtrees","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/DirectedGraph/minimumSpanningArborescence(from:weight:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningArborescence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA