 is Chu–Liu\/Edmonds with Tarjan’s contraction over mergeable heaps (skew heaps"},{"type":"text","text":" "},{"type":"text","text":"with lazy offsets) and a union–find with rollback to expand the contracted cycles."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(m log m).","type":"text"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"root"},{"type":"text","text":" is a vertex; every weight is finite (not NaN or infinite); the"},{"type":"text","text":" "},{"type":"text","text":"differences between weights do not overflow."}],"type":"paragraph"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"A minimum spanning arborescence rooted at ","type":"text"},{"type":"codeVoice","code":"root"},{"text":", by Edmonds’ algorithm; nil unless ","type":"text"},{"type":"codeVoice","code":"root"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"url":"\/documentation\/spanningtrees","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","type":"topic","title":"SpanningTrees","kind":"symbol","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/Branching":{"role":"symbol","url":"\/documentation\/spanningtrees\/branching","abstract":[{"text":"A branching of a directed graph: edges with no two into the same vertex and no cycle, so a","type":"text"},{"text":" ","type":"text"},{"text":"forest of arborescences. A spanning arborescence is the branching with exactly one root that","type":"text"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\