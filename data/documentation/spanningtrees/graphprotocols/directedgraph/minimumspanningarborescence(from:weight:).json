llback to expand the contracted cycles."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights."}],"type":"paragraph"},{"name":"Complexity","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}]},{"name":"Precondition","style":"note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"root"},{"text":" is a vertex; every weight is finite (not NaN or infinite); the","type":"text"},{"text":" ","type":"text"},{"text":"differences between weights do not overflow.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A minimum spanning arborescence rooted at ","type":"text"},{"code":"root","type":"codeVoice"},{"text":", by Edmonds’ algorithm; nil unless ","type":"text"},{"code":"root","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/directedgraph\/minimumspanningarborescence(from:weight:)"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Edges-swift.associatedtype":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/directedgraph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"title":"Edges","type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/DirectedGraph":{"url":"\/documentation\/spanningtrees\/graphprotocols\/directedgraph","abstract":[],"role":"symbol","type":"topic","identifier":"doc:\