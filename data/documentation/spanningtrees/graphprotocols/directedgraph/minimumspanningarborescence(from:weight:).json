r","text":"minimumSpanningArborescence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"root"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees9BranchingV","text":"Branching","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The vertex every edge points away from."}],"type":"paragraph"}],"name":"root"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each edge’s weight, from its position."}]}],"name":"weight"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The arborescence’s edges, in position order, and their total weight; nil when a","type":"text"},{"text":" ","type":"text"},{"text":"vertex cannot be reached from ","type":"text"},{"code":"root","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The arborescence has one edge into every vertex but ","type":"text"},{"code":"root","type":"codeVoice"},{"text":", all of them pointing away from","type":"text"},{"text":" ","type":"text"},{"text":"it, and the least total weight of any such set. Among equal-weight optima, which one is","type":"text"},{"text":" ","type":"text"},{"text":"returned is unspecified, but the same input always gives the same answer. Edges into ","type":"text"},{"code":"root","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and self-loops are never weighed; every other edge is weighed once. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is not kept.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The algorithm is Chu–Liu\/Edmonds with Tarjan’s contraction over mergeable heaps (skew heaps"},{"type":"text","text":" "},{"type":"text","text":"with lazy offsets) and a union–find with rollback to expand the contracted cycles."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inline