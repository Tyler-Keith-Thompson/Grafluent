ffsets) and a union–find with rollback to expand the contracted cycles.","type":"text"},{"text":" ","type":"text"},{"text":"Negative and zero weights are ordinary weights.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"O(m log m)."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"root","type":"codeVoice"},{"type":"text","text":" is a vertex; every weight is finite (not NaN or infinite); the"},{"type":"text","text":" "},{"type":"text","text":"differences between weights do not overflow."}]}],"type":"aside","style":"note","name":"Precondition"}],"kind":"content"}],"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningArborescence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees9BranchingV","text":"Branching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">?"}],"symbolKind":"method","title":"minimumSpanningArborescence(from:weight:)","ext