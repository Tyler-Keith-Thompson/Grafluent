{"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/DirectedGraph\/minimumSpanningArborescence(from:weight:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningArborescence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"root","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Branching","preciseIdentifier":"s:13SpanningTrees9BranchingV","text":"Branching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"parameters":[{"name":"root","content":[{"type":"paragraph","inlineContent":[{"text":"The vertex every edge points away from.","type":"text"}]}]},{"name":"weight","content":[{"type":"paragraph","inlineContent":[{"text":"Each edge’s weight, from its position.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The arborescence’s edges, in position order, and their total weight; nil when a"},{"type":"text","text":" "},{"type":"text","text":"vertex cannot be reached from "},{"type":"codeVoice","code":"root"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The arborescence has one edge into every vertex but "},{"code":"root","type":"codeVoice"},{"type":"text","text":", all of them pointing away from"},{"type":"text","text":" "},{"type":"text","text":"it, and the least total weight of any such set. Among equal-weight optima, which one is"},{"type":"text","text":" "},{"type":"text","text":"returned is unspecified, but the same input always gives the same answer. Edges into "},{"code":"root","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and self-loops are never weighed; every other edge is weighed once. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is not kept."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The algorithm is Chu–Liu\/Edmonds with Tarjan’s contraction over mergeable heaps (skew heaps"},{"type":"text","text":" "},{"type":"text","text":"with lazy offsets) and a union–find with rollback to expand the contracted cycles."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights."}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"root"},{"type":"text","text":" is a vertex; every weight is finite (not NaN or infinite); the"},{"type":"text","text":" "},{"type":"text","text":"differences between weights do not overflow."}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"sections":[],"kind":"symbol","metadata":{"role":"symbol","symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpanningTrees"}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","title":"minimumSpanningArborescence(from:weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningArborescence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Branching","preciseIdentifier":"s:13SpanningTrees9BranchingV"},{"kind":"text","text":