xt"},{"text":" ","type":"text"},{"text":"exactly when it joins two components of the edges taken before it. Its weight is its","type":"text"},{"text":" ","type":"text"},{"text":"number of edges. O(m α(n)), with no sort.","type":"text"}],"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree()"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"abstract":[{"text":"Borůvka’s algorithm (JGraphT’s ","type":"text"},{"code":"BoruvkaMinimumSpanningTree","type":"codeVoice"},{"text":", NetworkX’s ","type":"text"},{"code":"'boruvka'","type":"codeVoice"},{"text":"): in","type":"text"},{"text":" ","type":"text"},{"text":"each round every component takes its lightest edge to another component, under the strict","type":"text"},{"text":" ","type":"text"},{"text":"order (weight, position), so a round cannot close a cycle. The canonical minimum spanning","type":"text"},{"text":" ","type":"text"},{"text":"forest of ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":", the same edges as Kruskal’s, listed by round and","type":"text"},{"text":" ","type":"text"},{"text":"in an unspecified order within a round.","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"boruvkaMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningFo