"tokens":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}]}],"kind":"declarations"}],"sections":[],"kind":"symbol","references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"abstract":[{"text":"Borůvka’s algorithm (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"BoruvkaMinimumSpanningTree"},{"text":", NetworkX’s ","type":"text"},{"type":"codeVoice","code":"'boruvka'"},{"text":"): in","type":"text"},{"text":" ","type":"text"},{"text":"each round every component takes its lightest edge to another component, under the strict","type":"text"},{"text":" ","type":"text"},{"text":"order (weight, position), so a round cannot close a cycle. The canonical minimum spanning","type":"text"},{"text":" ","type":"text"},{"text":"forest of ","type":"text"},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"text":", the same edges as Kruskal’s, listed by round and","type":"text"},{"text":" ","type":"text"},{"text":"in an unspecified order within a round.","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"boruvkaMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/boruvkaMinimumSpanningTree(weight:)","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/boruvkaminimumspanningtree(weight:)","kind":"symbol","title":"boruvkaMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/maximumSpanningTree(weight:)":{"title":"maximumSpanningTree(weight:)","role":"symbol","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/maximumSpanningTree(weight:)","abstract":[{"type":"text","text":"A maximum spanning forest (NetworkX’s "},{"type":"codeVoice","code":"maximum_spanning_tree"},{"type":"text","text":"), by Kruskal’s algorithm with"},{"type":"text","text":" "},{"type":"text","text":"the comparison reversed, never by negating, so unsigned weights work. Among equal weights"},{"type":"text","text":" "},{"text":"the earlier position wins, as for the minimum; edges are listed in nonincreasing weight.","type":"text"}],"kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/maximumspanningtree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"title":"GraphProtocols","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(weight:)":{"abstract":[{"type":"text","text":"Prim’s algorithm over every component (NetworkX, JGraphT, igraph): grows a tree from the"},{"type":"text","text":" "},{"type":"text","text":"first unspanned vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, joining the lightest edge out of it each step,"},{"type":"text","text":" "},{"type":"text","text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,"},{"type":"text","text":" "},{"type":"text","text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the"},{"type":"text","text":" "},{"type":"text","text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a"},{"type":"text","text":" "},{"type":"text","text":"spanned vertex to a new one; the weight is added up in that order."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"primMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(weight:)","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)","kind":"symbol","title":"primMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree()":{"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree()","abstract":[{"type":"text","text":"A spanning forest of the graph unweighted, every edge weighing 1 (NetworkX’s default"},{"type":"text","text":" "},{"type":"text","text":"weight, igraph’s unweighted mode): the first forest in position order, which takes an edge"},{"type":"text","text":" "},{"type":"text","text":"exactly when it joins two components of the edges taken before it. Its weight is its"},{"type":"text","text":" "},{"type":"text","text":"number of edges. O(m α(n)), with no sort."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree()","title":"minimumSpanningTree()","role":"symbol","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":{"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"and igraph’s "},{"type":"codeVoice","code":"minimum_spanning_tree"},{"type":"text","text":")."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)","kind":"symbol","title":"minimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees":{"title":"SpanningTrees","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","abstract":[],"url":"\/documentation\/spanningtrees"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/kruskalMinimumSpanningTree(weight:)":{"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/kruskalminimumspanningtree(weight:)","abstract":[{"text":"Kruskal’s algorithm (Boost’s ","type":"text"},{"type":"codeVoice","code":"kruskal_minimum_spanning_tree"},{"text":", JGraphT’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"KruskalMinimumSpanningTree"},{"text":"): sorts the edges by (weight, position) and takes each edge","type":"text"},{"text":" ","type":"text"},{"text":"that joins two components, stopping once ","type":"text"},{"type":"codeVoice","code":"n − 1"},{"text":" are taken. The canonical minimum spanning","type":"text"},{"text":" ","type":"text"},{"text":"forest of ","type":"text"},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"text":", with edges in the order taken.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kruskalMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kruskalMinimumSpanningTree(weight:)","title":"kruskalMinimumSpanningTree(weight:)","role":"symbol","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtoco