":"text","text":"A maximum spanning forest (NetworkX’s "},{"type":"codeVoice","code":"maximum_spanning_tree"},{"type":"text","text":"), by Kruskal’s algorithm with"},{"type":"text","text":" "},{"type":"text","text":"the comparison reversed, never by negating, so unsigned weights work. Among equal weights"},{"type":"text","text":" "},{"type":"text","text":"the earlier position wins, as for the minimum; edges are listed in nonincreasing weight."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/maximumSpanningTree(weight:)","type":"topic","role":"symbol","title":"maximumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(weight:)":{"kind":"symbol","abstract":[{"text":"Prim’s algorithm over every component (NetworkX, JGraphT, igraph): grows a tree from the","type":"text"},{"text":" ","type":"text"},{"text":"first unspanned vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, joining the lightest edge out of it each step,","type":"text"},{"t