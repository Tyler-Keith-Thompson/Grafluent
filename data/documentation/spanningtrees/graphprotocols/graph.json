he canonical minimum spanning","type":"text"},{"text":" ","type":"text"},{"text":"forest of ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":", the same edges as Kruskal’s, listed by round and","type":"text"},{"text":" ","type":"text"},{"text":"in an unspecified order within a round.","type":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/boruvkaMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/kruskalMinimumSpanningTree(weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kruskalMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/kruskalminimumspanningtree(weight:)","role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kruskalMinimumSpanningTree(weight:)","kind":"symbol","title":"kruskalMinimumSpanningTree(weight:)","type":"topic","abstract":[{"type":"text","text":"Kruskal’s algorithm (Boost’s "},{"type":"codeVoice","code":"kruskal_minimum_spanning_tree"},{"type":"text","text":", JGraphT’s"},{"type":"text","text":" "}