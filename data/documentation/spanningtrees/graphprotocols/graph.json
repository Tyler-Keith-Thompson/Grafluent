Prim’s algorithm from ","type":"text"},{"type":"codeVoice","code":"root"},{"text":" (Boost’s ","type":"text"},{"type":"codeVoice","code":"prim_minimum_spanning_tree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"root_vertex"},{"text":"): a","type":"text"},{"text":" ","type":"text"},{"text":"minimum spanning tree of ","type":"text"},{"type":"codeVoice","code":"root"},{"text":"‘s connected component only. Only that component’s edges","type":"text"},{"text":" ","type":"text"},{"text":"are weighed.","type":"text"}],"title":"primMinimumSpanningTree(from:weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"primMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(f