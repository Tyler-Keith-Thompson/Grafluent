text":"and igraph’s ","type":"text"},{"type":"codeVoice","code":"minimum_spanning_tree"},{"text":").","type":"text"}],"type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph","role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","title":"Graph","type":"topic","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(from:weight:)":{"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(from:weight:)","title":"primMinimumSpanningTree(from:weight:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","type":"topic","abstract":[{"type":"text","text":"Prim’s algorithm from "},{"type":"codeVoice","code":"root"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"prim_minimum_spanning_tree"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root_vertex"},{"type":"text","text":"): a"},{"type":"text","text":" "},{"type":"text","text":"minimum spanning tree of "},{"type":"codeVoice","code":"root"},{"type":"text","text":"‘s connected component only. Only that component’s edges"},{"type":"text","text":" "},{"type":"text","text":"are weighed."}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)","role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(weight:)","kind":"symbol","title":"primMinimumSpanningTree(weight:)","type":"topic","abstract":[{"text":"Prim’s algorithm over every component (NetworkX, JGraphT, igraph): grows a tree from the","type":"text"},{"text":" ","type":"text"},{"text":"first unspanned vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, joining the lightest edge out of it each step,","type":"text"},{"text":" ","type":"text"},{"text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,","type":"text"},{"text":" ","type":"text"},{"text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the","type":"text"},{"text":" ","type":"text"},{"text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a","type":"text"},{"text":" ","type":"text"},{"text":"spanned vertex to a new one; the weight is added up in that order.","type":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"url":"\/documentation\/spanningtrees\/graphprotocols","title":"GraphProtocols","role":"collection","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","type":"topic","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/graphprotocols\/graph","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"symbol","title":"Graph","type":"topic","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree()":{"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree()","title":"minimumSpanningTree()","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"type":"text","text":"A spanning forest of the graph unweighted, every edge weighing 1 (NetworkX’s default"},{"type":"text","text":" "},{"type":"text","text":"weight, igraph’s unweighted mode): the first forest in position order, which takes an edge"},{"type":"text","text":" "},{"type":"text","text":"exactly when it joins two components of the edges taken before it. Its weight is its"},{"type":"text","text":" "},{"type":"text","text":"number of edges. O(m α(n)), with no sort."}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree()"}}}