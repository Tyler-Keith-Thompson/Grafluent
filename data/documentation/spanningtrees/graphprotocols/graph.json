":"identifier","text":"primMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"abstract":[{"text":"Prim’s algorithm from ","type":"text"},{"type":"codeVoice","code":"root"},{"text":" (Boost’s ","type":"text"},{"type":"codeVoice","code":"prim_minimum_spanning_tree"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"root_vertex"},{"text":"): a","type":"text"},{"text":" ","type":"text"},{"text":"minimum spanning tree of ","type":"text"},{"type":"codeVoice","code":"root"},{"text":"‘s connected component only. Only that component’s edges","type":"text"},{"text":" ","type":"text"},{"text":"are weighed.","type":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","title":"primMinimumSpanningTree(from:weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/maximumSpanningTree(weight:)":{"role":"symbol","abstract":[{"text":"A maximum spanning forest (NetworkX’s ","type":"text"},{"code":"maximum_spanning_tree","type":"codeVoice"},{"text":"), by Kruskal’s algorithm with","type":"text"},{"text":" ","type":"text"},{"text":"the comparison reversed, never by negating, so unsigned weights work. Among equal weights","type":"text"},{"text":" ","type":"text"},{"text":"the earlier position wins, as for the minimum; edges are listed in nonincreasing weight.","type":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/maximumSpanningTree(weight:)","title":"maximumSpanningTree(weight:)","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/maximumspanningtree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees":{"abstract":[],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","kind":"symbol","url":"\/documentation\/spanningtrees","title":"SpanningTrees","role":"collection"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/kruskalMinimumSpanningTree(weight:)":{"role":"symbol","identifier":"doc:\/\/Spa