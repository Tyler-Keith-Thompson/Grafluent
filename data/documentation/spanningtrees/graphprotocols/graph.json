ningTree(weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(weight:)"],"anchor":"Instance-Methods","generated":true}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"boruvkaMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","title":"boruvkaMinimumSpanningTree(weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/boruvkaMinimumSpanningTree(weight:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/boruvkaminimumspanningtree(weight:)","kind":"symbol","abstract":[{"type":"text","text":"Borůvka’s algorithm (JGraphT’s "},{"code":"BoruvkaMinimumSpanningTree","type":"codeVoice"},{"type":"text","text":", NetworkX’s "},{"code":"'boruvka'","type":"codeVoice"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"each round every component takes its lightest edge to another component, under the strict"},{"type":"text","text":" "},{"type":"text","text":"order (weight, position), so a round cannot close a cycle. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":", the same edges as Kruskal’s, listed by round and"},{"type":"text","text":" "},{"type":"text","text":"in an unspecified order within a round."}],"role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/kruskalMinimumSpanningTree(weight:)":{"kind":"symbol","title":"kruskalMinimumSpanningTree(weight:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/kruskalminimumspanningtree(weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kruskalMinimumSpanningTree(weight:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kruskalMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"Kruskal’s algorithm (Boost’s "},{"code":"kruskal_minimum_spanning_tree","type":"codeVoice"},{"type":"text","text":", JGraphT’s"},{"type":"text","text":" "},{"code":"KruskalMinimumSpanningTree","type":"codeVoice"},{"type":"text","text":"): sorts the edges by (weight, position) and takes each edge"},{"type":"text","text":" "},{"type":"text","text":"that joins two components, stopping once "},{"code":"n − 1","type":"codeVoice"},{"type":"text","text":" are taken. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":", with edges in the order taken."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"one, and no type is both. "},{"code":"directed","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(from:weight:)":{"kind":"symbol","title":"primMinimumSpanningTree(from:weight:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(from:weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTre