ype":"text"},{"text":" ","type":"text"},{"code":"KruskalMinimumSpanningTree","type":"codeVoice"},{"text":"): sorts the edges by (weight, position) and takes each edge","type":"text"},{"text":" ","type":"text"},{"text":"that joins two components, stopping once ","type":"text"},{"code":"n − 1","type":"codeVoice"},{"text":" are taken. The canonical minimum spanning","type":"text"},{"text":" ","type":"text"},{"text":"forest of ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":", with edges in the order taken.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","title":"Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphprotocols\/graph","type":"topic","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","title":"Graph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","abstract":[