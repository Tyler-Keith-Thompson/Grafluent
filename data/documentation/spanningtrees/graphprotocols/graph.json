gorithm from "},{"code":"root","type":"codeVoice"},{"type":"text","text":" (Boost’s "},{"code":"prim_minimum_spanning_tree","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root_vertex","type":"codeVoice"},{"type":"text","text":"): a"},{"type":"text","text":" "},{"type":"text","text":"minimum spanning tree of "},{"code":"root","type":"codeVoice"},{"type":"text","text":"‘s connected component only. Only that component’s edges"},{"type":"text","text":" "},{"type":"text","text":"are weighed."}],"title":"primMinimumSpanningTree(from:weight:)","kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(from:weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"primMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/boruvkaMinimumSpanningTree(weight:)","kind":"symbol","abstract":[{"type":"text","text":"Borůvka’s algorithm (JGraphT’s "},{"type":"codeVoice","code":"BoruvkaMinimumSpanningTree"},{"type":"text","text":", NetworkX’s "},{"type":"codeVoice","code":"'boruvka'"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"each round every component takes its lightest edge to another component, under the strict"},{"type":"text","text":" "},{"type":"text","text":"order (weight, position), so a round cannot close a cycle. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", the same edges as Kruskal’s, listed by round and"},{"type":"text","text":" "},{"type":"text","text":"in an unspecified order within a round."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"boruvkaMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/boruvkaminimumspanningtree(weight:)","title":"boruvkaMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree()":{"title":"minimumSpanningTree()","abstract":[{"text":"A spanning forest of the graph unweighted, every edge weighing 1 (NetworkX’s default","type":"text"},{"text":" ","type":"text"},{"text":"weight, igraph’s unweighted mode): the first forest in position order, which takes an edge","type":"text"},{"text":" ","type":"text"},{"text":"exactly when it joins two components of the edges taken before it. Its weight is its","type":"text"},{"text":" ","type":"text"},{"text":"number of edges. O(m α(n)), with no sort.","type":"text"}],"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree()","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}],"kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"type":"topic","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","title":"Graph"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/maximumSpanningTree(weight:)":{"title":"maximumSpanningTree(weight:)","abstract":[{"type":"text","text":"A maximum spanning forest (NetworkX’s "},{"type":"codeVoice","code":"maximum_spanning_tree"},{"type":"text","text":"), by Kruskal’s algorithm with"},{"type":"text","text":" "},{"type":"text","text":"the comparison reversed, never by negating, so unsigned weights work. Among equal weights"},{"type":"text","text":" "},{"type":"text","text":"the earlier position wins, as for the minimum; edges are listed in nonincreasing weight."}],"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/maximumspanningtree(weight:)","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/maximumSpanningTree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(weight:)":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(weight:)","kind":"symbol","abstract":[{"type":"text","text":"Prim’s algorithm over every component (NetworkX, JGraphT, igraph): grows a tree from the"},{"type":"text","text":" "},{"type":"text","text":"first unspanned vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, joining the lightest edge out of it each step,"},{"type":"text","text":" "},{"type":"text","text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,"},{"type":"text","text":" "},{"type":"text","text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the"},{"type":"text","text":" "},{"type":"text","text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a"},{"type":"text","text":" "},{"type":"text","text":"spanned vertex to a new one; the weight is added up in that order."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)","title":"primMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":{"title":"minimumSpanningTree(weight:)","abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"and igraph’s "},{"type":"codeVoice","code":"minimum_spanning_tree"},{"type":"text","text":")."}],"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"kind":"symbol"}}}