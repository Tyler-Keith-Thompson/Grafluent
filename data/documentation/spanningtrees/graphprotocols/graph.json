t of it each step,"},{"type":"text","text":" "},{"type":"text","text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,"},{"type":"text","text":" "},{"type":"text","text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the"},{"type":"text","text":" "},{"type":"text","text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a"},{"type":"text","text":" "},{"type":"text","text":"spanned vertex to a new one; the weight is added up in that order."}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"boruvkaMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/boruvkaMinimumSpanningTree(weight:)","abstract":[{"type":"text","text":"Borůvka’s algorithm (JGraphT’s "},{"type":"codeVoice","code":"BoruvkaMinimumSpanningTree"},{"type":"text","text":", NetworkX’s "},{"type":"codeVoice","code":"'boruvka'"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"each round every component takes its lightest edge to another component, under the strict"},{"type":"text","text":" "},{"type":"text","text":"order (weight, position), so a round cannot close a cycle. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", the same edges as Kruskal’s, listed by round and"},{"type":"text","text":" "},{"type":"text","text":"in an unspecified order within a round."}],"title":"boruvkaMinimumSpanningTree(weight:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/boruvkaminimumspanningtree(weight:)","role":"symbol","type":"topic","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees":{"role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","url":"\/documentation\/spanningtrees","kind":"symbol","type":"topic","title":"SpanningTrees","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/maximumSpanningTree(weight:)":{"role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/maximumSpanningTree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdent