:"text","text":" "},{"type":"text","text":"order (weight, position), so a round cannot close a cycle. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":", the same edges as Kruskal’s, listed by round and"},{"type":"text","text":" "},{"type":"text","text":"in an unspecified order within a round."}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"and igraph’s "},{"type":"codeVoice","code":"minimum_spanning_tree"},{"type":"text","text":")."}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","role":"symbol","title":"minimumSpanningTree(weight:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)","type