anguages":["swift"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"},"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols","kind":"symbol","role":"collection","abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree()":{"abstract":[{"type":"text","text":"A spanning forest of the graph unweighted, every edge weighing 1 (NetworkX’s default"},{"type":"text","text":" "},{"type":"text","text":"weight, igraph’s unweighted mode): the first forest in position order, which takes an edge"},{"type":"text","text":" "},{"type":"text","text":"exactly when it joins two components of the edges taken before it. Its weight is its"},{"type":"text","text":" "},{"type":"text","text":"number of edges. O(m α(n)), with no sort."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree()","kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree()","title":"minimumSpanningTree()","role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(weight:)":{"type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"primMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"Prim’s algorithm over every component (NetworkX, JGraphT, igraph): grows a tree from the"},{"type":"text","text":" "},{"type":"text","text":"first unspanned vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, joining the lightest edge out of it each step,"},{"type":"text","text":" "},{"type":"text","text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,"},{"type":"text","text":" "},{"type":"text","text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the"},{"type":"text","text":" "},{"type":"text","text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a"},{"type":"text","text":" "},{"type":"text","text":"spanned vertex to a new one; the weight is added up in that order."}],"title":"primMinimumSpanningTree(weight:)","identifier"