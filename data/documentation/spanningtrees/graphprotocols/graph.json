SpanningTree"},{"type":"text","text":"): sorts the edges by (weight, position) and takes each edge"},{"type":"text","text":" "},{"type":"text","text":"that joins two components, stopping once "},{"type":"codeVoice","code":"n − 1"},{"type":"text","text":" are taken. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", with edges in the order taken."}],"kind":"symbol","title":"kruskalMinimumSpanningTree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kruskalMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kruskalMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"url":"\/documentation\/spanningtrees\/graphprotocols","role":"collection","title":"GraphProtocols","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","kind":"symbol","abstract":[],"type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree()":{"kind":"