rest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A spanning forest of the graph unweighted, every edge weighing 1 (NetworkX’s default"},{"type":"text","text":" "},{"type":"text","text":"weight, igraph’s unweighted mode): the first forest in position order, which takes an edge"},{"type":"text","text":" "},{"type":"text","text":"exactly when it joins two components of the edges taken before it. Its weight is its"},{"type":"text","text":" "},{"type":"text","text":"number of edges. O(m α(n)), with no sort."}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","title":"GraphProtocols","role":"collection","kind":"symbol","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","abstract":[],"title":"Graph","kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/maximumSpanningTree(weight:)":{"kind":"symbol","title":"maximumSpanningTree(weight:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/maximumspanningtree(weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/maximumSpanningTree(weight:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"A maximum spanning forest (NetworkX’s ","type":"text"},{"type":"codeVoice","code":"maximum_spanning_tree"},{"text":"), by Kruskal’s algorithm with","type":"text"},{"text":" ","type":"text"},{"text":"the comparison reversed, never by negating, so unsigned weights work. Among equal weights","type":"text"},{"text":" ","type":"text"},{"text":"the earlier position wins, as for the minimum; edges are listed in nonincreasing weight.","type":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(weight:)":{"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(weight:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)","title":"primMinimumSpanningTree(weight:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"Prim’s algorithm over every component (NetworkX, JGraphT, igraph): grows a tree from the","type":"text"},{"text":" ","type":"text"},{"text":"first unspanned vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, joining the lightest edge out of it each step,","type":"text"},{"text":" ","type":"text"},{"text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,","type":"text"},{"text":" ","type":"text"},{"text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the","type":"text"},{"text":" ","type":"text"},{"text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a","type":"text"},{"text":" ","type":"text"},{"text":"spanned vertex to a new one; the weight is added up in that order.","type":"text"}]}}}