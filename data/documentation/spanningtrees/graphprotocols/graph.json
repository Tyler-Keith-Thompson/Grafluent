ningTrees\/documentation\/SpanningTrees","title":"SpanningTrees","role":"collection","abstract":[],"url":"\/documentation\/spanningtrees"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"type":"topic","title":"boruvkaMinimumSpanningTree(weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/boruvkaMinimumSpanningTree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"boruvkaMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/boruvkaminimumspanningtree(weight:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Borůvka’s algorithm (JGraphT’s "},{"type":"codeVoice","code":"BoruvkaMinimumSpanningTree"},{"type":"text","text":", NetworkX’s "},{"type":"codeVoice","code":"'boruvka'"},{"type":"text","text":"): in"},{"type":"text","text":" "},{"type":"text","text":"each round every component takes its lightest edge to another component, under the strict"},{"type":"text","text":" "},{"type":"text","text":"order (weight, position), so a round cannot close a cycle. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", the same edges as Kruskal’s, listed by round and"},{"type":"text","text":" "},{"type":"text","text":"in an unspecified order within a round."}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":{"kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","type":"topic","role":"symbol","title":"minimumSpanningTree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"and igraph’s "},{"type":"codeVoice","code":"minimum_spanning_tree"},{"type":"text","text":")."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"url":"\/documentation\/graphprotocols\/graph","kind":"symbol","role":"symbol","type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(from:weight:)":{"kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(from:weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","type":"topic","role":"symbol","title":"primMinimumSpanningTree(from:weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtoc