when it joins two components of the edges taken before it. Its weight is its","type":"text"},{"text":" ","type":"text"},{"text":"number of edges. O(m α(n)), with no sort.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"minimumSpanningTree()","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree()"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/kruskalMinimumSpanningTree(weight:)":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kruskalMinimumSpanningTree(weight:)","role":"symbol","type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/kruskalminimumspanningtree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kruskalMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"Kruskal’s algorithm (Boost’s "},{"type":"codeVoice","code":"kruskal_minimum_spanning_tree"},{"type":"text","text":", JGraphT’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"KruskalMinimumSpanningTree"},{"type":"text","text":"): sorts the edges by (weight, position) and takes each edge"},{"type":"text","text":" "},{"type":"text","text":"that joins two components, stopping once "},{"type":"codeVoice","code":"n − 1"},{"type":"text","text":" are taken. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", with edges in the order taken."}],"kind":"symbol","title":"kruskalMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(weight:)":{"type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)","abstract":[{"text":"Prim’s algorithm over every component (NetworkX, JGraphT, igraph): grows a tree from the","type":"text"},{"text":" ","type":"text"},{"text":"first unspanned vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, joining the lightest edge out of it each step,","type":"text"},{"text":" ","type":"text"},{"text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,","type":"text"},{"text":" ","type":"text"},{"text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the","type":"text"},{"text":" ","type":"text"},{"text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a","type":"text"},{"text":" ","type":"text"},{"text":"spanned vertex to a new one; the weight is added up in that order.","type":"text"}],"title":"primMinimumSpanningTree(weight:)","fragments":[{"kind":"keyword","te