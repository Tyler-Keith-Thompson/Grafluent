osition wins, as for the minimum; edges are listed in nonincreasing weight."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/primMinimumSpanningTree(from:weight:)":{"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(from:weight:)","role":"symbol","abstract":[{"text":"Prim’s algorithm from ","type":"text"},{"code":"root","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"prim_minimum_spanning_tree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"root_vertex","type":"codeVoice"},{"text":"): a","type":"text"},{"text":" ","type":"text"},{"text":"minimum spanning tree of ","type":"text"},{"code":"root","type":"codeVoice"},{"text":"‘s connected component only. Only that component’s edges","type":"text"},{"text":" ","type":"text"},{"text":"are weighed.","type":"text"}],"title":"primMinimumSpanningTree(from:weight:)","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(from:weight:)","fragments":[{"text":"func","kind":"