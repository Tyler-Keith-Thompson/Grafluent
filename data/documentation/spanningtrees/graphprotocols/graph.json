:"codeVoice"},{"text":" order, joining the lightest edge out of it each step,","type":"text"},{"text":" ","type":"text"},{"text":"and repeats until every vertex is spanned. A minimum spanning forest; among equal weights,","type":"text"},{"text":" ","type":"text"},{"text":"which edges it chooses is unspecified (a canonical choice is measurably slower; see the","type":"text"},{"text":" ","type":"text"},{"text":"benchmarks). Edges are listed in the order their far vertices joined, so each joins a","type":"text"},{"text":" ","type":"text"},{"text":"spanned vertex to a new one; the weight is added up in that order.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/boruvkaminim