m α(n)), with no sort."}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/kruskalMinimumSpanningTree(weight:)":{"kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kruskalMinimumSpanningTree(weight:)","abstract":[{"type":"text","text":"Kruskal’s algorithm (Boost’s "},{"type":"codeVoice","code":"kruskal_minimum_spanning_tree"},{"type":"text","text":", JGraphT’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"KruskalMinimumSpanningTree"},{"type":"text","text":"): sorts the edges by (weight, position) and takes each edge"},{"type":"text","text":" "},{"type":"text","text":"that joins two components, stopping once "},{"type":"codeVoice","code":"n − 1"},{"type":"text","text":" are taken. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":", with edges in the order taken."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kruskalMinimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A