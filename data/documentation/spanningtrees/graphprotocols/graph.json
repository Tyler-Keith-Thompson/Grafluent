mSpanningTree(weight:)","abstract":[{"type":"text","text":"Kruskal’s algorithm (Boost’s "},{"code":"kruskal_minimum_spanning_tree","type":"codeVoice"},{"type":"text","text":", JGraphT’s"},{"type":"text","text":" "},{"code":"KruskalMinimumSpanningTree","type":"codeVoice"},{"type":"text","text":"): sorts the edges by (weight, position) and takes each edge"},{"type":"text","text":" "},{"type":"text","text":"that joins two components, stopping once "},{"code":"n − 1","type":"codeVoice"},{"type":"text","text":" are taken. The canonical minimum spanning"},{"type":"text","text":" "},{"type":"text","text":"forest of "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":", with edges in the order taken."}],"kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/kruskalminimumspanningtree(weight:)","role":"symbol","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kruskalMinimumSpanningTree(weight:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree()":{"title":"minimumSpanningTree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree()","kind":"symbol","abstract":[{"text":"A spanning forest of the graph unweighted, every edge weighing 1 (NetworkX’s default","type":"text"},{"text":" ","type":"text"},{"text":"weight, igraph’s unweighted mode): the first forest in position order, which takes an edge","type":"text"},{"text":" ","type":"text"},{"text":"exactly when it joins two components of the edges taken before it. Its weight is its","type":"text"},{"text":" ","type":"text"},{"text":"number of edges. O(m α(n)), with no sort.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree()"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"title":"GraphProtocols","abstract":[],"url":"\/documentation\/spanningtrees\/graphprotocols","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"title":"Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphprotocols\/graph","kind":"symbol","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"}}}