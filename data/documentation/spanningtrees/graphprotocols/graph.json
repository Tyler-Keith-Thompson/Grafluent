nd":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(from:weight:)","kind":"symbol","abstract":[{"text":"Prim’s algorithm from ","type":"text"},{"code":"root","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"prim_minimum_spanning_tree","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"root_vertex","type":"codeVoice"},{"text":"): a","type":"text"},{"text":" ","type":"text"},{"text":"minimum spanning tree of ","type":"text"},{"code":"root","type":"codeVoice"},{"text":"‘s connected component only. Only that component’s edges","type":"text"},{"text":" ","type":"text"},{"text":"are weighed.","type":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees":{"type":"topic","title":"SpanningTrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","kind":"symbol","abstract":[],"role":"collection","url":"\/documentation\/spanningtrees"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/maximumSpanningTree(weight:)":{"type":"topic","title":"maximumSpanningTree(weight:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/maximumSpanningTree(weight:)","abstract":[{"type":"text","text":"A maximum spanning forest (NetworkX’s "},{"code":"maximum_spanning_tree","type":"codeVoice"},{"type":"text","text":"), by Kruskal’s algorithm with"},{"type":"text","text":" "},{"type":"text","text":"the comparison reversed, never by negating, so unsigned weights work. Among equal weights"},{"type":"text","text":" "},{"type":"text","text":"the earlier position wins, as for the minimum; edges are listed in nonincreasing weight."}],"kind":"symbol","role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/maximumspanningtree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"url":"\/documentation\/graphprotocols\/graph","title":"Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/boruvkaMinimumSpanningTree(weight:)":{"type":"topic","title":"boruvkaMinimumSpanningTree(weight:)","identifier":"d