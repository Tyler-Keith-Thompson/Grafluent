{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"kind":"symbol","identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"metadata":{"title":"minimumSpanningTree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L24","fileName":"Kruskal.swift"},"role":"symbol","extendedModule":"GraphProtocols","symbolKind":"method","externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpanningTrees"}]},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"and igraph’s "},{"code":"minimum_spanning_tree","type":"codeVoice"},{"type":"text","text":")."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Ties."}],"type":"strong"},{"text":" Edges are ordered by weight, then by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":". Under that strict order","type":"text"},{"text":" ","type":"text"},{"text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the","type":"text"},{"text":" ","type":"text"},{"text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position","type":"text"},{"text":" ","type":"text"},{"text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse","type":"text"},{"text":" ","type":"text"},{"text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a","type":"text"},{"text":" ","type":"text"},{"text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX instead offers "},{"type":"codeVoice","code":"ignore_nan"},{"type":"text","text":"; filter such edges out first)."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}]},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is NaN; the sum of the chosen weights, in the order listed, does"},{"type":"text","text":" "},{"type":"text","text":"not overflow and is not NaN."}]}]}]}],"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","type":"topic","abstract":[],"title":"SpanningTrees","url":"\/documentation\/spanningtrees","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","kind":"symbol","abstract":[],"type":"topic","title":"GraphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","role":"collection"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","type":"topic","abstract":[],"title":"Graph","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"abstract":[],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","title":"Edges","type":"topic","role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanningForest","kind":"identifier"}],"abstract":[{"text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in the graph’s ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", with the sum of their weights (JGraphT’s ","type":"text"},{"code":"SpanningTree","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"getEdges","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"getWeight","type":"codeVoice"},{"text":" these are).","type":"text"}],"type":"topic","url":"\/documentation\/spanningtrees\/spanningforest","title":"SpanningForest","role":"symbol","navigatorTitle":[{"text":"SpanningForest","kind":"identifier"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"and igraph’s "},{"type":"codeVoice","code":"minimum_spanning_tree"},{"type":"text","text":")."}],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)","type":"topic","title":"minimumSpanningTree(weight:)","role":"symbol"}}}