{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)"},"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component."}],"metadata":{"title":"minimumSpanningTree(weight:)","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","symbolKind":"method","role":"symbol","roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Edges are ordered by weight, then by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":". Under that order the minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning forest is unique, and this is it. Its edges are listed in nondecreasing weight"},{"type":"text","text":" "},{"type":"text","text":"and, among equal weights, in position order, and the weight is added up in that order."},{"type":"text","text":" "},{"type":"text","text":"Sparse graphs (fewer than 4 edges per vertex) run Kruskal’s algorithm; denser ones run"},{"type":"text","text":" "},{"type":"text","text":"Prim’s under the same order and sort the edges taken."}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives each edge’s weight from its position, so parallel edges can differ. It is","type":"text"},{"text":" ","type":"text"},{"text":"called once for each edge that is not a self-loop and is not kept. Negative, zero and","type":"text"},{"text":" ","type":"text"},{"text":"infinite weights are ordinary weights. A NaN weight traps; filter such edges out first.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is NaN; the sum of the chosen weights, in the order listed, does"},{"type":"text","text":" "},{"type":"text","text":"not overflow and is not NaN."}]}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","abstract":[],"kind":"symbol","title":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sl","kind":"typeIdentifier","text":"Collection"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"abstract":[],"kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","role":"symbol","title":"Graph"},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"navigatorTitle":[{"kind":"identifier","text":"SpanningForest"}],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpanningForest"}],"kind":"symbol","url":"\/documentation\/spanningtrees\/spanningforest","abstract":[{"text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in the graph’s ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", with the sum of their weights.","type":"text"}],"role":"symbol","title":"SpanningForest"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","abstract":[],"kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols","role":"collection","title":"GraphProtocols"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":{"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},