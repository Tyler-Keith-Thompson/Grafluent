d":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"}],"title":"Edges","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"symbol","type":"topic","role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"title":"SpanningForest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanningForest","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","url":"\/documentation\/spanningtrees\/spanningforest","abstract":[{"type":"text","text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge"},{"type":"text","text":" "},{"type":"text","text":"positions in the graph’s "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", with the sum of their weights."}],"role":"symbol","navigatorTitle":[{"text":"SpanningForest","kind":"identifier"}],"type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees":{"type":"topic","title":"SpanningTrees","url":"\/documentation\/spanningtrees","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","kind":"symbol","abstract":[]}}}