{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ties."}]},{"text":" Edges are ordered by weight, then by position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":". Under that strict order","type":"text"},{"text":" ","type":"text"},{"text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the","type":"text"},{"text":" ","type":"text"},{"text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position","type":"text"},{"text":" ","type":"text"},{"text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse","type":"text"},{"text":" ","type":"text"},{"text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a","type":"text"},{"text":" ","type":"text"},{"text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks).","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives each edge’s weight from its position, so parallel edges can differ. It is","type":"text"},{"text":" ","type":"text"},{"text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept.","type":"text"},{"text":" ","type":"text"},{"text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX instead offers ","type":"text"},{"code":"ignore_nan","type":"codeVoice"},{"text":"; filter such edges out first).","type":"text"}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"text":"No weight is NaN; the sum of the chosen weights, in the order listed, does","type":"text"},{"text":" ","type":"text"},{"text":"not overflow and is not NaN.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"role":"symbol","title":"minimumSpanningTree(weight:)","externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","extendedModule":"GraphProtocols","remoteSo