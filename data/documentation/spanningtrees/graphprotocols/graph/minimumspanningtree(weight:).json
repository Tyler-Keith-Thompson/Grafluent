{"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"sections":[],"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"minimumSpanningTree(weight:)","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L21","fileName":"Kruskal.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"symbolKind":"method","extendedModule":"GraphProtocols"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Edges are ordered by weight, then by position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":". Under that order the minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning forest is unique, and this is it. Its edges are listed in nondecreasing weight"},{"type":"text","text":" "},{"type":"text","text":"and, among equal weights, in position order, and the weight is added up in that order."},{"type":"text","text":" "},{"type":"text","text":"Sparse graphs (fewer than 4 edges per vertex) run Kruskal’s algorithm; denser ones run"},{"type":"text","text":" "},{"type":"text","text":"Prim’s under the same order and sort the edges taken."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"text":" gives each edge’s weight from its position, so parallel edges can differ. It is","type":"text"},{"text":" ","type":"text"},{"text":"called once for each edge that is not a self-loop and is not kept. Negative, zero and","type":"text"},{"text":" ","type":"text"},{"text":"infinite weights are ordinary weights. A NaN weight traps; filter such edges out first.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}],"name":"Complexity","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"No weight is NaN; the sum of the chosen weights, in the order listed, does","type":"text"},{"text":" ","type":"text"},{"text":"not overflow and is not NaN.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","title":"Graph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P",