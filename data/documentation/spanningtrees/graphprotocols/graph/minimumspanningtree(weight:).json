{"kind":"symbol","metadata":{"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","symbolKind":"method","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"title":"minimumSpanningTree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"roleHeading":"Instance Method","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L24","fileName":"Kruskal.swift"}},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ties."}],"type":"strong"},{"type":"text","text":" Edges are ordered by weight, then by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":". Under that strict order"},{"type":"text","text":" "},{"type":"text","text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the"},{"type":"text","text":" "},{"type":"text","text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position"},{"type":"text","text":" "},{"type":"text","text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a"},{"type":"text","text":" "},{"type":"text","text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks)."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX instead offers "},{"type":"codeVoice","code":"ignore_nan"},{"type":"text","text":"; filter such edges out first)."}],"type":"paragraph"},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}]},{"name":"Precondition","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is NaN; the sum of the chosen weights, in the order listed, does"},{"type":"text","text":" "},{"type":"text","text":"not overflow and is not NaN."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"text":"and igraph’s ","type":"text"},{"code":"minimum_spanning_tree","type":"codeVoice"},{"text":").","type":"text"}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"type":"topic","navigatorTitle":[{"text":"SpanningForest","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanningForest","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge"},{"type":"text","text":" "},{"type":"text","text":"positions in the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", with the sum of their weights (JGraphT’s "},{"type":"codeVoice","code":"SpanningTree"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"getEdges"},{"type":"text","text":" and "},{"type":"codeVoice","code":"getWeight"},{"type":"text","text":" these are)."}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","kind":"symbol","title":"SpanningForest","url":"\/documentation\/spanningtrees\/spanningforest"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text