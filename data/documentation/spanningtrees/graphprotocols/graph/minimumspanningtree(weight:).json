er"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"role":"symbol","kind":"symbol","title":"Edges","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sl","kind":"typeIdentifier","text":"Collection"}],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"role":"symbol","title":"SpanningForest","kind":"symbol","url":"\/documentation\/spanningtrees\/spanningforest","type":"topic","abstract":[{"type":"text","text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge"},{"type":"text","text":" "},{"type":"text","text":"positions in the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", with the sum of their weights."}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpanningForest"}],"navigatorTitle":[{"kind":"identifier","text":"SpanningForest"}]}}}