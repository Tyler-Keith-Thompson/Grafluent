{"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ties."}]},{"text":" Edges are ordered by weight, then by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":". Under that strict order","type":"text"},{"text":" ","type":"text"},{"text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the","type":"text"},{"text":" ","type":"text"},{"text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position","type":"text"},{"text":" ","type":"text"},{"text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse","type":"text"},{"text":" ","type":"text"},{"text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a","type":"text"},{"text":" ","type":"text"},{"text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX instead offers "},{"type":"codeVoice","code":"ignore_nan"},{"type":"text","text":"; filter such edges out first)."}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}]},{"style":"note","type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is NaN; the sum of the chosen weights, in the order listed, does"},{"type":"text","text":" "},{"type":"text","text":"not overflow and is not NaN."}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"metadata":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"title":"minimumSpanningTree(weight:)","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L24","fileName":"Kruskal.swift"}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"text":"and igraph’s ","type":"text"},{"co