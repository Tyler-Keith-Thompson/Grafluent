{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Edges are ordered by weight, then by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":". Under that order the minimum","type":"text"},{"text":" ","type":"text"},{"text":"spanning forest is unique, and this is it. Its edges are listed in nondecreasing weight","type":"text"},{"text":" ","type":"text"},{"text":"and, among equal weights, in position order, and the weight is added up in that order.","type":"text"},{"text":" ","type":"text"},{"text":"Sparse graphs (fewer than 4 edges per vertex) run Kruskal’s algorithm; denser ones run","type":"text"},{"text":" ","type":"text"},{"text":"Prim’s under the same order and sort the edges taken.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop and is not kept. Negative, zero and"},{"type":"text","text":" "},{"type":"text","text":"infinite weights are ordinary weights. A NaN weight traps; filter such edges out first."}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(m log m)."}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"No weight is NaN; the sum of the chosen weights, in the order listed, does","type":"text"},{"text":" ","type":"text"},{"text":"not overflow and is not NaN.","type":"text"}]}],"style":"note"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)"},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","role":"symbol","title":"minimumSpanningTree(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"SpanningTrees"}],"externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF"},"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"sections":[],"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"type":"topic","url":"\/documentation\/spanningtrees","role":"collection","title":"SpanningTrees","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"title":"GraphProtocols","kind":"symbol","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","abstract":[],"type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTree(weight:)":