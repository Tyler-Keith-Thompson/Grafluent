{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A minimum spanning forest: one minimum spanning tree per connected component.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Edges are ordered by weight, then by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":". Under that order the minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning forest is unique, and this is it. Its edges are listed in nondecreasing weight"},{"type":"text","text":" "},{"type":"text","text":"and, among equal weights, in position order, and the weight is added up in that order."},{"type":"text","text":" "},{"type":"text","text":"Sparse graphs (fewer than 4 edges per vertex) run Kruskal’s algorithm; denser ones run"},{"type":"text","text":" "},{"type":"text","text":"Prim’s under the same order and sort the edges taken."}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop and is not kept. Negative, zero and"},{"type":"text","text":" "},{"type":"text","text":"infinite weights are ordinary weights. A NaN weight traps; filter such edges out first."}],"type":"paragraph"},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(m log m)."}],"type":"paragraph"}]},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"text":"No weight is NaN; the sum of the chosen weights, in the order listed, does","type":"text"},{"text":" ","type":"text"},{"text":"not overflow and is not NaN.","type":"text"}],"type":"paragraph"}]}]}],"metadata":{"role":"symbol","extendedModule":"GraphProtocols","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L21","fileName":"Kruskal.swift"},"roleHeading":"Instance Method","title":"minimumSpanningTree(weight:)","externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"sections":[],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","kind":"symbol","type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"url":"\/documentation\/spanningtrees\/spanningforest","title":"SpanningForest","kind":"symbol","abstract":[{"type":"text","text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge"},{"type":"text","text":" "},{"type":"text","text":"positions in the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", with the sum of their weights."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpanningForest"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpanningForest"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","title":"Edges","kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sl","kind":"typeIdentifier","text":"Collection"}],"type":"topic","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},"doc://SpanningTrees/documentation/SpanningTrees":{"title":"SpanningTrees","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","abstract":[],"type":"topic","url":"\/documentation\/spanningtrees","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"url":"\/documentation\/spanningtrees\/graphprotocols","title":"GraphProtocols","kind":"symbol","abstract":[],"type":"topic","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTr