{"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"abstract":[{"type":"text","text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s"},{"type":"text","text":" "},{"type":"text","text":"and igraph’s "},{"type":"codeVoice","code":"minimum_spanning_tree"},{"type":"text","text":")."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ties."}],"type":"strong"},{"type":"text","text":" Edges are ordered by weight, then by position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":". Under that strict order"},{"type":"text","text":" "},{"type":"text","text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the"},{"type":"text","text":" "},{"type":"text","text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position"},{"type":"text","text":" "},{"type":"text","text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a"},{"type":"text","text":" "},{"type":"text","text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks)."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX instead offers "},{"type":"codeVoice","code":"ignore_nan"},{"type":"text","text":"; filter such edges out first)."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"name":"Complexity"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"No weight is NaN; the sum of the chosen weights, in the order listed, does"},{"type":"text","text":" "},{"type":"text","text":"not overflow and is not NaN."}],"type":"paragraph"}],"name":"Precondition"}],"kind":"content"}],"metadata":{"externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"title":"minimumSpanningTree(weight:)","symbolKind":"method","extendedModule":"GraphProtocols","roleHeading":"Instance Method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"fileName":"Kruskal.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L24"}},"references":{"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"abstract":[{"text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in the graph’s ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", with the sum of their weights (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"SpanningTree"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"type":"codeVoice","code":"getEdges"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"getWeight"},{"text":" these are).","type":"text"}],"title":"SpanningForest","kind":"symbol","url":"\/documentation\/spanningtrees\/spanningforest","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanningForest","kind":"identifier"}],"navigatorTitle":[{"text":"SpanningForest","kind":"identifier"}],"type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees":{"abstract":[],"title":"SpanningTrees","kind":"symbol","url":"\/documentation\/spanningtrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","role":"collection","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"abstract":[],"title":"Edges","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"type":"topic"},"doc://SpanningTrees/documentation/Spanni