{"sections":[],"abstract":[{"text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"text":"and igraph’s ","type":"text"},{"type":"codeVoice","code":"minimum_spanning_tree"},{"text":").","type":"text"}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"role":"symbol","title":"minimumSpanningTree(weight:)","extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"SpanningTrees"}],"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L24","fileName":"Kruskal.swift"},"roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Ties.","type":"text"}],"type":"strong"},{"text":" Edges are ordered by weight, then by position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":". Under that strict order","type":"text"},{"text":" ","type":"text"},{"text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the","type":"text"},{"text":" ","type":"text"},{"text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position","type":"text"},{"text":" ","type":"text"},{"text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse","type":"text"},{"text":" ","type":"text"},{"text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a","type":"text"},{"text":" ","type":"text"},{"text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX instead offers "},{"type":"codeVoice","code":"ignore_nan"},{"type":"text","text":"; filter such edges out first)."}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}]},{"style":"note","type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is NaN; the sum of the chosen weights, in the order listed, does"},{"type":"text","text":" "},{"type":"text","text":"not overflow and is not NaN."}]}]}]}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"title":"GraphProtocols","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"url":"\/documentation\/spanningtrees\/spanningforest","navigatorTitle":[{"text":"SpanningForest","kind":"identifier"}],"abstract":[{"type":"text","text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge"},{"type":"text","text":" "},{"type":"text","text":"positions in the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", with the sum of their weights (JGraphT’s "},{"type":"codeVoice","code":"SpanningTree"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"type":"codeVoice","code":"getEdges"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"getWeight"},{"text":" these are).","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanningForest","kind":"identifier"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","title":"SpanningForest","role":"symbol","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees":{"title":"SpanningTrees","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","abstract":[],"url":"\/documentation\/spanningtrees"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"