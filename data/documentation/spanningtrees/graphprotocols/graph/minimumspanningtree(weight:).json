les":["GraphProtocols"],"name":"SpanningTrees"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ties."}]},{"type":"text","text":" Edges are ordered by weight, then by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":". Under that strict order"},{"type":"text","text":" "},{"type":"text","text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the"},{"type":"text","text":" "},{"type":"text","text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position"},{"type":"text","text":" "},{"type":"text","text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a"},{"type":"text","text":" "},{"type":"text","text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks)."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX instead offers "},{"type":"codeVoice","code":"ignore_nan"},{"type":"text","text":"; filter such edges out first)."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O(m log m)."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"},{"content":[{"type":"paragraph","inlineContent":[{"text":"No weight is NaN; the sum of the chosen weights, in the order listed, does","type":"text"},{"text":" ","type":"text"},{"text":"not overflow and is not NaN.","type":"text"}]}],"type":"aside","style":"note","name":"Precondition"}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"text":"and igraph’s ","type":"text"},{"ty