"text":"and igraph’s ","type":"text"},{"code":"minimum_spanning_tree","type":"codeVoice"},{"text":").","type":"text"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Ties.","type":"text"}],"type":"strong"},{"type":"text","text":" Edges are ordered by weight, then by position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":". Under that strict order"},{"type":"text","text":" "},{"type":"text","text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the"},{"type":"text","text":" "},{"type":"text","text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position"},{"type":"text","text":" "},{"type":"text","text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a"},{"type":"text","text":" "},{"type":"text","text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks)."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept."},{"type":"text","text":" "},{"type":"text","text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX instead offers "},{"type":"codeVoice","code":"ignore_nan"},{"type":"text","text":"; filter such edges out first)."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"style":"note","name":"Complexity","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"No weight is NaN; the sum of the chosen weights, in the order listed, does"},{"type":"text","text":" "},{"type":"text","text":"not overflow and is not NaN."}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"}],"kind":"content"}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"url":"\/documentation\/spanningtrees\/graphprotocols","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","title":"GraphProtocols","role":"collection"},"doc://SpanningTrees/documentation/SpanningTrees":{"role":"collection","title":"SpanningTrees","abstract":[],"kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","url":"\/documentation\/spanningtrees","type":"topic"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"title":"Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"abstract":[],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"UndirectedEdge","preciseIdentifier":"s:14GraphProtocols14UndirectedEdgeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"tex