{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"kind":"symbol","metadata":{"externalID":"s:14GraphProtocols0A0P13SpanningTreesE07minimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","extendedModule":"GraphProtocols","role":"symbol","remoteSource":{"fileName":"Kruskal.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Kruskal.swift#L24"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">"}],"roleHeading":"Instance Method","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"symbolKind":"method","title":"minimumSpanningTree(weight:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SL","text":"Comparable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ties.","type":"text"}]},{"type":"text","text":" Edges are ordered by weight, then by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":". Under that strict order"},{"type":"text","text":" "},{"type":"text","text":"the minimum spanning forest is unique, and this is it, whichever algorithm runs: the"},{"type":"text","text":" "},{"type":"text","text":"canonical forest, listed in nondecreasing weight and, among equal weights, in position"},{"type":"text","text":" "},{"type":"text","text":"order, with the weight added up in that order. Currently Kruskal’s algorithm on sparse"},{"type":"text","text":" "},{"type":"text","text":"graphs (fewer than 4 edges per vertex) and otherwise Prim’s under that order followed by a"},{"type":"text","text":" "},{"type":"text","text":"sort of the n − 1 edges taken, which is faster on denser graphs (see the benchmarks)."}],"type":"paragraph"},{"inlineContent":[{"code":"weight","type":"codeVoice"},{"text":" gives each edge’s weight from its position, so parallel edges can differ. It is","type":"text"},{"text":" ","type":"text"},{"text":"called once for each edge that is not a self-loop, never for a self-loop, and not kept.","type":"text"},{"text":" ","type":"text"},{"text":"Negative and zero weights are ordinary weights, and so are infinities. A NaN weight traps","type":"text"},{"text":" ","type":"text"},{"text":"(NetworkX instead offers ","type":"text"},{"code":"ignore_nan","type":"codeVoice"},{"text":"; filter such edges out first).","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}],"style":"note","name":"Complexity","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"No weight is NaN; the sum of the chosen weights, in the order listed, does","type":"text"},{"text":" ","type":"text"},{"text":"not overflow and is not NaN.","type":"text"}]}],"style":"note","name":"Precondition","type":"aside"}],"kind":"content"}],"abstract":[{"text":"A minimum spanning forest: one minimum spanning tree per connected component (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"text":"and igraph’s ","type":"text"},{"code":"minimum_spanning_tree","type":"codeVoice"},{"text":").","type":"text"}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"abstract":[],"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","kind":"symbol","url":"\/documentation\/spanningtrees","title":"SpanningTrees","role":"collection"},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"role":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","abstract":[{"text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in the graph’s ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", with the sum of their weights (JGraphT’s ","type":"text"},{"code":"SpanningTree","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"getEdges","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"getWeight","type":"codeVoice"},{"text":" these are).","type":"text"}],"kind":"symbol","title":"SpanningForest","type":"topic","url":"\/documentation\/spanningtrees\/spanningforest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpanningForest"}],"navigatorTitle":[{"kind":"identifier","text":"SpanningForest"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","kind":"symbol","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","title":"Graph"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/minimumSpanningTre