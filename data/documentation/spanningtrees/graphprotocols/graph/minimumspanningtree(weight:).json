{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/minimumspanningtree(weight:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumSpanningTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edges are ordered by weight, then by position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":". Under that order the minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning forest is unique, and this is it. Its edges are listed in nondecreasing weight"},{"type":"text","text":" "},{"type":"text","text":"and, among equal weights, in position order, and the weight is added up in that order."},{"type":"text","text":" "},{"type":"text","text":"Sparse graphs (fewer than 4 edges per vertex) run Kruskal’s algorithm; denser ones run"},{"type":"text","text":" "},{"type":"text","text":"Prim’s under the same order and sort the edges taken."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position, so parallel edges can differ. It is"},{"type":"text","text":" "},{"type":"text","text":"called once for each edge that is not a self-loop and is not kept. Negative, zero and"},{"type":"text","text":" "},{"type":"text","text":"infinite weights are ordinary weights. A NaN weight traps; filter such edges out first."}]},{"name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"style":"note"},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"text":"No weight is NaN; the sum of the chosen weights, in the order listed, does","type":"text"},{"text":" ","type":"text"},{"text":"not overflow and is not NaN.","type":"text"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/minimumSpanningTree(weight:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A minimum spanning forest: o