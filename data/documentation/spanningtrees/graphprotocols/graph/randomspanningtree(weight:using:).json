":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Each edge’s weight, from its position."}],"type":"paragraph"}],"name":"weight"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The source of randomness.","type":"text"}]}],"name":"generator"}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The forest’s edges, in the order they joined, and the sum of their weights,"},{"type":"text","text":" "},{"type":"text","text":"added up in that order."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The walks of ","type":"text"},{"code":"randomSpanningTree(using:)","type":"codeVoice"},{"text":" step along each edge with probability","type":"text"},{"text":" ","type":"text"},{"text":"proportional to its weight, which makes a tree’s probability proportional to the product","type":"text"},{"text":" ","type":"text"},{"text":"of its weights. Every edge that is not a self-loop is weighed once; ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is not kept.","type":"text"}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m) plus the walks, each step a binary search of the vertex’s edges."}]}]},{"style":"note","type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is positive and finite."}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(weight:using:)"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"externalID":"s:14GraphProtocols0A0P13SpanningTreesE06randomC4Tree6weight5usingAD0C6ForestVy