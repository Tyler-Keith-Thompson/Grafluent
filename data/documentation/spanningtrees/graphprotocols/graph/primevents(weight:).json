{"abstract":[{"text":"Prim’s algorithm over every component, as a sequence of events: each tree started, each","type":"text"},{"text":" ","type":"text"},{"text":"vertex examined as it joins, each edge to an unspanned vertex examined and relaxed or not,","type":"text"},{"text":" ","type":"text"},{"text":"and each vertex finished. See ","type":"text"},{"type":"codeVoice","code":"PrimEvent"},{"text":" for the order.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/PrimEvents","text":"PrimEvents","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees10PrimEventsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The edges of the "},{"type":"codeVoice","code":"examine"},{"type":"text","text":" events, in order, are "},{"type":"codeVoice","code":"primMinimumSpanningTree(weight:).edges"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" gives each edge’s weight from its position. The sequence keeps it, and calls it"},{"type":"text","text":" "},{"type":"text","text":"once each time an edge is examined: at most once per edge, from the end spanned first."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log n) to iterate every event; O(n) to make each iterator, and O(n)"},{"type":"text","text":" "},{"type":"text","text":"expected to make the sequence when the graph has no vertex indices."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"While iterating, no examined weight is NaN.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"kind":"symbol","metadata":{"role":"symbol","externalID":"s:14GraphProtocols0A0P13SpanningTreesE10primEvents6weightAD04PrimF0Vyxqd__Gqd__5Edges_5IndexQZc_ts18AdditiveArithmeticRd__SLRd__lF","roleHeading":"Instance Method","extendedModule":"GraphProtocols","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s: