{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A spanning forest drawn uniformly at random, by Wilson’s algorithm: one uniform spanning"},{"type":"text","text":" "},{"type":"text","text":"tree per connected component."}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/randomspanningtree(using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"randomSpanningTree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}],"name":"generator"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The forest’s edges, in the order they joined, and its weight, the number of","type":"text"},{"text":" ","type":"text"},{"text":"edges.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component is rooted at its first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Every other vertex, in"},{"type":"text","text":" "},{"type":"text","text":"that order, starts a random walk that stops on reaching the tree; the walk with its loops"},{"type":"text","text":" "},{"type":"text","text":"erased joins the tree. The result is uniform over the spanning forests that have one tree"},{"type":"text","text":" "},{"type":"text","text":"per component, each copy of a parallel edge counting as its own edge. Self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"taken. The forest depends only on the generator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" sequence, so a seeded generator"},{"type":"text","text":" "},{"type":"text","text":"reproduces it on every platform."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(m) plus the walks: the mean hitting time of the root, expected, which is","type":"text"},{"text":" ","type":"text"},{"text":"O(n m) at worst and far less on well-connected graphs.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"title":"randomSpanningTree(using:)","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/RandomSpanningTree.swift#L47","fileName":"RandomSpanningTree.swift"},"ex