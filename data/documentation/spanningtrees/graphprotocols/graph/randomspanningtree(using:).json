{"sections":[],"abstract":[{"type":"text","text":"A spanning forest drawn uniformly at random, by Wilson’s algorithm: one uniform spanning"},{"type":"text","text":" "},{"type":"text","text":"tree per connected component."}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/randomspanningtree(using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"randomSpanningTree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SG","kind":"typeIdentifier","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}],"name":"generator"}]},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The forest’s edges, in the order they joined, and its weight, the number of"},{"type":"text","text":" "},{"type":"text","text":"edges."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component is rooted at its first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Every other vertex, in"},{"type":"text","text":" "},{"type":"text","text":"that order, starts a random walk that stops on reaching the tree; the walk with its loops"},{"type":"text","text":" "},{"type":"text","text":"erased joins the tree. The result is uniform over the spanning forests that have one tree"},{"type":"text","text":" "},{"type":"text","text":"per component, each copy of a parallel edge counting as its own edge. Self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"taken. The forest depends only on the generator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" sequence, so a seeded generator"},{"type":"text","text":" "},{"type":"text","text":"reproduces it on every platform."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(m) plus the walks: the mean hitting time of the root, expected, which is","type":"text"},{"text":" ","type":"text"},{"text":"O(n m) at worst and far less on well-connected graphs.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","metadata":{"externalID":"s:14GraphProtocols0A0P13SpanningTreesE06randomC4Tree5usingAD0C6ForestVyxSiGqd__z_tSGRd__lF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/RandomSpanningTree.swift#L47","fileName":"RandomSpanningTree.swift"},"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"}