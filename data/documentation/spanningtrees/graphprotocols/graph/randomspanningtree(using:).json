nd":"text"},{"text":"randomSpanningTree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"name":"generator","content":[{"type":"paragraph","inlineContent":[{"text":"The source of randomness.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The forest’s edges, in the order they joined, and its weight, the number of"},{"type":"text","text":" "},{"type":"text","text":"edges."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each component is rooted at its first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Every other vertex, in"},{"type":"text","text":" "},{"type":"text","text":"that order, starts a random walk that stops on reaching the tree; the walk with its loops"},{"type":"text","text":" "},{"type":"text","text":"erased joins the tree. The result is uniform over the spanning forests that have one tree"},{"type":"text","text":" "},{"type":"text","text":"per component, each copy of a parallel edge counting as its own edge. Self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"taken. The forest depends only on the generator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" sequence, so a seeded generator"},{"type":"text","text":" "},{"type":"text","text":"reproduces it on every platform."}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(m) plus the walks: the mean hitting time of the root, expected, which is","type":"text"},{"text":" ","type":"text"},{"text":"O(n m) at worst and far less on well-connected graphs.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","title":"Graph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}]},"doc://SpanningTrees/documentation/SpanningTrees":{"title":"SpanningTrees","abstract":[],"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/spanningtrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees"},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","url":"\/documentation\/spanningtrees\/spanningforest","title":"SpanningForest","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge"},{"type":"text","text":" "},{"type":"text","text":"positions in the graph’s "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", with the sum of their weights."}],"navigatorTitle":[{"kind":"identifier","text":"SpanningForest"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SpanningForest"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/randomSpanningTree(using:)":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/randomspanningtree(using:)","title":"randomSpanningTree(using:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A spanning forest drawn uniformly at random, by Wilson’s algorithm: one uniform spanning"},{"type":"text","text":" "},{"type":"text","text":"tree per connected component."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"randomSpanningTree","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"title":"GraphProtocols","type":"topic","kind":"symbol","abstract":[],"role":"collection","url":"\/documentation\/spanningtrees\/graphprotocols","identifier":"doc