":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/randomSpanningTree(using:)":{"kind":"symbol","abstract":[{"text":"A spanning forest drawn uniformly at random, by Wilson’s algorithm: one uniform spanning","type":"text"},{"text":" ","type":"text"},{"text":"tree per connected component.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"randomSpanningTree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","title":"randomSpanningTree(using:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/randomspanningtree(using:)"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"role":"collection","type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Graph