"text","text":"erased joins the tree. The result is uniform over the spanning forests that have one tree"},{"type":"text","text":" "},{"type":"text","text":"per component, each copy of a parallel edge counting as its own edge. Self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"taken. The forest depends only on the generator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" sequence, so a seeded generator"},{"type":"text","text":" "},{"type":"text","text":"reproduces it on every platform."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m) plus the walks: the mean hitting time of the root, expected, which is"},{"type":"text","text":" "},{"type":"text","text":"O(n m) at worst and far less on well-connected graphs."}]}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"kind":"symbol","references":{"doc://SpanningTrees/documentation/SpanningTrees":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","abstract":[],"role":"collection","type":"topic","title":"SpanningTrees","url":"\/documentation\/spanningtrees","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","kind":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols","type":"topic","title":"GraphProtocols","abstract":[],"role":"collection"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"type":"topic","title":"Graph","abstract":[],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://SpanningTrees/documentation/SpanningTrees/SpanningForest":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","abstract":[{"type":"text","text":"A spanning forest of an undirected graph: one spanning tree per connected component, as edge"},{"type":"text","text":" "},{"type":"text","text":"positions in the graph’s "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", with the sum of their weights."}],"role":"symbol","type":"topic","title":"SpanningForest","navigatorTitle":[{"text":"SpanningForest","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpanningForest","kind":"identifier"}],"url":"\/documentation\/spanningtrees\/spanningforest","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/randomSpanningTree(using:)":{"title":"randomSpanningTree(using:)","url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/randomspanningtree(using:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A spanning forest drawn uniformly at random, by Wilson’s algorithm: one uniform spanning"},{"type":"text","text":" "},{"type":"text","text":"tree per connected component."}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"randomSpanningTree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preci