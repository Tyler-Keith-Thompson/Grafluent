{"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"A spanning forest drawn uniformly at random, by Wilson’s algorithm: one uniform spanning"},{"type":"text","text":" "},{"type":"text","text":"tree per connected component."}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/randomspanningtree(using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/RandomSpanningTree.swift#L47","fileName":"RandomSpanningTree.swift"},"title":"randomSpanningTree(using:)","symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"SpanningTrees"}],"extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"randomSpanningTree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P13Spannin