{"abstract":[{"text":"A spanning forest drawn uniformly at random, by Wilson’s algorithm: one uniform spanning","type":"text"},{"text":" ","type":"text"},{"text":"tree per connected component.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"randomSpanningTree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SG","text":"RandomNumberGenerator","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"generator","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The source of randomness."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The forest’s edges, in the order they joined, and its weight, the number of"},{"type":"text","text":" "},{"type":"text","text":"edges."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Each component is rooted at its first vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. Every other vertex, in"},{"type":"text","text":" "},{"type":"text","text":"that order, starts a random walk that stops on reaching the tree; the walk with its loops"},{"type":"text","text":" "},{"type":"text","text":"erased joins the tree. The result is uniform over the spanning forests that have one tree"},{"type":"text","text":" "},{"type":"text","text":"per component, each copy of a parallel edge counting as its own edge. Self-loops are never"},{"type":"text","text":" "},{"type":"text","text":"taken. The forest depends only on the generator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" sequence, so a seeded generator"},{"type":"text","text":" "},{"type":"text","text":"reproduces it on every platform."}],"type":"paragraph"},{"name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m) plus the walks: the mean hitting time of the root, expected, which is"},{"type":"text","text":" "},{"type":"text","text":"O(n m) at worst and far less on well-connected graphs."}]}],"style":"note"}],"kind":"content"}],"kind":"symbol","metadata":{"role":"symbol","externalID":"s:14GraphProtocols0A0P13SpanningTreesE06randomC4Tree5usingAD0C6ForestVyxSiGqd__z_tSGRd__lF","roleHeading":"Instance Method","extendedModule":"GraphProtocols","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"randomSpanningTree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIde