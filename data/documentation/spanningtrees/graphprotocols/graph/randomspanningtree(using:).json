":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"randomSpanningTree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"generator","content":[{"type":"paragraph","inlineContent":[{"text":"The source of randomness.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The forest’s edges, in the order they joined, and its weight, the number of"},{"type":"text","text":" "},{"type":"text","text":"edges."}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Each component is rooted at its first vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. Every other vertex, in","type":"text"},{"text":" ","type":"text"},{"text":"that order, starts a random walk that stops on reaching the tree; the walk with its loops","type":"text"},{"text":" ","type":"text"},{"text":"erased joins the tree. The result is uniform over the spanning forests that have one tree","type":"text"},{"text":" ","type":"text"},{"text":"per component, each copy of a parallel edge counting as its own edge. Self-loops are never","type":"text"},{"text":" ","type":"text"},{"text":"taken. The forest depends only on the generator’s ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" sequence, so a seeded generator","type":"text"},{"text":" ","type":"text"},{"text":"reproduces it on every platform.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O(m) plus the walks: the mean hitting time of the root, expected, which is"},{"type":"text","text":" "},{"type":"text","text":"O(n m) at worst and far less on well-connected graphs."}],"type":"paragraph"}],"name":"Complexity","type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/randomSpanningTree(using:)"},"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"abstract":[],"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","kind":"symbol","title":"Graph","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"abstract":[],"type":"topic","kind":"symbol","title":"GraphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","role":"collection","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/randomSpanningTree(using:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"randomSpanningTree"},{"kind":"text","text":"("},{"text":"using","kind":"ex