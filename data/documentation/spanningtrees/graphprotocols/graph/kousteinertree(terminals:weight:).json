me":"SteinerTree.swift"},"externalID":"s:14GraphProtocols0A0P13SpanningTreesE14kouSteinerTree9terminals6weightAD0fG0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","title":"kouSteinerTree(terminals:weight:)","symbolKind":"method","extendedModule":"GraphProtocols","roleHeading":"Instance Method","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"role":"symbol"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kouSteinerTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"terminals","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SteinerTree","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree","preciseIdentifier":"s:13SpanningTrees11SteinerTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"terminals","content":[{"inlineContent":[{"text":"The vertices to connect.","type":"text"}],"type":"paragraph"}]},{"name":"weight","content":[{"inlineContent":[{"text":"Each edge’s weight, from its position.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The tree’s edges, in position order, and their total weight.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A Dijkstra search from each terminal gives the distances between terminals; a minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning tree of that complete distance graph is expanded into its shortest paths; and the"},{"type":"text","text":" "},{"type":"text","text":"tree is a minimum spanning tree of those paths’ edges with every leaf that is not a"},{"type":"text","text":" "},{"type":"text","text":"terminal pruned, repeatedly. Its weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is"},{"type":"text","text":" "},{"type":"text","text":"the number of leaves of an optimal tree."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop is weighed once; "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is not kept."}],"type":"paragraph"},{"name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(t (m + n) log n + t²) for t terminals, with O(t n) memory."}]}],"style":"note"},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/kousteinertree(terminals:weight:)"]}],"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"url":"\/documentation\/spanningtrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","title":"SpanningTrees","role":"collection","type":"topic","kind":"symbol","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols","abstract":[],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"identifie