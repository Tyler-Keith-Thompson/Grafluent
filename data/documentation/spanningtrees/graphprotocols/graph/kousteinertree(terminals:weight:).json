ype":"text","text":", by the algorithm of Kou,"},{"type":"text","text":" "},{"type":"text","text":"Markowsky and Berman; nil when two terminals are in different components."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"abstract":[],"url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","title":"Edges","type":"topic","kind":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/SteinerTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SteinerTree"}],"type":"topic","title":"SteinerTree","abstract":[{"type":"text","text":"A Steiner tree of an undirected graph: a tree among the graph’s edges that connects every"},{"type":"text","text":" "},{"type":"text","text":"terminal, through other vertices where that helps, as edge positions with their total weight."}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree","kind":"symbol","url":"\/documentation\/spanningtrees\/steinertree","navigatorTitle":[{"kind":"identifier","text":"SteinerTree"}],"role":"symbol"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"abstract":[],"url":"\/documentation\/spanningtrees\/graphprotocols\/graph","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","type":"topic","kind":"symbol"}}}