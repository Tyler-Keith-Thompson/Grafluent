{"abstract":[{"type":"text","text":"An approximate minimum Steiner tree connecting "},{"type":"codeVoice","code":"terminals"},{"type":"text","text":", by the algorithm of Kou,"},{"type":"text","text":" "},{"type":"text","text":"Markowsky and Berman; nil when two terminals are in different components."}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/kousteinertree(terminals:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"kind":"symbol","identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kouSteinerTree(terminals:weight:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kouSteinerTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"terminals"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SteinerTree","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree","preciseIdentifier":"s:13SpanningTrees11SteinerTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The vertices to connect."}],"type":"paragraph"}],"name":"terminals"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each edge’s weight, from its position."}]}],"name":"weight"}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The tree’s edges, in position order, and their total weight."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A Dijkstra search from each terminal gives the distances between terminals; a minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning tree of that complete distance graph is expanded into its shortest paths; and the"},{"type":"text","text":" "},{"type":"text","text":"tree is a minimum spanning tree of those paths’ edges with every leaf that is not a"},{"type":"text","text":" "},{"type":"text","text":"terminal pruned, repeatedly. Its weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is"},{"type":"text","text":" "},{"type":"text","text":"the number of leaves of an optimal tree."}]},{"type":"paragraph","inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is not kept.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(t (m + n) log n + t²) for t terminals, with O(t n) memory."}]}],"name":"Complexity","type":"aside","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Every terminal is a vertex; every weight is at least zero and not NaN; the","type":"text"},{"text":" ","type":"text"},{"text":"path lengths do not overflow.","type":"text"}]}],"name":"Precondition","type":"aside","style":"note"}]}],"metadata":{"role":"symbol","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/SteinerTree.swift#L96","fileName":"SteinerTree.swift"},"title":"kouSteinerTree(terminals:weight:)","modules":[{"relatedModules":["GraphProtocols"],"name":"SpanningTrees"}],"symbolKind":"method","externalID":"s:14GraphProtocols0A0P13SpanningTreesE14kouSteinerTree9terminals6weightAD0fG0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kouSteinerTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"terminals"},{"kind":"text","text":": "},{"kind":"keyword"