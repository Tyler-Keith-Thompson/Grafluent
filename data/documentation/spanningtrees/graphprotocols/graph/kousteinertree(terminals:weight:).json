kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13SpanningTrees11SteinerTreeV","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree","text":"SteinerTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The vertices to connect."}],"type":"paragraph"}],"name":"terminals"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each edge’s weight, from its position.","type":"text"}]}],"name":"weight"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The tree’s edges, in position order, and their total weight.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A Dijkstra search from each terminal gives the distances between terminals; a minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning tree of that complete distance graph is expanded into its shortest paths; and the"},{"type":"text","text":" "},{"type":"text","text":"tree is a minimum spanning tree of those paths’ edges with every leaf that is not a"},{"type":"text","text":" "},{"type":"text","text":"terminal pruned, repeatedly. Its weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is"},{"type":"text","text":" "},{"type":"text","text":"the number of leaves of an optimal tree."}]},{"type":"paragraph","inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is not kept.","type":"text"}]},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(t (m + n) log n + t²) for t terminals, with O(t n) memory.","type":"text"}]}],"style":"note"},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Every terminal is a vertex; every weight is at least zero and not NaN; the","type":"text"},{"text":" ","type":"text"},{"text":"path lengths do not overflow.","type":"text"}]}],"style":"note"}]}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","title":"Graph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}]},"doc://SpanningTrees/documentation/SpanningTrees":{"title":"SpanningTrees","abstract":[],"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/spanningtrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Grap