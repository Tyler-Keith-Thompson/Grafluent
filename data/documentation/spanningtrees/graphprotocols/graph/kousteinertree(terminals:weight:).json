{"abstract":[{"type":"text","text":"An approximate minimum Steiner tree connecting "},{"type":"codeVoice","code":"terminals"},{"type":"text","text":", by the algorithm of Kou,"},{"type":"text","text":" "},{"type":"text","text":"Markowsky and Berman; nil when two terminals are in different components."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kouSteinerTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"terminals"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:13SpanningTrees11SteinerTreeV","kind":"typeIdentifier","text":"SteinerTree","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SL","kind":"typeIdentifier","text":"Comparable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The vertices to connect.","type":"text"}],"type":"paragraph"}],"name":"terminals"},{"content":[{"inlineContent":[{"text":"Each edge’s weight, from its position.","type":"text"}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree’s edges, in position order, and their total weight."}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A Dijkstra search from each terminal gives the distances between terminals; a minimum","type":"text"},{"text":" ","type":"text"},{"text":"spanning tree of that complete distance graph is expanded into its shortest paths; and the","type":"text"},{"text":" ","type":"text"},{"text":"tree is a minimum spanning tree of those paths’ edges with every leaf that is not a","type":"text"},{"text":" ","type":"text"},{"text":"terminal pruned, repeatedly. Its weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is","type":"text"},{"text":" ","type":"text"},{"text":"the number of leaves of an optimal tree.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop is weighed once; "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is not kept."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(t (m + n) log n + t²) for t terminals, with O(t n) memory."}],"type":"paragraph"}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Every terminal is a vertex; every weight is at least zero and not NaN; the","type":"text"},{"text":" ","type":"text"},{"text":"path lengths do not overflow.","type":"text"}]}],"style":"note","name":"Precondition"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kouSteinerTree(terminals:weight:)"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","metadata":{"externalID":"s:14GraphProtocols0A0P13SpanningTreesE14kouSteinerTree9terminals6weightAD0fG0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","role":"symbol","remoteSource":{"fileName":"SteinerTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/SteinerTree.swift#L96"},"modules":[{"relatedModules":["GraphProtocols"],"name":"SpanningTrees"}],"roleHeading":"Instance Method","title":"kouSteinerTree(terminals:weight:)","extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kouSteinerTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"terminals"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"weight"},