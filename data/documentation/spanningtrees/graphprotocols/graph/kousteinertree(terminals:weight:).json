e":"text"},{"text":"the number of leaves of an optimal tree.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is not kept.","type":"text"}]},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(t (m + n) log n + t²) for t terminals, with O(t n) memory."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Every terminal is a vertex; every weight is at least zero and not NaN; the","type":"text"},{"text":" ","type":"text"},{"text":"path lengths do not overflow.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/kousteinertree(terminals:weight:)"]}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"role":"collection","url":"\/documentation\/spanningtrees\/graphprotocols","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","type":"topic","abstract":[]},"doc://SpanningTrees/documentation/SpanningTrees":{"role":"collection","type":"topic","title":"SpanningTrees","url":"\/documentation\/spanningtrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","kind":"symbol","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"abstract":[],"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"symbol","title":"Edges","fragments":[{"kind":"keyword","text":"as