er than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is not kept.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(t (m + n) log n + t²) for t terminals, with O(t n) memory."}]}],"name":"Complexity","type":"aside","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}]}],"name":"Precondition","type":"aside","style":"note"}]}],"metadata":{"role":"symbol","symbolKind":"method","externalID":"s:14GraphProtocols0A0P13SpanningTreesE14kouSteinerTree9terminals6weightAD0fG0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kouSteinerTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"terminals","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text"