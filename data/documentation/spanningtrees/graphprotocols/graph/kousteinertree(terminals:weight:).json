text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"terminals","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices to connect."}]}]},{"name":"weight","content":[{"inlineContent":[{"text":"Each edge’s weight, from its position.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"The tree’s edges, in position order, and their total weight."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A Dijkstra search from each terminal gives the distances between terminals; a minimum"},{"type":"text","text":" "},{"type":"text","text":"spanning tree of that complete distance graph is expanded into its shortest paths; and the"},{"type":"text","text":" "},{"type":"text","text":"tree is a minimum spanning tree of those paths’ edges with every leaf that is not a"},{"type":"text","text":" "},{"type":"text","text":"terminal pruned, repeatedly. Its weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is"},{"type":"text","text":" "},{"type":"text","text":"the number of leaves of an optimal tree."}]},{"type":"paragraph","inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is not kept.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(t (m + n) log n + t²) for t terminals, with O(t n) memory.","type":"text"}]}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"Every terminal is a vertex; every weight is at least zero and not NaN; the","type":"text"},{"text":" ","type":"text"},{"text":"path lengths do not overflow.","type":"text"}],"type":"paragraph"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kouSteinerTree(terminals:weight:)"},"abstract":[{"text":"An approximate minimum Steiner tree connecting ","type":"text"},{"code":"terminals","type":"codeVoice"},{"text":", by the algorithm of Kou,","type":"text"},{"text":" ","type":"text"},{"text":"Markowsky and Berman; nil when two terminals are in different components.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/kouSteinerTree(terminals:weight:)":{"type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/kouSteinerTree(terminals:weight:)","kind":"symbol","abstract":[{"text":"An approximate minimum Steiner tree connecting ","type":"text"},{"code":"terminals","type":"codeVoice"},{"text":", by the algorithm of Kou,","type":"text"},{"text":" ","type":"text"},{"text":"Markowsky and Berman; nil when two terminals are in different components.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kouSteinerTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"terminals"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "