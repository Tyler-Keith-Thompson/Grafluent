{"abstract":[{"text":"Every spanning forest of the graph, in nondecreasing weight: one spanning tree per connected","type":"text"},{"text":" ","type":"text"},{"text":"component, the lightest first, so ","type":"text"},{"code":"prefix(k)","type":"codeVoice"},{"text":" is the k lightest. Each forest lists its edges","type":"text"},{"text":" ","type":"text"},{"text":"by nondecreasing (weight, position), and the first is ","type":"text"},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Forests of equal weight come in an order that is deterministic but unspecified. Self-loops","type":"text"},{"text":" ","type":"text"},{"text":"are never in a forest; parallel edges give distinct forests.","type":"text"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/spanningforests(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"kind":"symbol","identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/spanningForests(weight:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningForests","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProto