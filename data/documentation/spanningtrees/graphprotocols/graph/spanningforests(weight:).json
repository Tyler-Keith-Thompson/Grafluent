{"abstract":[{"type":"text","text":"Every spanning forest of the graph, in nondecreasing weight: one spanning tree per connected"},{"type":"text","text":" "},{"type":"text","text":"component, the lightest first, so "},{"code":"prefix(k)","type":"codeVoice"},{"type":"text","text":" is the k lightest. Each forest lists its edges"},{"type":"text","text":" "},{"type":"text","text":"by nondecreasing (weight, position), and the first is "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Forests of equal weight come in an order that is deterministic but unspecified. Self-loops"},{"type":"text","text":" "},{"type":"text","text":"are never in a forest; parallel edges give distinct forests."}],"metadata":{"symbolKind":"method","role":"symbol","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P13SpanningTreesE15spanningForests6weightAD0cF0Vyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/SpanningTreeEnumeration.swift#L206","fileName":"SpanningTreeEnumeration.swift"},"extendedModule":"GraphProtocols","title":"spanningForests(weight:)","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningForests","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A7ForestsV","text":"SpanningForests","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/spanningforests(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/spanningForests(weight:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spanningForests"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A7ForestsV","text":"SpanningForests","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForests"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Each edge’s weight, called once per edge that is not a self-loop."}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence is lazy. It keeps a heap of partitions of the forests still to list, each with"},{"type":"text","text":" "},{"type":"text","text":"its lightest forest (Sörensen and Janssens): listing a forest splits its partition along the"},{"type":"text","text":" "},{"type":"text","text":"forest’s free edges, one Kruskal run per split."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m) to start; O(n · m · α(n)) per forest listed, and O(n · m) memory"},{"type":"text","text":" "},{"type":"text","text":"per forest still pending."}]}]},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No weight is NaN, and no forest’s weight overflows."}]}]}],"kind":"content"}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"abstract":[],"role":"symbol","type":"topic","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","title":"Graph","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}]