{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Every spanning forest of the graph, in nondecreasing weight: one spanning tree per connected"},{"type":"text","text":" "},{"type":"text","text":"component, the lightest first, so "},{"type":"codeVoice","code":"prefix(k)"},{"type":"text","text":" is the k lightest. Each forest lists its edges"},{"type":"text","text":" "},{"type":"text","text":"by nondecreasing (weight, position), and the first is "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Forests of equal weight come in an order that is deterministic but unspecified. Self-loops"},{"type":"text","text":" "},{"type":"text","text":"are never in a forest; parallel edges give distinct forests."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spanningForests"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"SpanningForests","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForests","preciseIdentifier":"s:13SpanningTrees0A7ForestsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"Each edge’s weight, called once per edge that is not a self-loop.","type":"text"}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence is lazy. It keeps a heap of partitions of the forests still to list, each with"},{"type":"text","text":" "},{"type":"text","text":"its lightest forest (Sörensen and Janssens): listing a forest splits its partition along the"},{"type":"text","text":" "},{"type":"text","text":"forest’s free edges, one Kruskal run per split."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m) to start; O(n · m · α(n)) per forest listed, and O(n · m) memory"},{"type":"text","text":" "},{"type":"text","text":"per forest still pending."}]}],"type":"aside","name":"Complexity","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"No weight is NaN, and no forest’s weight overflows.","type":"text"}]}],"type":"aside","name":"Precondition","style":"note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/spanningForests(weight:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/spanningforests(weight:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTre