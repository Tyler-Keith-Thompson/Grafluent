{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Every spanning forest of the graph, in nondecreasing weight: one spanning tree per connected"},{"type":"text","text":" "},{"type":"text","text":"component, the lightest first, so "},{"type":"codeVoice","code":"prefix(k)"},{"type":"text","text":" is the k lightest. Each forest lists its edges"},{"type":"text","text":" "},{"type":"text","text":"by nondecreasing (weight, position), and the first is "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Forests of equal weight come in an order that is deterministic but unspecified. Self-loops"},{"type":"text","text":" "},{"type":"text","text":"are never in a forest; parallel edges give distinct forests."}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/spanningforests(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spanningForests","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForests","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A7ForestsV","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForests"},{"text":"<","kind":"tex