ee is the picked edges with the shortest paths from their ends to their terminals. Its","type":"text"},{"text":" ","type":"text"},{"text":"weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is the number of leaves of an","type":"text"},{"text":" ","type":"text"},{"text":"optimal tree. Every leaf is a terminal.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is not kept.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(m log m).","type":"text"}],"type":"paragraph"}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}],"type":"paragraph"}]}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","title":"Vertex","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"abstract":[],"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"type":"topic","kind":"symbol","title":"GraphProtocols","url":"\/documentation\/spanningtrees\/graphprotocols","abstract":[],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","role":"collection"},"doc://SpanningTrees/documentation/SpanningTrees":{"url":"\/documentati