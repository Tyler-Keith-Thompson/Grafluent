ype":"codeVoice"},{"type":"text","text":" is not kept."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"O(m log m).","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Complexity"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}],"type":"paragraph"}],"type":"aside","name":"Precondition"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/steinertree(terminals:weight:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"abstract":[{"text":"An approximate minimum Steiner tree connecting ","type":"text"},{"code":"terminals","type":"codeVoice"},{"text":", by Mehlhorn’s algorithm; nil","type":"text"},{"text":" ","type":"text"},{"text":"when two terminals are in different components.","type":"text"}],"metadata":{"role":"symbol","extendedModule":"GraphProtocols","remoteSource":{"fileName":"SteinerTree.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/SteinerTree.swift#L55"},"modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P13SpanningTreesE11steinerTree9terminals6weightAD07SteinerF0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","symbolKind":"method","title":"steinerTree(terminals:weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"steinerTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"term