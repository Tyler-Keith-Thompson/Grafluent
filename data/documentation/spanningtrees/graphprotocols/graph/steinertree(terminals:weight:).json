:"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The vertices to connect.","type":"text"}]}],"name":"terminals"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each edge’s weight, from its position.","type":"text"}]}],"name":"weight"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"The tree’s edges, in position order, and their total weight.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One Dijkstra search from all terminals at once assigns every vertex to its nearest"},{"type":"text","text":" "},{"type":"text","text":"terminal. Each edge between two terminals’ regions joins them at the length of the path"},{"type":"text","text":" "},{"type":"text","text":"through it, a minimum spanning tree of those joins picks which regions to connect, and the"},{"type":"text","text":" "},{"type":"text","text":"tree is the picked edges with the shortest paths from their ends to their terminals. Its"},{"type":"text","text":" "},{"type":"text","text":"weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is the number of leaves of an"},{"type":"text","text":" "},{"type":"text","text":"optimal tree. Every leaf is a terminal."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop is weighed once; "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is not kept."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}],"type":"paragraph"}],"style":"note","name":"Precondition"}]}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/steinertree(terminals:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/steinerTree(terminals:weight:)","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P13SpanningTreesE11steinerTree9terminals6weightAD07SteinerF0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/SteinerTree.swift#L55","fileName":"SteinerTree.swift"},"title":"steinerTree(terminals:weight:)","symbolKind":"method","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steinerTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"terminals","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preci