{"sections":[],"abstract":[{"text":"An approximate minimum Steiner tree connecting ","type":"text"},{"type":"codeVoice","code":"terminals"},{"text":", by Mehlhorn’s algorithm; nil","type":"text"},{"text":" ","type":"text"},{"text":"when two terminals are in different components.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"steinerTree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"terminals"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree","text":"SteinerTree","preciseIdentifier":"s:13SpanningTrees11SteinerTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">? "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP","text":"AdditiveArithmetic"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The vertices to connect.","type":"text"}]}],"name":"terminals"},{"content":[{"inlineContent":[{"text":"Each edge’s weight, from its position.","type":"text"}],"type":"paragraph"}],"name":"weight"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The tree’s edges, in position order, and their total weight.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One Dijkstra search from all terminals at once assigns every vertex to its nearest"},{"type":"text","text":" "},{"type":"text","text":"terminal. Each edge between two terminals’ regions joins them at the length of the path"},{"type":"text","text":" "},{"type":"text","text":"through it, a minimum spanning tree of those joins picks which regions to connect, and the"},{"type":"text","text":" "},{"type":"text","text":"tree is the picked edges with the shortest paths from their ends to their terminals. Its"},{"type":"text","text":" "},{"type":"text","text":"weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is the number of leaves of an"},{"type":"text","text":" "},{"type":"text","text":"optimal tree. Every leaf is a terminal."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every"},{"type":"text","text":" "},{"type":"text","text":"edge that is not a self-loop is weighed once; "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is not kept."}]},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log m)."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}]}],"type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/steinerTree(terminals:weight:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/steinertree(terminals:weight:)"]}],"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/SteinerTree.swift#L55","fileName":"SteinerTree.swift"},"modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","title":"steinerTree(terminals:weight:)","externalID":"s:14GraphProtocols0A0P13SpanningTreesE11steinerTree9terminals6weightAD07SteinerF0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steinerTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"terminals",