t":" "},{"type":"text","text":"tree is the picked edges with the shortest paths from their ends to their terminals. Its"},{"type":"text","text":" "},{"type":"text","text":"weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is the number of leaves of an"},{"type":"text","text":" "},{"type":"text","text":"optimal tree. Every leaf is a terminal."}]},{"type":"paragraph","inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is not kept.","type":"text"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(m log m)."}],"type":"paragraph"}]},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}],"type":"paragraph"}]}]}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph":{"role":"symbol","url":"\/documentation\/spanningtrees\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","title":"Graph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","title":"Edges","role":"symbol","kind":"symbol","abstract":[],"fragments"