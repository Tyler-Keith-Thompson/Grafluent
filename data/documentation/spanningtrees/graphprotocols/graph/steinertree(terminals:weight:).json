tation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"abstract":[{"text":"An approximate minimum Steiner tree connecting ","type":"text"},{"code":"terminals","type":"codeVoice"},{"text":", by Mehlhorn’s algorithm; nil","type":"text"},{"text":" ","type":"text"},{"text":"when two terminals are in different components.","type":"text"}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/steinertree(terminals:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steinerTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"terminals","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SteinerTree","preciseIdentifier":"s:13SpanningTrees11SteinerTreeV","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","preciseIdentifier":"s:SL","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"terminals","content":[{"type":"paragraph","inlineContent":[{"text":"The vertices to connect.","type":"text"}]}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"Each edge’s weight, from its position."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"text":"The tree’s edges, in position order, and their total weight.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"One Dijkstra search from all terminals at once assigns every vertex to its nearest"},{"type":"text","text":" "},{"type":"text","text":"terminal. Each edge between two terminals’ regions joins them at the length of the path"},{"type":"text","text":" "},{"type":"text","text":"through it, a minimum spanning tree of those joins picks which regions to connect, and the"},{"type":"text","text":" "},{"type":"text","text":"tree is the picked edges with the shortest paths from their ends to their terminals. Its"},{"type":"text","text":" "},{"type":"text","text":"weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is the number of leaves of an"},{"type":"text","text":" "},{"type":"text","text":"optimal tree. Every leaf is a terminal."}],"type":"paragraph"},{"inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is not kept.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"O(m log m).","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"Every terminal is a vertex; every weight is at least zero and not NaN; the","type":"text"},{"text":" ","type":"text"},{"text":"path lengths do not overflow.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside","style":"note"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/steinerTree(terminals:weight:)","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"role":"collection","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees","url":"\/documentation\/spanningtrees","abstract":[],"title":"SpanningTrees","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","role":"symbol","type":"topic","title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}]},"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols":{"role":"collection","type":"topic","url":"\/documenta