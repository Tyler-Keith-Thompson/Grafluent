t."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"type":"aside","name":"Complexity"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}],"type":"paragraph"}],"type":"aside","name":"Precondition"}]}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/steinertree(terminals:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/steinerTree(terminals:weight:)"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","abstract":[{"text":"An approximate minimum Steiner tree connecting ","type":"text"},{"type":"codeVoice","code":"terminals"},{"text":", by Mehlhorn’s algorithm; nil","type":"text"},{"text":" ","type":"text"},{"text":"when two terminals are in different components.","type":"text"}],"references":{"doc://SpanningTrees/documentation/SpanningTrees/GraphProtocols/Graph/steinerTree(terminals:weight:)":{"url":"\/documentation\/spanningtrees\/graphprotocols\/graph\/steinertree(terminals:weight:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steinerTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"terminals","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"we