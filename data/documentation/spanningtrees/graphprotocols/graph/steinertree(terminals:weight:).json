alID":"s:14GraphProtocols0A0P13SpanningTreesE11steinerTree9terminals6weightAD07SteinerF0Vyxqd__GSgqd_0__qd__5Edges_5IndexQZXEts18AdditiveArithmeticRd__SLRd__STRd_0_7ElementQyd_0_6VertexRtzr0_lF","role":"symbol"},"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/steinertree(terminals:weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steinerTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"terminals","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SteinerTree","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SteinerTree","preciseIdentifier":"s:13SpanningTrees11SteinerTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">? ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"terminals","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices to connect."}]}]},{"name":"weight","content":[{"inlineContent":[{"type":"text","text":"Each edge’s weight, from its position."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tree’s edges, in position order, and their total weight."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"One Dijkstra search from all terminals at once assigns every vertex to its nearest","type":"text"},{"text":" ","type":"text"},{"text":"terminal. Each edge between two terminals’ regions joins them at the length of the path","type":"text"},{"text":" ","type":"text"},{"text":"through it, a minimum spanning tree of those joins picks which regions to connect, and the","type":"text"},{"text":" ","type":"text"},{"text":"tree is the picked edges with the shortest paths from their ends to their terminals. Its","type":"text"},{"text":" ","type":"text"},{"text":"weight is at most 2(1 − 1\/ℓ) times the optimum, where ℓ is the number of leaves of an","type":"text"},{"text":" ","type":"text"},{"text":"optimal tree. Every leaf is a terminal.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Repeated terminals count once. With fewer than two terminals the tree has no edges. Every","type":"text"},{"text":" ","type":"text"},{"text":"edge that is not a self-loop is weighed once; ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is not kept.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log m).","type":"text"}]}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every terminal is a vertex; every weight is at least zero and not NaN; the"},{"type":"text","text":" "},{"type":"text","text":"path lengths do not overflow."}]}],"style":"note","name":"Precondition"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/steinerTree(terminals:weight:)","interfaceLanguage":"swift"},"references":{"doc://SpanningTrees/documentation/SpanningTrees":{"abstract":[],"role":"collection","url":"\/documentation\/spanningtrees","type":"topic","kind":"symbol","title":"SpanningTrees","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"role":"symbol","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://SpanningTrees/documentation/SpanningTrees/SteinerTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":