{"sections":[],"abstract":[{"type":"text","text":"A minimum spanning forest by Prim’s algorithm, over every component."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AdditiveArithmetic","kind":"typeIdentifier","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Comparable","kind":"typeIdentifier","preciseIdentifier":"s:SL"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Grows a tree from the first unspanned vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, taking the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"out of it each step, and repeats until every vertex is spanned. Among equal weights, which"},{"type":"text","text":" "},{"type":"text","text":"edge it takes is unspecified. Edges are listed in the order their far vertices joined, and"},{"type":"text","text":" "},{"type":"text","text":"the weight is added up in that order."}],"type":"paragraph"},{"inlineContent":[{"text":"Each edge that is not a self-loop is weighed at most once, from the end spanned first. An","type":"text"},{"text":" ","type":"text"},{"text":"edge whose far end is already spanned is skipped without being weighed.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(m log n), with a 4-ary indexed heap.","type":"text"}]}],"type":"aside","name":"Complexity"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"As for "},{"type":"codeVoice","code":"minimumSpanningTree(weight:)"},{"type":"text","text":"."}]}],"type":"aside","name":"Precondition"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols","doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/GraphProtocols\/Graph\/primMinimumSpanningTree(weight:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)"]}],"metadata":{"role":"symbol","remoteSource":{"fileName":"Prim.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Prim.swift#L18"},"modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P13SpanningTreesE011primMinimu