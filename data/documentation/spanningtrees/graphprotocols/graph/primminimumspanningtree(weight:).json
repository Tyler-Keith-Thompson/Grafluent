 equal weights, which"},{"type":"text","text":" "},{"type":"text","text":"edge it takes is unspecified. Edges are listed in the order their far vertices joined, and"},{"type":"text","text":" "},{"type":"text","text":"the weight is added up in that order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each edge that is not a self-loop is weighed at most once, from the end spanned first. An"},{"type":"text","text":" "},{"type":"text","text":"edge whose far end is already spanned is skipped without being weighed."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(m log n), with a 4-ary indexed heap."}]}],"name":"Complexity"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"As for "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Precondition"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Prim.swift#L18","fileName":"Prim.swift"},"externalID":"s:14GraphProtocols0A0P13SpanningTreesE011primMinimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","roleHeading":"Instance Method","title":"primMinimumSpanningTree(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","tex