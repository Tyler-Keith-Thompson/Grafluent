":"codeVoice","code":"vertices"},{"type":"text","text":" order, taking the lightest edge"},{"type":"text","text":" "},{"type":"text","text":"out of it each step, and repeats until every vertex is spanned. Among equal weights, which"},{"type":"text","text":" "},{"type":"text","text":"edge it takes is unspecified. Edges are listed in the order their far vertices joined, and"},{"type":"text","text":" "},{"type":"text","text":"the weight is added up in that order."}]},{"type":"paragraph","inlineContent":[{"text":"Each edge that is not a self-loop is weighed at most once, from the end spanned first. An","type":"text"},{"text":" ","type":"text"},{"text":"edge whose far end is already spanned is skipped without being weighed.","type":"text"}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(m log n), with a 4-ary indexed heap."}],"type":"paragraph"}],"style":"note"},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":"As for "},{"code":"minimumSpanningTree(weight:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note"}]}],"variants":[{"paths":["\/documentation\/spanningtrees\/graphprotocols\/graph\/primminimumspanningtree(weight:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"remoteSource":{"fileName":"Prim.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/Prim.swift#L18"},"roleHeading":"Instance Method","role":"symbol","title":"primMinimumSpanningTree(weight:)","externalID":"s:14GraphProtocols0A0P13SpanningTreesE011primMinimumC4Tree6weightAD0C6ForestVyxqd__Gqd__5Edges_5IndexQZXE_ts18AdditiveArithmeticRd__SLRd__lF","modules":[{"name":"SpanningTrees","relatedModules":["GraphProtocols"]}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"primMinimumSpanningTree","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"gen