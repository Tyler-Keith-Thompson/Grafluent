,{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Making the sequence weighs and sorts the edges exactly as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"kruskalMinimumSpanningTree(weight:)"},{"text":" does; iterating runs the union–find. The tree edges, in","type":"text"},{"text":" ","type":"text"},{"text":"the order reported, are that call’s ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":". The sequence holds a copy of the graph, so later","type":"text"},{"text":" ","type":"text"},{"text":"changes to the original do not affect it, and it can be iterated more than once. Stopping the","type":"text"},{"text":" ","type":"text"},{"text":"loop stops the algorithm.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/KruskalEvents"},"hierarchy":{"paths":[["doc:\/\/SpanningTrees\/documentation\/SpanningTrees"]]},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/SpanningTrees\/ST"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/spanningtrees\/kruskalevents"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","remoteSource":{"fileName":"KruskalEvents.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/SpanningTrees\/KruskalEvents.swift#L47"},"modules":[{"name":"SpanningTrees"}],"externalID":"s:13SpanningTrees13KruskalEventsV","title":"KruskalEvents","roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KruskalEvents"}],"navigatorTitle":[{"text":"KruskalEvents","kind":"identifier"}]},"kind":"symbol","references":{"doc://SpanningTrees/documentation/SpanningTrees":{"role":"collection","url":"\/documentation\/spanningtre