phismModule/documentation/IsomorphismModule/AutomorphismGroup":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutomorphismGroup"}],"title":"AutomorphismGroup","navigatorTitle":[{"kind":"identifier","text":"AutomorphismGroup"}],"role":"symbol","url":"\/documentation\/isomorphismmodule\/automorphismgroup","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","kind":"symbol","abstract":[{"type":"text","text":"The automorphism group of a graph, as returned by "},{"code":"automorphismGroup()","type":"codeVoice"},{"type":"text","text":": the permutations of"},{"type":"text","text":" "},{"type":"text","text":"its vertices that keep every edge multiplicity (and the colours, when given), described by"},{"type":"text","text":" "},{"text":"generators, by the orbits they cut the vertices into, and by its order.","type":"text"}]},"doc://IsomorphismModule/documentation/IsomorphismModule/Isomorphisms":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Isomorphisms","kind":"identifier"}],"title":"Isomorphisms","kind":"symbol","role":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphisms","navigatorTitle":[{"text":"Isomorphisms","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Every mapping of one problem (isomorphism, subgraph isomorphism or monomorphism), found lazily:"},{"type":"text","text":" "},{"type":"text","text":"each iterator runs the search and stops at each mapping. Iterating twice runs the search twice"},{"type":"text","text":" "},{"type":"text","text":"and gives the same mappings in the same order. Colours were read when the sequence was made."}],"url":"\/documentation\/isomorphismmodule\/isomorphisms"},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalForm":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CanonicalForm","kind":"identifier"}],"title":"CanonicalForm","kind":"symbol","role":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalForm","navigatorTitle":[{"text":"CanonicalForm","kind":"identifier"}],"type":"topic","abstract":[{"text":"A graph renumbered by its canonical labeling, compared and hashed as a whole: equal exactly when","type":"text"},{"text":" ","type":"text"},{"text":"the graphs are isomorphic. O(n + m) to compare or hash.","type":"text"}],"url":"\/documentation\/isomorphismmodule\/canonicalform"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"kind":"symbol","title":"IsomorphismModule","url":"\/documentation\/isomorphismmodule","abstract":[],"role":"collection","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalLabeling":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CanonicalLabeling","kind":"identifier"}],"title":"CanonicalLabeling","kind":"symbol","role":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalLabeling","navigatorTitle":[{"kind":"identifier","text":"CanonicalLabeling"}],"type":"topic","abstract":[{"type":"text","text":"A canonical labeling of a graph, as returned by "},{"type":"codeVoice","code":"canonicalLabeling()"},{"type":"text","text":": a numbering of the"},{"type":"text","text":" "},{"type":"text","text":"vertices "},{"type":"codeVoice","code":"0..<n"},{"text":" such that isomorphic graphs, renumbered by their labelings, become equal. The","type":"text"},{"text":" ","type":"text"},{"text":"renumbered graph is ","type":"text"},{"code":"form","type":"codeVoice"},{"text":", so two graphs are isomorphic exactly when their forms are equal.","type":"text"}],"url":"\/documentation\/isomorphismmodule\/canonicallabeling"},"doc://IsomorphismModule/documentation/IsomorphismModule/WeisfeilerLehmanSubgraphHashes":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WeisfeilerLehmanSubgraphHashes"}],"title":"WeisfeilerLehmanSubgraphHashes","navigatorTitle":[{"kind":"identifier","text":"WeisfeilerLehmanSubgraphHashes"}],"role":"symbol","url":"\/documentation\/isomorphismmodule\/weisfeilerlehmansubgraphhashes","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/WeisfeilerLehmanSubgraphHashes","kind":"symbol","abstract":[{"text":"Per-vertex Weisfeiler–Leman hashes: each vertex’s colour after rounds 1 … ","type":"text"},{"code":"iterations","type":"codeVoice"},{"text":" of colour","type":"text"},{"text":" ","type":"text"},{"text":"refinement, as ","type":"text"},{"code":"weisfeilerLehmanSubgraphHashes(iterations:)","type":"codeVoice"},{"text":" returns them (Shervashidze et al.","type":"text"},{"text":" ","type":"text"},{"text":"2011). Equal hashes after a round mean equal colours, within one process.","type":"text"}]}}}