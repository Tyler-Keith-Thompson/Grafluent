ilerLehmanSubgraphHashes(iterations:)"},{"text":" returns them (Shervashidze et al.","type":"text"},{"text":" ","type":"text"},{"text":"2011). Equal hashes after a round mean equal colours, within one process.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"WeisfeilerLehmanSubgraphHashes"}],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/WeisfeilerLehmanSubgraphHashes","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WeisfeilerLehmanSubgraphHashes"}],"title":"WeisfeilerLehmanSubgraphHashes","role":"symbol","url":"\/documentation\/isomorphismmodule\/weisfeilerlehmansubgraphhashes"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","url":"\/documentation\/isomorphismmodule\/graphprotocols","title":"GraphProtocols","kind":"symbol","type":"topic","abstract":[],"role":"collection"},"doc://IsomorphismModule/documentation/IsomorphismModule/AutomorphismGroup":{"kind":"symbol","abstract":[{"type":"text","text":"The automorphism group of a graph, as returned by "},{"code":"automorphismGroup()","type":"codeVoice"},{"type":"text","text":": the permutations of"},{"type":"text","text":" "},{"type":"text","text":"its vertices that keep every edge multiplicity (and the colours, when given), described by"},{"type":"text","text":" "},{"text":"generators, by the orbits they cut the vertices into, and by its order.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AutomorphismGroup"}],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutomorphismGroup"}],"title":"AutomorphismGroup","role":"symbol","url":"\/documentation\/isomorphismmodule\/automorphismgroup"},"doc://IsomorphismModule/docu