teration or "},{"type":"codeVoice","code":"Array(_:)"},{"type":"text","text":", not "},{"type":"codeVoice","code":"[0]"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutomorphismOrbits","kind":"identifier"}],"navigatorTitle":[{"text":"AutomorphismOrbits","kind":"identifier"}]},"doc://IsomorphismModule/documentation/IsomorphismModule":{"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","url":"\/documentation\/isomorphismmodule","title":"IsomorphismModule","role":"collection","type":"topic","kind":"symbol","abstract":[]},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","url":"\/documentation\/isomorphismmodule\/graphprotocols","title":"GraphProtocols","role":"collection","type":"topic","kind":"symbol","abstract":[]},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalLabeling":{"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalLabeling","url":"\/documentation\/isomorphismmodule\/canonicallabeling","title":"CanonicalLabeling","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A canonical labeling of a graph, as returned by "},{"code":"canonicalLabeling()","type":"codeVoice"},{"type":"text","text":": a numbering of the"},{"type":"text","text":" "},{"type":"text","text":"vertices "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" such that isomorphic graphs, renumbered by their labelings, become equal. The"},{"type":"text","text":" "},{"type":"text","text":"renumbered graph is "},{"type":"codeVoice","code":"form"},{"type":"text","text":", so two graphs are isomorphic exactly when their forms are equal."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CanonicalLabeling","kind":"identifier"}],"navigatorTitle":[{"text":"CanonicalLabeling","kind