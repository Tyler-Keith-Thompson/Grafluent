mOrbits","kind":"identifier"}],"title":"AutomorphismOrbits","role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalForm":{"type":"topic","abstract":[{"text":"A graph renumbered by its canonical labeling, compared and hashed as a whole: equal exactly when","type":"text"},{"text":" ","type":"text"},{"text":"the graphs are isomorphic. O(n + m) to compare or hash.","type":"text"}],"url":"\/documentation\/isomorphismmodule\/canonicalform","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalForm","navigatorTitle":[{"text":"CanonicalForm","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CanonicalForm","kind":"identifier"}],"title":"CanonicalForm","role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule/Isomorphism":{"title":"Isomorphism","abstract":[{"type":"text","text":"A mapping from the vertices of a pattern graph into the vertices of a target graph that"},{"type":"text","text":" "},{"type":"text","text":"preserves edges: an isomorphism (a bijection), a subgraph isomorphism (onto an induced"},{"type":"text","text":" "},{"type":"text","text":"subgraph) or a monomorphism (onto a subgraph), as returned by "},{"type":"codeVoice","code":"isomorphism(to:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraphIsomorphism(to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"monomorphism(to:)"},{"type":"text","text":" and their sequences."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Isomorphism","kind":"identifier"}],"navigatorTitle":[{"text":"Isomorphism","kind":"identifier"}],"type":"topic","url":"\/documentation\/isomorphismmodule\/isomorphism","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphism","role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"title":"Isomor