es of"},{"type":"text","text":" "},{"type":"text","text":"the flat storage it is cut from: use "},{"type":"codeVoice","code":"first"},{"type":"text","text":", iteration or "},{"type":"codeVoice","code":"Array(_:)"},{"type":"text","text":", not "},{"type":"codeVoice","code":"[0]"},{"type":"text","text":"."}],"title":"AutomorphismOrbits","url":"\/documentation\/isomorphismmodule\/automorphismorbits","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutomorphismOrbits","kind":"identifier"}]},"doc://IsomorphismModule/documentation/IsomorphismModule/Isomorphism":{"url":"\/documentation\/isomorphismmodule\/isomorphism","abstract":[{"text":"A mapping from the vertices of a pattern graph into the vertices of a target graph that","type":"text"},{"text":" ","type":"text"},{"text":"preserves edges: an isomorphism (a bijection), a subgraph isomorphism (onto an induced","type":"text"},{"text":" ","type":"text"},{"text":"subgraph) or a monomorphism (onto a subgraph), as returned by ","type":"text"},{"code":"isomorphism(to:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"subgraphIsomorphism(to:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"monomorphism(to:)"},{"type":"text","text":" and their sequences."}],"role":"symbol","navigatorTitle":[{"text":"Isomorphism","kind":"identifier"}],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphism","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Isomorphism","kind":"identifier"}],"kind":"symbol","title":"Isomorphism"},"doc://IsomorphismModule/documentation/IsomorphismModule/AutomorphismGroup":{"url":"\/documentation\/isomorphismmodule\/automorphismgroup","abstract":[{"type":"text","text":"The automorphism group of a graph, as returned by "},{"type":"codeVoice","code":"automorphismGroup()"},{"type":"text","text":": the permutations of"},{"type":"text","text":" "},{"type":"text","text":"its vertices that keep every edge multiplicity (and the colours, when given), described by"},{"text":" ","type":"text"},{"text":"generators, by the orbits they cut the vertices into, and by its order.","type":"text"}],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutomorphismGroup","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"AutomorphismGroup","kind":"identifier"}],"kind":"symbol","title":"AutomorphismGroup","type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalLabeling":{"kind":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalLabeling","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CanonicalLabeling"}],"abstract":[{"text":"A canonical labeling of a graph, as returned by ","type":"text"},{"code":"canonicalLabeling()","type":"codeVoice"},{"text":": a numbering of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" such that isomorphic graphs, renumbered by their labelings, become equal. The"},{"type":"text","text":" "},{"type":"text","text":"renumbered graph is "},{"type":"codeVoice","code":"form"},{"type":"text","text":", so two graphs are isomorphic exactly when their forms are equal."}],"title":"CanonicalLabeling","url":"\/documentation\/isomorphismmodule\/canonicallabeling","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CanonicalLabeling"}]},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"url":"\/documentation\/isomorphismmodule\/graphprotocols","abstract":[],"role":"collection","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","type":"topic","kind":"symbo