 "},{"type":"text","text":"each iterator runs the search and stops at each mapping. Iterating twice runs the search twice"},{"type":"text","text":" "},{"type":"text","text":"and gives the same mappings in the same order. Colours were read when the sequence was made."}],"role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule/Isomorphism":{"role":"symbol","title":"Isomorphism","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Isomorphism"}],"abstract":[{"type":"text","text":"A mapping from the vertices of a pattern graph into the vertices of a target graph that"},{"type":"text","text":" "},{"type":"text","text":"preserves edges: an isomorphism (a bijection), a subgraph isomorphism (onto an induced"},{"type":"text","text":" "},{"type":"text","text":"subgraph) or a monomorphism (onto a subgraph), as returned by "},{"type":"codeVoice","code":"isomorphism(to:)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"subgraphIsomorphism(to:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"monomorphism(to:)"},{"text":" and their sequences.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Isomorphism"}],"url":"\/documentation\/isomorphismmodule\/isomorphism","kind":"symbol","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphism"},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalForm":{"role":"symbol","title":"CanonicalForm","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CanonicalForm"}],"abstract":[{"text":"A graph renumbered by its canonical labeling, compared and hashed as a whole: equal exactly when","type":"text"},{"text":" ","type":"text"},{"text":"the graphs are isomorphic. O(n + m) to compare or hash.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"CanonicalForm"}],"kind":"symbol","url":"\/documentation\/isomorphismmodule\/canonicalform","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalForm"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"kind":"symbol","title":"IsomorphismModule","url":"\/documentation\/isomorphismmodule","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","abstract":[],"type":"topic","role":"collection"},"doc://IsomorphismModule/documentation/IsomorphismModule/WeisfeilerLehmanSubgraphHashes":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WeisfeilerLehmanSubgraphHashes"}],"title":"WeisfeilerLehmanSubgraphHashes","navigatorTitle":[{"kind":"identifier","text":"WeisfeilerLehmanSubgraphHashes"}],"url":"\/documentation\/isomorphismmodule\/weisfeilerlehmansubgraphhashes","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/WeisfeilerLehmanSubgraphHashes","abstract":[{"type":"text","text":"Per-vertex Weisfeiler–Leman hashes: each vertex’s colour after rounds 1 … "},{"type":"codeVoice","code":"iterations"},{"type":"text","text":" of colour"},{"type":"text","text":" "},{"type":"text","text":"refinement, as "},{"type":"codeVoice","code":"weisfeilerLehmanSubgraphHashes(iterations:)"},{"type":"text","text":" returns them (Shervashidze et al."},{"type":"text","text":" "},{"type":"text","text":"2011). Equal hashes after a round mean equal colours, within one process."}],"role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule/AutomorphismOrbits":{"title":"AutomorphismOrbits","navigatorTitle":[{"kind":"identifier","text":"AutomorphismOrbits"}],"url":"\/documentation\/isomorphismmodule\/automorphismorbits","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutomorphismOrbits"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The orbits of an automorphism group: classes of vertices, each i