isms":{"abstract":[{"type":"text","text":"Every mapping of one problem (isomorphism, subgraph isomorphism or monomorphism), found lazily:"},{"type":"text","text":" "},{"type":"text","text":"each iterator runs the search and stops at each mapping. Iterating twice runs the search twice"},{"type":"text","text":" "},{"type":"text","text":"and gives the same mappings in the same order. Colours were read when the sequence was made."}],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphisms","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Isomorphisms","kind":"identifier"}],"title":"Isomorphisms","url":"\/documentation\/isomorphismmodule\/isomorphisms","navigatorTitle":[{"text":"Isomorphisms","kind":"identifier"}]},"doc://IsomorphismModule/documentation/IsomorphismModule/AutomorphismGroup":{"type":"topic","kind":"symbol","url":"\/documentation\/isomorphismmodule\/automorphismgroup","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/AutomorphismGroup","title":"AutomorphismGroup","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AutomorphismGroup"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutomorphismGroup"}],"abstract":[{"type":"text","text":"The automorphism group of a graph, as returned by "},{"type":"codeVoice","code":"automorphismGroup()"},{"type":"text","text":": the permutations of"},{"type":"text","text":" "},{"type":"text","text":"its vertices that keep every edge multiplicity (and the colours, when given), described by"},{"type":"text","text":" "},{"text":"generators, by the orbits they cut the vertices into, and by its order.","type":"text"}]},"doc://IsomorphismModule/documentation/IsomorphismModule":{"title":"IsomorphismModule","role":"collection","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","abstract":[],"kind":"symbol",