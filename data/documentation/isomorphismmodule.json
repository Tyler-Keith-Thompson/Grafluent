t":"edge of this graph (the pattern) is substituted by one of "},{"code":"other","type":"codeVoice"},{"type":"text","text":" (the target) or deleted, and"},{"type":"text","text":" "},{"type":"text","text":"every vertex and edge of the target that is no substitute is inserted."}],"type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/EditPath"},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalLabeling":{"navigatorTitle":[{"kind":"identifier","text":"CanonicalLabeling"}],"url":"\/documentation\/isomorphismmodule\/canonicallabeling","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CanonicalLabeling"}],"title":"CanonicalLabeling","abstract":[{"text":"A canonical labeling of a graph, as returned by ","type":"text"},{"code":"canonicalLabeling()","type":"codeVoice"},{"text":": a numbering of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices ","type":"text"},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" such that isomorphic graphs, renumbered by their labelings, become equal. The"},{"type":"text","text":" "},{"type":"text","text":"renumbered graph is "},{"code":"form","type":"codeVoice"},{"type":"text","text":", so two graphs are isomorphic exactly when their forms are equal."}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalLabeling"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"abstract":[],"title":"GraphProtocols","role":"collection","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","url":"\/documentation\/isomorphismmodule\/graphprotocols","kind":"symbol","type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule/WeisfeilerLehmanSubgraphHashes":{"kind":"symbol","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/WeisfeilerLehmanSubgraphHashes","typ