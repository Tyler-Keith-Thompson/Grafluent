icalLabeling","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A canonical labeling of a graph, as returned by "},{"type":"codeVoice","code":"canonicalLabeling()"},{"type":"text","text":": a numbering of the"},{"type":"text","text":" "},{"type":"text","text":"vertices "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" such that isomorphic graphs, renumbered by their labelings, become equal. The"},{"type":"text","text":" "},{"type":"text","text":"renumbered graph is "},{"type":"codeVoice","code":"form"},{"type":"text","text":", so two graphs are isomorphic exactly when their forms are equal."}],"kind":"symbol","url":"\/documentation\/isomorphismmodule\/canonicallabeling","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalLabeling","navigatorTitle":[{"kind":"identifier","text":"CanonicalLabeling"}],"type":"topic"},"doc://IsomorphismModule/documentation/IsomorphismModule":{"kind":"symbol","url":"\/documentation\/isomorphismmodule","title":"IsomorphismModule","role":"collection","type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule","abstract":[]},"doc://IsomorphismModule/documentation/IsomorphismModule/Isomorphisms":{"type":"topic","abstract":[{"type":"text","text":"Every mapping of one problem (isomorphism, subgraph isomorphism or monomorphism), found lazily:"},{"type":"text","text":" "},{"type":"text","text":"each iterator runs the search and stops at each mapping. Iterating twice runs the search twice"},{"type":"text","text":" "},{"type":"text","text":"and gives the same mappings in the same order. Colours were read when the sequence was made."}],"role":"symbol","url":"\/documentation\/isomorphismmodule\/isomorphisms","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Isomorphisms"}],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphisms","navigatorTitle":[{"kind":"identifier","t