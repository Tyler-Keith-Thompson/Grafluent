nds 1 … ","type":"text"},{"code":"iterations","type":"codeVoice"},{"text":" of","type":"text"},{"text":" ","type":"text"},{"text":"colour refinement, as ","type":"text"},{"code":"weisfeilerLehmanSubgraphHashes(iterations:)","type":"codeVoice"},{"text":" returns them (NetworkX’s","type":"text"},{"text":" ","type":"text"},{"code":"weisfeiler_lehman_subgraph_hashes","type":"codeVoice"},{"text":"; Shervashidze et al. 2011). Equal hashes after a round mean","type":"text"},{"text":" ","type":"text"},{"text":"equal colours, within one process.","type":"text"}],"type":"topic","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/WeisfeilerLehmanSubgraphHashes","title":"WeisfeilerLehmanSubgraphHashes","kind":"symbol","url":"\/documentation\/isomorphismmodule\/weisfeilerlehmansubgraphhashes","role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"type":"topic","role":"collection","title":"GraphProtocols","kind":"symbol","url":"\/documentation\/isomorphismmodule\/graphprotocols","abstract":[],"identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols"}}}