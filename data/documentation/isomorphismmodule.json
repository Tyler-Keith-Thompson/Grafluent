ation\/isomorphismmodule\/isomorphisms","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/Isomorphisms","navigatorTitle":[{"text":"Isomorphisms","kind":"identifier"}],"title":"Isomorphisms"},"doc://IsomorphismModule/documentation/IsomorphismModule/CanonicalLabeling":{"navigatorTitle":[{"kind":"identifier","text":"CanonicalLabeling"}],"type":"topic","title":"CanonicalLabeling","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/CanonicalLabeling","url":"\/documentation\/isomorphismmodule\/canonicallabeling","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CanonicalLabeling"}],"abstract":[{"text":"A canonical labeling of a graph, as returned by ","type":"text"},{"type":"codeVoice","code":"canonicalLabeling()"},{"text":": a numbering of the","type":"text"},{"text":" ","type":"text"},{"text":"vertices ","type":"text"},{"type":"codeVoice","code":"0..<n"},{"text":" such that isomorphic graphs, renumbered by their labelings, become equal. The","type":"text"},{"text":" ","type":"text"},{"text":"renumbered graph is ","type":"text"},{"type":"codeVoice","code":"form"},{"text":", so two graphs are isomorphic exactly when their forms are equal.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://IsomorphismModule/documentation/IsomorphismModule/GraphProtocols":{"type":"topic","role":"collection","url":"\/documentation\/isomorphismmodule\/graphprotocols","identifier":"doc:\/\/IsomorphismModule\/documentation\/IsomorphismModule\/GraphProtocols","abstract":[],"kind":"symbol","title":"GraphProtocols"},"doc://IsomorphismModule/documentation/IsomorphismModule/Isomorphism":{"abstract":[{"type":"text","text":"A mapping from the vertices of a pattern graph into the vertices of a target graph that"},{"type":"text","text":" "},{"type":"text","text":"preserves edges: an isomorphism (a bijection), a subgraph isomorphism (onto an induced"},{"type":"text","text":" "},{"type":"text","text