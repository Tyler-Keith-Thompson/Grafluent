{"kind":"symbol","identifier":{"url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees"],"anchor":"Extended-Modules","generated":true,"title":"Extended Modules"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"TreeAlgorithms","modules":[{"name":"TreeAlgorithms"}],"externalID":"TreeAlgorithms","symbolKind":"module","roleHeading":"Framework","role":"collection"},"sections":[],"variants":[{"paths":["\/documentation\/treealgorithms"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TreeAlgorithms/documentation/TreeAlgorithms/LowestCommonAncestors":{"role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","url":"\/documentation\/treealgorithms\/lowestcommonancestors","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"abstract":[{"type":"text","text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work."}],"kind":"symbol","title":"LowestCommonAncestors","navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"kind":"symbol","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"role":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition","title":"HeavyLightDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/treealgorithms\/trees","title":"Trees"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"title":"TreeAlgorithms","type":"topic","abstract":[],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","url":"\/documentation\/treealgorithms","role":"collection"}}}