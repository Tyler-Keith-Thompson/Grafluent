{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"topicSections":[{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"],"anchor":"Structures","title":"Structures","generated":true},{"generated":true,"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees"]}],"identifier":{"url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"role":"collection","symbolKind":"module","modules":[{"name":"TreeAlgorithms"}],"roleHeading":"Framework","title":"TreeAlgorithms","externalID":"TreeAlgorithms"},"variants":[{"paths":["\/documentation\/treealgorithms"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"references":{"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"url":"\/documentation\/treealgorithms\/trees","kind":"symbol","abstract":[],"title":"Trees","role":"collection","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"title":"TreeAlgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","abstract":[],"url":"\/documentation\/treealgorithms","kind":"symbol","role":"collection","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/LowestCommonAncestors":{"type":"topic","role":"symbol","title":"LowestCommonAncestors","url":"\/documentation\/treealgorithms\/lowestcommonancestors","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"title":"HeavyLightDecomposition","url":"\/documentation\/treealgorithms\/heavylightdecomposition","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"kind":"symbol","role":"symbol","type":"topic"}}}