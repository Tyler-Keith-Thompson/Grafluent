e), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"type":"topic","role":"symbol","title":"HeavyLightDecomposition","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"url":"\/documentation\/treealgorithms\/trees","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees","title":"Trees","type":"topic","abstract":[],"kind":"symbol","role":"collection"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"kind":"symbol","role":"collection","url":"\/documentation\/treealgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","abstract":[],"type":"topic","title":"TreeAlgorithms"}}}