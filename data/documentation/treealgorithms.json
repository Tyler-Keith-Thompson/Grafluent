{"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"TreeAlgorithms"}],"symbolKind":"module","role":"collection","title":"TreeAlgorithms","externalID":"TreeAlgorithms","roleHeading":"Framework"},"sections":[],"identifier":{"url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/treealgorithms"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees"],"title":"Extended Modules","generated":true,"anchor":"Extended-Modules"}],"references":{"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"url":"\/documentation\/treealgorithms\/trees","type":"topic","abstract":[],"role":"collection","kind":"symbol","title":"Trees","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"role":"collection","abstract":[],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","title":"TreeAlgorithms","url":"\/documentation\/treealgorithms","kind":"symbol","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"role":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"title":"HeavyLightDecomposition","url":"\/documentation\/treealgorithms\/heavylightdecomposition","kind":"symbol","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/LowestCommonAncestors":{"role":"symbol","navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","abstract":[{"type":"text","text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"type":"codeVoice","code":"lowest_common_ancestor"},{"type":"text","text":", JGraphT’s "},{"type":"codeVoice","code":"LowestCommonAncestorAlgorithm"},{"text":").","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"title":"LowestCommonAncestors","url":"\/documentation\/treealgorithms\/lowestcommonancestors","kind":"symbol","type":"topic"}}}