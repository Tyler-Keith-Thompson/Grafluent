ruct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HeavyLightDecomposition"}],"abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"navigatorTitle":[{"kind":"identifier","text":"HeavyLightDecomposition"}],"kind":"symbol","title":"HeavyLightDecomposition","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"type":"topic","url":"\/documentation\/treealgorithms","role":"collection","abstract":[],"kind":"symbol","title":"TreeAlgorithms","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees","url":"\/documentation\/treealgorithms\/trees","kind":"symbol","role":"collection","title":"Trees","abstract":[]}}}