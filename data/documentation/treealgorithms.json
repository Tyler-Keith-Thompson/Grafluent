{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"},"kind":"symbol","metadata":{"roleHeading":"Framework","externalID":"TreeAlgorithms","modules":[{"name":"TreeAlgorithms"}],"role":"collection","title":"TreeAlgorithms","symbolKind":"module"},"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"],"title":"Structures","generated":true},{"anchor":"Extended-Modules","identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees"],"title":"Extended Modules","generated":true}],"variants":[{"paths":["\/documentation\/treealgorithms"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"role":"collection","title":"TreeAlgorithms","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","kind":"symbol","abstract":[],"url":"\/documentation\/treealgorithms"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"kind":"symbol","title":"Trees","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/treealgorithms\/trees"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/LowestCommonAncestors":{"navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","abstract":[{"text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work.","type":"text"}],"kind":"symbol","title":"LowestCommonAncestors","role":"symbol","url":"\/documentation\/treealgorithms\/lowestcommonancestors"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"title":"HeavyLightDecomposition","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","kind":"symbol","type":"topic","url":"\/documentation\/treealgorithms\/heavylightdecomposition","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}]}}}