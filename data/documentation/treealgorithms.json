{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"},"kind":"symbol","hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"TreeAlgorithms","modules":[{"name":"TreeAlgorithms"}],"title":"TreeAlgorithms","symbolKind":"module","roleHeading":"Framework","role":"collection"},"topicSections":[{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees"],"generated":true,"title":"Extended Modules","anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/treealgorithms"]}],"references":{"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"type":"topic","title":"Trees","abstract":[],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees","role":"collection","url":"\/documentation\/treealgorithms\/trees"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"url":"\/documentation\/treealgorithms","kind":"symbol","type":"topic","title":"TreeAlgorithms","abstract":[],"role":"collection","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/HeavyLightDecomposition":{"type":"topic","abstract":[{"type":"text","text":"The heavy–light decomposition of a rooted tree or arborescence: each vertex’s heavy child is"},{"type":"text","text":" "},{"type":"text","text":"its child with the largest subtree (the first in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order on a tie), and the"},{"type":"text","text":" "},{"type":"text","text":"heavy edges form paths. Vertices get positions in a preorder that takes the heavy child first,"},{"type":"text","text":" "},{"type":"text","text":"so each heavy path and each subtree is an interval of positions, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"type":"codeVoice","code":"segments(from:to:)"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"title":"HeavyLightDecomposition","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HeavyLightDecomposition","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/HeavyLightDecomposition","role":"symbol","navigatorTitle":[{"text":"HeavyLightDecomposition","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/heavylightdecomposition"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/LowestCommonAncestors":{"type":"topic","abstract":[{"type":"text","text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work"},{"type":"text","text":" "},{"type":"text","text":"(NetworkX "},{"type":"codeVoice","code":"lowest_common_ancestor"},{"type":"text","text":", JGraphT’s "},{"type":"codeVoice","code":"LowestCommonAncestorAlgorithm"},{"text":").","type":"text"}],"title":"LowestCommonAncestors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","role":"symbol","navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/lowestcommonancestors"}}}