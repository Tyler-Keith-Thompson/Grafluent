s, and any path between two"},{"type":"text","text":" "},{"type":"text","text":"vertices is at most 2⌊log₂ n⌋ + 1 intervals ("},{"code":"segments(from:to:)","type":"codeVoice"},{"type":"text","text":"), for path and subtree"},{"type":"text","text":" "},{"type":"text","text":"queries over a structure indexed by position."}],"role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms":{"kind":"symbol","url":"\/documentation\/treealgorithms","title":"TreeAlgorithms","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms","abstract":[],"role":"collection"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees","type":"topic","url":"\/documentation\/treealgorithms\/trees","abstract":[],"role":"collection","title":"Trees","kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/LowestCommonAncestors":{"type":"topic","title":"LowestCommonAncestors","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/LowestCommonAncestors","navigatorTitle":[{"text":"LowestCommonAncestors","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Lowest common ancestors of a rooted tree or arborescence, each in O(1) after O(n) work.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LowestCommonAncestors","kind":"identifier"}],"url":"\/documentation\/treealgorithms\/lowestcommonancestors"}}}