t":" ","type":"text"},{"text":"are told apart, and a weight or other per-edge value is read at the position given. It holds a","type":"text"},{"text":" ","type":"text"},{"text":"copy of the graph, so later changes to the original do not affect it, and it can be iterated","type":"text"},{"text":" ","type":"text"},{"text":"more than once.","type":"text"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearch","kind":"symbol","title":"EdgeBreadthFirstSearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeBreadthFirstSearch"}],"type":"topic","url":"\/documentation\/traversal\/edgebreadthfirstsearch","navigatorTitle":[{"kind":"identifier","text":"EdgeBreadthFirstSearch"}]},"doc://Traversal/documentation/Traversal/iterativeDeepeningDepthFirstSearch(from:successors:until:)":{"role":"symbol","abstract":[{"text":"A shortest path by edge count from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" to the first state satisfying ","type":"text"},{"code":"isGoal","type":"codeVoice"},{"text":", by iterative","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"deepening."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/iterativeDeepeningDepthFirstSearch(from:successors:until:)","kind":"symbol","title":"iterativeDeepeningDepthFirstSearch(from:successors:until:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"iterativeDeepeningDepthFirstSearch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Successors","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"successors","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text"