ion\/Traversal\/breadthFirstSearch(from:depthLimit:successors:)"},"doc://Traversal/documentation/Traversal/DirectedSimplePaths":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DirectedSimplePaths"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedSimplePaths"}],"abstract":[{"type":"text","text":"Every simple path of a directed graph from a source to any of a set of targets, lazily, in the"},{"type":"text","text":" "},{"type":"text","text":"order a depth-first search from the source, taking out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, reaches them."}],"kind":"symbol","url":"\/documentation\/traversal\/directedsimplepaths","title":"DirectedSimplePaths","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths","role":"symbol","type":"topic"},"doc://Traversal/documentation/Traversal/UndirectedSimplePaths":{"type":"topic","title":"UndirectedSimplePaths","kind":"symbol","navigatorTitle":[{"text":"UndirectedSimplePaths","kind":"identifier"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedSimplePaths","role":"symbol","url":"\/documentation\/traversal\/undirectedsimplepaths","abstract":[{"text":"Every simple path of an undirected graph from a source to any of a set of targets, lazily, in","type":"text"},{"text":" ","type":"text"},{"text":"the order a depth-first search from the source, taking edges in ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" order, reaches","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"them. Each path is listed once, from the source; each copy of a parallel edge gives a different"},{"type":"text","text":" "},{"type":"text","text":"path, and a self-loop is on none. Otherwise as "},{"type":"codeVoice","code":"DirectedSimplePaths"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedSimplePaths","k