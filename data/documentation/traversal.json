al/DirectedSimplePaths":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedSimplePaths","kind":"identifier"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths","role":"symbol","kind":"symbol","title":"DirectedSimplePaths","abstract":[{"type":"text","text":"Every simple path of a directed graph from a source to any of a set of targets, lazily, in the"},{"type":"text","text":" "},{"type":"text","text":"order a depth-first search from the source, taking out-edges in "},{"code":"outEdges","type":"codeVoice"},{"type":"text","text":" order, reaches them."}],"url":"\/documentation\/traversal\/directedsimplepaths","navigatorTitle":[{"text":"DirectedSimplePaths","kind":"identifier"}],"type":"topic"},"doc://Traversal/documentation/Traversal/depthFirstSearch(from:depthLimit:successors:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"depthFirstSearch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Successors"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":", "},{"kind":"externalParam","text":"depthLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"successors"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Successors"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DepthFirstSearchEvent","preciseIdentifier":"s:9Traversal21DepthFirstSearchEventO"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">>\n"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/depthFirstSearch(from:depthLimit:successors:)","title":"depthFirstSearch(from:depthLimit:successors:)","abstract":[{"type":"text","text":"A depth-first search over "},{"type":"codeVoice","code":"successors"},{"type":"text","text":", from each of "},{"type":"codeVoice","code":"sources"},{"type":"text","text":" in turn. Lazy: on an infinite"},{"type":"text","text":" "},{"type":"text","text":"space, give a depth limit or stop iterating. To prune, return fewer successors."}],"type":"topic","role":"symbol","url":"\/documentation\/traversal\/depthfirstsearch(from:depthlimit:successors:)"},"doc://Traversal/documentation/Traversal/UndirectedEdgeDepthFirstSearch":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}],"kind":"symbol","title":"UndirectedEdgeDepthFirstSearch","url":"\/documentation\/traversal\/undirectededgedepthfirstsearch","navigatorTitle":[{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The edge depth-first search of an undirected graph: a sequence of "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"that reports each edge once, by its position, from the end that reaches it first. The tree"},{"type":"text","text":" "},{"type":"text","text":"edge into a vertex is not reported again from it, so a parallel edge to the parent is a back"},{"type":"text","text":" "},{"type":"text","text":"edge. It holds a copy of the graph and can be iterated more than once, and keeps its own stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch"},"doc://Traversal/documentation/Traversal/BreadthFirstSearch":{"navigatorTitle":[{"text":"BreadthFirstSearch","kind":"identifier"}],"title":"BreadthFirstSearch","abstract":[{"text":"A breadth-first search: a sequence of ","type":"text"},{"type":"codeVoice","code":"BreadthFirstSearchEvent"},{"text":"s. It holds a copy of the graph,","type":"text"},{"text":" ","type":"text"},{"text":"so later changes to the original do not affect it, and it can be iterated more than once.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Per-vertex state is kept in arrays indexed by the graph’s vertex indices when it has them."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/BreadthFirstSearch","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BreadthFirstSearch","kind":"identifier"}],"url":"\/documentation\/traversal\/breadthfirstsearch"},"doc://Traversal/documentation/Traversal/iterativeDeepeningDepthFirstSearch(from:successors:until:)":{"url":"\/documentation\/traversal\/iterativedeepeningdepthfirstsearch(from:successors:until:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"iterativeDeepeningDepthFirstSearch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Successors","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"successors","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Successors","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"until","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"abstract":[{"text":"A shortest path by edge count from ","type":"text"},{"code":"start","type":"codeVoice"},{"text":" to the first state satisfying ","type":"text"},{"code":"isGoal","type":"codeVoice"},{"text":", by iterative","type":"text"},{"text":" ","type":"text"},{"text":"deepening.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/iterativeDeepeningDepthFirstSearch(from:successors:until:)","role":"symbol","title":"iterativeDeepeningDepthFirstSearch(from:successors:until:)","type":"topic"},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearch":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearch","role":"symbol","abstract":[{"text":"A depth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"text":"s, in the order ","type":"text"},{"code":"DepthFirstSearch","type":"codeVoice"},{"text":" reports them, with every edge","type":"text"},{"text":" ","type":"text"},{"text":"classified as a tree, back, forward or cross edge. Parallel edges are told apart: a repeated","type":"text"},{"text":" ","type":"text"},{"text":"tree edge is a forward edge at its own position. It holds a copy of the graph and can be","type":"text"},{"text":" ","type":"text"},{"text":"iterated more than once. The search keeps its own stack, so a deep graph cannot overflow the","type":"text"},{"text":" ","type":"text"},{"text":"call stack.","type":"text"}],"title":"EdgeDepthFirstSearch","kind":"symbol","url":"\/documentation\/traversal\/edgedepthfirstsearch","navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearch"}],"type":"topic"},"doc://Traversal/documentation/Traversal/UndirectedSimplePaths":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedSimplePaths"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedSimplePaths","role":"symbol","kind":"symbol","title":"UndirectedSimplePaths","abstract":[{"type":"text","text":"Every simple path of an undirected graph from a source to any of a set of targets, lazily, in"},{"type":"text","text":" "},{"type":"text","text":"the order a depth-first search from the source, taking edges in "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order, reaches"},{"type":"text","text":" "},{"type":"text","text":"them. Each path is listed once, from the source; each copy of a parallel edge gives a different"},{"type":"text","text":" "},{"type":"text","text":"path, and a self-loop is on none. Otherwise as "},{"type":"codeVoice","code":"DirectedSimplePaths"},{"type":"text","text":"."}],"url":"\/documentation\/traversal\/undirectedsimplepaths","navigatorTitle":[{"kind":"identifier","text":"UndirectedSimplePaths"}],"type":"topic"},"doc://Traversal/documentation/Traversal/EdgeBreadthFirstSearch":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeBreadthFirstSearch"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearch","role":"symbol","kind":"symbol","abstract":[{"text":"A breadth-first search whose edge events carry edge positions: a sequence of","type":"text"},{"text":" ","type":"text"},{"code":"EdgeBreadthFirstSearchEvent","type":"codeVoice"},{"text":"s, in the order ","type":"text"},{"code":"BreadthFirstSearch","type":"codeVoice"},{"text":" reports them. Parallel edges","type":"text"},{"type":"text","text":" "},{"type":"text","text":"are told apart, and a weight or other per-edge value is read at the position given. It holds a"},{"type":"text","text":" "},{"type":"text","text":"copy of the graph, so later changes to the original do not affect it, and it can be iterated"},{"type":"text","text":" "},{"type":"text","text":"more than once."}],"title":"EdgeBreadthFirstSearch","url":"\/documentation\/traversal\/edgebreadthfirstsearch","navigatorTitle":[{"kind":"identifier","text":"EdgeBreadthFirstSearch"}],"type":"topic"},"doc://Traversal/documentation/Traversal/KahnEvents":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KahnEvents"}],"kind":"symbol","url":"\/documentation\/traversal\/kahnevents","title":"KahnEvents","navigatorTitle":[{"kind":"identifier","text":"KahnEvents"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Kahn’s topological sort as a sequence of "},{"type":"codeVoice","code":"KahnEvent"},{"type":"text","text":"s, pulled one at a time. Making it counts"},{"type":"text","text":" "},{"type":"text","text":"every vertex’s in-edges; iterating emits the vertices. It holds a copy of the graph, so later"},{"type":"text","text":" "},{"text":"changes to the original do not affect it, and it can be iterated more than once.","type":"text"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/KahnEvents"},"doc://Traversal/documentation/Traversal/EdgeBreadthFirstSearchEvent":{"navigatorTitle":[{"text":"EdgeBreadthFirstSearchEvent","kind":"identifier"}],"title":"EdgeBreadthFirstSearchEvent","abstract":[{"text":"What an edge breadth-first search reports, in order: the events of ","type":"text"},{"code":"BreadthFirstSearchEvent","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"with each edge given by its position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", so parallel edges are told apart.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeBreadthFirstSearchEvent","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EdgeBreadthFirstSearchEvent","