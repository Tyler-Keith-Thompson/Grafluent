 "},{"code":"EdgeDepthFirstSearchEvent","type":"codeVoice"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"that reports each edge once, by its position, from the end that reaches it first. The tree"},{"type":"text","text":" "},{"type":"text","text":"edge into a vertex is not reported again from it, so a parallel edge to the parent is a back"},{"type":"text","text":" "},{"type":"text","text":"edge. It holds a copy of the graph and can be iterated more than once, and keeps its own stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch","url":"\/documentation\/traversal\/undirectededgedepthfirstsearch"},"doc://Traversal/documentation/Traversal/UndirectedEdgeBreadthFirstSearch":{"abstract":[{"text":"The edge breadth-first search of an undirected graph: a sequence of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EdgeBreadthFirstSearchEvent"},{"text":"s that reports each edge once, by its position, from the end","type":"text"},{"text":" ","type":"text"},{"text":"whose edges are examined first. It holds a copy of the graph and can be iterated more than","type":"text"},{"type":"text","text":" "},{"type":"text","text":"once."}],"navigatorTitle":[{"kind":"identifier","text":"UndirectedEdgeBreadthFirstSearch"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeBreadthFirstSearch","type":"topic","title":"UndirectedEdgeBreadthFirstSearch","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdgeBreadthFirstSearch"}],"url":"\/documentation\/traversal\/undirectededgebreadthfirstsearch","role":"symbol"},"doc://Traversal/documentation/Traversal/EdgeBreadthFirstSearch":{"url":"\/documentation\/traversal\/edgebreadthfirstsearch","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EdgeBreadthFirstSearch"}],"type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\