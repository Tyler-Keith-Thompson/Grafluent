nt","kind":"identifier"}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/DepthFirstSearchEvent","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"What a depth-first search reports, in order, with the classification of CLRS §22.3."}]},"doc://Traversal/documentation/Traversal/depthFirstSearch(from:depthLimit:successors:)":{"type":"topic","abstract":[{"type":"text","text":"A depth-first search over "},{"type":"codeVoice","code":"successors"},{"type":"text","text":", from each of "},{"type":"codeVoice","code":"sources"},{"type":"text","text":" in turn. Lazy: on an infinite"},{"type":"text","text":" "},{"type":"text","text":"space, give a depth limit or stop iterating. To prune, return fewer successors."}],"title":"depthFirstSearch(from:depthLimit:successors:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"depthFirstSearch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Successors","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"depthLimit","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"successors","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Successors","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:9Traversal21DepthFirstSearchEventO","text":"DepthFirstSearchEvent","kind":"typeIdentifier"},{"text":"<","kin