Traversal/documentation/Traversal/UndirectedEdgeDepthFirstSearch":{"title":"UndirectedEdgeDepthFirstSearch","type":"topic","navigatorTitle":[{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}],"abstract":[{"type":"text","text":"The edge depth-first search of an undirected graph: a sequence of "},{"type":"codeVoice","code":"EdgeDepthFirstSearchEvent"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"that reports each edge once, by its position, from the end that reaches it first. The tree"},{"type":"text","text":" "},{"type":"text","text":"edge into a vertex is not reported again from it, so a parallel edge to the parent is a back"},{"type":"text","text":" "},{"type":"text","text":"edge. It holds a copy of the graph and can be iterated more than once, and keeps its own stack."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeDepthFirstSearch","role":"symbol","kind":"symbol","url":"\/documentation\/traversal\/undirectededgedepthfirstsearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedEdgeDepthFirstSearch"}]},"doc://Traversal/documentation/Traversal/EdgeDepthFirstSearchEvent":{"navigatorTitle":[{"kind":"identifier","text":"EdgeDepthFirstSearchEvent"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EdgeDepthFirstSearchEvent"}],"title":"EdgeDepthFirstSearchEvent","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/EdgeDepthFirstSearchEvent","abstract":[{"type":"text","text":"What an edge depth-first search reports, in order: the events of "},{"type":"codeVoice","code":"DepthFirstSearchEvent"},{"type":"text","text":", with"},{"type":"text","text":" "},{"type":"text","text":"each edge given by its position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", so parallel edges are told apart."}],"url":"\/documentation\/traversal\/edgedepthfirstsearchevent","kind":"sy