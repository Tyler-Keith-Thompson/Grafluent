first search: a sequence of "},{"type":"codeVoice","code":"BreadthFirstSearchEvent"},{"type":"text","text":"s. It holds a copy of the graph,"},{"type":"text","text":" "},{"type":"text","text":"so later changes to the original do not affect it, and it can be iterated more than once."},{"type":"text","text":" "},{"type":"text","text":"Per-vertex state is kept in arrays indexed by the graph’s vertex indices when it has them."}],"title":"BreadthFirstSearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BreadthFirstSearch"}]},"doc://Traversal/documentation/Traversal/DirectedSimplePaths":{"url":"\/documentation\/traversal\/directedsimplepaths","title":"DirectedSimplePaths","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"DirectedSimplePaths","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedSimplePaths","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/DirectedSimplePaths","abstract":[{"type":"text","text":"Every simple path of a directed graph from a source to any of a set of targets, lazily, in the"},{"type":"text","text":" "},{"type":"text","text":"order a depth-first search from the source, taking out-edges in "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" order, reaches them."}]},"doc://Traversal/documentation/Traversal/GraphProtocols":{"role":"collection","type":"topic","identifier":"doc:\/\/Traversal\/documentation\/Traversal\/GraphProtocols","kind":"symbol","abstract":[],"url":"\/documentation\/traversal\/graphprotocols","title":"GraphProtocols"},"doc://Traversal/documentation/Traversal/UndirectedEdgeDepthFirstSearch":{"navigatorTitle":[{"text":"UndirectedEdgeDepthFirstSearch","kind":"identifier"}],"url":"\/documentation\/traversal\/undirectededgedepthfirstsearch","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"