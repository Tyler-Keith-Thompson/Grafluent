"},{"text":" ","kind":"text"},{"text":"EdgeDepthFirstSearch","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"EdgeDepthFirstSearch","kind":"identifier"}]},"doc://Traversal/documentation/Traversal/BreadthFirstSearch":{"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/BreadthFirstSearch","type":"topic","abstract":[{"text":"A breadth-first search: a sequence of ","type":"text"},{"type":"codeVoice","code":"BreadthFirstSearchEvent"},{"text":"s. It holds a copy of the graph,","type":"text"},{"text":" ","type":"text"},{"text":"so later changes to the original do not affect it, and it can be iterated more than once.","type":"text"},{"text":" ","type":"text"},{"text":"Per-vertex state is kept in arrays indexed by the graph’s vertex indices when it has them.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BreadthFirstSearch"}],"navigatorTitle":[{"kind":"identifier","text":"BreadthFirstSearch"}],"url":"\/documentation\/traversal\/breadthfirstsearch","title":"BreadthFirstSearch","role":"symbol","kind":"symbol"},"doc://Traversal/documentation/Traversal/UndirectedEdgeBreadthFirstSearch":{"abstract":[{"type":"text","text":"The edge breadth-first search of an undirected graph: a sequence of"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeBreadthFirstSearchEvent"},{"type":"text","text":"s that reports each edge once, by its position, from the end"},{"type":"text","text":" "},{"type":"text","text":"whose edges are examined first. It holds a copy of the graph and can be iterated more than"},{"type":"text","text":" "},{"type":"text","text":"once."}],"identifier":"doc:\/\/Traversal\/documentation\/Traversal\/UndirectedEdgeBreadthFirstSearch","title":"UndirectedEdgeBreadthFirstSearch","url":"\/documentation\/traversal\/undirectededgebreadthfirstsearch","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","