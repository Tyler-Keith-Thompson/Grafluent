aph\/incidentEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighborIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighbors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexIndex(of:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"variants":[{"paths":["\/documentation\/graphprotocols\/graph"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"roleHeading":"Protocol","symbolKind":"protocol","modules":[{"name":"GraphProtocols"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"title":"Graph","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Graph.swift#L56","fileName":"Graph.swift"},"externalID":"s:14GraphProtocols0A0P"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges and their identity.","type":"text"}]},{"type":"text","text":" "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" lists every edge once (each copy of a parallel edge, and"},{"type":"text","text":" "},{"type":"text","text":"each self-loop, once), and an edge’s position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" is its identity. The edge is reached"},{"type":"text","text":" "},{"type":"text","text":"from both its endpoints through "},{"code":"incidentEdges(of:)","type":"codeVoice"},{"type":"text","text":", always at that one position, so a value"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"code":"Edges.Index","type":"codeVoice"},{"type":"text","text":" (a weight) is the same in both directions. Positions are valid until the"},{"type":"text","text":" "},{"type":"text","text":"graph is mutated."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Counting."}]},{"text":" Neighborhoods count edge ends. A vertex ","type":"text"},{"type":"codeVoice","code":"w ≠ v"},{"text":" appears in ","type":"text"},{"type":"codeVoice","code":"neighbors(of: v)"},{"text":" ","type":"text"},{"text":"once per edge between them. A self-loop has both its ends at ","type":"text"},{"type":"codeVoice","code":"v"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" appears in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"neighbors(of: v)"},{"text":" twice per loop, and the loop’s position twice in ","type":"text"},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"text":" ","type":"text"},{"text":"(Boost’s ","type":"text"},{"type":"codeVoice","code":"adjacency_list"},{"text":", LEMON, igraph). ","type":"text"},{"type":"codeVoice","code":"degree(of:)"},{"text":" is the length of either, so a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop counts 2 and the degrees sum to ","type":"text"},{"type":"codeVoice","code":"2 * edgeCount"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex and edge indices.","type":"text"}]},{"text":" As for ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": with ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps the vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency in index space. A representation with dense edge","type":"text"},{"text":" ","type":"text"},{"text":"indices also reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions","type":"text"},{"text":" ","type":"text"},{"text":"one-to-one onto ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too.","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdgeIndices(ofIndex:)","type":"codeVoice"},{"text":" lists them parallel to ","type":"text"},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"text":" Every conformer satisfies:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":" lists the position of each edge with an end at"},{"type":"text","text":" "},{"type":"codeVoice","code":"v"},{"type":"text","text":" once per end (a self-loop twice); each such edge has "},{"type":"codeVoice","code":"v"},{"type":"text","text":" as an endpoint;"},{"type":"text","text":" "},{"type":"codeVoice","code":"oppositeVertex(to: v, acrossEdgeAt: e)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"edges[e].oppositeVertex(to: v)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" is the opposite vertices in the same order; "},{"type":"codeVoice","code":"degree(of: v)"},{"type":"text","text":" is their"},{"type":"text","text":" "},{"type":"text","text":"count."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The degrees sum to ","type":"text"},{"code":"2 * edgeCount","type":"codeVoice"},{"text":". ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" is true exactly for the edges in","type":"text"},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", in either orientation, and ","type":"text"},{"code":"contains","type":"codeVoice"},{"text":" is false (and does not trap) for anything","type":"text"},{"text":" ","type":"text"},{"text":"absent.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Asking again gives the same answer."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order: "},{