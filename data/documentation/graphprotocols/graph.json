{"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/IncidentEdgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/IncidentEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/NeighborIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Neighbors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertices-swift.associatedtype"],"anchor":"Associated-Types","generated":true,"title":"Associated Types"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/directed","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertices-swift.property"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/endpointIndices(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighborIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighbors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexIndex(of:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","roleHeading":"Protocol","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"symbolKind":"protocol","remoteSource":{"fileName":"Graph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Graph.swift#L56"},"externalID":"s:14GraphProtocols0A0P","modules":[{"name":"GraphProtocols"}]},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"],"title":"Inherited By","type":"inheritedBy"},{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView"],"title":"Conforming Types","type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"inlineContent":[{"text":"Edges and their identity.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists every edge once (each copy of a parallel edge, and","type":"text"},{"text":" ","type":"text"},{"text":"each self-loop, once), and an edge’s position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" is its identity. The edge is reached","type":"text"},{"text":" ","type":"text"},{"text":"from both its endpoints through ","type":"text"},{"type":"codeVoice","code":"incidentEdges(of:)"},{"text":", always at that one position, so a value","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"type":"codeVoice","code":"Edges.Index"},{"text":" (a weight) is the same in both directions. Positions are valid until the","type":"text"},{"text":" ","type":"text"},{"text":"graph is mutated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Counting.","type":"text"}],"type":"strong"},{"text":" Neighborhoods count edge ends. A vertex ","type":"text"},{"code":"w ≠ v","type":"codeVoice"},{"text":" appears in ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"once per edge between them. A self-loop has both its ends at ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" appears in","type":"text"},{"text":" ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" twice per loop, and the loop’s position twice in ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(Boost’s ","type":"text"},{"code":"adjacency_list","type":"codeVoice"},{"text":", LEMON, igraph). ","type":"text"},{"code":"degree(of:)","type":"codeVoice"},{"text":" is the length of either, so a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop counts 2 and the degrees sum to ","type":"text"},{"code":"2 * edgeCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Vertex and edge indices.","type":"text"}],"type":"strong"},{"type":"text","text":" As for "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": with "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"type":"text","text":" gives adjacency in index space. A representation with dense edge"},{"type":"text","text":" "},{"type":"text","text":"indices also reports "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and then "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" maps edge positions"},{"type":"text","text":" "},{"type":"text","text":"one-to-one onto "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"edge_index"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":"), so"},{"type":"text","text":" "},{"type":"text","text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too."},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdgeIndices(ofIndex:)"},{"type":"text","text":" lists them parallel to "},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"text":" Every conformer satisfies:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":": ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" lists the position of each edge with an end at","type":"text"},{"text":" ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" once per end (a self-loop twice); each such edge has ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" as an endpoint;","type":"text"},{"text":" ","type":"text"},{"code":"oppositeVertex(to: v, acrossEdgeAt: e)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"edges[e].oppositeVertex(to: v)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" is the opposite vertices in the same order; ","type":"text"},{"code":"degree(of: v)","type":"codeVoice"},{"text":" is their","type":"text"},{"text":" ","type":"text"},{"text":"count.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", in either orientation, and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything"},{"type":"text","text":" "},{"type":"text","text":"absent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asking again gives the same answer."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is in index order: ","type":"text"},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"th vertex.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"neighborIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" "},{"type":"text","text":"mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":", in the same order."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"incidentEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"endpointIndices(ofEdgeAt: e)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"edges[e]","type":"codeVoice"},{"text":"’s ends mapped through ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With edge indices, "},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"type":"text","text":", "},{"code":"edgeIndex(of:)","type":"codeVoice"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"type":"text","text":", and, with vertex indices too,"},{"type":"text","text":" "},{"code":"incidentEdgeIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is "},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"type":"text","text":" mapped through"},{"type":"text","text":" "},{"code":"edgeIndex(of:)","type":"codeVoice"},{"type":"text","text":", in the same order."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With edge indices, ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is in index order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position of ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" has ","type":"text"},{"code":"edgeIndex","type":"codeVoice"},{"text":" ","type":"text"},{"code":"k","type":"codeVoice"},{"text":". So an algorithm that gathers edges from the index-space rows can order them by position","type":"text"},{"text":" ","type":"text"},{"text":"(a tie rule) without walking ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Defaults."}],"type":"strong"},{"text":" As for ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", members with default implementations are requirements,","type":"text"},{"text":" ","type":"text"},{"text":"so a representation’s faster version is the one generic code calls, and a wrapper must forward","type":"text"},{"text":" ","type":"text"},{"text":"every one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has no mutation; mutation belongs to concrete types. It does not refine","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/graph"]}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them.