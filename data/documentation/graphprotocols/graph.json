hProtocols\/Graph\/Neighbors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertices-swift.associatedtype"],"anchor":"Associated-Types","title":"Associated Types","generated":true},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/directed","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertices-swift.property"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighborIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighbors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexIndex(of:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges and their identity."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists every edge once (each copy of a parallel edge, and"},{"type":"text","text":" "},{"type":"text","text":"each self-loop, once), and an edge’s position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is its identity. The edge is reached"},{"type":"text","text":" "},{"type":"text","text":"from both its endpoints through "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":", always at that one position, so a value"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":" (a weight) is the same in both directions. Positions are valid until the"},{"type":"text","text":" "},{"type":"text","text":"graph is mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Counting.","type":"text"}]},{"type":"text","text":" Neighborhoods count edge ends. A vertex "},{"type":"codeVoice","code":"w ≠ v"},{"type":"text","text":" appears in "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" "},{"type":"text","text":"once per edge between them. A self-loop has both its ends at "},{"type":"codeVoice","code":"v"},{"type":"text","text":", so "},{"type":"codeVoice","code":"v"},{"type":"text","text":" appears in"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" twice per loop, and the loop’s position twice in "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":" "},{"type":"text","text":"(Boost’s "},{"type":"codeVoice","code":"adjacency_list"},{"type":"text","text":", LEMON, igraph). "},{"type":"codeVoice","code":"degree(of:)"},{"type":"text","text":" is the length of either, so a"},{"type":"text","text":" "},{"type":"text","text":"self-loop counts 2 and the degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Vertex and edge indices.","type":"text"}],"type":"strong"},{"text":" As for ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": with ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps the vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency in index space. A representation with dense edge","type":"text"},{"text":" ","type":"text"},{"text":"indices also reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions","type":"text"},{"text":" ","type":"text"},{"text":"one-to-one onto ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too.","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdgeIndices(ofIndex:)","type":"codeVoice"},{"text":" lists them parallel to ","type":"text"},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and every edge’s endpoints are","type":"text"},{"text":" ","type":"text"},{"text":"vertices; ","type":"text"},{"code":"edgeCount == edges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":": ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" lists the position of each edge with an end at","type":"text"},{"text":" ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" once per end (a self-loop twice); each such edge has ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" as an endpoint;","type":"text"},{"text":" ","type":"text"},{"code":"oppositeVertex(to: v, acrossEdgeAt: e)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"edges[e].oppositeVertex(to: v)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" is the opposite vertices in the same order; ","type":"text"},{"code":"degree(of: v)","type":"codeVoice"},{"text":" is their","type":"text"},{"text":" ","type":"text"},{"text":"count.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", in either orientation, and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything"},{"type":"text","text":" "},{"type":"text","text":"absent."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Asking again gives the same answer."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order: "},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"i"},{"type":"text","text":"th vertex."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"neighborIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" "},{"type":"text","text":"mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":", in the same order."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"incidentEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is "},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With edge indices, ","type":"text"},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":", and, with vertex indices too,","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdgeIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" mapped through","type":"text"},{"text":" ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":", in the same order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is in index order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position of "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" has "},{"type":"codeVoice","code":"edgeIndex"},{"type":"text","text":" "},{"type":"codeVoice","code":"k"},{"type":"text","text":". So an algorithm that gathers edges from the index-space rows can order them by position"},{"type":"text","text":" "},{"type":"text","text":"(a tie rule) without walking "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Defaults.","type":"text"}],"type":"strong"},{"text":" As for ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":", members with default implementations are requirements,","type":"text"},{"text":" ","type":"text"},{"text":"so a representation’s faster version is the one generic code calls, and a wrapper must forward","type":"text"},{"text":" ","type":"text"},{"text":"every one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has no mutation; mutation belongs to concrete types. It does not refine"},{"type":"text","text":" "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols":{"title":"GraphProtocols","abstract":[],"role":"collection","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols"},"doc://GraphProtocols/documentation/Gr