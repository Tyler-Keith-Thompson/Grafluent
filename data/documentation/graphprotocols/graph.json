:"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges and their identity.","type":"text"}]},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists every edge once (each copy of a parallel edge, and","type":"text"},{"text":" ","type":"text"},{"text":"each self-loop, once), and an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is its identity. The edge is reached","type":"text"},{"text":" ","type":"text"},{"text":"from both its endpoints through ","type":"text"},{"code":"incidentEdges(of:)","type":"codeVoice"},{"text":", always at that one position, so a value","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":" (a weight) is the same in both directions. Positions are valid until the","type":"text"},{"text":" ","type":"text"},{"text":"graph is mutated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Counting."}],"type":"strong"},{"text":" Neighborhoods count edge ends. A vertex ","type":"text"},{"code":"w ≠ v","type":"codeVoice"},{"text":" appears in ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"once per edge between them. A self-loop has both its ends at ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" appears in","type":"text"},{"text":" ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" twice per loop, and the loop’s position twice in ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(Boost’s ","type":"text"},{"code":"adjacency_list","type":"codeVoice"},{"text":", LEMON, igraph). ","type":"text"},{"code":"degree(of:)","type":"codeVoice"},{"text":" is the length of either, so a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop counts 2 and the degrees sum to ","type":"text"},{"code":"2 * edgeCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex and edge indices.","type":"text"}]},{"type":"text","text":" As for "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": with "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":" maps the vertices one-to-one onto "},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"type":"text","text":" gives adjacency in index space. A representation with dense edge"},{"type":"text","text":" "},{"type":"text","text":"indices also reports "},{"code":"edgeIndexBound","type":"codeVoice"},{"type":"text","text":", and then "},{"code":"edgeIndex(of:)","type":"codeVoice"},{"type":"text","text":" maps edge positions"},{"type":"text","text":" "},{"type":"text","text":"one-to-one onto "},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"type":"text","text":" (Boost’s "},{"code":"edge_index","type":"codeVoice"},{"type":"text","text":", petgraph’s "},{"code":"EdgeIndexable","type":"codeVoice"},{"type":"text","text":"), so"},{"type":"text","text":" "},{"type":"text","text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too."},{"type":"text","text":" "},{"code":"incidentEdgeIndices(ofIndex:)","type":"codeVoice"},{"type":"text","text":" lists them parallel to "},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":": ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" lists the position of each edge with an end at","type":"text"},{"text":" ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" once per end (a self-loop twice); each such edge has ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" as an endpoint;","type":"text"},{"text":" ","type":"text"},{"code":"oppositeVertex(to: v, acrossEdgeAt: e)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"edges[e].oppositeVertex(to: v)","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" is the opposite vertices in the same order; ","type":"text"},{"code":"degree(of: v)","type":"codeVoice"},{"text":" is their","type":"text"},{"text":" ","type":"text"},{"text":"count.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", in either orientation, and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything"},{"type":"text","text":" "},{"type":"text","text":"absent."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Asking again gives the same answer."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is in index order: ","type":"text"},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"th vertex.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex: vertexIndex(of: v))"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"neighbors(of: v)"},{"text":" ","type":"text"},{"text":"mapped through ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":", in the same order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"incidentEdges(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt: e)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"edges[e]"},{"type":"text","text":"’s ends mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With edge indices, "},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"type":"text","text":", "},{"code":"edgeIndex(of:)","type":"codeVoice"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"type":"text","text":", and, with vertex indices too,"},{"type":"text","text":" "},{"code":"incidentEdgeIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is "},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"type":"te