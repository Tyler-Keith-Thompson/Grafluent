{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"metadata":{"modules":[{"name":"GraphProtocols"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"roleHeading":"Protocol","role":"symbol","title":"Graph","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"remoteSource":{"fileName":"Graph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Graph.swift#L56"},"externalID":"s:14GraphProtocols0A0P"},"kind":"symbol","topicSections":[{"anchor":"Associated-Types","generated":true,"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/IncidentEdgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/IncidentEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/NeighborIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Neighbors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertices-swift.associatedtype"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/directed","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/Grap