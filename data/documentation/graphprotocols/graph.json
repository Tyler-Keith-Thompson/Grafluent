{"relationshipsSections":[{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView"]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"inlineContent":[{"text":"Edges and their identity.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists every edge once (each copy of a parallel edge, and","type":"text"},{"text":" ","type":"text"},{"text":"each self-loop, once), and an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is its identity. The edge is reached","type":"text"},{"text":" ","type":"text"},{"text":"from both its endpoints through ","type":"text"},{"code":"incidentEdges(of:)","type":"codeVoice"},{"text":", always at that one position, so a value","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":" (a weight) is the same in both directions. Positions are valid until the","type":"text"},{"text":" ","type":"text"},{"text":"graph is mutated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Counting."}],"type":"strong"},{"type":"text","text":" Neighborhoods count edge ends. A vertex "},{"code":"w ≠ v","type":"codeVoice"},{"type":"text","text":" appears in "},{"code":"neighbors(of: v)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"once per edge between them. A self-loop has both its ends at "},{"code":"v","type":"codeVoice"},{"type":"text","text":", so "},{"code":"v","type":"codeVoice"},{"type":"text","text":" appears in"},{"type":"text","text":" "},{"code":"neighbors(of: v)","type":"codeVoice"},{"type":"text","text":" twice per loop, and the loop’s position twice in "},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(Boost’s "},{"code":"adjacency_list","type":"codeVoice"},{"type":"text","text":", LEMON, igraph). "},{"code":"degree(of:)","type":"codeVoice"},{"type":"text","text":" is the length of either, so a"},{"type":"text","text":" "},{"type":"text","text":"self-loop counts 2 and the degrees sum to "},{"code":"2 * edgeCount","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertex and edge indices."}]},{"text":" As for ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": with ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps the vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency in index space. A representation with dense edge","type":"text"},{"text":" ","type":"text"},{"text":"indices also reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions","type":"text"},{"text":" ","type":"text"},{"text":"one-to-one onto ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too.","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdgeIndices(ofIndex:)","type":"codeVoice"},{"text":" lists them parallel to ","type":"text"},{"code":"neighborIndices(ofIndex:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":" lists the position of each edge with an end at"},{"type":"text","text":" "},{"type":"codeVoice","code":"v"},{"type":"text","text":" once per end (a self-loop twice); each such edge has "},{"type":"codeVoice","code":"v"},{"type":"text","text":" as an endpoint;"},{"type":"text","text":" "},{"type":"codeVoice","code":"oppositeVertex(to: v, acrossEdgeAt: e)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"edges[e].oppositeVertex(to: v)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" is the opposite vertices in the same order; "},{"type":"codeVoice","code":"degree(of: v)"},{"type":"text","text":" is their"},{"type":"text","text":" "},{"type":"text","text":"count."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", in either orientation, and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything"},{"type":"text","text":" "},{"type":"text","text":"absent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asking again gives the same answer."}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is in index order: ","type":"text"},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"th vertex.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"neighborIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"mapped through ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":", in the same order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"incidentEdges(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt: e)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"edges[e]"},{"type":"text","text":"’s ends mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With edge indices, ","type":"text"},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"text":", ","type":"text"},{"type":"codeVoice","code":"edgeIndex(of:)"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"text":", and, with vertex indices too,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdgeIndices(ofIndex: vertexIndex(of: v))"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"text":" mapped through","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edgeIndex(of:)"},{"text":", in the same order.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is in index order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position of "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" has "},{"type":"codeVoice","code":"edgeIndex"},{"type":"text","text":" "},{"type":"codeVoice","code":"k"},{"type":"text","text":". So an algorithm that gathers edges from the index-space rows can order them by position"},{"type":"text","text":" "},{"type":"text","text":"(a tie rule) without walking "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Defaults."}],"type":"strong"},{"text":" As for ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":", members with default implementations are requirements,","type":"text"},{"text":" ","type":"text"},{"text":"so a representation’s faster version is the one generic code calls, and a wrapper must forward","type":"text"},{"text":" ","type":"text"},{"text":"every one.","type":"text"}],"type":"paragraph"},{"