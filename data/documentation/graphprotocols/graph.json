{"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/IncidentEdgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/IncidentEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/NeighborIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Neighbors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertices-swift.associatedtype"],"anchor":"Associated-Types","title":"Associated Types","generated":true},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/directed","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertices-swift.property"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/endpointIndices(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/incidentEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighborIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/neighbors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/vertexIndex(of:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"],"type":"inheritedBy","kind":"relationships","title":"Inherited By"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView"],"type":"conformingTypes","kind":"relationships","title":"Conforming Types"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edges and their identity.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" lists every edge once (each copy of a parallel edge, and"},{"type":"text","text":" "},{"type":"text","text":"each self-loop, once), and an edge’s position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" is its identity. The edge is reached"},{"type":"text","text":" "},{"type":"text","text":"from both its endpoints through "},{"code":"incidentEdges(of:)","type":"codeVoice"},{"type":"text","text":", always at that one position, so a value"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"code":"Edges.Index","type":"codeVoice"},{"type":"text","text":" (a weight) is the same in both directions. Positions are valid until the"},{"type":"text","text":" "},{"type":"text","text":"graph is mutated."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Counting.","type":"text"}]},{"type":"text","text":" Neighborhoods count edge ends. A vertex "},{"type":"codeVoice","code":"w ≠ v"},{"type":"text","text":" appears in "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" "},{"type":"text","text":"once per edge between them. A self-loop has both its ends at "},{"type":"codeVoice","code":"v"},{"type":"text","text":", so "},{"type":"codeVoice","code":"v"},{"type":"text","text":" appears in"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" twice per loop, and the loop’s position twice in "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":" "},{"type":"text","text":"(Boost’s "},{"type":"codeVoice","code":"adjacency_list"},{"type":"text","text":", LEMON, igraph). "},{"type":"codeVoice","code":"degree(of:)"},{"type":"text","text":" is the length of either, so a"},{"type":"text","text":" "},{"type":"text","text":"self-loop counts 2 and the degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Vertex and edge indices."}],"type":"strong"},{"type":"text","text":" As for "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": with "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"type":"text","text":" gives adjacency in index space. A representation with dense edge"},{"type":"text","text":" "},{"type":"text","text":"indices also reports "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and then "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" maps edge positions"},{"type":"text","text":" "},{"type":"text","text":"one-to-one onto "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"edge_index"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":"), so"},{"type":"text","text":" "},{"type":"text","text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too."},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdgeIndices(ofIndex:)"},{"type":"text","text":" lists them parallel to "},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"text":" Every conformer satisfies:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For every vertex "},{"code":"v","type":"codeVoice"},{"type":"text","text":": "},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"type":"text","text":" lists the position of each edge with an end at"},{"type":"text","text":" "},{"code":"v","type":"codeVoice"},{"type":"text","text":" once per end (a self-loop twice); each such edge has "},{"code":"v","type":"codeVoice"},{"type":"text","text":" as an endpoint;"},{"type":"text","text":" "},{"code":"oppositeVertex(to: v, acrossEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"edges[e].oppositeVertex(to: v)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"code":"neighbors(of: v)","type":"codeVoice"},{"type":"text","text":" is the opposite vertices in the same order; "},{"code":"degree(of: v)","type":"codeVoice"},{"type":"text","text":" is their"},{"type":"text","text":" "},{"type":"text","text":"count."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", in either orientation, and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything"},{"type":"text","text":" "},{"type":"text","text":"absent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asking again gives the same answer."}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is in index order: ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"i"},{"text":"th vertex.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"neighborIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" "},{"type":"text","text":"mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":", in the same order."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"incidentEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"endpointIndices(ofEdgeAt: e)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"edges[e]","type":"codeVoice"},{"text":"’s ends mapped through ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"type":"text","text":", "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":", and, with vertex indices too,"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdgeIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":" mapped through"},{"type":"text","text":" "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":", in the same order."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is in index order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position of "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" has "},{"type":"codeVoice","code":"edgeIndex"},{"type":"text","text":" "},{"type":"codeVoice","code":"k"},{"type":"text","text":". So an algorithm that gathers edges from the index-space rows can order them by position"},{"type":"text","text":" "},{"type":"text","text":"(a tie rule) without walking "},{"type":"codeVoice","code":"edges"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"type":"text","text":" As for "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":", members with default implementations are requirements,"},{"type":"text","text":" "},{"type":"text","text":"so a representation’s faster version is the one generic code calls, and a wrapper must forward"},{"type":"text","text":" "},{"type":"text","text":"every one."}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has no mutation; mutation belongs to concrete types. It does not refine","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directed","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"metadata":{"role":"symbol","modules":[{"name":"GraphProtocols"}],"roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"remoteSource":{"fileName":"Graph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Graf