":"codeVoice","code":"v"},{"type":"text","text":", so "},{"type":"codeVoice","code":"v"},{"type":"text","text":" appears in"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" twice per loop, and the loop’s position twice in "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":" "},{"type":"text","text":"(Boost’s "},{"type":"codeVoice","code":"adjacency_list"},{"type":"text","text":", LEMON, igraph). "},{"type":"codeVoice","code":"degree(of:)"},{"type":"text","text":" is the length of either, so a"},{"type":"text","text":" "},{"type":"text","text":"self-loop counts 2 and the degrees sum to "},{"type":"codeVoice","code":"2 * edgeCount"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex and edge indices.","type":"text"}]},{"type":"text","text":" As for "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": with "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"type":"text","text":" gives adjacency in index space. A representation with dense edge"},{"type":"text","text":" "},{"type":"text","text":"indices also reports "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and then "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" maps edge positions"},{"type":"text","text":" "},{"type":"text","text":"one-to-one onto "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"edge_index"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":"), so"},{