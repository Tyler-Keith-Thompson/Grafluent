evel":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges and their identity."}],"type":"strong"},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists every edge once (each copy of a parallel edge, and","type":"text"},{"text":" ","type":"text"},{"text":"each self-loop, once), and an edge’s position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is its identity. The edge is reached","type":"text"},{"text":" ","type":"text"},{"text":"from both its endpoints through ","type":"text"},{"code":"incidentEdges(of:)","type":"codeVoice"},{"text":", always at that one position, so a value","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":" (a weight) is the same in both directions. Positions are valid until the","type":"text"},{"text":" ","type":"text"},{"text":"graph is mutated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Counting."}],"type":"strong"},{"type":"text","text":" Neighborhoods count edge ends. A vertex "},{"code":"w ≠ v","type":"codeVoice"},{"type":"text","text":" appears in "},{"code":"neighbors(of: v)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"once per edge between them. A self-loop has both its ends at "},{"code":"v","type":"codeVoice"},{"type":"text","text":", so "},{"code":"v","type":"codeVoice"},{"type":"text","text":" appears in"},{"type":"text","text":" "},{"code":"neighbors(of: v)","type":"codeVoice"},{"type":"text","text":" twice per loop, and the loop’s position twice in "},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(Boost’s "},{"code":"adjacency_list","type":"codeVoice"},{"type":"text","text":", LEMON, igraph). "},{"code":"degree(of:)","type":"codeVoice"},{"type":"text","text":" is the length of either, so a"},{"type":"text","text":" "},{"type":"text","text":"self-loop counts 2 and the degrees sum to "},{"code":"2 * edgeCount","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex and edge indices.","type":"text"}]},{"text":" As for ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":": with ","type":"text"},{"type":"codeVoice","code":"vertexIndexBound"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" maps the vertices one-to-one onto ","type":"text"},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"text":" gives adjacency in index space. A representation with dense edge","type":"text"},{"text":" ","type":"text"},{"text":"indices also reports ","type":"text"},{"type":"codeVoice","code":"edgeIndexBound"},{"text":", and then ","type":"text"},{"type":"codeVoice","code":"edgeIndex(of:)"},{"text":" maps edge positions","type":"text"},{"text":" ","type":"text"},{"text":"one-to-one onto ","type":"text"},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"text":" (Boost’s ","type":"text"},{"type":"codeVoice","code":"edge_index"},{"text":", petgraph’s ","type":"text"},{"type":"codeVoice","code":"EdgeIndexable"},{"text":"), so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdgeIndices(ofIndex:)"},{"text":" lists them parallel to ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"text":" Every conformer satisfies:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"type":"text","text":" lists the position of each edge with an end at"},{"type":"text","text":" "},{"type":"codeVoice","code":"v"},{"type":"text","text":" once per end (a self-loop twice); each such edge has "},{"type":"codeVoice","code":"v"},{"type":"text","text":" as an endpoint;"},{"type":"text","text":" "},{"type":"codeVoice","code":"oppositeVertex(to: v, acrossEdgeAt: e)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"edges[e].oppositeVertex(to: v)"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighbors(of: v)"},{"type":"text","text":" is the opposite vertices in the same order; "},{"type":"codeVoice","code":"degree(of: v)"},{"type":"text","text":" is their"},{"type":"text","text":" "},{"type":"text","text":"count."}]}]},{"content":[{"inlineContent":[{"text":"The degrees sum to ","type":"text"},{"code":"2 * edgeCount","type":"codeVoice"},{"text":". ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" is true exactly for the edges in","type":"text"},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", in either orientation, and ","type":"text"},{"code":"contains","type":"codeVoice"},{"text":" is false (and does not trap) for anything","type":"text"},{"text":" ","type":"text"},{"text":"absent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asking again gives the same answer."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" is in index order: "},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"type":"text","text":" is the "},{"code":"i","type":"codeVoice"},{"type":"text","text":"th vertex."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex: vertexIndex(of: v))"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"neighbors(of: v)"},{"text":" ","type":"text"},{"text":"mapped through ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":", in the same order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"incidentEdges(ofIndex: vertexIndex(of: v))"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"incidentEdges(of: v)"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"With edge indices, ","type":"text"},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":", and, with vertex indices too,","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdgeIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" mapped through","type":"text"},{"text":" ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":", in the same order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With edge indices, ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is in index order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position of ","type":"text"},{"code":"edges","type":"c