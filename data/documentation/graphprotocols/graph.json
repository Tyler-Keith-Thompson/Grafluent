t":"once per edge between them. A self-loop has both its ends at ","type":"text"},{"code":"v","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" appears in","type":"text"},{"text":" ","type":"text"},{"code":"neighbors(of: v)","type":"codeVoice"},{"text":" twice per loop, and the loop’s position twice in ","type":"text"},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(Boost’s ","type":"text"},{"code":"adjacency_list","type":"codeVoice"},{"text":", LEMON, igraph). ","type":"text"},{"code":"degree(of:)","type":"codeVoice"},{"text":" is the length of either, so a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop counts 2 and the degrees sum to ","type":"text"},{"code":"2 * edgeCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex and edge indices.","type":"text"}]},{"type":"text","text":" As for "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": with "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"type":"text","text":" gives adjacency in index space. A representation with dense edge"},{"type":"text","text":" "},{"type":"text","text":"indices also reports "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and then "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" maps edge positions"},{"type":"text","text":" "},{"type":"text","text":"one-to-one onto "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"edge_index"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":"), so"},{"type":"text","text":" "},{"type":"text","text":"algorithms that mark edges (bridges, cut vertices, Euler tours) keep that state in arrays too."},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdgeIndices(ofIndex:)"},{"type":"text","text":" lists them parallel to "},{"type":"codeVoice","code":"neighborIndices(ofIndex:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"text":", the vertices are distinct, and every edge’s endpoints are","type":"text"},{"text":" ","type":"text"},{"text":"vertices; ","type":"text"},{"type":"codeVoice","code":"edgeCount == edges.count"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For every vertex "},{"code":"v","type":"codeVoice"},{"type":"text","text":": "},{"code":"incidentEdges(of: v)","type":"codeVoice"},{"type":"text","text":" lists the position of each edge with an end at"},{"type":"text","text":" "},{"code":"v","type":"codeVoice"},{"type":"text","text":" once per end (a self-loop twice); each such edge has "},{"code":"v","type":"codeVoice"},{"type":"text","text":" as an endpoint;"},{"type":"text","text":" "},{"code":"oppositeVertex(to: v, acrossEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"edges[e].oppositeVertex(to: v)","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"code":"neighbors(of: v)","type":"codeVoice"},{"type":"text","text":" is the opposite vertices in the same order; "},{"code":"degree(of: v)","type":"codeVoice"},{"type":"text","text":" is their"},{"type":"text","text":" "},{"type":"text","text":"count."}],"type":"paragraph"}]},{"content":[{"inlineCon