{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Every structural mutation (an insertion, a removal, re-pointing an edge) starts a new","type":"text"},{"text":" ","type":"text"},{"text":"generation. Reserving capacity and writing attached map values do not. A structure derived from","type":"text"},{"text":" ","type":"text"},{"text":"a graph stores the graph’s ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" before it relies on the","type":"text"},{"text":" ","type":"text"},{"text":"graph again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A copy of a graph has the same generation as the original until either is mutated. Views and"},{"type":"text","text":" "},{"type":"text","text":"adaptors (a transposed view, an undirected view, a wrapper such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"report their base’s generation, so a view and its base, though they may describe different"},{"type":"text","text":" "},{"type":"text","text":"graphs, have equal generations. "},{"type":"codeVoice","code":"isCurrent(for:)"},{"type":"text","text":" answers only whether the storage of the graph"},{"type":"text","text":" "},{"type":"text","text":"passed in is in the state the generation was read from; it does not tell which view the"},{"type":"text","text":" "},{"type":"text","text":"generation was read through. An untracked generation, from a representation that does not track"},{"type":"text","text":" "},{"type":"text","text":"generations or a mutable graph never mutated, is current for no graph. Equal tracked"},{"type":"text","text":" "},{"type":"text","text":"generations are the same structural state of the same storage, and every untracked generation"},{"type":"text","text":" "},{"type":"text","text":"equals every other."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/graphgeneration"]}],"topicSections":[{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1rsfw","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1t817","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-3zt2o","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-5kltt","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-scjl"],"anchor":"Instance-Methods"},{"title":"Type Properties","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/untracked"],"anchor":"Type-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"},"metadata":{"title":"GraphGeneration","externalID":"s:14GraphProtocols0A10GenerationV","role":"symbol","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"GraphGeneration","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/GraphGeneration.swift#L53","f