{"abstract":[{"text":"A graph’s generation: which structural state of which graph storage it is.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/graphgeneration"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphGeneration"}],"navigatorTitle":[{"kind":"identifier","text":"GraphGeneration"}],"symbolKind":"struct","externalID":"s:14GraphProtocols0A10GenerationV","roleHeading":"Structure","modules":[{"name":"GraphProtocols"}],"role":"symbol","title":"GraphGeneration","remoteSource":{"fileName":"GraphGeneration.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/GraphGeneration.swift#L57"}},"topicSections":[{"anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1rsfw","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1t817","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-3zt2o","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-5kltt","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-scjl"],"title":"Instance Methods","generated":true},{"anchor":"Type-Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/untracked"],"title":"Type Properties","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/Equatable-Implementations"],"title":"Default Implementations","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every structural mutation (an insertion, a removal, re-pointing an edge) starts a new"},{"type":"text","text":" "},{"type":"text","text":"generation. Reserving capacity and writing attached map values do not. A structure derived from"},{"type":"text","text":" "},{"type":"text","text":"a graph stores the graph’s "},{"type":"codeVoice","code":"generation"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"isCurrent(for:)"},{"type":"text","text":" before it relies on the"},{"type":"text","text":" "},{"type":"text","text":"graph again."}]},{"type":"paragraph","inlineContent":[{"text":"A copy of a graph has the same generation as the original until either is mutated. Views and","type":"text"},{"text":" ","type":"text"},{"text":"adaptors (a transposed view, an undirected view, a wrapper such as ","type":"text"},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"report their base’s generation, so a view and its base, though they may describe different","type":"text"},{"text":" ","type":"text"},{"text":"graphs, have equal generations. ","type":"text"},{"type":"codeVoice","code":"isCurrent(for:)"},{"text":" answers only whether the storage of the graph","type":"text"},{"text":" ","type":"text"},{"text":"passed in is in the state the generation was read from; it does not tell which view the","type":"text"},{"text":" ","type":"text"},{"text":"generation was read through. An untracked generation, from a representation that does not track","type":"text"},{"text":" ","type":"text"},{"text":"generations or a mutable graph never mutated, is current for no graph. Equal tracked","type":"text"},{"text":" ","type":"text"},{"text":"generations are the same structural state of the same storage, and every untracked generation","type":"text"},{"text":" ","type":"text"},{"text":"equals every other.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/s15BitwiseCopyableP","doc:\/\/GraphProtocols\/SQ","doc:\/\/GraphProtocols\/s8SendableP","doc:\/\/GraphProtocols\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration/isCurrent(for:)-3zt2o":{"type":"topic","url":"\/documentation\/graphprotocols\/graphgeneration\/iscurrent(for:)-3zt2o","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCurrent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-3zt2o","kind":"symbol","title":"isCurrent(for:)","abstract":[{"type":"text","text":"Whether "},{"code":"graph","type":"codeVoice"},{"type":"text","text":" has not been structurally mutated since this generation was read from it"},{"type":"text","text":" "},{"type":"text","text":"(or from a copy of it, or from a view or adaptor over the same storage). O(1)."}],"role":"symbol"},"doc://GraphProtocols/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/GraphProtocols\/s8SendableP"},"doc://GraphProtocols/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/GraphProtocols\/SQ"},"doc://GraphProtocols/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/GraphProtocols\/s16SendableMetatypeP"},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration/isCurrent(for:)-5kltt":{"title":"isCurrent(for:)","abstract":[{"text":"Whether this is ","type":"text"},{"type":"codeVoice","code":"generation"},{"text":", meaning both were read from the same storage (a graph, its","type":"text"},{"text":" ","type":"text"},{"text":"copies, or views and adaptors over them) with no structural mutation between them. False","type":"text"},{"text":" ","type":"text"},{"text":"when either is untracked. O(1).","type":"text"}],"url":"\/documentation\/graphprotocols\/graphgeneration\/iscurrent(for:)-5kltt","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isCurrent","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A10GenerationV","text":"GraphGeneration","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-5kltt","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration/Equatable-Implementations":{"type":"topic","url":"\/documentation\/graphprotocols\/graphgeneration\/equatable-implementations","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/Equatable-Implementations","kind":"article","title":"Equatable Implementations","abstract":[],"role":"collectionGroup"},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","abstract":[],"type":"topic","title":"GraphProtocols","role":"collection","url":