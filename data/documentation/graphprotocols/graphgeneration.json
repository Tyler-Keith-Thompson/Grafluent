{"abstract":[{"type":"text","text":"A graph’s generation: which structural state of which graph storage it is."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/graphgeneration"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/s15BitwiseCopyableP","doc:\/\/GraphProtocols\/SQ","doc:\/\/GraphProtocols\/s8SendableP","doc:\/\/GraphProtocols\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Every structural mutation (an insertion, a removal, re-pointing an edge) starts a new","type":"text"},{"text":" ","type":"text"},{"text":"generation. Reserving capacity and writing attached map values do not. A structure derived from","type":"text"},{"text":" ","type":"text"},{"text":"a graph stores the graph’s ","type":"text"},{"type":"codeVoice","code":"generation"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"isCurrent(for:)"},{"text":" before it relies on the","type":"text"},{"text":" ","type":"text"},{"text":"graph again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A copy of a graph has the same generation as the original until either is mutated. Views and","type":"text"},{"text":" ","type":"text"},{"text":"adaptors (a transposed view, an undirected view, a wrapper such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"report their base’s generation, so a view and its base, though they may describe different","type":"text"},{"text":" ","type":"text"},{"text":"graphs, have equal generations. ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" answers only whether the storage of the graph","type":"text"},{"text":" ","type":"text"},{"text":"passed in is in the state the generation was read from; it does not tell which view the","type":"text"},{"text":" ","type":"text"},{"text":"generation was read through. An untracked generation, from a representation that does not track","type":"text"},{"text":" ","type":"text"},{"text":"generations or a mutable graph never mutated, is current for no graph. Equal tracked","type":"text"},{"text":" ","type":"text"},{"text":"generations are the same structural state of the same storage, and every untracked generation","type":"text"},{"text":" ","type":"text"},{"text":"equals every other.","type":"text"}],"type":"paragraph"}]}],"metadata":{"title":"GraphGeneration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"GraphGeneration"}],"role":"symbol","remoteSource":{"fileName":"GraphGeneration.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/GraphGeneration.swift#L57"},"roleHeading":"Structure","symbolKind":"struct","externalID":"s:14GraphProtocols0A10GenerationV","modules":[{"name":"GraphProtocols"}]},"topicSections":[{"anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1rsfw","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1t817","doc:\/\/GraphProtocols\/documentation\/GraphProto