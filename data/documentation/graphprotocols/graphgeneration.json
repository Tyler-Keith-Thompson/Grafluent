{"abstract":[{"type":"text","text":"A graph’s generation: which structural state of which graph storage it is."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/graphgeneration"]}],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1rsfw","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1t817","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-3zt2o","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-5kltt","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-scjl"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/untracked"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/Equatable-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"GraphGeneration"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"symbolKind":"struct","externalID":"s:14GraphProtocols0A10GenerationV","remoteSource":{"fileName":"GraphGeneration.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/GraphGeneration.swift#L57"},"title":"GraphGeneration","role":"symbol","modules":[{"name":"GraphProtocols"}],"roleHeading":"Structure"},"kind":"symbol","identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/s15BitwiseCopyableP","doc:\/\/GraphProtocols\/SQ","doc:\/\/GraphProtocols\/s8SendableP","doc:\/\/GraphProtocols\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Every structural mutation (an insertion, a removal, re-pointing an edge) starts a new","type":"text"},{"text":" ","type":"text"},{"text":"generation. Reserving capacity and writing attached map values do not. A structure derived from","type":"text"},{"text":" ","type":"text"},{"text":"a graph stores the graph’s ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" before it relies on the","type":"text"},{"text":" ","type":"text"},{"text":"graph again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A copy of a graph has the same generation as the original until either is mutated. Views and","type":"text"},{"text":" ","type":"text"},{"text":"adaptors (a transposed view, an undirected view, a wrapper such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"report their base’s generation, so a view and its base, though they may describe different","type":"text"},{"text":" ","type":"text"},{"text":"graphs, have equal generations. ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" answers only whether the storage of the graph","type":"text"},{"text":" ","type":"text"},{"text":"passed in is in the state the generation was read from; it does not tell which view the","type":"text"},{"text":" ","type":"text"},{"text":"generation was read through. An untracked generation, from a representation that does not track","type":"text"},{"text":" ","type":"text"},{"text":"generations or a mutable graph never mutated, is current for no graph. Equal tracked","type":"text"},{"text":" ","type":"text"},{"text":"generations are the same structural state of the same storage, and every untracked generation","type":"text"},{"text":" ","type":"text"},{"text":"equals every other.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/s16SendableMetatypeP":{"identifier":"doc:\/\/GraphProtocols\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://GraphProtocols/SQ":{"type":"unresolvable","identifier":"doc:\/\/GraphProtocols\/SQ","title":"Swift.Equatable"},"doc://GraphProtocols/s8SendableP":{"identifier":"doc:\/\/GraphProtocols\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration/isCurrent(for:)-1t817":{"url":"\/documentation\/graphprotocols\/graphgeneration\/iscurrent(for:)-1t817","title":"isCurrent(for:)","kind":"symbol","abstract":[{"text":"Whether ","type":"text"},{"code":"hypergraph","type":"codeVoice"},{"text":" has not been structurally mutated since this generation was read from","type":"text"},{"text":" ","type":"text"},{"text":"it (or from a copy of it, or from a view or adaptor over the same storage). O(1).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isCurrent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"for"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","kind":"typeIdentifier","text":"DirectedHypergraph"