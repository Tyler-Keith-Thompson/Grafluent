{"kind":"symbol","abstract":[{"text":"A graph’s generation: which structural state of which graph storage it is.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphGeneration"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Every structural mutation (an insertion, a removal, re-pointing an edge) starts a new","type":"text"},{"text":" ","type":"text"},{"text":"generation. Reserving capacity and writing attached map values do not. A structure derived from","type":"text"},{"text":" ","type":"text"},{"text":"a graph stores the graph’s ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" before it relies on the","type":"text"},{"text":" ","type":"text"},{"text":"graph again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A copy of a graph has the same generation as the original until either is mutated. Views and"},{"type":"text","text":" "},{"type":"text","text":"adaptors (a transposed view, an undirected view, a wrapper such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"report their base’s generation, so a view and its base, though they may describe different"},{"type":"text","text":" "},{"type":"text","text":"graphs, have equal generations. "},{"type":"codeVoice","code":"isCurrent(for:)"},{"type":"text","text":" answers only whether the storage of the graph"},{"type":"text","text":" "},{"type":"text","text":"passed in is in the state the generation was read from; it does not tell which view the"},{"type":"text","text":" "},{"type":"text","text":"generation was read through. An untracked generation, from a representation that does not track"},{"type":"text","text":" "},{"type":"text","text":"generations or a mutable graph never mutated, is current for no graph. Equal tracked"},{"type":"text","text":" "},{"type":"text","text":"generations are the same structural state of the same storage, and every untracked generation"},{"type":"text","text":" "},{"type":"text","text":"equals every other."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/graphgeneration"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/s15BitwiseCopyableP","doc:\/\/GraphProtocols\/SQ","doc:\/\/GraphProtocols\/s8SendableP","doc:\/\/GraphProtocols\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"modules":[{"name":"GraphProtocols"}],"remoteSource":{"fileName":"GraphGeneration.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/GraphGeneration.swift#L57"},"externalID":"s:14GraphProtocols0A10GenerationV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"title":"GraphGeneration","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GraphGeneration"}],"roleHeading":"Structure"},"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1rsfw","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1t817","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCur