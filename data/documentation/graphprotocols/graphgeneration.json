{"abstract":[{"type":"text","text":"A graph’s generation: which structural state of which graph storage it is."}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1rsfw","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-1t817","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-3zt2o","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-5kltt","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/isCurrent(for:)-scjl"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/untracked"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration\/Equatable-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"variants":[{"paths":["\/documentation\/graphprotocols\/graphgeneration"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphGeneration"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Every structural mutation (an insertion, a removal, re-pointing an edge) starts a new","type":"text"},{"text":" ","type":"text"},{"text":"generation. Reserving capacity and writing attached map values do not. A structure derived from","type":"text"},{"text":" ","type":"text"},{"text":"a graph stores the graph’s ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" before it relies on the","type":"text"},{"text":" ","type":"text"},{"text":"graph again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A copy of a graph has the same generation as the original until either is mutated. Views and","type":"text"},{"text":" ","type":"text"},{"text":"adaptors (a transposed view, an undirected view, a wrapper such as ","type":"text"},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"report their base’s generation, so a view and its base, though they may describe different","type":"text"},{"text":" ","type":"text"},{"text":"graphs, have equal generations. ","type":"text"},{"type":"codeVoice","code":"isCurrent(for:)"},{"text":" answers only whether the storage of the graph","type":"text"},{"text":" ","type":"text"},{"text":"passed in is in the state the generation was read from; it does not tell which view the","type":"text"},{"text":" ","type":"text"},{"text":"generation was read through. An untracked generation, from a representation that does not track","type":"text"},{"text":" ","type":"text"},{"text":"generations or a mutable graph never mutated, is current for no graph. Equal tracked","type":"text"},{"text":" ","type":"text"},{"text":"generations are the same structural state of the same storage, and every untracked generation","type":"text"},{"text":" ","type":"text"},{"text":"equals every other.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"},"sections":[],"metadata":{"modules":[{"name":"GraphProtocols"}],"remoteSource":{"fileName":"GraphGeneration.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blo