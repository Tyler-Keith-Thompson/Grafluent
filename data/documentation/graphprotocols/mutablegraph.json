pe":"text","text":"Every conformer satisfies these laws:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"_key(of: v)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"vertices.firstIndex(of: v)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"_vertex(atKey:)","type":"codeVoice"},{"text":" is its inverse.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key,"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"code":"vertices.endIndex","type":"codeVoice"},{"type":"text","text":" before the call. Keys of other vertices do not change."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey: u, toKey: v)"},{"type":"text","text":" inserts the edge, stored as "},{"type":"codeVoice","code":"UndirectedEdge(u, v)"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"that orientation, and returns its position. On a simple graph ("},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"an edge already present, in either orientation, is not inserted again, and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"type":"text","text":" removes "},{"type":"codeVoice","code":"v"},{"type":"text","text":" and every edge at it, returning the removed instance. "},{"type":"codeVoice","code":"remove(edge:)"},{"type":"text","text":" "},{"type":"text","text":"removes one copy of the edge, in either orientation, and never a vertex."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_built(vertices:uKeys:vKeys:reportingPosi