{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"},"abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":", with the members a reader needs to build a graph by key."}],"sections":[],"variants":[{"paths":["\/documentation\/graphprotocols\/mutablegraph"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","preciseIdentifier":"s:14GraphProtocols0A0P"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertices","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P8VerticesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Each vertex has a key: its index in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" ("},{"code":"Vertices.Index == Int","type":"codeVoice"},{"type":"text","text":"). On the dense"},{"type":"text","text":" "},{"type":"text","text":"representations ("},{"code":"UndirectedAdjacencyList","type":"codeVoice"},{"type":"text","text":", "},{"code":"Pseudograph","type":"codeVoice"},{"type":"text","text":") the key is the vertex’s slot."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every conformer satisfies these laws:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key,"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":" before the call. Keys of other vertices do not change."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey: u, toKey: v)"},{"type":"text","text":" inserts the edge, stored as "},{"type":"codeVoice","code":"UndirectedEdge(u, v)"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"that orientation, and returns its position. On a simple graph ("},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"an edge already present, in either orientation, is not inserted again, and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"remove(v)","type":"codeVoice"},{"text":" removes ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" and every edge at it, returning the removed instance. ","type":"text"},{"code":"remove(edge:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"removes one copy of the edge, in either orientation, and never a vertex.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_built(vertices:uKeys:vKeys:reportingPositions:_:)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"init()","type":"codeVoice"},{"type":"text","text":", then "},{"code":"_insertVertex(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for each vertex in order, then "},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"type":"text","text":" for each pair in order. It gives"},{"type":"text","text":" "},{"type":"text","text":"the same graph and the same position for each pair."}]}]}]},{"inlineContent":[{"text":"The underscored members are for library code that builds graphs generically, such as the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GraphFormats"},{"text":" readers. Callers use the representations’ own ","type":"text"},{"type":"codeVoice","code":"insert"},{"text":" members.","type":"text"}],"type":"paragraph"}]}],"metadata":{"symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}],"title":"MutableGraph","externalID":"s:14GraphProtocols07MutableA0P","remoteSource":{"fileName":"MutableGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableGraph.swift#L23"},"role":"symbol","roleHeading":"Protocol","modules":[{"name":"GraphProtocols"}]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\