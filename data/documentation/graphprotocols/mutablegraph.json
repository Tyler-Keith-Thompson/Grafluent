and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"remove(v)","type":"codeVoice"},{"text":" removes ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" and every edge at it, returning the removed instance. ","type":"text"},{"code":"remove(edge:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"removes one copy of the edge, in either orientation, and never a vertex.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_built(vertices:uKeys:vKeys:reportingPositions:_:)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"init()"},{"type":"text","text":", then "},{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" "},{"type":"text","text":"for each vertex in order, then "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" for each pair in order. It gives"},{"type":"text","text":" "},{"type":"text","text":"the same graph and the same position for each pair."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The underscored members are for library code that builds graphs generically, such as the","type":"text"},{"text":" ","type":"text"},{"code":"GraphFormats","type":"codeVoice"},{"text":" readers. Callers use the representations’ own ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":" members.","type":"text"}]}]}],"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"MutableGraph","kind":"identifier"}],"navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}],"externalID":"s:14GraphProtocols07MutableA0P","title":"MutableGraph","role":"symbol","modules":[{"name":"GraphProtocols"}],"symbolKind":"protocol","remoteSource":{"fileName":"MutableGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProto