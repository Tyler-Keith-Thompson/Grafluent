:{"role":"symbol","title":"DirectedView","kind":"symbol","url":"\/documentation\/graphprotocols\/directedview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the two arcs ","type":"text"},{"type":"codeVoice","code":"u→v"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v→u"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"successors"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"predecessors"},{"text":" are both ","type":"text"},{"type":"codeVoice","code":"neighbors"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":" is twice the","type":"text"},{"text":" ","type":"text"},{"text":"base’s.","type":"text"}],"navigatorTitle":[{"text":"DirectedView","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","url":"\/documentation\/graphprotocols","role":"collection","abstract":[],"type":"topic","kind":"symbol","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView/Arcs":{"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/directedview\/arcs","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView\/Arcs","title":"DirectedView.Arcs","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arcs"}],"navigatorTitle":[{"kind":"identifier","text":"Arcs"}],"abstract":[{"type":"text","text":"The arcs at a vertex, one per edge end, in the order of the base’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":": each"},{"type":"text","text":" "},{"type":"text","text":"arc leaving the vertex for "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":", or entering it for "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":". A self-loop’s first"},{"type":"text","text":" "},{"type":"text","text":"end is its forward arc and its second the reversed one, so each arc is listed once."}]}}}