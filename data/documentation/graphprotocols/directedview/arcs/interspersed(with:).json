/documentation\/GraphProtocols\/DirectedView","navigatorTitle":[{"kind":"identifier","text":"DirectedView"}],"title":"DirectedView","abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"code":"{u, v}","type":"codeVoice"},{"type":"text","text":" is the two arcs "},{"code":"u→v","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"v→u","type":"codeVoice"},{"type":"text","text":", so "},{"code":"successors","type":"codeVoice"},{"type":"text","text":" and "},{"code":"predecessors","type":"codeVoice"},{"type":"text","text":" are both "},{"code":"neighbors","type":"codeVoice"},{"type":"text","text":", and "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"type":"topic","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView/Arcs":{"title":"DirectedView.Arcs","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView\/Arcs","url":"\/documentation\/graphprotocols\/directedview\/arcs","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arcs","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Arcs","kind":"identifier"}],"abstract":[{"type":"text","text":"The arcs at a vertex, one per edge end, in the order of the base’s "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":": each"},{"type":"text","text":" "},{"type":"text","text":"arc leaving the vertex for "},{"code":"outEdges","type":"codeVoice"},{"type":"text","text":", or entering it for "},{"code":"inEdges","type":"codeVoice"},{"type":"text","text":". A self-loop’s first"},{"type":"text","text":" "},{"type":"text","text":"end is its forward arc and its second the reversed one, so each arc is listed once."}]}}}