{"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertices","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":" == ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Keys.","type":"text"}]},{"type":"text","text":" Each vertex has a key: its index in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Vertices.Index == Int"},{"type":"text","text":"). On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation ("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":", "},{"type":"codeVoice","code":"DirectedPseudograph"},{"type":"text","text":") the key is the vertex’s slot, which is"},{"type":"text","text":" "},{"type":"text","text":"also its "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":"; on "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" it is the vertex’s position, which never"},{"type":"text","text":" "},{"type":"text","text":"changes while the vertex exists and may leave holes. The underscored members read and write the"},{"type":"text","text":" "},{"type":"text","text":"graph by key, with no hashing, so a wrapper hashes a vertex once and then works on keys."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"type":"text","text":" In addition to "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":"’s:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For a vertex with key ","type":"text"},{"code":"k","type":"codeVoice"},{"text":": ","type":"text"},{"code":"_successors(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_predecessors(ofKey: k)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"_outEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_inEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_outDegree(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_inDegree(ofKey: k)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are the members of the same name without the label, for that vertex.","type":"text"},{"text":" ","type":"text"},{"code":"_successorKeys(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey: k)","type":"codeVoice"},{"text":" are the far ends’ keys, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order; ","type":"text"},{"code":"_sourceKey(ofEdgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_targetKey(ofEdgeAt:)","type":"codeVoice"},{"text":" are the endpoints’ keys.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" appends a vertex, which must not already be one, and returns its key:","type":"text"},{"text":" ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"text":" inserts the edge and returns its position. On a simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"AdjacencyList"},{"text":"), an edge already present is not inserted again and its position is","type":"text"},{"text":" ","type":"text"},{"text":"returned. Inserting an edge changes no key.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_removeVertex(atKey: k)","type":"codeVoice"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"the vertex’s key is now "},{"code":"k","type":"codeVoice"},{"type":"text","text":"; otherwise it returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and no other key changes."}]}]},{"content":[{"inlineContent":[{"code":"_removeEdge(at:)","type":"codeVoice"},{"text":" removes the edge at a live position and returns it, trapping on any other","type":"text"},{"text":" ","type":"text"},{"text":"position. Removing an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"type":"text","text":", returning the removed instance."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":", then","type":"text"},{"text":" ","type":"text"},{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" for each vertex in order, then ","type":"text"},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":" for each pair","type":"text"},{"text":" ","type":"text"},{"text":"in order: the same graph, and the same position for each pair.","type":"text"}]}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Key density."}]},{"text":" A wrapper may keep one table entry per 1024 keys, from the smallest live key","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"vertices.endIndex"},{"text":", plus O(1) per live vertex: the memory of the representation’s own page","type":"text"},{"text":" ","type":"text"},{"text":"table. On a dense representation the keys are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":". On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"span can exceed the vertex count: removals leave holes, and a decoded graph may start at any","type":"text"},{"text":" ","type":"text"},{"text":"position (its decoder bounds the span at ","type":"text"},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"text":" pages). Keys before the","type":"text"},{"text":" ","type":"text"},{"text":"smallest live key cost nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Key rows."}],"type":"strong"},{"text":" ","type":"text"},{"code":"_successorKeys(ofKey:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey:)","type":"codeVoice"},{"text":" return the stored rows","type":"text"},{"text":" ","type":"text"},{"text":"typed as ","type":"text"},{"code":"SuccessorIndices","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PredecessorIndices","type":"codeVoice"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes; ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Not requirements."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"insert(edge:)"},{"type":"text","text":" differs in its return type: "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"type":"text","text":"simple, returns "},{"type":"codeVoice","code":"(inserted:memberAfterInsert:)"},{"type":"text","text":", the multigraphs return the new position, and"},{"type":"text","text":" "},{"type":"text","text":"a wrapper that rejects edges returns an optional. So generic code inserts an edge by key, with"},{"type":"text","text":" "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The hooks are underscored because they are for wrappers inside the library: callers use the"},{"type":"text","text":" "},{"type":"text","text":"representations’ own "},{"type":"codeVoice","code":"insert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"remove"},{"type":"text","text":" members, which take vertices."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":", ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_vertex","type":"codeVoice"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"metadata":{"modules":[{"name":"GraphProtocols"}],"title":"MutableDirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"externalID":"s:14GraphProtocols015MutableDirectedA0P","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L53","fileName":"MutableDirectedGraph.swift"},"roleHeading":"Protocol","symbolKind":"protocol","role":"symbol"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/init()":{"fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/init()","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()","title":"init()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The empty graph."}],"required":true,"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/removeAllEdges(keepingCapacity:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/removealledges(keepingcapacity:)","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","abstract":[{"type":"text","text":"Removes every edge, keeping every vertex and its key."}],"required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"removeAllEdges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"keepingCapacity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"role":"symbol","kind":"symbol","title":"removeAllEdges(keepingCapacity:)"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertices-swift.associatedtype":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertices","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"url":"\/documentation\/graphprotocols\/directedgraph\/vertices-swift.associatedtype","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","title":"Vertices","type":"topic","kind":"symbol","abstract":[],"required":true,"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"kind":"symbol","title":"DirectedGraph","type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/insert(_:)":{"type":"topic","kind":"symbol","title":"insert(_:)","abstract":[{"type":"text","text":"In