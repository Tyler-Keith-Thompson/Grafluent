nt","type":"codeVoice"},{"text":" vertices and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" edges.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","title":"BidirectionalDirectedGraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}]},"doc://GraphProtocols/documentation/GraphProtocols":{"type":"topic","role":"collection","abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","url":"\/documentation\/graphprotocols","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/removeAll(keepingCapacity:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeAll"},{"kind":"text","text":"("},{"kind":"externalParam","text":"keepingCapacity"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")"}],"required":true,"role":"symbol","abstract":[{"type":"text","text":"Removes every vertex and edge."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","title":"removeAll(keepingCapacity:)","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/removeall(keepingcapacity:)","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/init()":{"abstract":[{"text":"The empty graph.","type":"text"}],"type":"topic","required":true,"kind":"symbol","role":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/init()","title":"init()","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}]}}}