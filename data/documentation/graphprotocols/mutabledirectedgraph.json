"},{"text":" ","kind":"text"},{"text":"remove","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/reserveCapacity(vertexCount:edgeCount:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/reservecapacity(vertexcount:edgecount:)","type":"topic","required":true,"abstract":[{"type":"text","text":"Reserves space for at least "},{"code":"vertexCount","type":"codeVoice"},{"type":"text","text":" vertices and "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" edges."}],"title":"reserveCapacity(vertexCount:edgeCount:)","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"edgeCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/insert(_:)":{"abstract":[{"text":"Inserts ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" with no edges, if it is not already a vertex.","type":