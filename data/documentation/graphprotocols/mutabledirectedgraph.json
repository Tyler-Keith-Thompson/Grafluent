{"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex"},{"kind":"text","text":"> : "},{"preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","text":"BidirectionalDirectedGraph"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","text":"Vertices"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":" == "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wrapper that adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":", can own any mutable directed"},{"type":"text","text":" "},{"type":"text","text":"representation as its base through this protocol and work on it without extra hashing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each vertex has a key: its index in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Vertices.Index == Int"},{"type":"text","text":"). On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation ("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":", "},{"type":"codeVoice","code":"DirectedPseudograph"},{"type":"text","text":") the key is the vertex’s slot, which is"},{"type":"text","text":" "},{"type":"text","text":"also its "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" it is the vertex’s position, which never"},{"type":"text","text":" "},{"type":"text","text":"changes while the vertex exists and may leave holes. The underscored members read and write the"},{"type":"text","text":" "},{"type":"text","text":"graph by key, so a wrapper hashes a vertex once and then works on keys."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s laws:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a vertex with key "},{"type":"codeVoice","code":"k"},{"type":"text","text":", "},{"type":"codeVoice","code":"_successors(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_predecessors(ofKey: k)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_outEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_inEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_outDegree(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_inDegree(ofKey: k)"},{"type":"text","text":" "},{"type":"text","text":"equal the unprefixed members for that vertex."},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey: k)"},{"type":"text","text":" are the far ends’ keys, in the"},{"type":"text","text":" "},{"type":"text","text":"same order. "},{"type":"codeVoice","code":"_sourceKey(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_targetKey(ofEdgeAt:)"},{"type":"text","text":" are the endpoints’ keys."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key,"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":" before the call. Keys of other vertices do not change."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"text":" inserts the edge and returns its position. On a simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"AdjacencyList"},{"text":"), an edge already present is not inserted again and its position is","type":"text"},{"text":" ","type":"text"},{"text":"returned. Inserting an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"that vertex’s key becomes "},{"type":"codeVoice","code":"k"},{"type":"text","text":". Otherwise it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and no other key changes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"type":"text","text":" removes the edge at a live position and returns it, and traps on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"type":"text","text":", returning the removed instance."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"init()"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" for each vertex in order, then "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" for each pair"},{"type":"text","text":" "},{"type":"text","text":"in order. It gives the same graph and the same position for each pair."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A wrapper may keep one table entry per 1024 keys, from the smallest live key to","type":"text"},{"text":" ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":", plus O(1) per live vertex. That matches the representation’s own page","type":"text"},{"text":" ","type":"text"},{"text":"table. On a dense representation the keys are ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":". On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"span can exceed the vertex count, because removals leave holes and a decoded graph may start at","type":"text"},{"text":" ","type":"text"},{"text":"any position. Its decoder bounds the span at ","type":"text"},{"code":"16 × vertexCount + 64","type":"codeVoice"},{"text":" pages. Keys before the","type":"text"},{"text":" ","type":"text"},{"text":"smallest live key cost nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"_successorKeys(ofKey:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey:)","type":"codeVoice"},{"text":" return the stored rows typed as","type":"text"},{"text":" ","type":"text"},{"code":"SuccessorIndices","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PredecessorIndices","type":"codeVoice"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes. ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"insert(edge:)","type":"codeVoice"},{"type":"text","text":" is not a requirement because its return type varies by representation."},{"type":"text","text":" "},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"(inserted:memberAfterInsert:)","type":"codeVoice"},{"type":"text","text":", the multigraphs return the new"},{"type":"text","text":" "},{"type":"text","text":"position, and a wrapper that rejects edges returns an optional. Generic code inserts an edge by"},{"type":"text","text":" "},{"type":"text","text":"key with "},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The underscored members are for wrappers inside the library. Callers use the representations’"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"insert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"remove"},{"type":"text","text":" members, which take vertices."}]}]}],"metadata":{"symbolKind":"protocol","roleHeading":"Protocol","modules":[{"name":"GraphProtocols"}],"role":"symbol","externalID":"s:14GraphProtocols015MutableDirectedA0P","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"remoteSource":{"fileName":"MutableDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L54"},"title":"MutableDirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"generated":true}],"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/remove(_:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(_:)","type":"topic","required":true,"role":"symbol","abstract":[{"type":"text","text":"Removes "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" and every edge at it."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":"?"}],"title":"remove(_:)"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/removeAllEdges(keepingCapacity:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/removealledges(keepingcapacity:)","title":"removeAllEdges(keepingCapacity:)","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeAllEdges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"keepingCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Removes every edge, keeping every vertex and its key."}]},"doc://GraphProtocols/documentation/GraphProtocols":{"abstract":[],"url":"\/documentation\/graphprotocols","type":"topic","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"title":"Vertex","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","type":"topic","kind":"symbol","required":true,"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/reserveCapacity(vertexCount:edgeCount:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/reservecapacity(vertexcount:edgecount:)","type":"topic","required":true,"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)","abstract":[{"type":"text","text":"Reserves space for at least "},{"type":"codeVoice","code":"vertexCount"},{"type":"text","text":" vertices and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" edges."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"edgeCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"reserveCapacity(vertexCount:edgeCount:)"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"title":"DirectedGraph","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/graphprotocols\/directedgraph"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/remove(edge:)":{"title":"remove(edge:)","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(edge:)","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","type":"topic","kind":"symbol","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DirectedEdge","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"DirectedEdge","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">?"}],"abstract":[{"text":"Removes one copy of ","type":"text"},{"code":"edge","type":"codeVoice"},{"text":". On a representation with parallel edges it removes the newest","type":"text"},{"text":" ","type":"text"},{"text":"copy. Never inserts or removes a vertex.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/init()":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/init()","title":"init()","role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()","kind":"symbol","required":true,"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"abstract":[{"text":"The empty graph.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"title":"MutableDirectedGraph","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"url":"\/documentation\/graphprotocols\/mutabledirectedgraph"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/removeAll(keepingCapacity:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/removeall(keepingcapacity:)","type":"topic","required":true,"role":"symbol","abstract":[{"text":"Removes every vertex and edge.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeAll"},{"kind":"text","text":"("},{"kind":"externalParam","text":"keepingCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"title":"removeAll(keepingCapacity:)"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/insert(_:)":{"title":"insert(_:)","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/insert(_:)","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> (inserted"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", memberAfterInsert"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Inserts "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":" with no edges, if it is not already a vertex."}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertices-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","kind":"symbol","required":true,"abstract":[],"title":"Vertices","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertices"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"url":"\/documentation\/graphprotocols\/directedgraph\/vertices-swift.associatedtype"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"abstract":[{"text":"A directed graph that also answers in-neighborhoods. In-adjacency usually costs extra","type":"text"},{"text":" ","type":"text"},{"text":"storage, so representations that store only out-adjacency conform to ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" alone.","type":"text"}],"type":"topic","title":"BidirectionalDirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph"}}}