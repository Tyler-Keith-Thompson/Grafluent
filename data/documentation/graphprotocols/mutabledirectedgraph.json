{"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"roleHeading":"Protocol","externalID":"s:14GraphProtocols015MutableDirectedA0P","modules":[{"name":"GraphProtocols"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}],"title":"MutableDirectedGraph","symbolKind":"protocol"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertices","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wrapper that adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":", can own any mutable directed"},{"type":"text","text":" "},{"type":"text","text":"representation as its base through this protocol and work on it without extra hashing."}]},{"type":"paragraph","inlineContent":[{"text":"Each vertex has a key: its index in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Vertices.Index == Int","type":"codeVoice"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedPseudograph","type":"codeVoice"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":". On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, so a wrapper hashes a vertex once and then works on keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In addition to ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":"’s laws:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a vertex with key "},{"type":"codeVoice","code":"k"},{"type":"text","text":", "},{"type":"codeVoice","code":"_successors(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_predecessors(ofKey: k)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_outEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_inEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_outDegree(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_inDegree(ofKey: k)"},{"type":"text","text":" "},{"type":"text","text":"equal the unprefixed members for that vertex."},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey: k)"},{"type":"text","text":" are the far ends’ keys, in the"},{"type":"text","text":" "},{"type":"text","text":"same order. "},{"type":"codeVoice","code":"_sourceKey(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_targetKey(ofEdgeAt:)"},{"type":"text","text":" are the endpoints’ keys."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key,"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":" before the call. Keys of other vertices do not change."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"that vertex’s key becomes "},{"type":"codeVoice","code":"k"},{"type":"text","text":". Otherwise it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and no other key changes."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_removeEdge(at:)","type":"codeVoice"},{"type":"text","text":" removes the edge at a live position and returns it, and traps on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"type":"text","text":", returning the removed instance."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"init()"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" for each vertex in order, then "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" for each pair"},{"type":"text","text":" "},{"type":"text","text":"in order. It gives the same graph and the same position for each pair."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wrapper may keep one table entry per 1024 keys, from the smallest live key to"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":", plus O(1) per live vertex. That matches the representation’s own page"},{"type":"text","text":" "},{"type":"text","text":"table. On a dense representation the keys are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"span can exceed the vertex count, because removals leave holes and a decoded graph may start at"},{"type":"text","text":" "},{"type":"text","text":"any position. Its decoder bounds the span at "},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"type":"text","text":" pages. Keys before the"},{"type":"text","text":" "},{"type":"text","text":"smallest live key cost nothing."}]},{"type":"paragraph","inlineContent":[{"code":"_successorKeys(ofKey:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey:)","type":"codeVoice"},{"text":" return the stored rows typed as","type":"text"},{"text":" ","type":"text"},{"code":"SuccessorIndices","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PredecessorIndices","type":"codeVoice"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes. ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"insert(edge:)"},{"type":"text","text":" is not a requirement because its return type varies by representation."},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"(inserted:memberAfterInsert:)"},{"type":"text","text":", the multigraphs return the new"},{"type":"text","text":" "},{"type":"text","text":"position, and a wrapper that rejects edges returns an optional. Generic code inserts an edge by"},{"type":"text","text":" "},{"type":"text","text":"key with "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The underscored members are for wrappers inside the library. Callers use the representations’"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"insert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"remove"},{"type":"text","text":" members, which take vertices."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/insert(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> (inserted","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", memberAfterInsert","kind":"text"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","type":"topic","abstract":[{"type":"text","text":"Inserts "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":" with no edges, if it is not already a vertex."}],"role":"symbol","required":true,"title":"insert(_:)","kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/insert(_:)"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/remove(_:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(_:)","abstract":[{"type":"text","text":"Removes "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" and every edge at it."}],"type":"topic","required":true,"title":"remove(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":"?"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/removeAllEdges(keepingCapacity:)":{"kind":"symbol","required":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeAllEdges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"keepingCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/removealledges(keepingcapacity:)","title":"removeAllEdges(keepingCapacity:)","abstract":[{"type":"text","text":"Removes every edge, keeping every vertex and its key."}],"role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/init()":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()","type":"topic","abstract":[{"type":"text","text":"The empty graph."}],"role":"symbol","required":true,"title":"init()","kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/init()"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"text":"A directed graph that also answers in-neighborhoods. In-adjacency usually costs extra","type":"text"},{"text":" ","typ