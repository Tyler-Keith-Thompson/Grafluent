{"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"code":"MutableGraph","type":"codeVoice"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"add_vertex","type":"codeVoice"},{"type":"text","text":", "},{"code":"add_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_vertex","type":"codeVoice"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"kind":"symbol","metadata":{"remoteSource":{"fileName":"MutableDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L53"},"navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"roleHeading":"Protocol","role":"symbol","title":"MutableDirectedGraph","externalID":"s:14GraphProtocols015MutableDirectedA0P","symbolKind":"protocol","modules":[{"name":"GraphProtocols"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom","title":"Inherits From"}],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"> : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","text":"BidirectionalDirectedGraph","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","text":"Vertices","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"inlineContent":[{"text":"Keys.","type":"text"}],"type":"strong"},{"text":" Each vertex has a key: its index in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Vertices.Index == Int","type":"codeVoice"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedPseudograph","type":"codeVoice"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":"; on ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, with no hashing, so a wrapper hashes a vertex once and then works on keys.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"_key(of: v)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"vertices.firstIndex(of: v)","type":"codeVoice"},{"type":"text","text":", and "},{"code":"_vertex(atKey:)","type":"codeVoice"},{"type":"text","text":" is its inverse."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For a vertex with key ","type":"text"},{"type":"codeVoice","code":"k"},{"text":": ","type":"text"},{"type":"codeVoice","code":"_successors(ofKey: k)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_predecessors(ofKey: k)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_outEdges(ofKey: k)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_inEdges(ofKey: k)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_outDegree(ofKey: k)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_inDegree(ofKey: k)"},{"text":" ","type":"text"},{"text":"are the members of the same name without the label, for that vertex.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_successorKeys(ofKey: k)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_predecessorKeys(ofKey: k)"},{"text":" are the far ends’ keys, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order; ","type":"text"},{"type":"codeVoice","code":"_sourceKey(ofEdgeAt:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_targetKey(ofEdgeAt:)"},{"text":" are the endpoints’ keys.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" appends a vertex, which must not already be one, and returns its key:","type":"text"},{"text":" ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_removeVertex(atKey: k)","type":"codeVoice"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"the vertex’s key is now "},{"code":"k","type":"codeVoice"},{"type":"text","text":"; otherwise it returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and no other key changes."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"text":" removes the edge at a live position and returns it, trapping on any other","type":"text"},{"text":" ","type":"text"},{"text":"position. Removing an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"type":"text","text":", returning the removed instance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":", then","type":"text"},{"text":" ","type":"text"},{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" for each vertex in order, then ","type":"text"},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":" for each pair","type":"text"},{"text":" ","type":"text"},{"text":"in order: the same graph, and the same position for each pair.","type":"text"}]}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Key density."}],"type":"strong"},{"text":" A wrapper may keep one table entry per 1024 keys, from the smallest live key","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":", plus O(1) per live vertex: the memory of the representation’s own page","type":"text"},{"text":" ","type":"text"},{"text":"table. On a dense representation the keys are ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":". On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"span can exceed the vertex count: removals leave holes, and a decoded graph may start at any","type":"text"},{"text":" ","type":"text"},{"text":"position (its decoder bounds the span at ","type":"text"},{"code":"16 × vertexCount + 64","type":"codeVoice"},{"text":" pages). Keys before the","type":"text"},{"text":" ","type":"text"},{"text":"smallest live key cost nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Key rows.","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"type":"text","text":" return the stored rows"},{"type":"text","text":" "},{"type":"text","text":"typed as "},{"type":"codeVoice","code":"SuccessorIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PredecessorIndices"},{"type":"text","text":", whose elements here are keys. On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation keys and indices coincide. On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the elements are positions,"},{"type":"text","text":" "},{"type":"text","text":"which are vertex indices only while the graph has no holes; "},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"then unavailable, but the key rows are not."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Not requirements.","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"insert(edge:)"},{"text":" differs in its return type: ","type":"text"},{"type":"codeVoice","code":"AdjacencyList"},{"text":", which is","type":"text"},{"text":" ","type":"text"},{"text":"simple, returns ","type":"text"},{"type":"codeVoice","code":"(inserted:memberAfterInsert:)"},{"text":", the multigraphs return the new position, and","type":"text"},{"text":" ","type":"text"},{"text":"a wrapper that rejects edges returns an optional. So generic code inserts an edge by key, with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The hooks are underscored because they are for wrappers inside the library: callers use the","type":"text"},{"text":" ","type":"text"},{"text":"representations’ own ","type":"text"},{"type":"codeVoice","code":"insert"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"remove"},{"text":" members, which take vertices.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/init()":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"title":"init()","required":true,"abstract":[{"type":"text","text":"The empty graph."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()","type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/init()","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/reserveCapacity(vertexCount:edgeCount:)":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)","role":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/reservecapacity(vertexcount:edgecount:)","kind":"symbol","abstract":[{"type":"text","text":"Reserves space for at least "},{"code":"vertexCount","type":"codeVoice"},{"type":"text","text":" vertices and "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" edges."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"edgeCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"title":"reserveCapacity(vertexCount:edgeCount:)","type":"topic","required":true},"doc://GraphProtocols/documentation/GraphProtocols":{"title":"GraphProtocols","url":"\/documentation\/graphprotocols","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertices-swift.associatedtype":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertices"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"title":"Vertices","required":true,"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","url":"\/documentation\/graphprotocols\/directedgraph\/vertices-swift.associatedtype","abstract":[],"kind":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"title":"MutableDirectedGraph","abstract":[{"type":