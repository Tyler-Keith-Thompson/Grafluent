{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"protocol","roleHeading":"Protocol","modules":[{"name":"GraphProtocols"}],"navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"externalID":"s:14GraphProtocols015MutableDirectedA0P","title":"MutableDirectedGraph","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L53","fileName":"MutableDirectedGraph.swift"}},"abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":", ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_vertex","type":"codeVoice"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":"> : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","text":"BidirectionalDirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","text":"Vertices","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Keys."}]},{"type":"text","text":" Each vertex has a key: its index in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" ("},{"code":"Vertices.Index == Int","type":"codeVoice"},{"type":"text","text":"). On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation ("},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":", "},{"code":"DirectedPseudograph","type":"codeVoice"},{"type":"text","text":") the key is the vertex’s slot, which is"},{"type":"text","text":" "},{"type":"text","text":"also its "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":"; on "},{"code":"StableDirectedGraph","type":"codeVoice"},{"type":"text","text":" it is the vertex’s position, which never"},{"type":"text","text":" "},{"type":"text","text":"changes while the vertex exists and may leave holes. The underscored members read and write the"},{"type":"text","text":" "},{"type":"text","text":"graph by key, with no hashing, so a wrapper hashes a vertex once and then works on keys."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"_vertex(atKey:)"},{"text":" is its inverse.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a vertex with key "},{"type":"codeVoice","code":"k"},{"type":"text","text":": "},{"type":"codeVoice","code":"_successors(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_predecessors(ofKey: k)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_outEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_inEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_outDegree(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_inDegree(ofKey: k)"},{"type":"text","text":" "},{"type":"text","text":"are the members of the same name without the label, for that vertex."},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey: k)"},{"type":"text","text":" are the far ends’ keys, in the"},{"type":"text","text":" "},{"type":"text","text":"same order; "},{"type":"codeVoice","code":"_sourceKey(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_targetKey(ofEdgeAt:)"},{"type":"text","text":" are the endpoints’ keys."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"text":" appends a vertex, which must not already be one, and returns its key:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices.endIndex"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"text":" inserts the edge and returns its position. On a simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"AdjacencyList"},{"text":"), an edge already present is not inserted again and its position is","type":"text"},{"text":" ","type":"text"},{"text":"returned. Inserting an edge changes no key.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_removeVertex(atKey: k)","type":"codeVoice"},{"text":" removes the vertex and every edge at it. If the representation fills","type":"text"},{"text":" ","type":"text"},{"text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and","type":"text"},{"text":" ","type":"text"},{"text":"the vertex’s key is now ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"; otherwise it returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and no other key changes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_removeEdge(at:)","type":"codeVoice"},{"type":"text","text":" removes the edge at a live position and returns it, trapping on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"remove(v)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"_removeVertex(atKey: _key(of: v)!)","type":"codeVoice"},{"text":", returning the removed instance.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":", then","type":"text"},{"text":" ","type":"text"},{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" for each vertex in order, then ","type":"text"},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":" for each pair","type":"text"},{"text":" ","type":"text"},{"text":"in order: the same graph, and the same position for each pair.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Key density.","type":"text"}],"type":"strong"},{"type":"text","text":" A wrapper may keep one table entry per 1024 keys, from the smallest live key"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":", plus O(1) per live vertex: the memory of the representation’s own page"},{"type":"text","text":" "},{"type":"text","text":"table. On a dense representation the keys are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"span can exceed the vertex count: removals leave holes, and a decoded graph may start at any"},{"type":"text","text":" "},{"type":"text","text":"position (its decoder bounds the span at "},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"type":"text","text":" pages). Keys before the"},{"type":"text","text":" "},{"type":"text","text":"smallest live key cost nothing."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Key rows."}]},{"text":" ","type":"text"},{"code":"_successorKeys(ofKey:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey:)","type":"codeVoice"},{"text":" return the stored rows","type":"text"},{"text":" ","type":"text"},{"text":"typed as ","type":"text"},{"code":"SuccessorIndices","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PredecessorIndices","type":"codeVoice"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes; ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Not requirements."}],"type":"strong"},{"text":" ","type":"text"},{"code":"insert(edge:)","type":"codeVoice"},{"text":" differs in its return type: ","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", which is","type":"text"},{"text":" ","type":"text"},{"text":"simple, returns ","type":"text"},{"code":"(inserted:memberAfterInsert:)","type":"codeVoice"},{"text":", the multigraphs return the new position, and","type":"text"},{"text":" ","type":"text"},{"text":"a wrapper that rejects edges returns an optional. So generic code inserts an edge by key, with","type":"text"},{"text":" ","type":"text"},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The hooks are underscored because they are for wrappers inside the library: callers use the","type":"text"},{"text":" ","type":"text"},{"text":"representations’ own ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"remove","type":"codeVoice"},{"text":" members, which take vertices.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom","kind":"relationships","title":"Inherits From"}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","interfaceLanguage":"swift"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/removeAllEdges(keepingCapacity:)":{"required":true,"abstract":[{"type":"text","text":"Removes every edge, keeping every vertex and its key."}],"title":"removeAllEdges(keepingCapacity:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeAllEdges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"keepingCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/removealledges(keepingcapacity:)","identifier":"doc:\/\/GraphProtocols\/d