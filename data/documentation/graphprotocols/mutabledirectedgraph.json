{"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","text":"BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","text":"Vertices","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wrapper that adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":", can own any mutable directed"},{"type":"text","text":" "},{"type":"text","text":"representation as its base through this protocol and work on it without extra hashing."}]},{"type":"paragraph","inlineContent":[{"text":"Each vertex has a key: its index in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" (","type":"text"},{"type":"codeVoice","code":"Vertices.Index == Int"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"type":"codeVoice","code":"AdjacencyList"},{"text":", ","type":"text"},{"type":"codeVoice","code":"DirectedPseudograph"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":". On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, so a wrapper hashes a vertex once and then works on keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s laws:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For a vertex with key ","type":"text"},{"code":"k","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_successors(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_predecessors(ofKey: k)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"_outEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_inEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_outDegree(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_inDegree(ofKey: k)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"equal the unprefixed members for that vertex.","type":"text"},{"text":" ","type":"text"},{"code":"_successorKeys(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey: k)","type":"codeVoice"},{"text":" are the far ends’ keys, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order. ","type":"text"},{"code":"_sourceKey(ofEdgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_targetKey(ofEdgeAt:)","type":"codeVoice"},{"text":" are the endpoints’ keys.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key,"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":" before the call. Keys of other vertices do not change."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"that vertex’s key becomes "},{"type":"codeVoice","code":"k"},{"type":"text","text":". Otherwise it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and no other key changes."}]}]},{"content":[{"inlineContent":[{"code":"_removeEdge(at:)","type":"codeVoice"},{"text":" removes the edge at a live position and returns it, and traps on any other","type":"text"},{"text":" ","type":"text"},{"text":"position. Removing an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"text":", returning the removed instance.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"init()"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" for each vertex in order, then "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" for each pair"},{"type":"text","text":" "},{"type":"text","text":"in order. It gives the same graph and the same position for each pair."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wrapper may keep one table entry per 1024 keys, from the smallest live key to"},{"type":"text","text":" "},{"code":"vertices.endIndex","type":"codeVoice"},{"type":"text","text":", plus O(1) per live vertex. That matches the representation’s own page"},{"type":"text","text":" "},{"type":"text","text":"table. On a dense representation the keys are "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":". On "},{"code":"StableDirectedGraph","type":"codeVoice"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"span can exceed the vertex count, because removals leave holes and a decoded graph may start at"},{"type":"text","text":" "},{"type":"text","text":"any position. Its decoder bounds the span at "},{"code":"16 × vertexCount + 64","type":"codeVoice"},{"type":"text","text":" pages. Keys before the"},{"type":"text","text":" "},{"type":"text","text":"smallest live key cost nothing."}]},{"type":"paragraph","inlineContent":[{"code":"_successorKeys(ofKey:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey:)","type":"codeVoice"},{"text":" return the stored rows typed as","type":"text"},{"text":" ","type":"text"},{"code":"SuccessorIndices","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PredecessorIndices","type":"codeVoice"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes. ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"insert(edge:)","type":"codeVoice"},{"text":" is not a requirement because its return type varies by representation.","type":"text"},{"text":" ","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"(inserted:memberAfterInsert:)","type":"codeVoice"},{"text":", the multigraphs return the new","type":"text"},{"text":" ","type":"text"},{"text":"position, and a wrapper that rejects edges returns an optional. Generic code inserts an edge by","type":"text"},{"text":" ","type":"text"},{"text":"key with ","type":"text"},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The underscored members are for wrappers inside the library. Callers use the representations’","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"type":"codeVoice","code":"insert"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"remove"},{"text":" members, which take vertices.","type":"text"}]}],"kind":"content"}],"sections":[],"kind":"symbol","metadata":{"symbolKind":"protocol","externalID":"s:14GraphProtocols015MutableDirectedA0P","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L54","fileName":"MutableDirectedGraph.swift"},"title":"MutableDirectedGraph","modules":[{"name":"GraphProtocols"}],"role":"symbol","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}]},"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom"}],"variants":[{"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphPr