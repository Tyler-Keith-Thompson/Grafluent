nd":"identifier"}],"title":"BidirectionalDirectedGraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/insert(_:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/insert(_:)","kind":"symbol","required":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","abstract":[{"text":"Inserts ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" with no edges, if it is not already a vertex.","type":"text"}],"title":"insert(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text