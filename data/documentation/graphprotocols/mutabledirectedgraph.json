{"abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":", ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_vertex","type":"codeVoice"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"metadata":{"modules":[{"name":"GraphProtocols"}],"navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"roleHeading":"Protocol","role":"symbol","title":"MutableDirectedGraph","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"remoteSource":{"fileName":"MutableDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L50"},"externalID":"s:14GraphProtocols015MutableDirectedA0P"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier"},{"text":"> : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","text":"BidirectionalDirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","text":"Vertices","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Keys."}],"type":"strong"},{"text":" Each vertex has a key: its index in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Vertices.Index == Int","type":"codeVoice"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedPseudograph","type":"codeVoice"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":"; on ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, with no hashing, so a wrapper hashes a vertex once and then works on keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"_key(of: v)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"vertices.firstIndex(of: v)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"_vertex(atKey:)","type":"codeVoice"},{"text":" is its inverse.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a vertex with key "},{"code":"k","type":"codeVoice"},{"type":"text","text":": "},{"code":"_successors(ofKey: k)","type":"codeVoice"},{"type":"text","text":", "},{"code":"_predecessors(ofKey: k)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"_outEdges(ofKey: k)","type":"codeVoice"},{"type":"text","text":", "},{"code":"_inEdges(ofKey: k)","type":"codeVoice"},{"type":"text","text":", "},{"code":"_outDegree(ofKey: k)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"_inDegree(ofKey: k)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are the members of the same name without the label, for that vertex."},{"type":"text","text":" "},{"code":"_successorKeys(ofKey: k)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"_predecessorKeys(ofKey: k)","type":"codeVoice"},{"type":"text","text":" are the far ends’ keys, in the"},{"type":"text","text":" "},{"type":"text","text":"same order; "},{"code":"_sourceKey(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"_targetKey(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" are the endpoints’ keys."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key:"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":" before the call. Keys of other vertices do not change."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":" inserts the edge and returns its position. On a simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":"), an edge already present is not inserted again and its position is","type":"text"},{"text":" ","type":"text"},{"text":"returned. Inserting an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"the vertex’s key is now "},{"type":"codeVoice","code":"k"},{"type":"text","text":"; otherwise it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and no other key changes."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"text":" removes the edge at a live position and returns it, trapping on any other","type":"text"},{"text":" ","type":"text"},{"text":"position. Removing an edge changes no key.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"type":"text","text":", returning the removed instance."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Key density."}],"type":"strong"},{"type":"text","text":" A wrapper may keep one table entry per 1024 keys, from the smallest live key"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":", plus O(1) per live vertex: the memory of the representation’s own page"},{"type":"text","text":" "},{"type":"text","text":"table. On a dense representation the keys are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"span can exceed the vertex count: removals leave holes, and a decoded graph may start at any"},{"type":"text","text":" "},{"type":"text","text":"position (its decoder bounds the span at "},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"type":"text","text":" pages). Keys before the"},{"type":"text","text":" "},{"type":"text","text":"smallest live key cost nothing."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Key rows."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"type":"text","text":" return the stored rows"},{"type":"text","text":" "},{"type":"text","text":"typed as "},{"type":"codeVoice","code":"SuccessorIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PredecessorIndices"},{"type":"text","text":", whose elements here are keys. On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation keys and indices coincide. On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the elements are positions,"},{"type":"text","text":" "},{"type":"text","text":"which are vertex indices only while the graph has no holes; "},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"then unavailable, but the key rows are not."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Not requirements."}],"type":"strong"},{"type":"text","text":" "},{"code":"insert(edge:)","type":"codeVoice"},{"type":"text","text":" differs in its return type: "},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"type":"text","text":"simple, returns "},{"code":"(inserted:memberAfterInsert:)","type":"codeVoice"},{"type":"text","text":", the multigraphs return the new position, and"},{"type":"text","text":" "},{"type":"text","text":"a wrapper that rejects edges returns an optional. So generic code inserts an edge by key, with"},{"type":"text","text":" "},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The hooks are underscored because they are for wrappers inside the library: callers use the","type":"text"},{"text":" ","type":"text"},{"text":"representations’ own ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"remove","type":"codeVoice"},{"text":" members, which take vertices.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/remove(_:)":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","title":"remove(_:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Removes "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" and every edge at it."}],"type":"topic","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remove","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"text":"?","kind":"text"}],"required":true},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","title":"GraphProtocols","role":"collection","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"