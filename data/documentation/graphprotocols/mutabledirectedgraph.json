{"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"kind":"symbol","topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertices","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":" == ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A wrapper that adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":", can own any mutable directed","type":"text"},{"text":" ","type":"text"},{"text":"representation as its base through this protocol and work on it without extra hashing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each vertex has a key: its index in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Vertices.Index == Int"},{"type":"text","text":"). On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation ("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":", "},{"type":"codeVoice","code":"DirectedPseudograph"},{"type":"text","text":") the key is the vertex’s slot, which is"},{"type":"text","text":" "},{"type":"text","text":"also its "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" it is the vertex’s position, which never"},{"type":"text","text":" "},{"type":"text","text":"changes while the vertex exists and may leave holes. The underscored members read and write the"},{"type":"text","text":" "},{"type":"text","text":"graph by key, so a wrapper hashes a vertex once and then works on keys."}]},{"type":"paragraph","inlineContent":[{"text":"In addition to ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":"’s laws:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For a vertex with key "},{"type":"codeVoice","code":"k"},{"type":"text","text":", "},{"type":"codeVoice","code":"_successors(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_predecessors(ofKey: k)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_outEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_inEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_outDegree(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_inDegree(ofKey: k)"},{"type":"text","text":" "},{"type":"text","text":"equal the unprefixed members for that vertex."},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey: k)"},{"type":"text","text":" are the far ends’ keys, in the"},{"type":"text","text":" "},{"type":"text","text":"same order. "},{"type":"codeVoice","code":"_sourceKey(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_targetKey(ofEdgeAt:)"},{"type":"text","text":" are the endpoints’ keys."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" appends a vertex, which must not already be one, and returns its key,","type":"text"},{"text":" ","type":"text"},{"text":"which is ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":" inserts the edge and returns its position. On a simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":"), an edge already present is not inserted again and its position is","type":"text"},{"text":" ","type":"text"},{"text":"returned. Inserting an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"text":" removes the vertex and every edge at it. If the representation fills","type":"text"},{"text":" ","type":"text"},{"text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and","type":"text"},{"text":" ","type":"text"},{"text":"that vertex’s key becomes ","type":"text"},{"type":"codeVoice","code":"k"},{"text":". Otherwise it returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and no other key changes.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"text":" removes the edge at a live position and returns it, and traps on any other","type":"text"},{"text":" ","type":"text"},{"text":"position. Removing an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"remove(v)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"_removeVertex(atKey: _key(of: v)!)","type":"codeVoice"},{"type":"text","text":", returning the removed instance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"init()"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" for each vertex in order, then "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" for each pair"},{"type":"text","text":" "},{"type":"text","text":"in order. It gives the same graph and the same position for each pair."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A wrapper may keep one table entry per 1024 keys, from the smallest live key to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices.endIndex"},{"text":", plus O(1) per live vertex. That matches the representation’s own page","type":"text"},{"text":" ","type":"text"},{"text":"table. On a dense representation the keys are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":". On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"span can exceed the vertex count, because removals leave holes and a decoded graph may start at","type":"text"},{"text":" ","type":"text"},{"text":"any position. Its decoder bounds the span at ","type":"text"},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"text":" pages. Keys before the","type":"text"},{"text":" ","type":"text"},{"text":"smallest live key cost nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"type":"text","text":" return the stored rows typed as"},{"type":"text","text":" "},{"type":"codeVoice","code":"SuccessorIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PredecessorIndices"},{"type":"text","text":", whose elements here are keys. On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation keys and indices coincide. On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the elements are positions,"},{"type":"text","text":" "},{"type":"text","text":"which are vertex indices only while the graph has no holes. "},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"then unavailable, but the key rows are not."}]},{"type":"paragraph","inlineContent":[{"code":"insert(edge:)","type":"codeVoice"},{"type":"text","text":" is not a requirement because its return type varies by representation."},{"type":"text","text":" "},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"(inserted:memberAfterInsert:)","type":"codeVoice"},{"type":"text","text":", the multigraphs return the new"},{"type":"text","text":" "},{"type":"text","text":"position, and a wrapper that rejects edges returns an optional. Generic code inserts an edge by"},{"type":"text","text":" "},{"type":"text","text":"key with "},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The underscored members are for wrappers inside the library. Callers use the representations’"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"insert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"remove"},{"type":"text","text":" members, which take vertices."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"]}],"metadata":{"modules":[{"name":"GraphProtocols"}],"title":"MutableDirectedGraph","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"tex