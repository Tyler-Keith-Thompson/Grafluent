{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","interfaceLanguage":"swift"},"sections":[],"metadata":{"symbolKind":"protocol","modules":[{"name":"GraphProtocols"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}],"roleHeading":"Protocol","externalID":"s:14GraphProtocols015MutableDirectedA0P","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L50","fileName":"MutableDirectedGraph.swift"},"title":"MutableDirectedGraph","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"kind":"symbol","abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"type":"codeVoice","code":"MutableGraph"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"add_vertex"},{"text":", ","type":"text"},{"type":"codeVoice","code":"add_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_vertex"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":"> : "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","text":"BidirectionalDirectedGraph"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","text":"Vertices"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Keys."}],"type":"strong"},{"text":" Each vertex has a key: its index in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Vertices.Index == Int","type":"codeVoice"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedPseudograph","type":"codeVoice"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":"; on ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, with no hashing, so a wrapper hashes a vertex once and then works on keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Laws."}],"type":"strong"},{"text":" In addition to ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":"’s:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For a vertex with key "},{"code":"k","type":"codeVoice"},{"type":"text","text":": "},{"code":"_successors(ofKey: k)","type":"codeVoice"},{"type":"text","text":", "},{"code":"_predecessors(ofKey: k)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"_outEdges(ofKey: k)","type":"codeVoice"},{"type":"text","text":", "},{"code":"_inEdges(ofKey: k)","type":"codeVoice"},{"type":"text","text":", "},{"code":"_outDegree(ofKey: k)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"_inDegree(ofKey: k)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are the members of the same name without the label, for that vertex."},{"type":"text","text":" "},{"code":"_successorKeys(ofKey: k)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"_predecessorKeys(ofKey: k)","type":"codeVoice"},{"type":"text","text":" are the far ends’ keys, in the"},{"type":"text","text":" "},{"type":"text","text":"same order; "},{"code":"_sourceKey(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"_targetKey(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" are the endpoints’ keys."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" appends a vertex, which must not already be one, and returns its key:","type":"text"},{"text":" ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"the vertex’s key is now "},{"type":"codeVoice","code":"k"},{"type":"text","text":"; otherwise it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and no other key changes."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"type":"text","text":" removes the edge at a live position and returns it, trapping on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"type":"text","text":", returning the removed instance."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Key density."}],"type":"strong"},{"text":" A wrapper may keep one table entry per 1024 keys, from the smallest live key","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"vertices.endIndex"},{"text":", plus O(1) per live vertex: the memory of the representation’s own page","type":"text"},{"text":" ","type":"text"},{"text":"table. On a dense representation the keys are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":". On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"span can exceed the vertex count: removals leave holes, and a decoded graph may start at any","type":"text"},{"text":" ","type":"text"},{"text":"position (its decoder bounds the span at ","type":"text"},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"text":" pages). Keys before the","type":"text"},{"text":" ","type":"text"},{"text":"smallest live key cost nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Key rows."}]},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"type":"text","text":" return the stored rows"},{"type":"text","text":" "},{"type":"text","text":"typed as "},{"type":"codeVoice","code":"SuccessorIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PredecessorIndices"},{"type":"text","text":", whose elements here are keys. On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation keys and indices coincide. On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the elements are positions,"},{"type":"text","text":" "},{"type":"text","text":"which are vertex indices only while the graph has no holes; "},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"then unavailable, but the key rows are not."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Not requirements."}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"insert(edge:)"},{"type":"text","text":" differs in its return type: "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"type":"text","text":"simple, returns "},{"type":"codeVoice","code":"(inserted:memberAfterInsert:)"},{"type":"text","text":", the multigraphs return the new position, and"},{"type":"text","text":" "},{"type"