{"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"generated":true,"anchor":"Instance-Methods"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom"}],"sections":[],"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertices","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wrapper that adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":", can own any mutable directed"},{"type":"text","text":" "},{"type":"text","text":"representation as its base through this protocol and work on it without extra hashing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each vertex has a key: its index in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Vertices.Index == Int"},{"type":"text","text":"). On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation ("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":", "},{"type":"codeVoice","code":"DirectedPseudograph"},{"type":"text","text":") the key is the vertex’s slot, which is"},{"type":"text","text":" "},{"type":"text","text":"also its "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" it is the vertex’s position, which never"},{"type":"text","text":" "},{"type":"text","text":"changes while the vertex exists and may leave holes. The underscored members read and write the"},{"type":"text","text":" "},{"type":"text","text":"graph by key, so a wrapper hashes a vertex once and then works on keys."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":"’s laws:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For a vertex with key ","type":"text"},{"code":"k","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_successors(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_predecessors(ofKey: k)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"_outEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_inEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_outDegree(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_inDegree(ofKey: k)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"equal the unprefixed members for that vertex.","type":"text"},{"text":" ","type":"text"},{"code":"_successorKeys(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey: k)","type":"codeVoice"},{"text":" are the far ends’ keys, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order. ","type":"text"},{"code":"_sourceKey(ofEdgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_targetKey(ofEdgeAt:)","type":"codeVoice"},{"text":" are the endpoints’ keys.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key,"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":" before the call. Keys of other vertices do not change."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"text":" removes the vertex and every edge at it. If the representation fills","type":"text"},{"text":" ","type":"text"},{"text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and","type":"text"},{"text":" ","type":"text"},{"text":"that vertex’s key becomes ","type":"text"},{"type":"codeVoice","code":"k"},{"text":". Otherwise it returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and no other key changes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"type":"text","text":" removes the edge at a live position and returns it, and traps on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"remove(v)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"_removeVertex(atKey: _key(of: v)!)","type":"codeVoice"},{"type":"text","text":", returning the removed instance."}]}]},{"content":[{"inlineContent":[{"code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"init()","type":"codeVoice"},{"type":"text","text":", then"},{"type":"text","text":" "},{"code":"_insertVertex(_:)","type":"codeVoice"},{"type":"text","text":" for each vertex in order, then "},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"type":"text","text":" for each pair"},{"type":"text","text":" "},{"type":"text","text":"in order. It gives the same graph and the same position for each pair."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A wrapper may keep one table entry per 1024 keys, from the smallest live key to"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":", plus O(1) per live vertex. That matches the representation’s own page"},{"type":"text","text":" "},{"type":"text","text":"table. On a dense representation the keys are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"span can exceed the vertex count, because removals leave holes and a decoded graph may start at"},{"type":"text","text":" "},{"type":"text","text":"any position. Its decoder bounds the span at "},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"type":"text","text":" pages. Keys before the"},{"type":"text","text":" "},{"type":"text","text":"smallest live key cost nothing."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"text":" return the stored rows typed as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SuccessorIndices"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PredecessorIndices"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes. ","type":"text"},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"insert(edge:)"},{"type":"text","text":" is not a requirement because its return type varies by representation."},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"(inserted:memberAfterInsert:)"},{"type":"text","text":", the multigraphs return the new"},{"type":"text","text":" "},{"type":"text","text":"position, and a wrapper that rejects edges returns an optional. Generic code inserts an edge by"},{"type":"text","text":" "},{"type":"text","text":"key with "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The underscored members are for wrappers inside the library. Callers use the representations’"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"insert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"remove"},{"type":"text","text":" members, which take vertices."}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"metadata":{"navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"modules":[{"name":"GraphProtocols"}],"roleHeading":"Protocol","remoteSource":{"fileName":"MutableDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableD