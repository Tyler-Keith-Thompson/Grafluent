{"topicSections":[{"generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"title":"Instance Methods","anchor":"Instance-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertices","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":" == ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]}]},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Keys."}]},{"type":"text","text":" Each vertex has a key: its index in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" ("},{"code":"Vertices.Index == Int","type":"codeVoice"},{"type":"text","text":"). On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation ("},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":", "},{"code":"DirectedPseudograph","type":"codeVoice"},{"type":"text","text":") the key is the vertex’s slot, which is"},{"type":"text","text":" "},{"type":"text","text":"also its "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":"; on "},{"code":"StableDirectedGraph","type":"codeVoice"},{"type":"text","text":" it is the vertex’s position, which never"},{"type":"text","text":" "},{"type":"text","text":"changes while the vertex exists and may leave holes. The underscored members read and write the"},{"type":"text","text":" "},{"type":"text","text":"graph by key, with no hashing, so a wrapper hashes a vertex once and then works on keys."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"_key(of: v)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"vertices.firstIndex(of: v)","type":"codeVoice"},{"type":"text","text":", and "},{"code":"_vertex(atKey:)","type":"codeVoice"},{"type":"text","text":" is its inverse."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For a vertex with key ","type":"text"},{"code":"k","type":"codeVoice"},{"text":": ","type":"text"},{"code":"_successors(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_predecessors(ofKey: k)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"_outEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_inEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_outDegree(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_inDegree(ofKey: k)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are the members of the same name without the label, for that vertex.","type":"text"},{"text":" ","type":"text"},{"code":"_successorKeys(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey: k)","type":"codeVoice"},{"text":" are the far ends’ keys, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order; ","type":"text"},{"code":"_sourceKey(ofEdgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_targetKey(ofEdgeAt:)","type":"codeVoice"},{"text":" are the endpoints’ keys.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertVertex(_:)"},{"text":" appends a vertex, which must not already be one, and returns its key:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices.endIndex"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"the vertex’s key is now "},{"type":"codeVoice","code":"k"},{"type":"text","text":"; otherwise it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and no other key changes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"type":"text","text":" removes the edge at a live position and returns it, trapping on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}]}]}]},{"inlineContent":[{"text":"The hooks are underscored because they are for wrappers inside the library: callers use the","type":"text"},{"text":" ","type":"text"},{"text":"representations’ own ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"remove","type":"codeVoice"},{"text":" members, which take vertices.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"symbolKind":"protocol","modules":[{"name":"GraphProtocols"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L32","fileName":"MutableDirectedGraph.swift"},"roleHeading":"Protocol","externalID":"s:14GraphProtocols015MutableDirectedA0P","title":"MutableDirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}]},"abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"code"