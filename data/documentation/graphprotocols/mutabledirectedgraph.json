{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"variants":[{"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"generated":true,"anchor":"Instance-Methods"}],"kind":"symbol","metadata":{"roleHeading":"Protocol","role":"symbol","remoteSource":{"fileName":"MutableDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/MutableDirectedGraph.swift#L54"},"symbolKind":"protocol","externalID":"s:14GraphProtocols015MutableDirectedA0P","modules":[{"name":"GraphProtocols"}],"title":"MutableDirectedGraph","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertices","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":" == ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A wrapper that adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":", can own any mutable directed","type":"text"},{"text":" ","type":"text"},{"text":"representation as its base through this protocol and work on it without extra hashing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each vertex has a key: its index in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Vertices.Index == Int","type":"codeVoice"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedPseudograph","type":"codeVoice"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":". On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, so a wrapper hashes a vertex once and then works on keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s laws:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"_vertex(atKey:)"},{"text":" is its inverse.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For a vertex with key ","type":"text"},{"type":"codeVoice","code":"k"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_successors(ofKey: k)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_predecessors(ofKey: k)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_outEdges(ofKey: k)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_inEdges(ofKey: k)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"_outDegree(ofKey: k)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_inDegree(ofKey: k)"},{"text":" ","type":"text"},{"text":"equal the unprefixed members for that vertex.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"_successorKeys(ofKey: k)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_predecessorKeys(ofKey: k)"},{"text":" are the far ends’ keys, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order. ","type":"text"},{"type":"codeVoice","code":"_sourceKey(ofEdgeAt:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_targetKey(ofEdgeAt:)"},{"text":" are the endpoints’ keys.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" appends a vertex, which must not already be one, and returns its key,","type":"text"},{"text":" ","type":"text"},{"text":"which is ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_removeVertex(atKey: k)","type":"codeVoice"},{"text":" removes the vertex and every edge at it. If the representation fills","type":"text"},{"text":" ","type":"text"},{"text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and","type":"text"},{"text":" ","type":"text"},{"text":"that vertex’s key becomes ","type":"text"},{"code":"k","type":"codeVoice"},{"text":". Otherwise it returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and no other key changes.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"_removeEdge(at:)","type":"codeVoice"},{"type":"text","text":" removes the edge at a live position and returns it, and traps on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"remove(v)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"_removeVertex(atKey: _key(of: v)!)"},{"text":", returning the removed instance.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":", then","type":"text"},{"text":" ","type":"text"},{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" for each vertex in order, then ","type":"text"},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":" for each pair","type":"text"},{"text":" ","type":"text"},{"text":"in order. It gives the same graph and the same position for each pair.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A wrapper may keep one table entry per 1024 keys, from the smallest live key to","type":"text"},{"text":" ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":", plus O(1) per live vertex. That matches the representation’s own page","type":"text"},{"text":" ","type":"text"},{"text":"table. On a dense representation the keys are ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":". On ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"span can exceed the vertex count, because removals leave holes and a decoded graph may start at","type":"text"},{"text":" ","type":"text"},{"text":"any position. Its decoder bounds the span at ","type":"text"},{"code":"16 × vertexCount + 64","type":"codeVoice"},{"text":" pages. Keys before the","type":"text"},{"text":" ","type":"text"},{"text":"smallest live key cost nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"text":" return the stored rows typed as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SuccessorIndices"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PredecessorIndices"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes. ","type":"text"},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"insert(edge:)"},{"type":"text","text":" is not a requirement because its return type varies by representation."},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"(inserted:memberAfterInsert:)"},{"type":"text","text":", the multigraphs return the new"},{"type":"text","text":" "},{"type":"text","text":"position, and a wrapper that rejects edges returns an optional. Generic code inserts an edge by"},{"type":"text","text":" "},{"type":"text","text":"key with "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The underscored members are for wrappers inside the library. Callers use the representations’"},{"type":"text","text":" "},{"type":"text","text":"own "},{"code":"insert","type":"codeVoice"},{"type":"text","text":" and "},{"code":"remove","type":"codeVoice"},{"type":"text","text":" members, which take vertices."}]}]}],"abstract":[{"text":"A bidirectional directed graph that generic code can mutate.","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"title":"Vertex","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","required":true,"abstract":[],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/removeAllEdges(keepingCapacity:)":{"title":"removeAllEdges(keepingCapacity:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Removes every edge, keeping every vertex and its key."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/removealledges(keepingcapacity:)","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"removeAllEdges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"keepingCapacity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/init()":{"role":"symbol","title":"init()","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Mutable