ols\/MutableDirectedGraph\/remove(edge:)","required":true,"abstract":[{"type":"text","text":"Removes one copy of "},{"code":"edge","type":"codeVoice"},{"type":"text","text":" (the newest, on a representation with parallel edges). Never"},{"type":"text","text":" "},{"type":"text","text":"inserts or removes a vertex."}],"type":"topic","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(edge:)","kind":"symbol","role":"symbol","title":"remove(edge:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV","text":"DirectedEdge"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV","text":"DirectedEdge"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">?"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","type":"topic","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","title":"DirectedGraph"},"doc: