{"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertices","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":" == ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Keys."}],"type":"strong"},{"text":" Each vertex has a key: its index in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" (","type":"text"},{"code":"Vertices.Index == Int","type":"codeVoice"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DirectedPseudograph","type":"codeVoice"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":"; on ","type":"text"},{"code":"StableDirectedGraph","type":"codeVoice"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, with no hashing, so a wrapper hashes a vertex once and then works on keys.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"_key(of: v)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"vertices.firstIndex(of: v)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"_vertex(atKey:)","type":"codeVoice"},{"text":" is its inverse.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"For a vertex with key "},{"type":"codeVoice","code":"k"},{"type":"text","text":": "},{"type":"codeVoice","code":"_successors(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_predecessors(ofKey: k)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"_outEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_inEdges(ofKey: k)"},{"type":"text","text":", "},{"type":"codeVoice","code":"_outDegree(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_inDegree(ofKey: k)"},{"type":"text","text":" "},{"type":"text","text":"are the members of the same name without the label, for that vertex."},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey: k)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey: k)"},{"type":"text","text":" are the far ends’ keys, in the"},{"type":"text","text":" "},{"type":"text","text":"same order; "},{"type":"codeVoice","code":"_sourceKey(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_targetKey(ofEdgeAt:)"},{"type":"text","text":" are the endpoints’ keys."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"text":" appends a vertex, which must not already be one, and returns its key:","type":"text"},{"text":" ","type":"text"},{"code":"vertices.endIndex","type":"codeVoice"},{"text":" before the call. Keys of other vertices do not change.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":" inserts the edge and returns its position. On a simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":"), an edge already present is not inserted again and its position is","type":"text"},{"text":" ","type":"text"},{"text":"returned. Inserting an edge changes no key.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_removeVertex(atKey: k)","type":"codeVoice"},{"text":" removes the vertex and every edge at it. If the representation fills","type":"text"},{"text":" ","type":"text"},{"text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and","type":"text"},{"text":" ","type":"text"},{"text":"the vertex’s key is now ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"; otherwise it returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and no other key changes.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"_removeEdge(at:)","type":"codeVoice"},{"type":"text","text":" removes the edge at a live position and returns it, trapping on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"remove(v)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"_removeVertex(atKey: _key(of: v)!)","type":"codeVoice"},{"type":"text","text":", returning the removed instance."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Key density."}]},{"type":"text","text":" A wrapper may keep one table entry per 1024 keys, from the smallest live key"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"vertices.endIndex"},{"type":"text","text":", plus O(1) per live vertex: the memory of the representation’s own page"},{"type":"text","text":" "},{"type":"text","text":"table. On a dense representation the keys are "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":". On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"span can exceed the vertex count: removals leave holes, and a decoded graph may start at any"},{"type":"text","text":" "},{"type":"text","text":"position (its decoder bounds the span at "},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"type":"text","text":" pages). Keys before the"},{"type":"text","text":" "},{"type":"text","text":"smallest live key cost nothing."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Key rows."}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"type":"text","text":" return the stored rows"},{"type":"text","text":" "},{"type":"text","text":"typed as "},{"type":"codeVoice","code":"SuccessorIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PredecessorIndices"},{"type":"text","text":", whose elements here are keys. On a dense"},{"type":"text","text":" "},{"type":"text","text":"representation keys and indices coincide. On "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" the elements are positions,"},{"type":"text","text":" "},{"type":"text","text":"which are vertex indices only while the graph has no holes; "},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"then unavailable, but the key rows are not."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Not requirements.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"insert(edge:)","type":"codeVoice"},{"text":" differs in its return type: ","type":"text"},{"code":"AdjacencyList","type":"codeVoice"},{"text":", which is","type":"text"},{"text":" ","type":"text"},{"text":"simple, returns ","type":"text"},{"code":"(inserted:memberAfterInsert:)","type":"codeVoice"},{"text":", the multigraphs return the new position, and","type":"text"},{"text":" ","type":"text"},{"text":"a wrapper that rejects edges returns an optional. So generic code inserts an edge by key, with","type":"text"},{"text":" ","type":"text"},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The hooks are underscored because they are for wrappers inside the library: callers use the"},{"type":"text","text":" "},{"type":"text","text":"representations’ own "},{"code":"insert","type":"codeVoice"},{"type":"text","text":" and "},{"code":"remove","type":"codeVoice"},{"type":"text","text":" members, which take vert