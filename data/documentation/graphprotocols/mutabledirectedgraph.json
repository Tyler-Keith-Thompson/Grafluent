ges it removes the newest"},{"type":"text","text":" "},{"type":"text","text":"copy. Never inserts or removes a vertex."}],"role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","title":"MutableDirectedGraph","abstract":[{"text":"A bidirectional directed graph that generic code can mutate.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","kind":"symbol","role":"collection","title":"GraphProtocols","abstract":[],"type":"topic","url":"\/documentation\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","title":"DirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertices-swift.associatedtype":{"kind":"symbol","required":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text