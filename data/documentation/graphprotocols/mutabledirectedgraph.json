text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"title":"MutableDirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"required":true,"role":"symbol","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","title":"Vertex","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/remove(_:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(_:)","kind":"symbol","required":true,"role":"symbol","title":"remove(_:)","abstract":[{"type":"text","text":"Removes "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" and every edge at it."}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":"?"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/insert(_:)":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/insert(_:)","kind":"symbol","required":true,"role":"symbol","title":"insert(_:)","abstract":[{"text":