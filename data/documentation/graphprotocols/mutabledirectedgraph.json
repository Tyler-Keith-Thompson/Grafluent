{"metadata":{"role":"symbol","title":"MutableDirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"modules":[{"name":"GraphProtocols"}],"symbolKind":"protocol","roleHeading":"Protocol","externalID":"s:14GraphProtocols015MutableDirectedA0P","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"kind":"relationships","title":"Inherits From"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/mutabledirectedgraph"]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAll(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/removeAllEdges(keepingCapacity:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","text":"BidirectionalDirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P8VerticesQa","text":"Vertices","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A wrapper that adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":", can own any mutable directed","type":"text"},{"text":" ","type":"text"},{"text":"representation as its base through this protocol and work on it without extra hashing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each vertex has a key: its index in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" (","type":"text"},{"type":"codeVoice","code":"Vertices.Index == Int"},{"text":"). On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation (","type":"text"},{"type":"codeVoice","code":"AdjacencyList"},{"text":", ","type":"text"},{"type":"codeVoice","code":"DirectedPseudograph"},{"text":") the key is the vertex’s slot, which is","type":"text"},{"text":" ","type":"text"},{"text":"also its ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":". On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" it is the vertex’s position, which never","type":"text"},{"text":" ","type":"text"},{"text":"changes while the vertex exists and may leave holes. The underscored members read and write the","type":"text"},{"text":" ","type":"text"},{"text":"graph by key, so a wrapper hashes a vertex once and then works on keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In addition to ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":"’s laws:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_key(of: v)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"vertices.firstIndex(of: v)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"_vertex(atKey:)"},{"type":"text","text":" is its inverse."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For a vertex with key ","type":"text"},{"code":"k","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_successors(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_predecessors(ofKey: k)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"_outEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_inEdges(ofKey: k)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_outDegree(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_inDegree(ofKey: k)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"equal the unprefixed members for that vertex.","type":"text"},{"text":" ","type":"text"},{"code":"_successorKeys(ofKey: k)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_predecessorKeys(ofKey: k)","type":"codeVoice"},{"text":" are the far ends’ keys, in the","type":"text"},{"text":" ","type":"text"},{"text":"same order. ","type":"text"},{"code":"_sourceKey(ofEdgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_targetKey(ofEdgeAt:)","type":"codeVoice"},{"text":" are the endpoints’ keys.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_insertVertex(_:)","type":"codeVoice"},{"type":"text","text":" appends a vertex, which must not already be one, and returns its key,"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"code":"vertices.endIndex","type":"codeVoice"},{"type":"text","text":" before the call. Keys of other vertices do not change."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":" inserts the edge and returns its position. On a simple graph"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":"), an edge already present is not inserted again and its position is"},{"type":"text","text":" "},{"type":"text","text":"returned. Inserting an edge changes no key."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeVertex(atKey: k)"},{"type":"text","text":" removes the vertex and every edge at it. If the representation fills"},{"type":"text","text":" "},{"type":"text","text":"the hole by moving another vertex in (a swap-remove), it returns that vertex’s old key, and"},{"type":"text","text":" "},{"type":"text","text":"that vertex’s key becomes "},{"type":"codeVoice","code":"k"},{"type":"text","text":". Otherwise it returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and no other key changes."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_removeEdge(at:)"},{"type":"text","text":" removes the edge at a live position and returns it, and traps on any other"},{"type":"text","text":" "},{"type":"text","text":"position. Removing an edge changes no key."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"remove(v)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"_removeVertex(atKey: _key(of: v)!)","type":"codeVoice"},{"text":", returning the removed instance.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_built(vertices:sourceKeys:targetKeys:reportingPositions:_:)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"init()","type":"codeVoice"},{"type":"text","text":", then"},{"type":"text","text":" "},{"code":"_insertVertex(_:)","type":"codeVoice"},{"type":"text","text":" for each vertex in order, then "},{"code":"_insertEdge(fromKey:toKey:)","type":"codeVoice"},{"type":"text","text":" for each pair"},{"type":"text","text":" "},{"type":"text","text":"in order. It gives the same graph and the same position for each pair."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A wrapper may keep one table entry per 1024 keys, from the smallest live key to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices.endIndex"},{"text":", plus O(1) per live vertex. That matches the representation’s own page","type":"text"},{"text":" ","type":"text"},{"text":"table. On a dense representation the keys are ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":". On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"span can exceed the vertex count, because removals leave holes and a decoded graph may start at","type":"text"},{"text":" ","type":"text"},{"text":"any position. Its decoder bounds the span at ","type":"text"},{"type":"codeVoice","code":"16 × vertexCount + 64"},{"text":" pages. Keys before the","type":"text"},{"text":" ","type":"text"},{"text":"smallest live key cost nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_successorKeys(ofKey:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"_predecessorKeys(ofKey:)"},{"text":" return the stored rows typed as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SuccessorIndices"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"PredecessorIndices"},{"text":", whose elements here are keys. On a dense","type":"text"},{"text":" ","type":"text"},{"text":"representation keys and indices coincide. On ","type":"text"},{"type":"codeVoice","code":"StableDirectedGraph"},{"text":" the elements are positions,","type":"text"},{"text":" ","type":"text"},{"text":"which are vertex indices only while the graph has no holes. ","type":"text"},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"then unavailable, but the key rows are not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"insert(edge:)"},{"type":"text","text":" is not a requirement because its return type varies by representation."},{"type":"text","text":" "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"(inserted:memberAfterInsert:)"},{"type":"text","text":", the multigraphs return the new"},{"type":"text","text":" "},{"type":"text","text":"position, and a wrapper that rejects edges returns an optional. Generic code inserts an edge by"},{"type":"text","text":" "},{"type":"text","text":"key with "},{"type":"codeVoice","code":"_insertEdge(fromKey:toKey:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The underscored members are for wrappers inside the library. Callers use the representations’","type":"text"},{"text":" ","type":"text"},{"text":"own ","type":"text"},{"code":"insert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"remove","type":"codeVoice"},{"text":" members, which take vertices.","type":"text"}]}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate."}],"kind":"symbol","role":"symbol","type":"topic","title":"MutableDirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/init()":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/init()","type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/init()","abstract":[{"type":"text","text":"The empty graph."}],"kind":"symbol","required":true,"fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"title":"init()"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/remove(_:)":{"kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(_:)","title":"remove(_:)","required":true,"abstract":[{"text":"Removes ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" and every edge at it.","type":"text"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(_:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifi