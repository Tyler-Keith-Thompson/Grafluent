dA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":"?"}],"required":true,"role":"symbol","abstract":[{"type":"text","text":"Removes "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" and every edge at it."}],"kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(_:)"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/remove(edge:)":{"title":"remove(edge:)","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/remove(edge:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DirectedEdge","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"DirectedEdge","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">?"}],"required":true,"role":"symbol","abstract":[{"text":"Removes one copy of ","type":"text"},{"code":"edge","type":"codeVoice"},{"text":" (the newest, on a representation with parallel edges). Never","type":"text"},{"text":" ","type":"text"},{"text":"inserts or removes a vertex.","type":"text"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/remove(edge:)"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/reserveCapacity(vertexCount:edgeCount:)":{"type":"topic","required":true,"title":"reserveCapacity(vertexCount:edgeCount:)","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/reservecapacity(vertexcount:edgecount:)","kind":"symbol","abstract":[{"text":"Reserves space for at least ","type":"text"},{"code":"vertexCount","type":"codeVoice"},{"text":" vertices and ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":" edges.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"reserveCapacity"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"edgeCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/reserveCapacity(vertexCount:edgeCount:)","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph/insert(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> (inserted"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", memberAfterInsert"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Inserts "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" with no edges, if it is not already a vertex."}],"required":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph\/insert(_:)","url":"\/documentation\/graphprotocols\/mutabledirectedgraph\/insert(_:)","title":"insert(_:)","type":"topic","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","title":"GraphProtocols","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols","abstract":[]}}}