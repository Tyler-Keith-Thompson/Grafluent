l","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph","title":"DirectedHypergraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/generation-5b2iu":{"url":"\/documentation\/graphprotocols\/directedhypergraph\/generation-5b2iu","abstract":[{"code":"GraphGeneration.untracked","type":"codeVoice"},{"type":"text","text":": a conformer that does not track its mutations."}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/generation-5b2iu","title":"generation","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"generation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GraphGeneration","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A10GenerationV"}]},"doc://GraphProtocols/documentation/GraphProtocols":{"role":"collection","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","url":"\/documentation\/graphprotocols","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration":{"type":"topic","url":"\/documentation\/graphprotocols\/graphgeneration","kind":"symbol","role":"symbol","title":"GraphGeneration","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration","abstract":[{"type":"text","text":"A graph’s generation: which state of which graph it is. Every structural mutation (an"},{"type":"text","text":" "},{"type":"text","text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and"},{"type":"text","text":" "},{"type":"text","text":"writing attached map values do not. A structure derived from a graph stores the graph’s"},{"type":"text","text":" "},{"code":"generation","type":"codeVoice"},{"text":" and asks ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" before it relies on the graph again.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"GraphGeneration"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphGeneration"}]}}}