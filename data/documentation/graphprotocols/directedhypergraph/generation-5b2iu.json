,"text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/generation-5b2iu":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"generation","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A10GenerationV","text":"GraphGeneration","kind":"typeIdentifier"}],"title":"generation","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/generation-5b2iu","url":"\/documentation\/graphprotocols\/directedhypergraph\/generation-5b2iu","abstract":[{"type":"codeVoice","code":"GraphGeneration.untracked"},{"type":"text","text":": a conformer that does not track its mutations."}],"kind":"symbol","type":"topic"}}}