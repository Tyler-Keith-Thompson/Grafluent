"abstract":[],"url":"\/documentation\/graphprotocols\/directedhypergraph\/incidenthyperedges","role":"symbol","title":"IncidentHyperedges","type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedhypergraph","role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","title":"DirectedHypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","abstract":[],"url":"\/documentation\/graphprotocols","role":"collection","title":"GraphProtocols","type":"topic","kind":"symbol"}}}