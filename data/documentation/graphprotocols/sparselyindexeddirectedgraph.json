 while it has no holes."}],"type":"paragraph"},{"inlineContent":[{"text":"Algorithms use this refinement to number the live vertices and edges with arrays while holes","type":"text"},{"text":" ","type":"text"},{"text":"exist, instead of hashing every vertex and edge they meet. The bounds are upper bounds only.","type":"text"},{"text":" ","type":"text"},{"text":"Positions are never reused, so a bound counts every position ever handed out, and nothing in","type":"text"},{"text":" ","type":"text"},{"text":"the library allocates by it. Position-keyed state goes through a paged map","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"_PositionNumbers","type":"codeVoice"},{"text":"), O(live elements + pages).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In addition to ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":"’s laws:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"text":" is true exactly for the positions of live vertices, all in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":". ","type":"text"},{"type":"codeVoice","code":"vertexPosition(of:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"vertex(atPosition:)"},{"text":" are inverses, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" lists the live vertices in increasing position. Likewise","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"text":" is true exactly for the positions in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", all in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":", which ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists in increasing order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges(of:)"},{"type":"text","text":" order."}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph/containsEdge(atPosition:)":{"url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph\/containsedge(atposition:)","kind":"symbol","abstract":[{"type":"text","text":"Whether a live edge sits at "},{"type":"codeVoice","code":"position"},{"type":"text","text":"; false, without trapping, for any other integer."},{"type":"text","text":" "},{"type":"text","text":"O(1)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"containsEdge"},{"kind":"text","text":"("},{"kind":"externalParam","text":"