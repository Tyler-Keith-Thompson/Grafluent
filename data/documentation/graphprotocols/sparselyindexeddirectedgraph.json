"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges(of:)"},{"type":"text","text":" order."}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/edgePositionBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPositionBound"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsEdge(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsVertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPosition(of:)"],"anchor":"Instance-Methods"}],"kind":"symbol","metadata":{"remoteSource":{"fileName":"SparselyIndexedDirectedGraph.swift","url":"https