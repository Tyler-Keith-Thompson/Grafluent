":" ","type":"text"},{"text":"(","type":"text"},{"code":"_PositionNumbers","type":"codeVoice"},{"text":"), O(live elements + pages).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Laws."}],"type":"strong"},{"text":" In addition to ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":"’s:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":"; "},{"type":"codeVoice","code":"vertexPosition(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vertex(atPosition:)"},{"type":"text","text":" are inverse; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists the live vertices in increasing position. Likewise "},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"type":"text","text":" "},{"type":"text","text":"for the positions in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", all in "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", in increasing order."}]}]},{"content":[{"inlineContent":[{"text":"Without holes, the bounds equal ","type":"text"},{"type":"codeVoice","code":"vertexIndexBound"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"edgeIndexBound"},{"text":", and positions are","type":"text"},{"text":" ","type":"text"},{"text":"indices.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_numberedRows(outward:edges:)","type":"codeVoice"},{"text":" numbers the live vertices ","type":"text"},{"code":"0..<vertexCount","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order and","type":"text"},{