{"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedDirectedGraph"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":"> : "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","text":"BidirectionalDirectedGraph"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" describe dense indices with no holes"},{"type":"text","text":" "},{"type":"text","text":"and keep their laws. A conformer reports them only while it has no holes."}],"type":"paragraph"},{"inlineContent":[{"text":"Algorithms use this refinement to number the live vertices and edges with arrays while holes","type":"text"},{"text":" ","type":"text"},{"text":"exist, instead of hashing every vertex and edge they meet. The bounds are upper bounds only.","type":"text"},{"text":" ","type":"text"},{"text":"Positions are never reused, so a bound counts every position ever handed out, and nothing in","type":"text"},{"text":" ","type":"text"},{"text":"the library allocates by it. Position-keyed state goes through a paged map","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"_PositionNumbers","type":"codeVoice"},{"text":"), O(live elements + pages).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In addition to "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":"’s laws:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":". "},{"type":"codeVoice","code":"vertexPosition(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vertex(atPosition:)"},{"type":"text","text":" are inverses, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists the live vertices in increasing position. Likewise"},{"type":"text","text":" "},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"type":"text","text":" is true exactly for the positions in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", which "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists in increasing order."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges(of:)"},{"type":"text","text":" order."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/graphprotocols\/sparselyindexeddirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","interfaceLanguage":"swift"},"abstract":[{"text":"A directed graph whose vertices and edges sit at integer positions in ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":", with possible holes.","type":"text"}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"protocol","remoteSource":{"fileName":"SparselyIndexedDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/SparselyIndexedDirectedGraph.swift#L24"},"na