xt","text":"("},{"type":"codeVoice","code":"_PositionNumbers"},{"type":"text","text":"), O(live elements + pages)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s laws:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":". "},{"type":"codeVoice","code":"vertexPosition(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vertex(atPosition:)"},{"type":"text","text":" are inverses, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists the live vertices in increasing position. Likewise"},{"type":"text","text":" "},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"type":"text","text":" is true exactly for the positions in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", which "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists in increasing order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Without holes, the bounds equal ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and positions are","type":"text"},{"text":" ","type":"text"},{"text":"indices.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"text":" numbers the live vertices ","type":"text"},{"type":"codeVoice","code":"0..<vertexCount"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order and","type":"text