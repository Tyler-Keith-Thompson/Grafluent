 positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges(of:)"},{"type":"text","text":" order."}]}]}]}]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"topicSections":[{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/edgePositionBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPositionBound"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsEdge(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsVertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPosition(of:)"]}],"variants":[{"paths":["\/documentation\/graphprotocols\/sparselyindexeddirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph/vertex(atPosition:)":{"type":"topic",