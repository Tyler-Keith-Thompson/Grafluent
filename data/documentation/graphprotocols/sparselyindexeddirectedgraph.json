hProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"code":"DirectedGraph","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":" describe dense indices with no holes","type":"text"},{"text":" ","type":"text"},{"text":"and keep their laws. A conformer reports them only while it has no holes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Algorithms use this refinement to number the live vertices and edges with arrays while holes"},{"type":"text","text":" "},{"type":"text","text":"exist, instead of hashing every vertex and edge they meet. The bounds are upper bounds only."},{"type":"text","text":" "},{"type":"text","text":"Positions are never reused, so a bound counts every position ever handed out, and nothing in"},{"type":"text","text":" "},{"type":"text","text":"the library allocates by it. Position-keyed state goes through a paged map"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"_PositionNumbers"},{"type":"text","text":"), O(live elements + pages)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s laws:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"containsVertex(atPosition: p)","type":"codeVoice"},{"text":" is true exactly for the positions of live vertices, all in","type":"text"},{"text":" ","type":"text"},{"code":"0..<vertexPositionBound","type":"codeVoice"},{"text":". ","type":"text"},{"code":"vertexPosition(of:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"vertex(atPosition:)","type":"codeVoice"},{"text":" are inverses, and","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" lists the live vertices in increasing position. Likewise","type":"text"},{"text":" ","type":"text"},{"code":"containsEdge(atPosition:)","type":"codeVoice"},{"text":" is true exactly for the positions in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", all in","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgePositionBound","type":"codeVoice"},{"text":", which ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" lists in increasing order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"_numberedRows(outward:edges:)","type":"codeVoice"},{"type":"text","text":" numbers the live vertices "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"code":"outEdges(of:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"inEdges(of:)","type":"codeVoice"},{"type":"text","text":" order."}]}]}],"type":"unorderedList"}]}],"metadata":{"title":"SparselyIndexedDirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier