":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Algorithms use this refinement to number the live vertices and edges with arrays while holes","type":"text"},{"text":" ","type":"text"},{"text":"exist, instead of hashing every vertex and edge they meet. The bounds are upper bounds only:","type":"text"},{"text":" ","type":"text"},{"text":"positions are never reused, so a bound counts every position ever handed out, and nothing in","type":"text"},{"text":" ","type":"text"},{"text":"the library allocates by it. Position-keyed state goes through a paged map","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"_PositionNumbers","type":"codeVoice"},{"text":"), O(live elements + pages).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"text":" In addition to ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":"’s:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":"; "},{"type":"codeVoice","code":"vertexPosition(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vertex(atPosition:)"},{"type":"text","text":" are inverse; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists the live vertices in increasing position. Likewise "},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"type":"text","text":" "},{"type":"text","text":"for the positions in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", all in "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", in increasing order."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Without holes, the bounds equal ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and positions are","type":"text"},{"text":" ","type":"text"},{"text":"indices.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges(of:)"},{"type":"text","text":" order."}]}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"type":"inheritsFrom","kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/graphprotocols\/sparselyindexeddirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph":{"url":"\/documentation\/graphprotoc