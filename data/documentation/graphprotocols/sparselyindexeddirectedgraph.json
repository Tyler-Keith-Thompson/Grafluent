{"kind":"symbol","relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"},"abstract":[{"type":"text","text":"A directed graph whose vertices and edges sit at integer positions in "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":" that may have holes: petgraph’s "},{"type":"codeVoice","code":"NodeIndexable"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"node_bound()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edge_bound()"},{"type":"text","text":" are “an upper bound of the indices,"},{"type":"text","text":" "},{"type":"text","text":"suitable for the size of a bitmap”, as against "},{"type":"codeVoice","code":"NodeCompactIndexable"},{"type":"text","text":", whose indices have no"},{"type":"text","text":" "},{"type":"text","text":"holes. "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" are the compact kind and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws; a conformer reports them only while it has no holes."}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"topicSections":[{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/edgePositionBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPositionBound"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsEdge(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsVertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPosition(of:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedDirectedGraph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"> : "},{"preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"typeIdentifier","text":"BidirectionalDirectedGraph"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":" == "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Algorithms use this refinement to number the live vertices and edges with arrays while holes"},{"type":"text","text":" "},{"type":"text","text":"exist, instead of hashing every vertex and edge they meet. The bounds are upper bounds only:"},{"type":"text","text":" "},{"type":"text","text":"positions are never reused, so a bound counts every position ever handed out, and nothing in"},{"type":"text","text":" "},{"type":"text","text":"the library allocates by it. Position-keyed state goes through a paged map"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"_PositionNumbers"},{"type":"text","text":"), O(live elements + pages)."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"containsVertex(atPosition: p)","type":"codeVoice"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"code":"0..<vertexPositionBound","type":"codeVoice"},{"type":"text","text":"; "},{"code":"vertexPosition(of:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"vertex(atPosition:)","type":"codeVoice"},{"type":"text","text":" are inverse; and"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" lists the live vertices in increasing position. Likewise "},{"code":"containsEdge(atPosition:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for the positions in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", all in "},{"code":"0..<edgePositionBound","type":"codeVoice"},{"type":"text","text":", in increasing order."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges(of:)"},{"type":"text","text":" order."}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/graphprotocols\/sparselyindexeddirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"symbol","modules":[{"name":"GraphProtocols"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"roleHeading":"Protocol","externalID":"s:14GraphProtocols023SparselyIndexedDirectedA0P","title":"SparselyIndexedDirectedGraph","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"remoteSource":{"fileName":"SparselyIndexedDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/SparselyIndexedDirectedGraph.swift#L24"}},"references":{"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtoc