{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"role":"symbol","symbolKind":"protocol","modules":[{"name":"GraphProtocols"}],"roleHeading":"Protocol","title":"SparselyIndexedDirectedGraph","externalID":"s:14GraphProtocols023SparselyIndexedDirectedA0P","navigatorTitle":[{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"remoteSource":{"fileName":"SparselyIndexedDirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/SparselyIndexedDirectedGraph.swift#L24"},"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}]},"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"abstract":[{"type":"text","text":"A directed graph whose vertices and edges sit at integer positions in "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":" that may have holes: petgraph’s "},{"type":"codeVoice","code":"NodeIndexable"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"node_bound()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edge_bound()"},{"type":"text","text":" are “an upper bound of the indices,"},{"type":"text","text":" "},{"type":"text","text":"suitable for the size of a bitmap”, as against "},{"type":"codeVoice","code":"NodeCompactIndexable"},{"type":"text","text":", whose indices have no"},{"type":"text","text":" "},{"type":"text","text":"holes. "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" are the compact kind and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws; a conformer reports them only while it has no holes."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"],"title":"Inherits From","type":"inheritsFrom"}],"variants":[{"paths":["\/documentation\/graphprotocols\/sparselyindexeddirectedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/edgePositionBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPositionBound"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsEdge(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/containsVertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertex(atPosition:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph\/vertexPosition(of:)"],"title":"Instance Methods","anchor":"Instance-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparselyIndexedDirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":"> : ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols021BidirectionalDirectedA0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":" == ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"platforms":["Linux"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Algorithms use this refinement to number the live vertices and edges with arrays while holes"},{"type":"text","text":" "},{"type":"text","text":"exist, instead of hashing every vertex and edge they meet. The bounds are upper bounds only:"},{"type":"text","text":" "},{"type":"text","text":"positions are never reused, so a bound counts every position ever handed out, and nothing in"},{"type":"text","text":" "},{"type":"text","text":"the library allocates by it. Position-keyed state goes through a paged map"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"_PositionNumbers"},{"type":"text","text":"), O(live elements + pages)."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"text":" In addition to ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":"’s:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"text":" is true exactly for the positions of live vertices, all in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"vertexPosition(of:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"vertex(atPosition:)"},{"text":" are inverse; and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" lists the live vertices in increasing position. Likewise ","type":"text"},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"text":" ","type":"text"},{"text":"for the positions in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", all in ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":", in increasing order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedRows(outward:edges:)"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"lists, for each number, the numbers of its successors (outward) or predecessors, with the edge"},{"type":"text","text":" "},{"type":"text","text":"positions beside them, in "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges(of:)"},{"type":"text","text":" order."}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentatio