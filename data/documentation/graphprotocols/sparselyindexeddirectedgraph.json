s only:","type":"text"},{"text":" ","type":"text"},{"text":"positions are never reused, so a bound counts every position ever handed out, and nothing in","type":"text"},{"text":" ","type":"text"},{"text":"the library allocates by it. Position-keyed state goes through a paged map","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"_PositionNumbers"},{"text":"), O(live elements + pages).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"containsVertex(atPosition: p)","type":"codeVoice"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"code":"0..<vertexPositionBound","type":"codeVoice"},{"type":"text","text":"; "},{"code":"vertexPosition(of:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"vertex(atPosition:)","type":"codeVoice"},{"type":"text","text":" are inverse; and"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" lists the live vertices in increasing position. Likewise "},{"code":"containsEdge(atPosition:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"for the positions in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", all in "},{"code":"0..<edgePositionBound","type":"codeVoice"},{"type":"text","text":", in increasing order."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}],"type":"paragraph"}]},{"conten