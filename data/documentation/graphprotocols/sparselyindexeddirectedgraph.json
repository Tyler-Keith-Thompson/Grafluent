 positions in ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":" that may have holes: petgraph’s ","type":"text"},{"type":"codeVoice","code":"NodeIndexable"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EdgeIndexable"},{"text":", whose ","type":"text"},{"type":"codeVoice","code":"node_bound()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"edge_bound()"},{"text":" are “an upper bound of the indices,","type":"text"},{"text":" ","type":"text"},{"text":"suitable for the size of a bitmap”, as against ","type":"text"},{"type":"codeVoice","code":"NodeCompactIndexable"},{"text":", whose indices have no","type":"text"},{"text":" ","type":"text"},{"text":"holes. ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"vertexIndexBound"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"edgeIndexBound"},{"text":" are the compact kind and keep","type":"text"},{"text":" ","type":"text"},{"text":"their laws; a conformer reports them only while it has no holes.","type":"text"}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedDirectedGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","preciseIden