ng every vertex and edge they meet. The bounds are upper bounds only:","type":"text"},{"text":" ","type":"text"},{"text":"positions are never reused, so a bound counts every position ever handed out, and nothing in","type":"text"},{"text":" ","type":"text"},{"text":"the library allocates by it. Position-keyed state goes through a paged map","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"_PositionNumbers","type":"codeVoice"},{"text":"), O(live elements + pages).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" In addition to "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":"’s:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":"; "},{"type":"codeVoice","code":"vertexPosition(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vertex(atPosition:)"},{"type":"text","text":" are inverse; and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists the live vertices in increasing position. Likewise "},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"type":"text","text":" "},{"type":"text","text":"for the positions in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", all in "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", in increasing order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":" and "},{"code":"edgeIndexBound","type":"codeVoice"},{"type":"text","text":", and positions are"},{"type":"te