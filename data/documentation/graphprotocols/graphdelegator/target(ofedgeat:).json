/documentation\/graphprotocols\/graphdelegator","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphDelegator"}],"abstract":[{"type":"text","text":"A wrapper that owns its base, keeps the base’s vertices, edges and positions, and adds only"},{"type":"text","text":" "},{"type":"text","text":"rules: JGraphT’s "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":". Every read requirement of "},{"type":"codeVoice","code":"Graph"},{"text":", ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SparselyIndexedDirectedGraph","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":" has a default","type":"text"},{"text":" ","type":"text"},{"text":"that forwards to the base, ","type":"text"},{"code":"@inlinable","type":"codeVoice"},{"text":" and with the base’s own types, so algorithms run at the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"base’s speed and data kept by position stays valid through the wrapper. The wrapper implements"},{"type":"text","text":" "},{"type":"text","text":"every mutation itself (that is where its rules are), and its non-requirement members."}]}}}