/graphprotocols","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/GraphDelegator":{"type":"topic","url":"\/documentation\/graphprotocols\/graphdelegator","navigatorTitle":[{"text":"GraphDelegator","kind":"identifier"}],"abstract":[{"type":"text","text":"A wrapper that owns its base, keeps the base’s vertices, edges and positions, and adds only"},{"type":"text","text":" "},{"type":"text","text":"rules: JGraphT’s "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":". Every read requirement of "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":", "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":", "},{"type":"codeVoice","code":"SparselyIndexedDirectedGraph"},{"type":"text","text":" and "},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":" has a default"},{"type":"text","text":" "},{"type":"text","text":"that forwards to the base, "},{"type":"codeVoice","code":"@inlinable"},{"type":"text","text":" and with the base’s own types, so algorithms run at the"},{"type":"text","text":" "},{"type":"text","text":"base’s speed and data kept by position stays valid through the wrapper. The wrapper implements"},{"type":"text","text":" "},{"type":"text","text":"every mutation itself (that is where its rules are), and its non-requirement members."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphDelegator","title":"GraphDelegator","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphDelegator","kind":"identifier"}],"kind":"symbol","role":"symbol"}}}