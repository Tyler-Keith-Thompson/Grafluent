p"},{"type":"text","text":"),"},{"type":"text","text":" "},{"text":"returned by ","type":"text"},{"code":"PropertyGraph.addEdgeMap(default:)","type":"codeVoice"},{"text":". It holds no values: read and write them","type":"text"},{"text":" ","type":"text"},{"text":"through the graph, ","type":"text"},{"code":"graph[handle, ofEdgeAt: position]","type":"codeVoice"},{"text":". It is valid on the graph that added it","type":"text"},{"text":" ","type":"text"},{"text":"and on every copy of that graph, until ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":"; on another graph it traps.","type":"text"}],"url":"\/documentation\/graphprotocols\/edgemap","role":"symbol","title":"EdgeMap","type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph/EdgePosition":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The position that names an edge: "},{"code":"Edges.Index","type":"codeVoice"},{"type":"text","text":" of a graph, a hyperedge’s position of a"},{"type":"text","text":" "},{"type":"text","text":"hypergraph."}],"required":true,"url":"\/documentation\/graphprotocols\/propertygraph\/edgeposition","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"text":"EdgePosition","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"title":"EdgePosition","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition"}}}