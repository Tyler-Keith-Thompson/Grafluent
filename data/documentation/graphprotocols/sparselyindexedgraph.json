them only while it has no holes of that kind."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Algorithms over the incidence rows use this refinement to number the live vertices and edges"},{"type":"text","text":" "},{"type":"text","text":"with arrays while holes exist, instead of hashing every vertex and edge they meet. The bounds"},{"type":"text","text":" "},{"type":"text","text":"are upper bounds only. Positions are never reused, so a bound counts every position ever handed"},{"type":"text","text":" "},{"type":"text","text":"out, and nothing in the library allocates by it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":"’s laws:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":". "},{"type":"codeVoice","code":"vertexPosition(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vertex(atPosition:)"},{"type":"text","text":" are inverses, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists the live vertices in increasing position. Likewise"},{"type":"text","text":" "},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"type":"text","text":" is true exactly for the positions in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", which "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists in increasing order."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_numberedIncidenceRows()"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"the live edges "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, and lists, for each vertex number, the"},{"type":"text","text":" "},{"type":"text","text":"numbers of the far ends of its edge ends with the edge numbers beside them, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":" order (a self-loop twice)."}],"type":"paragraph"}]}]}]}],"variants":[{"paths":["\/documentation\/graphprotocols\/sparselyindexedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:14GraphProtocols015SparselyIndexedA0P","remoteSource":{"fileName":"SparselyIndexedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/SparselyIndexedGraph.swift#L25"},"roleHeading":"Protocol","title":"SparselyIndexedGraph","modules":[{"name":"GraphProtocols"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedGraph"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SparselyIndexedGraph"}],"symbolKind":"protocol"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"abstract":[{"type":"text","text":"An undirected graph whose vertices and edges sit at integer positions in"},{"type":"text","text":" "},{"type":"codeVoice