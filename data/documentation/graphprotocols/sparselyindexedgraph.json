eVoice"},{"type":"text","text":" and "},{"code":"edgeIndexBound","type":"codeVoice"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_numberedIncidenceRows()"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"the live edges "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, and lists, for each vertex number, the"},{"type":"text","text":" "},{"type":"text","text":"numbers of the far ends of its edge ends with the edge numbers beside them, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":" order (a self-loop twice)."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"SparselyIndexedGraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparselyIndexedGraph","kind":"identifier"}],"role":"symbol","title":"SparselyIndexedGraph","symbolKind":"protocol","externalID":"s:14GraphProtocols015SparselyIndexedA0P","roleHeading":"Protocol","remoteSource":{"fileName":"SparselyIndexedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/SparselyIndexedGraph.swift#L25"},"modules":[{"name":"GraphProtocols"}]},"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedGraph\/edgePositionBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedGraph\/vertexPositionBound"],"generated":true},{"anchor":"Instance-Methods","title":"