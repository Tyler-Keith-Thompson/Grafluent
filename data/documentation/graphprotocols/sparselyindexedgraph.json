s. A conformer reports them only while it has no holes of that kind."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Algorithms over the incidence rows use this refinement to number the live vertices and edges"},{"type":"text","text":" "},{"type":"text","text":"with arrays while holes exist, instead of hashing every vertex and edge they meet. The bounds"},{"type":"text","text":" "},{"type":"text","text":"are upper bounds only. Positions are never reused, so a bound counts every position ever handed"},{"type":"text","text":" "},{"type":"text","text":"out, and nothing in the library allocates by it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":"’s laws:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"text":" is true exactly for the positions of live vertices, all in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":". ","type":"text"},{"type":"codeVoice","code":"vertexPosition(of:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"vertex(atPosition:)"},{"text":" are inverses, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" lists the live vertices in increasing position. Likewise","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"text":" is true exactly for the positions in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", all in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":", which ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists in increasing order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_numberedIncidenceRows()"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"the live edges "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, and lists, for each vertex number, the"},{"type":"text","text":" "},{"type":"text","text":"numbers of the far ends of its edge ends with the edge numbers beside them, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":" order (a self-loop twice)."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/graphprotocols\/sparselyindexedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedGraph/vertex(atPosition:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The vertex at "},{"type":"codeVoice","code":"position"},{"type":"text","text":". O(1)."}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedGraph\/vertex(atPosition:)","title":"vertex(atPosition:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertex"},{"kind":"text","text":"("},{"kind":"externalParam","text":"atPosition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphP