{"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"]}],"metadata":{"roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"SparselyIndexedGraph"}],"symbolKind":"protocol","remoteSource":{"fileName":"SparselyIndexedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/SparselyIndexedGraph.swift#L25"},"modules":[{"name":"GraphProtocols"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedGraph"}],"title":"SparselyIndexedGraph","externalID":"s:14GraphProtocols015SparselyIndexedA0P","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","text":"Graph"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" describe dense indices with no holes and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws. A conformer reports them only while it has no holes of that kind."}]},{"type":"paragraph","inlineContent":[{"text":"Algorithms over the incidence rows use this refinement to number the live vertices and edges","type":"text"},{"text":" ","type":"text"},{"text":"with arrays while holes exist, instead of hashing every vertex and edge they meet. The bounds","type":"text"},{"text":" ","type":"text"},{"text":"are upper bounds only. Positions are never reused, so a bound counts every position ever handed","type":"text"},{"text":" ","type":"text"},{"text":"out, and nothing in the library allocates by it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s laws:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"text":" is true exactly for the positions of live vertices, all in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"text":". ","type":"text"},{"type":"codeVoice","code":"vertexPosition(of:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"vertex(atPosition:)"},{"text":" are inverses, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" lists the live vertices in increasing position. Likewise","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"text":" is true exactly for the positions in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", all in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<edgePositionBound"},{"text":", which ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" lists in increasing order.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"_numberedIncidenceRows()"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"the live edges "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, and lists, for each vertex number, the"},{"type":"text","text":" "},{"type":"text","text":"numbers of the far ends of its edge ends with the edge numbers beside them, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":" order (a self-loop twice)."}]}]}]}]}],"abstract":[{"type":"text","text":"An undirected graph whose vertices and edges sit at integer positions in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", with possible holes: the undirected"},{"type":"text","text":" "},{"type":"text","text":"counterpart of "},{"type":"codeVoice","code":"SparselyIndexedDirectedGraph"},{"type":"text","te