hProtocols\/SparselyIndexedGraph"},"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedGraph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":"> : "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"typeIdentifier","text":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":" == "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" describe dense indices with no holes and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws. A conformer reports them only while it has no holes of that kind."}],"type":"paragraph"},{"inlineContent":[{"text":"Algorithms over the incidence rows use this refinement to number the live vertices and edges","type":"text"},{"text":" ","type":"text"},{"text":"with arrays while holes exist, instead of hashing every vertex and edge they meet. The bounds","type":"text"},{"text":" ","type":"text"},{"text":"are upper bounds only. Positions are never reused, so a bound counts every position ever handed","type":"text"},{"text":" ","type":"text"},{"text":"out, and nothing in the library allocates by it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In addition to "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s laws:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"containsVertex(atPosition: p)"},{"type":"text","text":" is true exactly for the positions of live vertices, all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":". "},{"type":"codeVoice","code":"vertexPosition(of:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vertex(atPosition:)"},{"type":"text","text":" are inverses, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" lists the live vertices in increasing position. Likewise"},{"type":"text","text":" "},{"type":"codeVoice","code":"containsEdge(atPosition:)"},{"type":"text","text":" is true exactly for the positions in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", all in"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":", which "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" lists in increasing order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Without holes, the bounds equal "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and positions are"},{"type":"text","text":" "},{"type":"text","text":"indices."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"_numberedIncidenceRows()"},{"type":"text","text":" numbers the live vertices "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order and"},{"type":"text","text":" "},{"type":"text","text":"the live edges "},{"type":"codeVoice","code":"0..<edgeCount"},{"type":"text","text":" in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order, and lists, for each vertex number, the"},{"type":"text","text":" "},{"type":"text","text":"numbers of the far ends of its edge ends with the edge numbers beside them, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges(of:)"},{"type":"text","text":" order (a self-loop twice)."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/sparselyindexedgraph"]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Sl","kind":"typeIdentifier","text":"Collection"}],"title":"Edges","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","required":true,"type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedGraph/edgePositionBound":{"url":"\/documentation\/graphprotocols\/sparselyindexedgraph\/edgepositionbound","kind":"symbol","title":"edgePositionBound","required":true,"type":"topic","identifi