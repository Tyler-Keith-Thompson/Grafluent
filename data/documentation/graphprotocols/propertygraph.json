texMap"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"checked"},{"kind":"text","text":" _: "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"}],"type":"topic","required":true,"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)"},"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph/values(of:)-89n40":{"title":"values(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"values"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14GraphProtocols7EdgeMapV","kind":"typeIdentifier","text":"EdgeMap"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:14GraphProtocols10EdgeValuesV","kind":"typeIdentifier","text":"EdgeValues"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">"}],"url":"\/documentation\/graphprotocols\/propertygraph\/values(of:)-89n40","required":true,"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A snapshot of "},{"code":"map","type":"codeVoice"},{"type":"text","text":"’s values, read by edge position. O(1)."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph/removeEdgeMap(_:)":{"url":"\/documentation\/graphprotocols\/propertygraph\/removeedgemap(_:)","role":"symbol","identifier":"do