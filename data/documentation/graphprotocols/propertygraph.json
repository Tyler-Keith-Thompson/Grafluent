{"topicSections":[{"generated":true,"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"],"anchor":"Associated-Types"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"],"anchor":"Instance-Methods"},{"generated":true,"title":"Subscripts","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"],"anchor":"Subscripts"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/propertygraph"]}],"abstract":[{"text":"A graph that keeps maps from its vertices and edges to values.","type":"text"}],"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The graph owns the values and keeps every attached map in step with its mutations. The caller"},{"type":"text","text":" "},{"type":"text","text":"holds a small handle, "},{"type":"codeVoice","code":"VertexMap<Value>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeMap<Value>"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Each map has a default value, which every element has until it is given another, so a new","type":"text"},{"text":" ","type":"text"},{"text":"element needs no write. ","type":"text"},{"code":"addEdgeMap(default: 1.0)","type":"codeVoice"},{"text":" is a map of weights that are all 1.","type":"text"},{"text":" ","type":"text"},{"code":"addEdgeMap(of: T.self)","type":"codeVoice"},{"text":" is a map of ","type":"text"},{"code":"T?","type":"codeVoice"},{"text":" whose default is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every mutation updates every attached map in the same call. A removed element’s value goes with"},{"type":"text","text":" "},{"type":"text","text":"it, and a representation that moves another element into the hole (a swap-remove) moves that"},{"type":"text","text":" "},{"type":"text","text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value"},{"type":"text","text":" "},{"type":"text","text":"of a removed element traps. The "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" subscripts throw "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeNotFound"},{"type":"text","text":" "},{"type":"text","text":"instead. "},{"type":"codeVoice","code":"removeAll"},{"type":"text","text":" empties every map and keeps it attached, and "},{"type":"codeVoice","code":"removeAllEdges"},{"type":"text","text":" empties the"},{"type":"text","text":" "},{"type":"text","text":"edge maps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A handle is valid on the graph that attached it and on every copy, until "},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":". Using it on any other graph traps. It also works through a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":" of that graph, which reads the base’s values, and through a "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which reads and writes them. Writing a map value is not a structural mutation and does not"},{"type":"text","text":" "},{"type":"text","text":"advance "},{"type":"codeVoice","code":"generation"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a","type":"text"},{"text":" ","type":"text"},{"text":"copy copies the map’s storage: a dense map all at once, like an ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":", and a paged map a page","type":"text"},{"text":" ","type":"text"},{"text":"at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality, hashing, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none. To"},{"type":"text","text":" "},{"type":"text","text":"keep a graph and its maps together as one value, equal when the values are and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the maps reattached by decoding, use "},{"type":"codeVoice","code":"PropertyGraphBundle"},{"type":"text","text":". A snapshot ("},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":") is a"},{"type":"text","text":" "},{"type":"text","text":"value of its own, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" when its values are, and "},{"type":"codeVoice","code":"addEdgeMap(values:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"addVertexMap(values:)"},{"type":"text","text":" attaches one as a new map."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" returns a snapshot of a map that reads as fast as an array. Pass "},{"type":"codeVoice","code":"{ w[$0] }"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"an algorithm asks for a weight closure:"}],"type":"paragraph"},{"type":"codeListing","code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,"},{"type":"text","text":" "},{"type":"text","text":"either the default or the value the element had. Algorithms read only the values of live"},{"type":"text","text":" "},{"type":"text","text":"elements, so each read stays one load."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L47","fileName":"PropertyGraph.swift"},"roleHeading":"Protocol","symbolKind":"protocol","navigatorTitle":[{"text":"PropertyGraph","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"}],"externalID":"s:14GraphProtocols08PropertyA0P","modules":[{"name":"GraphProtocols"}],"title":"PropertyGraph","role":"symbol"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph/subscript(_:ofEdgeAt:)":{"type":"topic","title":"subscript(_:ofEdgeAt:)","required":true,"kind":"symbol","abstract":[{"text":"The value of the edge at ","type":"text"},{"type":"codeVoice","code":"position"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"map"},{"text":".","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","url":"\/documentation\/graphprotocols\/propertygraph\/subscript(_:ofedgeat:)","fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols7EdgeMapV","text":"EdgeMap"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"ofEdgeAt"},{"k