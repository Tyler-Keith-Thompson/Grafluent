{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L43","fileName":"PropertyGraph.swift"},"modules":[{"name":"GraphProtocols"}],"title":"PropertyGraph","externalID":"s:14GraphProtocols08PropertyA0P","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"}],"symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}],"roleHeading":"Protocol"},"abstract":[{"type":"text","text":"A graph that keeps maps from its vertices and edges to values."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The graph owns the values and keeps every attached map in step with its mutations. The caller"},{"type":"text","text":" "},{"type":"text","text":"holds a small handle, "},{"code":"VertexMap<Value>","type":"codeVoice"},{"type":"text","text":" or "},{"code":"EdgeMap<Value>","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each map has a default value, which every element has until it is given another, so a new"},{"type":"text","text":" "},{"type":"text","text":"element needs no write. "},{"code":"addEdgeMap(default: 1.0)","type":"codeVoice"},{"type":"text","text":" is a map of weights that are all 1."},{"type":"text","text":" "},{"code":"addEdgeMap(of: T.self)","type":"codeVoice"},{"type":"text","text":" is a map of "},{"code":"T?","type":"codeVoice"},{"type":"text","text":" whose default is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every mutation updates every attached map in the same call. A removed element’s value goes with"},{"type":"text","text":" "},{"type":"text","text":"it, and a representation that moves another element into the hole (a swap-remove) moves that"},{"type":"text","text":" "},{"type":"text","text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value"},{"type":"text","text":" "},{"type":"text","text":"of a removed element traps. The "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" subscripts throw "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeNotFound"},{"type":"text","text":" "},{"type":"text","text":"instead. "},{"type":"codeVoice","code":"removeAll"},{"type":"text","text":" empties every map and keeps it attached, and "},{"type":"codeVoice","code":"removeAllEdges"},{"type":"text","text":" empties the"},{"type":"text","text":" "},{"type":"text","text":"edge maps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A handle is valid on the graph that attached it and on every copy, until "},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":". Using it on any other graph traps. It also works through a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":" of that graph, which reads the base’s values, and through a "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which reads and writes them. Writing a map value is not a structural mutation and does not"},{"type":"text","text":" "},{"type":"text","text":"advance "},{"type":"codeVoice","code":"generation"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a"},{"type":"text","text":" "},{"type":"text","text":"copy copies the map’s storage: a dense map all at once, like an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", and a paged map a page"},{"type":"text","text":" "},{"type":"text","text":"at a time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality, hashing, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" returns a snapshot of a map that reads as fast as an array. Pass "},{"type":"codeVoice","code":"{ w[$0] }"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"an algorithm asks for a weight closure:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"]},{"inlineContent":[{"text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,","type":"text"},{"text":" ","type":"text"},{"text":"either the default or the value the element had. Algorithms read only the values of live","type":"text"},{"text":" ","type":"text"},{"text":"elements, so each read stays one load.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"topicSections":[{"anchor":"Associated-Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"],"title":"Associated Types","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"],"title":"Instance Methods","generated":true},{"anchor":"Subscripts","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"],"title":"Subscripts","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/propertygraph"