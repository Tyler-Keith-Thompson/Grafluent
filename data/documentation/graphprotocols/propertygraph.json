{"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The graph owns the values and keeps every attached map in step with its mutations. The caller","type":"text"},{"text":" ","type":"text"},{"text":"holds a small handle, ","type":"text"},{"code":"VertexMap<Value>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EdgeMap<Value>","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each map has a default value, which every element has until it is given another, so a new","type":"text"},{"text":" ","type":"text"},{"text":"element needs no write. ","type":"text"},{"code":"addEdgeMap(default: 1.0)","type":"codeVoice"},{"text":" is a map of weights that are all 1.","type":"text"},{"text":" ","type":"text"},{"code":"addEdgeMap(of: T.self)","type":"codeVoice"},{"text":" is a map of ","type":"text"},{"code":"T?","type":"codeVoice"},{"text":" whose default is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every mutation updates every attached map in the same call. A removed element’s value goes with","type":"text"},{"text":" ","type":"text"},{"text":"it, and a representation that moves another element into the hole (a swap-remove) moves that","type":"text"},{"text":" ","type":"text"},{"text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value","type":"text"},{"text":" ","type":"text"},{"text":"of a removed element traps. The ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" subscripts throw ","type":"text"},{"code":"VertexNotFound","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EdgeNotFound","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instead. ","type":"text"},{"code":"removeAll","type":"codeVoice"},{"text":" empties every map and keeps it attached, and ","type":"text"},{"code":"removeAllEdges","type":"codeVoice"},{"text":" empties the","type":"text"},{"text":" ","type":"text"},{"text":"edge maps.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A handle is valid on the graph that attached it and on every copy, until ","type":"text"},{"code":"removeVertexMap(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":". Using it on any other graph traps. It also works through a","type":"text"},{"text":" ","type":"text"},{"code":"GraphAdaptor","type":"codeVoice"},{"text":" of that graph, which reads the base’s values, and through a ","type":"text"},{"code":"GraphDelegator","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which reads and writes them. Writing a map value is not a structural mutation and does not","type":"text"},{"text":" ","type":"text"},{"text":"advance ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a","type":"text"},{"text":" ","type":"text"},{"text":"copy copies the map’s storage: a dense map all at once, like an ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":", and a paged map a page","type":"text"},{"text":" ","type":"text"},{"text":"at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality, hashing, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none. To"},{"type":"text","text":" "},{"type":"text","text":"keep a graph and its maps together as one value, equal when the values are and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the maps reattached by decoding, use "},{"type":"codeVoice","code":"PropertyGraphBundle"},{"type":"text","text":". A snapshot ("},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":") is a"},{"type":"text","text":" "},{"type":"text","text":"value of its own, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" when its values are, and "},{"type":"codeVoice","code":"addEdgeMap(values:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"addVertexMap(values:)"},{"type":"text","text":" attaches one as a new map."}],"type":"paragraph"},{"inlineContent":[{"code":"values(of:)","type":"codeVoice"},{"text":" returns a snapshot of a map that reads as fast as an array. Pass ","type":"text"},{"code":"{ w[$0] }","type":"codeVoice"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"an algorithm asks for a weight closure:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"]},{"inlineContent":[{"text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,","type":"text"},{"text":" ","type":"text"},{"text":"either the default or the value the element had. Algorithms read only the values of live","type":"text"},{"text":" ","type":"text"},{"text":"elements, so each read stays one load.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/graphprotocols\/propertygraph"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph"},"metadata":{"externalID":"s:14GraphProtocols08PropertyA0P","navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}],"title":"PropertyGraph","modules":[{"name":"GraphProtocols"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L47","fileName":"PropertyGraph.swift"},"roleHeading":"Protocol","symbolKind":"protocol"},"kind":"symbol","abstract":[{"type":"text","text":"A graph that keeps maps from its vertices and edges to values."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"topicSections":[{"generated":true,"title":"Associated Types","anchor":"Associated-Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Property