{"sections":[],"topicSections":[{"generated":true,"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"],"anchor":"Associated-Types"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"],"anchor":"Instance-Methods"},{"generated":true,"title":"Subscripts","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"],"anchor":"Subscripts"}],"abstract":[{"text":"A graph that keeps maps from its vertices and edges to values.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The graph owns the values and keeps every attached map in step with its mutations. The caller","type":"text"},{"text":" ","type":"text"},{"text":"holds a small handle, ","type":"text"},{"code":"VertexMap<Value>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EdgeMap<Value>","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each map has a default value, which every element has until it is given another, so a new"},{"type":"text","text":" "},{"type":"text","text":"element needs no write. "},{"type":"codeVoice","code":"addEdgeMap(default: 1.0)"},{"type":"text","text":" is a map of weights that are all 1."},{"type":"text","text":" "},{"type":"codeVoice","code":"addEdgeMap(of: T.self)"},{"type":"text","text":" is a map of "},{"type":"codeVoice","code":"T?"},{"type":"text","text":" whose default is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every mutation updates every attached map in the same call. A removed element’s value goes with"},{"type":"text","text":" "},{"type":"text","text":"it, and a representation that moves another element into the hole (a swap-remove) moves that"},{"type":"text","text":" "},{"type":"text","text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value"},{"type":"text","text":" "},{"type":"text","text":"of a removed element traps. The "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" subscripts throw "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeNotFound"},{"type":"text","text":" "},{"type":"text","text":"instead. "},{"type":"codeVoice","code":"removeAll"},{"type":"text","text":" empties every map and keeps it attached, and "},{"type":"codeVoice","code":"removeAllEdges"},{"type":"text","text":" empties the"},{"type":"text","text":" "},{"type":"text","text":"edge maps."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A handle is valid on the graph that attached it and on every copy, until "},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":". Using it on any other graph traps. It also works through a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":" of that graph, which reads the base’s values, and through a "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which reads and writes them. Writing a map value is not a structural mutation and does not"},{"type":"text","text":" "},{"type":"text","text":"advance "},{"type":"codeVoice","code":"generation"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a"},{"type":"text","text":" "},{"type":"text","text":"copy copies the map’s storage: a dense map all at once, like an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", and a paged map a page"},{"type":"text","text":" "},{"type":"text","text":"at a time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Equality, hashing, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none. To"},{"type":"text","text":" "},{"type":"text","text":"keep a graph and its maps together as one value, equal when the values are and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the maps reattached by decoding, use "},{"type":"codeVoice","code":"PropertyGraphBundle"},{"type":"text","text":". A snapshot ("},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":") is a"},{"type":"text","text":" "},{"type":"text","text":"value of its own, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" when its values are, and "},{"type":"codeVoice","code":"addEdgeMap(values:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"addVertexMap(values:)"},{"type":"text","text":" attaches one as a new map."}]},{"type":"paragraph","inlineContent":[{"code":"values(of:)","type":"codeVoice"},{"type":"text","text":" returns a snapshot of a map that reads as fast as an array. Pass "},{"code":"{ w[$0] }","type":"codeVoice"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"an algorithm asks for a weight closure:"}]},{"code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,"},{"type":"text","text":" "},{"type":"text","text":"either the default or the value the element had. Algorithms read only the values of live"},{"type":"text","text":" "},{"type":"text","text":"elements, so each read stays one load."}]}]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Protocol","navigatorTitle":[{"text":"PropertyGraph","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L47","fileName":"PropertyGraph.swift"},"modules":[{"name":"GraphProtocols"}],"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"}],"title":"PropertyGraph","externalID":"s:14GraphProtocols08PropertyA0P","role":"symbol"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"variants":[{"paths":["\/documentation\/graphprotocols\/propertygraph"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph/values(of:)-2ufmp":{"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","title":"values(of:)","abstract":[{"type":"text","text":"A snapshot of "},{"type":"codeVoice","code":"map"},{"type":"text","text":"’s values, read by vertex position. O(1)."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"values"},{"kind":"text","text":"<"},{"text":"Value","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"VertexMap","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols9VertexMapV"},{"text":"<","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"VertexValues","preciseIdentifier":"s