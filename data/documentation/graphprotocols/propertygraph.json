{"abstract":[{"text":"A graph that keeps maps from its vertices and edges to values.","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"PropertyGraph","modules":[{"name":"GraphProtocols"}],"navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L43","fileName":"PropertyGraph.swift"},"symbolKind":"protocol","externalID":"s:14GraphProtocols08PropertyA0P","roleHeading":"Protocol","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/propertygraph"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The graph owns the values and keeps every attached map in step with its mutations. The caller"},{"type":"text","text":" "},{"type":"text","text":"holds a small handle, "},{"code":"VertexMap<Value>","type":"codeVoice"},{"type":"text","text":" or "},{"code":"EdgeMap<Value>","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Each map has a default value, which every element has until it is given another, so a new","type":"text"},{"text":" ","type":"text"},{"text":"element needs no write. ","type":"text"},{"code":"addEdgeMap(default: 1.0)","type":"codeVoice"},{"text":" is a map of weights that are all 1.","type":"text"},{"text":" ","type":"text"},{"code":"addEdgeMap(of: T.self)","type":"codeVoice"},{"text":" is a map of ","type":"text"},{"code":"T?","type":"codeVoice"},{"text":" whose default is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every mutation updates every attached map in the same call. A removed element’s value goes with","type":"text"},{"text":" ","type":"text"},{"text":"it, and a representation that moves another element into the hole (a swap-remove) moves that","type":"text"},{"text":" ","type":"text"},{"text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value","type":"text"},{"text":" ","type":"text"},{"text":"of a removed element traps. The ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" subscripts throw ","type":"text"},{"code":"VertexNotFound","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EdgeNotFound","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instead. ","type":"text"},{"code":"removeAll","type":"codeVoice"},{"text":" empties every map and keeps it attached, and ","type":"text"},{"code":"removeAllEdges","type":"codeVoice"},{"text":" empties the","type":"text"},{"text":" ","type":"text"},{"text":"edge maps.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A handle is valid on the graph that attached it and on every copy, until ","type":"text"},{"code":"removeVertexMap(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"code":"removeEdgeMap(_:)","type":"codeVoice"},{"text":". Using it on any other graph traps. It also works through a","type":"text"},{"text":" ","type":"text"},{"code":"GraphAdaptor","type":"codeVoice"},{"text":" of that graph, which reads the base’s values, and through a ","type":"text"},{"code":"GraphDelegator","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which reads and writes them. Writing a map value is not a structural mutation and does not","type":"text"},{"text":" ","type":"text"},{"text":"advance ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a"},{"type":"text","text":" "},{"type":"text","text":"copy copies the map’s storage: a dense map all at once, like an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", and a paged map a page"},{"type":"text","text":" "},{"type":"text","text":"at a time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Equality, hashing, "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none."}]},{"type":"paragraph","inlineContent":[{"code":"values(of:)","type":"codeVoice"},{"text":" returns a snapshot of a map that reads as fast as an array. Pass ","type":"text"},{"code":"{ w[$0] }","type":"codeVoice"},{"text":" where","type":"text"},{"text":" ","type":"text"},{"text":"an algorithm asks for a weight closure:","type":"text"}]},{"code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,","type":"text"},{"text":" ","type":"text"},{"text":"either the default or the value the element had. Algorithms read only the values of live","type":"text"},{"text":" ","type":"text"},{"text":"elements, so each read stays one load.","type":"text"}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"],"generated":true,"anchor":"Associated-Types","title":"Associated Types"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"],"generated":true,"anchor":"S