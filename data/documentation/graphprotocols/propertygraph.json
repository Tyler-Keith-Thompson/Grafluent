{"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"}],"externalID":"s:14GraphProtocols08PropertyA0P","navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}],"modules":[{"name":"GraphProtocols"}],"role":"symbol","title":"PropertyGraph","symbolKind":"protocol","remoteSource":{"fileName":"PropertyGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L43"}},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/propertygraph"]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Associated-Types","title":"Associated Types","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"]},{"anchor":"Subscripts","title":"Subscripts","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A graph that keeps maps from its vertices and edges to values: the BGL "},{"type":"emphasis","inlineContent":[{"type":"text","text":"PropertyGraph"}]},{"type":"text","text":" "},{"type":"text","text":"concept (“a graph that has some property associated with each vertex or edge”), with LEMON’s"},{"type":"text","text":" "},{"code":"NodeMap","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ArcMap","type":"codeVoice"},{"type":"text","text":" attached to the graph and kept in step by it. The graph owns the values"},{"type":"text","text":" "},{"type":"text","text":"and the caller holds a small handle, "},{"code":"VertexMap<Value>","type":"codeVoice"},{"type":"text","text":" or "},{"code":"EdgeMap<Value>","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Values are total."}],"type":"strong"},{"text":" Each map has a default value, which every element has until it is given","type":"text"},{"text":" ","type":"text"},{"text":"another, so a new element needs no write: ","type":"text"},{"type":"codeVoice","code":"addEdgeMap(default: 1.0)"},{"text":" is a map of weights that","type":"text"},{"text":" ","type":"text"},{"text":"are all 1. ","type":"text"},{"type":"codeVoice","code":"addEdgeMap(of: T.self)"},{"text":" is the map of ","type":"text"},{"type":"codeVoice","code":"T?"},{"text":" whose default is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Removal."}],"type":"strong"},{"text":" Every mutation keeps every attached map in step, in the same call: a removed","type":"text"},{"text":" ","type":"text"},{"text":"element’s value goes with it, and a representation that moves another element into the hole","type":"text"},{"text":" ","type":"text"},{"text":"(a swap-remove) moves its values too. Removing a vertex removes its edges’ values. A removed","type":"text"},{"text":" ","type":"text"},{"text":"element has no value: reading or writing it traps, and the ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" subscripts throw","type":"text"},{"text":" ","type":"text"},{"code":"VertexNotFound","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EdgeNotFound","type":"codeVoice"},{"text":" instead. ","type":"text"},{"code":"removeAll","type":"codeVoice"},{"text":" empties every map and keeps it","type":"text"},{"text":" ","type":"text"},{"text":"attached; ","type":"text"},{"code":"removeAllEdges","type":"codeVoice"},{"text":" empties the edge maps.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Handles."}],"type":"strong"},{"type":"text","text":" A handle is valid on the graph that attached it and on every copy, until"},{"type":"text","text":" "},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":"; on any other graph it traps. It also works"},{"type":"text","text":" "},{"type":"text","text":"through a "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":" of that graph (a view reads the base’s values) and through a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":" (which reads and writes them). Map writes are not structural mutations: they"},{"type":"text","text":" "},{"type":"text","text":"do not advance "},{"type":"codeVoice","code":"generation"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Copies.","type":"text"}]},{"type":"text","text":" A copy shares every map, and the first write to a map or structural mutation of a"},{"type":"text","text":" "},{"type":"text","text":"copy copies the map’s storage lazily: a dense map on its first write, like an "},{"code":"Array","type":"codeVoice"},{"type":"text","text":", a paged"},{"type":"text","text":" "},{"type":"text","text":"map a page at a time."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Equality, hashing, "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" and descriptions ignore maps"}],"type":"strong"},{"text":": equal graphs may carry different","type":"text"},{"text":" ","type":"text"},{"text":"maps, a decoded graph has none, and a conversion to another representation carries none.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reading many values."}],"type":"strong"},{"text":" ","type":"text"},{"code":"values(of:)","type":"codeVoice"},{"text":" is a snapshot of a map, as fast to read as an array:","type":"text"},{"text":" ","type":"text"},{"text":"pass ","type":"text"},{"code":"{ w[$0] }","type":"codeVoice"},{"text":" where an algorithm asks for a weight closure,","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"]},{"inlineContent":[{"text":"The snapshot does not check liveness: at a removed position it reads an unspecified value","type":"text"},{"text":" ","type":"text"},{"text":"(the default, or the value the element had). Algorithms only ask for the values of the live","type":"text"},{"text":" ","type":"text"},{"text":"elements they walk, so the read stays one load.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph/subscript(_:ofVertexAt:)":{"title":"subscript(_:ofVertexAt:)","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)","url":"\/documentation\/graphprotocols\/propertygraph\/subscript(_:ofvertexat:)","type":"topic","required":true,"role":"symbol","fragments":[{"text":"subscript","kind":"keyword"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"preciseIdentifier":"s:14GraphProtocols9VertexMapV","kind":"typeIdentifier","text":"VertexMap"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"ofVertexAt"},{"kind":"text","text":" _: "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"}],"abstract":[{"text":"The value of the vertex at ","type":"text"},{"code":"position","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"map","type":"codeVoice"},{"text":".","type":"text"}]},"doc://GraphProto