{"topicSections":[{"title":"Associated Types","anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"]},{"title":"Subscripts","anchor":"Subscripts","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Values are total."}],"type":"strong"},{"text":" Each map has a default value, which every element has until it is given","type":"text"},{"text":" ","type":"text"},{"text":"another, so a new element needs no write: ","type":"text"},{"type":"codeVoice","code":"addEdgeMap(default: 1.0)"},{"text":" is a map of weights that","type":"text"},{"text":" ","type":"text"},{"text":"are all 1. ","type":"text"},{"type":"codeVoice","code":"addEdgeMap(of: T.self)"},{"text":" is the map of ","type":"text"},{"type":"codeVoice","code":"T?"},{"text":" whose default is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Removal."}]},{"type":"text","text":" Every mutation keeps every attached map in step, in the same call: a removed"},{"type":"text","text":" "},{"type":"text","text":"element’s value goes with it, and a representation that moves another element into the hole"},{"type":"text","text":" "},{"type":"text","text":"(a swap-remove) moves its values too. Removing a vertex removes its edges’ values. A removed"},{"type":"text","text":" "},{"type":"text","text":"element has no value: reading or writing it traps, and the "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" subscripts throw"},{"type":"text","text":" "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeNotFound"},{"type":"text","text":" instead. "},{"type":"codeVoice","code":"removeAll"},{"type":"text","text":" empties every map and keeps it"},{"type":"text","text":" "},{"type":"text","text":"attached; "},{"type":"codeVoice","code":"removeAllEdges"},{"type":"text","text":" empties the edge maps."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Handles.","type":"text"}],"type":"strong"},{"type":"text","text":" A handle is valid on the graph that attached it and on every copy, until"},{"type":"text","text":" "},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":"; on any other graph it traps. It also works"},{"type":"text","text":" "},{"type":"text","text":"through a "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":" of that graph (a view reads the base’s values) and through a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":" (which reads and writes them). Map writes are not structural mutations: they"},{"type":"text","text":" "},{"type":"text","text":"do not advance "},{"type":"codeVoice","code":"generation"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Copies."}],"type":"strong"},{"text":" A copy shares every map, and the first write to a map or structural mutation of a","type":"text"},{"text":" ","type":"text"},{"text":"copy copies the map’s storage lazily: a dense map on its first write, like an ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":", a paged","type":"text"},{"text":" ","type":"text"},{"text":"map a page at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Equality, hashing, "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" and descriptions ignore maps"}]},{"text":": equal graphs may carry different","type":"text"},{"text":" ","type":"text"},{"text":"maps, a decoded graph has none, and a conversion to another representation carries none.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reading many values.","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" is a snapshot of a map, as fast to read as an array:"},{"type":"text","text":" "},{"type":"text","text":"pass "},{"type":"codeVoice","code":"{ w[$0] }"},{"type":"text","text":" where an algorithm asks for a weight closure,"}],"type":"paragraph"},{"code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The snapshot does not check liveness: at a removed position it reads an unspecified value"},{"type":"text","text":" "},{"type":"text","text":"(the default, or the value the element had). Algorithms only ask for the values of the live"},{"type":"text","text":" "},{"type":"text","text":"elements they walk, so the read stays one load."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"role":"symbol","externalID":"s:14GraphProtocols08PropertyA0P","roleHeading":"Protocol","title":"PropertyGraph","symbolKind":"protocol","remoteSource":{"fileName":"PropertyGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L43"},"modules":[{"name":"GraphProtocols"}],"navigatorTitle":[{"text":"PropertyGraph","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"PropertyGraph","kind":"identifier"}]},"abstract":[{"text":"A graph that keeps maps from its vertices and edges to values: the BGL ","type":"text"},{"inlineContent":[{"type":"text","text":"PropertyGraph"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"concept (“a graph that has some property associated with ea