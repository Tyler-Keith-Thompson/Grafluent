{"metadata":{"remoteSource":{"fileName":"PropertyGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L43"},"externalID":"s:14GraphProtocols08PropertyA0P","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"}],"modules":[{"name":"GraphProtocols"}],"title":"PropertyGraph","navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}],"role":"symbol","roleHeading":"Protocol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The graph owns the values and keeps every attached map in step with its mutations. The caller"},{"type":"text","text":" "},{"type":"text","text":"holds a small handle, "},{"type":"codeVoice","code":"VertexMap<Value>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeMap<Value>"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each map has a default value, which every element has until it is given another, so a new"},{"type":"text","text":" "},{"type":"text","text":"element needs no write. "},{"type":"codeVoice","code":"addEdgeMap(default: 1.0)"},{"type":"text","text":" is a map of weights that are all 1."},{"type":"text","text":" "},{"type":"codeVoice","code":"addEdgeMap(of: T.self)"},{"type":"text","text":" is a map of "},{"type":"codeVoice","code":"T?"},{"type":"text","text":" whose default is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every mutation updates every attached map in the same call. A removed element’s value goes with"},{"type":"text","text":" "},{"type":"text","text":"it, and a representation that moves another element into the hole (a swap-remove) moves that"},{"type":"text","text":" "},{"type":"text","text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value"},{"type":"text","text":" "},{"type":"text","text":"of a removed element traps. The "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" subscripts throw "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeNotFound"},{"type":"text","text":" "},{"type":"text","text":"instead. "},{"type":"codeVoice","code":"removeAll"},{"type":"text","text":" empties every map and keeps it attached, and "},{"type":"codeVoice","code":"removeAllEdges"},{"type":"text","text":" empties the"},{"type":"text","text":" "},{"type":"text","text":"edge maps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A handle is valid on the graph that attached it and on every copy, until "},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":". Using it on any other graph traps. It also works through a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":" of that graph, which reads the base’s values, and through a "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which reads and writes them. Writing a map value is not a structural mutation and does not"},{"type":"text","text":" "},{"type":"text","text":"advance "},{"type":"codeVoice","code":"generation"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a","type":"text"},{"text":" ","type":"text"},{"text":"copy copies the map’s storage: a dense map all at once, like an ","type":"text"},{"type":"codeVoice","code":"Array"},{"text":", and a paged map a page","type":"text"},{"text":" ","type":"text"},{"text":"at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality, hashing, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" returns a snapshot of a map that reads as fast as an array. Pass "},{"type":"codeVoice","code":"{ w[$0] }"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"an algorithm asks for a weight closure:"}],"type":"paragraph"},{"code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,"},{"type":"text","text":" "},{"type":"text","text":"either the default or the value the element had. Algorithms read only the values of live"},{"type":"text","text":" "},{"type":"text","text":"elements, so each read stays one load."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A graph that keeps maps from its vertices and edges to values."}],"variants":[{"paths":["\/documentation\/graphprotocols\/propertygraph"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Associated-Types","generated":true,"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"]},{"anchor":"Subscripts","generated":true,"title":"Subscripts","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"]}],"sections":[],"schemaVersion