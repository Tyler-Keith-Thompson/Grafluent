{"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"A graph that keeps maps from its vertices and edges to values."}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/propertygraph"]}],"topicSections":[{"generated":true,"anchor":"Associated-Types","title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"]},{"generated":true,"anchor":"Subscripts","title":"Subscripts","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:ofVertexAt:)"]}],"metadata":{"modules":[{"name":"GraphProtocols"}],"title":"PropertyGraph","navigatorTitle":[{"kind":"identifier","text":"PropertyGraph"}],"externalID":"s:14GraphProtocols08PropertyA0P","roleHeading":"Protocol","role":"symbol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/PropertyGraph.swift#L47","fileName":"PropertyGraph.swift"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PropertyGraph"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"The graph owns the values and keeps every attached map in step with its mutations. The caller","type":"text"},{"text":" ","type":"text"},{"text":"holds a small handle, ","type":"text"},{"type":"codeVoice","code":"VertexMap<Value>"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"EdgeMap<Value>"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each map has a default value, which every element has until it is given another, so a new"},{"type":"text","text":" "},{"type":"text","text":"element needs no write. "},{"code":"addEdgeMap(default: 1.0)","type":"codeVoice"},{"type":"text","text":" is a map of weights that are all 1."},{"type":"text","text":" "},{"code":"addEdgeMap(of: T.self)","type":"codeVoice"},{"type":"text","text":" is a map of "},{"code":"T?","type":"codeVoice"},{"type":"text","text":" whose default is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every mutation updates every attached map in the same call. A removed element’s value goes with"},{"type":"text","text":" "},{"type":"text","text":"it, and a representation that moves another element into the hole (a swap-remove) moves that"},{"type":"text","text":" "},{"type":"text","text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value"},{"type":"text","text":" "},{"type":"text","text":"of a removed element traps. The "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" subscripts throw "},{"type":"codeVoice","code":"VertexNotFound"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeNotFound"},{"type":"text","text":" "},{"type":"text","text":"instead. "},{"type":"codeVoice","code":"removeAll"},{"type":"text","text":" empties every map and keeps it attached, and "},{"type":"codeVoice","code":"removeAllEdges"},{"type":"text","text":" empties the"},{"type":"text","text":" "},{"type":"text","text":"edge maps."}],"type":"paragraph"},{"inlineContent":[{"text":"A handle is valid on the graph that attached it and on every copy, until ","type":"text"},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"text":". Using it on any other graph traps. It also works through a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"GraphAdaptor"},{"text":" of that graph, which reads the base’s values, and through a ","type":"text"},{"type":"codeVoice","code":"GraphDelegator"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which reads and writes them. Writing a map value is not a structural mutation and does not","type":"text"},{"text":" ","type":"text"},{"text":"advance ","type":"text"},{"type":"codeVoice","code":"generation"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a"},{"type":"text","text":" "},{"type":"text","text":"copy copies the map’s storage: a dense map all at once, like an "},{"type":"codeVoice","code":"Array"},{"type":"text","text":", and a paged map a page"},{"type":"text","text":" "},{"type":"text","text":"at a time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality, hashing, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none. To"},{"type":"text","text":" "},{"type":"text","text":"keep a graph and its maps together as one value, equal when the values are and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the maps reattached by decoding, use "},{"type":"codeVoice","code":"PropertyGraphBundle"},{"type":"text","text":". A snapshot ("},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":") is a"},{"type":"text","text":" "},{"type":"text","text":"value of its own, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" when its values are, and "},{"type":"codeVoice","code":"addEdgeMap(values:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"addVertexMap(values:)"},{"type":"text","text":" attaches one as a new map."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" returns a snapshot of a map that reads as fast as an array. Pass "},{"type":"codeVoice","code":"{ w[$0] }"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"an algorithm asks for a weight closure:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"]},{"inlineContent":[{"type":"text","text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,"},{"type":"text","text":" "},{"type":"text","text":"either the default or the value the element had. Algorithms read only the values of live"},{"type":"text","text":" "},{"type":"text","text":"elements, so each read stays one load."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph/subscript(_:ofVertexAt:)":{"abstract":[{"type":"text","text":"The value of the vertex at "},{"code":"position","type":"codeVoice"},{"type":"text","text":" in "},{"code":"map","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"VertexMap","preciseIdentifier":"s:14GraphProtocols9VertexMapV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"ofVertexAt"},{"kind":"text","text":" _: "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Value"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Proper