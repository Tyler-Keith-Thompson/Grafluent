{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/propertygraph"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08PropertyA0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The graph owns the values and keeps every attached map in step with its mutations. The caller","type":"text"},{"text":" ","type":"text"},{"text":"holds a small handle, ","type":"text"},{"code":"VertexMap<Value>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EdgeMap<Value>","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each map has a default value, which every element has until it is given another, so a new","type":"text"},{"text":" ","type":"text"},{"text":"element needs no write. ","type":"text"},{"type":"codeVoice","code":"addEdgeMap(default: 1.0)"},{"text":" is a map of weights that are all 1.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"addEdgeMap(of: T.self)"},{"text":" is a map of ","type":"text"},{"type":"codeVoice","code":"T?"},{"text":" whose default is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every mutation updates every attached map in the same call. A removed element’s value goes with","type":"text"},{"text":" ","type":"text"},{"text":"it, and a representation that moves another element into the hole (a swap-remove) moves that","type":"text"},{"text":" ","type":"text"},{"text":"element’s values too. Removing a vertex removes its edges’ values. Reading or writing the value","type":"text"},{"text":" ","type":"text"},{"text":"of a removed element traps. The ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" subscripts throw ","type":"text"},{"code":"VertexNotFound","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"EdgeNotFound","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instead. ","type":"text"},{"code":"removeAll","type":"codeVoice"},{"text":" empties every map and keeps it attached, and ","type":"text"},{"code":"removeAllEdges","type":"codeVoice"},{"text":" empties the","type":"text"},{"text":" ","type":"text"},{"text":"edge maps.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A handle is valid on the graph that attached it and on every copy, until "},{"type":"codeVoice","code":"removeVertexMap(_:)"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"codeVoice","code":"removeEdgeMap(_:)"},{"type":"text","text":". Using it on any other graph traps. It also works through a"},{"type":"text","text":" "},{"type":"codeVoice","code":"GraphAdaptor"},{"type":"text","text":" of that graph, which reads the base’s values, and through a "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which reads and writes them. Writing a map value is not a structural mutation and does not"},{"type":"text","text":" "},{"type":"text","text":"advance "},{"type":"codeVoice","code":"generation"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A copy of the graph shares every map. The first write to a map, or structural mutation, of a","type":"text"},{"text":" ","type":"text"},{"text":"copy copies the map’s storage: a dense map all at once, like an ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":", and a paged map a page","type":"text"},{"text":" ","type":"text"},{"text":"at a time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Equality, hashing, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" and descriptions ignore maps. Equal graphs may carry different"},{"type":"text","text":" "},{"type":"text","text":"maps, a decoded graph has none, and a conversion to another representation carries none. To"},{"type":"text","text":" "},{"type":"text","text":"keep a graph and its maps together as one value, equal when the values are and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the maps reattached by decoding, use "},{"type":"codeVoice","code":"PropertyGraphBundle"},{"type":"text","text":". A snapshot ("},{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":") is a"},{"type":"text","text":" "},{"type":"text","text":"value of its own, "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" when its values are, and "},{"type":"codeVoice","code":"addEdgeMap(values:)"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"addVertexMap(values:)"},{"type":"text","text":" attaches one as a new map."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"values(of:)"},{"type":"text","text":" returns a snapshot of a map that reads as fast as an array. Pass "},{"type":"codeVoice","code":"{ w[$0] }"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"an algorithm asks for a weight closure:"}],"type":"paragraph"},{"code":["let weights = graph.addEdgeMap(default: 1.0)","\/\/ … set some weights …","let w = graph.values(of: weights)","let distances = graph.dijkstraShortestPaths(from: start, weight: { w[$0] })"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The snapshot does not check liveness. At a removed position it reads an unspecified value,","type":"text"},{"text":" ","type":"text"},{"text":"either the default or the value the element had. Algorithms read only the values of live","type":"text"},{"text":" ","type":"text"},{"text":"elements, so each read stays one load.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/EdgePosition","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/Vertex"],"title":"Associated Types"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addEdgeMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(default:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/addVertexMap(values:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeEdgeMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/removeVertexMap(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-2ufmp","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/values(of:)-89n40"],"title":"Instance Methods"},{"anchor":"Subscripts","generated":true,"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checked:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:checkedVertexAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph\/subscript(_:of:)","doc:\/\/GraphProtocols\/documentation\/GraphPr