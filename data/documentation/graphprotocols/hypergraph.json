.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The hash law: index-space members hash no vertex, and a vertex-space read looks its vertex up"},{"type":"text","text":" "},{"type":"text","text":"once."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Defaults.","type":"text"}]},{"text":" As for ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":", members with default implementations are requirements, so a","type":"text"},{"text":" ","type":"text"},{"text":"representation’s faster version is the one generic code calls, and a wrapper must forward","type":"text"},{"text":" ","type":"text"},{"text":"every one. The protocol has no mutation and does not refine ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/hyperedges-swift.property":{"kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hyperedges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges"}],"role":"symbol","abstract":[{"type":"text","text":"Every hyperedge, as its members, at its position: a repeated hyperedge at each of its"},{"type":"text","text":" "},{"type":"text","text":"positions, an empty one as an empty collection."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedges-swift.property","type":"topic","required":true,"title":"hyperedges","url":"\/documentation\/graphprotocols\/hypergraph\/hyperedges-swift.property"},"doc://GraphProtocols/documentation/GraphProtocols":{"title":"GraphProtocols","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","url":"\/documentation\/graphprotocols","kind":"symbol","abstract":