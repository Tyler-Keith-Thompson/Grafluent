e"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/generation","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertices-swift.property"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(hyperedge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/memberIndices(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/size(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndex(of:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A hypergraph is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" and shares no parent protocol with one, because a hyperedge is","type":"text"},{"text":" ","type":"text"},{"text":"not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s ","type":"text"},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its","type":"text"},{"text":" ","type":"text"},{"text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"hyperedges","type":"codeVoice"},{"text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s","type":"text"},{"text":" ","type":"text"},{"text":"position is its identity, as an edge’s is in ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":". ","type":"text"},{"code":"incidentHyperedges(of:)","type":"codeVoice"},{"text":" lists the","type":"text"},{"text":" ","type":"text"},{"text":"positions of the hyperedges a vertex is a member of, so a value keyed by ","type":"text"},{"code":"Hyperedges.Index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is","type":"text"},{"text":" ","type":"text"},{"text":"mutated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" need both bounds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every conformer satisfies these laws:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A position ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"incidentHyperedges(of: v)","type":"codeVoice"},{"text":" exactly when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge at ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", once, in ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" order. ","type":"text"},{"code":"degree(of: v)","type":"codeVoice"},{"text":" is the length of that list and","type":"text"},{"text":" ","type":"text"},{"code":"size(ofHyperedgeAt: p)","type":"codeVoice"},{"text":" is the number of members, so the degrees sum to the sizes.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"contains(hyperedge:)","type":"codeVoice"},{"text":" is true exactly when some hyperedge has those members, the empty set","type":"text"},{"text":" ","type":"text"},{"text":"included. It and ","type":"text"},{"code":"contains(_:)","type":"codeVoice"},{"text":" never trap.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is in index order, ","type":"text"},{"code":"memberIndices(ofHyperedgeAt:)","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"members mapped through ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" in the same order, and the ","type":"text"},{"code":"(ofIndex:)","type":"codeVoice"},{"text":" reads equal","type":"text"},{"text":" ","type":"text"},{"text":"the vertex reads.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With hyperedge indices, "},{"type":"codeVoice","code":"hyperedgeIndexBound == hyperedgeCount"},{"type":"text","text":", and "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" is in index"},{"type":"text","text":" "},{"type":"text","text":"order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position has index "},{"type":"codeVoice","code":"k"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Members with default implementations are still requirements. Generic code calls a","type":"text"},{"text":" ","type":"text"},{"text":"representation’s own version when it has one, and a wrapper must forward every one. The","type":"text"},{"text":" ","type":"text"},{"text":"protocol has no mutating members and does not refine ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/members(ofHyperedgeAt:)":{"defaultImplementations":1,"abstract":[{"text":"The members of the hyperedge at ","type":"text"},{"code":"position","type":"codeVoice"},{"text":". Default: ","type":"text"},{"code":"hyperedges[position]","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"members(ofHyperedgeAt:)","url":"\/documentation\/graphprotocols\/hypergraph\/members(ofhyperedgeat:)","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","role":"symbol","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"members","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofHyperedgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Members","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP7MembersQa"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/Hyperedges-swift.associatedtype":{"abstract":[],"type":