{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/hypergraph"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"type":"text","text":", 1989)."}],"metadata":{"modules":[{"name":"GraphProtocols"}],"externalID":"s:14GraphProtocols10HypergraphP","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"title":"Hypergraph","role":"symbol","symbolKind":"protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Hypergraph.swift#L39","fileName":"Hypergraph.swift"}},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"A hypergraph is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" and shares no parent protocol with one, because a hyperedge is","type":"text"},{"text":" ","type":"text"},{"text":"not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s ","type":"text"},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its","type":"text"},{"text":" ","type":"text"},{"text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s"},{"type":"text","text":" "},{"type":"text","text":"position is its identity, as an edge’s is in "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":". "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" lists the"},{"type":"text","text":" "},{"type":"text","text":"positions of the hyperedges a vertex is a member of, so a value keyed by "},{"type":"codeVoice","code":"Hyperedges.Index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is"},{"type":"text","text":" "},{"type":"text","text":"mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" need both bounds."}],"type":"paragraph"},{"inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"hyperedgeCount == hyperedges.count"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A position ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" is in ","type":"text"},{"type":"codeVoice","code":"incidentHyperedges(of: v)"},{"text":" exactly when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is a member of the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge at ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", once, in ","type":"text"},{"type":"codeVoice","code":"hyperedges"},{"text":" order. ","type":"text"},{"type":"codeVoice","code":"degree(of: v)"},{"text":" is the length of that list and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"size(ofHyperedgeAt: p)"},{"text":" is the number of members, so the degrees sum to the sizes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"contains(hyperedge:)"},{"text":" is true exactly when some hyperedge has those members, the empty set","type":"text"},{"text":" ","type":"text"},{"text":"included. It and ","type":"text"},{"type":"codeVoice","code":"contains(_:)"},{"text":" never trap.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order, "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"members mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" in the same order, and the "},{"type":"codeVoice","code":"(ofIndex:)"},{"type":"text","text":" reads equal"},{"type":"text","text":" "},{"type":"text","text":"the vertex reads."}]}]},{"content":[{"inlineContent":[{"text":"With hyperedge indices, ","type":"text"},{"type":"codeVoice","code":"hyperedgeIndexBound == hyperedgeCount"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"hyperedges"},{"text":" is in index","type":"text"},{"text":" ","type":"text"},{"text":"order: the ","type":"text"},{"type":"codeVoice","code":"k"},{"text":"th position has index ","type":"text"},{"type":"codeVoice","code":"k"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Members with default implementations are still requirements. Generic code calls a","type":"text"},{"text":" ","type":"text"},{"text":"representation’s own version when it has one, and a wrapper must forward every one. The","type":"text"},{"text":" ","type":"text"},{"text":"protocol has no mutating members and does not refine ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","doc:\/\/GraphProtoc