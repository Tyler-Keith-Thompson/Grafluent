{"sections":[],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/graphprotocols\/hypergraph"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"anchor":"Associated-Types","generated":true,"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/MemberIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Members","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertices-swift.associatedtype"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/generation","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertices-swift.property"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(hyperedge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/memberIndices(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/size(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndex(of:)"]}],"metadata":{"roleHeading":"Protocol","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Hypergraph.swift#L39","fileName":"Hypergraph.swift"},"symbolKind":"protocol","externalID":"s:14GraphProtocols10HypergraphP","modules":[{"name":"GraphProtocols"}],"title":"Hypergraph","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A hypergraph is not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" and shares no parent protocol with one, because a hyperedge is"},{"type":"text","text":" "},{"type":"text","text":"not an edge. The "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" module’s "},{"code":"incidenceGraphView","type":"codeVoice"},{"type":"text","text":" reads a hypergraph as its"},{"type":"text","text":" "},{"type":"text","text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s"},{"type":"text","text":" "},{"type":"text","text":"position is its identity, as an edge’s is in "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":". "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" lists the"},{"type":"text","text":" "},{"type":"text","text":"positions of the hyperedges a vertex is a member of, so a value keyed by "},{"type":"codeVoice","code":"Hyperedges.Index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is"},{"type":"text","text":" "},{"type":"text","text":"mutated."}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps the vertices one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"memberIndices(ofHyperedgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"incidentHyperedges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"read incidence in index space. With ","type":"text"},{"code":"hyperedgeIndexBound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"hyperedgeIndex(of:)","type":"codeVoice"},{"text":" maps the","type":"text"},{"text":" ","type":"text"},{"text":"positions one-to-one onto ","type":"text"},{"code":"0..<hyperedgeIndexBound","type":"codeVoice"},{"text":", so per-hyperedge state lives in arrays.","type":"text"},{"text":" ","type":"text"},{"text":"The algorithms in ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" need both bounds.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The members of a hyperedge are distinct vertices.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A position ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"incidentHyperedges(of: v)","type":"codeVoice"},{"text":" exactly when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge at ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", once, in ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" order. ","type":"text"},{"code":"degree(of: v)","type":"codeVoice"},{"text":" is the length of that list and","type":"text"},{"text":" ","type":"text"},{"code":"size(ofHyperedgeAt: p)","type":"codeVoice"},{"text":" is the number of members, so the degrees sum to the sizes.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"contains(hyperedge:)"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":" never trap."}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is in index order, ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"members mapped through ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" in the same order, and the ","type":"text"},{"type":"codeVoice","code":"(ofIndex:)"},{"text":" reads equal","type":"text"},{"text":" ","type":"text"},{"text":"the vertex reads.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With hyperedge indices, ","type":"text"},{"code":"hyperedgeIndexBound == hyperedgeCount","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" is in index","type":"text"},{"text":" ","type":"text"},{"text":"order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position has index ","type":"text"},{"code":"k","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Members with default implementations are still requirements. Generic code calls a","type":"text"},{"text":" ","type":"text"},{"text":"representation’s own version when it has one, and a wrapper must forward every one. The","type":"text"},{"text":" ","type":"text"},{"text":"protocol has no mutating members and does not refine ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"text":", 1989).","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/Hyperedges-swift.associatedtype":{"role":"symbol","title":"Hyperedges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","kind":"symbol","required":true,"type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hyperedges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"abstract":[],"url":"\/documentation\/graphprotocols\/hypergraph\/hyperedges-swift.associatedtype"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/hyperedgeCount":{"title":"hyperedgeCount","type":"topic","role":"symbol","defaultImplementations":1,"abstract":[{"type":"text","text":"The number of hyperedges, repeats and empty ones included. Default: "},{"type":"codeVoice","code":"hyperedges.count"},{"type":"text","text":"."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeCount","url":"\/documentation\/graphprotocols\/hypergraph\/hyperedgecount","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedgeCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols":{"title":"Graph