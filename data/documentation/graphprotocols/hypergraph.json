[{"type":"text","text":"With "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":", "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"type":"text","text":", and "},{"code":"memberIndices(ofHyperedgeAt:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"incidentHyperedges(ofIndex:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"code":"hyperedgeIndexBound","type":"codeVoice"},{"type":"text","text":", "},{"code":"hyperedgeIndex(of:)","type":"codeVoice"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"code":"0..<hyperedgeIndexBound","type":"codeVoice"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" need both bounds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every conformer satisfies these laws:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The members of a hyperedge are distinct vertices.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position "},{"type":"codeVoice","code":"p"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"incidentHyperedges(of: v)"},{"type":"text","text":" exactly when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of the"},{"type":"text","tex