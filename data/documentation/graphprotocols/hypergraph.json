{"kind":"symbol","variants":[{"paths":["\/documentation\/graphprotocols\/hypergraph"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A hypergraph is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" and shares no parent protocol with one, because a hyperedge is","type":"text"},{"text":" ","type":"text"},{"text":"not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s ","type":"text"},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its","type":"text"},{"text":" ","type":"text"},{"text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"hyperedges","type":"codeVoice"},{"text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s","type":"text"},{"text":" ","type":"text"},{"text":"position is its identity, as an edge’s is in ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":". ","type":"text"},{"code":"incidentHyperedges(of:)","type":"codeVoice"},{"text":" lists the","type":"text"},{"text":" ","type":"text"},{"text":"positions of the hyperedges a vertex is a member of, so a value keyed by ","type":"text"},{"code":"Hyperedges.Index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is","type":"text"},{"text":" ","type":"text"},{"text":"mutated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" need both bounds."}]},{"type":"paragraph","inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"type":"text","text":", the vertices are distinct, and"},{"type":"text","text":" "},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}]}]},{"content":[{"inlineContent":[{"text":"A position ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"incidentHyperedges(of: v)","type":"codeVoice"},{"text":" exactly when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge at ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", once, in ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" order. ","type":"text"},{"code":"degree(of: v)","type":"codeVoice"},{"text":" is the length of that list and","type":"text"},{"text":" ","type":"text"},{"code":"size(ofHyperedgeAt: p)","type":"codeVoice"},{"text":" is the number of members, so the degrees sum to the sizes.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"contains(hyperedge:)"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":" never trap."}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is in index order, ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"members mapped through ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" in the same order, and the ","type":"text"},{"type":"codeVoice","code":"(ofIndex:)"},{"text":" reads equal","type":"text"},{"text":" ","type":"text"},{"text":"the vertex reads.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With hyperedge indices, "},{"type":"codeVoice","code":"hyperedgeIndexBound == hyperedgeCount"},{"type":"text","text":", and "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" is in index"},{"type":"text","text":" "},{"type":"text","text":"order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position has index "},{"type":"codeVoice","code":"k"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Members with default implementations are still requirements. Generic code calls a"},{"type":"text","text":" "},{"type":"text","text":"representation’s own version when it has one, and a wrapper must forward every one. The"},{"type":"text","text":" "},{"type":"text","text":"protocol has no mutating members and does not refine "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"text":", 1989).","type":"text"}],"sections":[],"topicSections":[{"title":"Associated Types","generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/MemberIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Members","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergr