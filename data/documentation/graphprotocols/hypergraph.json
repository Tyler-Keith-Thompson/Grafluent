{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A hypergraph is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" and shares no parent protocol with one, because a hyperedge is","type":"text"},{"text":" ","type":"text"},{"text":"not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s ","type":"text"},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its","type":"text"},{"text":" ","type":"text"},{"text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"hyperedges","type":"codeVoice"},{"text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s","type":"text"},{"text":" ","type":"text"},{"text":"position is its identity, as an edge’s is in ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":". ","type":"text"},{"code":"incidentHyperedges(of:)","type":"codeVoice"},{"text":" lists the","type":"text"},{"text":" ","type":"text"},{"text":"positions of the hyperedges a vertex is a member of, so a value keyed by ","type":"text"},{"code":"Hyperedges.Index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is","type":"text"},{"text":" ","type":"text"},{"text":"mutated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"With ","type":"text"},{"type":"codeVoice","code":"vertexIndexBound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" maps the vertices one-to-one onto","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"text":" ","type":"text"},{"text":"read incidence in index space. With ","type":"text"},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"text":" maps the","type":"text"},{"text":" ","type":"text"},{"text":"positions one-to-one onto ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"text":", so per-hyperedge state lives in arrays.","type":"text"},{"text":" ","type":"text"},{"text":"The algorithms in ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" need both bounds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"type":"text","text":", the vertices are distinct, and"},{"type":"text","text":" "},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The members of a hyperedge are distinct vertices.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A position "},{"type":"codeVoice","code":"p"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"incidentHyperedges(of: v)"},{"type":"text","text":" exactly when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge at "},{"type":"codeVoice","code":"p"},{"type":"text","text":", once, in "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" order. "},{"type":"codeVoice","code":"degree(of: v)"},{"type":"text","text":" is the length of that list and"},{"type":"text","text":" "},{"type":"codeVoice","code":"size(ofHyperedgeAt: p)"},{"type":"text","text":" is the number of members, so the degrees sum to the sizes."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"contains(hyperedge:)"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":" never trap."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order, "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"members mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" in the same order, and the "},{"type":"codeVoice","code":"(ofIndex:)"},{"type":"text","text":" reads equal"},{"type":"text","text":" "},{"type":"text","text":"the vertex reads."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With hyperedge indices, ","type":"text"},{"type":"codeVoice","code":"hyperedgeIndexBound == hyperedgeCount"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"hyperedges"},{"text":" is in index","type":"text"},{"text":" ","type":"text"},{"text":"order: the ","type":"text"},{"type":"codeVoice","code":"k"},{"text":"th position has index ","type":"text"},{"type":"codeVoice","code":"k"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Members with default implementations are still requirements. Generic code calls a","type":"text"},{"text":" ","type":"text"},{"text":"representation’s own version when it has one, and a wrapper must forward every one. The","type":"text"},{"text":" ","type":"text"},{"text":"protocol has no mutating members and does not refine ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}]}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/MemberIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Members","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertices-swift.associatedtype"],"anchor":"Associated-Types","title":"Associated Types","generated":true},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/generation","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertices-swift.property"],"anchor":"Instance-Properties","title":"Instance Properties","generat