{"sections":[],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/MemberIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Members","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertices-swift.associatedtype"],"title":"Associated Types","generated":true,"anchor":"Associated-Types"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/generation","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertices-swift.property"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(hyperedge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/memberIndices(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/size(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndex(of:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"text":", 1989).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A hypergraph is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" and shares no parent protocol with one, because a hyperedge is"},{"type":"text","text":" "},{"type":"text","text":"not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" reads a hypergraph as its"},{"type":"text","text":" "},{"type":"text","text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it."}],"type":"paragraph"},{"inlineContent":[{"code":"hyperedges","type":"codeVoice"},{"text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s","type":"text"},{"text":" ","type":"text"},{"text":"position is its identity, as an edge’s is in ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":". ","type":"text"},{"code":"incidentHyperedges(of:)","type":"codeVoice"},{"text":" lists the","type":"text"},{"text":" ","type":"text"},{"text":"positions of the hyperedges a vertex is a member of, so a value keyed by ","type":"text"},{"code":"Hyperedges.Index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is","type":"text"},{"text":" ","type":"text"},{"text":"mutated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" need both bounds."}],"type":"paragraph"},{"inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"type":"text","text":", the vertices are distinct, and"},{"type":"text","text":" "},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position "},{"type":"codeVoice","code":"p"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"incidentHyperedges(of: v)"},{"type":"text","text":" exactly when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge at "},{"type":"codeVoice","code":"p"},{"type":"text","text":", once, in "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" order. "},{"type":"codeVoice","code":"degree(of: v)"},{"type":"text","text":" is the length of that list and"},{"type":"text","text":" "},{"type":"codeVoice","code":"size(ofHyperedgeAt: p)"},{"type":"text","text":" is the number of members, so the degrees sum to the sizes."}]}]},{"content":[{"inlineContent":[{"code":"contains(hyperedge:)","type":"codeVoice"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"code":"contains(_:)","type":"codeVoice"},{"type":"text","text":" never trap."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" is in index order, "},{"code":"memberIndices(ofHyperedgeAt:)","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"members mapped through "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":" in the same order, and the "},{"code":"(ofIndex:)","type":"codeVoice"},{"type":"text","text":" reads equal"},{"type":"text","text":" "},{"type":"text","text":"the vertex reads."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With hyperedge indices, "},{"code":"hyperedgeIndexBound == hyperedgeCount","type":"codeVoice"},{"type":"text","text":", and "},{"code":"hyperedges","type":"codeVoice"},{"type":"text","text":" is in index"},{"type":"text","text":" "},{"type":"text","text":"order: the "},{"code":"k","type":"codeVoice"},{"type":"text","text":"th position has index "},{"code":"k","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Members with default implementations are still requirements. Generic code calls a","type":"text"},{"text":" ","type":"text"},{"text":"representation’s own version when it has one, and a wrapper must forward every one. The","type":"text"},{"text":" ","type":"text"},{"text":"protocol has no mutating members and does not refine ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Protocol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Hypergraph.swift#L39","fileName":"H