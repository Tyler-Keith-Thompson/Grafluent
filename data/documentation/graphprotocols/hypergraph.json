{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"remoteSource":{"fileName":"Hypergraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Hypergraph.swift#L39"},"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"title":"Hypergraph","modules":[{"name":"GraphProtocols"}],"roleHeading":"Protocol","externalID":"s:14GraphProtocols10HypergraphP","symbolKind":"protocol"},"kind":"symbol","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"text":", 1989).","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/hypergraph"]}],"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedgeIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/MemberIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Members","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertices-swift.associatedtype"],"anchor":"Associated-Types","generated":true,"title":"Associated Types"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/generation","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertices-swift.property"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(hyperedge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/memberIndices(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/size(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndex(of:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hypergraph is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" and shares no parent protocol with one, because a hyperedge is"},{"type":"text","text":" "},{"type":"text","text":"not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" reads a hypergraph as its"},{"type":"text","text":" "},{"type":"text","text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it."}]},{"type":"paragraph","inlineContent":[{"code":"hyperedges","type":"codeVoice"},{"text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s","type":"text"},{"text":" ","type":"text"},{"text":"position is its identity, as an edge’s is in ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":". ","type":"text"},{"code":"incidentHyperedges(of:)","type":"codeVoice"},{"text":" lists the","type":"text"},{"text":" ","type":"text"},{"text":"positions of the hyperedges a vertex is a member of, so a value keyed by ","type":"text"},{"code":"Hyperedges.Index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is","type":"text"},{"text":" ","type":"text"},{"text":"mutated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"With ","type":"text"},{"type":"codeVoice","code":"vertexIndexBound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" maps the vertices one-to-one onto","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"text":" ","type":"text"},{"text":"read incidence in index space. With ","type":"text"},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"text":", ","type":"text"},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"text":" maps the","type":"text"},{"text":" ","type":"text"},{"text":"positions one-to-one onto ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"text":", so per-hyperedge state lives in arrays.","type":"text"},{"text":" ","type":"text"},{"text":"The algorithms in ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" need both bounds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}]}]},{"content":[{"inlineContent":[{"text":"A position ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" is in ","type":"text"},{"code":"incidentHyperedges(of: v)","type":"codeVoice"},{"text":" exactly when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is a member of the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge at ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", once, in ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" order. ","type":"text"},{"code":"degree(of: v)","type":"codeVoice"},{"text":" is the length of that list and","type":"text"},{"text":" ","type":"text"},{"code":"size(ofHyperedgeAt: p)","type":"codeVoice"},{"text":" is the number of members, so the degrees sum to the sizes.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"contains(hyperedge:)","type":"codeVoice"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"code":"contains(_:)","type":"codeVoice"},{"type":"text","text":" never trap."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is in index order, ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"members mapped through ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" in the same order, and the ","type":"text"},{"type":"codeVoice","code":"(ofIndex:)"},{"text":" reads equal","type":"text"},{"text":" ","type":"text"},{"text":"the vertex reads.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With hyperedge indices, ","type":"text"},{"type":"codeVoice","code":"hyperedgeIndexBound == hyperedgeCount"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"hyperedges"},{"text":" is in index","type":"text"},{"text":" ","type":"text"},{"text":"order: the ","type":"text"},{"type":"codeVoice","code":"k"},{"text":"th position has index ","type":"text"},{"type":"codeVoice","code":"k"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Members with default implementations are still requirements. Generic code calls a"},{"type":"text","text":" "},{"type":"text","text":"representation’s own version when it has one, and a wrapper must forward every one. The"},{"type":"text","text":" "},{"type":"text","text":"protocol has no mutating members and does not refine "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}]}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","kind":"symbol","title":"GraphProtocols","abstract":[],"url":"\/documentation\/graphprotocols","type":"topic","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/IncidentHyperedgeIndices":{"type":"topic","required":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedgeIndices","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidentHyperedgeIndices"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":" = "},{"preciseIdentifier":"s:s15LazyMapSequenceV","kind":"typeIdentifier","text":"LazyMapSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP18IncidentHyperedgesQa","kind":"typeIdentifier","text":"IncidentHyperedges"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"url":"\/documentation\/graphprotocols\/hypergraph\/incidenthyperedgeindices","kind":"symbol","title":"IncidentHyperedgeIndices","abstract":[],"role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/degree(ofIndex:)":{"required":tr