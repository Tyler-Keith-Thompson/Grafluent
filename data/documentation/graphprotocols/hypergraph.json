{"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"roleHeading":"Protocol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"symbolKind":"protocol","remoteSource":{"fileName":"Hypergraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Hypergraph.swift#L39"},"modules":[{"name":"GraphProtocols"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"title":"Hypergraph","externalID":"s:14GraphProtocols10HypergraphP","role":"symbol"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A hypergraph is not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" and shares no parent protocol with one, because a hyperedge is","type":"text"},{"text":" ","type":"text"},{"text":"not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s ","type":"text"},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its","type":"text"},{"text":" ","type":"text"},{"text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s"},{"type":"text","text":" "},{"type":"text","text":"position is its identity, as an edge’s is in "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":". "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" lists the"},{"type":"text","text":" "},{"type":"text","text":"positions of the hyperedges a vertex is a member of, so a value keyed by "},{"type":"codeVoice","code":"Hyperedges.Index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is"},{"type":"text","text":" "},{"type":"text","text":"mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" need both bounds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every conformer satisfies these laws:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The members of a hyperedge are distinct vertices.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position "},{"type":"codeVoice","code":"p"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"incidentHyperedges(of: v)"},{"type":"text","text":" exactly when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge at "},{"type":"codeVoice","code":"p"},{"type":"text","text":", once, in "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" order. "},{"type":"codeVoice","code":"degree(of: v)"},{"type":"text","text":" is the length of that list and"},{"type":"text","text":" "},{"type":"codeVoice","code":"size(ofHyperedgeAt: p)"},{"type":"text","text":" is the number of members, so the degrees sum to the sizes."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"contains(hyperedge:)"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":" never trap."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order, "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"members mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" in the same order, and the "},{"type":"codeVoice","code":"(ofIndex:)"},{"type":"text","text":" reads equal"},{"type":"text","text":" "},{"type":"text","text":"the vertex reads."}]}]},{"content":[{"inlineContent":[{"text":"With hyperedge indices, ","type":"text"},{"code":"hyperedgeIndexBound == hyperedgeCount","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" is in index","type":"text"},{"text":" ","type":"text"},{"text":"order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position has index ","type":"text"},{"code":"k","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Members with default implementations are still requirements. Generic code calls a"},{"type":"text","text":" "},{"type":"text","text":"representation’s own version when it has one, and a wrapper must forward every one. The"},{"type":"text","text":" "},{"type":"text","text":"protocol has no mutating members and does not refine "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"text":", 1989).","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"},"kind":"symbol","topicSections":[{"anchor":"Associated-Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Hyperedges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/IncidentHyperedgeIndices","doc:\/\/GraphProtocols\