rue},{"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/generation","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertices-swift.property"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(hyperedge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/memberIndices(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/size(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndex(of:)"],"anchor":"Instance-Methods","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A hypergraph is not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" and shares no parent protocol with one, because a hyperedge is","type":"text"},{"text":" ","type":"text"},{"text":"not an edge. The ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" module’s ","type":"text"},{"type":"codeVoice","code":"incidenceGraphView"},{"text":" reads a hypergraph as its","type":"text"},{"text":" ","type":"text"},{"text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s"},{"type":"text","text":" "},{"type":"text","text":"position is its identity, as an edge’s is in "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":". "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" lists the"},{"type":"text","text":" "},{"type":"text","text":"positions of the hyperedges a vertex is a member of, so a value keyed by "},{"type":"codeVoice","code":"Hyperedges.Index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is"},{"type":"text","text":" "},{"type":"text","text":"mutated."}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps the vertices one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"memberIndices(ofHyperedgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"incidentHyperedges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"read incidence in index space. With ","type":"text"},{"code":"hyperedgeIndexBound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"hyperedgeIndex(of:)","type":"codeVoice"},{"text":" maps the","type":"text"},{"text":" ","type":"text"},{"text":"positions one-to-one onto ","type":"text"},{"code":"0..<hyperedgeIndexBound","type":"codeVoice"},{"text":", so per-hyperedge state lives in arrays.","type":"text"},{"text":" ","type":"text"},{"text":"The algorithms in ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" need both bounds.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every conformer satisfies these laws:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The members of a hyperedge are distinct vertices.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position "},{"code":"p","type":"codeVoice"},{"type":"text","text":" is in "},{"code":"incidentHyperedges(of: v)","type":"codeVoice"},{"type":"text","text":" exactly when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a member of the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge at "},{"code":"p","type":"codeVoice"},{"type":"text","text":", once, in "},{"code":"hyperedges","type":"codeVoice"},{"type":"text","text":" order. "},{"code":"degree(of: v)","type":"codeVoice"},{"type":"text","text":" is the length of that list and"},{"type":"text","text":" "},{"code":"size(ofHyperedgeAt: p)","type":"codeVoice"},{"type":"text","text":" is the number of members, so the degrees sum to the sizes."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"contains(hyperedge:)"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"type":"codeVoice","code":"contains(_:)"},{"type":"text","text":" never trap."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order, "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"members mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" in the same order, and the "},{"type":"codeVoice","code":"(ofIndex:)"},{"type":"text","text":" reads equal"},{"type":"text","text":" "},{"type":"text","text":"the vertex reads."}]}]},{"content":[{"inlineContent":[{"text":"With hyperedge indices, ","type":"text"},{"code":"hyperedgeIndexBound == hyperedgeCount","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" is in index","type":"text"},{"text":" ","type":"text"},{"text":"order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position has index ","type":"text"},{"code":"k","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Members with default implementations are still requirements. Generic code calls a"},{"type":"text","text":" "},{"type":"text","text":"representation’s own version when it has one, and a wrapper must forward every one. The"},{"type":"text","text":" "},{"type":"text","text":"protocol has no mutating members and does not refine "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/incidentHyperedges(of:)":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidentHyperedges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"IncidentHyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP18IncidentHyperedgesQa"}],"required":true,"abstract":[{"text":"The positions of the hyperedges ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" is a member of, each once, in ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" order.","type":"text"}],"role":"symbol","title":"incidentHyperedges(of:)","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","url":"\/documentation\/graphprotocols\/hypergraph\/incidenthyperedges(of:)"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/contains(hyperedge:)":{"title":"contains(hyperedge:)","type":"topic","abstract":[{"text":"Whether some hyperedge has exactly the members of ","type":"text"},