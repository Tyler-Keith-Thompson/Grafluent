rotocols\/documentation\/GraphProtocols\/Hypergraph\/vertices-swift.property"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/contains(hyperedge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/degree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/hyperedgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedgeIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/memberIndices(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/size(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndex(of:)"]}],"kind":"symbol","variants":[{"paths":["\/documentation\/graphprotocols\/hypergraph"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"text":"Hypergraphs","type":"text"}]},{"type":"text","text":", 1989)."}],"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A hypergraph is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" and shares no parent protocol with one, because a hyperedge is"},{"type":"text","text":" "},{"type":"text","text":"not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" reads a hypergraph as its"},{"type":"text","text":" "},{"type":"text","text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s"},{"type":"text","text":" "},{"type":"text","text":"position is its identity, as an edge’s is in "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":". "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" lists the"},{"type":"text","text":" "},{"type":"text","text":"positions of the hyperedges a vertex is a member of, so a value keyed by "},{"type":"codeVoice","code":"Hyperedges.Index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is"},{"type":"text","text":" "},{"type":"text","text":"mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" need both bounds."}],"type":"paragraph"},{"inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"type":"text","text":", the vertices are distinct, and"},{"type":"text","text":" "},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position "},{"code":"p","type":"codeVoice"},{"type":"text","text":" is in "},{"code":"incidentHyperedges(of: v)","type":"codeVoice"},{"type":"text","text":" exactly when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is a member of the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge at "},{"code":"p","type":"codeVoice"},{"type":"text","text":", once, in "},{"code":"hyperedges","type":"codeVoice"},{"type":"text","text":" order. "},{"code":"degree(of: v)","type":"codeVoice"},{"type":"text","text":" is the length of that list and"},{"type":"text","text":" "},{"code":"size(ofHyperedgeAt: p)","type":"codeVoice"},{"type":"text","text":" is the number of members, so the degrees sum to the sizes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"contains(hyperedge:)","type":"codeVoice"},{"text":" is true exactly when some hyperedge has those members, the empty set","type":"text"},{"text":" ","type":"text"},{"text":"included. It and ","type":"text"},{"code":"contains(_:)","type":"codeVoice"},{"text":" never trap.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is in index order, ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"members mapped through ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" in the same order, and the ","type":"text"},{"type":"codeVoice","code":"(ofIndex:)"},{"text":" reads equal","type":"text"},{"text":" ","type":"text"},{"text":"the vertex reads.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"With hyperedge indices, ","type":"text"},{"code":"hyperedgeIndexBound == hyperedgeCount","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"hyperedges","type":"codeVoice"},{"text":" is in index","type":"text"},{"text":" ","type":"text"},{"text":"order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position has index ","type":"text"},{"code":"k","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Members with default implementations are still requirements. Generic code calls a"},{"type":"text","text":" "},{"type":"text","text":"representation’s own version when it has one, and a wrapper must forward every one. The"},{"type":"text","text":" "},{"type":"text","text":"protocol has no mutating members and does not refine "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/incidentHyperedges(of:)":{"abstract":[{"type":"text","text":"The positions of the hyperedges "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" is a member of, each once, in "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" order."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidentHyperedges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP18IncidentHyperedgesQa","text":"IncidentHyperedges"}],"url":"\/documentation\/graphprotocols\/hypergraph\/incidenthyperedges(of:)","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","kind":"symbol","required":true,"title":"incidentHyperedges(of:)","role":"symbol","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols":{"title":"GraphProtocols","kind":"symbol","abstract":[],"url":"\/documentation\/graphprotocols","role":"collection","type":"topic","identifier":"doc:\/\/GraphProtocols