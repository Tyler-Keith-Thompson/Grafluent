nd hyperedge indices."}],"type":"strong"},{"text":" As for ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":": with ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"maps the vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"memberIndices(ofHyperedgeAt:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"incidentHyperedges(ofIndex:)","type":"codeVoice"},{"text":" read incidence in index space. With ","type":"text"},{"code":"hyperedgeIndexBound","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeIndex(of:)","type":"codeVoice"},{"text":" maps the positions one-to-one onto ","type":"text"},{"code":"0..<hyperedgeIndexBound","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"per-hyperedge state lives in arrays. The algorithms in ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" need both bounds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" Every conformer satisfies:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and","type":"text"},{"text":" ","type":"text"},{"code":"hyperedgeCount == hyperedges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A position "},{"code":"p","type":"codeVoice"},{"type":"text","text":" is in "},{"code":"incidentHyperedges(of: v)","type":"codeVoice"},{"type":"te