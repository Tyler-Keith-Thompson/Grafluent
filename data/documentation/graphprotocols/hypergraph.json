s\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/incidentHyperedges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/memberIndices(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/members(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/size(ofHyperedgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertexIndex(of:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"kind":"symbol","identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/graphprotocols\/hypergraph"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"text":"Hypergraphs","type":"text"}]},{"type":"text","text":", 1989)."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"modules":[{"name":"GraphProtocols"}],"roleHeading":"Protocol","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"role":"symbol","externalID":"s:14GraphProtocols10HypergraphP","title":"Hypergraph","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/Hypergraph.swift#L39","fileName":"Hypergraph.swift"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"Hypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A hypergraph is not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" and shares no parent protocol with one, because a hyperedge is"},{"type":"text","text":" "},{"type":"text","text":"not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" reads a hypergraph as its"},{"type":"text","text":" "},{"type":"text","text":"bipartite incidence graph (the Levi graph), which is how the graph algorithms reach it."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" lists every hyperedge once, a repeated one at each of its positions. A hyperedge’s"},{"type":"text","text":" "},{"type":"text","text":"position is its identity, as an edge’s is in "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":". "},{"type":"codeVoice","code":"incidentHyperedges(of:)"},{"type":"text","text":" lists the"},{"type":"text","text":" "},{"type":"text","text":"positions of the hyperedges a vertex is a member of, so a value keyed by "},{"type":"codeVoice","code":"Hyperedges.Index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"such as a weight, is the same from every member. Positions are valid until the hypergraph is"},{"type":"text","text":" "},{"type":"text","text":"mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"With "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps the vertices one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"read incidence in index space. With "},{"type":"codeVoice","code":"hyperedgeIndexBound"},{"type":"text","text":", "},{"type":"codeVoice","code":"hyperedgeIndex(of:)"},{"type":"text","text":" maps the"},{"type":"text","text":" "},{"type":"text","text":"positions one-to-one onto "},{"type":"codeVoice","code":"0..<hyperedgeIndexBound"},{"type":"text","text":", so per-hyperedge state lives in arrays."},{"type":"text","text":" "},{"type":"text","text":"The algorithms in "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" need both bounds."}],"type":"paragraph"},{"inlineContent":[{"text":"Every conformer satisfies these laws:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"hyperedgeCount == hyperedges.count"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The members of a hyperedge are distinct vertices."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A position "},{"type":"codeVoice","code":"p"},{"type":"text","text":" is in "},{"type":"codeVoice","code":"incidentHyperedges(of: v)"},{"type":"text","text":" exactly when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is a member of the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge at "},{"type":"codeVoice","code":"p"},{"type":"text","text":", once, in "},{"type":"codeVoice","code":"hyperedges"},{"type":"text","text":" order. "},{"type":"codeVoice","code":"degree(of: v)"},{"type":"text","text":" is the length of that list and"},{"type":"text","text":" "},{"type":"codeVoice","code":"size(ofHyperedgeAt: p)"},{"type":"text","text":" is the number of members, so the degrees sum to the sizes."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"contains(hyperedge:)","type":"codeVoice"},{"type":"text","text":" is true exactly when some hyperedge has those members, the empty set"},{"type":"text","text":" "},{"type":"text","text":"included. It and "},{"code":"contains(_:)","type":"codeVoice"},{"type":"text","text":" never trap."}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is in index order, ","type":"text"},{"code":"memberIndices(ofHyperedgeAt:)","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"members mapped through ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" in the same order, and the ","type":"text"},{"code":"(ofIndex:)","type":"codeVoice"},{"text":" reads equal","type":"text"},{"text":" ","type":"text"},{"text":"the vertex reads.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With hyperedge indices, "},{"code":"hyperedgeIndexBound == hyperedgeCount","type":"codeVoice"},{"type":"text","text":", and "},{"code":"hyperedges","type":"codeVoice"},{"type":"text","text":" is in index"},{"type":"text","text":" "},{"type":"text","text":"order: the "},{"code":"k","type":"codeVoice"},{"type":"text","text":"th position has index "},{"code":"k","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Index-space members hash no vertex, and a vertex-space read looks its vertex up once.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Members with default implementations are still requirements. Generic code calls a"},{"type":"text","text":" "},{"type":"text","text":"representation’s own version when it has one, and a wrapper must forward every one. The"},{"type":"text","text":" "},{"type":"text","text":"protocol has no mutating members and does not refine "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/vertex(atIndex:)":{"role":"symbol","required":true,"title":"vertex(atIndex:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertex","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"atIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"}],"type":"topic","abstract":[{"text":"The vertex whose index is ","type":"text"},{"code":"index","type":"codeVoice"},{"text":".","type":"text"}],"defaultImplementations":1,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph\/vertex(atIndex:)","url":"\/documentation\/graphprotocols\/hypergraph\/vertex(atindex:)","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols":{"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","title":"GraphProtocols","role":"collection","url":"\/documentation\/graphprotocols","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph/IncidentHyperedges":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidentHyperedges","kind":"identifier"},