{"topicSections":[{"title":"Associated Types","anchor":"Associated-Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/SuccessorIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertices-swift.property"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/source(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/target(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndex(of:)"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"kind":"relationships","title":"Inherited By","type":"inheritedBy","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"]},{"kind":"relationships","title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/directedgraph"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Edges and their identity."}],"type":"strong"},{"text":" Edges may repeat (parallel edges) unless the representation says","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Each edge, every copy included, has a position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", and that position is the","type":"text"},{"text":" ","type":"text"},{"text":"edge’s identity: ","type":"text"},{"type":"codeVoice","code":"outEdges(of:)"},{"text":" lists the positions of the edges leaving a vertex, so an","type":"text"},{"text":" ","type":"text"},{"text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"type":"codeVoice","code":"Edges.Index"},{"text":". ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"text":" read an edge’s endpoints","type":"text"},{"text":" ","type":"text"},{"text":"without the cost of ","type":"text"},{"type":"codeVoice","code":"edges[i]"},{"text":". Positions are valid until the graph is mutated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Counting."}]},{"text":" Every count and neighborhood counts each edge once, so a repeated edge counts once","type":"text"},{"text":" ","type":"text"},{"text":"per copy: ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" lists a target once per edge to it, in the same order as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"outEdges(of:)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"outDegree(of:)"},{"text":" is the length of either. For a simple graph these are the","type":"text"},{"text":" ","type":"text"},{"text":"set definitions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertex indices."}]},{"text":" A representation with dense vertex indices reports ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps its vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s ","type":"text"},{"code":"vertex_index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"petgraph’s ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":"). Indices are valid until the graph is mutated.","type":"text"},{"text":" ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency directly in index space, and ","type":"text"},{"code":"outEdges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the out-edges without looking the vertex up. A representation with dense edge indices also","type":"text"},{"text":" ","type":"text"},{"text":"reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so per-edge values","type":"text"},{"text":" ","type":"text"},{"text":"(weights, flow) can live in arrays.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":" lists each position of an edge leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"source(ofEdgeAt: e) == v"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e) == edges[e].target"},{"type":"text","text":" for each;"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" is their targets in the same order; "},{"type":"codeVoice","code":"outDegree(of: v)"},{"type":"text","text":" is their count."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The out-degrees sum to "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":". "},{"code":"contains(edge:)","type":"codeVoice"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", and "},{"code":"contains","type":"codeVoice"},{"type":"text","text":" is false (and does not trap) for anything absent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Asking again gives the same answer.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order: "},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"i"},{"type":"text","text":"th vertex,"},{"type":"text","text":" "},{"type":"text","text":"so an algorithm that visits vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order can walk "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"successorIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"successors(of: v)","type":"codeVoice"},{"text":" mapped through ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":", in the same order, and","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"outEdges(of: v)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With edge indices, ","type":"text"},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is in index order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position of ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"code":"edgeIndex","type":"codeVoice"},{"text":" ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" (so ","type":"text"},{"code":"undirected","type":"codeVoice"},{"text":", which forwards both, keeps ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":"’s law of the same name).","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"type":"text","text":" Members with default implementations are requirements, not extension methods, so"},{"type":"text","text":" "},{"type":"text","text":"a representation’s faster version is the one generic code calls. A type that wraps another"},{"type":"text","text":" "},{"type":"text","text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its"},{"type":"text","text":" "},{"type":"text","text":"base: a default chosen for the wrapper would ignore the base’s faster member."}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has no mutation; mutation belongs to concrete types. It does not refine","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":"; representations are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when their vertices are, and algorithms that cross","type":"text"},{"text":" ","type":"text"},{"text":"isolation ask for ","type":"text"},{"code":"DirectedGraph & Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"symbolKind":"protocol","externalID":"s:14GraphProtocols08DirectedA0P","modules":[{"name":"GraphProtocols"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"remoteSource":{"fileName":"DirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/DirectedGraph.swift#L52"},"title":"DirectedGraph","roleHeading":"Protocol","role":"symbol"},"sections":[],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Successors":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"}],"url":"\/documentation\/graphprotocols\/directedgraph\/succe