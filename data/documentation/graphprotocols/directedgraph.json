{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges and their identity."}],"type":"strong"},{"text":" Edges may repeat (parallel edges) unless the representation says","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Each edge, every copy included, has a position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", and that position is the","type":"text"},{"text":" ","type":"text"},{"text":"edge’s identity: ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" lists the positions of the edges leaving a vertex, so an","type":"text"},{"text":" ","type":"text"},{"text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":". ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" read an edge’s endpoints","type":"text"},{"text":" ","type":"text"},{"text":"without the cost of ","type":"text"},{"code":"edges[i]","type":"codeVoice"},{"text":". Positions are valid until the graph is mutated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Counting.","type":"text"}],"type":"strong"},{"text":" Every count and neighborhood counts each edge once, so a repeated edge counts once","type":"text"},{"text":" ","type":"text"},{"text":"per copy: ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" lists a target once per edge to it, in the same order as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"outEdges(of:)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"outDegree(of:)"},{"text":" is the length of either. For a simple graph these are the","type":"text"},{"text":" ","type":"text"},{"text":"set definitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertex indices."}]},{"type":"text","text":" A representation with dense vertex indices reports "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"then "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps its vertices one-to-one onto "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s "},{"type":"codeVoice","code":"vertex_index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"petgraph’s "},{"type":"codeVoice","code":"NodeCompactIndexable"},{"type":"text","text":"). Indices are valid until the graph is mutated."},{"type":"text","text":" "},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"type":"text","text":" gives adjacency directly in index space, and "},{"type":"codeVoice","code":"outEdges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"the out-edges without looking the vertex up. A representation with dense edge indices also"},{"type":"text","text":" "},{"type":"text","text":"reports "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and then "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" maps edge positions one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"edge_index"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":"), so per-edge values"},{"type":"text","text":" "},{"type":"text","text":"(weights, flow) can live in arrays."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Laws."}]},{"type":"text","text":" Every conformer satisfies:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and every edge’s endpoints are","type":"text"},{"text":" ","type":"text"},{"text":"vertices; ","type":"text"},{"code":"edgeCount == edges.count","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"For every vertex ","type":"text"},{"type":"codeVoice","code":"v"},{"text":": ","type":"text"},{"type":"codeVoice","code":"outEdges(of: v)"},{"text":" lists each position of an edge leaving ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"once; ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt: e) == v"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt: e) == edges[e].target"},{"text":" for each;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"successors(of: v)"},{"text":" is their targets in the same order; ","type":"text"},{"type":"codeVoice","code":"outDegree(of: v)"},{"text":" is their count.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The out-degrees sum to "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything absent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asking again gives the same answer."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" is in index order: "},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"type":"text","text":" is the "},{"code":"i","type":"codeVoice"},{"type":"text","text":"th vertex,"},{"type":"text","text":" "},{"type":"text","text":"so an algorithm that visits vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order can walk "},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"successorIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":", in the same order, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":"; for every position "},{"type":"codeVoice","code":"e"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndex(ofEdgeAt: e)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"targetIndex(ofEdgeAt: e)"},{"type":"text","text":" are the indices of"},{"type":"text","text":" "},{"type":"codeVoice","code":"source(ofEdgeAt: e)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is in index order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position of "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"codeVoice","code":"edgeIndex"},{"type":"text","text":" "},{"type":"codeVoice","code":"k"},{"type":"text","text":" (so "},{"type":"codeVoice","code":"undirected"},{"type":"text","text":", which forwards both, keeps "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s law of the same name)."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"text":" Members with default implementations are requirements, not extension methods, so","type":"text"},{"text":" ","type":"text"},{"text":"a representation’s faster version is the one generic code calls. A type that wraps another","type":"text"},{"text":" ","type":"text"},{"text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its","type":"text"},{"text":" ","type":"text"},{"text":"base: a default chosen for the wrapper would ignore the base’s faster member.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has no mutation: mutation belongs to concrete types, and the refinement","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":") gives wrappers the few hooks they need to","type":"text"},{"text":" ","type":"text"},{"text":"mutate a base generically. It does not refine","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":"; representations are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when their vertices are, and algorithms that cross","type":"text"},{"text":" ","type":"text"},{"text":"isolation ask for ","type":"text"},{"code":"DirectedGraph & Sendable","type":"codeVoice"},{"text":".","type":"text"}]}]}],"relationshipsSections":[{"kind":"relationships","title":"Inherited By","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"],"type":"inheritedBy"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"],"type":"conformingTypes"}],"variants":[{"paths":["\/documentation\/graphprotocols\/directedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/SuccessorIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","doc:\/\/GraphProtocols\/document