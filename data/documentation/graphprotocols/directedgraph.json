stract":[{"type":"text","text":"A directed graph whose vertices and edges sit at integer positions in "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":" that may have holes: petgraph’s "},{"type":"codeVoice","code":"NodeIndexable"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"node_bound()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edge_bound()"},{"type":"text","text":" are “an upper bound of the indices,"},{"type":"text","text":" "},{"type":"text","text":"suitable for the size of a bitmap”, as against "},{"type":"codeVoice","code":"NodeCompactIndexable"},{"type":"text","text":", whose indices have no"},{"type":"text","text":" "},{"type":"text","text":"holes. "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" are the compact kind and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws; a conformer reports them only while it has no holes."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","navigatorTitle":[{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}],"url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph","type":"topic","title":"SparselyIndexedDirectedGraph","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparselyIndexedDirectedGraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"title":"BidirectionalDirectedGraph","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","role":"symbol","navigatorTitle":[{"text":"