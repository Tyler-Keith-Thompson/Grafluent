{"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"kind":"symbol","sections":[],"topicSections":[{"anchor":"Associated-Types","generated":true,"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/SuccessorIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertices-swift.property"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/source(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/sourceIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/target(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/targetIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndex(of:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"metadata":{"symbolKind":"protocol","externalID":"s:14GraphProtocols08DirectedA0P","remoteSource":{"fileName":"DirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/DirectedGraph.swift#L56"},"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"roleHeading":"Protocol","role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","modules":[{"name":"GraphProtocols"}]},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"kind":"relationships","title":"Inherited By","type":"inheritedBy","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"]},{"kind":"relationships","title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges and their identity.","type":"text"}]},{"type":"text","text":" Edges may repeat (parallel edges) unless the representation says"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Each edge, every copy included, has a position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and that position is the"},{"type":"text","text":" "},{"type":"text","text":"edge’s identity: "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" lists the positions of the edges leaving a vertex, so an"},{"type":"text","text":" "},{"type":"text","text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":". "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" read an edge’s endpoints"},{"type":"text","text":" "},{"type":"text","text":"without the cost of "},{"type":"codeVoice","code":"edges[i]"},{"type":"text","text":". Positions are valid until the graph is mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Counting."}]},{"type":"text","text":" Every count and neighborhood counts each edge once, so a repeated edge counts once"},{"type":"text","text":" "},{"type":"text","text":"per copy: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" lists a target once per edge to it, in the same order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" is the length of either. For a simple graph these are the"},{"type":"text","text":" "},{"type":"text","text":"set definitions."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Vertex indices."}],"type":"strong"},{"text":" A representation with dense vertex indices reports ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps its vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s ","type":"text"},{"code":"vertex_index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"petgraph’s ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":"). Indices are valid until the graph is mutated.","type":"text"},{"text":" ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency directly in index space, and ","type":"text"},{"code":"outEdges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the out-edges without looking the vertex up. A representation with dense edge indices also","type":"text"},{"text":" ","type":"text"},{"text":"reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so per-edge values","type":"text"},{"text":" ","type":"text"},{"text":"(weights, flow) can live in arrays.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Laws."}],"type":"strong"},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For every vertex "},{"code":"v","type":"codeVoice"},{"type":"text","text":": "},{"code":"outEdges(of: v)","type":"codeVoice"},{"type":"text","text":" lists each position of an edge leaving "},{"code":"v","type":"codeVoice"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"code":"source(ofEdgeAt: e) == v","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target(ofEdgeAt: e) == edges[e].target","type":"codeVoice"},{"type":"text","text":" for each;"},{"type":"text","text":" "},{"code":"successors(of: v)","type":"codeVoice"},{"type":"text","text":" is their targets in the same order; "},{"code":"outDegree(of: v)","type":"codeVoice"},{"type":"text","text":" is their count."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The out-degrees sum to "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything absent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Asking again gives the same answer."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is in index order: ","type":"text"},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"th vertex,","type":"text"},{"text":" ","type":"text"},{"text":"so an algorithm that visits vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order can walk ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"successorIndices(ofIndex: vertexIndex(of: v))"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"successors(of: v)"},{"text":" mapped through ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":", in the same order, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"outEdges(ofIndex: vertexIndex(of: v))"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"outEdges(of: v)"},{"text":"; for every position ","type":"text"},{"type":"codeVoice","code":"e"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"sourceIndex(ofEdgeAt: e)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"targetIndex(ofEdgeAt: e)"},{"text":" are the indices of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt: e)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt: e)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With edge indices, ","type":"text"},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"edgeIndex(of:)"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" is in index order: the ","type":"text"},{"type":"codeVoice","code":"k"},{"text":"th position of ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edgeIndex"},{"text":" ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" (so ","type":"text"},{"type":"codeVoice","code":"undirected"},{"text":", which forwards both, keeps ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":"’s law of the same name).","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Defaults.","type":"text"}]},{"type":"text","text":" Members with default implementations are requirements, not extension methods, so"},{"type":"text","text":" "},{"type":"text","text":"a representation’s faster version is the one generic code calls. A type that wraps another"},{"type":"text","text":" "},{"type":"text","text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its"},{"type":"text","text":" "},{"type":"text","text":"base: a default chosen for the wrapper would ignore the base’s faster member."}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has no mutation: mutation belongs to concrete types, and the refinement","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":") gives wrappers the few hooks they need to","type":"text"},{"text":" ","type":"text"},{"text":"mutate a base generically. It does not refine","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":"; representations are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when their vertices are, and algorithms that cross","type":"text"},{"text":" ","type":"text"},{"text":"isolation ask for ","type":"text"},{"code":"DirectedGraph & Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/directedgraph"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/edgeCount":{"role":"symbol","abstract":[{"type":"text","text":"The number of edges, repeats included. Default: "},{"type":"codeVoice","code":"edges.count"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","url":"\/documentation\/graphprotocols\/directedgraph\/edgecount","title":"edgeCount","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"edgeCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","defaultImplementations":1,"required":true},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/outEdges(of:)":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(of:)","abstract":[{"text":"The position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" of every edge leaving ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", each once.","type":"text"}],"fragment