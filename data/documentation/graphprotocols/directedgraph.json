phProtocols\/DirectedGraph\/Vertices-swift.associatedtype"],"generated":true,"anchor":"Associated-Types"},{"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertices-swift.property"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/source(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/sourceIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/target(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/targetIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndex(of:)"],"generated":true,"anchor":"Instance-Methods"}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges and their identity."}]},{"text":" Edges may repeat (parallel edges) unless the representation says","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Each edge, every copy included, has a position in ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", and that position is the","type":"text"},{"text":" ","type":"text"},{"text":"edge’s identity: ","type":"text"},{"type":"codeVoice","code":"outEdges(of:)"},{"text":" lists the positions of the edges leaving a vertex, so an","type":"text"},{"text":" ","type":"text"},{"text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"type":"codeVoice","code":"Edges.Index"},{"text":". ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"text":" read an edge’s endpoints","type":"text"},{"text":" ","type":"text"},{"text":"without the cost of ","type":"text"},{"type":"codeVoice","code":"edges[i]"},{"text":". Positions are valid until the graph is mutated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Counting."}],"type":"strong"},{"text":" Every count and neighborhood counts each edge once, so a repeated edge counts once","type":"text"},{"text":" ","type":"text"},{"text":"per copy: ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" lists a target once per edge to it, in the same order as","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" is the length of either. For a simple graph these are the","type":"text"},{"text":" ","type":"text"},{"text":"set definitions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex indices.","type":"text"}]},{"text":" A representation with dense vertex indices reports ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps its vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s ","type":"text"},{"code":"vertex_index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"petgraph’s ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":"). Indices are valid until the graph is mutated.","type":"text"},{"text":" ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency directly in index space, and ","type":"text"},{"code":"outEdges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the out-edges without looking the vertex up. A representation with dense edge indices also","type":"text"},{"text":" ","type":"text"},{"text":"reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so per-edge values","type":"text"},{"text":" ","type":"text"},{"text":"(weights, flow) can live in arrays.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Laws."}],"type":"strong"},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and every edge’s endpoints are","type":"text"},{"text":" ","type":"text"},{"text":"vertices; ","type":"text"},{"code":"edgeCount == edges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":": ","type":"text"},{"code":"outEdges(of: v)","type":"codeVoice"},{"text":" lists each position of an edge leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"once; ","type":"text"},{"code":"source(ofEdgeAt: e) == v","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target(ofEdgeAt: e) == edges[e].target","type":"codeVoice"},{"text":" for each;","type":"text"},{"text":" ","type":"text"},{"code":"successors(of: v)","type":"codeVoice"},{"text":" is their targets in the same order; ","type":"text"},{"code":"outDegree(of: v)","type":"codeVoice"},{"text":" is their count.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The out-degrees sum to ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":". ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" is true exactly for the edges in","type":"text"},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"contains","type":"codeVoice"},{"text":" is false (and does not trap) for anything absent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asking again gives the same answer."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order: "},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"i"},{"type":"text","text":"th vertex,"},{"type":"text","text":" "},{"type":"text","text":"so an algorithm that visits vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order can walk "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"successorIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"successors(of: v)","type":"codeVoice"},{"type":"text","text":" mapped through "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":", in the same order, and"},{"type":"text","text":" "},{"code":"outEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is "},{"code":"outEdges(of: v)","type":"codeVoice"},{"type":"text","text":"; for every position "},{"code":"e","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"sourceIndex(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"targetIndex(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" are the indices of"},{"type":"text","text":" "},{"code":"source(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With edge indices, ","type":"text"},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is in index order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position of ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"code":"edgeIndex","type":"codeVoice"},{"text":" ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" (so ","type":"text"},{"code":"undirected","type":"codeVoice"},{"text":", which forwards both, keeps ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":"’s law of the same name).","type":"text"}]}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"type":"text","text":" Members with default implementations are requirements, not extension methods, so"},{"type":"text","text":" "},{"type":"text","text":"a representation’s faster version is the one generic code calls. A type that wraps another"},{"type":"text","text":" "},{"type":"text","text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its"},{"type":"text","text":" "},{"type":"text","text":"base: a default chosen for the wrapper would ignore the base’s faster member."}],"type":"pa