Protocols\/DirectedGraph\/source(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/sourceIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/target(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/targetIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndex(of:)"],"generated":true}],"kind":"symbol","metadata":{"modules":[{"name":"GraphProtocols"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"symbolKind":"protocol","role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P","roleHeading":"Protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/DirectedGraph.swift#L56","fileName":"DirectedGraph.swift"},"title":"DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges and their identity."}],"type":"strong"},{"text":" Edges may repeat (parallel edges) unless the representation says","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. Each edge, every copy included, has a position in ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", and that position is the","type":"text"},{"text":" ","type":"text"},{"text":"edge’s identity: ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":" lists the positions of the edges leaving a vertex, so an","type":"text"},{"text":" ","type":"text"},{"text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)","type":"text"},{"text":" ","type":"text"},{"text":"keyed by ","type":"text"},{"code":"Edges.Index","type":"codeVoice"},{"text":". ","type":"text"},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"text":" read an edge’s endpoints","type":"text"},{"text":" ","type":"text"},{"text":"without the cost of ","type":"text"},{"code":"edges[i]","type":"codeVoice"},{"text":". Positions are valid until the graph is mutated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Counting.","type":"text"}]},{"type":"text","text":" Every count and neighborhood counts each edge once, so a repeated edge counts once"},{"type":"text","text":" "},{"type":"text","text":"per copy: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" lists a target once per edge to it, in the same order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" is the length of either. For a simple graph these are the"},{"type":"text","text":" "},{"type":"text","text":"set definitions."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Vertex indices.","type":"text"}],"type":"strong"},{"text":" A representation with dense vertex indices reports ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps its vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s ","type":"text"},{"code":"vertex_index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"petgraph’s ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":"). Indices are valid until the graph is mutated.","type":"text"},{"text":" ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency directly in index space, and ","type":"text"},{"code":"outEdges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the out-edges without looking the vertex up. A representation with dense edge indices also","type":"text"},{"text":" ","type":"text"},{"text":"reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so per-edge values","type":"text"},{"text":" ","type":"text"},{"text":"(weights, flow) can live in arrays.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"text":" Every conformer satisfies:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"type":"codeVoice","code":"edgeCount == edges.count"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For every vertex ","type":"text"},{"code":"v","type":"codeVoice"},{"text":": ","type":"text"},{"code":"outEdges(of: v)","type":"codeVoice"},{"text":" lists each position of an edge leaving ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"once; ","type":"text"},{"code":"source(ofEdgeAt: e) == v","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target(ofEdgeAt: e) == edges[e].target","type":"codeVoice"},{"text":" for each;","type":"text"},{"text":" ","type":"text"},{"code":"successors(of: v)","type":"codeVoice"},{"text":" is their targets in the same order; ","type":"text"},{"code":"outDegree(of: v)","type":"codeVoice"},{"text":" is their count.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The out-degrees sum to "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything absent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Asking again gives the same answer.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order: "},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"i"},{"type":"text","text":"th vertex,"},{"type":"text","text":" "},{"type":"text","text":"so an algorithm that visits vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order can walk "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"successorIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"successors(of: v)","type":"codeVoice"},{"type":"text","text":" mapped through "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":", in the same order, and"},{"type":"text","text":" "},{"code":"outEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is "},{"code":"outEdges(of: v)","type":"codeVoice"},{"type":"text","text":"; for every position "},{"code":"e","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"sourceIndex(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"targetIndex(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" are the indices of"},{"type":"text","text":" "},{"code":"source(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target(ofEdgeAt: e)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"With edge indices, ","type":"text"},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" is in index order: the ","type":"text"},{"code":"k","type":"codeVoice"},{"text":"th position of ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"code":"edgeIndex","type":"codeVoice"},{"text":" ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" (so ","type":"text"},{"code":"undirected","type":"codeVoice"},{"text":", which forwards both, keeps ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":"’s law of the same name).","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"type":"text","text":" Members with default implementations are requirements, not extension methods, so"},{"type":"text","text":" "},{"type":"text","text":"a representation’s faster version is the one generic code calls. A type that wraps another"},{"type":"text","text":" "},{"type":"text","text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its"},{"type":"text","text":" "},{"type":"text","text":"base: a default chosen for the wrapper would ignore the base’s faster member."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has no mutation: mutation belongs to concrete types, and the refinement"},{"type":"text","text":" "},{"code":"MutableDirectedGraph","type":"codeVoice"},{"type":"text","text":" (Boost’s "},{"code":"MutableGraph","type":"codeVoice"},{"type":"text","text":") gives wrappers the few hooks they need to"},{"type":"text","text":" "},{"type":"text","text":"mutate a base generically. It does not refine"},{"type":"text","text":" "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"; representations are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" when their vertices are, and algorithms that cross"},{"type":"text","text":" "},{"type":"text","text":"isolation ask for "},{"code":"DirectedGraph & Sendable","type":"codeVoice"},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/graphprotocols\/directedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","title":"Inherited By","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"],"type":"inheritedBy"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"],"type":"conformingTypes"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/vertexIndexBound":{"required":true,"title":"vertexIndexBound","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexIndexBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","url":"\/documentation\/graphprotocols\/directedgraph\/vertexindexbound","kind":"symbol","abstract":[{"text":"The number of dense vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertexCount"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when the representation has","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"none. Default: "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"defaultImplementations":1,"type":"topic","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/source(ofEdgeAt:)":{"required":true,"title":"source(ofEdgeAt:)","fra