"},{"text":" ","kind":"text"},{"text":"Successors","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"}],"title":"Successors","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/vertexIndexBound":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertexIndexBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"defaultImplementations":1,"required":true,"role":"symbol","abstract":[{"text":"The number of dense vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertexCount"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when the representation has","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"none. Default: "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"title":"vertexIndexBound","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","url":"\/documentation\/graphprotocols\/directedgraph\/vertexindexbound","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/OutEdges":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/directedgraph\/outedges","required":true,"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutEdges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"}],"title":"OutEdges","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"title":"MutableDirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the two arcs ","type":"text"},{"type":"codeVoice","code":"u→v"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v→u"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"successors"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"predecessors"},{"text":" are both ","type":"text"},{"type":"codeVoice","code":"neighbors"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":" is twice the","type":"text"},{"text":" ","type":"text"},{"text":"base’s.","type":"text"}],"url":"\/documentation\/graphprotocols\/directedview","type":"top