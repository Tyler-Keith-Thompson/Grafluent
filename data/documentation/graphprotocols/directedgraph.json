{"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"relationshipsSections":[{"title":"Inherited By","kind":"relationships","type":"inheritedBy","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"]},{"title":"Conforming Types","kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"]}],"variants":[{"paths":["\/documentation\/graphprotocols\/directedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges and their identity.","type":"text"}]},{"type":"text","text":" Edges may repeat (parallel edges) unless the representation says"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Each edge, every copy included, has a position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and that position is the"},{"type":"text","text":" "},{"type":"text","text":"edge’s identity: "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" lists the positions of the edges leaving a vertex, so an"},{"type":"text","text":" "},{"type":"text","text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":". "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" read an edge’s endpoints"},{"type":"text","text":" "},{"type":"text","text":"without the cost of "},{"type":"codeVoice","code":"edges[i]"},{"type":"text","text":". Positions are valid until the graph is mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Counting.","type":"text"}]},{"type":"text","text":" Every count and neighborhood counts each edge once, so a repeated edge counts once"},{"type":"text","text":" "},{"type":"text","text":"per copy: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" lists a target once per edge to it, in the same order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" is the length of either. For a simple graph these are the"},{"type":"text","text":" "},{"type":"text","text":"set definitions."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Vertex indices."}]},{"text":" A representation with dense vertex indices reports ","type":"text"},{"type":"codeVoice","code":"vertexIndexBound"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"type":"codeVoice","code":"vertexIndex(of:)"},{"text":" maps its vertices one-to-one onto ","type":"text"},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s ","type":"text"},{"type":"codeVoice","code":"vertex_index"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"petgraph’s ","type":"text"},{"type":"codeVoice","code":"NodeCompactIndexable"},{"text":"). Indices are valid until the graph is mutated.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"text":" gives adjacency directly in index space, and ","type":"text"},{"type":"codeVoice","code":"outEdges(ofIndex:)"},{"text":" ","type":"text"},{"text":"the out-edges without looking the vertex up. A representation with dense edge indices also","type":"text"},{"text":" ","type":"text"},{"text":"reports ","type":"text"},{"type":"codeVoice","code":"edgeIndexBound"},{"text":", and then ","type":"text"},{"type":"codeVoice","code":"edgeIndex(of:)"},{"text":" maps edge positions one-to-one onto","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"text":" (Boost’s ","type":"text"},{"type":"codeVoice","code":"edge_index"},{"text":", petgraph’s ","type":"text"},{"type":"codeVoice","code":"EdgeIndexable"},{"text":"), so per-edge values","type":"text"},{"text":" ","type":"text"},{"text":"(weights, flow) can live in arrays.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"code":"edgeCount == edges.count","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":" lists each position of an edge leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"source(ofEdgeAt: e) == v"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e) == edges[e].target"},{"type":"text","text":" for each;"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" is their targets in the same order; "},{"type":"codeVoice","code":"outDegree(of: v)"},{"type":"text","text":" is their count."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The out-degrees sum to "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":". "},{"type":"codeVoice","code":"contains(edge:)"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and "},{"type":"codeVoice","code":"contains"},{"type":"text","text":" is false (and does not trap) for anything absent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Asking again gives the same answer.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" is in index order: ","type":"text"},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"text":" is the ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"th vertex,","type":"text"},{"text":" ","type":"text"},{"text":"so an algorithm that visits vertices in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order can walk ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"successorIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":", in the same order, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is in index order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position of "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"codeVoice","code":"edgeIndex"},{"type":"text","text":" "},{"type":"codeVoice","code":"k"},{"type":"text","text":" (so "},{"type":"codeVoice","code":"undirected"},{"type":"text","text":", which forwards both, keeps "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s law of the same name)."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"type":"text","text":" Members with default implementations are requirements, not extension methods, so"},{"type":"text","text":" "},{"type":"text","text":"a representation’s faster version is the one generic code calls. A type that wraps another"},{"type":"text","text":" "},{"type":"text","text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its"},{"type":"text","text":" "},{"type":"text","text":"base: a default chosen for the wrapper would ignore the base’s faster member."}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has no mutation; mutation belongs to concrete types. It does not refine","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":"; representations are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when their vertices are, and algorithms that cross","type":"text"},{"text":" ","type":"text"},{"text":"isolation ask for ","type":"text"},{"code":"DirectedGraph & Sendable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Associated Types","generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/SuccessorIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertices-swift.property"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(_:)","doc:\/\/GraphProtocols\/documen