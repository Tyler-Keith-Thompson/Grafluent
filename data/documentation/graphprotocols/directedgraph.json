{"kind":"symbol","topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/SuccessorIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"],"generated":true,"anchor":"Associated-Types"},{"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertices-swift.property"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/source(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/sourceIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/target(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/targetIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndex(of:)"],"generated":true,"anchor":"Instance-Methods"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"metadata":{"role":"symbol","roleHeading":"Protocol","title":"DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"symbolKind":"protocol","remoteSource":{"fileName":"DirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/DirectedGraph.swift#L56"},"externalID":"s:14GraphProtocols08DirectedA0P","modules":[{"name":"GraphProtocols"}]},"relationshipsSections":[{"kind":"relationships","title":"Inherited By","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"],"type":"inheritedBy"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"],"type":"conformingTypes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges and their identity."}]},{"type":"text","text":" Edges may repeat (parallel edges) unless the representation says"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Each edge, every copy included, has a position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and that position is the"},{"type":"text","text":" "},{"type":"text","text":"edge’s identity: "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" lists the positions of the edges leaving a vertex, so an"},{"type":"text","text":" "},{"type":"text","text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":". "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" read an edge’s endpoints"},{"type":"text","text":" "},{"type":"text","text":"without the cost of "},{"type":"codeVoice","code":"edges[i]"},{"type":"text","text":". Positions are valid until the graph is mutated."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Counting."}],"type":"strong"},{"text":" Every count and neighborhood counts each edge once, so a repeated edge counts once","type":"text"},{"text":" ","type":"text"},{"text":"per copy: ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" lists a target once per edge to it, in the same order as","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(of:)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"outDegree(of:)","type":"codeVoice"},{"text":" is the length of either. For a simple graph these are the","type":"text"},{"text":" ","type":"text"},{"text":"set definitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Vertex indices.","type":"text"}],"type":"strong"},{"text":" A representation with dense vertex indices reports ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps its vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s ","type":"text"},{"code":"vertex_index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"petgraph’s ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":"). Indices are valid until the graph is mutated.","type":"text"},{"text":" ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency directly in index space, and ","type":"text"},{"code":"outEdges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the out-edges without looking the vertex up. A representation with dense edge indices also","type":"text"},{"text":" ","type":"text"},{"text":"reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so per-edge values","type":"text"},{"text":" ","type":"text"},{"text":"(weights, flow) can live in arrays.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"text":" Every conformer satisfies:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"code":"edgeCount == edges.count","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":" lists each position of an edge leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"source(ofEdgeAt: e) == v"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e) == edges[e].target"},{"type":"text","text":" for each;"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" is their targets in the same order; "},{"type":"codeVoice","code":"outDegree(of: v)"},{"type":"text","text":" is their count."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The out-degrees sum to ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":". ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" is true exactly for the edges in","type":"text"},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"contains","type":"codeVoice"},{"text":" is false (and does not trap) for anything absent.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Asking again gives the same answer.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" is in index order: "},{"code":"vertex(atIndex: i)","type":"codeVoice"},{"type":"text","text":" is the "},{"code":"i","type":"codeVoice"},{"type":"text","text":"th vertex,"},{"type":"text","text":" "},{"type":"text","text":"so an algorithm that visits vertices in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order can walk "},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"successorIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":", in the same order, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":"; for every position "},{"type":"codeVoice","code":"e"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndex(ofEdgeAt: e)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"targetIndex(ofEdgeAt: e)"},{"type":"text","text":" are the indices of"},{"type":"text","text":" "},{"type":"codeVoice","code":"source(ofEdgeAt: e)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is in index order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position of "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"codeVoice","code":"edgeIndex"},{"type":"text","text":" "},{"type":"codeVoice","code":"k"},{"type":"text","text":" (so "},{"type":"codeVoice","code":"undirected"},{"type":"text","text":", which forwards both, keeps "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s law of the same name)."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Defaults.","type":"text"}],"type":"strong"},{"text":" Members with default implementations are requirements, not extension methods, so","type":"text"},{"text":" ","type":"text"},{"text":"a representation’s faster version is the one generic code calls. A type that wraps another","type":"text"},{"text":" ","type":"text"},{"text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its","type":"text"},{"text":" ","type":"text"},{"text":"base: a default chosen for the wrapper would ignore the base’s faster member.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has no mutation: mutation belongs to concrete types, and the refinement","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":") gives wrappers the few hooks they need to","type":"text"},{"text":" ","type":"text"},{"text":"mutate a base generically. It does not refine","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":"; representations are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when their vertices are, and algorithms that cross","type":"text"},{"text":" ","type":"text"},{"text":"isolation ask for ","type":"text"},{"code":"DirectedGraph & Sendable","type":"codeVoice"},{"text":".","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/graphprotocols\/directedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Successors":{"abstract":[],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Successors"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"}],"required":true,"url":"\/documentation\/graphprotocols\/directedgraph\/successors","title":"Successors"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/outDegree(of:)":{"abstract":[{"text":"The number of edges leaving ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", repeats included. Default: the length of","type":"text"},{"text":" ","type":"text"},{"code":"successors(of: vertex)","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(of:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword