{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges and their identity.","type":"text"}]},{"type":"text","text":" Edges may repeat (parallel edges) unless the representation says"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Each edge, every copy included, has a position in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", and that position is the"},{"type":"text","text":" "},{"type":"text","text":"edge’s identity: "},{"code":"outEdges(of:)","type":"codeVoice"},{"type":"text","text":" lists the positions of the edges leaving a vertex, so an"},{"type":"text","text":" "},{"type":"text","text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"code":"Edges.Index","type":"codeVoice"},{"type":"text","text":". "},{"code":"source(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"target(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" read an edge’s endpoints"},{"type":"text","text":" "},{"type":"text","text":"without the cost of "},{"code":"edges[i]","type":"codeVoice"},{"type":"text","text":". Positions are valid until the graph is mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Counting."}]},{"type":"text","text":" Every count and neighborhood counts each edge once, so a repeated edge counts once"},{"type":"text","text":" "},{"type":"text","text":"per copy: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" lists a target once per edge to it, in the same order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" is the length of either. For a simple graph these are the"},{"type":"text","text":" "},{"type":"text","text":"set definitions."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Vertex indices."}],"type":"strong"},{"text":" A representation with dense vertex indices reports ","type":"text"},{"code":"vertexIndexBound","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":" maps its vertices one-to-one onto ","type":"text"},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s ","type":"text"},{"code":"vertex_index","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"petgraph’s ","type":"text"},{"code":"NodeCompactIndexable","type":"codeVoice"},{"text":"). Indices are valid until the graph is mutated.","type":"text"},{"text":" ","type":"text"},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"text":" gives adjacency directly in index space, and ","type":"text"},{"code":"outEdges(ofIndex:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the out-edges without looking the vertex up. A representation with dense edge indices also","type":"text"},{"text":" ","type":"text"},{"text":"reports ","type":"text"},{"code":"edgeIndexBound","type":"codeVoice"},{"text":", and then ","type":"text"},{"code":"edgeIndex(of:)","type":"codeVoice"},{"text":" maps edge positions one-to-one onto","type":"text"},{"text":" ","type":"text"},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"edge_index","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"EdgeIndexable","type":"codeVoice"},{"text":"), so per-edge values","type":"text"},{"text":" ","type":"text"},{"text":"(weights, flow) can live in arrays.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"text":" Every conformer satisfies:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"text":", the vertices are distinct, and every edge’s endpoints are","type":"text"},{"text":" ","type":"text"},{"text":"vertices; ","type":"text"},{"code":"edgeCount == edges.count","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":" lists each position of an edge leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"source(ofEdgeAt: e) == v"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e) == edges[e].target"},{"type":"text","text":" for each;"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" is their targets in the same order; "},{"type":"codeVoice","code":"outDegree(of: v)"},{"type":"text","text":" is their count."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The out-degrees sum to ","type":"text"},{"type":"codeVoice","code":"edgeCount"},{"text":". ","type":"text"},{"type":"codeVoice","code":"contains(edge:)"},{"text":" is true exactly for the edges in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"contains"},{"text":" is false (and does not trap) for anything absent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Asking again gives the same answer.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" is in index order: "},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"type":"text","text":" is the "},{"type":"codeVoice","code":"i"},{"type":"text","text":"th vertex,"},{"type":"text","text":" "},{"type":"text","text":"so an algorithm that visits vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order can walk "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"code":"successorIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"successors(of: v)","type":"codeVoice"},{"type":"text","text":" mapped through "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":", in the same order, and"},{"type":"text","text":" "},{"code":"outEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"type":"text","text":" is "},{"code":"outEdges(of: v)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"With edge indices, ","type":"text"},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"edgeIndex(of:)"},{"text":" is one-to-one onto","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" is in index order: the ","type":"text"},{"type":"codeVoice","code":"k"},{"text":"th position of ","type":"text"},{"type":"codeVoice","code":"edges"},{"text":" has","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edgeIndex"},{"text":" ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" (so ","type":"text"},{"type":"codeVoice","code":"undirected"},{"text":", which forwards both, keeps ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":"’s law of the same name).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"type":"text","text":" Members with default implementations are requirements, not extension methods, so"},{"type":"text","text":" "},{"type":"text","text":"a representation’s faster version is the one generic code calls. A type that wraps another"},{"type":"text","text":" "},{"type":"text","text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its"},{"type":"text","text":" "},{"type":"text","text":"base: a default chosen for the wrapper would ignore the base’s faster member."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has no mutation; mutation belongs to concrete types. It does not refine"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"; representations are "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" when their vertices are, and algorithms that cross"},{"type":"text","text":" "},{"type":"text","text":"isolation ask for "},{"type":"codeVoice","code":"DirectedGraph & Sendable"},{"type":"text