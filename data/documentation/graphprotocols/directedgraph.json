A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"relationshipsSections":[{"title":"Inherited By","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"],"type":"inheritedBy","kind":"relationships"},{"title":"Conforming Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"],"type":"conformingTypes","kind":"relationships"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/directedgraph"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"url":"\/documentation\/graphprotocols\/directedview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedView"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","title":"DirectedView","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedView"}],"abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"code":"{u, v}","type":"codeVoice"},{"type":"text","text":" is the two arcs "},{"code":"u→v","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"v→u","type":"codeVoice"},{"type":"text","text":", so "},{"code":"successors","type":"codeVoice"},{"type":"text","text":" and "},{"code":"predecessors","type":"codeVoice"},{"type":"text","text":" are both "},{"code":"neighbors","type":"codeVoice"},{"type":"text","text":", and "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","title":"MutableDirectedGraph","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/SparselyIndexedDirectedGraph":{"url":"\/documentation\/graphprotocols\/sparselyindexeddirectedgraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph","title":"SparselyIndexedDirectedGraph","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"SparselyIndexedDirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph whose vertices and edges sit at integer positions in "},{"type":"codeVoice","code":"0..<vertexPositionBound"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"0..<edgePositionBound"},{"type":"text","text":" that may have holes: petgraph’s "},{"type":"codeVoice","code":"NodeIndexable"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"node_bound()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edge_bound()"},{"type":"text","text":" are “an upper bound of the indices,"},{"type":"text","text":" "},{"type":"text","text":"suitable for the size of a bitmap”, as against "},{"type":"codeVoice","code":"NodeCompactIndexable"},{"type":"text","text":", whose indices have no"},{"type":"text","text":" "},{"type":"text","text":"holes. "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":" are the compact kind and keep"},{"type":"text","text":" "},{"type":"text","text":"their laws; a conformer reports them only while it has no holes."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","title":"BidirectionalDirectedGraph","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/OutEdges":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutEdges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"}],"url":"\/documentation\/graphprotocols\/directedgraph\/outedges","kind":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","required":true,"role":"symbol","title":"OutEdges"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/successorIndices(ofIndex:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"successorIndices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P16SuccessorIndicesQa","text":"SuccessorIndices","kind":"typeIdentifier"}],"type":"topic","title":"successorIndices(ofIndex:)","url":"\/documentation\/graphprotocols\/directedgraph\/successorindices(ofindex:)","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","abstract":[{"type":"text","text":"The indices of "},{"type":"codeVoice","code":"successors(of: vertex(atIndex: index))"},{"type":"text","text":", in the same order: adjacency in"},{"type":"text","text":" "},{"type":"text","text":"index space, so an algorithm keeping per-vertex state in arrays never maps a neighbor back"},{"type":"text","text":" "},{"type":"text","text":"to its index. Default: "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":"."}],"required":true,"kind":"symbol","role":"symbol","defaultImplementations":1},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/source(ofEdgeAt:)":{"defaultImplementations":1,"type":"topic","abstract":[{"type":"text","text":"The source of the edge at "},{"type":"codeVoice","code":"position"},{"type":"text","text":" in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":". Default: "},{"type":"codeVoice","code":"edges[position].source"},{"type":"text","text":"."}],"kind":"symbol","title":"source(ofEdgeAt:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"source"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofEdgeAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","text":"Vertex"}],"required":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/source(ofEdgeAt:)","url":"\/documentation\/graphprotocols\/directedgraph\/source(ofedgeat:)"},"doc://GraphProtocols/documentation/GraphProtocols":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols","title":"GraphProtocols","role":"collection","kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/graphprotocols"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/vertices-swift.property":{"url":"\/documentation\/grap