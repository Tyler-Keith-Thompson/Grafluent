{"kind":"symbol","sections":[],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentation\/GraphProtocols"]]},"topicSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/SuccessorIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"],"title":"Associated Types","generated":true,"anchor":"Associated-Types"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertices-swift.property"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/source(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/sourceIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/target(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/targetIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndex(of:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/SparselyIndexedDirectedGraph"],"title":"Inherited By","type":"inheritedBy","kind":"relationships"},{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView"],"title":"Conforming Types","type":"conformingTypes","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"},{"kind":"text","text":"<"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges and their identity.","type":"text"}]},{"type":"text","text":" Edges may repeat (parallel edges) unless the representation says"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Each edge, every copy included, has a position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and that position is the"},{"type":"text","text":" "},{"type":"text","text":"edge’s identity: "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" lists the positions of the edges leaving a vertex, so an"},{"type":"text","text":" "},{"type":"text","text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":". "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" read an edge’s endpoints"},{"type":"text","text":" "},{"type":"text","text":"without the cost of "},{"type":"codeVoice","code":"edges[i]"},{"type":"text","text":". Positions are valid until the graph is mutated."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Counting."}]},{"text":" Every count and neighborhood counts each edge once, so a repeated edge counts once","type":"text"},{"text":" ","type":"text"},{"text":"per copy: ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" lists a target once per edge to it, in the same order as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"outEdges(of:)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"outDegree(of:)"},{"text":" is the length of either. For a simple graph these are the","type":"text"},{"text":" ","type":"text"},{"text":"set definitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex indices.","type":"text"}]},{"type":"text","text":" A representation with dense vertex indices reports "},{"code":"vertexIndexBound","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"then "},{"code":"vertexIndex(of:)","type":"codeVoice"},{"type":"text","text":" maps its vertices one-to-one onto "},{"code":"0..<vertexIndexBound","type":"codeVoice"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s "},{"code":"vertex_index","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"petgraph’s "},{"code":"NodeCompactIndexable","type":"codeVoice"},{"type":"text","text":"). Indices are valid until the graph is mutated."},{"type":"text","text":" "},{"code":"successorIndices(ofIndex:)","type":"codeVoice"},{"type":"text","text":" gives adjacency directly in index space, and "},{"code":"outEdges(ofIndex:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the out-edges without looking the vertex up. A representation with dense edge indices also"},{"type":"text","text":" "},{"type":"text","text":"reports "},{"code":"edgeIndexBound","type":"codeVoice"},{"type":"text","text":", and then "},{"code":"edgeIndex(of:)","type":"codeVoice"},{"type":"text","text":" maps edge positions one-to-one onto"},{"type":"text","text":" "},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"type":"text","text":" (Boost’s "},{"code":"edge_index","type":"codeVoice"},{"type":"text","text":", petgraph’s "},{"code":"EdgeIndexable","type":"codeVoice"},{"type":"text","text":"), so per-edge values"},{"type":"text","text":" "},{"type":"text","text":"(weights, flow) can live in arrays."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Laws.","type":"text"}]},{"text":" Every conformer satisfies:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"vertexCount == vertices.count","type":"codeVoice"},{"type":"text","text":", the vertices are distinct, and every edge’s endpoints are"},{"type":"text","text":" "},{"type":"text","text":"vertices; "},{"code":"edgeCount == edges.count","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"For every vertex ","type":"text"},{"type":"codeVoice","code":"v"},{"text":": ","type":"text"},{"type":"codeVoice","code":"outEdges(of: v)"},{"text":" lists each position of an edge leaving ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"once; ","type":"text"},{"type":"codeVoice","code":"source(ofEdgeAt: e) == v"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"target(ofEdgeAt: e) == edges[e].target"},{"text":" for each;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"successors(of: v)"},{"text":" is their targets in the same order; ","type":"text"},{"type":"codeVoice","code":"outDegree(of: v)"},{"text":" is their count.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The out-degrees sum to ","type":"text"},{"code":"edgeCount","type":"codeVoice"},{"text":". ","type":"text"},{"code":"contains(edge:)","type":"codeVoice"},{"text":" is true exactly for the edges in","type":"text"},{"text":" ","type":"text"},{"code":"edges","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"contains","type":"codeVoice"},{"text":" is false (and does not trap) for anything absent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Asking again gives the same answer.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is in index order: ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"i"},{"text":"th vertex,","type":"text"},{"text":" ","type":"text"},{"text":"so an algorithm that visits vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order can walk ","type":"text"},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With vertex indices, "},{"type":"codeVoice","code":"successorIndices(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" mapped through "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":", in the same order, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(ofIndex: vertexIndex(of: v))"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":"; for every position "},{"type":"codeVoice","code":"e"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndex(ofEdgeAt: e)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"targetIndex(ofEdgeAt: e)"},{"type":"text","text":" are the indices of"},{"type":"text","text":" "},{"type":"codeVoice","code":"source(ofEdgeAt: e)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With edge indices, "},{"code":"edgeIndexBound == edgeCount","type":"codeVoice"},{"type":"text","text":" and "},{"code":"edgeIndex(of:)","type":"codeVoice"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"code":"0..<edgeIndexBound","type":"codeVoice"},{"type":"text","text":", and "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" is in index order: the "},{"code":"k","type":"codeVoice"},{"type":"text","text":"th position of "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" has"},{"type":"text","text":" "},{"code":"edgeIndex","type":"codeVoice"},{"type":"text","text":" "},{"code":"k","type":"codeVoice"},{"type":"text","text":" (so "},{"code":"undirected","type":"codeVoice"},{"type":"text","text":", which forwards both, keeps "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":"’s law of the same name)."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Defaults."}]},{"type":"text","text":" Members with default implementations are requirements, not extension methods, so"},{"type":"text","text":" "},{"type":"text","text":"a representation’s faster version is the one generic code calls. A type that wraps another"},{"type":"text","text":" "},{"type":"text","text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its"},{"type":"text","text":" "},{"type":"text","text":"base: a default chosen for the wrapper would ignore the base’s faster member."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has no mutation: mutation belongs to concrete types, and the refinement"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":") gives wrappers the few hooks they need to"},{"type":"text","text":" "},{"type":"text","text":"mutate a base generically. It does not refine"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"; representations are "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" when their vertices are, and algorithms that cross"},{"type":"text","text":" "},{"type":"text","text":"isolation ask for "},{"type":"codeVoice","code":"DirectedGraph & Sendable"},{"type":"text","text":"."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"roleHeading":"Protocol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"externalID":"s:14GraphProtocols08DirectedA0P","role":"symbol","title":"DirectedGraph","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/DirectedGraph.swift#L56","fileName":"DirectedGraph.swift"},"symbolKind":"protocol","modules":[{"name":"GraphProtocols"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/directedgraph"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"role":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","title":"BidirectionalDirectedGraph","abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"type":"codeVoice","code":"BidirectionalGraph"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertices-swift.associatedtype":{"role":"symbol","url":"