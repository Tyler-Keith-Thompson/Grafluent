{"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"generated":true,"title":"Associated Types","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Edges-swift.associatedtype","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/OutEdges","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/SuccessorIndices","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Successors","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertices-swift.associatedtype"],"anchor":"Associated-Types"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edges-swift.property","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexCount","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndexBound","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertices-swift.property"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(_:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/contains(edge:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/edgeIndex(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outDegree(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/outEdges(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/source(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/sourceIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successorIndices(ofIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/successors(of:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/target(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/targetIndex(ofEdgeAt:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertex(atIndex:)","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/vertexIndex(of:)"],"anchor":"Instance-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges and their identity.","type":"text"}]},{"type":"text","text":" Edges may repeat (parallel edges) unless the representation says"},{"type":"text","text":" "},{"type":"text","text":"otherwise. Each edge, every copy included, has a position in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":", and that position is the"},{"type":"text","text":" "},{"type":"text","text":"edge’s identity: "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":" lists the positions of the edges leaving a vertex, so an"},{"type":"text","text":" "},{"type":"text","text":"algorithm can tell parallel edges apart and keep per-edge values (weights, capacities, flow)"},{"type":"text","text":" "},{"type":"text","text":"keyed by "},{"type":"codeVoice","code":"Edges.Index"},{"type":"text","text":". "},{"type":"codeVoice","code":"source(ofEdgeAt:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt:)"},{"type":"text","text":" read an edge’s endpoints"},{"type":"text","text":" "},{"type":"text","text":"without the cost of "},{"type":"codeVoice","code":"edges[i]"},{"type":"text","text":". Positions are valid until the graph is mutated."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Counting."}]},{"type":"text","text":" Every count and neighborhood counts each edge once, so a repeated edge counts once"},{"type":"text","text":" "},{"type":"text","text":"per copy: "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" lists a target once per edge to it, in the same order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"outEdges(of:)"},{"type":"text","text":", and "},{"type":"codeVoice","code":"outDegree(of:)"},{"type":"text","text":" is the length of either. For a simple graph these are the"},{"type":"text","text":" "},{"type":"text","text":"set definitions."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Vertex indices.","type":"text"}]},{"type":"text","text":" A representation with dense vertex indices reports "},{"type":"codeVoice","code":"vertexIndexBound"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"then "},{"type":"codeVoice","code":"vertexIndex(of:)"},{"type":"text","text":" maps its vertices one-to-one onto "},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"algorithms can keep per-vertex state in arrays instead of dictionaries (Boost’s "},{"type":"codeVoice","code":"vertex_index"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"petgraph’s "},{"type":"codeVoice","code":"NodeCompactIndexable"},{"type":"text","text":"). Indices are valid until the graph is mutated."},{"type":"text","text":" "},{"type":"codeVoice","code":"successorIndices(ofIndex:)"},{"type":"text","text":" gives adjacency directly in index space, and "},{"type":"codeVoice","code":"outEdges(ofIndex:)"},{"type":"text","text":" "},{"type":"text","text":"the out-edges without looking the vertex up. A representation with dense edge indices also"},{"type":"text","text":" "},{"type":"text","text":"reports "},{"type":"codeVoice","code":"edgeIndexBound"},{"type":"text","text":", and then "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" maps edge positions one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"edge_index"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"EdgeIndexable"},{"type":"text","text":"), so per-edge values"},{"type":"text","text":" "},{"type":"text","text":"(weights, flow) can live in arrays."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Laws.","type":"text"}],"type":"strong"},{"type":"text","text":" Every conformer satisfies:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vertexCount == vertices.count"},{"text":", the vertices are distinct, and every edge’s endpoints are","type":"text"},{"text":" ","type":"text"},{"text":"vertices; ","type":"text"},{"type":"codeVoice","code":"edgeCount == edges.count"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For every vertex "},{"type":"codeVoice","code":"v"},{"type":"text","text":": "},{"type":"codeVoice","code":"outEdges(of: v)"},{"type":"text","text":" lists each position of an edge leaving "},{"type":"codeVoice","code":"v"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"once; "},{"type":"codeVoice","code":"source(ofEdgeAt: e) == v"},{"type":"text","text":" and "},{"type":"codeVoice","code":"target(ofEdgeAt: e) == edges[e].target"},{"type":"text","text":" for each;"},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of: v)"},{"type":"text","text":" is their targets in the same order; "},{"type":"codeVoice","code":"outDegree(of: v)"},{"type":"text","text":" is their count."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The out-degrees sum to "},{"code":"edgeCount","type":"codeVoice"},{"type":"text","text":". "},{"code":"contains(edge:)","type":"codeVoice"},{"type":"text","text":" is true exactly for the edges in"},{"type":"text","text":" "},{"code":"edges","type":"codeVoice"},{"type":"text","text":", and "},{"code":"contains","type":"codeVoice"},{"type":"text","text":" is false (and does not trap) for anything absent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Asking again gives the same answer."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"With vertex indices, ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" is in index order: ","type":"text"},{"type":"codeVoice","code":"vertex(atIndex: i)"},{"text":" is the ","type":"text"},{"type":"codeVoice","code":"i"},{"text":"th vertex,","type":"text"},{"text":" ","type":"text"},{"text":"so an algorithm that visits vertices in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order can walk ","type":"text"},{"type":"codeVoice","code":"0..<vertexIndexBound"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"With vertex indices, ","type":"text"},{"code":"successorIndices(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"successors(of: v)","type":"codeVoice"},{"text":" mapped through ","type":"text"},{"code":"vertexIndex(of:)","type":"codeVoice"},{"text":", in the same order, and","type":"text"},{"text":" ","type":"text"},{"code":"outEdges(ofIndex: vertexIndex(of: v))","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"outEdges(of: v)","type":"codeVoice"},{"text":"; for every position ","type":"text"},{"code":"e","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"sourceIndex(ofEdgeAt: e)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"targetIndex(ofEdgeAt: e)","type":"codeVoice"},{"text":" are the indices of","type":"text"},{"text":" ","type":"text"},{"code":"source(ofEdgeAt: e)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"target(ofEdgeAt: e)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With edge indices, "},{"type":"codeVoice","code":"edgeIndexBound == edgeCount"},{"type":"text","text":" and "},{"type":"codeVoice","code":"edgeIndex(of:)"},{"type":"text","text":" is one-to-one onto"},{"type":"text","text":" "},{"type":"codeVoice","code":"0..<edgeIndexBound"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" is in index order: the "},{"type":"codeVoice","code":"k"},{"type":"text","text":"th position of "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" has"},{"type":"text","text":" "},{"type":"codeVoice","code":"edgeIndex"},{"type":"text","text":" "},{"type":"codeVoice","code":"k"},{"type":"text","text":" (so "},{"type":"codeVoice","code":"undirected"},{"type":"text","text":", which forwards both, keeps "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":"’s law of the same name)."}]}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Defaults.","type":"text"}]},{"text":" Members with default implementations are requirements, not extension methods, so","type":"text"},{"text":" ","type":"text"},{"text":"a representation’s faster version is the one generic code calls. A type that wraps another","type":"text"},{"text":" ","type":"text"},{"text":"graph generically (a view, a relabeling) must implement every requirement by forwarding to its","type":"text"},{"text":" ","type":"text"},{"text":"base: a default chosen for the wrapper would ignore the base’s faster member.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has no mutation; mutation belongs to concrete types. It does not refine"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"; representations are "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" when their vertices are, and algorithms that cross"},{"type":"text","text":" "},{"type":"text","text":"isolation ask for "},{"type":"codeVoice","code":"DirectedGraph & Sendable"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/graphprotocols\/directedgraph"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"metadata":{"title":"DirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"remoteSource":{"fileName":"DirectedGraph.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphProtocols\/DirectedGraph.swift#L54"},"symbolKind":"protocol","modules":[{"name":"GraphProtocols"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"externalID":"s:14GraphProtocols08DirectedA0P","roleHeading":"Protocol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},"hierarchy":{"paths":[["doc:\/\/GraphProtocols\/documentati