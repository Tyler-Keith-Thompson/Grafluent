 complement, has no"},{"type":"text","text":" "},{"type":"text","text":"edge-map reads. These members are read-only. A "},{"type":"codeVoice","code":"GraphDelegator"},{"type":"text","text":" writes maps through members"},{"type":"text","text":" "},{"type":"text","text":"of its own."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A view whose vertices are a subset of its base’s should declare its own "},{"type":"codeVoice","code":"[map, of: vertex]"},{"type":"text","text":" "},{"type":"text","text":"that traps on a vertex outside the view. The default reads the base’s value."}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing else is forwarded. A view’s graph members are its own, or the protocol defaults over","type":"text"},{"text":" ","type":"text"},{"text":"its own members. ","type":"text"},{"code":"GraphDelegator","type":"codeVoice"},{"text":" forwards every read member to the base, and only a wrapper","type":"text"},{"text":" ","type":"text"},{"text":"that keeps the base’s adjacency conforms to it. For a view such as a transposed one, the base’s","type":"text"},{"text":" ","type":"text"},{"text":"members would describe the wrong graph.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"A type that wraps a base graph and passes its positions through."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphAdaptor"},"variants":[{"paths":["\/documentation\/graphprotocols\/graphadaptor"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"navigatorTitle":[{"text":"GraphAdaptor","kind":"identifier"}],"externalID":"s:14GraphProtocols0A7AdaptorP","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphAdaptor","kind":"identifier"}],"title":"GraphAdaptor","roleHeading":"Protocol","modules":[{"name":"GraphProtocols"}],"symbolKind":"pro