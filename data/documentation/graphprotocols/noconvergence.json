{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Power iterations (eigenvector and Katz centrality, PageRank, HITS), Lanczos and"},{"type":"text","text":" "},{"type":"text","text":"conjugate-gradient runs, and QL eigenvalue iterations throw it. Each throwing method documents"},{"type":"text","text":" "},{"type":"text","text":"what it counts as an iteration and what its residual measures. The residual is on the scale of"},{"type":"text","text":" "},{"type":"text","text":"the tolerance the method compares it with, which is the caller’s "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" where the method"},{"type":"text","text":" "},{"type":"text","text":"takes one, so "},{"type":"codeVoice","code":"residual \/ tolerance"},{"type":"text","text":" says how far from convergence the method stopped. It may"},{"type":"text","text":" "},{"type":"text","text":"be infinite or NaN when the iteration diverged."}]},{"syntax":"swift","type":"codeListing","code":["do throws(NoConvergence) {","    let scores = try graph.pageRank(maxIterations: 20)","    use(scores)","} catch {","    print(\"PageRank stopped after \\(error.iterations) iterations at \\(error.residual)\")","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphprotocols\/noconvergence"]}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence\/init(iterations:residual:)"]},{"title":