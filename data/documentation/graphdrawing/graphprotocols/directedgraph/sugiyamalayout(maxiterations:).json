{"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/directedgraph\/sugiyamalayout(maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A layered drawing by the Sugiyama framework: every vertex on a horizontal layer, edges"},{"type":"text","text":" "},{"type":"text","text":"pointing down, long edges bent through every layer they cross, few crossings."}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph"]]},"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"extendedModule":"GraphProtocols","role":"symbol","remoteSource":{"fileName":"SugiyamaLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SugiyamaLayout.swift#L41"},"symbolKind":"method","title":"sugiyamaLayout(maxIterations:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sugiyamaLayout","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LayeredDrawing","preciseIdentifier":"s:12GraphDrawing07LayeredB0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"externalID":"s:14GraphProtocols08DirectedA0P0A7DrawingE14sugiyamaLayout13maxIterationsAD07LayeredD0VyxGSi_tF","roleHeading":"Instance Method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sugiyamaLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 100) -> "},{"preciseIdentifier":"s:12GraphDrawing07LayeredB0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/LayeredDrawing","kind":"typeIdentifier","text":"LayeredDrawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Cycles are broken by reversing ","type":"text"},{"type":"codeVoice","code":"feedbackArcSet()"},{"text":" (Eades, Lin and Smyth); a DAG reverses","type":"text"},{"text":" ","type":"text"},{"text":"nothing. Self-loops are left out of the drawing.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Layers minimize the total edge span Σ (layer(target) − layer(source)) with every edge"},{"type":"text","text":" "},{"type":"text","text":"spanning at least one layer, parallel edges counted each (Gansner et al.‘s network"},{"type":"text","text":" "},{"type":"text","text":"simplex, as Graphviz’s "},{"type":"codeVoice","code":"dot"},{"type":"text","text":"); each weakly connected component starts at layer 0. Where"},{"type":"text","text":" "},{"type":"text","text":"several layerings are optimal, which one is chosen is not specified."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An edge spanning k > 1 layers gets a bend point on each of the k − 1 between."}]}]},{"content":[{"inlineContent":[{"text":"Crossings are reduced by barycenter sweeps: each layer starts with its vertices in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, then its bend points by edge position; a sweep sorts layers 1 … L−1 by","type":"text"},{"text":" ","type":"text"},{"text":"the mean position of each node’s neighbours in the layer above, then layers L−2 … 0 by","type":"text"},{"text":" ","type":"text"},{"text":"those below, stably, a node with no such neighbour keeping its position. The order with","type":"text"},{"text":" ","type":"text"},{"text":"the fewest crossings seen is kept. Sweeps stop at no crossings, when a sweep changes","type":"text"},{"text":" ","type":"text"},{"text":"nothing, or after ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" (igraph’s default, 100).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"x coordinates are Brandes and Köpf’s: four vertical alignments to median neighbours,"},{"type":"text","text":" "},{"type":"text","text":"avoiding type-1 conflicts, each compacted by longest path over its blocks at separation"},{"type":"text","text":" "},{"type":"text","text":"1, aligned to the narrowest, and averaged by the mean of the two median candidates."},{"type":"text","text":" "},{"type":"text","text":"Then the least x is 0, and y is the layer."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Layered drawing as a framework: Sugiyama, Tagawa and Toda, “Methods for visual","type":"text"},{"text":" ","type":"text"},{"text":"understanding of hierarchical system structures”, IEEE Transactions on Systems, Man, and","type":"text"},{"text":" ","type":"text"},{"text":"Cybernetics 11(2), 1981. Layering: Gansner, Koutsofios, North and Vo, “A technique for","type":"text"},{"text":" ","type":"text"},{"text":"drawing directed graphs”, IEEE Transactions on Software Engineering 19(3), 1993.","type":"text"},{"text":" ","type":"text"},{"text":"Coordinates: Brandes and Köpf, “Fast and simple horizontal coordinate assignment”, Graph","type":"text"},{"text":" ","type":"text"},{"text":"Drawing (GD 2001), LNCS 2265, 2002. The compaction is longest path rather than the paper’s","type":"text"},{"text":" ","type":"text"},{"text":"class shifts, which Brandes, Walter and Zink show can violate the separation (“Erratum:","type":"text"},{"text":" ","type":"text"},{"text":"Fast and simple horizontal coordinate assignment”, arXiv:2008.01252, 2020).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"O(n + m) for cycle removal; network simplex is not polynomially bounded but near-linear in","type":"text"},{"text":" ","type":"text"},{"text":"practice; O(maxIterations · (N + M) log N) for crossing reduction over N vertices and bend","type":"text"},{"text":" ","type":"text"},{"text":"points and M segments; O(N + M) for coordinates.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"maxIterations ≥ 0","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph\/sugiyamaLayout(maxIterations:)"},"references":{"doc://GraphDrawing/documentation/GraphDrawing/LayeredDrawing":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LayeredDrawing"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LayeredDrawing"}],"type":"topic","title":"LayeredDrawing","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/LayeredDrawing","abstract":[{"text":"A layered drawing of a directed graph (","type":"text"},{"code":"DirectedGraph.sugiyamaLayout(…)","type":"codeVoice"},{"text":"): a position per","type":"text"},{"text":" ","type":"text"},{"text":"vertex with y its layer, a layer per vertex, and bend points for every edge that crosses","type":"text"},{"text":" ","type":"text"},{"text":"layers. Vertices and bend points in one layer are at least 1 apart; edges point down once the","type":"text"},{"text":" ","type":"text"},{"text":"reversed ones are turned.","type":"text"}],"url":"\/documentation\/graphdrawing\/layereddrawing"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/DirectedGraph":{"role":"symbol","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"type":"topic","title":"DirectedGraph","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols\/directedgraph"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/DirectedGraph/sugiyamaLayout(maxIterations:)":{"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph\/sugiyamaLayout(maxIterations:)","title":"sugiyamaLayout(maxIterations:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sugiyamaLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"LayeredDrawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing07LayeredB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A layered drawing by the Sugiyama framework: every vertex on a horizontal layer, edges"},{"type":"text","text":" "},{"type":"text","text":"pointing down, long edges bent through every layer they cross, few crossings."}],"url":"\/documentation\/graphdrawing\/graphprotocols\/directedgraph\/sugiyamalayout(maxiterations:)"},"doc://GraphDrawing/documentation/GraphDrawing":{"role":"collection","type":"topic","title":"GraphDrawing","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","abstract":[],"url":"\/documentation\/graphdrawing"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","title":"GraphProtocols","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols"}}}