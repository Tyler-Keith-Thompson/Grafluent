{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/directedgraph\/sugiyamalayout(maxiterations:)"]}],"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph\/sugiyamaLayout(maxIterations:)","interfaceLanguage":"swift"},"metadata":{"extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"roleHeading":"Instance Method","externalID":"s:14GraphProtocols08DirectedA0P0A7DrawingE14sugiyamaLayout13maxIterationsAD07LayeredD0VyxGSi_tF","title":"sugiyamaLayout(maxIterations:)","role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sugiyamaLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"LayeredDrawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing07LayeredB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SugiyamaLayout.swift#L43","fileName":"SugiyamaLayout.swift"}},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sugiyamaLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 100) -> "},{"preciseIdentifier":"s:12GraphDrawing07LayeredB0V","kind":"typeIdentifier","text":"LayeredDrawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/LayeredDrawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Cycles are broken by reversing the edges of ","type":"text"},{"type":"codeVoice","code":"feedbackArcSet()"},{"text":" (Eades, Lin and Smyth)","type":"text"},{"text":" ","type":"text"},{"text":"other than self-loops; a DAG reverses nothing. Self-loops are left out of the drawing.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layers minimize the total edge span Σ (layer(target) − layer(source)) with every edge"},{"type":"text","text":" "},{"type":"text","text":"spanning at least one layer, parallel edges counted each (Gansner et al.’s network"},{"type":"text","text":" "},{"type":"text","text":"simplex, solved through its dual min-cost flow). Each weakly connected component starts"},{"type":"text","text":" "},{"type":"text","text":"at layer 0. Where several layerings are optimal, which one is"},{"type":"text","text":" "},{"type":"text","text":"chosen is not specified."}]}]},{"content":[{"inlineContent":[{"text":"An edge spanning k > 1 layers gets a bend point on each of the k − 1 between.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Crossings are reduced by barycenter sweeps: each layer starts with its vertices in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, then its bend points by edge position; a sweep sorts layers 1 … L−1 by","type":"text"},{"text":" ","type":"text"},{"text":"the mean position of each node’s neighbours in the layer above, then layers L−2 … 0 by","type":"text"},{"text":" ","type":"text"},{"text":"those below, stably, a node with no such neighbour keeping its position. The order with","type":"text"},{"text":" ","type":"text"},{"text":"the fewest crossings seen is kept. Sweeps stop at no crossings, when a sweep changes","type":"text"},{"text":" ","type":"text"},{"text":"nothing, or after ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"x coordinates are Brandes and Köpf’s: four vertical alignments to median neighbours,","type":"text"},{"text":" ","type":"text"},{"text":"avoiding type-1 conflicts, each compacted by longest path over its blocks at separation","type":"text"},{"text":" ","type":"text"},{"text":"1, aligned to the narrowest, and averaged by the mean of the two median candidates.","type":"text"},{"text":" ","type":"text"},{"text":"Then the least x is 0, and y is the layer.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Layered drawing as a framework: Sugiyama, Tagawa and Toda, “Methods for visual","type":"text"},{"text":" ","type":"text"},{"text":"understanding of hierarchical system structures”, IEEE Transactions on Systems, Man, and","type":"text"},{"text":" ","type":"text"},{"text":"Cybernetics 11(2), 1981. Layering: Gansner, Koutsofios, North and Vo, “A technique for","type":"text"},{"text":" ","type":"text"},{"text":"drawing directed graphs”, IEEE Transactions on Software Engineering 19(3), 1993.","type":"text"},{"text":" ","type":"text"},{"text":"Coordinates: Brandes and Köpf, “Fast and simple horizontal coordinate assignment”, Graph","type":"text"},{"text":" ","type":"text"},{"text":"Drawing (GD 2001), LNCS 2265, 2002. The compaction is longest path rather than the paper’s","type":"text"},{"text":" ","type":"text"},{"text":"class shifts, which Brandes, Walter and Zink show can violate the separation (“Erratum:","type":"text"},{"text":" ","type":"text"},{"text":"Fast and simple horizontal coordinate assignment”, arXiv:2008.01252, 2020).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"O((n + m) log n) for cycle removal. Network simplex has no polynomial bound; on random DAGs","type":"text"},{"text":" ","type":"text"},{"text":"with m = 2n its time grows about as n^1.5 to n^1.7. O(maxIterations ·","type":"text"},{"text":" ","type":"text"},{"text":"(N + M) log N) for crossing reduction over N vertices and bend points and M segments;","type":"text"},{"text":" ","type":"text"},{"text":"O(N + M) for coordinates.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"maxIterations ≥ 0","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"aside"}]}],"sections":[],"abstract":[{"text":"A layered drawing by the Sugiyama framework: every vertex on a horizontal layer, edges","type":"text"},{"text":" ","type":"text"},{"text":"pointing down, long edges bent through every layer they cross, few crossings.","type":"text"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/LayeredDrawing":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A layered drawing of a directed graph ("},{"type":"codeVoice","code":"DirectedGraph.sugiyamaLayout(…)"},{"type":"text","text":"): a position per"},{"type":"text","text":" "},{"type":"text","text":"vertex with y its layer, a layer per vertex, and bend points for every edge that crosses"},{"type":"text","text":" "},{"type":"text","text":"layers. Vertices and bend points in one layer are at least 1 apart; edges point down once the"},{"type":"text","text":" "},{"type":"text","text":"reversed ones are turned."}],"url":"\/documentation\/graphdrawing\/layereddrawing","navigatorTitle":[{"kind":"identifier","text":"LayeredDrawing"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LayeredDrawing"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/LayeredDrawing","title":"LayeredDrawing"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","title":"GraphProtocols"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/DirectedGraph/sugiyamaLayout(maxIterations:)":{"role":"symbol","url":"\/documentation\/graphdrawing\/graphprotocols\/directedgraph\/sugiyamalayout(maxiterations:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sugiyamaLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"LayeredDrawing","preciseIdentifier":"s:12GraphDrawing07LayeredB0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph\/sugiyamaLayout(maxIterations:)","type":"topic","abstract":[{"type":"text","text":"A layered drawing by the Sugiyama framework: every vertex on a horizontal layer, edges"},{"type":"text","text":" "},{"type":"text","text":"pointing down, long edges bent through every layer they cross, few crossings."}],"title":"sugiyamaLayout(maxIterations:)"},"doc://GraphDrawing/documentation/GraphDrawing":{"url":"\/documentation\/graphdrawing","type":"topic","kind":"symbol","title":"GraphDrawing","abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","role":"collection"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"title":"DirectedGraph","url":"\/documentation\/graphdrawing\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","text":"DirectedGraph"}],"kind":"symbol","role":"symbol","abstract":[]}}}