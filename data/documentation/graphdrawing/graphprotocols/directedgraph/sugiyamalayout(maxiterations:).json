{"metadata":{"title":"sugiyamaLayout(maxIterations:)","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","role":"symbol","externalID":"s:14GraphProtocols08DirectedA0P0A7DrawingE14sugiyamaLayout13maxIterationsAD07LayeredD0VyxGSi_tF","roleHeading":"Instance Method","symbolKind":"method","remoteSource":{"fileName":"SugiyamaLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SugiyamaLayout.swift#L43"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sugiyamaLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"LayeredDrawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing07LayeredB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph"]]},"sections":[],"abstract":[{"text":"A layered drawing by the Sugiyama framework: every vertex on a horizontal layer, edges","type":"text"},{"text":" ","type":"text"},{"text":"pointing down, long edges bent through every layer they cross, few crossings.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph\/sugiyamaLayout(maxIterations:)"},"kind":"symbol","variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/directedgraph\/sugiyamalayout(maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sugiyamaLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 100) -> "},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/LayeredDrawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing07LayeredB0V","text":"LayeredDrawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Cycles are broken by reversing the edges of ","type":"text"},{"code":"feedbackArcSet()","type":"codeVoice"},{"text":" (Eades, Lin and Smyth)","type":"text"},{"text":" ","type":"text"},{"text":"other than self-loops; a DAG reverses nothing. Self-loops are left out of the drawing.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Layers minimize the total edge span Σ (layer(target) − layer(source)) with every edge","type":"text"},{"text":" ","type":"text"},{"text":"spanning at least one layer, parallel edges counted each (Gansner et al.’s network","type":"text"},{"text":" ","type":"text"},{"text":"simplex, solved through its dual min-cost flow). Each weakly connected component starts","type":"text"},{"text":" ","type":"text"},{"text":"at layer 0. Where several layerings are optimal, which one is","type":"text"},{"text":" ","type":"text"},{"text":"chosen is not specified.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"An edge spanning k > 1 layers gets a bend point on each of the k − 1 between.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Crossings are reduced by barycenter sweeps: each layer starts with its vertices in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, then its bend points by edge position; a sweep sorts layers 1 … L−1 by","type":"text"},{"text":" ","type":"text"},{"text":"the mean position of each node’s neighbours in the layer above, then layers L−2 … 0 by","type":"text"},{"text":" ","type":"text"},{"text":"those below, stably, a node with no such neighbour keeping its position. The order with","type":"text"},{"text":" ","type":"text"},{"text":"the fewest crossings seen is kept. Sweeps stop at no crossings, when a sweep changes","type":"text"},{"text":" ","type":"text"},{"text":"nothing, or after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"x coordinates are Brandes and Köpf’s: four vertical alignments to median neighbours,","type":"text"},{"text":" ","type":"text"},{"text":"avoiding type-1 conflicts, each compacted by longest path over its blocks at separation","type":"text"},{"text":" ","type":"text"},{"text":"1, aligned to the narrowest, and averaged by the mean of the two median candidates.","type":"text"},{"text":" ","type":"text"},{"text":"Then the least x is 0, and y is the layer.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Layered drawing as a framework: Sugiyama, Tagawa and Toda, “Methods for visual"},{"type":"text","text":" "},{"type":"text","text":"understanding of hierarchical system structures”, IEEE Transactions on Systems, Man, and"},{"type":"text","text":" "},{"type":"text","text":"Cybernetics 11(2), 1981. Layering: Gansner, Koutsofios, North and Vo, “A technique for"},{"type":"text","text":" "},{"type":"text","text":"drawing directed graphs”, IEEE Transactions on Software Engineering 19(3), 1993."},{"type":"text","text":" "},{"type":"text","text":"Coordinates: Brandes and Köpf, “Fast and simple horizontal coordinate assignment”, Graph"},{"type":"text","text":" "},{"type":"text","text":"Drawing (GD 2001), LNCS 2265, 2002. The compaction is longest path rather than the paper’s"},{"type":"text","text":" "},{"type":"text","text":"class shifts, which Brandes, Walter and Zink show can violate the separation (“Erratum:"},{"type":"text","text":" "},{"type":"text","text":"Fast and simple horizontal coordinate assignment”, arXiv:2008.01252, 2020)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"O((n + m) log n) for cycle removal. Network simplex has no polynomial bound; on random DAGs"},{"type":"text","text":" "},{"type":"text","text":"with m = 2n its time grows about as n^1.5 to n^1.7. O(maxIterations ·"},{"type":"text","text":" "},{"type":"text","text":"(N + M) log N) for crossing reduction over N vertices and bend points and M segments;"},{"type":"text","text":" "},{"type":"text","text":"O(N + M) for coordinates."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"maxIterations ≥ 0"},{"type":"text","text":"."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"url":"\/documentation\/graphdrawing","type":"topic","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","kind":"symbol","title":"GraphDrawing","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier","text":"DirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"role":"symbol","abstract":[],"type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols\/directedgraph","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/DirectedGraph/sugiyamaLayout(maxIterations:)":{"role":"symbol","title":"sugiyamaLayout(maxIterations:)","type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols\/directedgraph\/sugiyamalayout(maxiterations:)","abstract":[{"text":"A layered drawing by the Sugiyama framework: every vertex on a horizontal layer, edges","type":"text"},{"text":" ","type":"text"},{"text":"pointing down, long edges bent through every layer they cross, few crossings.","type":"text"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/DirectedGraph\/sugiyamaLayout(maxIterations:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sugiyamaLayout"},{"kind":"text","text":"("},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing07LayeredB0V","text":"LayeredDrawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"title":"GraphProtocols","type":"topic","abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","kind":"symbol","role":"collection","url":"\/documentation\/graphdrawing\/graphprotocols"},"doc://GraphDrawing/documentation/GraphDrawing/LayeredDrawing":{"role":"symbol","title":"LayeredDrawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/LayeredDrawing","url":"\/documentation\/graphdrawing\/layereddrawing","abstract":[{"text":"A layered drawing of a directed graph (","type":"text"},{"code":"DirectedGraph.sugiyamaLayout(…)","type":"codeVoice"},{"text":"): a position per","type":"text"},{"text":" ","type":"text"},{"text":"vertex with y its layer, a layer per vertex, and bend points for every edge that crosses","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"layers. Vertices and bend points in one layer are at least 1 apart; edges point down once the"},{"type":"text","text":" "},{"type":"text","text":"reversed ones are turned."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LayeredDrawing","kind":"identifier"}],"navigatorTitle":[{"text":"LayeredDrawing","kind":"identifier"}]}}}