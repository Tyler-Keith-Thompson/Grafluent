{"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"A drawing whose distances match the graph’s: stress majorization, the minimizer of","type":"text"},{"text":" ","type":"text"},{"text":"Kamada and Kawai’s energy that Graphviz’s ","type":"text"},{"code":"neato","type":"codeVoice"},{"text":" uses by default.","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/stressmajorizationlayout(initial:edgelength:tolerance:maxiterations:)"]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/StressMajorizationLayout.swift#L39","fileName":"StressMajorizationLayout.swift"},"externalID":"s:14GraphProtocols0A0P0A7DrawingE24stressMajorizationLayout7initial10edgeLength9tolerance13maxIterationsAD0C0Vy6VertexQzGANSg_Sd5Edges_5IndexQZXESdSitF","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","symbolKind":"method","role":"symbol","roleHeading":"Instance Method"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 1000) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The target distance d_ij of two vertices is their shortest-path distance with "},{"code":"edgeLength","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(hops by default); between components it is 1 + L̄·√n, L̄ the mean edge length ("},{"code":"neato","type":"codeVoice"},{"type":"text","text":"‘s"},{"type":"text","text":" "},{"type":"text","text":"rule without packing). The drawing minimizes the stress Σ_{i<j} d_ij⁻² (‖x_i − x_j‖ − d_ij)²,"},{"type":"text","text":" "},{"type":"text","text":"which with these weights is Kamada and Kawai’s energy. Each step updates every vertex in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order to the minimizer of a majorant of the stress in that vertex (Gansner,"},{"type":"text","text":" "},{"type":"text","text":"Koren and North’s localized update), so the stress never increases. The run stops one step"},{"type":"text","text":" "},{"type":"text","text":"after a step that lowered the stress by at most "},{"code":"tolerance","type":"codeVoice"},{"type":"text","text":" times its value (each step"},{"type":"text","text":" "},{"type":"text","text":"measures its starting stress on the way), or after "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":" steps. The default"},{"type":"text","text":" "},{"type":"text","text":"tolerance, 10⁻⁴, is Graphviz’s "},{"code":"epsilon","type":"codeVoice"},{"type":"text","text":" for "},{"code":"neato -Gmode=major","type":"codeVoice"},{"type":"text","text":"; a smaller one can leave a"},{"type":"text","text":" "},{"type":"text","text":"plateau that 10⁻⁴ stops on (on a random 40-vertex graph, 10⁻⁵ ends 9% lower)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The start is "},{"type":"codeVoice","code":"initial"},{"type":"text","text":", or by default "},{"type":"codeVoice","code":"circularLayout(radius: L̄)"},{"type":"text","text":": NetworkX’s start for"},{"type":"text","text":" "},{"type":"text","text":"Kamada–Kawai, scaled by the mean edge length so that scaling every length by a power of 2"},{"type":"text","text":" "},{"type":"text","text":"scales every step’s drawing by exactly that factor (the update is homogeneous), and any"},{"type":"text","text":" "},{"type":"text","text":"other factor up to rounding. ("},{"type":"codeVoice","code":"neato -Gmode=major"},{"type":"text","text":", the like-for-like Graphviz run, starts"},{"type":"text","text":" "},{"type":"text","text":"from random positions.) Deterministic: no randomness anywhere. A directed graph is drawn"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"undirected"},{"type":"text","text":"."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gansner, Koren and North, “Graph drawing by stress majorization”, Graph Drawing (GD"},{"type":"text","text":" "},{"type":"text","text":"2004), LNCS 3383, 2005."}]}]},{"content":[{"inlineContent":[{"text":"Kamada and Kawai, “An algorithm for drawing general undirected graphs”, Information","type":"text"},{"text":" ","type":"text"},{"text":"Processing Letters 31(1), 1989.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the"},{"type":"text","text":" "},{"type":"text","text":"lengths differ), then O(n²) per step. The reciprocal target distances are kept in single"},{"type":"text","text":" "},{"type":"text","text":"precision for the pairs i < j only: 2n² bytes (200 MB at 10⁴ vertices), so "},{"type":"codeVoice","code":"stress"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"type":"text","text":"drawing are those of distances rounded to about 7 significant digits."}]},{"style":"note","name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"tolerance ≥ 0"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations ≥ 0"},{"type":"text","text":"; every vertex of the graph is in "},{"type":"codeVoice","code":"initial"},{"type":"text","text":", at a finite position,"},{"type":"text","text":" "},{"type":"text","text":"when it is given."}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing":{"abstract":[],"title":"GraphDrawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/graphdrawing"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"title":"Edges","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","abstract":[],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)":{"abstract":[{"type":"text","text":"A drawing whose distances match the graph’s: stress majorization, the minimizer of"},{"type":"text","text":" "},{"type":"text","text":"Kamada and Kawai’s energy that Graphviz’s "},{"type":"codeVoice","code":"neato"},{"type":"text","text":" uses by default."}],"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)