{"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 1000) -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The target distance d_ij of two vertices is their shortest-path distance with ","type":"text"},{"code":"edgeLength","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(hops by default); between components it is 1 + L̄·√n, L̄ the mean edge length. The drawing minimizes the stress Σ_{i<j} d_ij⁻² (‖x_i − x_j‖ − d_ij)²,","type":"text"},{"text":" ","type":"text"},{"text":"which with these weights is Kamada and Kawai’s energy. Each step updates every vertex in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order to the minimizer of a majorant of the stress in that vertex (Gansner,","type":"text"},{"text":" ","type":"text"},{"text":"Koren and North’s localized update), so the stress never increases. The run stops one step","type":"text"},{"text":" ","type":"text"},{"text":"after a step that lowered the stress by at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" times its value (each step","type":"text"},{"text":" ","type":"text"},{"text":"measures its starting stress on the way), or after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" steps. A tolerance","type":"text"},{"text":" ","type":"text"},{"text":"below the default 10⁻⁴ can carry the run past a plateau to a lower stress.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The start is ","type":"text"},{"code":"initial","type":"codeVoice"},{"text":", or by default ","type":"text"},{"code":"circularLayout(radius: L̄)","type":"codeVoice"},{"text":". Scaled by the mean edge","type":"text"},{"text":" ","type":"text"},{"text":"length, the default start makes scaling every length by a power of 2 scale every step’s","type":"text"},{"text":" ","type":"text"},{"text":"drawing by exactly that factor, and by any other factor up to rounding. The layout uses no","type":"text"},{"text":" ","type":"text"},{"text":"randomness. A directed graph is drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Gansner, Koren and North, “Graph drawing by stress majorization”, Graph Drawing (GD"},{"type":"text","text":" "},{"type":"text","text":"2004), LNCS 3383, 2005."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Kamada and Kawai, “An algorithm for drawing general undirected graphs”, Information"},{"type":"text","text":" "},{"type":"text","text":"Processing Letters 31(1), 1989."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the","type":"text"},{"text":" ","type":"text"},{"text":"lengths differ), then O(n²) per step. The reciprocal target distances are kept in single","type":"text"},{"text":" ","type":"text"},{"text":"precision for the pairs i < j only, 2n² bytes (200 MB at 10⁴ vertices). ","type":"text"},{"code":"stress","type":"codeVoice"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"drawing are those of distances rounded to about 7 significant digits.","type":"text"}]},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"tolerance ≥ 0"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations ≥ 0"},{"type":"text","text":"; every vertex of the graph is in "},{"type":"codeVoice","code":"initial"},{"type":"text","text":", at a finite position,"},{"type":"text","text":" "},{"type":"text","text":"when it is given."}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/stressmajorizationlayout(initial:edgelength:tolerance:maxiterations:)"]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P0A7DrawingE24stressMajorizationLayout7initial10edgeLength9tolerance13maxIterationsAD0C0Vy6VertexQzGANSg_Sd5Edges_5IndexQZXESdSitF","roleHeading":"Instance Method"},"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A drawing whose distances match the graph’s, by stress majorization."}],"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"url":"\/documentation\/graphdrawing","abstract":[],"kind":"symbol","role":"collection","title":"GraphDrawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"title":"Drawing","url":"\/documentation\/graphdrawing\/drawing"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)":{"url":"\/document