er":"s:Sd"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"kind":"symbol","title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"title":"Graph","abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphdrawing\/graphprotocols\/graph","type":"topic"}}}