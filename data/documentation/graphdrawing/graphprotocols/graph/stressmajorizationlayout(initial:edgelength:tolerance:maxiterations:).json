kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","role":"symbol","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"title":"Graph","type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","role":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","title":"GraphProtocols","role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/graphdrawing\/graphprotocols"}}}