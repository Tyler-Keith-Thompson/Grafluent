{"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"roleHeading":"Instance Method","extendedModule":"GraphProtocols","symbolKind":"method","role":"symbol","remoteSource":{"fileName":"StressMajorizationLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/StressMajorizationLayout.swift#L33"},"externalID":"s:14GraphProtocols0A0P0A7DrawingE24stressMajorizationLayout7initial10edgeLength9tolerance13maxIterationsAD0C0Vy6VertexQzGANSg_Sd5Edges_5IndexQZXESdSitF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/stressmajorizationlayout(initial:edgelength:tolerance:maxiterations:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-5, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 1000) -> "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The target distance d_ij of two vertices is their shortest-path distance with "},{"type":"codeVoice","code":"edgeLength"},{"type":"text","text":" "},{"type":"text","text":"(hops by default); between components it is 1 + L̄·√n, L̄ the mean edge length ("},{"type":"codeVoice","code":"neato"},{"type":"text","text":"‘s"},{"type":"text","text":" "},{"type":"text","text":"rule without packing). The drawing minimizes the stress Σ_{i<j} d_ij⁻² (‖x_i − x_j‖ − d_ij)²,"},{"type":"text","text":" "},{"type":"text","text":"which with these weights is Kamada and Kawai’s energy. Each step updates every vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order to the minimizer of a majorant of the stress in that vertex (Gansner,"},{"type":"text","text":" "},{"type":"text","text":"Koren and North’s localized update), so the stress never increases. The run stops one step"},{"type":"text","text":" "},{"type":"text","text":"after a step that lowered the stress by at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" times its value (each step"},{"type":"text","text":" "},{"type":"text","text":"measures its starting stress on the way), or after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" steps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start is "},{"type":"codeVoice","code":"initial"},{"type":"text","text":", or by default "},{"type":"codeVoice","code":"circularLayout(radius: L̄)"},{"type":"text","text":", NetworkX’s start for"},{"type":"text","text":" "},{"type":"text","text":"Kamada–Kawai scaled by the mean edge length (Graphviz’s practice), so that scaling every"},{"type":"text","text":" "},{"type":"text","text":"length scales the drawing. Deterministic: no randomness anywhere. A directed graph is drawn"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"undirected"},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Gansner, Koren and North, “Graph drawing by stress majorization”, Graph Drawing (GD"},{"type":"text","text":" "},{"type":"text","text":"2004), LNCS 3383, 2005."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Kamada and Kawai, “An algorithm for drawing general undirected graphs”, Information"},{"type":"text","text":" "},{"type":"text","text":"Processing Letters 31(1), 1989."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the"},{"type":"text","text":" "},{"type":"text","text":"lengths differ), then O(n²) per step; O(n²) memory, so for graphs up to about 10⁴"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"tolerance ≥ 0"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations ≥ 0"},{"type":"text","text":"; every vertex of the graph is in "},{"type":"codeVoice","code":"initial"},{"type":"text","text":" when it is given."}],"type":"paragraph"}],"type":"aside"}]}],"abstract":[{"text":"A drawing whose distances match the graph’s: stress majorization, the minimizer of","type":"text"},{"text":" ","type":"text"},{"text":"Kamada and Kawai’s energy that Graphviz’s ","type":"text"},{"code":"neato","type":"codeVoice"},{"text":" uses by default.","type":"text"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"type":"topic","url":"\/documentation\/graphdrawing\/drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"symbol","title":"Drawing","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drawing"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":