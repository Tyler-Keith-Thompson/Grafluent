:"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"kind":"symbol","url":"\/documentation\/graphdrawing\/drawing","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","type":"topic","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"title":"Drawing"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","title":"Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"type":"topic"}}}