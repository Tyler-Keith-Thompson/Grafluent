{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A drawing whose distances match the graph’s, by stress majorization."}],"metadata":{"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"externalID":"s:14GraphProtocols0A0P0A7DrawingE24stressMajorizationLayout7initial10edgeLength9tolerance13maxIterationsAD0C0Vy6VertexQzGANSg_Sd5Edges_5IndexQZXESdSitF","extendedModule":"GraphProtocols","roleHeading":"Instance Method","role":"symbol","symbolKind":"method","remoteSource":{"fileName":"StressMajorizationLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/StressMajorizationLayout.swift#L34"}},"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/stressmajorizationlayout(initial:edgelength:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" = 1000) -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The target distance d_ij of two vertices is their shortest-path distance with ","type":"text"},{"type":"codeVoice","code":"edgeLength"},{"text":" ","type":"text"},{"text":"(hops by default); between components it is 1 + L̄·√n, L̄ the mean edge length. The drawing minimizes the stress Σ_{i<j} d_ij⁻² (‖x_i − x_j‖ − d_ij)²,","type":"text"},{"text":" ","type":"text"},{"text":"which with these weights is Kamada and Kawai’s energy. Each step updates every vertex in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order to the minimizer of a majorant of the stress in that vertex (Gansner,","type":"text"},{"text":" ","type":"text"},{"text":"Koren and North’s localized update), so the stress never increases. The run stops one step","type":"text"},{"text":" ","type":"text"},{"text":"after a step that lowered the stress by at most ","type":"text"},{"type":"codeVoice","code":"tolerance"},{"text":" times its value (each step","type":"text"},{"text":" ","type":"text"},{"text":"measures its starting stress on the way), or after ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" steps. A tolerance","type":"text"},{"text":" ","type":"text"},{"text":"below the default 10⁻⁴ can carry the run past a plateau to a lower stress.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The start is "},{"code":"initial","type":"codeVoice"},{"type":"text","text":", or by default "},{"code":"circularLayout(radius: L̄)","type":"codeVoice"},{"type":"text","text":". Scaled by the mean edge"},{"type":"text","text":" "},{"type":"text","text":"length, the default start makes scaling every length by a power of 2 scale every step’s"},{"type":"text","text":" "},{"type":"text","text":"drawing by exactly that factor, and by any other factor up to rounding. The layout uses no"},{"type":"text","text":" "},{"type":"text","text":"randomness. A directed graph is drawn through "},{"code":"undirectedView","type":"codeVoice"},{"type":"text","text":"."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Gansner, Koren and North, “Graph drawing by stress majorization”, Graph Drawing (GD","type":"text"},{"text":" ","type":"text"},{"text":"2004), LNCS 3383, 2005.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Kamada and Kawai, “An algorithm for drawing general undirected graphs”, Information"},{"type":"text","text":" "},{"type":"text","text":"Processing Letters 31(1), 1989."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the","type":"text"},{"text":" ","type":"text"},{"text":"lengths differ), then O(n²) per step. The reciprocal target distances are kept in single","type":"text"},{"text":" ","type":"text"},{"text":"precision for the pairs i < j only, 2n² bytes (200 MB at 10⁴ vertices). ","type":"text"},{"type":"codeVoice","code":"stress"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"drawing are those of distances rounded to about 7 significant digits.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"tolerance ≥ 0"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations ≥ 0"},{"type":"text","text":"; every vertex of the graph is in "},{"type":"codeVoice","code":"initial"},{"type":"text","text":", at a finite position,"},{"type":"text","text":" "},{"type":"text","text":"when it is given."}]}],"name":"Precondition","type":"aside","style":"note"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"url":"\/documentation\/graphdrawing\/drawing","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","type":"topic","title":"Drawing","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","preciseIdentifier":"s:Sl","kind":"typeIdentifier"}],"title":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://GraphDrawing/documentation/GraphDrawing":{"url":"\/documentation\/graphdrawing","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","type":"topic","title":"GraphDrawing","abstract":[],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)":{"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","kind":"symbol","role":"symbol","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/stressmajorizationlayout(initial:edgelength:tolerance:maxiterati