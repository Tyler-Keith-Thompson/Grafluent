{"abstract":[{"text":"A drawing whose distances match the graph’s: stress majorization, the minimizer of","type":"text"},{"text":" ","type":"text"},{"text":"Kamada and Kawai’s energy that Graphviz’s ","type":"text"},{"code":"neato","type":"codeVoice"},{"text":" uses by default.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/stressmajorizationlayout(initial:edgelength:tolerance:maxiterations:)"]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"symbolKind":"method","roleHeading":"Instance Method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P0A7DrawingE24stressMajorizationLayout7initial10edgeLength9tolerance13maxIterationsAD0C0Vy6VertexQzGANSg_Sd5Edges_5IndexQZXESdSitF","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/StressMajorizationLayout.swift#L39","fileName":"StressMajorizationLayout.swift"},"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)"},"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 1000) -> "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The target distance d_ij of two vertices is their shortest-path distance with ","type":"text"},{"code":"edgeLength","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(hops by default); between components it is 1 + L̄·√n, L̄ the mean edge length (","type":"text"},{"code":"neato","type":"codeVoice"},{"text":"‘s","type":"text"},{"text":" ","type":"text"},{"text":"rule without packing). The drawing minimizes the stress Σ_{i<j} d_ij⁻² (‖x_i − x_j‖ − d_ij)²,","type":"text"},{"text":" ","type":"text"},{"text":"which with these weights is Kamada and Kawai’s energy. Each step updates every vertex in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order to the minimizer of a majorant of the stress in that vertex (Gansner,","type":"text"},{"text":" ","type":"text"},{"text":"Koren and North’s localized update), so the stress never increases. The run stops one step","type":"text"},{"text":" ","type":"text"},{"text":"after a step that lowered the stress by at most ","type":"text"},{"code":"tolerance","type":"codeVoice"},{"text":" times its value (each step","type":"text"},{"text":" ","type":"text"},{"text":"measures its starting stress on the way), or after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" steps. The default","type":"text"},{"text":" ","type":"text"},{"text":"tolerance, 10⁻⁴, is Graphviz’s ","type":"text"},{"code":"epsilon","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"neato -Gmode=major","type":"codeVoice"},{"text":"; a smaller one can leave a","type":"text"},{"text":" ","type":"text"},{"text":"plateau that 10⁻⁴ stops on (on a random 40-vertex graph, 10⁻⁵ ends 9% lower).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start is "},{"code":"initial","type":"codeVoice"},{"type":"text","text":", or by default "},{"code":"circularLayout(radius: L̄)","type":"codeVoice"},{"type":"text","text":": NetworkX’s start for"},{"type":"text","text":" "},{"type":"text","text":"Kamada–Kawai, scaled by the mean edge length so that scaling every length by a power of 2"},{"type":"text","text":" "},{"type":"text","text":"scales every step’s drawing by exactly that factor (the update is homogeneous), and any"},{"type":"text","text":" "},{"type":"text","text":"other factor up to rounding. ("},{"code":"neato -Gmode=major","type":"codeVoice"},{"type":"text","text":", the like-for-like Graphviz run, starts"},{"type":"text","text":" "},{"type":"text","text":"from random positions.) Deterministic: no randomness anywhere. A directed graph is drawn"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"undirected","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gansner, Koren and North, “Graph drawing by stress majorization”, Graph Drawing (GD"},{"type":"text","text":" "},{"type":"text","text":"2004), LNCS 3383, 2005."}]}]},{"content":[{"inlineContent":[{"text":"Kamada and Kawai, “An algorithm for drawing general undirected graphs”, Information","type":"text"},{"text":" ","type":"text"},{"text":"Processing Letters 31(1), 1989.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the"},{"type":"text","text":" "},{"type":"text","text":"lengths differ), then O(n²) per step. The reciprocal target distances are kept in single"},{"type":"text","text":" "},{"type":"text","text":"precision for the pairs i < j only: 2n² bytes (200 MB at 10⁴ vertices), so "},{"code":"stress","type":"codeVoice"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"type":"text","text":"drawing are those of distances rounded to about 7 significant digits."}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"text":"Every edge length is positive and finite; ","type":"text"},{"code":"tolerance ≥ 0","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"code":"maxIterations ≥ 0","type":"codeVoice"},{"text":"; every vertex of the graph is in ","type":"text"},{"code":"initial","type":"codeVoice"},{"text":", at a finite position,","type":"text"},{"text":" ","type":"text"},{"text":"when it is given.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","title":"Edges","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl","text":"Collection"}],"type":"topic","role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)":{"abstract":[{"type":"text","text":"A drawing whose distances match the graph’s: stress majorization, the minimizer of"},{"type":"text","text":" "},{"type":"text","text":"Kamada and Kawai’s energy that Graphviz’s "},{"type":"codeVoice","code":"neato"},{"type":"text","text":" uses by default."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text"