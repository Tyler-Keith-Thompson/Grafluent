{"metadata":{"externalID":"s:14GraphProtocols0A0P0A7DrawingE24stressMajorizationLayout7initial10edgeLength9tolerance13maxIterationsAD0C0Vy6VertexQzGANSg_Sd5Edges_5IndexQZXESdSitF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stressMajorizationLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"initial","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">?, ","kind":"text"},{"text":"edgeLength","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"symbolKind":"method","title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/StressMajorizationLayout.swift#L34","fileName":"StressMajorizationLayout.swift"},"extendedModule":"GraphProtocols"},"sections":[],"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/stressmajorizationlayout(initial:edgelength:tolerance:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stressMajorizationLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">? = nil, "},{"kind":"externalParam","text":"edgeLength"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 1000) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The target distance d_ij of two vertices is their shortest-path distance with "},{"type":"codeVoice","code":"edgeLength"},{"type":"text","text":" "},{"type":"text","text":"(hops by default); between components it is 1 + L̄·√n, L̄ the mean edge length. The drawing minimizes the stress Σ_{i<j} d_ij⁻² (‖x_i − x_j‖ − d_ij)²,"},{"type":"text","text":" "},{"type":"text","text":"which with these weights is Kamada and Kawai’s energy. Each step updates every vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order to the minimizer of a majorant of the stress in that vertex (Gansner,"},{"type":"text","text":" "},{"type":"text","text":"Koren and North’s localized update), so the stress never increases. The run stops one step"},{"type":"text","text":" "},{"type":"text","text":"after a step that lowered the stress by at most "},{"type":"codeVoice","code":"tolerance"},{"type":"text","text":" times its value (each step"},{"type":"text","text":" "},{"type":"text","text":"measures its starting stress on the way), or after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" steps. A tolerance"},{"type":"text","text":" "},{"type":"text","text":"below the default 10⁻⁴ can carry the run past a plateau to a lower stress."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start is "},{"type":"codeVoice","code":"initial"},{"type":"text","text":", or by default "},{"type":"codeVoice","code":"circularLayout(radius: L̄)"},{"type":"text","text":". Scaled by the mean edge"},{"type":"text","text":" "},{"type":"text","text":"length, the default start makes scaling every length by a power of 2 scale every step’s"},{"type":"text","text":" "},{"type":"text","text":"drawing by exactly that factor, and by any other factor up to rounding. The layout uses no"},{"type":"text","text":" "},{"type":"text","text":"randomness. A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gansner, Koren and North, “Graph drawing by stress majorization”, Graph Drawing (GD"},{"type":"text","text":" "},{"type":"text","text":"2004), LNCS 3383, 2005."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Kamada and Kawai, “An algorithm for drawing general undirected graphs”, Information"},{"type":"text","text":" "},{"type":"text","text":"Processing Letters 31(1), 1989."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the"},{"type":"text","text":" "},{"type":"text","text":"lengths differ), then O(n²) per step. The reciprocal target distances are kept in single"},{"type":"text","text":" "},{"type":"text","text":"precision for the pairs i < j only, 2n² bytes (200 MB at 10⁴ vertices). "},{"type":"codeVoice","code":"stress"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"type":"text","text":"drawing are those of distances rounded to about 7 significant digits."}],"type":"paragraph"},{"name":"Precondition","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"tolerance ≥ 0"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"codeVoice","code":"maxIterations ≥ 0"},{"type":"text","text":"; every vertex of the graph is in "},{"type":"codeVoice","code":"initial"},{"type":"text","text":", at a finite position,"},{"type":"text","text":" "},{"type":"text","text":"when it is given."}]}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"A drawing whose distances match the graph’s, by stress majorization.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)":{"title":"stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","abstract":[{"text":"A drawing whose distances match the graph’s, by stress majorization.","type":"text"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/stressMajorizationLayout(initial:edgeLength:tolerance:maxIterations:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stressMajorizationLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"initial","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"