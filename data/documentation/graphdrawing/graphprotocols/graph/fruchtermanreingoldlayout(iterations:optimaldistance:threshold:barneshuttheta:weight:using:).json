{"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 50, ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1e-4, ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force","type":"text"},{"text":" ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" · d²\/k, where d is their distance (at least 0.01) and k is ","type":"text"},{"code":"optimalDistance","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(default √(1\/n)). Each step moves every vertex along its net force by at most the","type":"text"},{"text":" ","type":"text"},{"text":"temperature, which starts at a tenth of the larger side of the start’s bounding box (k\/10","type":"text"},{"text":" ","type":"text"},{"text":"when every vertex starts at one point) and falls by the same amount each step, reaching 0","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"code":"iterations + 1","type":"codeVoice"},{"text":" steps. Two vertices at exactly the same point repel as if 0.01","type":"text"},{"text":" ","type":"text"},{"text":"apart, along a direction fixed by their two ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" offsets, so coincident vertices","type":"text"},{"text":" ","type":"text"},{"text":"separate deterministically. The run stops after ","type":"text"},{"code":"iterations","type":"codeVoice"},{"text":" steps, or earlier once the","type":"text"},{"text":" ","type":"text"},{"text":"moves’ root-sum-square divided by n is below ","type":"text"},{"code":"threshold","type":"codeVoice"},{"text":". Self-loops are ignored; parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"add their weights. The drawing is in layout units (vertices end about k apart), not","type":"text"},{"text":" ","type":"text"},{"text":"rescaled. A directed graph is drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"type":"codeVoice","code":"next()"},{"type":"text","text":". The same generator state gives the same drawing. Positions are"},{"type":"text","text":" "},{"type":"text","text":"not stable across library versions, because the iteration is chaotic and any change in"},{"type":"text","text":" "},{"type":"text","text":"summation order changes its digits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices."},{"type":"text","text":" "},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"type":"text","text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a"},{"type":"text","text":" "},{"type":"text","text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does"},{"type":"text","text":" "},{"type":"text","text":"not contain the vertex, acts as one body when s\/D < θ. θ = 1.2 suits graphs past about 5,000 vertices;"},{"type":"text","text":" "},{"type":"text","text":"θ = 0 is exact repulsion."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice","type":"text"},{"text":" ","type":"text"},{"text":"and Experience 21(11), 1991.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,","type":"text"},{"text":" ","type":"text"},{"text":"1986.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"memory.","type":"text"}]},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"iterations ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"optimalDistance","type":"codeVoice"},{"text":", when given, is positive and finite;","type":"text"},{"text":" ","type":"text"},{"code":"threshold ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"barnesHutTheta","type":"codeVoice"},{"text":", when given, is finite and not negative; every weight","type":"text"},{"text":" ","type":"text"},{"text":"is finite and not negative.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"metadata":{"symbolKind":"method","externalID":"s:14GraphProtocols0A0P0A7DrawingE25fruchtermanReingoldLayout10iterations15optimalDistance9threshold14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_SdSgSdAQSd5Edges_5IndexQZXEqd__ztSGRd__lF","roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/FruchtermanReingoldLayout.swift#L42","fileName":"FruchtermanReingoldLayout.swift"},"extendedModule":"GraphProtocols","title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","fragments":[{"text":"func","kind":"keyword"},{"text":" "