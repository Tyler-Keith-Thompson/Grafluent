{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fruchtermanReingoldLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"optimalDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" · d²\/k, where d is their distance (at least 0.01) and k is "},{"type":"codeVoice","code":"optimalDistance"},{"type":"text","text":" "},{"type":"text","text":"(default √(1\/n), NetworkX’s). Each step moves every vertex along its net force by at most"},{"type":"text","text":" "},{"type":"text","text":"the temperature, which starts at a tenth of the larger side of the start’s bounding box"},{"type":"text","text":" "},{"type":"text","text":"(k\/10 when every vertex starts at one point) and falls by the same amount each step,"},{"type":"text","text":" "},{"type":"text","text":"reaching 0 after "},{"type":"codeVoice","code":"iterations + 1"},{"type":"text","text":" steps (NetworkX’s schedule). Two vertices at exactly the"},{"type":"text","text":" "},{"type":"text","text":"same point repel as if 0.01 apart, along a direction fixed by their two "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"offsets, so a start with coincident vertices separates them deterministically. The run stops after "},{"type":"codeVoice","code":"iterations"},{"type":"text","text":" steps, or earlier once the moves’"},{"type":"text","text":" "},{"type":"text","text":"root-sum-square divided by n is below "},{"type":"codeVoice","code":"threshold"},{"type":"text","text":". Self-loops are ignored; parallel edges"},{"type":"text","text":" "},{"type":"text","text":"add their weights. The drawing is in layout units (vertices end about k apart), not"},{"type":"text","text":" "},{"type":"text","text":"rescaled. A directed graph is drawn through "},{"type":"codeVoice","code":"undirected"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The start takes exactly 2n draws: x then y for each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, each the","type":"text"},{"text":" ","type":"text"},{"text":"top 53 bits of one ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":". The same generator state gives the same drawing; positions are","type":"text"},{"text":" ","type":"text"},{"text":"otherwise not stable across library versions, as any change in summation order changes","type":"text"},{"text":" ","type":"text"},{"text":"the digits of a chaotic iteration without changing its quality.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices."},{"type":"text","text":" "},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"type":"text","text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a"},{"type":"text","text":" "},{"type":"text","text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does"},{"type":"text","text":" "},{"type":"text","text":"not contain the vertex, acts as one body when s\/D < θ. 1.2 is a common choice past about"},{"type":"text","text":" "},{"type":"text","text":"5,000 vertices; θ = 0 is exact repulsion."}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice"},{"type":"text","text":" "},{"type":"text","text":"and Experience 21(11), 1991."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,"},{"type":"text","text":" "},{"type":"text","text":"1986."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"memory.","type":"text"}]},{"name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"iterations ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"optimalDistance","type":"codeVoice"},{"text":", when given, is positive and finite;","type":"text"},{"text":" ","type":"text"},{"code":"threshold ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"barnesHutTheta","type":"codeVoice"},{"text":", when given, is finite and not negative; every weight","type":"text"},{"text":" ","type":"text"},{"text":"is finite and not negative.","type":"text"}]}],"type":"aside"}]}],"abstract":[{"text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions","type":"text"},{"text":" ","type":"text"},{"text":"drawn uniformly in [0, 1)² from ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":".","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtoc