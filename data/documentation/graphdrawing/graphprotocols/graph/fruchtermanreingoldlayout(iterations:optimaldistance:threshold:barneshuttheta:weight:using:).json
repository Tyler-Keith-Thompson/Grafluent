"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions"},{"type":"text","text":" "},{"type":"text","text":"drawn uniformly in [0, 1)² from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":" = 50, ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 1e-4, ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SG","text":"RandomNumberGenerator","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force","type":"text"},{"text":" ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" · d²\/k, where d is their distance (at least 0.01) and k is ","type":"text"},{"code":"optimalDistance","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(default √(1\/n)). Each step moves every vertex along its net force by at most the","type":"text"},{"text":" ","type":"text"},{"text":"temperature, which starts at a tenth of the larger side of the start’s bounding box (k\/10","type":"text"},{"text":" ","type":"text"},{"text":"when every vertex starts at one point) and falls by the same amount each step, reaching 0","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"code":"iterations + 1","type":"codeVoice"},{"text":" steps. Two vertices at exactly the same point repel as if 0.01","type":"text"},{"text":" ","type":"text"},{"text":"apart, along a direction fixed by their two ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" offsets, so coincident vertices","type":"text"},{"text":" ","type":"text"},{"text":"separate deterministically. The run stops after ","type":"text"},{"code":"iterations","type":"codeVoice"},{"text":" steps, or earlier once the","type":"text"},{"text":" ","type":"text"},{"text":"moves’ root-sum-square divided by n is below ","type":"text"},{"code":"threshold","type":"codeVoice"},{"text":". Self-loops are ignored; parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"add their weights. The drawing is in layout units (vertices end about k apart), not","type":"text"},{"text":" ","type":"text"},{"text":"rescaled. A directed graph is drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The start takes exactly 2n draws: x then y for each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, each the","type":"text"},{"text":" ","type":"text"},{"text":"top 53 bits of one ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":". The same generator state gives the same drawing. Positions are","type":"text"},{"text":" ","type":"text"},{"text":"not stable across library versions, because the iteration is chaotic and any change in","type":"text"},{"text":" ","type":"text"},{"text":"summation order changes its digits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices."},{"type":"text","text":" "},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"type":"text","text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a"},{"type":"text","text":" "},{"type":"text","text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does"},{"type":"text","text":" "},{"type":"text","text":"not contain the vertex, acts as one body when s\/D < θ. θ = 1.2 suits graphs past about 5,000 vertices;"},{"type":"text","text":" "},{"type":"text","text":"θ = 0 is exact repulsion."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice","type":"text"},{"text":" ","type":"text"},{"text":"and Experience 21(11), 1991.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,","type":"text"},{"text":" ","type":"text"},{"text":"1986.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"iterations ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"optimalDistance","type":"codeVoice"},{"text":", when given, is positive and finite;","type":"text"},{"text":" ","type":"text"},{"code":"threshold ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"barnesHutTheta","type":"codeVoice"},{"text":", when given, is finite and not negative; every weight","type":"text"},{"text":" ","type":"text"},{"text":"is finite and not negative.","type":"text"}],"type":"paragraph"}],"name":"Precondition","style":"note","type":"aside"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","type":"topic","title":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing":{"abstract":[],"url":"\/documentation\/graphdrawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","title":"GraphDrawing","kind":"symbol","type":"topic","role":"collection"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"kind":"symbol","url":"\/documentation\/graphdrawing\/graphprotocols","type":"topic","title":"GraphProtocols","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","role":"collection","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"url":"\/documentation\/graphdrawing\/drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","title":"Drawing","kind":"symbol","type":"topic","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","url":"\/documentation\/graphdrawing\/graphprotocols\/graph","title":"Graph","kind":"symbol","type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","role":"symbol","title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","abstract":[{"text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions","type":"text"},{"text":" ","type":"text"},{"text":"drawn uniformly in [0, 1)² from ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":".","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"tex