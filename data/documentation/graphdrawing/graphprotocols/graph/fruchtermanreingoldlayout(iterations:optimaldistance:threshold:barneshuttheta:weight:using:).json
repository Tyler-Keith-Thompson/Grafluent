{"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","extendedModule":"GraphProtocols","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:14GraphProtocols0A0P0A7DrawingE25fruchtermanReingoldLayout10iterations15optimalDistance9threshold14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_SdSgSdAQSd5Edges_5IndexQZXEqd__ztSGRd__lF","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/FruchtermanReingoldLayout.swift#L42","fileName":"FruchtermanReingoldLayout.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"abstract":[{"text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions","type":"text"},{"text":" ","type":"text"},{"text":"drawn uniformly in [0, 1)² from ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fruchtermanReingoldLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"optimalDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force","type":"text"},{"text":" ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" · d²\/k, where d is their distance (at least 0.01) and k is ","type":"text"},{"code":"optimalDistance","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(default √(1\/n), NetworkX’s). Each step moves every vertex along its net force by at most","type":"text"},{"text":" ","type":"text"},{"text":"the temperature, which starts at a tenth of the larger side of the start’s bounding box","type":"text"},{"text":" ","type":"text"},{"text":"(k\/10 when every vertex starts at one point) and falls by the same amount each step,","type":"text"},{"text":" ","type":"text"},{"text":"reaching 0 after ","type":"text"},{"code":"iterations + 1","type":"codeVoice"},{"text":" steps (NetworkX’s schedule). Two vertices at exactly the","type":"text"},{"text":" ","type":"text"},{"text":"same point repel as if 0.01 apart, along a direction fixed by their two ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"offsets, so a start with coincident vertices separates them deterministically. The run stops after ","type":"text"},{"code":"iterations","type":"codeVoice"},{"text":" steps, or earlier once the moves’","type":"text"},{"text":" ","type":"text"},{"text":"root-sum-square divided by n is below ","type":"text"},{"code":"threshold","type":"codeVoice"},{"text":". Self-loops are ignored; parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"add their weights. The drawing is in layout units (vertices end about k apart), not","type":"text"},{"text":" ","type":"text"},{"text":"rescaled. A directed graph is drawn through ","type":"text"},{"code":"undirected","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"code":"next()","type":"codeVoice"},{"type":"text","text":". The same generator state gives the same drawing; positions are"},{"type":"text","text":" "},{"type":"text","text":"otherwise not stable across library versions, as any change in summation order changes"},{"type":"text","text":" "},{"type":"text","text":"the digits of a chaotic iteration without changing its quality."}],"type":"paragraph"},{"inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices.","type":"text"},{"text":" ","type":"text"},{"code":"barnesHutTheta: θ","type":"codeVoice"},{"text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a","type":"text"},{"text":" ","type":"text"},{"text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does","type":"text"},{"text":" ","type":"text"},{"text":"not contain the vertex, acts as one body when s\/D < θ. 1.2 is a common choice past about","type":"text"},{"text":" ","type":"text"},{"text":"5,000 vertices; θ = 0 is exact repulsion.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice"},{"type":"text","text":" "},{"type":"text","text":"and Experience 21(11), 1991."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,"},{"type":"text","text":" "},{"type":"text","text":"1986."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"memory.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"iterations ≥ 0","type":"codeVoice"},{"type":"text","text":"; "},{"code":"optimalDistance","type":"codeVoice"},{"type":"text","text":", when given, is positive and finite;"},{"type":"text","text":" "},{"code":"threshold ≥ 0","type":"codeVoice"},{"type":"text","text":"; "},{"code":"barnesHutTheta","type":"codeVoice"},{"type":"text","text":", when given, is finite and not negative; every weight"},{"type":"text","text":" "},{"type":"text","text":"is finite and not negative."}]}],"type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)"},"sections":[],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","kind":"symbol","role":"symbol","title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","type":"topic","abstract":[{"type":"text","text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions"},{"type":"text","text":" "},{"type":"text","text":"drawn uniformly in [0, 1)² from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":"."}],"url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"optimalDistance","kind