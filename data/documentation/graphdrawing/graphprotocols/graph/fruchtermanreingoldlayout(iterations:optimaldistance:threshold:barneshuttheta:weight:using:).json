{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)"]}],"metadata":{"role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"externalID":"s:14GraphProtocols0A0P0A7DrawingE25fruchtermanReingoldLayout10iterations15optimalDistance9threshold14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_SdSgSdAQSd5Edges_5IndexQZXEqd__ztSGRd__lF","extendedModule":"GraphProtocols","remoteSource":{"fileName":"FruchtermanReingoldLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/FruchtermanReingoldLayout.swift#L42"},"title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fruchtermanReingoldLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"optimalDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SG","kind":"typeIdentifier","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 50, ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? = nil, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-4, ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · d²\/k, where d is their distance (at least 0.01) and k is ","type":"text"},{"type":"codeVoice","code":"optimalDistance"},{"text":" ","type":"text"},{"text":"(default √(1\/n)). Each step moves every vertex along its net force by at most the","type":"text"},{"text":" ","type":"text"},{"text":"temperature, which starts at a tenth of the larger side of the start’s bounding box (k\/10","type":"text"},{"text":" ","type":"text"},{"text":"when every vertex starts at one point) and falls by the same amount each step, reaching 0","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"type":"codeVoice","code":"iterations + 1"},{"text":" steps. Two vertices at exactly the same point repel as if 0.01","type":"text"},{"text":" ","type":"text"},{"text":"apart, along a direction fixed by their two ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" offsets, so coincident vertices","type":"text"},{"text":" ","type":"text"},{"text":"separate deterministically. The run stops after ","type":"text"},{"type":"codeVoice","code":"iterations"},{"text":" steps, or earlier once the","type":"text"},{"text":" ","type":"text"},{"text":"moves’ root-sum-square divided by n is below ","type":"text"},{"type":"codeVoice","code":"threshold"},{"text":". Self-loops are ignored; parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"add their weights. The drawing is in layout units (vertices end about k apart), not","type":"text"},{"text":" ","type":"text"},{"text":"rescaled. A directed graph is drawn through ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The start takes exactly 2n draws: x then y for each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, each the","type":"text"},{"text":" ","type":"text"},{"text":"top 53 bits of one ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":". The same generator state gives the same drawing. Positions are","type":"text"},{"text":" ","type":"text"},{"text":"not stable across library versions, because the iteration is chaotic and any change in","type":"text"},{"text":" ","type":"text"},{"text":"summation order changes its digits.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices."},{"type":"text","text":" "},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"type":"text","text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a"},{"type":"text","text":" "},{"type":"text","text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does"},{"type":"text","text":" "},{"type":"text","text":"not contain the vertex, acts as one body when s\/D < θ. θ = 1.2 suits graphs past about 5,000 vertices;"},{"type":"text","text":" "},{"type":"text","text":"θ = 0 is exact repulsion."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice","type":"text"},{"text":" ","type":"text"},{"text":"and Experience 21(11), 1991.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,","type":"text"},{"text":" ","type":"text"},{"text":"1986.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"name":"Precondition","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"iterations ≥ 0"},{"type":"text","text":"; "},{"type":"codeVoice","code":"optimalDistance"},{"type":"text","text":", when given, is positive and finite;"},{"type":"text","text":" "},{"type":"codeVoice","code":"threshold ≥ 0"},{"type":"text","text":"; "},{"type":"codeVoice","code":"barnesHutTheta"},{"type":"text","text":", when given, is finite and not negative; every weight"},{"type":"text","text":" "},{"type":"text","text":"is finite and not negative."}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions"},{"type":"text","text":" "},{"type":"text","text":"drawn uniformly in [0, 1)² from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"references":{"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"url":"\/documentation\/graphdrawing\/drawing","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"title":"Drawing","kind":"symbol","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"url":"\/documentation\/graphdrawing\/graphprotocols\/graph","kind":"symbol","type":"topic","title":"Graph","role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"url":"\/documentation\/graphdrawing\/graphprotocols","identifier":"doc:\/\/GraphDrawing\/docu