{"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"kind":"symbol","abstract":[{"type":"text","text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions"},{"type":"text","text":" "},{"type":"text","text":"drawn uniformly in [0, 1)² from "},{"code":"generator","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"remoteSource":{"fileName":"FruchtermanReingoldLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/FruchtermanReingoldLayout.swift#L42"},"externalID":"s:14GraphProtocols0A0P0A7DrawingE25fruchtermanReingoldLayout10iterations15optimalDistance9threshold14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_SdSgSdAQSd5Edges_5IndexQZXEqd__ztSGRd__lF","extendedModule":"GraphProtocols"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fruchtermanReingoldLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"optimalDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" · d²\/k, where d is their distance (at least 0.01) and k is "},{"type":"codeVoice","code":"optimalDistance"},{"type":"text","text":" "},{"type":"text","text":"(default √(1\/n)). Each step moves every vertex along its net force by at most the"},{"type":"text","text":" "},{"type":"text","text":"temperature, which starts at a tenth of the larger side of the start’s bounding box (k\/10"},{"type":"text","text":" "},{"type":"text","text":"when every vertex starts at one point) and falls by the same amount each step, reaching 0"},{"type":"text","text":" "},{"type":"text","text":"after "},{"type":"codeVoice","code":"iterations + 1"},{"type":"text","text":" steps. Two vertices at exactly the same point repel as if 0.01"},{"type":"text","text":" "},{"type":"text","text":"apart, along a direction fixed by their two "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offsets, so coincident vertices"},{"type":"text","text":" "},{"type":"text","text":"separate deterministically. The run stops after "},{"type":"codeVoice","code":"iterations"},{"type":"text","text":" steps, or earlier once the"},{"type":"text","text":" "},{"type":"text","text":"moves’ root-sum-square divided by n is below "},{"type":"codeVoice","code":"threshold"},{"type":"text","text":". Self-loops are ignored; parallel edges"},{"type":"text","text":" "},{"type":"text","text":"add their weights. The drawing is in layout units (vertices end about k apart), not"},{"type":"text","text":" "},{"type":"text","text":"rescaled. A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"code":"next()","type":"codeVoice"},{"type":"text","text":". The same generator state gives the same drawing. Positions are"},{"type":"text","text":" "},{"type":"text","text":"not stable across library versions, because the iteration is chaotic and any change in"},{"type":"text","text":" "},{"type":"text","text":"summation order changes its digits."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices."},{"type":"text","text":" "},{"code":"barnesHutTheta: θ","type":"codeVoice"},{"type":"text","text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a"},{"type":"text","text":" "},{"type":"text","text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does"},{"type":"text","text":" "},{"type":"text","text":"not contain the vertex, acts as one body when s\/D < θ. θ = 1.2 suits graphs past about 5,000 vertices;"},{"type":"text","text":" "},{"type":"text","text":"θ = 0 is exact repulsion."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice"},{"type":"text","text":" "},{"type":"text","text":"and Experience 21(11), 1991."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,"},{"type":"text","text":" "},{"type":"text","text":"1986."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"iterations ≥ 0"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"optimalDistance"},{"text":", when given, is positive and finite;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"threshold ≥ 0"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"barnesHutTheta"},{"text":", when given, is finite and not negative; every weight","type":"text"},{"text":" ","type":"text"},{"text":"is finite and not negative.","type":"text"}]}],"style":"note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","title":"GraphDrawing","type":"topic","url":"\/documentation\/graphdrawing","role":"collection","abstract":[],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)":{"title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)","abstract":[{"type":"text","text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions"},{"type":"text","text":" "},{"type":"text","text":"drawn uniformly in [0, 1)² from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":"."}],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphdrawing\/graphprotocols\/graph","type":"topic","title":"Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"abstract":[],"type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","role":"collection","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"title":"Drawing","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"kind":"symbol","url":"\/documentation\/graphdrawing\/drawing","navigatorTitle":[{"kind":"identifier","text":"Drawing"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"title":"Edges","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIde