{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fruchtermanReingoldLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 50, "},{"kind":"externalParam","text":"optimalDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1e-4, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · d²\/k, where d is their distance (at least 0.01) and k is ","type":"text"},{"type":"codeVoice","code":"optimalDistance"},{"text":" ","type":"text"},{"text":"(default √(1\/n)). Each step moves every vertex along its net force by at most the","type":"text"},{"text":" ","type":"text"},{"text":"temperature, which starts at a tenth of the larger side of the start’s bounding box (k\/10","type":"text"},{"text":" ","type":"text"},{"text":"when every vertex starts at one point) and falls by the same amount each step, reaching 0","type":"text"},{"text":" ","type":"text"},{"text":"after ","type":"text"},{"type":"codeVoice","code":"iterations + 1"},{"text":" steps. Two vertices at exactly the same point repel as if 0.01","type":"text"},{"text":" ","type":"text"},{"text":"apart, along a direction fixed by their two ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" offsets, so coincident vertices","type":"text"},{"text":" ","type":"text"},{"text":"separate deterministically. The run stops after ","type":"text"},{"type":"codeVoice","code":"iterations"},{"text":" steps, or earlier once the","type":"text"},{"text":" ","type":"text"},{"text":"moves’ root-sum-square divided by n is below ","type":"text"},{"type":"codeVoice","code":"threshold"},{"text":". Self-loops are ignored; parallel edges","type":"text"},{"text":" ","type":"text"},{"text":"add their weights. The drawing is in layout units (vertices end about k apart), not","type":"text"},{"text":" ","type":"text"},{"text":"rescaled. A directed graph is drawn through ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"code":"next()","type":"codeVoice"},{"type":"text","text":". The same generator state gives the same drawing. Positions are"},{"type":"text","text":" "},{"type":"text","text":"not stable across library versions, because the iteration is chaotic and any change in"},{"type":"text","text":" "},{"type":"text","text":"summation order changes its digits."}],"type":"paragraph"},{"inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices.","type":"text"},{"text":" ","type":"text"},{"code":"barnesHutTheta: θ","type":"codeVoice"},{"text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a","type":"text"},{"text":" ","type":"text"},{"text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does","type":"text"},{"text":" ","type":"text"},{"text":"not contain the vertex, acts as one body when s\/D < θ. θ = 1.2 suits graphs past about 5,000 vertices;","type":"text"},{"text":" ","type":"text"},{"text":"θ = 0 is exact repulsion.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice"},{"type":"text","text":" "},{"type":"text","text":"and Experience 21(11), 1991."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,"},{"type":"text","text":" "},{"type":"text","text":"1986."}]}]}]},{"inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"iterations ≥ 0","type":"codeVoice"},{"type":"text","text":"; "},{"code":"optimalDistance","type":"codeVoice"},{"type":"text","text":", when given, is positive and finite;"},{"type":"text","text":" "},{"code":"threshold ≥ 0","type":"codeVoice"},{"type":"text","text":"; "},{"code":"barnesHutTheta","type":"codeVoice"},{"type":"text","text":", when given, is finite and not negative; every weight"},{"type":"text","text":" "},{"type":"text","text":"is finite and not negative."}]}],"style":"note","type":"aside"}]}],"kind":"symbol","abstract":[{"text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions","type":"text"},{"text":" ","type":"text"},{"text":"drawn uniformly in [0, 1)² from ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"metadata":{"symbolKind":"method","remoteSource":{"fileName":"FruchtermanReingoldLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/FruchtermanReingoldLayout.swift#L42"},"role":"symbol","externalID":"s:14GraphProtocols0A0P0A7DrawingE25fruchtermanReingoldLayout10iterations15optimalDistance9threshold14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_SdSgSdAQSd5Edges_5IndexQZXEqd__ztSGRd__lF","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"?, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"