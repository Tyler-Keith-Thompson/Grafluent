{"abstract":[{"type":"text","text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions"},{"type":"text","text":" "},{"type":"text","text":"drawn uniformly in [0, 1)² from "},{"type":"codeVoice","code":"generator"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"sections":[],"metadata":{"extendedModule":"GraphProtocols","title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","symbolKind":"method","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P0A7DrawingE25fruchtermanReingoldLayout10iterations15optimalDistance9threshold14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_SdSgSdAQSd5Edges_5IndexQZXEqd__ztSGRd__lF","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/FruchtermanReingoldLayout.swift#L42","fileName":"FruchtermanReingoldLayout.swift"},"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fruchtermanReingoldLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"optimalDistance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}]},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fruchtermanReingoldLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 50, ","kind":"text"},{"text":"optimalDistance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? = nil, ","kind":"text"},{"text":"threshold","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1e-4, ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Every pair of vertices repels with force k²\/d and every edge attracts its ends with force"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" · d²\/k, where d is their distance (at least 0.01) and k is "},{"type":"codeVoice","code":"optimalDistance"},{"type":"text","text":" "},{"type":"text","text":"(default √(1\/n), NetworkX’s). Each step moves every vertex along its net force by at most"},{"type":"text","text":" "},{"type":"text","text":"the temperature, which starts at a tenth of the larger side of the start’s bounding box"},{"type":"text","text":" "},{"type":"text","text":"(k\/10 when every vertex starts at one point) and falls by the same amount each step,"},{"type":"text","text":" "},{"type":"text","text":"reaching 0 after "},{"type":"codeVoice","code":"iterations + 1"},{"type":"text","text":" steps (NetworkX’s schedule). Two vertices at exactly the"},{"type":"text","text":" "},{"type":"text","text":"same point repel as if 0.01 apart, along a direction fixed by their two "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"offsets, so a start with coincident vertices separates them deterministically. The run stops after "},{"type":"codeVoice","code":"iterations"},{"type":"text","text":" steps, or earlier once the moves’"},{"type":"text","text":" "},{"type":"text","text":"root-sum-square divided by n is below "},{"type":"codeVoice","code":"threshold"},{"type":"text","text":". Self-loops are ignored; parallel edges"},{"type":"text","text":" "},{"type":"text","text":"add their weights. The drawing is in layout units (vertices end about k apart), not"},{"type":"text","text":" "},{"type":"text","text":"rescaled. A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"type":"codeVoice","code":"next()"},{"type":"text","text":". The same generator state gives the same drawing; positions are"},{"type":"text","text":" "},{"type":"text","text":"otherwise not stable across library versions, as any change in summation order changes"},{"type":"text","text":" "},{"type":"text","text":"the digits of a chaotic iteration without changing its quality."}],"type":"paragraph"},{"inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step, for graphs up to a few thousand vertices.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"text":" approximates it with a Barnes–Hut quadtree, O(n log n) per step: a","type":"text"},{"text":" ","type":"text"},{"text":"square cell of side s whose centre of mass is at distance D from the vertex, and which does","type":"text"},{"text":" ","type":"text"},{"text":"not contain the vertex, acts as one body when s\/D < θ. 1.2 is a common choice past about","type":"text"},{"text":" ","type":"text"},{"text":"5,000 vertices; θ = 0 is exact repulsion.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fruchterman and Reingold, “Graph drawing by force-directed placement”, Software: Practice","type":"text"},{"text":" ","type":"text"},{"text":"and Experience 21(11), 1991.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Barnes and Hut, “A hierarchical O(N log N) force-calculation algorithm”, Nature 324,"},{"type":"text","text":" "},{"type":"text","text":"1986."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"type":"paragraph"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"iterations ≥ 0"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"optimalDistance"},{"text":", when given, is positive and finite;","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"threshold ≥ 0"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"barnesHutTheta"},{"text":", when given, is finite and not negative; every weight","type":"text"},{"text":" ","type":"text"},{"text":"is finite and not negative.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"title":"Vertex","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"type":"topic","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","abstract":[],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"kind":"symbol","title":"Edges"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"title":"Graph","abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphdrawing\/graphprotocols\/graph","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)":{"url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/fruchtermanreingoldlayout(iterations:optimaldistance:threshold:barneshuttheta:weight:using:)","abstract":[{"text":"A force-directed drawing by Fruchterman and Reingold’s spring embedder, from positions","type":"text"},{"text":" ","type":"text"},{"text":"drawn uniformly in [0, 1)² from ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fruchtermanReingoldLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"optimalDistance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"threshold"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SG","kind":"typeIdentifier","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)","kind":"symbol","role":"symbol","type":"topic","title":"fruchtermanReingoldLayout(iterations:optimalDistance:threshold:barnesHutTheta:weight:using:)"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","title":"GraphProtocols"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"url":"\/documentation\/graphdrawing\/drawing","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawi