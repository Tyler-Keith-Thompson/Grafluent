{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceAtlas2Layout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 100, ","kind":"text"},{"text":"scalingRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 2, ","kind":"text"},{"text":"gravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1, ","kind":"text"},{"text":"strongGravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"linLog","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"dissuadeHubs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"jitterTolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1, ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Each vertex has mass m = 1 + its degree (self-loops ignored, parallel edges counted). Every","type":"text"},{"text":" ","type":"text"},{"text":"pair of vertices repels with force k_r · m_u · m_v \/ d, where k_r is ","type":"text"},{"code":"scalingRatio","type":"codeVoice"},{"text":" and d","type":"text"},{"text":" ","type":"text"},{"text":"their distance (at least 0.01); every edge attracts its ends with force ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" · d, or","type":"text"},{"text":" ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" · log(1 + d) with ","type":"text"},{"code":"linLog","type":"codeVoice"},{"text":"; with ","type":"text"},{"code":"dissuadeHubs","type":"codeVoice"},{"text":" an edge’s attraction is divided by","type":"text"},{"text":" ","type":"text"},{"text":"the mass of its first end (","type":"text"},{"code":"endpointIndices(ofEdgeAt:).u","type":"codeVoice"},{"text":") and multiplied by the mean mass.","type":"text"},{"text":" ","type":"text"},{"text":"Gravity pulls each vertex towards the origin with force ","type":"text"},{"code":"gravity","type":"codeVoice"},{"text":" · m, or ","type":"text"},{"code":"gravity","type":"codeVoice"},{"text":" · m · d","type":"text"},{"text":" ","type":"text"},{"text":"(d its distance from the origin) with ","type":"text"},{"code":"strongGravity","type":"codeVoice"},{"text":". Two vertices at the same point repel","type":"text"},{"text":" ","type":"text"},{"text":"as if 0.01 apart, along a direction fixed by their two ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" offsets.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each step moves every vertex along its net force F scaled by s \/ (1 + √(s · swing)), where"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s swing is m · ‖F − F′‖, F′ its force in the previous step, and the global speed s"},{"type":"text","text":" "},{"type":"text","text":"adapts as in the reference implementation: it starts at 1 and, with the speed efficiency"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"jitterTolerance","type":"codeVoice"},{"type":"text","text":", follows the ratio of the total traction Σ m ‖F + F′‖ \/ 2 to the total"},{"type":"text","text":" "},{"type":"text","text":"swing, rising by at most half each step. The run makes "},{"code":"iterations","type":"codeVoice"},{"type":"text","text":" steps. The drawing is in"},{"type":"text","text":" "},{"type":"text","text":"layout units, not rescaled. A directed graph is drawn through "},{"code":"undirectedView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"type":"codeVoice","code":"next()"},{"type":"text","text":". The same generator state gives the same drawing; positions"},{"type":"text","text":" "},{"type":"text","text":"are not stable across library versions."}],"type":"paragraph"},{"inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step. ","type":"text"},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"text":" approximates it with a","type":"text"},{"text":" ","type":"text"},{"text":"Barnes–Hut quadtree of the masses, O(n log n) per step: a square cell of side s whose","type":"text"},{"text":" ","type":"text"},{"text":"centre of mass is at distance D from the vertex, and which does not contain it, acts as one","type":"text"},{"text":" ","type":"text"},{"text":"body of the cell’s mass when s\/D < θ. θ = 1.2 suits graphs past a few thousand vertices.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jacomy, Venturini, Heymann and Bastian, “ForceAtlas2, a continuous graph layout algorithm"},{"type":"text","text":" "},{"type":"text","text":"for handy network visualization designed for the Gephi software”, PLoS ONE 9(6), 2014."}]}]}]},{"inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"iterations ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"scalingRatio","type":"codeVoice"},{"text":" is positive and finite; ","type":"text"},{"code":"gravity","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"jitterTolerance","type":"codeVoice"},{"text":" are finite and not negative; ","type":"text"},{"code":"barnesHutTheta","type":"codeVoice"},{"text":", when given, is finite and","type":"text"},{"text":" ","type":"text"},{"text":"not negative; every weight is finite and not negative.","type":"text"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/forceatlas2layout(iterations:scalingratio:gravity:stronggravity:linlog:dissuadehubs:jittertolerance:barneshuttheta:weight:using:)"]}],"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceAtlas2Layout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"scalingRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"gravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":", ","kind":"text"},{"text":"strongGravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"linLog","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"dissuadeHubs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","pre