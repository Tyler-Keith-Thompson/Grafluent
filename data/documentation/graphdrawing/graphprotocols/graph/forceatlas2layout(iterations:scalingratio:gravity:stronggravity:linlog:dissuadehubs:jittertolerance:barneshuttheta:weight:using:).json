,{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SG","text":"RandomNumberGenerator","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"roleHeading":"Instance Method","extendedModule":"GraphProtocols","title":"forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)","remoteSource":{"fileName":"ForceAtlas2Layout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ForceAtlas2Layout.swift#L54"},"role":"symbol","symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceAtlas2Layout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":" = 100, ","kind":"text"},{"text":"scalingRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 2, ","kind":"text"},{"text":"gravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1, ","kind":"text"},{"text":"strongGravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"linLog","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"dissuadeHubs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false, ","kind":"text"},{"text":"jitterTolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = 1, ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each vertex has mass m = 1 + its degree (self-loops ignored, parallel edges counted). Every"},{"type":"text","text":" "},{"type":"text","text":"pair of vertices repels with force k_r · m_u · m_v \/ d, where k_r is "},{"code":"scalingRatio","type":"codeVoice"},{"type":"text","text":" and d"},{"type":"text","text":" "},{"type":"text","text":"their distance (at least 0.01); every edge attracts its ends with force "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" · d, or"},{"type":"text","text":" "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" · log(1 + d) with "},{"code":"linLog","type":"codeVoice"},{"type":"text","text":"; with "},{"code":"dissuadeHubs","type":"codeVoice"},{"type":"text","text":" an edge’s attraction is divided by"},{"type":"text","text":" "},{"type":"text","text":"the mass of its first end ("},{"code":"endpointIndices(ofEdgeAt:).u","type":"codeVoice"},{"type":"text","text":") and multiplied by the mean mass."},{"type":"text","text":" "},{"type":"text","text":"Gravity pulls each vertex towards the origin with force "},{"code":"gravity","type":"codeVoice"},{"type":"text","text":" · m, or "},{"code":"gravity","type":"codeVoice"},{"type":"text","text":" · m · d"},{"type":"text","text":" "},{"type":"text","text":"(d its distance from the origin) with "},{"code":"strongGravity","type":"codeVoice"},{"type":"text","text":". Two vertices at the same point repel"},{"type":"text","text":" "},{"type":"text","text":"as if 0.01 apart, along a direction fixed by their two "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" offsets."}]},{"type":"paragraph","inlineContent":[{"text":"Each step moves every vertex along its net force F scaled by s \/ (1 + √(s · swing)), where","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s swing is m · ‖F − F′‖, F′ its force in the previous step, and the global speed s","type":"text"},{"text":" ","type":"text"},{"text":"adapts as in the reference implementation: it starts at 1 and, with the speed efficiency","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"jitterTolerance"},{"text":", follows the ratio of the total traction Σ m ‖F + F′‖ \/ 2 to the total","type":"text"},{"text":" ","type":"text"},{"text":"swing, rising by at most half each step. The run makes ","type":"text"},{"type":"codeVoice","code":"iterations"},{"text":" steps. The drawing is in","type":"text"},{"text":" ","type":"text"},{"text":"layout units, not rescaled. A directed graph is drawn through ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"type":"codeVoice","code":"next()"},{"type":"text","text":". The same generator state gives the same drawing; positions"},{"type":"text","text":" "},{"type":"text","text":"are not stable across library versions."}]},{"type":"paragraph","inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step. ","type":"text"},{"code":"barnesHutTheta: θ","type":"codeVoice"},{"text":" approximates it with a","type":"text"},{"text":" ","type":"text"},{"text":"Barnes–Hut quadtree of the masses, O(n log n) per step: a square cell of side s whose","type":"text"},{"text":" ","type":"text"},{"text":"centre of mass is at distance D from the vertex, and which does not contain it, acts as one","type":"text"},{"text":" ","type":"text"},{"text":"body of the cell’s mass when s\/D < θ. θ = 1.2 suits graphs past a few thousand vertices.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Jacomy, Venturini, Heymann and Bastian, “ForceAtlas2, a continuous graph layout algorithm","type":"text"},{"text":" ","type":"text"},{"text":"for handy network visualization designed for the Gephi software”, PLoS ONE 9(6), 2014.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"iterations ≥ 0"},{"type":"text","text":"; "},{"type":"codeVoice","code":"scalingRatio"},{"type":"text","text":" is positive and finite; "},{"type":"codeVoice","code":"gravity"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"jitterTolerance"},{"type":"text","text":" are finite and not negative; "},{"type":"codeVoice","code":"barnesHutTheta"},{"type":"text","text":", when given, is finite and"},{"type":"text","text":" "},{"type":"text","text":"not negative; every weight is finite and not negative."}]}],"type":"aside","name":"Precondition","style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/forceatlas2layout(iterations:scalingratio:gravity:stronggravity:linlog:dissuadehubs:jittertolerance:barneshuttheta:weight:using:)"]}],"kind":"symbol","abstract":[{"text":"A force-directed drawing by ForceAtlas2, from positions drawn uniformly in [0, 1)² from","type":"text"},{"text":" ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forceAtlas2Layout"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"scalingRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"gravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"strongGravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"linLog"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dissuadeHubs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","te