 "},{"kind":"identifier","text":"forceAtlas2Layout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 100, "},{"kind":"externalParam","text":"scalingRatio"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 2, "},{"kind":"externalParam","text":"gravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"strongGravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"linLog"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"dissuadeHubs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"jitterTolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Each vertex has mass m = 1 + its degree (self-loops ignored, parallel edges counted). Every","type":"text"},{"text":" ","type":"text"},{"text":"pair of vertices repels with force k_r · m_u · m_v \/ d, where k_r is ","type":"text"},{"type":"codeVoice","code":"scalingRatio"},{"text":" and d","type":"text"},{"text":" ","type":"text"},{"text":"their distance (at least 0.01); every edge attracts its ends with force ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · d, or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · log(1 + d) with ","type":"text"},{"type":"codeVoice","code":"linLog"},{"text":"; with ","type":"text"},{"type":"codeVoice","code":"dissuadeHubs"},{"text":" an edge’s attraction is divided by","type":"text"},{"text":" ","type":"text"},{"text":"the mass of its first end (","type":"text"},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:).u"},{"text":") and multiplied by the mean mass.","type":"text"},{"text":" ","type":"text"},{"text":"Gravity pulls each vertex towards the origin with force ","type":"text"},{"type":"codeVoice","code":"gravity"},{"text":" · m, or ","type":"text"},{"type":"codeVoice","code":"gravity"},{"text":" · m · d","type":"text"},{"text":" ","type":"text"},{"text":"(d its distance from the origin) with ","type":"text"},{"type":"codeVoice","code":"strongGravity"},{"text":". Two vertices at the same point repel","type":"text"},{"text":" ","type":"text"},{"text":"as if 0.01 apart, along a direction fixed by their two ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" offsets.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each step moves every vertex along its net force F scaled by s \/ (1 + √(s · swing)), where"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s swing is m · ‖F − F′‖, F′ its force in the previous step, and the global speed s"},{"type":"text","text":" "},{"type":"text","text":"adapts as in the reference implementation: it starts at 1 and, with the speed efficiency"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"jitterTolerance"},{"type":"text","text":", follows the ratio of the total traction Σ m ‖F + F′‖ \/ 2 to the total"},{"type":"text","text":" "},{"type":"text","text":"swing, rising by at most half each step. The run makes "},{"type":"codeVoice","code":"iterations"},{"type":"text","text":" steps. The drawing is in"},{"type":"text","text":" "},{"type":"text","text":"layout units, not rescaled. A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The start takes exactly 2n draws: x then y for each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, each the","type":"text"},{"text":" ","type":"text"},{"text":"top 53 bits of one ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":". The same generator state gives the same drawing; positions","type":"text"},{"text":" ","type":"text"},{"text":"are not stable across library versions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repulsion is exact by default: O(n²) per step. "},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"type":"text","text":" approximates it with a"},{"type":"text","text":" "},{"type":"text","text":"Barnes–Hut quadtree of the masses, O(n log n) per step: a square cell of side s whose"},{"type":"text","text":" "},{"type":"text","text":"centre of mass is at distance D from the vertex, and which does not contain it, acts as one"},{"type":"text","text":" "},{"type":"text","text":"body of the cell’s mass when s\/D < θ. θ = 1.2 suits graphs past a few thousand vertices."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jacomy, Venturini, Heymann and Bastian, “ForceAtlas2, a continuous graph layout algorithm"},{"type":"text","text":" "},{"type":"text","text":"for handy network visualization designed for the Gephi software”, PLoS ONE 9(6), 2014."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"iterations ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"scalingRatio","type":"codeVoice"},{"text":" is positive and finite; ","type":"text"},{"code":"gravity","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"jitterTolerance","type":"codeVoice"},{"text":" are finite and not negative; ","type":"text"},{"code":"barnesHutTheta","type":"codeVoice"},{"text":", when given, is finite and","type":"text"},{"text":" ","type":"text"},{"text":"not negative; every weight is finite and not negative.","type":"text"}],"type":"paragraph"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)","interfaceLanguage":"swift"},"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","abstract":[],"url":"\/documentation\/graphdrawing","type":"topic","title":"GraphDrawing","kind":"symbol","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","url":"\/documentation\/graphdrawing\/drawing","type":"topic","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"title":"Drawing","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text