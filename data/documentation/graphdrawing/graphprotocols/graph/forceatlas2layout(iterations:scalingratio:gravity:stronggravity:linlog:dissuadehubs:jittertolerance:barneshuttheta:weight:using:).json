dentifier","text":"forceAtlas2Layout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 100, "},{"kind":"externalParam","text":"scalingRatio"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 2, "},{"kind":"externalParam","text":"gravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"strongGravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"linLog"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"dissuadeHubs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"jitterTolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Each vertex has mass m = 1 + its degree (self-loops ignored, parallel edges counted). Every","type":"text"},{"text":" ","type":"text"},{"text":"pair of vertices repels with force k_r · m_u · m_v \/ d, where k_r is ","type":"text"},{"type":"codeVoice","code":"scalingRatio"},{"text":" and d","type":"text"},{"text":" ","type":"text"},{"text":"their distance (at least 0.01); every edge attracts its ends with force ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · d, or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · log(1 + d) with ","type":"text"},{"type":"codeVoice","code":"linLog"},{"text":"; with ","type":"text"},{"type":"codeVoice","code":"dissuadeHubs"},{"text":" an edge’s attraction is divided by","type":"text"},{"text":" ","type":"text"},{"text":"the mass of its first end (","type":"text"},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:).u"},{"text":") and multiplied by the mean mass.","type":"text"},{"text":" ","type":"text"},{"text":"Gravity pulls each vertex towards the origin with force ","type":"text"},{"type":"codeVoice","code":"gravity"},{"text":" · m, or ","type":"text"},{"type":"codeVoice","code":"gravity"},{"text":" · m · d","type":"text"},{"text":" ","type":"text"},{"text":"(d its distance from the origin) with ","type":"text"},{"type":"codeVoice","code":"strongGravity"},{"text":". Two vertices at the same point repel","type":"text"},{"text":" ","type":"text"},{"text":"as if 0.01 apart, along a direction fixed by their two ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" offsets.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each step moves every vertex along its net force F scaled by s \/ (1 + √(s · swing)), where"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s swing is m · ‖F − F′‖, F′ its force in the previous step, and the global speed s"},{"type":"text","text":" "},{"type":"text","text":"adapts as in the reference implementation: it starts at 1 and, with the speed efficiency"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"jitterTolerance"},{"type":"text","text":", follows the ratio of the total traction Σ m ‖F + F′‖ \/ 2 to the total"},{"type":"text","text":" "},{"type":"text","text":"swing, rising by at most half each step. The run makes "},{"type":"codeVoice","code":"iterations"},{"type":"text","text":" steps. The drawing is in"},{"type":"text","text":" "},{"type":"text","text":"layout units, not rescaled. A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"code":"next()","type":"codeVoice"},{"type":"text","text":". The same generator state gives the same drawing; positions"},{"type":"text","text":" "},{"type":"text","text":"are not stable across library versions."}]},{"type":"paragraph","inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step. ","type":"text"},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"text":" approximates it with a","type":"text"},{"text":" ","type":"text"},{"text":"Barnes–Hut quadtree of the masses, O(n log n) per step: a square cell of side s whose","type":"text"},{"text":" ","type":"text"},{"text":"centre of mass is at distance D from the vertex, and which does not contain it, acts as one","type":"text"},{"text":" ","type":"text"},{"text":"body of the cell’s mass when s\/D < θ. θ = 1.2 suits graphs past a few thousand vertices.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Jacomy, Venturini, Heymann and Bastian, “ForceAtlas2, a continuous graph layout algorithm","type":"text"},{"text":" ","type":"text"},{"text":"for handy network visualization designed for the Gephi software”, PLoS ONE 9(6), 2014.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"iterations ≥ 0"},{"type":"text","text":"; "},{"type":"codeVoice","code":"scalingRatio"},{"type":"text","text":" is positive and finite; "},{"type":"codeVoice","code":"gravity"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"jitterTolerance"},{"type":"text","text":" are finite and not negative; "},{"type":"codeVoice","code":"barnesHutTheta"},{"type":"text","text":", when given, is finite and"},{"type":"text","text":" "},{"type":"text","text":"not negative; every weight is finite and not negative."}]}],"style":"note"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"kind":"symbol","references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)":{"abstract":[{"text":"A force-directed drawing by ForceAtlas2, from positions drawn uniformly in [0, 1)² from","type":"text"},{"text":" ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceAtlas2Layout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"scalingRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"gravity"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":", "},{"kind":"externalParam","text":"strongGravity"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"linLog"},{"kind":"text","text":": "},{"preciseIdentifier