,{"text":" ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forceAtlas2Layout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":" = 100, "},{"kind":"externalParam","text":"scalingRatio"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 2, "},{"kind":"externalParam","text":"gravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"strongGravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"linLog"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"dissuadeHubs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"jitterTolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Each vertex has mass m = 1 + its degree (self-loops ignored, parallel edges counted). Every","type":"text"},{"text":" ","type":"text"},{"text":"pair of vertices repels with force k_r · m_u · m_v \/ d, where k_r is ","type":"text"},{"type":"codeVoice","code":"scalingRatio"},{"text":" and d","type":"text"},{"text":" ","type":"text"},{"text":"their distance (at least 0.01); every edge attracts its ends with force ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · d, or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" · log(1 + d) with ","type":"text"},{"type":"codeVoice","code":"linLog"},{"text":"; with ","type":"text"},{"type":"codeVoice","code":"dissuadeHubs"},{"text":" an edge’s attraction is divided by","type":"text"},{"text":" ","type":"text"},{"text":"the mass of its first end (","type":"text"},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:).u"},{"text":") and multiplied by the mean mass.","type":"text"},{"text":" ","type":"text"},{"text":"Gravity pulls each vertex towards the origin with force ","type":"text"},{"type":"codeVoice","code":"gravity"},{"text":" · m, or ","type":"text"},{"type":"codeVoice","code":"gravity"},{"text":" · m · d","type":"text"},{"text":" ","type":"text"},{"text":"(d its distance from the origin) with ","type":"text"},{"type":"codeVoice","code":"strongGravity"},{"text":". Two vertices at the same point repel","type":"text"},{"text":" ","type":"text"},{"text":"as if 0.01 apart, along a direction fixed by their two ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" offsets.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each step moves every vertex along its net force F scaled by s \/ (1 + √(s · swing)), where"},{"type":"text","text":" "},{"type":"text","text":"a vertex’s swing is m · ‖F − F′‖, F′ its force in the previous step, and the global speed s"},{"type":"text","text":" "},{"type":"text","text":"adapts as in the reference implementation: it starts at 1 and, with the speed efficiency"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"jitterTolerance"},{"type":"text","text":", follows the ratio of the total traction Σ m ‖F + F′‖ \/ 2 to the total"},{"type":"text","text":" "},{"type":"text","text":"swing, rising by at most half each step. The run makes "},{"type":"codeVoice","code":"iterations"},{"type":"text","text":" steps. The drawing is in"},{"type":"text","text":" "},{"type":"text","text":"layout units, not rescaled. A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The start takes exactly 2n draws: x then y for each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, each the","type":"text"},{"text":" ","type":"text"},{"text":"top 53 bits of one ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":". The same generator state gives the same drawing; positions","type":"text"},{"text":" ","type":"text"},{"text":"are not stable across library versions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step. ","type":"text"},{"code":"barnesHutTheta: θ","type":"codeVoice"},{"text":" approximates it with a","type":"text"},{"text":" ","type":"text"},{"text":"Barnes–Hut quadtree of the masses, O(n log n) per step: a square cell of side s whose","type":"text"},{"text":" ","type":"text"},{"text":"centre of mass is at distance D from the vertex, and which does not contain it, acts as one","type":"text"},{"text":" ","type":"text"},{"text":"body of the cell’s mass when s\/D < θ. θ = 1.2 suits graphs past a few thousand vertices.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Jacomy, Venturini, Heymann and Bastian, “ForceAtlas2, a continuous graph layout algorithm","type":"text"},{"text":" ","type":"text"},{"text":"for handy network visualization designed for the Gephi software”, PLoS ONE 9(6), 2014.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"iterations ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"scalingRatio","type":"codeVoice"},{"text":" is positive and finite; ","type":"text"},{"code":"gravity","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"jitterTolerance","type":"codeVoice"},{"text":" are finite and not negative; ","type":"text"},{"code":"barnesHutTheta","type":"codeVoice"},{"text":", when given, is finite and","type":"text"},{"text":" ","type":"text"},{"text":"not negative; every weight is finite and not negative.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition"}]}],"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/forceatlas2layout(iterations:scalingratio:gravity:stronggravity:linlog:dissuadehubs:jittertolerance:barneshuttheta:weight:using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/graphdrawing\/graphprotocols\/graph","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","abstract":[],"type":"topic","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols","title":"GraphProtocols","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","abstract":[],"role":"collection","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"title":"Drawing","url":"\/documentation\/graphdrawing\/drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"kind":"symbol","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"type":"topic","role":"symbol"