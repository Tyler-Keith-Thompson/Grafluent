{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"forceAtlas2Layout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = 100, "},{"kind":"externalParam","text":"scalingRatio"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 2, "},{"kind":"externalParam","text":"gravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"strongGravity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"linLog"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"dissuadeHubs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = false, "},{"kind":"externalParam","text":"jitterTolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = 1, "},{"kind":"externalParam","text":"barnesHutTheta"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":" "},{"kind":"internalParam","text":"generator"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SG","text":"RandomNumberGenerator"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each vertex has mass m = 1 + its degree (self-loops ignored, parallel edges counted). Every"},{"type":"text","text":" "},{"type":"text","text":"pair of vertices repels with force k_r · m_u · m_v \/ d, where k_r is "},{"type":"codeVoice","code":"scalingRatio"},{"type":"text","text":" and d"},{"type":"text","text":" "},{"type":"text","text":"their distance (at least 0.01); every edge attracts its ends with force "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" · d, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" · log(1 + d) with "},{"type":"codeVoice","code":"linLog"},{"type":"text","text":"; with "},{"type":"codeVoice","code":"dissuadeHubs"},{"type":"text","text":" an edge’s attraction is divided by"},{"type":"text","text":" "},{"type":"text","text":"the mass of its first end ("},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:).u"},{"type":"text","text":") and multiplied by the mean mass."},{"type":"text","text":" "},{"type":"text","text":"Gravity pulls each vertex towards the origin with force "},{"type":"codeVoice","code":"gravity"},{"type":"text","text":" · m, or "},{"type":"codeVoice","code":"gravity"},{"type":"text","text":" · m · d"},{"type":"text","text":" "},{"type":"text","text":"(d its distance from the origin) with "},{"type":"codeVoice","code":"strongGravity"},{"type":"text","text":". Two vertices at the same point repel"},{"type":"text","text":" "},{"type":"text","text":"as if 0.01 apart, along a direction fixed by their two "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offsets."}]},{"type":"paragraph","inlineContent":[{"text":"Each step moves every vertex along its net force F scaled by s \/ (1 + √(s · swing)), where","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s swing is m · ‖F − F′‖, F′ its force in the previous step, and the global speed s","type":"text"},{"text":" ","type":"text"},{"text":"adapts as in the reference implementation: it starts at 1 and, with the speed efficiency","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"jitterTolerance","type":"codeVoice"},{"text":", follows the ratio of the total traction Σ m ‖F + F′‖ \/ 2 to the total","type":"text"},{"text":" ","type":"text"},{"text":"swing, rising by at most half each step. The run makes ","type":"text"},{"code":"iterations","type":"codeVoice"},{"text":" steps. The drawing is in","type":"text"},{"text":" ","type":"text"},{"text":"layout units, not rescaled. A directed graph is drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The start takes exactly 2n draws: x then y for each vertex in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, each the","type":"text"},{"text":" ","type":"text"},{"text":"top 53 bits of one ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":". The same generator state gives the same drawing; positions","type":"text"},{"text":" ","type":"text"},{"text":"are not stable across library versions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Repulsion is exact by default: O(n²) per step. "},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"type":"text","text":" approximates it with a"},{"type":"text","text":" "},{"type":"text","text":"Barnes–Hut quadtree of the masses, O(n log n) per step: a square cell of side s whose"},{"type":"text","text":" "},{"type":"text","text":"centre of mass is at distance D from the vertex, and which does not contain it, acts as one"},{"type":"text","text":" "},{"type":"text","text":"body of the cell’s mass when s\/D < θ. θ = 1.2 suits graphs past a few thousand vertices."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jacomy, Venturini, Heymann and Bastian, “ForceAtlas2, a continuous graph layout algorithm"},{"type":"text","text":" "},{"type":"text","text":"for handy network visualization designed for the Gephi software”, PLoS ONE 9(6), 2014."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)"},{"type":"text","text":" "},{"type":"text","text":"memory."}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"iterations ≥ 0"},{"type":"text","text":"; "},{"type":"codeVoice","code":"scalingRatio"},{"type":"text","text":" is positive and finite; "},{"type":"codeVoice","code":"gravity"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"jitterTolerance"},{"type":"text","text":" are finite and not negative; "},{"type":"codeVoice","code":"barnesHutTheta"},{"type":"text","text":", when given, is finite and"},{"type":"text","text":" "},{"type":"text","text":"not negative; every weight is finite and not negative."}],"type":"paragraph"}],"name":"Precondition"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/forceatlas2layout(iterations:scalingratio:gravity:stronggravity:linlog:dissuadehubs:jittertolerance:barneshuttheta:weight:using:)"]}],"abstract":[{"text":"A force-directed drawing by ForceAtlas2, from positions drawn uniformly in [0, 1)² from","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"generator"},{"text":".","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"sections":[],"metadata":{"extendedModule":"GraphProtocols","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"role":"symbol","title":"forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)","externalID":"s:14GraphProtocols0A0P0A7DrawingE17forceAtlas2Layout10iterations12scalingRatio7gravity13strongGravity6linLog12dissuadeHubs15jitterTolerance14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_S2dS3bS2dSgSd5Edges_5IndexQZXEqd__ztSGRd__lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceAtlas2Layout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"e