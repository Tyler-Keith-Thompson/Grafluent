","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"externalID":"s:14GraphProtocols0A0P0A7DrawingE17forceAtlas2Layout10iterations12scalingRatio7gravity13strongGravity6linLog12dissuadeHubs15jitterTolerance14barnesHutTheta6weight5usingAD0C0Vy6VertexQzGSi_S2dS3bS2dSgSd5Edges_5IndexQZXEqd__ztSGRd__lF","extendedModule":"GraphProtocols"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/forceAtlas2Layout(iterations:scalingRatio:gravity:strongGravity:linLog:dissuadeHubs:jitterTolerance:barnesHutTheta:weight:using:)"},"abstract":[{"text":"A force-directed drawing by ForceAtlas2, from positions drawn uniformly in [0, 1)² from","type":"text"},{"text":" ","type":"text"},{"code":"generator","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"forceAtlas2Layout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"iterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 100, ","kind":"text"},{"text":"scalingRatio","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 2, ","kind":"text"},{"text":"gravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1, ","kind":"text"},{"text":"strongGravity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"linLog","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"dissuadeHubs","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" = false, ","kind":"text"},{"text":"jitterTolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = 1, ","kind":"text"},{"text":"barnesHutTheta","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":"? = nil, ","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"generator","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","preciseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each vertex has mass m = 1 + its degree (self-loops ignored, parallel edges counted). Every"},{"type":"text","text":" "},{"type":"text","text":"pair of vertices repels with force k_r · m_u · m_v \/ d, where k_r is "},{"type":"codeVoice","code":"scalingRatio"},{"type":"text","text":" and d"},{"type":"text","text":" "},{"type":"text","text":"their distance (at least 0.01); every edge attracts its ends with force "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" · d, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" · log(1 + d) with "},{"type":"codeVoice","code":"linLog"},{"type":"text","text":"; with "},{"type":"codeVoice","code":"dissuadeHubs"},{"type":"text","text":" an edge’s attraction is divided by"},{"type":"text","text":" "},{"type":"text","text":"the mass of its first end ("},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:).u"},{"type":"text","text":") and multiplied by the mean mass."},{"type":"text","text":" "},{"type":"text","text":"Gravity pulls each vertex towards the origin with force "},{"type":"codeVoice","code":"gravity"},{"type":"text","text":" · m, or "},{"type":"codeVoice","code":"gravity"},{"type":"text","text":" · m · d"},{"type":"text","text":" "},{"type":"text","text":"(d its distance from the origin) with "},{"type":"codeVoice","code":"strongGravity"},{"type":"text","text":". Two vertices at the same point repel"},{"type":"text","text":" "},{"type":"text","text":"as if 0.01 apart, along a direction fixed by their two "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" offsets."}],"type":"paragraph"},{"inlineContent":[{"text":"Each step moves every vertex along its net force F scaled by s \/ (1 + √(s · swing)), where","type":"text"},{"text":" ","type":"text"},{"text":"a vertex’s swing is m · ‖F − F′‖, F′ its force in the previous step, and the global speed s","type":"text"},{"text":" ","type":"text"},{"text":"adapts as in the reference implementation: it starts at 1 and, with the speed efficiency","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"jitterTolerance"},{"text":", follows the ratio of the total traction Σ m ‖F + F′‖ \/ 2 to the total","type":"text"},{"text":" ","type":"text"},{"text":"swing, rising by at most half each step. The run makes ","type":"text"},{"type":"codeVoice","code":"iterations"},{"text":" steps. The drawing is in","type":"text"},{"text":" ","type":"text"},{"text":"layout units, not rescaled. A directed graph is drawn through ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The start takes exactly 2n draws: x then y for each vertex in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, each the"},{"type":"text","text":" "},{"type":"text","text":"top 53 bits of one "},{"code":"next()","type":"codeVoice"},{"type":"text","text":". The same generator state gives the same drawing; positions"},{"type":"text","text":" "},{"type":"text","text":"are not stable across library versions."}],"type":"paragraph"},{"inlineContent":[{"text":"Repulsion is exact by default: O(n²) per step. ","type":"text"},{"type":"codeVoice","code":"barnesHutTheta: θ"},{"text":" approximates it with a","type":"text"},{"text":" ","type":"text"},{"text":"Barnes–Hut quadtree of the masses, O(n log n) per step: a square cell of side s whose","type":"text"},{"text":" ","type":"text"},{"text":"centre of mass is at distance D from the vertex, and which does not contain it, acts as one","type":"text"},{"text":" ","type":"text"},{"text":"body of the cell’s mass when s\/D < θ. θ = 1.2 suits graphs past a few thousand vertices.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jacomy, Venturini, Heymann and Bastian, “ForceAtlas2, a continuous graph layout algorithm"},{"type":"text","text":" "},{"type":"text","text":"for handy network visualization designed for the Gephi software”, PLoS ONE 9(6), 2014."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"O(iterations · (n² + m)) time exactly, O(iterations · (n log n + m)) with Barnes–Hut; O(n + m)","type":"text"},{"text":" ","type":"text"},{"text":"memory.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"iterations ≥ 0","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"scalingRatio","type":"codeVoice"},{"text":" is positive and finite; ","type":"text"},{"code":"gravity","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"jitterTolerance","type":"codeVoice"},{"text":" are finite and not negative; ","type":"text"},{"code":"barnesHutTheta","type":"codeVoice"},{"text":", when given, is finite and","type":"text"},{"text":" ","type":"text"},{"text":"not negative; every weight is finite and not negative.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/forceatlas2layout(iterations:scalingratio:gravity:stronggravity:linlog:dissuadehubs:jittertolerance:barneshuttheta:weight:using:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"sections":[],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"role":"symbol","kind":"symbol","url":"\/documentation\/graphdrawing\/graphprotocols\/graph","abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"type":"topic","role":"symbol","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","kind":"symbol","title":"Edges"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"type":"topic","role":"symbol","title":"Drawing","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":