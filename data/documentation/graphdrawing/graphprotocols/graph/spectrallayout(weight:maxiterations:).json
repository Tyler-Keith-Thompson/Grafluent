{"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/spectralLayout(weight:maxIterations:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"A drawing whose axes are eigenvectors of the Laplacian: x is the eigenvector of the second"},{"type":"text","text":" "},{"type":"text","text":"smallest eigenvalue of L = D − A (the Fiedler vector of a connected graph) and y that of"},{"type":"text","text":" "},{"type":"text","text":"the third, both of unit length, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their","type":"text"},{"text":" ","type":"text"},{"text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from","type":"text"},{"text":" ","type":"text"},{"text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s","type":"text"},{"text":" ","type":"text"},{"text":"sign makes its first entry, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, whose magnitude is at least 10⁻⁴ of its","type":"text"},{"text":" ","type":"text"},{"text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is","type":"text"},{"text":" ","type":"text"},{"text":"not rescaled (","type":"text"},{"code":"rescaled(scale:center:)","type":"codeVoice"},{"text":" maps it to a common frame). A directed graph is","type":"text"},{"text":" ","type":"text"},{"text":"drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s, for graphs of up to a few thousand vertices."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with","type":"text"},{"text":" ","type":"text"},{"text":"Applications 49(11–12), 2005.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Every weight is finite and not negative; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at","type":"text"},{"text":" ","type":"text"},{"text":"least 1.","type":"text"}]}],"name":"Precondition","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" QL iterations in all (30 n when nil), with","type":"text"},{"text":" ","type":"text"},{"text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its","type":"text"},{"text":" ","type":"text"},{"text":"block. The iteration converges cubically, about two iterations per eigenvalue.","type":"text"}]}],"name":"Throws","type":"aside"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"metadata":{"role":"symbol","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P0A7DrawingE14spectralLayout6weight13maxIterationsAD0C0Vy6VertexQzGSd5Edges_5IndexQZXE_SiSgtAA13NoConvergenceVYKF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SpectralLayout.swift#L30","fileName":"SpectralLayout.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralLayout"},{"kind":"te