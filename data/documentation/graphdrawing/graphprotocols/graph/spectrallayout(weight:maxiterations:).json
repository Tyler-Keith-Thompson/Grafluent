{"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/spectrallayout(weight:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A drawing whose axes are eigenvectors of the Laplacian: x is the eigenvector of the second","type":"text"},{"text":" ","type":"text"},{"text":"smallest eigenvalue of L = D − A (the Fiedler vector of a connected graph) and y that of","type":"text"},{"text":" ","type":"text"},{"text":"the third, both of unit length, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/spectralLayout(weight:maxIterations:)","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"metadata":{"modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"symbolKind":"method","externalID":"s:14GraphProtocols0A0P0A7DrawingE14spectralLayout6weight13maxIterationsAD0C0Vy6VertexQzGSd5Edges_5IndexQZXE_SiSgtAA13NoConvergenceVYKF","title":"spectralLayout(weight:maxIterations:)","roleHeading":"Instance Method","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SpectralLayout.swift#L30","fileName":"SpectralLayout.swift"},"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their"},{"type":"text","text":" "},{"type":"text","text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from"},{"type":"text","text":" "},{"type":"text","text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s"},{"type":"text","text":" "},{"type":"text","text":"sign makes its first entry, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, whose magnitude is at least 10⁻⁴ of its"},{"type":"text","text":" "},{"type":"text","text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is"},{"type":"text","text":" "},{"type":"text","text":"not rescaled ("},{"code":"rescaled(scale:center:)","type":"codeVoice"},{"type":"text","text":" maps it to a common frame). A directed graph is"},{"type":"text","text":" "},{"type":"text","text":"drawn through "},{"code":"undirectedView","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s, for graphs of up to a few thousand vertices.","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with"},{"type":"text","text":" "},{"type":"text","text":"Applications 49(11–12), 2005."}]}]}],"type":"unorderedList"},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and not negative; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" QL iterations in all (30 n when nil), with","type":"text"},{"text":" ","type":"text"},{"text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its","type":"text"},{"text":" ","type":"text"},{"text":"block. The iteration converges cubically, about two iterations per eigenvalue.","type":"text"}]}]}]}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"type":"topic","role":"collection","title":"GraphProtocols","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","titl