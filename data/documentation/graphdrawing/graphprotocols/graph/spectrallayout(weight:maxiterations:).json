{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their"},{"type":"text","text":" "},{"type":"text","text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from"},{"type":"text","text":" "},{"type":"text","text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s"},{"type":"text","text":" "},{"type":"text","text":"sign makes its first entry, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, whose magnitude is at least 10⁻⁴ of its"},{"type":"text","text":" "},{"type":"text","text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is"},{"type":"text","text":" "},{"type":"text","text":"not rescaled ("},{"code":"rescaled(scale:center:)","type":"codeVoice"},{"type":"text","text":" maps it to a common frame). A directed graph is"},{"type":"text","text":" "},{"type":"text","text":"drawn through "},{"code":"undirectedView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s, for graphs of up to a few thousand vertices.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with","type":"text"},{"text":" ","type":"text"},{"text":"Applications 49(11–12), 2005.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Every weight is finite and not negative; ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":", when given, is at","type":"text"},{"text":" ","type":"text"},{"text":"least 1.","type":"text"}]}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), with"},{"type":"text","text":" "},{"type":"text","text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its"},{"type":"text","text":" "},{"type":"text","text":"block. The iteration converges cubically, about two iterations per eigenvalue."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"}]}],"metadata":{"symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"remoteSource":{"fileName":"SpectralLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SpectralLayout.swift#L30"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"extendedModule":"GraphProtocols","title":"spectralLayout(weight:maxIterations:)","role":"symbol","externalID":"s:14GraphProtocols0A0P0A7DrawingE14spectralLayout6weight13maxIterationsAD0C0Vy6VertexQzGSd5Edges_5IndexQZXE_SiSgtAA13NoConvergenceVYKF","roleHeading":"Instance Method"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/spectralLayout(weight:maxIterations:)"},"kind":"symbol","abstract":[{"text":"A drawing whose axes are eigenvectors of the Laplacian: x is the eigenvector of the second","type":"text"},{"text":" ","type":"text"},{"text":"smallest eigenvalue of L = D − A (the Fiedler vector of a connected graph) and y that of","type":"text"},{"text":" ","type":"text"},{"text":"the third, both of unit length, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/spectrallayout(weight:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule."}],"kind":"symbol","title":"NoConvergence","type":"topic","navigatorTitle":[{"kind":"identifier","text":"NoConvergence"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifi