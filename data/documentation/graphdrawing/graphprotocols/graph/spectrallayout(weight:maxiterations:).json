ergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their"},{"type":"text","text":" "},{"type":"text","text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from"},{"type":"text","text":" "},{"type":"text","text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s"},{"type":"text","text":" "},{"type":"text","text":"sign makes its first entry, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, whose magnitude is at least 10⁻⁴ of its"},{"type":"text","text":" "},{"type":"text","text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is"},{"type":"text","text":" "},{"type":"text","text":"not rescaled ("},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"type":"text","text":" maps it to a common frame). A directed graph is"},{"type":"text","text":" "},{"type":"text","text":"drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²"},{"type":"text","text":" "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s, for graphs of up to a few thousand vertices."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with"},{"type":"text","text":" "},{"type":"text","text":"Applications 49(11–12), 2005."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and not negative; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), with"},{"type":"text","text":" "},{"type":"text","text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its"},{"type":"text","text":" "},{"type":"text","text":"block. The iteration converges cubically, about two iterations per eigenvalue."}],"type":"paragraph"}]}]}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/spectralLayout(weight:maxIterations:)":{"type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/spectrallayout(weight:maxiterations:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"ki