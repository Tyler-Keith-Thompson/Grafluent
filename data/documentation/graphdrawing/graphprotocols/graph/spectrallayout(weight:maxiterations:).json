{"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"A drawing whose axes are eigenvectors of the Laplacian: x is the eigenvector of the second"},{"type":"text","text":" "},{"type":"text","text":"smallest eigenvalue of L = D − A (the Fiedler vector of a connected graph) and y that of"},{"type":"text","text":" "},{"type":"text","text":"the third, both of unit length, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","text":"NoConvergence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their","type":"text"},{"text":" ","type":"text"},{"text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from","type":"text"},{"text":" ","type":"text"},{"text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s","type":"text"},{"text":" ","type":"text"},{"text":"sign makes its first entry, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, whose magnitude is at least 10⁻⁴ of its","type":"text"},{"text":" ","type":"text"},{"text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is","type":"text"},{"text":" ","type":"text"},{"text":"not rescaled (","type":"text"},{"code":"rescaled(scale:center:)","type":"codeVoice"},{"text":" maps it to a common frame). A directed graph is","type":"text"},{"text":" ","type":"text"},{"text":"drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s, for graphs of up to a few thousand vertices.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with","type":"text"},{"text":" ","type":"text"},{"text":"Applications 49(11–12), 2005.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is finite and not negative; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}]}],"style":"note"},{"name":"Throws","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), with"},{"type":"text","text":" "},{"type":"text","text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its"},{"type":"text","text":" "},{"type":"text","text":"block. The iteration converges cubically, about two iterations per eigenvalue."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/spectrallayout(weight:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/spectralLayout(weight:maxIterations:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P0A7DrawingE14spectralLayout6weight13maxIterationsAD0C0Vy6VertexQzGSd5Edges_5IndexQZXE_SiSgtAA13NoConvergenceVYKF","remoteSource":{"fileName":"SpectralLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main