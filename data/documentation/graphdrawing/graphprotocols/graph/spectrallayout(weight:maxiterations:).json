{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Instance Method","extendedModule":"GraphProtocols","role":"symbol","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SpectralLayout.swift#L30","fileName":"SpectralLayout.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"spectralLayout(weight:maxIterations:)","externalID":"s:14GraphProtocols0A0P0A7DrawingE14spectralLayout6weight13maxIterationsAD0C0Vy6VertexQzGSd5Edges_5IndexQZXE_SiSgtAA13NoConvergenceVYKF","symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"abstract":[{"text":"A drawing whose axes are eigenvectors of the Laplacian: x is the eigenvector of the second","type":"text"},{"text":" ","type":"text"},{"text":"smallest eigenvalue of L = D − A (the Fiedler vector of a connected graph) and y that of","type":"text"},{"text":" ","type":"text"},{"text":"the third, both of unit length, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/spectrallayout(weight:maxiterations:)"]}],"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/spectralLayout(weight:maxIterations:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","text":"NoConvergence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their"},{"type":"text","text":" "},{"type":"text","text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from"},{"type":"text","text":" "},{"type":"text","text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s"},{"type":"text","text":" "},{"type":"text","text":"sign makes its first entry, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, whose magnitude is at least 10⁻⁴ of its"},{"type":"text","text":" "},{"type":"text","text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is"},{"type":"text","text":" "},{"type":"text","text":"not rescaled ("},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"type":"text","text":" maps it to a common frame). A directed graph is"},{"type":"text","text":" "},{"type":"text","text":"drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s, for graphs of up to a few thousand vertices.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with"},{"type":"text","text":" "},{"type":"text","text":"Applications 49(11–12), 2005."}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every weight is finite and not negative; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}]}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" QL iterations in all (30 n when nil), with","type":"text"},{"text":" ","type":"text"},{"text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its","type":"text"},{"text":" ","type":"text"},{"text":"block. The iteration converges cubically, about two iterations per eigenvalue.","type":"text"}],"type":"paragraph"}],"name":"Throws","type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/spectralLayout(weight:maxIterations:)":{"type":"topic","role":"symbol","title":"spectralLayout(weight:maxIterations:)","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/spectrallayout(weight:maxiterations:)","abstract":[{"type":"text","text":"A drawing whose axes are eigenvectors of the Laplacian: x is the eigenvector of the second"},{"type":"text","text":" "},{"type":"text","text":"smallest eigenvalue of L = D − A (