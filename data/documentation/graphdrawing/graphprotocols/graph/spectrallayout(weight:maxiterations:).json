0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are"},{"type":"text","text":" "},{"type":"text","text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their"},{"type":"text","text":" "},{"type":"text","text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from"},{"type":"text","text":" "},{"type":"text","text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s"},{"type":"text","text":" "},{"type":"text","text":"sign makes its first entry, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, whose magnitude is at least 10⁻⁴ of its"},{"type":"text","text":" "},{"type":"text","text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is"},{"type":"text","text":" "},{"type":"text","text":"not rescaled ("},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"type":"text","text":" maps it to a common frame). A directed graph is"},{"type":"text","text":" "},{"type":"text","text":"drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s, for graphs of up to a few thousand vertices."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with"},{"type":"text","text":" "},{"type":"text","text":"Applications 49(11–12), 2005."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"Every weight is finite and not negative; ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":", when given, is at","type":"text"},{"text":" ","type":"text"},{"text":"least 1.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"NoConvergence","type":"codeVoice"},{"text":" after ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":" QL iterations in all (30 n when nil), with","type":"text"},{"text":" ","type":"text"},{"text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its","type":"text"},{"text":" ","type":"text"},{"text":"block. The iteration converges cubically, about two iterations per eigenvalue.","type":"text"}]}],"type":"aside"}]}],"sections":[],"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/spectralLayout(weight:maxIterations:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s: