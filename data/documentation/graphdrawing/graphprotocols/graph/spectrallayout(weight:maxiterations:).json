wift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spectralLayout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" = { _ in 1 }, "},{"kind":"externalParam","text":"maxIterations"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","kind":"typeIdentifier","text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":">"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"A is the weighted adjacency matrix: parallel edges add their weights, self-loops are","type":"text"},{"text":" ","type":"text"},{"text":"ignored, and a weight of 0 is no edge. The eigenvalues are sorted ascending with their","type":"text"},{"text":" ","type":"text"},{"text":"multiplicity, so a graph with c components has c zero eigenvalues and its axes come from","type":"text"},{"text":" ","type":"text"},{"text":"eigenvectors of 0 when c > 1 (which ones is fixed by the solver, not specified). Each axis’s","type":"text"},{"text":" ","type":"text"},{"text":"sign makes its first entry, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, whose magnitude is at least 10⁻⁴ of its","type":"text"},{"text":" ","type":"text"},{"text":"largest positive. Two vertices have y = 0, and one vertex is at the origin. The drawing is","type":"text"},{"text":" ","type":"text"},{"text":"not rescaled (","type":"text"},{"code":"rescaled(scale:center:)","type":"codeVoice"},{"text":" maps it to a common frame). A directed graph is","type":"text"},{"text":" ","type":"text"},{"text":"drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Dense: Householder tridiagonalization and the implicit QL iteration, O(n³) time and n²"},{"type":"text","text":" "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s, for graphs of up to a few thousand vertices."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Koren, “Drawing graphs by eigenvectors: theory and practice”, Computers & Mathematics with"},{"type":"text","text":" "},{"type":"text","text":"Applications 49(11–12), 2005."}]}]}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every weight is finite and not negative; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}],"type":"paragraph"}]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), with"},{"type":"text","text":" "},{"type":"text","text":"that count and the off-diagonal entry being reduced, relative to the largest entry of its"},{"type":"text","text":" "},{"type":"text","text":"block. The iteration converges cubically, about two iterations per eigenvalue."}]}]}]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"abstract":[{"text":"A drawing whose axes are eigenvectors of the Laplacian: x is the eigenvector of the second","type":"text"},{"text":" ","type":"text"},{"text":"smallest eigenvalue of L = D − A (the Fiedler vector of a connected graph) and y that of","type":"text"},{"text":" ","type":"text"},{"text":"the third, both of unit length, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"}],"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/spectrallayout(weight:maxiterations:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/spectralLayout(weight:maxIterations:)":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/spectralLayout(weight:maxIterations:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spectralLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","