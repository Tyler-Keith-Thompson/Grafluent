{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/multidimensionalscalinglayout(edgelength:maxiterations:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"multidimensionalScalingLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edgeLength","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The distance d_ij of two vertices is their shortest-path distance with ","type":"text"},{"type":"codeVoice","code":"edgeLength"},{"text":" (hops by","type":"text"},{"text":" ","type":"text"},{"text":"default); between components it is 1 + L̄·√n, L̄ the mean edge length, as in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"stressMajorizationLayout()"},{"text":". With B = −½ J D⁽²⁾ J (D⁽²⁾ the squared distances, J the centring","type":"text"},{"text":" ","type":"text"},{"text":"matrix), x is √λ₁ · v₁ and y is √λ₂ · v₂ for the two largest eigenvalues λ₁ ≥ λ₂ of B and","type":"text"},{"text":" ","type":"text"},{"text":"their unit eigenvectors (a negative eigenvalue gives 0). When the distances are Euclidean","type":"text"},{"text":" ","type":"text"},{"text":"in the plane, the drawing reproduces them exactly, up to a rigid motion. Each axis’s sign","type":"text"},{"text":" ","type":"text"},{"text":"makes its first entry, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, whose magnitude is at least 10⁻⁴ of its","type":"text"},{"text":" ","type":"text"},{"text":"largest positive. The drawing is centred on the origin. A directed graph is drawn through","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Torgerson, “Multidimensional scaling: I. Theory and method”, Psychometrika 17(4), 1952.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the"},{"type":"text","text":" "},{"type":"text","text":"lengths differ), then O(n³) for the dense eigensystem; n² "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"text":"Every edge length is positive and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at","type":"text"},{"text":" ","type":"text"},{"text":"least 1.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), as"},{"type":"text","text":" "},{"type":"codeVoice","code":"spectralLayout(weight:maxIterations:)"},{"type":"text","text":"."}]}],"style":"note","type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/multidimensionalScalingLayout(edgeLength:maxIterations:)"},"metadata":{"role":"symbol","externalID":"s:14GraphProtocols0A0P0A7DrawingE29multidimensionalScalingLayout10edgeLength13maxIterationsAD0C0Vy6VertexQzGSd5Edges_5IndexQZXE_SiSgtAA13NoConvergenceVYKF","extendedModule":"GraphProtocols","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"multidimensionalScalingLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edgeLength","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier"