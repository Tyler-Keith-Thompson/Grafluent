:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The distance d_ij of two vertices is their shortest-path distance with "},{"type":"codeVoice","code":"edgeLength"},{"type":"text","text":" (hops by"},{"type":"text","text":" "},{"type":"text","text":"default); between components it is 1 + L̄·√n, L̄ the mean edge length, as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"stressMajorizationLayout()"},{"type":"text","text":". With B = −½ J D⁽²⁾ J (D⁽²⁾ the squared distances, J the centring"},{"type":"text","text":" "},{"type":"text","text":"matrix), x is √λ₁ · v₁ and y is √λ₂ · v₂ for the two largest eigenvalues λ₁ ≥ λ₂ of B and"},{"type":"text","text":" "},{"type":"text","text":"their unit eigenvectors (a negative eigenvalue gives 0). When the distances are Euclidean"},{"type":"text","text":" "},{"type":"text","text":"in the plane, the drawing reproduces them exactly, up to a rigid motion. Each axis’s sign"},{"type":"text","text":" "},{"type":"text","text":"makes its first entry, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, whose magnitude is at least 10⁻⁴ of its"},{"type":"text","text":" "},{"type":"text","text":"largest positive. The drawing is centred on the origin. A directed graph is drawn through"},{"type":"text","text":" "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Torgerson, “Multidimensional scaling: I. Theory and method”, Psychometrika 17(4), 1952."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the"},{"type":"text","text":" "},{"type":"text","text":"lengths differ), then O(n³) for the dense eigensystem; n² "},{"type":"codeVoice","code":"Double"},{"type":"text","text":"s."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"code":"maxIterations","type":"codeVoice"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}]}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), as"},{"type":"text","text":" "},{"type":"codeVoice","code":"spectralLayout(weight:maxIterations:)"},{"type":"text","text":"."}]}],"name":"Throws","type":"aside","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/multidimensionalscalinglayout(edgelength:maxiterations:)"]}],"kind":"symbol","abstract":[{"text":"A drawing by classical multidimensional scaling of the shortest-path distances: the","type":"text"},{"text":" ","type":"text"},{"text":"coordinates of the best rank-2 approximation of the doubly centred squared distances.","type":"text"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/NoConvergence":{"title":"NoConvergence","type":"topic","navigatorTitle":[{"text":"NoConvergence","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NoConvergence","kind":"identifier"}],"abstract":[{"type":"text","text":"The error an iterative method throws when it uses up its iteration limit without meeting its"},{"type":"text","text":" "},{"type":"text","text":"stopping rule."}],"kind":"symbol","url":"\/documentation\/graphprotocols\/noconvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphPro