h is drawn through"},{"type":"text","text":" "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Torgerson, “Multidimensional scaling: I. Theory and method”, Psychometrika 17(4), 1952.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the","type":"text"},{"text":" ","type":"text"},{"text":"lengths differ), then O(n³) for the dense eigensystem; n² ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}]}],"name":"Precondition","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), as"},{"type":"text","text":" "},{"type":"codeVoice","code":"spectralLayout(weight:maxIterations:)"},{"type":"text","text":"."}]}],"name":"Throws","type":"aside"}],"kind":"content"}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"multidimensionalScalingLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edgeLength","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"t