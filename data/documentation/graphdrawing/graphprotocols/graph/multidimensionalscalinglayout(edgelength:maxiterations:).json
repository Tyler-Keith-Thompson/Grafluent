rces\/GraphDrawing\/SpectralLayout.swift#L59","fileName":"SpectralLayout.swift"},"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A drawing by classical multidimensional scaling of the shortest-path distances: the","type":"text"},{"text":" ","type":"text"},{"text":"coordinates of the best rank-2 approximation of the doubly centred squared distances.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"multidimensionalScalingLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edgeLength","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The distance d_ij of two vertices is their shortest-path distance with "},{"type":"codeVoice","code":"edgeLength"},{"type":"text","text":" (hops by"},{"type":"text","text":" "},{"type":"text","text":"default); between components it is 1 + L̄·√n, L̄ the mean edge length, as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"stressMajorizationLayout()"},{"type":"text","text":". With B = −½ J D⁽²⁾ J (D⁽²⁾ the squared distances, J the centring"},{"type":"text","text":" "},{"type":"text","text":"matrix), x is √λ₁ · v₁ and y is √λ₂ · v₂ for the two largest eigenvalues λ₁ ≥ λ₂ of B and"},{"type":"text","text":" "},{"type":"text","text":"their unit eigenvectors (a negative eigenvalue gives 0). When the distances are Euclidean"},{"type":"text","text":" "},{"type":"text","text":"in the plane, the drawing reproduces them exactly, up to a rigid motion. Each axis’s sign"},{"type":"text","text":" "},{"type":"text","text":"makes its first entry, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, whose magnitude is at least 10⁻⁴ of its"},{"type":"text","text":" "},{"type":"text","text":"largest positive. The drawing is centred on the origin. A directed graph is drawn through"},{"type":"text","text":" "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Torgerson, “Multidimensional scaling: I. Theory and method”, Psychometrika 17(4), 1952."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the","type":"text"},{"text":" ","type":"text"},{"text":"lengths differ), then O(n³) for the dense eigensystem; n² ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}],"type":"paragraph"}],"type":"aside","name":"Precondition"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NoConvergence"},{"text":" after ","type":"text"},{"type":"codeVoice","code":"maxIterations"},{"text":" QL iterations in all (30 n when nil), as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"spectralLayout(weight:maxIterations:)"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Throws"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/multidimensionalscalinglayout(edgelength:maxiterations:)"]}],"kind":"symbol","references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"title":"Graph","url":"\/documentation\/graphdrawing\/graphprotocols\/graph","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","abstract":[],"type":"topic","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"type":"topic","url":"\/documentation\/grap