{"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"A drawing by classical multidimensional scaling of the shortest-path distances: the"},{"type":"text","text":" "},{"type":"text","text":"coordinates of the best rank-2 approximation of the doubly centred squared distances."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/multidimensionalscalinglayout(edgelength:maxiterations:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"multidimensionalScalingLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edgeLength","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":") -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":" = { _ in 1 }, ","kind":"text"},{"text":"maxIterations","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"? = nil) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NoConvergence","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"text":") -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">","kind":"text"}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The distance d_ij of two vertices is their shortest-path distance with ","type":"text"},{"type":"codeVoice","code":"edgeLength"},{"text":" (hops by","type":"text"},{"text":" ","type":"text"},{"text":"default); between components it is 1 + L̄·√n, L̄ the mean edge length, as in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"stressMajorizationLayout()"},{"text":". With B = −½ J D⁽²⁾ J (D⁽²⁾ the squared distances, J the centring","type":"text"},{"text":" ","type":"text"},{"text":"matrix), x is √λ₁ · v₁ and y is √λ₂ · v₂ for the two largest eigenvalues λ₁ ≥ λ₂ of B and","type":"text"},{"text":" ","type":"text"},{"text":"their unit eigenvectors (a negative eigenvalue gives 0). When the distances are Euclidean","type":"text"},{"text":" ","type":"text"},{"text":"in the plane, the drawing reproduces them exactly, up to a rigid motion. Each axis’s sign","type":"text"},{"text":" ","type":"text"},{"text":"makes its first entry, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, whose magnitude is at least 10⁻⁴ of its","type":"text"},{"text":" ","type":"text"},{"text":"largest positive. The drawing is centred on the origin. A directed graph is drawn through","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Torgerson, “Multidimensional scaling: I. Theory and method”, Psychometrika 17(4), 1952."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the","type":"text"},{"text":" ","type":"text"},{"text":"lengths differ), then O(n³) for the dense eigensystem; n² ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":"s.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Every edge length is positive and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at","type":"text"},{"text":" ","type":"text"},{"text":"least 1.","type":"text"}]}],"name":"Precondition"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), as"},{"type":"text","text":" "},{"type":"codeVoice","code":"spectralLayout(weight:maxIterations:)"},{"type":"text","text":"."}]}],"name":"Throws"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"remoteSource":{"fileName":"SpectralLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/SpectralLayout.swift#L59"},"extendedModule":"GraphProtocols","symbolKind":"method","role":"symbol","externalID":"s:14GraphProtocols0A0P0A7DrawingE29multidimensionalScalingLayout10edgeLength13maxIterationsAD0C0Vy6VertexQzGSd5Edges_5IndexQZXE_SiSgtAA13NoConvergenceVYKF","modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"title":"multidimensionalScalingLayout(edgeLength:maxIterations:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"multidimensionalScalingLayout"},{"kind":"text","text":"("},{"kind":"externalPar