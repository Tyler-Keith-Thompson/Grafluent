n³) for the dense eigensystem; n² "},{"code":"Double","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Every edge length is positive and finite; ","type":"text"},{"code":"maxIterations","type":"codeVoice"},{"text":", when given, is at","type":"text"},{"text":" ","type":"text"},{"text":"least 1.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), as"},{"type":"text","text":" "},{"type":"codeVoice","code":"spectralLayout(weight:maxIterations:)"},{"type":"text","text":"."}]}],"style":"note","name":"Throws","type":"aside"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/multidimensionalScalingLayout(edgeLength:maxIterations:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"kind":"symbol","references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/multidimensionalScalingLayout(edgeLength:maxIterations:)":{"title":"multidimensionalScalingLayout(edgeLength:maxIterations:)","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/multidimensionalscalinglayout(edgelength:maxiterations:)","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/multidimensionalScalingLayout(edgeLength:maxIterations:)","kind":"symbol","role":"symbol","abstract":[{"text":"A drawing by classical multidimensional scaling of the shortest-path distances: the","type":"text"},{"text":"