text":"NoConvergence","preciseIdentifier":"s:14GraphProtocols13NoConvergenceV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The distance d_ij of two vertices is their shortest-path distance with ","type":"text"},{"code":"edgeLength","type":"codeVoice"},{"text":" (hops by","type":"text"},{"text":" ","type":"text"},{"text":"default); between components it is 1 + L̄·√n, L̄ the mean edge length, as in","type":"text"},{"text":" ","type":"text"},{"code":"stressMajorizationLayout()","type":"codeVoice"},{"text":". With B = −½ J D⁽²⁾ J (D⁽²⁾ the squared distances, J the centring","type":"text"},{"text":" ","type":"text"},{"text":"matrix), x is √λ₁ · v₁ and y is √λ₂ · v₂ for the two largest eigenvalues λ₁ ≥ λ₂ of B and","type":"text"},{"text":" ","type":"text"},{"text":"their unit eigenvectors (a negative eigenvalue gives 0). When the distances are Euclidean","type":"text"},{"text":" ","type":"text"},{"text":"in the plane, the drawing reproduces them exactly, up to a rigid motion. Each axis’s sign","type":"text"},{"text":" ","type":"text"},{"text":"makes its first entry, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, whose magnitude is at least 10⁻⁴ of its","type":"text"},{"text":" ","type":"text"},{"text":"largest positive. The drawing is centred on the origin. A directed graph is drawn through","type":"text"},{"text":" ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Torgerson, “Multidimensional scaling: I. Theory and method”, Psychometrika 17(4), 1952."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"O(n·(n + m)) for the distances by breadth-first search (O(n·m log n) by Dijkstra when the","type":"text"},{"text":" ","type":"text"},{"text":"lengths differ), then O(n³) for the dense eigensystem; n² ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":"s.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every edge length is positive and finite; "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":", when given, is at"},{"type":"text","text":" "},{"type":"text","text":"least 1."}]}],"name":"Precondition"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NoConvergence"},{"type":"text","text":" after "},{"type":"codeVoice","code":"maxIterations"},{"type":"text","text":" QL iterations in all (30 n when nil), as"},{"type":"text","text":" "},{"type":"codeVoice","code":"spectralLayout(weight:maxIterations:)"},{"type":"text","text":"."}]}],"name":"Throws"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Edges-swift.associatedtype":{"title":"Edges","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sl","text":"Collection","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Edges-swift.associatedtype","url":"\/documentation\/graphprotocols\/graph\/edges-swift.associatedtype","kind":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing":{"ident