{"metadata":{"externalID":"s:14GraphProtocols0A0P0A7DrawingE12planarLayoutAD0C0Vy6VertexQzGSgyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"symbolKind":"method","title":"planarLayout()","modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"roleHeading":"Instance Method","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/PlanarLayout.swift#L31","fileName":"PlanarLayout.swift"},"extendedModule":"GraphProtocols"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarLayout"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">?"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The drawing, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, or nil when the graph has no planar embedding.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"The drawing comes from ","type":"text"},{"code":"planarEmbedding()","type":"codeVoice"},{"text":" by de Fraysseix, Pach and Pollack’s shift method","type":"text"},{"text":" ","type":"text"},{"text":"in Chrobak and Payne’s linear-time form. The embedding of the underlying simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(self-loops and parallel copies drawn as one segment) is first made connected, by an edge","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex of each component to the first vertex of the next, and every face","type":"text"},{"text":" ","type":"text"},{"text":"boundary a simple cycle; then every face but the largest (the outer face) is triangulated.","type":"text"},{"text":" ","type":"text"},{"text":"The vertices are placed in a canonical ordering of that graph, each one above the contour","type":"text"},{"text":" ","type":"text"},{"text":"of those before it, the contour shifted to make room. The added edges are not drawn and not","type":"text"},{"text":" ","type":"text"},{"text":"reported. Every vertex has integer coordinates with 0 ≤ x ≤ 2n − 4 and 0 ≤ y ≤ n − 2, and no","type":"text"},{"text":" ","type":"text"},{"text":"two edges cross or overlap. Fewer than four vertices are placed at (0, 0), (2, 0) and","type":"text"},{"text":" ","type":"text"},{"text":"(1, 1) in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. The drawing is not rescaled (","type":"text"},{"code":"rescaled(scale:center:)","type":"codeVoice"},{"text":" maps it","type":"text"},{"text":" ","type":"text"},{"text":"to a common frame). A directed graph is drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"de Fraysseix, Pach and Pollack, “How to draw a planar graph on a grid”, Combinatorica"},{"type":"text","text":" "},{"type":"text","text":"10(1), 1990."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Chrobak and Payne, “A linear-time algorithm for drawing a planar graph on a grid”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 54(4), 1995."}]}]}]},{"inlineContent":[{"type":"text","text":"O(n + m) for the embedding, then O(n) expected (hashing the triangulation’s vertex pairs)."}],"type":"paragraph"},{"name":"Precondition","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"As for "},{"type":"codeVoice","code":"planarEmbedding()"},{"type":"text","text":"."}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not"},{"type":"text","text":" "},{"type":"text","text":"planar."}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"references":{"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","url":"\/documentation\/graphdrawing\/drawing","title":"Drawing"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/planarLayout()":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">?"}],"abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"title":"planarLayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/graphdrawing\/graphprotocols\/graph","type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","abstract":[],"kind":"symbol","title":"Graph","role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"kind":"symbol","title":"GraphProtocols","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"title":"Vertex","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]},"doc://GraphDrawing/documentation/GraphDrawing":{"type":"topic","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","url":"\/documentation\/graphdrawing","title":"GraphDrawing"}}}