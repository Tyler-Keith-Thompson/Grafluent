ut()","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphdrawing\/drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"symbol","title":"Drawing","type":"topic"}}}