{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"metadata":{"roleHeading":"Instance Method","extendedModule":"GraphProtocols","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarLayout"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"remoteSource":{"fileName":"PlanarLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/PlanarLayout.swift#L31"},"modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"externalID":"s:14GraphProtocols0A0P0A7DrawingE12planarLayoutAD0C0Vy6VertexQzGSgyF","symbolKind":"method","title":"planarLayout()","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">?","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The drawing, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, or nil when the graph has no planar embedding."}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The drawing comes from "},{"type":"codeVoice","code":"planarEmbedding()"},{"type":"text","text":" by de Fraysseix, Pach and Pollack’s shift method"},{"type":"text","text":" "},{"type":"text","text":"in Chrobak and Payne’s linear-time form. The embedding of the underlying simple graph"},{"type":"text","text":" "},{"type":"text","text":"(self-loops and parallel copies drawn as one segment) is first made connected, by an edge"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex of each component to the first vertex of the next, and every face"},{"type":"text","text":" "},{"type":"text","text":"boundary a simple cycle; then every face but the largest (the outer face) is triangulated."},{"type":"text","text":" "},{"type":"text","text":"The vertices are placed in a canonical ordering of that graph, each one above the contour"},{"type":"text","text":" "},{"type":"text","text":"of those before it, the contour shifted to make room. The added edges are not drawn and not"},{"type":"text","text":" "},{"type":"text","text":"reported. Every vertex has integer coordinates with 0 ≤ x ≤ 2n − 4 and 0 ≤ y ≤ n − 2, and no"},{"type":"text","text":" "},{"type":"text","text":"two edges cross or overlap. Fewer than four vertices are placed at (0, 0), (2, 0) and"},{"type":"text","text":" "},{"type":"text","text":"(1, 1) in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. The drawing is not rescaled ("},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"type":"text","text":" maps it"},{"type":"text","text":" "},{"type":"text","text":"to a common frame). A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"de Fraysseix, Pach and Pollack, “How to draw a planar graph on a grid”, Combinatorica","type":"text"},{"text":" ","type":"text"},{"text":"10(1), 1990.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Chrobak and Payne, “A linear-time algorithm for drawing a planar graph on a grid”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 54(4), 1995."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(n + m) for the embedding, then O(n) expected (hashing the triangulation’s vertex pairs)."}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":"As for "},{"code":"planarEmbedding()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"]}],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/planarLayout()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">?"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","title":"planarLayout()","type":"topic","kind":"symbol","abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"abstract":[],"role":"collection","kind":"symbol","title":"GraphProtocols","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"abstract":[],"role":"symbol","kind":"symbol","title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols\/graph"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"role":"symbol","url":"\/documentation\/graphdrawing\/drawing","kind":"symbol","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"type":"topic","title":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},"doc://GraphDrawing/documentation/GraphDrawing":{"role":"collection","title":"GraphDrawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/graphdrawing"}}}