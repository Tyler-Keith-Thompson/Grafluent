{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"]}],"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"extendedModule":"GraphProtocols","roleHeading":"Instance Method","modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P0A7DrawingE12planarLayoutAD0C0Vy6VertexQzGSgyF","title":"planarLayout()","role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"remoteSource":{"fileName":"PlanarLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/PlanarLayout.swift#L31"}},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The drawing, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, or nil when the graph has no planar embedding.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The drawing comes from ","type":"text"},{"code":"planarEmbedding()","type":"codeVoice"},{"text":" by de Fraysseix, Pach and Pollack’s shift method","type":"text"},{"text":" ","type":"text"},{"text":"in Chrobak and Payne’s linear-time form. The embedding of the underlying simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(self-loops and parallel copies drawn as one segment) is first made connected, by an edge","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex of each component to the first vertex of the next, and every face","type":"text"},{"text":" ","type":"text"},{"text":"boundary a simple cycle; then every face but the largest (the outer face) is triangulated.","type":"text"},{"text":" ","type":"text"},{"text":"The vertices are placed in a canonical ordering of that graph, each one above the contour","type":"text"},{"text":" ","type":"text"},{"text":"of those before it, the contour shifted to make room. The added edges are not drawn and not","type":"text"},{"text":" ","type":"text"},{"text":"reported. Every vertex has integer coordinates with 0 ≤ x ≤ 2n − 4 and 0 ≤ y ≤ n − 2, and no","type":"text"},{"text":" ","type":"text"},{"text":"two edges cross or overlap. Fewer than four vertices are placed at (0, 0), (2, 0) and","type":"text"},{"text":" ","type":"text"},{"text":"(1, 1) in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. The drawing is not rescaled (","type":"text"},{"code":"rescaled(scale:center:)","type":"codeVoice"},{"text":" maps it","type":"text"},{"text":" ","type":"text"},{"text":"to a common frame). A directed graph is drawn through ","type":"text"},{"code":"undirectedView","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"de Fraysseix, Pach and Pollack, “How to draw a planar graph on a grid”, Combinatorica","type":"text"},{"text":" ","type":"text"},{"text":"10(1), 1990.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Chrobak and Payne, “A linear-time algorithm for drawing a planar graph on a grid”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 54(4), 1995."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m) for the embedding, then O(n) expected (hashing the triangulation’s vertex pairs)."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"As for "},{"code":"planarEmbedding()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/planarLayout()":{"title":"planarLayout()","type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not"},{"type":"text","text":" "},{"type":"text","text":"planar."}],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing":{"url":"\/documentation\/graphdrawing","type":"topic","kind":"symbol","title":"GraphDrawing","abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","role":"collection"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","url":"\/documentation\/graphdrawing\/graphprotocols\/graph","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","title":"GraphProtocols"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"title":"Vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"url":"\/documentation\/graphdrawing\/drawing","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"title":"Drawing","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drawing"}]}}}