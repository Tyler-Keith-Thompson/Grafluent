{"metadata":{"modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}],"remoteSource":{"fileName":"PlanarLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/PlanarLayout.swift#L31"},"externalID":"s:14GraphProtocols0A0P0A7DrawingE12planarLayoutAD0C0Vy6VertexQzGSgyF","symbolKind":"method","roleHeading":"Instance Method","title":"planarLayout()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">?"}],"role":"symbol","extendedModule":"GraphProtocols"},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The drawing, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, or nil when the graph has no planar embedding.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The drawing comes from ","type":"text"},{"type":"codeVoice","code":"planarEmbedding()"},{"text":" by de Fraysseix, Pach and Pollack’s shift method","type":"text"},{"text":" ","type":"text"},{"text":"in Chrobak and Payne’s linear-time form. The embedding of the underlying simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(self-loops and parallel copies drawn as one segment) is first made connected, by an edge","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex of each component to the first vertex of the next, and every face","type":"text"},{"text":" ","type":"text"},{"text":"boundary a simple cycle; then every face but the largest (the outer face) is triangulated.","type":"text"},{"text":" ","type":"text"},{"text":"The vertices are placed in a canonical ordering of that graph, each one above the contour","type":"text"},{"text":" ","type":"text"},{"text":"of those before it, the contour shifted to make room. The added edges are not drawn and not","type":"text"},{"text":" ","type":"text"},{"text":"reported. Every vertex has integer coordinates with 0 ≤ x ≤ 2n − 4 and 0 ≤ y ≤ n − 2, and no","type":"text"},{"text":" ","type":"text"},{"text":"two edges cross or overlap. Fewer than four vertices are placed at (0, 0), (2, 0) and","type":"text"},{"text":" ","type":"text"},{"text":"(1, 1) in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. The drawing is not rescaled (","type":"text"},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"text":" maps it","type":"text"},{"text":" ","type":"text"},{"text":"to a common frame). A directed graph is drawn through ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"de Fraysseix, Pach and Pollack, “How to draw a planar graph on a grid”, Combinatorica","type":"text"},{"text":" ","type":"text"},{"text":"10(1), 1990.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Chrobak and Payne, “A linear-time algorithm for drawing a planar graph on a grid”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 54(4), 1995."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"O(n + m) for the embedding, then O(n) expected (hashing the triangulation’s vertex pairs).","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"As for ","type":"text"},{"type":"codeVoice","code":"planarEmbedding()"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","type":"topic"},"