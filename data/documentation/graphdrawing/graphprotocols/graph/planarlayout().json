{"metadata":{"title":"planarLayout()","symbolKind":"method","role":"symbol","remoteSource":{"fileName":"PlanarLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/PlanarLayout.swift#L31"},"roleHeading":"Instance Method","extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P0A7DrawingE12planarLayoutAD0C0Vy6VertexQzGSgyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">?","kind":"text"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"GraphDrawing"}]},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()"},"abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":">?","kind":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The drawing, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, or nil when the graph has no planar embedding."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The drawing comes from "},{"type":"codeVoice","code":"planarEmbedding()"},{"type":"text","text":" by de Fraysseix, Pach and Pollack’s shift method"},{"type":"text","text":" "},{"type":"text","text":"in Chrobak and Payne’s linear-time form. The embedding of the underlying simple graph"},{"type":"text","text":" "},{"type":"text","text":"(self-loops and parallel copies drawn as one segment) is first made connected, by an edge"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex of each component to the first vertex of the next, and every face"},{"type":"text","text":" "},{"type":"text","text":"boundary a simple cycle; then every face but the largest (the outer face) is triangulated."},{"type":"text","text":" "},{"type":"text","text":"The vertices are placed in a canonical ordering of that graph, each one above the contour"},{"type":"text","text":" "},{"type":"text","text":"of those before it, the contour shifted to make room. The added edges are not drawn and not"},{"type":"text","text":" "},{"type":"text","text":"reported. Every vertex has integer coordinates with 0 ≤ x ≤ 2n − 4 and 0 ≤ y ≤ n − 2, and no"},{"type":"text","text":" "},{"type":"text","text":"two edges cross or overlap. Fewer than four vertices are placed at (0, 0), (2, 0) and"},{"type":"text","text":" "},{"type":"text","text":"(1, 1) in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. The drawing is not rescaled ("},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"type":"text","text":" maps it"},{"type":"text","text":" "},{"type":"text","text":"to a common frame). A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}]},{"items":[{"content":[{"inlineContent":[{"text":"de Fraysseix, Pach and Pollack, “How to draw a planar graph on a grid”, Combinatorica","type":"text"},{"text":" ","type":"text"},{"text":"10(1), 1990.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Chrobak and Payne, “A linear-time algorithm for drawing a planar graph on a grid”,","type":"text"},{"text":" ","type":"text"},{"text":"Information Processing Letters 54(4), 1995.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m) for the embedding, then O(n) expected (hashing the triangulation’s vertex pairs)."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"As for "},{"type":"codeVoice","code":"planarEmbedding()"},{"type":"text","text":"."}]}]}]}],"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"type":"topic","role":"collection","title":"GraphProtocols","abstract":[],"url":"\/documentation\/graphdrawing\/graphprotocols","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","role":"symbol","title":"Drawing","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"url":"\/documentation\/graphdrawing\/drawing","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/planarLayout()":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"kind":"symbol","title":"planarLayout()","role":"symbol","abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{