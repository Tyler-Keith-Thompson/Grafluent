{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()"},"sections":[],"metadata":{"modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"role":"symbol","roleHeading":"Instance Method","title":"planarLayout()","externalID":"s:14GraphProtocols0A0P0A7DrawingE12planarLayoutAD0C0Vy6VertexQzGSgyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">?","kind":"text"}],"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/PlanarLayout.swift#L31","fileName":"PlanarLayout.swift"},"extendedModule":"GraphProtocols"},"abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":">?","kind":"text"}]}]},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The drawing, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, or nil when the graph has no planar embedding.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The drawing comes from "},{"type":"codeVoice","code":"planarEmbedding()"},{"type":"text","text":" by de Fraysseix, Pach and Pollack’s shift method"},{"type":"text","text":" "},{"type":"text","text":"in Chrobak and Payne’s linear-time form. The embedding of the underlying simple graph"},{"type":"text","text":" "},{"type":"text","text":"(self-loops and parallel copies drawn as one segment) is first made connected, by an edge"},{"type":"text","text":" "},{"type":"text","text":"from the first vertex of each component to the first vertex of the next, and every face"},{"type":"text","text":" "},{"type":"text","text":"boundary a simple cycle; then every face but the largest (the outer face) is triangulated."},{"type":"text","text":" "},{"type":"text","text":"The vertices are placed in a canonical ordering of that graph, each one above the contour"},{"type":"text","text":" "},{"type":"text","text":"of those before it, the contour shifted to make room. The added edges are not drawn and not"},{"type":"text","text":" "},{"type":"text","text":"reported. Every vertex has integer coordinates with 0 ≤ x ≤ 2n − 4 and 0 ≤ y ≤ n − 2, and no"},{"type":"text","text":" "},{"type":"text","text":"two edges cross or overlap. Fewer than four vertices are placed at (0, 0), (2, 0) and"},{"type":"text","text":" "},{"type":"text","text":"(1, 1) in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. The drawing is not rescaled ("},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"type":"text","text":" maps it"},{"type":"text","text":" "},{"type":"text","text":"to a common frame). A directed graph is drawn through "},{"type":"codeVoice","code":"undirectedView"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"de Fraysseix, Pach and Pollack, “How to draw a planar graph on a grid”, Combinatorica"},{"type":"text","text":" "},{"type":"text","text":"10(1), 1990."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Chrobak and Payne, “A linear-time algorithm for drawing a planar graph on a grid”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 54(4), 1995."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"O(n + m) for the embedding, then O(n) expected (hashing the triangulation’s vertex pairs)."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"As for ","type":"text"},{"type":"codeVoice","code":"planarEmbedding()"},{"text":".","type":"text"}]}],"type":"aside","style":"note","name":"Precondition"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"abstract":[],"url":"\/documentation\/graphdrawing","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","role":"collection","title":"GraphDrawing","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/planarLayout()":{"url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","title":"planarLayout()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"planarLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">?"}],"type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not","type":"text"},{"text":" ","type":"text"},{"text":"planar.","type":"text"}]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"abstract":[],"type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","role":"collection","title":"GraphProtocols","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph":{"abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","url":"\/documentation\/graphdrawing\/graphprotocols\/graph","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph","role":"symbol","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"url":"\/documentation\/graphdrawing\/drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"title":"Drawing","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}]}}}