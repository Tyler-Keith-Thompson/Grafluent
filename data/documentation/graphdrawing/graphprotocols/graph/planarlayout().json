{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not"},{"type":"text","text":" "},{"type":"text","text":"planar."}],"variants":[{"paths":["\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":">?","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The drawing, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, or nil when the graph has no planar embedding."}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The drawing comes from ","type":"text"},{"type":"codeVoice","code":"planarEmbedding()"},{"text":" by de Fraysseix, Pach and Pollack’s shift method","type":"text"},{"text":" ","type":"text"},{"text":"in Chrobak and Payne’s linear-time form. The embedding of the underlying simple graph","type":"text"},{"text":" ","type":"text"},{"text":"(self-loops and parallel copies drawn as one segment) is first made connected, by an edge","type":"text"},{"text":" ","type":"text"},{"text":"from the first vertex of each component to the first vertex of the next, and every face","type":"text"},{"text":" ","type":"text"},{"text":"boundary a simple cycle; then every face but the largest (the outer face) is triangulated.","type":"text"},{"text":" ","type":"text"},{"text":"The vertices are placed in a canonical ordering of that graph, each one above the contour","type":"text"},{"text":" ","type":"text"},{"text":"of those before it, the contour shifted to make room. The added edges are not drawn and not","type":"text"},{"text":" ","type":"text"},{"text":"reported. Every vertex has integer coordinates with 0 ≤ x ≤ 2n − 4 and 0 ≤ y ≤ n − 2, and no","type":"text"},{"text":" ","type":"text"},{"text":"two edges cross or overlap. Fewer than four vertices are placed at (0, 0), (2, 0) and","type":"text"},{"text":" ","type":"text"},{"text":"(1, 1) in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. The drawing is not rescaled (","type":"text"},{"type":"codeVoice","code":"rescaled(scale:center:)"},{"text":" maps it","type":"text"},{"text":" ","type":"text"},{"text":"to a common frame). A directed graph is drawn through ","type":"text"},{"type":"codeVoice","code":"undirectedView"},{"text":".","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"de Fraysseix, Pach and Pollack, “How to draw a planar graph on a grid”, Combinatorica"},{"type":"text","text":" "},{"type":"text","text":"10(1), 1990."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Chrobak and Payne, “A linear-time algorithm for drawing a planar graph on a grid”,"},{"type":"text","text":" "},{"type":"text","text":"Information Processing Letters 54(4), 1995."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"O(n + m) for the embedding, then O(n) expected (hashing the triangulation’s vertex pairs)."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"As for ","type":"text"},{"type":"codeVoice","code":"planarEmbedding()"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Precondition"}],"kind":"content"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/PlanarLayout.swift#L31","fileName":"PlanarLayout.swift"},"title":"planarLayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">?","kind":"text"}],"modules":[{"name":"GraphDrawing","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P0A7DrawingE12planarLayoutAD0C0Vy6VertexQzGSgyF","role":"symbol","roleHeading":"Instance Method","symbolKind":"method"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()"},"references":{"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols":{"url":"\/documentation\/graphdrawing\/graphprotocols","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols","abstract":[],"title":"GraphProtocols","kind":"symbol","role":"collection","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","title":"Drawing","url":"\/documentation\/graphdrawing\/drawing","type":"topic","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"navigatorTitle":[{"text":"Drawing","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"kind":"symbol","title":"Vertex","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://GraphDrawing/documentation/GraphDrawing":{"kind":"symbol","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","title":"GraphDrawing","url":"\/documentation\/graphdrawing","type":"topic","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/GraphProtocols/Graph/planarLayout()":{"abstract":[{"type":"text","text":"A crossing-free straight-line drawing on an integer grid, or nil when the graph is not"},{"type":"text","text":" "},{"type":"text","text":"planar."}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/GraphProtocols\/Graph\/planarLayout()","kind":"symbol","role":"symbol","url":"\/documentation\/graphdrawing\/graphprotocols\/graph\/planarlayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"planarLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"te