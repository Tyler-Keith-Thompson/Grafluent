{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"]}],"abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"sections":[],"metadata":{"modules":[{"relatedModules":["Trees"],"name":"GraphDrawing"}],"symbolKind":"method","externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF","title":"reingoldTilfordLayout()","roleHeading":"Instance Method","extendedModule":"Trees","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L38","fileName":"ReingoldTilfordLayout.swift"},"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order, vertices at one depth at least 1 apart along each subtree’s"},{"type":"text","text":" "},{"type":"text","text":"contour, and every parent centred over its first and last child. Where two subtrees are"},{"type":"text","text":" "},{"type":"text","text":"pushed apart, the smaller subtrees between them are spaced evenly. A mirrored tree draws as"},{"type":"text","text":" "},{"type":"text","text":"the reflection of the drawing, and isomorphic subtrees are drawn identically up to"},{"type":"text","text":" "},{"type":"text","text":"translation. Separations and centring give multiples of a power of ½, which are exact in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":". The even spacing divides a shift by the number of gaps, so values such as ±5\/6"},{"type":"text","text":" "},{"type":"text","text":"occur and are rounded, and a mirrored tree’s drawing then matches the reflection only to"},{"type":"text","text":" "},{"type":"text","text":"rounding."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software"},{"type":"text","text":" "},{"type":"text","text":"Engineering SE-7(2), 1981."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and"},{"type":"text","text":" "},{"type":"text","text":"Experience 20(7), 1990."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,","type":"text"},{"text":" ","type":"text"},{"text":"Graph Drawing (GD 2002), LNCS 2528, 2002.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n) time and memory, with no recursion."}]}],"kind":"content"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","role":"symbol","title":"Drawing","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"url":"\/documentation\/graphdrawing\/drawing","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing":{"type":"topic","role":"collection","title":"GraphDrawing","abstract":[],"url":"\/documentation\/graphdrawing","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"kind":"symbol","type":"topic","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefi