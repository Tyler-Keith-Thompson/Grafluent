{"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order, vertices at one depth at least 1 apart along each subtree’s"},{"type":"text","text":" "},{"type":"text","text":"contour, and every parent centred over its first and last child. Where two subtrees are"},{"type":"text","text":" "},{"type":"text","text":"pushed apart, the smaller subtrees between them are spaced evenly. A mirrored tree draws as"},{"type":"text","text":" "},{"type":"text","text":"the reflection of the drawing, and isomorphic subtrees are drawn identically up to"},{"type":"text","text":" "},{"type":"text","text":"translation. Separations and centring give multiples of a power of ½, which are exact in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":". The even spacing divides a shift by the number of gaps, so values such as ±5\/6"},{"type":"text","text":" "},{"type":"text","text":"occur and are rounded, and a mirrored tree’s drawing then matches the reflection only to"},{"type":"text","text":" "},{"type":"text","text":"rounding."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software","type":"text"},{"text":" ","type":"text"},{"text":"Engineering SE-7(2), 1981.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and"},{"type":"text","text":" "},{"type":"text","text":"Experience 20(7), 1990."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,"},{"type":"text","text":" "},{"type":"text","text":"Graph Drawing (GD 2002), LNCS 2528, 2002."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"O(n) time and memory, with no recursion.","type":"text"}]}]}],"metadata":{"roleHeading":"Instance Method","title":"reingoldTilfordLayout()","extendedModule":"Trees","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}]},"remoteSource":{"fileName":"ReingoldTilfordLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L38"},"role":"symbol","modules":[{"name":"GraphDrawing","relatedModules":["Trees"]}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"symbolKind":"method","externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF"},"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"title":"reingoldTilfordLayout()","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"type":"topic"},"doc://GraphDrawing/documentation/Grap