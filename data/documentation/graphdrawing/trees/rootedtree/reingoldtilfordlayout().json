{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"GraphDrawing","relatedModules":["Trees"]}],"title":"reingoldTilfordLayout()","externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method","remoteSource":{"fileName":"ReingoldTilfordLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L38"},"extendedModule":"Trees","conformance":{"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]}},"abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order, vertices at one depth at least 1 apart along each subtree’s"},{"type":"text","text":" "},{"type":"text","text":"contour, and every parent centred over its first and last child. Where two subtrees are"},{"type":"text","text":" "},{"type":"text","text":"pushed apart, the smaller subtrees between them are spaced evenly. A mirrored tree draws as"},{"type":"text","text":" "},{"type":"text","text":"the reflection of the drawing, and isomorphic subtrees are drawn identically up to"},{"type":"text","text":" "},{"type":"text","text":"translation. Separations and centring give multiples of a power of ½, which are exact in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":". The even spacing divides a shift by the number of gaps, so values such as ±5\/6"},{"type":"text","text":" "},{"type":"text","text":"occur and are rounded, and a mirrored tree’s drawing then matches the reflection only to"},{"type":"text","text":" "},{"type":"text","text":"rounding."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software","type":"text"},{"text":" ","type":"text"},{"text":"Engineering SE-7(2), 1981.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and"},{"type":"text","text":" "},{"type":"text","text":"Experience 20(7), 1990."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,"},{"type":"text","text":" "},{"type":"text","text":"Graph Drawing (GD 2002), LNCS 2528, 2002."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"O(n) time and memory, with no recursion."}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"variants":[{"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"abstract":[],"url":"\/documentation\/graphdrawing","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","role":"collection","title":"GraphDrawing","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","title":"reingoldTilfordLayout()","abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"type":"topic","kind":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}]}},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","url":"\/documentation\/graphdrawing\/trees\/rootedtree","title":"RootedTree","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}]},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"url":"\/documentation\/graphdrawing\/drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"title":"Drawing","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees":{"abstract":[],"type":"topic","url":"\/documentation\/graphdrawing\/trees","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","role":"collection","title":"Trees","kind":"symbol"}}}