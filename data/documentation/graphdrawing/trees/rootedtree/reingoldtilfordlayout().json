{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"sections":[],"abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order, vertices at one depth at least 1 apart along each subtree’s"},{"type":"text","text":" "},{"type":"text","text":"contour, and every parent centred over its first and last child. Where two subtrees are"},{"type":"text","text":" "},{"type":"text","text":"pushed apart, the smaller subtrees between them are spaced evenly. A mirrored tree draws as"},{"type":"text","text":" "},{"type":"text","text":"the reflection of the drawing, and isomorphic subtrees are drawn identically up to"},{"type":"text","text":" "},{"type":"text","text":"translation. Separations and centring give multiples of a power of ½, which are exact in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":". The even spacing divides a shift by the number of gaps, so values such as ±5\/6"},{"type":"text","text":" "},{"type":"text","text":"occur and are rounded, and a mirrored tree’s drawing then matches the reflection only to"},{"type":"text","text":" "},{"type":"text","text":"rounding."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software"},{"type":"text","text":" "},{"type":"text","text":"Engineering SE-7(2), 1981."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and","type":"text"},{"text":" ","type":"text"},{"text":"Experience 20(7), 1990.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,","type":"text"},{"text":" ","type":"text"},{"text":"Graph Drawing (GD 2002), LNCS 2528, 2002.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"O(n) time and memory, with no recursion.","type":"text"}]}],"kind":"content"}],"metadata":{"title":"reingoldTilfordLayout()","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"extendedModule":"Trees","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"role":"symbol","externalID":"s:5Tr