{"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"kind":"symbol","abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"variants":[{"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"roleHeading":"Instance Method","modules":[{"name":"GraphDrawing","relatedModules":["Trees"]}],"role":"symbol","extendedModule":"Trees","symbolKind":"method","externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"title":"reingoldTilfordLayout()","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L38","fileName":"ReingoldTilfordLayout.swift"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order, vertices at one depth at least 1 apart along each subtree’s"},{"type":"text","text":" "},{"type":"text","text":"contour, and every parent centred over its first and last child. Where two subtrees are"},{"type":"text","text":" "},{"type":"text","text":"pushed apart, the smaller subtrees between them are spaced evenly. A mirrored tree draws as"},{"type":"text","text":" "},{"type":"text","text":"the reflection of the drawing, and isomorphic subtrees are drawn identically up to"},{"type":"text","text":" "},{"type":"text","text":"translation. Separations and centring give multiples of a power of ½, which are exact in"},{"type":"text","text":" "},{"type":"codeVoice","code":"Double"},{"type":"text","text":". The even spacing divides a shift by the number of gaps, so values such as ±5\/6"},{"type":"text","text":" "},{"type":"text","text":"occur and are rounded, and a mirrored tree’s drawing then matches the reflection only to"},{"type":"text","text":" "},{"type":"text","text":"rounding."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software","type":"text"},{"text":" ","type":"text"},{"text":"Engineering SE-7(2), 1981.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and","type":"text"},{"text":" ","type":"text"},{"text":"Experience 20(7), 1990.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,"},{"type":"text","text":" "},{"type":"text","text":"Graph Drawing (GD 2002), LNCS 2528, 2002."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"O(n) time and memory, with no recursion."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","interfaceLanguage":"swift"},"references":{"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","url":"\/documentation\/graphdrawing\/drawing","type":"topic","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"title":"Drawing","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:5Trees10RootedTreeV","kind":"identifier","text":"RootedTree"}],"title":"RootedTree","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree","role":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"type":"t