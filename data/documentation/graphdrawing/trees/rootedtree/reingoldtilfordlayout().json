phDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","title":"reingoldTilfordLayout()","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","kind":"symbol","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"url":"\/documentation\/graphdrawing\/drawing","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"title":"Drawing","kind":"symbol","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing/Trees":{"abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/graphdrawing\/trees","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","title":"Trees","role":"collection"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"role":"symbol","title":"RootedTree","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","url":"\/documentation\/graphdrawing\/trees\/rootedtree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","preciseIdentifier":"s:5Trees10RootedTreeV","kind":"identifier"}],"abstract":[]}}}