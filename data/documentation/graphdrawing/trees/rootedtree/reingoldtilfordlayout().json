{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"roleHeading":"Instance Method","modules":[{"relatedModules":["Trees"],"name":"GraphDrawing"}],"symbolKind":"method","remoteSource":{"fileName":"ReingoldTilfordLayout.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L37"},"externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF","extendedModule":"Trees","title":"reingoldTilfordLayout()","role":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}},"abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order, vertices at one depth at least 1 apart along each subtree’s","type":"text"},{"text":" ","type":"text"},{"text":"contour, and every parent centred over its first and last child. Where two subtrees had to","type":"text"},{"text":" ","type":"text"},{"text":"be pushed apart, the smaller subtrees between them are spaced evenly (Walker’s","type":"text"},{"text":" ","type":"text"},{"text":"improvement), so a mirrored tree draws as the reflection of the drawing and isomorphic","type":"text"},{"text":" ","type":"text"},{"text":"subtrees are drawn identically up to translation. Coordinates are ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" arithmetic:","type":"text"},{"text":" ","type":"text"},{"text":"separations and centring alone give multiples of a power of ½, which are exact, but the even","type":"text"},{"text":" ","type":"text"},{"text":"spacing divides a shift by the number of gaps it is spread over, so values such as ±5\/6","type":"text"},{"text":" ","type":"text"},{"text":"occur and are rounded (and a mirrored tree’s drawing then matches the reflection only to","type":"text"},{"text":" ","type":"text"},{"text":"rounding).","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software"},{"type":"text","text":" "},{"type":"text","text":"Engineering SE-7(2), 1981."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and"},{"type":"text","text":" "},{"type":"text","text":"Experience 20(7), 1990."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,","type":"text"},{"text":" ","type":"text"},{"text":"Graph Drawing (GD 2002), LNCS 2528, 2002.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n) time and memory, with no recursion."}]}]}],"variants":[{"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"url":"\/documentation\/graphdrawing\/trees\/rootedtree","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree"}],"kind":"symbol","title":"RootedTree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","role":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing":{"url":"\/documentation\/graphdrawing","type":"topic","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","abstract":[],"kind":"symbol","title":"GraphDrawing"},"doc://GraphDrawing/documentation/GraphDrawing/Trees":{"kind":"symbol","abstract":[],"role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","type":"topic","url":"\/documentation\/graphdrawing\/trees","title":"Trees"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"role":"symbol","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","url":"\/documentation\/graphdrawing\/drawing","title":"Drawing","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","kind":"symbol","type":"topic","title":"reingoldTilfordLayout()","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"role":"symbol","conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}}}}