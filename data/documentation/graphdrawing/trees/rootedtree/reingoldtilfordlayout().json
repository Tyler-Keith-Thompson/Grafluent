{"abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"variants":[{"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order, vertices at one depth at least 1 apart along each subtree’s"},{"type":"text","text":" "},{"type":"text","text":"contour, and every parent centred over its first and last child. Where two subtrees had to"},{"type":"text","text":" "},{"type":"text","text":"be pushed apart, the smaller subtrees between them are spaced evenly (Walker’s"},{"type":"text","text":" "},{"type":"text","text":"improvement), so a mirrored tree draws as the reflection of the drawing and isomorphic"},{"type":"text","text":" "},{"type":"text","text":"subtrees are drawn identically up to translation. Coordinates are "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" arithmetic:"},{"type":"text","text":" "},{"type":"text","text":"separations and centring alone give multiples of a power of ½, which are exact, but the even"},{"type":"text","text":" "},{"type":"text","text":"spacing divides a shift by the number of gaps it is spread over, so values such as ±5\/6"},{"type":"text","text":" "},{"type":"text","text":"occur and are rounded (and a mirrored tree’s drawing then matches the reflection only to"},{"type":"text","text":" "},{"type":"text","text":"rounding)."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software"},{"type":"text","text":" "},{"type":"text","text":"Engineering SE-7(2), 1981."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and"},{"type":"text","text":" "},{"type":"text","text":"Experience 20(7), 1990."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,"},{"type":"text","text":" "},{"type":"text","text":"Graph Drawing (GD 2002), LNCS 2528, 2002."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"O(n) time and memory, with no recursion.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L37","fileName":"ReingoldTilfordLayout.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"reingoldTilfordLayout()","symbolKind":"method","extendedModule":"Trees","roleHeading":"Instance Method","externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF","modules":[{"name":"GraphDrawing","relatedModules":["Trees"]}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"role":"symbol"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"kind":"symbol","abstract":[],"title":"GraphDrawing","url":"\/documentation\/graphdrawing","type":"topic","role":"collection","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"title":"Drawing","role":"symbol","type":"topic","url":"\/documentation\/graphdrawing\/drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drawing"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees":{"abstract":[],"title":"Trees","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","type":"topic","url":"\/documentation\