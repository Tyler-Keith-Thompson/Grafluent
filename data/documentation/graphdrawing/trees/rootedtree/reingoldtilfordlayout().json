guages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" order, vertices at one depth at least 1 apart along each subtree’s","type":"text"},{"text":" ","type":"text"},{"text":"contour, and every parent centred over its first and last child. Where two subtrees are","type":"text"},{"text":" ","type":"text"},{"text":"pushed apart, the smaller subtrees between them are spaced evenly. A mirrored tree draws as","type":"text"},{"text":" ","type":"text"},{"text":"the reflection of the drawing, and isomorphic subtrees are drawn identically up to","type":"text"},{"text":" ","type":"text"},{"text":"translation. Separations and centring give multiples of a power of ½, which are exact in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":". The even spacing divides a shift by the number of gaps, so values such as ±5\/6","type":"text"},{"text":" ","type":"text"},{"text":"occur and are rounded, and a mirrored tree’s drawing then matches the reflection only to","type":"text"},{"text":" ","type":"text"},{"text":"rounding.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software","type":"text"},{"text":" ","type":"text"},{"text":"Engineering SE-7(2), 1981.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and","type":"text"},{"text":" ","type":"text"},{"text":"Experience 20(7), 1990.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,"},{"type":"text","text":" "},{"type":"text","text":"Graph Drawing (GD 2002), LNCS 2528, 2002."}]}]}]},{"inlineContent":[{"type":"text","text":"O(n) time and memory, with no recursion."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/Trees":{"type":"topic","title":"Trees","url":"\/documentation\/graphdrawing\/trees","role":"collection","abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"type":"topic","title":"RootedTree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree","role":"symbol","abstract":[],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"title":"reingoldTilfordLayout()","type":"topic","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"tex