{"sections":[],"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order, vertices at one depth at least 1 apart along each subtree’s","type":"text"},{"text":" ","type":"text"},{"text":"contour, and every parent centred over its first and last child. Where two subtrees had to","type":"text"},{"text":" ","type":"text"},{"text":"be pushed apart, the smaller subtrees between them are spaced evenly (Walker’s","type":"text"},{"text":" ","type":"text"},{"text":"improvement), so a mirrored tree draws as the reflection of the drawing and isomorphic","type":"text"},{"text":" ","type":"text"},{"text":"subtrees are drawn identically up to translation. Coordinates are ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" arithmetic:","type":"text"},{"text":" ","type":"text"},{"text":"separations and centring alone give multiples of a power of ½, which are exact, but the even","type":"text"},{"text":" ","type":"text"},{"text":"spacing divides a shift by the number of gaps it is spread over, so values such as ±5\/6","type":"text"},{"text":" ","type":"text"},{"text":"occur and are rounded (and a mirrored tree’s drawing then matches the reflection only to","type":"text"},{"text":" ","type":"text"},{"text":"rounding).","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software","type":"text"},{"text":" ","type":"text"},{"text":"Engineering SE-7(2), 1981.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and"},{"type":"text","text":" "},{"type":"text","text":"Experience 20(7), 1990."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,","type":"text"},{"text":" ","type":"text"},{"text":"Graph Drawing (GD 2002), LNCS 2528, 2002.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"O(n) time and memory, with no recursion.","type":"text"}]}],"kind":"content"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L37","fileName":"ReingoldTilfordLayout.swift"},"externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF","title":"reingoldTilfordLayout()","modules":[{"relatedModules":["Trees"],"name":"GraphDrawing"}],"extendedModule":"Trees","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"roleHeading":"Instance Method","symbolKind":"method","conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}},"abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"references":{"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","kind":"symbol","abstract":[],"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","preciseIdentifier":"s:5Trees10RootedTreeV","kind":"identifier"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree","title":"RootedTree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"title":"Drawing","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"role":"symbol","url":"\/documentation\/graphdrawing\/drawing","abstract":[{"text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this","type":"text"},{"text":" ","type":"text"},{"text":"module returns, and what a caller passes as a starting drawing.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","kind":"symbol","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","title":"reingoldTilfordLayout()"},"doc://GraphDrawing/documentation/GraphDrawing":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","type":"topic","role":"collection","title":"GraphDrawing","abstract":[],"url":"\/documentation\/graphdrawing","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees":{"title":"Trees","role":"collection","url":"\/documentation\/graphdrawing\/trees","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees"}}}