{"hierarchy":{"paths":[["doc:\/\/GraphDrawing\/documentation\/GraphDrawing","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree"]]},"kind":"symbol","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"metadata":{"role":"symbol","extendedModule":"Trees","modules":[{"name":"GraphDrawing","relatedModules":["Trees"]}],"title":"reingoldTilfordLayout()","symbolKind":"method","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/GraphDrawing\/ReingoldTilfordLayout.swift#L36","fileName":"ReingoldTilfordLayout.swift"},"externalID":"s:5Trees10RootedTreeV12GraphDrawingE21reingoldTilfordLayoutAD0E0VyxGyF","roleHeading":"Instance Method"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The root is at (0, 0) and a vertex at depth d has y = d. Children are placed left to right","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order, vertices at one depth at least 1 apart along each subtree’s","type":"text"},{"text":" ","type":"text"},{"text":"contour, and every parent centred over its first and last child. Where two subtrees are","type":"text"},{"text":" ","type":"text"},{"text":"pushed apart, the smaller subtrees between them are spaced evenly. A mirrored tree draws as","type":"text"},{"text":" ","type":"text"},{"text":"the reflection of the drawing, and isomorphic subtrees are drawn identically up to","type":"text"},{"text":" ","type":"text"},{"text":"translation. Separations and centring give multiples of a power of ½, which are exact in","type":"text"},{"text":" ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":". The even spacing divides a shift by the number of gaps, so values such as ±5\/6","type":"text"},{"text":" ","type":"text"},{"text":"occur and are rounded, and a mirrored tree’s drawing then matches the reflection only to","type":"text"},{"text":" ","type":"text"},{"text":"rounding.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reingold and Tilford, “Tidier drawings of trees”, IEEE Transactions on Software"},{"type":"text","text":" "},{"type":"text","text":"Engineering SE-7(2), 1981."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Walker, “A node-positioning algorithm for general trees”, Software: Practice and"},{"type":"text","text":" "},{"type":"text","text":"Experience 20(7), 1990."}]}]},{"content":[{"inlineContent":[{"text":"Buchheim, Jünger and Leipert, “Improving Walker’s algorithm to run in linear time”,","type":"text"},{"text":" ","type":"text"},{"text":"Graph Drawing (GD 2002), LNCS 2528, 2002.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"O(n) time and memory, with no recursion.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","interfaceLanguage":"swift"},"references":{"doc://GraphDrawing/documentation/GraphDrawing":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","title":"GraphDrawing","type":"topic","url":"\/documentation\/graphdrawing","role":"collection","abstract":[],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"kind":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree"}],"type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","role":"symbol","abstract":[]},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"title":"Drawing","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drawing"}],"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"kind":"symbol","url":"\/documentation\/graphdrawing\/drawing","navigatorTitle":[{"kind":"identifier","text":"Drawing"}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees":{"title":"Trees","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees","type":"topic","url":"\/documentation\/graphdrawing\/trees","role":"collection","abstract":[],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","type":"topic","abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","title":"reingoldTilfordLayout()"}}}