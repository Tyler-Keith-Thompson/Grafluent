":"symbol","title":"Trees"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree":{"abstract":[],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree","kind":"identifier"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree","title":"RootedTree","type":"topic"},"doc://GraphDrawing/documentation/GraphDrawing":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing","url":"\/documentation\/graphdrawing","title":"GraphDrawing","type":"topic","abstract":[],"role":"collection","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Drawing":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drawing","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphdrawing\/drawing","navigatorTitle":[{"text":"Drawing","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Drawing","abstract":[{"type":"text","text":"A position in the plane for each vertex, in a fixed vertex order: what every layout in this"},{"type":"text","text":" "},{"type":"text","text":"module returns, and what a caller passes as a starting drawing."}],"type":"topic","title":"Drawing"}}}