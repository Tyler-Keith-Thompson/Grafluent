raph: from a maximum matching (Hopcroft–Karp on"},{"type":"text","text":" "},{"type":"text","text":"the sides), Z is the set of vertices reached from the free left vertices by alternating"},{"type":"text","text":" "},{"type":"text","text":"paths, an edge not in the matching from left to right, then the matched edge back; the cover"},{"type":"text","text":" "},{"text":"is (left ∖ Z) ∪ (right ∩ Z), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. It is the one minimum cover with the most","type":"text"},{"text":" ","type":"text"},{"text":"left vertices, so it does not depend on the matching. O(m √n).","type":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover(weight:)":{"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumVertexCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","title":"approximateMinimumVertexCover(weight:)","abstract":[{"text":"A vertex cover of at most twice the least weight (Bar-Yehuda and Even’s local ratio): each","type":"text"},{"text":" ","type":"text"},{"text":"edge in position or