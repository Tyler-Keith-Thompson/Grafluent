xt","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop covers its vertex). n − ν edges (Gallai)."},{"type":"text","text":" "},{"type":"text","text":"O(n · m · log n)."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]?","kind":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()","title":"minimumEdgeCover()","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-7iycq":{"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-7iycq","abstract":[{"text":"A dominating set of at most H(Δ + 1) times the least weight, ratios computed as weight \/ k","type":"text"},{"text":" ","type":"text"},{"text":"in floating point.","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-7iycq","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"kind":"symbol","role":"symbol","type":"topic","title":"approximateMinimumDominatingSet(weight:)"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","title":"Graph","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover()":{"title":"minimumVertexCover()","abstract":[{"type":"text","text":"A minimum vertex cover (exact): "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" minus "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":", in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (τ = n − α, Gallai). Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once. The cost is "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"’s: O(m √n) on bipartite components."},{"type":"text","text":" "},{"type":"text","text":"Deterministic, but which minimum cover it is depends on the search; for one fixed by a rule,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumVertexCover()"},{"type":"text","text":"."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCo