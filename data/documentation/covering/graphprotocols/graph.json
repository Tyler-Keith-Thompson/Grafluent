ring\/GraphProtocols\/Graph\/independenceNumber()","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"independenceNumber","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/independencenumber()"},"doc://Covering/documentation/Covering/GraphProtocols":{"role":"collection","url":"\/documentation\/covering\/graphprotocols","type":"topic","title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet()":{"type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()","kind":"symbol","title":"approximateMinimumDominatingSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","role":"symbol"},"doc://Covering/documentation/Covering":{"title":"Covering","url":"\/documentation\/covering","role":"collection","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"title":"minimumVertexCover(bipartition:)","abstract":[{"text":"König’s m