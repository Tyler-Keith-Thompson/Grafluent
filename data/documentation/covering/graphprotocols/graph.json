xt":" is maximum; from any other matching it is"},{"type":"text","text":" "},{"type":"text","text":"still an edge cover (a vertex covered by an edge added earlier in the pass is skipped). nil"},{"type":"text","text":" "},{"type":"text","text":"when some vertex has no edge. O(n + m)."}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet()":{"url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset()","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"abstract":[{"text":"A maximal independent set (NetworkX ","type":"text"},{"code":"maximal_independent_set","type":"codeVoice"},{"text":", without the randomness): each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order joins when it has no self-loop and no neighbour in the set yet.","type":"text"},{"text":" ","type":"text"},{"text":"On a graph without self-loops it is also a minimal dominating set. O(n + m).","type":"text"}],"type":"topic","title":"maximalIndependentSet()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumEdgeCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kin