 in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. It is the one minimum cover with the most","type":"text"},{"text":" ","type":"text"},{"text":"left vertices, so it does not depend on the matching. O(m √n).","type":"text"}],"kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet(containing:)":{"abstract":[{"type":"text","text":"A maximal independent set containing "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":", which go in first, then each vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order as "},{"type":"codeVoice","code":"maximalIndependentSet()"},{"type":"text","text":"; nil when "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":" is not an independent set"},{"type":"text","text":" "},{"type":"text","text":"(two are adjacent, or one has a self-loop). Repeats are one seed. O(n + m)."}],"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet(containing:)","role":"symbol","kind":"symbol","title":"maximalIndependentSet(containing:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalIndependentSet"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]?"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/maximalinde