 + m)."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover(matching:)","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover(matching:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"title":"maximumIndependentSet()","role":"symbol","abstract":[{"type":"text","text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference ("},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"’s rule, so"},{"type":"text","text":" "},{"type":"text","text":"on a loop-free graph this is "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"naviga