","text":"A minimum vertex cover (exact): "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" minus "},{"code":"maximumIndependentSet()","type":"codeVoice"},{"type":"text","text":", in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (τ = n − α, Gallai). Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once. The cost is "},{"code":"maximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"’s: O(m √n) on bipartite components."},{"type":"text","text":" "},{"type":"text","text":"Deterministic, but which minimum cover it is depends on the search; for one fixed by a rule,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"code":"lexicographicallyFirstMinimumVertexCover()","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover()","title":"minimumVertexCover()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","abstract":[],"role":"symbol","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"Graph"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover(weight:)":{"abstract":[{"text":"A vertex cover of at most twice the least weight (Bar-Yehuda and Even’s local ratio): each","type":"text"},{"text":" ","type":"text"},{"text":"edge in position order with neither end in the cover puts in the end with the lesser","type":"text"},{"text":" ","type":"text"},{"text":"remaining weight (the end with the lesser vertex index on ties) and subtracts that weight","type":"text"},{"text":" ","type":"text"},{"text":"from the other end’s. A self-loop puts its vertex in. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per vertex, in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","type":"topic","title":"approximateMinimumVertexCover(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"approximateMinimumVertexCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isIndependentSet(_:)":{"abstract":[{"text":"Whether no edge, and no self-loop, has both ends in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":". Repeats are ignored.","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isIndependentSet(_:)","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/isindependentset(_:)","title":"isIndependentSet(_:)","fragments":[{"text"