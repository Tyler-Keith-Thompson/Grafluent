et","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight, ratios computed as weight \/ k"},{"type":"text","text":" "},{"type":"text","text":"in floating point."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-7iycq","title":"approximateMinimumDominatingSet(weight:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet()":{"abstract":[{"text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","title":"approximateMinimumDominatingSet()","role":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","