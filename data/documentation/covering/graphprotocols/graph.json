":"approximateMinimumVertexCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"A vertex cover of at most twice the least weight (Bar-Yehuda and Even’s local ratio): each"},{"type":"text","text":" "},{"type":"text","text":"edge in position order with neither end in the cover puts in the end with the lesser"},{"type":"text","text":" "},{"type":"text","text":"remaining weight (the end with the lesser vertex index on ties) and subtracts that weight"},{"type":"text","text":" "},{"type":"text","text":"from the other end’s. A self-loop puts its vertex in. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per vertex, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. O(n + m)."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","title":"approximateMinimumVertexCover(weight:)","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isDominatingSet(_:)":{"type":"topic","abstract":[{"type":"text","text":"Whether every vertex is in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" or adjacent to one in it. Repeats are ignored."},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"kind":"symbol","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/isdominatingset(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isDominatingSet"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isDominatingSet(_:)","title":"isDominatingSet(_:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"type":"topic","abstract":[{"type":"text","text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumMatching()"},{"type":"text","text":", then for each vertex still uncovered, in vertex order, its first edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop covers its vertex). n − ν edges (Gallai)."},{"type":"text","text":" "},{"type":"text","text":"O(n · m · log n)."}],"kind":"symbol","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]?","kind":"