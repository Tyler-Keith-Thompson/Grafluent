ht","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-6gboe","kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-6gboe","title":"approximateMinimumDominatingSet(weight:)","abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover;"},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"code":"min_weighted_dominating_set","type":"codeVoice"},{"type":"text","text":", the same set): repeatedly the vertex with the least"},{"type":"text","text":" "},{"type":"text","text":"weight per newly dominated vertex of its closed neighbourhood, the least vertex index on ties."},{"type":"text","text":" "},{"type":"text","text":"Ratios are compared exactly, by cross-multiplication. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per vertex."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) log n)."}],"role":"symbol"},"doc://Covering/documentation/Covering":{"type":"topic","url":"\/documentation\/covering","title":"Covering","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","title":"minimumDominatingSet()","role":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","kind":"symbol","abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of"},{"type":"text","text":" "},{"type":"text","text":"the smallest such sets it is the lexicographically least by vertex index (the rule of"},{"type":"text","text":" "},{"code":"maximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isDominatingSet(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDominatingSet"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isDominatingSet(_:)","title":"isDominatingSet(_:)","url":"\/documentation\/covering\/graphprotocols\/graph\/isdominatingset(_:)","abstract"