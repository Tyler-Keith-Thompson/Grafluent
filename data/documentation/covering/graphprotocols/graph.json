alled once per vertex, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. O(n + m)."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumVertexCover"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"kind":"symbol","title":"approximateMinimumVertexCover(weight:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"König’s minimum vertex cover of a bipartite graph: from a maximum matching (Hopcroft–Karp on"},{"type":"text","text":" "},{"type":"text","text":"the sides), Z is the set of vertices reached from the free left vertices by alternating"},{"type":"text","text":" "},{"type":"text","text":"paths, an edge not in the matching from left to right, then the matched edge back; the cover"},{"type":"text","text":" "},{"type":"text","text":"is (left ∖ Z) ∪ (right ∩ Z), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. It is the one minimum cover with the most"},{"type":"text","text":" "},{"type":"text","text":"left vertices, so it does not depend on the matching. O(m √n)."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","title":"minimumVertexCover(bipartition:)","type":"topic","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMaximumIndependentSet()":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","role":"symbol","abstract":[{"type":"text","text":"The lexicographically first maximum independent set: of all the largest ones, the least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"type":"text","text":", so on a loop-free graph this is that clique of the"},{"type":"text","text":" "},{"type":"text","text":"complement). A vertex with a self-loop is never in it; parallel edges count once."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","title":"lexicographicallyFirstMaximumIndependentSet()"}}}