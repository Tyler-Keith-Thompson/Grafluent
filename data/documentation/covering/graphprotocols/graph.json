xt"},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","abstract":[{"text":"The lexicographically first maximum independent set: of all the largest ones, the least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"lesser holds the least vertex of their symmetric difference (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"type":"text","text":", so on a loop-free graph this is that clique of the"},{"type":"text","text":" "},{"type":"text","text":"complement). A vertex with a self-loop is never in it; parallel edges count once."}],"type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumDominatingSet()":{"url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"kind":"symbol","abstract":[{"text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the","type":"text"},{"text":" ","type":"text"},{"text":"least by vertex index (the rule of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":"), in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;"},{"type":"text","text":" "},{"type":"text","text":"isolated vertices are in it."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumDominatingSet()","title":"lexicographicallyFirstMinimumDominatingSet()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet()":{"title":"maximalIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet()","abstract":[{"type":"text","text":"A maximal independent set, built deterministically: each vertex in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order joins"},{"type":"text","text":" "},{"type":"text","text":"when it has no self-loop and no neighbour in the set yet. On a graph without self-loops it"},{"type":"text","text":" "},{"text":"is also a minimal dominating set. O(n + m).","type":"text"}],"type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"title":"minimumVertexCover(bipartition:)","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","kind":"symbol","role":"symbol","fragments":[{"text":"func",