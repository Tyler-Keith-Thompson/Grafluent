e":"codeVoice","code":"maximalMatching()"},{"type":"text","text":"."}],"title":"approximateMinimumVertexCover()","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties."}],"type":"topic","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()","title":"approximateMinimumDominatingSet()","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isVertexCover(_:)":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVertexCover"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isVertexCover(_:)","abstract":[{"text":"Whether every edge, and every self-loop, has an end in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":". Repeats are ignored.","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}],"title":"isVertexCover(_:)","url":"\/documentation\/covering\/graphprotocols\/graph\/isvertexcover(_:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isIndependentSet(_:)":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isIndependentSet(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isIndependentSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether no edge, and no self-loop, has both ends in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":". Repeats are ignored."},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"type":"topic","role":"symbol","title":"isIndependentSet(_:)","url":"\/documentation\/covering\/graphprotocols\/graph\/isindependentset(_:)","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet()":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet()","abstract":[{"text":"A maximal independent set, built deterministically: each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order joins","type":"text"},{"text":" ","type":"text"},{"text":"when it has no self-loop and no neighbour in the set yet. On a graph without self-loops it","type":"text"},{"text":" ","type":"text"},{"text":"is also a minimal dominating set. O(n + m).","type":"text"}],"title":"maximalIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumDominatingSet()":{"title":"lexicographicallyFirstMinimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()","abstract":[{"text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the","type":"text"},{"text":" ","type":"text"},{"text":"least by vertex index (the rule of ","type":"text"},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"text":"), in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertices are in it.","type":"text"}],"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumDominatingSet()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"kind":"symbol"},"doc://Covering/documentation/Covering":{"type":"to