entSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"A maximal independent set, built deterministically: each vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order joins","type":"text"},{"text":" ","type":"text"},{"text":"when it has no self-loop and no neighbour in the set yet. On a graph without self-loops it","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is also a minimal dominating set. O(n + m)."}],"type":"topic"},"doc://Covering/documentation/Covering":{"type":"topic","kind":"symbol","abstract":[],"title":"Covering","url":"\/documentation\/covering","role":"collection","identifier":"doc:\/\/Covering\/documentation\/Covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet(containing:)":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalIndependentSet"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]?"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset(containing:)","type":"topic","abstract":[{"type":"text","text":"A maximal independent set containing "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":", which go in first, then each vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order as "},{"type":"codeVoice","code":"maximalIndependentSet()"},{"type":"text","text":"; nil when "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":" is not an independent set"},{"type":"text","text":" "},{"type":"text","text":"(two are adjacent, or one has a self-loop). Repeats are one seed. O(n + m)."}],"title":"maximalIndependentSet(containing:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet(containing:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumEdgeCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier","text":"Edges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":"]?"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()","type":"topic","abstract":[{"type":"text","text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumMatching()"},{"type":"text","text":", then for each vertex still uncovered, in vertex order, its first edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"text":" order (a self-loop covers its vertex). n − ν edges (Gallai).","type":"text"},{"text":" ","type":"text"},{"text":"O(n · m · log n).","type":"text"}],"title":"minimumEdgeCover()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"type":"topic","role":"symbol","abstract":[{"text":"König’s minimum vertex cover of a bipartite graph: from a maximum matching (Hopcroft–Karp on","type":"text"},{"text":" ","type":"text"},{"text":"the sides), Z is the set of vertices reached from the free left vertices by alternating","type":"text"},{"text":" ","type":"text"},{"text":"paths, an edge not in the matching from left to right, then the matched edge back; the cover","type":"text"},{"text":" ","type":"text"},{"text":"is (left ∖ Z) ∪ (right ∩ Z), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. It is the one minimum cover with the most","type":"text"},{"text":" ","type":"text"},{"text":"left vertices, so it does not depend on the matching. O(m √n).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","text":"Bipartition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","title":"minimumVertexCover(bipartition:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isDominatingSet(_:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isDominatingSet"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"k