text":", which go in first, then each vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order as "},{"type":"codeVoice","code":"maximalIndependentSet()"},{"type":"text","text":"; nil when "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":" is not an independent set"},{"type":"text","text":" "},{"type":"text","text":"(two are adjacent, or one has a self-loop). Repeats are one seed. O(n + m)."}],"role":"symbol","type":"topic","kind":"symbol","title":"maximalIndependentSet(containing:)","url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset(containing:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet(containing:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumEdgeCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]?"}],"abstract":[{"type":"text","text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumMatching()"},{"type":"text","text":", then for each vertex still uncovered, in vertex order, its first edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop covers its vertex). n − ν edges (Gallai)."},{"type":"text","text":" "},{"type":"text","text":"O(n · m · log n)."}],"role":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()","title":"minimumEdgeCover()","kind":"symbol","identifier":"doc:\/\