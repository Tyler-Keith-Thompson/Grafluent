/minimumEdgeCover()":{"abstract":[{"type":"text","text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumMatching()"},{"type":"text","text":", then for each vertex still uncovered, in vertex order, its first edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop covers its vertex). n − ν edges (Gallai)."},{"type":"text","text":" "},{"type":"text","text":"O(n · m · log n)."}],"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover()","kind":"symbol","title":"minimumEdgeCover()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumVertexCover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"bipartition","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","text":"Bipartition","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"minimumVertexCover(bipartition:)","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","abstract":[{"type":"text","text":"König’s minimum vertex cover of a bipartite graph (NetworkX "},{"type":"codeVoice","code":"to_vertex_cover"},{"type":"text","text":", the same"},{"type":"text","text":" "},{"type":"text","text":"cover): from a maximum matching (Hopcroft–Karp on the sides), Z is the set of vertices"},{"type":"text","text":" "},{"type":"text","text":"reached from the free left vertices by alternating paths, an edge not in the matching from"},{"type":"text","text":" "},{"type":"text","text":"left to right, then the matched edge back; the cover is (left ∖ Z) ∪ (right ∩ Z), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. It is the one minimum cover with the most left vertices, so it does not"},{"type":"text","text":" "},{"type":"text","text":"depend on the matching. O(m √n)."}],"kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover()":{"abstract":[{"type":"text","text":"A minimum vertex cover (exact): "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" minus "},{"code":"maximumIndependentSet()","type":"codeVoice"},{"type":"text","text":", in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (τ = n − α, Gallai), so the minimum cover avoiding the least vertex of a symmetric"},{"type":"text","text":" "},{"type":"text","text":"difference. Every vertex with a self-loop is in it; parallel edges count once. The cost is"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"’s: O(m √n) on bipartite components."}],"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover()","kind":"symbol","title":"minimumVertexCover()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isIndependentSet(_:)":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isIndependentSet(_:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"isIndependentSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"isIndependentSet(_:)","url":"\/documentation\/covering\/graphprotocols\/graph\/isindependentset(_:)","kind":"symbol","abstract":[{"type":"text","text":"Whether no edge, and no self-loop, has both ends in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":". Repeats are ignored."},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet(containing:)":{"abstract":[{"type":"text","text":"A maximal independent set containing "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":", which go in first, then each vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order as "},{"type":"codeVoice","code":"maximalIndependentSet()"},{"type":"text","text":"; nil when "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":" is not an independent set"},{"type":"text","text":" "},{"type":"text","text":"(two are adjacent, or one has a self-loop). Repeats are one seed. O(n + m)."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalIndependentSet"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]?"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet(containing:)","kind":"symbol","title":"maximalIndependentSet(containing:)","url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset(containing:)"},"doc://Covering/documentation/Covering":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","title":"Covering","url":"\/documentation\/covering","abstract":[],"kind":"symbol","role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet()":{"abstract":[{"type":"text","text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties."}],"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","kind":"symbol","title":"approximateMinimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()"}}}