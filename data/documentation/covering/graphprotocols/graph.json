cols/Graph/lexicographicallyFirstMaximumIndependentSet()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"title":"lexicographicallyFirstMaximumIndependentSet()","abstract":[{"type":"text","text":"The lexicographically first maximum independent set: of all the largest ones, the least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"text":"lesser holds the least vertex of their symmetric difference (the rule of","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":", so on a loop-free graph this is that clique of the","type":"text"},{"text":" ","type":"text"},{"text":"complement). A vertex with a self-loop is never in it; parallel edges count once.","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"type":"topic","kind":"symbol","title":"GraphProtocols","url":"\/documentation\/covering\/graphprotocols","role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover(matching:)":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover(matching:)","abstract