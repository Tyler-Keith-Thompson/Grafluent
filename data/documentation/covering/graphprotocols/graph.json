nating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover;","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX ","type":"text"},{"code":"min_weighted_dominating_set","type":"codeVoice"},{"text":", the same set): repeatedly the vertex with the least","type":"text"},{"text":" ","type":"text"},{"text":"weight per newly dominated vertex of its closed neighbourhood, the least vertex index on ties.","type":"text"},{"text":" ","type":"text"},{"text":"Ratios are compared exactly, by cross-multiplication. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per vertex.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) log n).","type":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-6gboe","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumDominatingSet"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"title":"approximateMinimumDominatingSet(weight:)","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-6gboe","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumV