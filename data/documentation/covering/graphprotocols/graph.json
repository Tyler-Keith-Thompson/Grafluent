ts of one size, the"},{"type":"text","text":" "},{"text":"lesser holds the least vertex of their symmetric difference (","type":"text"},{"type":"codeVoice","code":"maximumClique()"},{"text":"’s rule, so","type":"text"},{"text":" ","type":"text"},{"text":"on a loop-free graph this is ","type":"text"},{"type":"codeVoice","code":"maximumClique()"},{"text":" of the complement). A vertex with a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop is never in it; parallel edges count once.","type":"text"}],"type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","role":"symbol","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-6gboe":{"kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-6gboe","title":"approximateMinimumDominatingSet(weight:)","role":"symbol","abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover;"},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"type":"codeVoice","code":"min_weighted_dominating_set"},{"type":"text","text":", the same set): repeatedly the vertex with the least"},{"type":"text","text":" "},{"type":"text","text":"weight per newly dominated vertex of its closed neighbourhood, the least vertex index on ties."},{"type":"text","text":" "},{"type":"text","text":"Ratios are compared exactly, by cross-multiplication. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per vertex."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) log n)."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumDominatingSet"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"k