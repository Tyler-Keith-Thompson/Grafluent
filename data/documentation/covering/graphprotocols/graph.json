{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"type":"topic","abstract":[{"type":"text","text":"The lexicographically first maximum independent set: of all the largest ones, the least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"text":"lesser holds the least vertex of their symmetric difference (the rule of","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":", so on a loop-free graph this is that clique of the","type":"text"},{"text":" ","type":"text"},{"text":"complement). A vertex with a self-loop is never in it; parallel edges count once.","type":"text"}],"title":"lexicographicallyFirstMaximumIndependentSet()","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"A minimum vertex cover (exact): "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" minus "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":", in "},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order (τ = n − α, Gallai). Every vertex with a self-loop is in it; parallel edges count","type":"text"},{"text":" ","type":"text"},{"text":"once. The cost is ","type":"text"},{"code":"maximumIndependentSet()","type":"codeVoice"},{"text":"’s: O(m √n) on bipartite components.","type":"text"},{"text":" ","type":"text"},{"text":"Deterministic, but which minimum cover it is depends on the search; for one fixed by a rule,","type":"text"},{"text":" ","type":"text"},{"text":"see ","type":"text"},{"code":"lexicographicallyFirstMinimumVertexCover()","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover()","title":"minimumVertexCover()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover()"},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","abstract":[],"role":"collection","kind":"symbol","url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isEdgeCover(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeCover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","abstract":[{"type":"text","text":"Whether every vertex is an end of some edge in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" (positions). Repeats are ignored."},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"role":"symbol","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/isedgecover(_:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isEdgeCover(_:)","title":"isEdgeCover(_:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover(weight:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumVertexCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","type":"topic","role":"symbol","title":"approximateMinimumVertexCover(weight:)","abstract":[{"type":"text","text":"A vertex cover of at most twice the least weight (Bar-Yehuda and Even’s local ratio): each"},{"type":"text","text":" "},{"type":"text","text":"edge in position order with neither end in the cover puts in the end with the lesser"},{"type":"text","text":" "},{"type":"text","text":"remaining weight (the end with the lesser vertex index on ties) and subtracts that weight"},{"type":"text","text":" "},{"type":"text","text":"from the other end’s. A self-loop puts its vertex in. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per vertex, in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. O(n + m)."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","kind":"symbol"}}}