","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]?","kind":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover(matching:)","title":"minimumEdgeCover(matching:)","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","abstract":[{"text":"König’s minimum vertex cover of a bipartite graph: from a maximum matching (Hopcroft–Karp on","type":"text"},{"text":" ","type":"text"},{"text":"the sides), Z is the set of vertices reached from the free left vertices by alternating","type":"text"},{"text":" ","type":"text"},{"text":"paths, an edge not in the matching from left to right, then the matched edge back; the cover","type":"text"},{"text":" ","type":"text"},{"text":"is (left ∖ Z) ∪ (right ∩ Z), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. It is the one minimum cover with the most","type":"text"},{"text":" ","type":"text"},{"text":"left vertices, so it does not depend on the matching. O(m √n).","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","kind":"typeIdentifier","text":"Bipartition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","t