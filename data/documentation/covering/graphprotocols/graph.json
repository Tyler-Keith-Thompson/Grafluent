dentSet()"},{"type":"text","text":"’s: O(m √n) on bipartite components."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover()","kind":"symbol","role":"symbol","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet(containing:)":{"title":"maximalIndependentSet(containing:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximalIndependentSet"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containing"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]?"}],"abstract":[{"text":"A maximal independent set containing ","type":"text"},{"code":"seeds","type":"codeVoice"},{"text":", which go in first, then each vertex in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order as ","type":"text"},{"type":"codeVoice","code":"maximalIndependentSet()"},{"text":"; nil when ","type":"text"},{"type":"codeVoice","code":"seeds"},{"text":" is not an independent set","type":"text"},{"text":" ","type":"text"},{"text":"(two are adjacent, or one has a self-loop). Repeats are one seed. O(n + m).","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet(containing:)","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maxima