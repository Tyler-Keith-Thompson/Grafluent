ion\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","kind":"symbol","role":"symbol","title":"approximateMinimumVertexCover(weight:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties.","type":"text"}],"type":"topic","title":"approximateMinimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them."}],"type":"topic","title":"Graph","url":"\/documentation\/graphprotocols\/graph"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"minimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"abstract":[{"type":"text","text":"A maximum independent set (exact), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. A vertex"},{"type":"text","text":" "},{"type":"text","text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which"},{"type":"text","text":" "},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","title":"maximumIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","type":"topic","role":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()"}}}