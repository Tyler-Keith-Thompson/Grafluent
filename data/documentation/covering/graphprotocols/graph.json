 the free left vertices by alternating paths, an edge not in the matching from"},{"type":"text","text":" "},{"type":"text","text":"left to right, then the matched edge back; the cover is (left ∖ Z) ∪ (right ∩ Z), in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. It is the one minimum cover with the most left vertices, so it does not"},{"type":"text","text":" "},{"type":"text","text":"depend on the matching. O(m √n)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"title":"minimumVertexCover(bipartition:)","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover(matching:)":{"kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover(matching:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumEdgeCover"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14MatchingModule0A0V","kind":"typeIdentifier","text":"Matching"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">) -