"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight, ratios computed as weight \/ k in"},{"type":"text","text":" "},{"type":"text","text":"floating point, as NetworkX does, so the same values give the same set."}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","type":"topic","role":"symbol","title":"minimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of"},{"type":"text","text":" "},{"type":"text","text":"the smallest such sets it is the lexicographically least by vertex index (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover(matching:)":{"abstract":[{"type":"text","text":"The same construction from "},{"type":"codeVoice","code":"matching"},{"type":"text","text":