ype":"codeVoice"},{"type":"text","text":": pass "},{"code":"maximumBipartiteMatching()","type":"codeVoice"},{"type":"text","text":" on a bipartite"},{"type":"text","text":" "},{"type":"text","text":"graph for O(m √n). Minimum when "},{"code":"matching","type":"codeVoice"},{"type":"text","text":" is maximum; from any other matching it is still"},{"type":"text","text":" "},{"type":"text","text":"an edge cover (a vertex covered by an edge added earlier in the pass is skipped). nil when"},{"type":"text","text":" "},{"type":"text","text":"some vertex has no edge. O(n + m)."}],"type":"topic","title":"minimumEdgeCover(matching:)","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover(matching:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","kind":"symbol","role":"symbol","title":"Graph"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-6gboe":{"abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover):"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the vertex with the least weight per newly dominated vertex of its closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood, the least vertex index on ties. Ratios are compared exactly, by"},{"type":"text","text":" "},{"type":"text","text":"cross-multiplication. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per vertex. O((n + m) log n)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text"