},{"type":"text","text":" "},{"type":"text","text":"ties."}],"type":"topic","kind":"symbol","title":"approximateMinimumDominatingSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet(containing:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalIndependentSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"containing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"title":"maximalIndependentSet(containing:)","abstract":[{"type":"text","text":"A maximal independent set containing "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":", which go in first, then each vertex in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order as "},{"type":"codeVoice","code":"maximalIndependentSet()"},{"type":"text","text":"; nil when "},{"type":"codeVoice","code":"seeds"},{"type":"text","text":" is not an independent set"},{"type":"text","text":" "},{"type":"text","text":"(two are adjacent, or one has a self-loop). Repeats are one seed. O(n + m)."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet(containing:)","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset(containing:)","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/independenceNumber()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/independenceNumber()","abstract":[{"text":"The size of a maximum independent set, α: 0 for the empty graph. A bipartite component","type":"text"},{"text":" ","type":"text"},{"text":"contributes its vertex count minus a maximum matching (König), a complete one 1, any other","type":"text"},{"text":" ","type":"text"},{"text":"the reductions and kernel search of ","type":"text"},{"code":"maximumIndependentSet()","type":"codeVoice"},{"text":", without building the set:","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m) plus the search on what the reductions leave.","type":"text"}],"type":"topic","kind":"symbol","title":"independenceNumber()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"independenceNumber"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/independencenumber()","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"title":"minimumVertexCover(bipartition:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","abstract":[{"type":"text","text":"König’s minimum vertex cover of a bipartite graph: from a maximum matching (Hopcroft–Karp on"},{"type":"text","text":" "},{"type":"text","text":"the sides), Z is the set of vertices reached from the free left vertices by alternating"},{"type":"text","text":" "},{"type":"text","text":"paths, an edge not in the matching from left to right, then the matched edge back; the cover"},{"type":"text","text":" "},{"text":"is (left ∖ Z) ∪ (right ∩ Z), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. It is the one minimum cover with the most","type":"text"},{"text":" ","type":"text"},{"text":"left vertices, so it does not depend on the matching. O(m √n).","type":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumDominatingSet()":{"title":"lexicographicallyFirstMinimumDominatingSet()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumDominatingSet()","abstract":[{"text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the","type":"text"},{"text":" ","type":"text"},{"text":"least by vertex index (the rule of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":"), in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertices are in it.","type":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-6gboe":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumDominatingSet"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"title":"approximateMinimumDominatingSet(weight:)","abstract":[{"text":"A dominating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover):","type":"text"},{"text":" ","type":"text"},{"text":"repeatedly the vertex with the least weight per newly dominated vertex of its closed","type":"text"},{"text":" ","type":"text"},{"text":"neighbourhood, the least vertex index on ties. Ratios are compared exactly, by","type":"text"},{"text":" ","type":"text"},{"text":"cross-multiplication. ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is called once per vertex. O((n + m) log n).","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-6gboe","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-6gboe","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumVertexCover()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()","abstract":[{"type":"text","text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least"},{"type":"text","text":" "},{"type":"text","text":"by vertex index (the rule of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":": of two covers"},{"type":"text","text":" "},{"type":"text","text":"of one size, the lesser holds the least vertex of their symmetric difference), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once."}],"type":"topic","kind":"symbol","title":"lexicographicallyFirstMinimumVertexCover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet()":{"role":"symbol","