)","type":"codeVoice"},{"type":"text","text":"), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}],"title":"minimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","type":"topic","kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-7iycq":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","abstract":[{"text":"A dominating set of at most H(Δ + 1) times the least weight, ratios computed as weight \/ k","type":"text"},{"text":" ","type":"text"},{"text":"in floating point.","type":"text"}],"role":"symbol","title":"approximateMinimumDominatingSet(weight:)","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-7iycq","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-7iycq"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover()":{"fragments":[{"text":"func","kind":"keyword"},{