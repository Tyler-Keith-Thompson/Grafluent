":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"url":"\/documentation\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"type":"topic","abstract":[{"type":"text","text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumMatching()"},{"type":"text","text":", then for each vertex still uncovered, in vertex order, its first edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop covers its vertex). n − ν edges (Gallai)."},{"type":"text","text":" "},{"type":"text","text":"O(n · m · log n)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumEdgeCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]?"}],"kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover()","title":"minimumEdgeCover()","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isVertexCover(_:)":{"type":"topic","abstract":[{"type":"text","text":"Whether every edge, and every self-loop, has an end in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" (NetworkX"},{"type":"text","text":" "},{"code":"is_vertex_cover","type":"codeVoice"},{"type":"text","text":"). Repeats are ignored. O(n + m)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isVertexCover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"isVertexCover(_:)","url":"\/documentation\/covering\/graphprotocols\/graph\/isvertexcover(_:)","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isVertexCover(_:)","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"type":"topic","abstract":[{"type":"text","text":"König’s minimum vertex cover of a bipartite graph (NetworkX "},{"type":"codeVoice","code":"to_vertex_cover"},{"type":"text","text":", the same"},{"type":"text","text":" "},{"type":"text","text":"cover): from a maximum matching (Hopcroft–Karp on the sides), Z is the set of vertices"},{"type":"text","text":" "},{"type":"text","text":"reached from the free left vertices by alternating paths, an edge not in the matching from"},{"type":"text","text":" "},{"type":"text","text":"left to right, then the matched edge back; the cover is (left ∖ Z) ∪ (right ∩ Z), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. It is the one minimum cover with the most left vertices, so it does not"},{"type":"text","text":" "},{"type":"text","text":"depend on the matching. O(m √n)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","text":"Bipartition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"title":"minimumVertexCover(bipartition:)","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover(weight:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumVertexCover"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"type":"topic","title":"approximateMinimumVertexCover(weight:)","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","abstract":[{"text":"A vertex cover of at most twice the least weight (Bar-Yehuda and Even’s local ratio; NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"min_weighted_vertex_cover","type":"codeVoice"},{"text":", the same cover when positions are in its edge order): each edge","type":"text"},{"text":" ","type":"text"},{"text":"in position order with neither end in the cover puts in the end with the lesser remaining","type":"text"},{"type":"text","text":" "},{"type":"text","text":"weight (the end with the lesser vertex index on ties) and subtracts that weight from the"},{"type":"text","text":" "},{"type":"text","text":"other end’s. A self-loop puts its vertex in. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per vertex, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. O(n + m)."}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"abstract":[],"url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","kind":"symbol","role":"symbol"}}}