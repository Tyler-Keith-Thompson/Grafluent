ight (the end with the lesser vertex index on ties) and subtracts that weight","type":"text"},{"text":" ","type":"text"},{"text":"from the other end’s. A self-loop puts its vertex in. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per vertex, in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumVertexCover"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","title":"approximateMinimumVertexCover(weight:)","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isIndependentSet(_:)":{"kind":"symbol","type":"topic","abstract":[{"text":"Whether no edge, and no self-loop, has both ends in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":". Repeats are ignored.","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isIndependentSet(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isIndependentSet","kind