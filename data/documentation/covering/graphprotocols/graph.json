text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertices are in it.","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumDominatingSet()","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isVertexCover(_:)":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isVertexCover(_:)","url":"\/documentation\/covering\/graphprotocols\/graph\/isvertexcover(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isVertexCover"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:ST","kind":"typeIdentifier","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"text":"Whether every edge, and every self-loop, has an end in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":". Repeats are ignored.","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m).","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","title":"isVertexCover(_:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isIndependentSet(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isIndependentSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"pr