"},{"type":"codeVoice","code":"is_edge_cover"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Repeats are ignored. O(n + m)."}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isVertexCover(_:)":{"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isVertexCover(_:)","title":"isVertexCover(_:)","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/isvertexcover(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isVertexCover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether every edge, and every self-loop, has an end in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" (NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"is_vertex_cover","type":"codeVoice"},{"text":"). Repeats are ignored. O(n + m).","type":"text"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","title":"minimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of","type":"text"},{"text":" ","type":"text"},{"text":"the smallest such sets it is the lexicographically least by vertex index (the rule of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maximumIndependentSet()"},{"text":"), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges do not matter; isolated vertices are in it.","type":"text"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","kind":"symbol","title":"minimumVertexCover(bipartition:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15BipartiteGraphs11BipartitionV","kind":"typeIdentifier","text":"Bipartition"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"König’s minimum vertex cover of a bipartite graph (NetworkX "},{"type":"codeVoice","code":"to_vertex_cover"},{"type":"text","text":", the same"},{"type":"text","text":" "},{"type":"text","text":"cover): from a maximum matching (Hopcroft–Karp on the sides), Z is the set of vertices"},{"type":"text","text":" "},{"type":"text","text":"reached from the free left vertices by alternating paths, an edge not in the matching from"},{"type":"text","text":" "},{"type":"text","text":"left to right, then the matched edge back; the cover is (left ∖ Z) ∪ (right ∩ Z), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. It is the one minimum cover with the most left vertices, so it does not"},{"type":"text","text":" "},{"type":"text","text":"depend on the matching. O(m √n)."}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover()","title":"minimumEdgeCover()","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"abstract":[{"type":"text","text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumMatching()"},{"type":"text","text":", then for each vertex still uncovered, in vertex order, its first edge in"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" order (a self-loop covers its vertex). n − ν edges (Gallai)."},{"type":"text","text":" "},{"type":"text","text":"O(n · m · log n)."}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-6gboe":{"title":"approximateMinimumDominatingSet(weight:)","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-6gboe","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-6gboe","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"A dominating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover;","type":"text"},{"text":" ","type":"text"},{"text":"NetworkX ","type":"text"},{"code":"min_weighted_dominating_set","type":"codeVoice"},{"text":", the same set): repeatedly the vertex with the least","type":"text"},{"text":" ","type":"text"},{"text":"weight per newly dominated vertex of its closed neighbourhood, the least vertex index on ties.","type":"text"},{"text":" ","type":"text"},{"text":"Ratios are compared exactly, by cross-multiplication. ","type":"text"},{"type":"codeVoice","code":"weight"},{"text":" is called once per vertex.","type":"text"},{"text":" ","type":"text"},{"text":"O((n + m) log n).","type":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-7iycq":{"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-7iycq","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-7iycq","title":"approximateMinimumDominatingSet(weight:)","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumDominatingSet"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"A dominating set of at most H(Δ + 1) times the least weight, ratios computed as weight \/ k in","type":"text"},{"text":" ","type":"text"},{"text":"floating point, as NetworkX does, so the same values give the same set.","type":"text"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover(weight:)":{"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","title":"approximateMinimumVertexCover(weight:)","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumVertexCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"text":"A vertex cover of at most twice the least weight (Bar-Yehuda and Even’s local ratio; NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"min_weighted_vertex_cover","type":"codeVoice"},{"text":", the same cover when positions are in its edge order): each edge","type":"text"},{"text":" ","type":"text"},{"text":"in position order with neither end in the cover puts in the end with the lesser remaining","type":"text"},{"text":" ","type":"text"},{"text":"weight (the end with the lesser vertex index on ties) and subtracts that weight from the","type":"text"},{"text":" ","type":"text"},{"text":"other end’s. A self-loop puts its vertex in. ","type":"text"},{"code":"weight","type":"codeVoice"},{"text":" is called once per vertex, in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. O(n + m).","type":"text"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","title":"maximumIndependentSet()","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference ("},{"code":"maximumClique()","type":"codeVoice"},{"type":"text","text":"’s rule, so"},{"type":"text","text":" "},{"type":"text","text":"on a loop-free graph this is "},{"code":"maximumClique()","type":"codeVoice"},{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet()":{"title":"maximalIndependentSet()","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet()","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"text":"A maximal independent set (NetworkX ","type":"text"},{"code":"maximal_independent_set","type":"codeVoice"},{"text":", without the randomness): each","type":"text"},{"text":" ","type":"text"},{"text":"vertex in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order joins when it has no self-loop and no neighbour in the set yet.","type":"text"},{"text":" ","type":"text"},{"text":"On a graph without self-loops it is also a minimal dominating set. O(n + m).","type":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet()":{"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","title":"approximateMinimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties."}],"role":"symbol"},"doc://Covering/documentation/Covering":{"title":"Covering","identifier":"doc:\/\/Covering\/documentation\/Covering","type":"topic","kind":"symbol","url":"\/documentation\/covering","role":"collection","abstract":[]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximalIndependentSet(containing:)":{"title":"maximalIndependentSet(containing:)","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximalIndependentSet(containing:)","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maximalindependentset(containing:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximalIndependentSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"containing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]?","kind":"text"}],"abstract":[{"text":"A maximal independent set containing ","type":"text"},{"code":"seeds","type":"codeVoice"},{"text":", which go in first, then each vertex in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order as ","type":"text"},{"code":"maximalIndependentSet()","type":"codeVoice"},{"text":"; nil when ","type":"text"},{"code":"seeds","type":"codeVoice"},{"text":" is not an independent set","type":"text"},{"text":" ","type":"text"},{"text":"(two are adjacent, or one has a self-loop). Repeats are one seed. O(n + m).","type":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover()":{"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover()","title":"approximateMinimumVertexCover()","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The same with every weight 1. On a graph without self-loops it lies within the ends of","type":"text"},{"text":" ","type":"text"},{"code":"maximalMatching()","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isDominatingSet(_:)":{"title":"isDominatingSet(_:)","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isDominatingSet(_:)","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/isdominatingset(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isDominatingSet"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether every vertex is in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" or adjacent to one in it (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"is_dominating_set"},{"text":"). Repeats are ignored. O(n + m).","type":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isIndependentSet(_:)":{"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isIndependentSet(_:)","title":"isIndependentSet(_:)","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/isindependentset(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isIndependentSet","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:ST","text":"Sequence","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":