thout self-loops it lies within the ends of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximalMatching()"},{"type":"text","text":"."}],"role":"symbol","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isEdgeCover(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isEdgeCover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"isEdgeCover(_:)","abstract":[{"type":"text","text":"Whether every vertex is an end of some edge in "},{"code":"edges","type":"codeVoice"},{"type":"text","text":" (positions; NetworkX "},{"code":"is_edge_cover","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Repeats are ignored. O(n + m)."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/isedgecover(_:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isEdgeCover(_:)","kind":"symbol","role":"symbol","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols":{"title":"GraphProtocols","url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","kind":"symbol","abstract":[],"role":"collection","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-6gboe":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"approximateMinimumDominatingSet(weight:)","abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover;"},{"type":"text","text":" "},{"type":"text","text":"NetworkX "},{"type":"codeVoice","code":"min_weighted_dominating_set"},{"type":"text","text":", the same set): repeatedly the vertex with the least"},{"type":"text","text":" "},{"type":"text","text":"weight per newly dominated vertex of its closed neighbourhood, the least vertex index on ties."},{"type":"text","text":" "},{"type":"text","text":"Ratios are compared exactly, by cross-multiplication. "},{"type":"codeVoice","code":"weight"},{"type":"text","text":" is called once per vertex."},{"type":"text","text":" "},{"type":"text","text":"O((n + m) log n)."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-6gboe","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-6gboe","kind":"symbol","role":"symbol","type":"topic"},"doc://Covering/documentation/Covering":{"title":"Covering","url":"\/documentation\/covering","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"kind":"symbol","role":"collection","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover(bipartition:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bipartition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bipartition","preciseIdentifier":"s:15BipartiteGraphs11BipartitionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"title":"minimumVertexCover(bipartition:)","abstract":[{"type":"text","text":"König’s minimum vertex cover of a bipartite graph (NetworkX "},{"type":"codeVoice","code":"to_vertex_cover"},{"type":"text","text":", the same"},{"type":"text","text":" "},{"type":"text","text":"cover): from a maximum matching (Hopcroft–Karp on the sides), Z is the set of vertices"},{"type":"text","text":" "},{"type":"text","text":"reached from the free left vertices by alternating paths, an edge not in the matching from"},{"type":"text","text":" "},{"type":"text","text":"left to right, then the matched edge back; the cover is (left ∖ Z) ∪ (right ∩ Z), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order. It is the one minimum cover with the most left vertices, so it does not"},{"type":"text","text":" "},{"type":"text","text":"depend on the matching. O(m √n)."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover(bipartition:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover(bipartition:)","kind":"symbol","role":"symbol","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"approximateMinimumDominatingSet()","abstract":[{"type":"text","text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on"},{"type":"text","text":" "},{"type":"text","text":"ties."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","kind":"symbol","role":"symbol","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumVertexCover(weight:)":{"type":"topic","kind":"symbol","role":"symbol","title":"approximateMinimumVertexCover(weight:)","abstract":[{"type":"text","text":"A vertex cover of at most twice the least weight (Bar-Yehuda and Even’s local ratio; NetworkX"},{"type":"text","text":" "},{"code":"min_weighted_vertex_cover","type":"codeVoice"},{"type":"text","text":", the same cover when positions are in its edge order): each edge"},{"type":"text","text":" "},{"type":"text","text":"in position order with neither end in the cover puts in the end with the lesser remaining"},{"type":"text","text":" "},{"type":"text","text":"weight (the end with the lesser vertex index on ties) and subtracts that weight from the"},{"type":"text","text":" "},{"type":"text","text":"other end’s. A self-loop puts its vertex in. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per vertex, in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. O(n + m)."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumVertexCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","