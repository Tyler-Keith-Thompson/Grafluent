"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"The same with every weight 1: the vertex dominating the most new vertices, the least index on","type":"text"},{"text":" ","type":"text"},{"text":"ties.","type":"text"}],"kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover()":{"type":"topic","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"text":"A minimum vertex cover (exact): ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" minus ","type":"text"},{"code":"maximumIndependentSet()","type":"codeVoice"},{"text":", in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order (τ = n − α, Gallai). Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once. The cost is "},{"code":"maximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"’s: O(m √n) on bipartite components."},{"type":"text","text":" "},{"type":"text","text":"Deterministic, but which minimum cover it is depends on the search; for one fixed by a rule,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"code":"lexicographicallyFirstMinimumVertexCover()","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover()","role":"symbol","title":"minimumVertexCover()"},"doc://Covering/documentation/Covering/GraphProtocols