"text":", without building the set:","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m) plus the search on what the reductions leave.","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/independenceNumber()","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/independencenumber()","type":"topic","title":"independenceNumber()","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover(matching:)":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover(matching:)","role":"symbol","abstract":[{"text":"The same construction from ","type":"text"},{"code":"matching","type":"codeVoice"},{"text":": pass ","type":"text"},{"code":"maximumBipartiteMatching()","type":"codeVoice"},{"text":" on a bipartite","type":"text"},{"text":" ","type":"text"},{"text":"graph for O(m √n). Minimum when ","type":"text"},{"code":"matching","type":"codeVoice"},{"text":" is maximum; from any other matching it is still","type":"text"},{"text":" ","type":"text"},{"text":"an edge cover (a vertex covered by an edge added earlier in the pass is skipped). nil when","type":"text"},{"text":" ","type":"text"},{"text":"some vertex has no edge. O(n + m).","type":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover(matching:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumEdgeCover"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"matching"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Matching","preciseIdentifier":"s:14MatchingModule0A0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">) -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text