east weight (Bar-Yehuda and Even’s local ratio): each","type":"text"},{"text":" ","type":"text"},{"text":"edge in position order with neither end in the cover puts in the end with the lesser","type":"text"},{"text":" ","type":"text"},{"text":"remaining weight (the end with the lesser vertex index on ties) and subtracts that weight","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from the other end’s. A self-loop puts its vertex in. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per vertex, in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order. O(n + m)."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumVertexCover(weight:)","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumvertexcover(weight:)","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-7iycq":{"title":"approximateMinimumDominatingSet(weight:)","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-7iycq","abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight, ratios computed as weight \/ k"},{"type":"text","text":" "},{"type":"text","text":"in floating point."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"approximateMinimumDominatingSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text"