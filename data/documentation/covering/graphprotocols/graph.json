":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover()","abstract":[{"text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maximumMatching()"},{"text":", then for each vertex still uncovered, in vertex order, its first edge in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" order (a self-loop covers its vertex). n − ν edges (Gallai).","type":"text"},{"text":" ","type":"text"},{"text":"O(n · m · log n).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa","text":"Edges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]?","kind":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"title":"minimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMinimumDominatingSet()"},{"text":".","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-6gboe":{"role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/approximateminimumdominatingset(weight:)-6gboe","type":"topic","kind":"symbol","title":"approximateMinimumDominatingSet(weight:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet(weight:)-6gboe","abstract":[{"type":"text","text":"A dominating set of at most H(Δ + 1) times the least weight (Chvátal’s greedy set cover):"},{"type":"text","text":" "},{"type":"text","text":"repeatedly the vertex with the least weight per newly dominated vertex of its closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood, the least vertex index on ties. Ratios are compared exactly, by"},{"type":"text","text":" "},{"type":"text","text":"cross-multiplication. "},{"code":"weight","type":"codeVoice"},{"type":"text","text":" is called once per vertex. O((n + m) log n)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"approximateMinimumDominatingSet"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifi