,{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","kind":"symbol","role":"symbol","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isVertexCover(_:)":{"kind":"symbol","type":"topic","role":"symbol","title":"isVertexCover(_:)","abstract":[{"text":"Whether every edge, and every self-loop, has an end in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"is_vertex_cover"},{"text":"). Repeats are ignored. O(n + m).","type":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/isvertexcover(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isVertexCover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":">) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isVertexCover(_:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"title":"minimumEdgeCover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Edges","preciseIdentifier":"s:14GraphProtocols0A0P5EdgesQa