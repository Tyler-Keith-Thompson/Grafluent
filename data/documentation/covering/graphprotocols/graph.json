pe":"text","text":"the reductions and kernel search of "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":", without building the set:"},{"type":"text","text":" "},{"type":"text","text":"O(n + m) plus the search on what the reductions leave."}],"type":"topic","role":"symbol","title":"independenceNumber()","url":"\/documentation\/covering\/graphprotocols\/graph\/independencenumber()","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover(matching:)":{"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumedgecover(matching:)","abstract":[{"type":"text","text":"The same construction from "},{"type":"codeVoice","code":"matching"},{"type":"text","text":": pass "},{"type":"codeVoice","code":"maximumBipartiteMatching()"},{"type":"text","text":" on a bipartite"},{"type":"text","text":" "},{"type":"text","text":"graph for O(m √n). Minimum when "},{"type":"codeVoice","code":"matching"},{"type":"text","text":" is maximum; from any other matching it is still"},{"type":"text","text":" "},{"type":"text","text":"an edge cover (a vertex covered by an edge added earlier in the pass is skipped). nil when"},{"type":"text","text":" "},{"type":"text","text":"some vertex has no edge. O(n + m)."}],"title":"minimumEdgeCover(matching:)","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover(matching:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"matching","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MatchingModule0A0V","text":"Matching","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">) -> [","kind":"text"},{"text":"Se