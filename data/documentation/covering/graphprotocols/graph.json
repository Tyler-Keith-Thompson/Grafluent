"}],"title":"approximateMinimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()","kind":"symbol","type":"topic","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isIndependentSet(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isIndependentSet"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether no edge, and no self-loop, has both ends in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":". Repeats are ignored."},{"type":"text","text":" "},{"type":"text","text":"O(n + m)."}],"role":"symbol","type":"topic","kind":"symbol","title":"isIndependentSet(_:)","url":"\/documentation\/covering\/graphprotocols\/graph\/isindependentset(_:)","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/isIndependentSet(_:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[],"title":"Graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","type":"topic","kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/isDominatingSet(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","ki