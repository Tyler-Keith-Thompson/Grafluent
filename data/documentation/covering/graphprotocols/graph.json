xt"},{"text":"ties.","type":"text"}],"title":"approximateMinimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/approximateMinimumDominatingSet()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumVertexCover()":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A minimum vertex cover (exact): "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" minus "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":", in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order (τ = n − α, Gallai). Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once. The cost is "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"’s: O(m √n) on bipartite components."},{"type":"text","text":" "},{"type":"text","text":"Deterministic, but which minimum cover it is depends on the search; for one fixed by a rule,"},{"type":"text","text":" "},{"type":"text","text":"see "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumVertexCover()"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumVertexCover()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumvertexcover()","title":"minimumVertexCover()"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/approximateMinimumDominatingSet(weight:)-7iycq":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"k