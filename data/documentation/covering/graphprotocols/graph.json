t"},{"text":"reached from the free left vertices by alternating paths, an edge not in the matching from","type":"text"},{"text":" ","type":"text"},{"text":"left to right, then the matched edge back; the cover is (left ∖ Z) ∪ (right ∩ Z), in","type":"text"},{"text":" ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. It is the one minimum cover with the most left vertices, so it does not","type":"text"},{"text":" ","type":"text"},{"text":"depend on the matching. O(m √n).","type":"text"}],"role":"symbol","title":"minimumVertexCover(bipartition:)"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"abstract":[],"title":"Graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"url":"\/documentation\/covering\/graphprotocols\/graph","type":"topic","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumEdgeCover()":{"abstract":[{"type":"text","text":"A minimum edge cover (positions, ascending), or nil when some vertex has no edge: the edges of"},{"type":"text","text":" "},{"code":"maximumMatching()","type":"codeVoice"},{"type":"text","text":", then for each vertex still uncovered, in vertex order, its first edge in"},{"type":"text","text":" "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" order (a self-loop covers its vertex). n − ν edges (Gallai)."},{"type":"text","text":" "},{"type":"text","text":"O(n · m · log n)."}],"title":"minimumEdgeCover()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumEdgeCover()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumEdgeCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","