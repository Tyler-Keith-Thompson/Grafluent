{"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()"]}],"abstract":[{"type":"text","text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the"},{"type":"text","text":" "},{"type":"text","text":"least by vertex index (the rule of "},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"), in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;"},{"type":"text","text":" "},{"type":"text","text":"isolated vertices are in it."}],"metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE42lexicographicallyFirstMinimumDominatingSetSay6VertexQzGyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"extendedModule":"GraphProtocols","symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"lexicographicallyFirstMinimumDominatingSet()","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1780"},"modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lex