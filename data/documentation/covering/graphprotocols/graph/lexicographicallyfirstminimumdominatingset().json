{"kind":"symbol","abstract":[{"type":"text","text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the"},{"type":"text","text":" "},{"type":"text","text":"least by vertex index (the rule of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;"},{"type":"text","text":" "},{"type":"text","text":"isolated vertices are in it."}],"metadata":{"title":"lexicographicallyFirstMinimumDominatingSet()","extendedModule":"GraphProtocols","roleHeading":"Instance Method","externalID":"s:14GraphProtocols0A0P8CoveringE42lexicographicallyFirstMinimumDominatingSetSay6VertexQzGyF","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1780"},"symbolKind":"method"},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentatio