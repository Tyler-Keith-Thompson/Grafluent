{"abstract":[{"type":"text","text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the"},{"type":"text","text":" "},{"type":"text","text":"least by vertex index (the rule of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;"},{"type":"text","text":" "},{"type":"text","text":"isolated vertices are in it."}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumDominatingSet()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Γ is found as in "},{"type":"codeVoice","code":"minimumDominatingSet()"},{"type":"text","text":", with the dominated-vertex rule applied only in"},{"type":"text","text":" "},{"type":"text","text":"favour of a lesser vertex, which keeps the least set. The least set of γ vertices is then"},{"type":"text","text":" "},{"type":"text","text":"decided vertex by vertex in index order against a witness, each decision a search of only"},{"type":"text","text":" "},{"type":"text","text":"the part of the problem the vertex touches. Memory as "},{"type":"codeVoice","code":"minimumDominatingSet()"},{"type":"text","text":". Exponential"},{"type":"text","text":" "},{"type":"text","text":"in the component size in the worst case, and up to one search per vertex, so it can be far"},{"type":"text","text":" "},{"type":"text","text":"slower than "},{"type":"codeVoice","code":"minimumDominatingSet()"},{"type":"text","text":"; the search does not check for task cancellation."}]}],"kind":"content"}],"metadata":{"remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1780"},"externalID":"s:14GraphProtocols0A0P8CoveringE42lexicographicallyFirstMinimumDominatingSetSay6VertexQzGyF","role":"symbol","extendedModule":"GraphProtocols","title":"lexicographicallyFirstMinimumDominatingSet()","modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumDominatingSet","kind":"identifier"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"roleHeading":"Instance Method","symbolKind":"method"},"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumDominatingSet()":{"abstract":[{"text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the","type":"tex