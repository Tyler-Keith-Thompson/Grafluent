 lesser vertex, which keeps the least set. The least set of γ vertices is then","type":"text"},{"text":" ","type":"text"},{"text":"decided vertex by vertex in index order against a witness, each decision a search of only","type":"text"},{"text":" ","type":"text"},{"text":"the part of the problem the vertex touches. Memory as ","type":"text"},{"code":"minimumDominatingSet()","type":"codeVoice"},{"text":". Exponential","type":"text"},{"text":" ","type":"text"},{"text":"in the component size in the worst case, and up to one search per vertex, so it can be far","type":"text"},{"text":" ","type":"text"},{"text":"slower than ","type":"text"},{"code":"minimumDominatingSet()","type":"codeVoice"},{"text":"; the search does not check for task cancellation.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the"},{"type":"text","text":" "},{"type":"text","text":"least by vertex index (the rule of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"), in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;"},{"type":"text","text":" "},{"type":"text","text":"isolated vertices are in it."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()"]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumDominatingSet()"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text"