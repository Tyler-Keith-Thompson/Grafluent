{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"The lexicographically first minimum dominating set: of the smallest dominating sets, the"},{"type":"text","text":" "},{"type":"text","text":"least by vertex index (the rule of "},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"), in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and parallel edges do not matter;"},{"type":"text","text":" "},{"type":"text","text":"isolated vertices are in it."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumdominatingset()"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Γ is found as in "},{"type":"codeVoice","code":"minimumDominatingSet()"},{"type":"text","text":", with the dominated-vertex rule applied only in"},{"type":"text","text":" "},{"type":"text","text":"favour of a lesser vertex, which keeps the least set. The least set of γ vertices is then"},{"type":"text","text":" "},{"type":"text","text":"decided vertex by vertex in index order against a witness, each decision a search of only"},{"type":"text","text":" "},{"type":"text","text":"the part of the problem the vertex touches. Memory as "},{"type":"codeVoice","code":"minimumDominatingSet()"},{"type":"text","text":". Exponential"},{"type":"text","text":" "},{"type":"text","text":"in the component size in the worst case, and up to one search per vertex, so it can be far"},{"type":"text","text":" "},{"type":"text","text":"slower than "},{"type":"codeVoice","code":"minimumDominatingSet()"},{"type":"text","text":"; the search does not check for task cancellation."}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumDominatingSet()"},"metadata":{"extendedModule":"GraphProtocols","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"title":"lexicographicallyFirstMinimumDominatingSet()","roleHeading":"Instance Method","symbolKind":"method","externalID":"s:14GraphProtocols0A0P8CoveringE42lexicographicallyFirstMinimumDominatingSetSay6VertexQzGyF","role":"symbol","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1780"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumDominatingSet","kind":"identifier"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}]},"references":{"doc://Covering/documentation/Covering":{"abstract":[],"type":"topic","title":"Covering","url":"\/documentation\/covering","identifier":"doc:\/\/Covering\/documentation\/Covering","kind":"symbol","role":"collection"},"doc://Graph