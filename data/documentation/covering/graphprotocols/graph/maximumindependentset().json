{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","extendedModule":"GraphProtocols","title":"maximumIndependentSet()","role":"symbol","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1669"},"externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF"},"sections":[],"abstract":[{"text":"A maximum independent set (exact), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. A vertex","type":"text"},{"text":" ","type":"text"},{"text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which","type":"text"},{"text":" ","type":"text"},{"text":"maximum set it is depends on the search; for one fixed by a rule, see","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone. A bipartite"},{"type":"text","text":" "},{"type":"text","text":"component costs O(m √n): a maximum matching (Hopcroft–Karp), the alternating reach from its"},{"type":"text","text":" "},{"type":"text","text":"free vertices (König), and one pass over the perfectly matched core along the"},{"type":"text","text":" "},{"type":"text","text":"Dulmage–Mendelsohn implications. A complete component takes its least vertex. Any other"},{"type":"text","text":" "},{"type":"text","text":"component is solved once: the degree-0, -1 and -2 reductions (taking a leaf, folding a"},{"type":"text","text":" "},{"type":"text","text":"degree-2 vertex), then, on the kernel’s non-bipartite components, branch and bound on bitset"},{"type":"text","text":" "},{"type":"text","text":"rows of the complement with a greedy-colouring bound (BBMC; San Segundo et al. 2011). O(n +"},{"type":"text","text":" "},{"type":"text","text":"m) plus the search on what the reductions leave, exponential in the kernel’s size in the"},{"type":"text","text":" "},{"type":"text","text":"worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices. The search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"kind":"symbol","title":"Vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","type":"topic","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"Graph","abstract":[]},"doc://Covering/documentation/Covering":{"identifier":"doc:\/\/Covering\/documentation\/Covering","title":"Covering","role":"collection","abstract":[],"type":"topic","url":"\/documentation\/covering","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A maximum independent set (exact), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. A vertex"},{"type":"text","text":" "},{"type":"text","text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which"},{"type":"text","text":" "},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","role":"symbol","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","title":"maximumIndependentSet()"}}}