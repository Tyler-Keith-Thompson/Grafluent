{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","symbolKind":"method","role":"symbol","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1802"},"title":"maximumIndependentSet()","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"abstract":[{"text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser holds the least vertex of their symmetric difference (","type":"text"},{"type":"codeVoice","code":"maximumClique()"},{"text":"’s rule, so","type":"text"},{"text":" ","type":"text"},{"text":"on a loop-free graph this is ","type":"text"},{"type":"codeVoice","code":"maximumClique()"},{"text":" of the complement). A vertex with a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop is never in it; parallel edges count once.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Looped vertices are removed and each connected component solved alone, since the rule","type":"text"},{"text":" ","type":"text"},{"text":"composes across components. A bipartite component costs O(m √n): a maximum matching","type":"text"},{"text":" ","type":"text"},{"text":"(Hopcroft–Karp), the alternating reach from its free vertices (König), and one greedy pass","type":"text"},{"text":" ","type":"text"},{"text":"over the perfectly matched core in index order along the Dulmage–Mendelsohn implications.","type":"text"},{"text":" ","type":"text"},{"text":"A complete component takes its least vertex. Any other component of c vertices is decided","type":"text"},{"text":" ","type":"text"},{"text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by","type":"text"},{"text":" ","type":"text"},{"text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such","type":"text"},{"text":" ","type":"text"},{"text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete","type":"text"},{"text":" ","type":"text"},{"text":"handed to the cases above. Each decision the witness cannot answer computes α of what is","type":"text"},{"text":" ","type":"text"},{"text":"left of the vertex’s component by the degree-0, -1 and -2 reductions (taking a leaf,","type":"text"},{"text":" ","type":"text"},{"text":"folding a degree-2 vertex) and then, on the kernel’s non-bipartite components, branch and","type":"text"},{"text":" ","type":"text"},{"text":"bound on bitset rows of the complement with a greedy-colouring bound (BBMC; San Segundo et","type":"text"},{"text":" ","type":"text"},{"text":"al. 2011). So trees with few extra edges, long paths and cycles cost O(c (c + m)) at worst","type":"text"},{"text":" ","type":"text"},{"text":"and O(c + m) when the rules settle them; the search is exponential in the kernel’s size in","type":"text"},{"text":" ","type":"text"},{"text":"the worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","abstract":[{"type":"text","text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference ("},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"’s rule, so"},{"type":"text","text":" "},{"type":"text","text":"on a loop-free graph this is "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"role":"symbol","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","title":"maximumIndependentSet()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","url":"\/documentation\/covering\/graphprotocols","title":"GraphProtocols","role":"collection","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","type":"topic","kind":"symbol","title":"Graph","url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[],"role":"symbol"},"doc://Covering/documentation/Covering":{"type":"topic","url":"\/documentation\/covering","title":"Covering","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Neighbors","preciseIdentifier":"s:14GraphProtocols0A0P9NeighborsQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","abstract":[],"role":"symbol"}}}