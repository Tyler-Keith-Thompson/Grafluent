{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":"]"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Looped vertices are removed and each connected component solved alone, since the rule","type":"text"},{"text":" ","type":"text"},{"text":"composes across components. A bipartite component costs O(m √n): a maximum matching","type":"text"},{"text":" ","type":"text"},{"text":"(Hopcroft–Karp), the alternating reach from its free vertices (König), and one greedy pass","type":"text"},{"text":" ","type":"text"},{"text":"over the perfectly matched core in index order along the Dulmage–Mendelsohn implications.","type":"text"},{"text":" ","type":"text"},{"text":"A complete component takes its least vertex. Any other component of c vertices is decided","type":"text"},{"text":" ","type":"text"},{"text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by","type":"text"},{"text":" ","type":"text"},{"text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such","type":"text"},{"text":" ","type":"text"},{"text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete","type":"text"},{"text":" ","type":"text"},{"text":"handed to the cases above. Each decision the witness cannot answer computes α of what is","type":"text"},{"text":" ","type":"text"},{"text":"left of the vertex’s component by the degree-0, -1 and -2 reductions (taking a leaf,","type":"text"},{"text":" ","type":"text"},{"text":"folding a degree-2 vertex) and then, on the kernel’s non-bipartite components, branch and","type":"text"},{"text":" ","type":"text"},{"text":"bound on bitset rows of the complement with a greedy-colouring bound (BBMC; San Segundo et","type":"text"},{"text":" ","type":"text"},{"text":"al. 2011). So trees with few extra edges, long paths and cycles cost O(c (c + m)) at worst","type":"text"},{"text":" ","type":"text"},{"text":"and O(c + m) when the rules settle them; the search is exponential in the kernel’s size in","type":"text"},{"text":" ","type":"text"},{"text":"the worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices.","type":"text"}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference ("},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"’s rule, so"},{"type":"text","text":" "},{"type":"text","text":"on a loop-free graph this is "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"metadata":{"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"title":"maximumIndependentSet()","externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","extendedModule":"GraphProtocols","role":"symbol","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1802"}},"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"type":"topic","abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"Graph","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","title":"Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":" == ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Neighbors","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P9NeighborsQa"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa"}],"abstract":[],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Covering/documentation/Covering":{"type":"topic","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering","title":"Covering","kind":"symbol","url":"\/documentation\/covering","role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"abstract":[{"type":"text","text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference ("},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"’s rule, so"},{"type":"text","text":" "},{"type":"text","text":"on a loop-free graph this is "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},