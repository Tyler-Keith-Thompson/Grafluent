{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"roleHeading":"Instance Method","role":"symbol","externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1802"},"title":"maximumIndependentSet()","extendedModule":"GraphProtocols"},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"kind":"symbol","abstract":[{"type":"text","text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference ("},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"’s rule, so"},{"type":"text","text":" "},{"type":"text","text":"on a loop-free graph this is "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone, since the rule"},{"type":"text","text":" "},{"type":"text","text":"composes across components. A bipartite component costs O(m √n): a maximum matching"},{"type":"text","text":" "},{"type":"text","text":"(Hopcroft–Karp), the alternating reach from its free vertices (König), and one greedy pass"},{"type":"text","text":" "},{"type":"text","text":"over the perfectly matched core in index order along the Dulmage–Mendelsohn implications."},{"type":"text","text":" "},{"type":"text","text":"A complete component takes its least vertex. Any other component of c vertices is decided"},{"type":"text","text":" "},{"type":"text","text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by"},{"type":"text","text":" "},{"type":"text","text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such"},{"type":"text","text":" "},{"type":"text","text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete"},{"type":"text","text":" "},{"type":"text","text":"handed to the cases above. Each decision the witness cannot answer computes α of what is"},{"type":"text","text":" "},{"type":"text","text":"left of the vertex’s component by the degree-0, -1 and -2 reductions (taking a leaf,"},{"type":"text","text":" "},{"type":"text","text":"folding a degree-2 vertex) and then, on the kernel’s non-bipartite components, branch and"},{"type":"text","text":" "},{"type":"text","text":"bound on bitset rows of the complement with a greedy-colouring bound (BBMC; San Segundo et"},{"type":"text","text":" "},{"type":"text","text":"al. 2011). So trees with few extra edges, long paths and cycles cost O(c (c + m)) at worst"},{"type":"text","text":" "},{"type":"text","text":"and O(c + m) when the rules settle them; the search is exponential in the kernel’s size in"},{"type":"text","text":" "},{"type":"text","text":"the worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices."}]}],"kind":"content"}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"maximumIndependentSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","abstract":[{"text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser holds the least vertex of their symmetric difference (","type":"text"},{"type":"codeVoice","code":"maximumClique()"},{"text":"’s rule, so","type":"text"},{"text":" ","type":"text"},{"text":"on a loop-free graph this is ","type":"text"},{"type":"codeVoice","code":"maximumClique()"},{"text":" of the complement). A vertex with a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop is never in it; parallel edges count once.","type":"text"}],"kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","role":"collection","title":"GraphProtocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","url":"\/documentation\/covering\/graphprotocols","abstract":[],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","type":"topic","title":"Vertex","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"title":"Graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","url":"\/documentation\/covering\/graphprotocols\/graph","abstract":[],"kind":"symbol"},"doc://Covering/documentation/Covering":{"role":"collection","kind":"symbol","type":"topic","title":"Covering","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering","url":"\/documentation\/covering"}}}