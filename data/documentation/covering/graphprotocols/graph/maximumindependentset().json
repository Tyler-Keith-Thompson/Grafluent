{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"role":"symbol","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1619","fileName":"ExactCovering.swift"},"title":"maximumIndependentSet()"},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A maximum independent set (exact), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. A vertex"},{"type":"text","text":" "},{"type":"text","text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which"},{"type":"text","text":" "},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone. A bipartite"},{"type":"text","text":" "},{"type":"text","text":"component costs O(m √n): a maximum matching (Hopcroft–Karp), the alternating reach from its"},{"type":"text","text":" "},{"type":"text","text":"free vertices (König), and one pass over the perfectly matched core along the"},{"type":"text","text":" "},{"type":"text","text":"Dulmage–Mendelsohn implications. A complete component takes its least vertex. Any other"},{"type":"text","text":" "},{"type":"text","text":"component is solved once: the degree-0, -1 and -2 reductions (taking a leaf, folding a"},{"type":"text","text":" "},{"type":"text","text":"degree-2 vertex), then, on the kernel’s non-bipartite components, branch and bound on bitset"},{"type":"text","text":" "},{"type":"text","text":"rows of the complement with a greedy-colouring bound (BBMC; San Segundo et al. 2011). O(n +"},{"type":"text","text":" "},{"type":"text","text":"m) plus the search on what the reductions leave, exponential in the kernel’s size in the"},{"type":"text","text":" "},{"type":"text","text":"worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices. The search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"abstract":[{"type":"text","text":"A maximum independent set (exact), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. A vertex"},{"type":"text","text":" "},{"type":"text","text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which"},{"type":"text","text":" "},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","title":"maximumIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","type":"topic","role":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()"},"doc://Covering/documentation/Covering":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"type":"topic","title":"Covering","url":"\/documentation\/covering"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","type":"topic","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","kind":"symbol","role":"collection","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","kind":"symbol","role":"symbol","title":"Graph"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"kind":"symbol","role":"symbol","title":"Vertex"}}}