aphicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Covering/documentation/Covering":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","role":"collection","abstract":[],"url":"\/documentation\/covering","kind":"symbol","title":"Covering"},"doc://Covering/documentation/Covering/GraphProtocols":{"title":"GraphProtocols","role":"collection","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","kind":"symbol","url":"\/documentation\/covering\/graphprotocols","abstract":[]}}}