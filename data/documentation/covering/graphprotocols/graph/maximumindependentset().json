{"sections":[],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"abstract":[{"text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser holds the least vertex of their symmetric difference (","type":"text"},{"code":"maximumClique()","type":"codeVoice"},{"text":"’s rule, so","type":"text"},{"text":" ","type":"text"},{"text":"on a loop-free graph this is ","type":"text"},{"code":"maximumClique()","type":"codeVoice"},{"text":" of the complement). A vertex with a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop is never in it; parallel edges count once.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"]}],"metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","title":"maximumIndependentSet()","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","role":"symbol","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1802","fileName":"ExactCovering.swift"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":"]"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Looped vertices are removed and each connected component solved alone, since the rule","type":"text"},{"text":" ","type":"text"},{"text":"composes across components. A bipartite component costs O(m √n): a maximum matching","type":"text"},{"text":" ","type":"text"},{"text":"(Hopcroft–Karp), the alternating reach from its free vertices (König), and one greedy pass","type":"text"},{"text":" ","type":"text"},{"text":"over the perfectly matched core in index order along the Dulmage–Mendelsohn implications.","type":"text"},{"text":" ","type":"text"},{"text":"A complete component takes its least vertex. Any other component of c vertices is decided","type":"text"},{"text":" ","type":"text"},{"text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by","type":"text"},{"text":" ","type":"text"},{"text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such","type":"text"},{"text":" ","type":"text"},{"text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete","type":"text"},{"text":" ","type":"text"},{"text":"handed to the cases above. Each decision the witness cannot answer computes α of what is","type":"text"},{"text":" ","type":"text"},{"text":"left of the vertex’s component by the degree-0, -1 and -2 reductions (taking a leaf,","type":"text"},{"text":" ","type":"text"},{"text":"folding a degree-2 vertex) and then, on the kernel’s non-bipartite components, branch and","type":"text"},{"text":" ","type":"text"},{"text":"bound on bitset rows of the complement with a greedy-colouring bound (BBMC; San Segundo et","type":"text"},{"text":" ","type":"text"},{"text":"al. 2011). So trees with few extra edges, long paths and cycles cost O(c (c + m)) at worst","type":"text"},{"text":" ","type":"text"},{"text":"and O(c + m) when the rules settle them; the search is exponential in the kernel’s size in","type":"text"},{"text":" ","type":"text"},{"text":"the worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"abstract":[],"type":"topic","title":"Graph","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}]},"doc://Covering/documentation/Covering":{"title":"Covering","abstract":[],"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","url":"\/documentation\/covering","role":"collection","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","abstract":[],"title":"GraphProtocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","url":"\/documentation\/covering\/graphprotocols","role":"collection","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"kind":"symbol","title":"maximumIndependentSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","abstract":[{"type":"text","text":"A maximum independent set (exact): of all the largest ones, the lexicographically least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference ("},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":"’s rule, so"},{"type":"text","text":" "},{"type":"text","text":"on a loop-free graph this is "},{"type":"codeVoice","code":"maximumClique()"},{"type":"text","text":" of the complement). A vertex with a"},{"type":"text","text":" "},{"type":"text","text":"self-loop is never in it; parallel edges count once."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"type":"topic","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"title":"Vertex","abstract":[],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","kind":"symbol"}}}