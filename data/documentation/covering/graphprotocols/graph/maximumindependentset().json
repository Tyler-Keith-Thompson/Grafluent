ee"},{"type":"text","text":" "},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","role":"symbol"},"doc://Covering/documentation/Covering":{"title":"Covering","url":"\/documentation\/covering","role":"collection","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering"},"doc://Covering/documentation/Covering/GraphProtocols":{"role":"collection","url":"\/documentation\/covering\/graphprotocols","type":"topic","title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[]}}}