{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A maximum independent set (exact), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. A vertex"},{"type":"text","text":" "},{"type":"text","text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which"},{"type":"text","text":" "},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone. A bipartite"},{"type":"text","text":" "},{"type":"text","text":"component costs O(m √n): a maximum matching (Hopcroft–Karp), the alternating reach from its"},{"type":"text","text":" "},{"type":"text","text":"free vertices (König), and one pass over the perfectly matched core along the"},{"type":"text","text":" "},{"type":"text","text":"Dulmage–Mendelsohn implications. A complete component takes its least vertex. Any other"},{"type":"text","text":" "},{"type":"text","text":"component is solved once: the degree-0, -1 and -2 reductions (taking a leaf, folding a"},{"type":"text","text":" "},{"type":"text","text":"degree-2 vertex), then, on the kernel’s non-bipartite components, branch and bound on bitset"},{"type":"text","text":" "},{"type":"text","text":"rows of the complement with a greedy-colouring bound (BBMC; San Segundo et al. 2011). O(n +"},{"type":"text","text":" "},{"type":"text","text":"m) plus the search on what the reductions leave, exponential in the kernel’s size in the"},{"type":"text","text":" "},{"type":"text","text":"worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices. The search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"kind":"symbol","metadata":{"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1619","fileName":"ExactCovering.swift"},"symbolKind":"method","title":"maximumIndependentSet()"},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Covering/documentation/Covering":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"url":"\/documentation\/covering","kind":"symbol","role":"collection","title":"Covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"Graph","kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","url":"\/documentation\/covering\/graphprotocols","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","title":"GraphProtocols","kind":"symbol","role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"title":"maximumIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"abstract":[{"text":"A maximum independent set (exact), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. A vertex","type":"text"},{"text":" ","type":"text"},{"text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","kind":"symbol","role":"symbol","title":"Vertex"}}}