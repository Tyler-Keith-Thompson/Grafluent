{"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone. A bipartite"},{"type":"text","text":" "},{"type":"text","text":"component costs O(m √n): a maximum matching (Hopcroft–Karp), the alternating reach from its"},{"type":"text","text":" "},{"type":"text","text":"free vertices (König), and one pass over the perfectly matched core along the"},{"type":"text","text":" "},{"type":"text","text":"Dulmage–Mendelsohn implications. A complete component takes its least vertex. Any other"},{"type":"text","text":" "},{"type":"text","text":"component is solved once: the degree-0, -1 and -2 reductions (taking a leaf, folding a"},{"type":"text","text":" "},{"type":"text","text":"degree-2 vertex), then, on the kernel’s non-bipartite components, branch and bound on bitset"},{"type":"text","text":" "},{"type":"text","text":"rows of the complement with a greedy-colouring bound (BBMC; San Segundo et al. 2011). O(n +"},{"type":"text","text":" "},{"type":"text","text":"m) plus the search on what the reductions leave, exponential in the kernel’s size in the"},{"type":"text","text":" "},{"type":"text","text":"worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices. The search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A maximum independent set (exact), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. A vertex","type":"text"},{"text":" ","type":"text"},{"text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which","type":"text"},{"text":" ","type":"text"},{"text":"maximum set it is depends on the search; for one fixed by a rule, see","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","role":"symbol","symbolKind":"method","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1669"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"extendedModule":"GraphProtocols","roleHeading":"Instance Method","title":"maximumIndependentSet()"},"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"title":"Graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","type":"topic","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"kind":"symbol","abstract":[]},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","kind":"symbol","url":"\/documentation\/covering\/graphprotocols","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","role":"collection","title":"GraphProtocols"},"doc://Covering/documentation/Covering":{"type":"topic","kind":"symbol","url":"\/documentation\/covering","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering","role":"collection","title":"Covering"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"kind":"symbol","abstract":[]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","title":"maximumIndependentSet()","type":"topic","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"A maximum independent set (exact), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. A vertex","type":"text"},{"text":" ","type":"text"},{"text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which","type":"text"},{"text":" ","type":"text"},{"text":"maximum set it is depends on the search; for one fixed by a rule, see","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":".","type":"text"}],"kind":"symbol"}}}