{"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone. A bipartite"},{"type":"text","text":" "},{"type":"text","text":"component costs O(m √n): a maximum matching (Hopcroft–Karp), the alternating reach from its"},{"type":"text","text":" "},{"type":"text","text":"free vertices (König), and one pass over the perfectly matched core along the"},{"type":"text","text":" "},{"type":"text","text":"Dulmage–Mendelsohn implications. A complete component takes its least vertex. Any other"},{"type":"text","text":" "},{"type":"text","text":"component is solved once: the degree-0, -1 and -2 reductions (taking a leaf, folding a"},{"type":"text","text":" "},{"type":"text","text":"degree-2 vertex), then, on the kernel’s non-bipartite components, branch and bound on bitset"},{"type":"text","text":" "},{"type":"text","text":"rows of the complement with a greedy-colouring bound (BBMC; San Segundo et al. 2011). O(n +"},{"type":"text","text":" "},{"type":"text","text":"m) plus the search on what the reductions leave, exponential in the kernel’s size in the"},{"type":"text","text":" "},{"type":"text","text":"worst case. Memory O(n + m + k² \/ 64) words for a kernel component of k vertices. The search"},{"type":"text","text":" "},{"type":"text","text":"does not check for task cancellation."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A maximum independent set (exact), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. A vertex"},{"type":"text","text":" "},{"type":"text","text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which"},{"type":"text","text":" "},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()"]}],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","interfaceLanguage":"swift"},"metadata":{"symbolKind":"method","externalID":"s:14GraphProtocols0A0P8CoveringE21maximumIndependentSetSay6VertexQzGyF","extendedModule":"GraphProtocols","modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"title":"maximumIndependentSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"roleHeading":"Instance Method","role":"symbol","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1669"}},"kind":"symbol","references":{"doc://Covering/documentation/Covering/GraphProtocols":{"title":"GraphProtocols","kind":"symbol","type":"topic","role":"collection","abstract":[],"url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/maximumIndependentSet()":{"kind":"symbol","abstract":[{"text":"A maximum independent set (exact), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. A vertex","type":"text"},{"text":" ","type":"text"},{"text":"with a self-loop is never in it; parallel edges count once. Deterministic, but which","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"maximum set it is depends on the search; for one fixed by a rule, see"},{"type":"text","text":" "},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/maximumindependentset()","role":"symbol","title":"maximumIndependentSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"maximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://Covering/documentation/Covering":{"kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","url":"\/documentation\/covering","role":"collection","title":"Covering"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","title":"Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"kind":"symbol","abstract":[],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","url":"\/documentation\/covering\/graphprotocols\/graph","role":"symbol","title":"Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}]}}}