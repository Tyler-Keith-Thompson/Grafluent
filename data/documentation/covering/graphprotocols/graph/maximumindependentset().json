codeVoice"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/maximumIndependentSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}]},"doc://Covering/documentation/Covering":{"url":"\/documentation\/covering","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering","type":"topic","role":"collection","abstract":[],"title":"Covering"}}}