umentation/Covering/GraphProtocols":{"abstract":[],"type":"topic","title":"GraphProtocols","url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","kind":"symbol","role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"title":"Graph","type":"topic","abstract":[],"kind":"symbol","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}]}}}