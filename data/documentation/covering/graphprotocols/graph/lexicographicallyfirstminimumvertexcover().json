,"text":"once."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"It is the complement of the lexicographically greatest maximum independent set, not of the","type":"text"},{"text":" ","type":"text"},{"text":"least one: the least vertex of a symmetric difference is in one cover exactly when it is in","type":"text"},{"text":" ","type":"text"},{"text":"the other cover’s complement. That set is found as in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":", with each choice the other way round: the","type":"text"},{"text":" ","type":"text"},{"text":"core pass on a bipartite component leaves out each vertex it decides, a complete component","type":"text"},{"text":" ","type":"text"},{"text":"keeps its greatest vertex, and any other component deletes a vertex whenever a maximum set","type":"text"},{"text":" ","type":"text"},{"text":"without it remains, with the reductions taking a simplicial vertex greater than all its","type":"text"},{"text":" ","type":"text"},{"text":"neighbours. The cost is that of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":": O(m √n) on","type":"text"},{"text":" ","type":"text"},{"text":"bipartite components, and up to c exponential searches on a component of c vertices the","type":"text"},{"text":" ","type":"text"},{"text":"reductions do not settle. The search does not check for task cancellation.","type":"text"}]}],"kind":"content"}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumVertexCover()":{"kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"title":"lexicographicallyFirstMinimumVertexCover()","abstract":[{"text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least","type":"text"},{"text":" ","type":"text"},{"text":"by vertex index (the rule of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":": of two covers","type":"text"},{"text":" ","type":"text"},{"text":"of one size, the lesser holds the least vertex of their symmetric difference), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","type":"topic","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph"}],"title":"Graph","abstract":[],"role":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"},"doc://Covering/documentation/Covering":{"url":"\/documentation\/covering","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering","type":"topic","title":"Covering"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"title":"Vertex","abstract":[],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"}}}