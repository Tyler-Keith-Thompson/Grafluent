{"sections":[],"metadata":{"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols0A0P8CoveringE40lexicographicallyFirstMinimumVertexCoverSay0G0QzGyF","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1739"},"roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"symbolKind":"method","role":"symbol","title":"lexicographicallyFirstMinimumVertexCover()"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"It is the complement of the lexicographically greatest maximum independent set, not of the"},{"type":"text","text":" "},{"type":"text","text":"least one: the least vertex of a symmetric difference is in one cover exactly when it is in"},{"type":"text","text":" "},{"type":"text","text":"the other cover’s complement. That set is found as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":", with each choice the other way round: the"},{"type":"text","text":" "},{"type":"text","text":"core pass on a bipartite component leaves out each vertex it decides, a complete component"},{"type":"text","text":" "},{"type":"text","text":"keeps its greatest vertex, and any other component deletes a vertex whenever a maximum set"},{"type":"text","text":" "},{"type":"text","text":"without it remains, with the reductions taking a simplicial vertex greater than all its"},{"type":"text","text":" "},{"type":"text","text":"neighbours. The cost is that of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":": O(m √n) on"},{"type":"text","text":" "},{"type":"text","text":"bipartite components, and up to c exponential searches on a component of c vertices the"},{"type":"text","text":" "},{"type":"text","text":"reductions do not settle. The search does not check for task cancellation."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()"]}],"kind":"symbol","abstract":[{"text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least","type":"text"},{"text":" ","type":"text"},{"text":"by vertex index (the rule of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":": of two covers","type":"text"},{"text":" ","type":"text"},{"text":"of one size, the lesser holds the least vertex of their symmetric difference), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"abstract":[],"title":"Graph","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"title":"Vertex","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"role":"symbol"},"doc://Covering/documentation/Covering":{"abstract":[],"kind":"symbol","url":"\/documentation\/covering","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","role":"collection","title":"Covering"},"doc://Covering/documentation/Covering/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","role":"collection","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumVertexCover()":{"abstract":[{"type":"text","text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least"},{"type":"text","text":" "},{"type":"text","text":"by vertex index (the rule of "},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"type":"text","text":": of two covers"},{"type":"text","text":" "},{"type":"text","text":"of one size, the lesser holds the least vertex of their symmetric difference), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once."}],"title":"lexicographicallyFirstMinimumVertexCover()","kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"role":"symbol"}}}