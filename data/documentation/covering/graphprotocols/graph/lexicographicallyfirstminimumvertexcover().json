entation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"It is the complement of the lexicographically greatest maximum independent set, not of the","type":"text"},{"text":" ","type":"text"},{"text":"least one: the least vertex of a symmetric difference is in one cover exactly when it is in","type":"text"},{"text":" ","type":"text"},{"text":"the other cover’s complement. That set is found as in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":", with each choice the other way round: the","type":"text"},{"text":" ","type":"text"},{"text":"core pass on a bipartite component leaves out each vertex it decides, a complete component","type":"text"},{"text":" ","type":"text"},{"text":"keeps its greatest vertex, and any other component deletes a vertex whenever a maximum set","type":"text"},{"text":" ","type":"text"},{"text":"without it remains, with the reductions taking a simplicial vertex greater than all its","type":"text"},{"text":" ","type":"text"},{"text":"neighbours. The cost is that of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":": O(m √n) on","type":"text"},{"text":" ","type":"text"},{"text":"bipartite components, and up to c exponential searches on a component of c vertices the","type":"text"},{"text":" ","type":"text"},{"text":"reductions do not settle. The search does not check for task cancellation.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Covering/documentation/Covering/GraphProtocols":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"type":"topic","kind":"symbol","title":"GraphProtocols","url":"\/documentation\/covering\/graphprotocols","role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumVertexCover()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()","abstract":[{"type":"text","text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least"},{"type":"text","text":" "},{"type":"text","text":"by vertex index (the rule of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":": of two covers"},{"type":"text","text":" "},{"type":"text","text":"of one size, the lesser holds the least vertex of their symmetric difference), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once."}],"type":"topic","kind":"symbol","title":"lexicographicallyFirstMinimumVertexCover()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documen