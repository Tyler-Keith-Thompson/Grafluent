{"sections":[],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"It is the complement of the lexicographically greatest maximum independent set, not of the","type":"text"},{"text":" ","type":"text"},{"text":"least one: the least vertex of a symmetric difference is in one cover exactly when it is in","type":"text"},{"text":" ","type":"text"},{"text":"the other cover’s complement. That set is found as in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":", with each choice the other way round: the","type":"text"},{"text":" ","type":"text"},{"text":"core pass on a bipartite component leaves out each vertex it decides, a complete component","type":"text"},{"text":" ","type":"text"},{"text":"keeps its greatest vertex, and any other component deletes a vertex whenever a maximum set","type":"text"},{"text":" ","type":"text"},{"text":"without it remains, with the reductions taking a simplicial vertex greater than all its","type":"text"},{"text":" ","type":"text"},{"text":"neighbours. The cost is that of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":": O(m √n) on","type":"text"},{"text":" ","type":"text"},{"text":"bipartite components, and up to c exponential searches on a component of c vertices the","type":"text"},{"text":" ","type":"text"},{"text":"reductions do not settle. The search does not check for task cancellation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least"},{"type":"text","text":" "},{"type":"text","text":"by vertex index (the rule of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":": of two covers"},{"type":"text","text":" "},{"type":"text","text":"of one size, the lesser holds the least vertex of their symmetric difference), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" "},{"type":"text","text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once."}],"kind":"symbol","metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1739"},"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","role":"symbol","externalID":"s:14GraphProtocols0A0P8CoveringE40lexicographicallyFirstMinimumVertexCoverSay0G0QzGyF","title":"lexicographicallyFirstMinimumVertexCover()"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()","interfaceLanguage":"swift"},"references":{"doc://Covering/documentation/Covering":{"url":"\/documentation\/covering","type":"topic","role":"collection","title":"Covering","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumVertexCover()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"type":"topic","abstract":[{"text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least","type":"text"},{"text":" ","type":"text"},{"text":"by vertex index (the rule of ","type":"text"},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"text":": of two covers","type":"text"},{"text":" ","type":"text"},{"text":"of one size, the lesser holds the least vertex of their symmetric difference), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()","title":"lexicographicallyFirstMinimumVertexCover()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Gra