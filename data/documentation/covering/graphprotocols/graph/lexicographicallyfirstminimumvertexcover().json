{"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1739","fileName":"ExactCovering.swift"},"role":"symbol","title":"lexicographicallyFirstMinimumVertexCover()","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P8CoveringE40lexicographicallyFirstMinimumVertexCoverSay0G0QzGyF","extendedModule":"GraphProtocols","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"It is the complement of the lexicographically greatest maximum independent set, not of the"},{"type":"text","text":" "},{"type":"text","text":"least one: the least vertex of a symmetric difference is in one cover exactly when it is in"},{"type":"text","text":" "},{"type":"text","text":"the other cover’s complement. That set is found as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":", with each choice the other way round: the"},{"type":"text","text":" "},{"type":"text","text":"core pass on a bipartite component leaves out each vertex it decides, a complete component"},{"type":"text","text":" "},{"type":"text","text":"keeps its greatest vertex, and any other component deletes a vertex whenever a maximum set"},{"type":"text","text":" "},{"type":"text","text":"without it remains, with the reductions taking a simplicial vertex greater than all its"},{"type":"text","text":" "},{"type":"text","text":"neighbours. The cost is that of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":": O(m √n) on"},{"type":"text","text":" "},{"type":"text","text":"bipartite components, and up to c exponential searches on a component of c vertices the"},{"type":"text","text":" "},{"type":"text","text":"reductions do not settle. The search does not check for task cancellation."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least","type":"text"},{"text":" ","type":"text"},{"text":"by vertex index (the rule of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":": of two covers","type":"text"},{"text":" ","type":"text"},{"text":"of one size, the lesser holds the least vertex of their symmetric difference), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"kind":"symbol","references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","title":"Vertex","type":"topic","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumVertexCover()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()","role":"symbol","type":"topic","kind":"symbol","title":"lexicographicallyFirstMinimumVertexCover()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least"},{"type":"text","text":" "},{"type":"text","text":"by vertex index (the rule of "},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"type":"text","text":": of two covers"},{"type":"text","text":" "},{"type":"text","text":"of one size, the lesser holds the least vertex of their symmetric difference), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count"},{"type":"text","text":" "},{"type":"text","text":"once."}]},"doc://Covering/documentation/Covering/GraphProtocols":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"url":"\/documentation\/covering\/graphprotocols","role":"collection","title":"GraphProtocols","type":"topic","kind":"symbol"},"doc://Covering/documentation/Covering":{"identifier":"doc:\/\/Covering\/documentation\/Covering","url":"\/documentation\/covering","role":"collection","type":"topic","title":"Covering","kind":"symbol","abstract":[]},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","abstract":[],"url":"\/documentation\/covering\/graphprotocols\/graph","role":"symbol","title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"kind":"symbol"}}}