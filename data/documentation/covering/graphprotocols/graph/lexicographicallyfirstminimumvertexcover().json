{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex"},{"kind":"text","text":"]"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"It is the complement of the lexicographically greatest maximum independent set, not of the"},{"type":"text","text":" "},{"type":"text","text":"least one: the least vertex of a symmetric difference is in one cover exactly when it is in"},{"type":"text","text":" "},{"type":"text","text":"the other cover’s complement. That set is found as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":", with each choice the other way round: the"},{"type":"text","text":" "},{"type":"text","text":"core pass on a bipartite component leaves out each vertex it decides, a complete component"},{"type":"text","text":" "},{"type":"text","text":"keeps its greatest vertex, and any other component deletes a vertex whenever a maximum set"},{"type":"text","text":" "},{"type":"text","text":"without it remains, with the reductions taking a simplicial vertex greater than all its"},{"type":"text","text":" "},{"type":"text","text":"neighbours. The cost is that of "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"type":"text","text":": O(m √n) on"},{"type":"text","text":" "},{"type":"text","text":"bipartite components, and up to c exponential searches on a component of c vertices the"},{"type":"text","text":" "},{"type":"text","text":"reductions do not settle. The search does not check for task cancellation."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1739","fileName":"ExactCovering.swift"},"roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMinimumVertexCover"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"symbolKind":"method","externalID":"s:14GraphProtocols0A0P8CoveringE40lexicographicallyFirstMinimumVertexCoverSay0G0QzGyF","title":"lexicographicallyFirstMinimumVertexCover()","extendedModule":"GraphProtocols"},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"sections":[],"abstract":[{"text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least","type":"text"},{"text":" ","type":"text"},{"text":"by vertex index (the rule of ","type":"text"},{"code":"lexicographicallyFirstMaximumIndependentSet()","type":"codeVoice"},{"text":": of two covers","type":"text"},{"text":" ","type":"text"},{"text":"of one size, the lesser holds the least vertex of their symmetric difference), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" ","type":"text"},{"text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMinimumVertexCover()":{"title":"lexicographicallyFirstMinimumVertexCover()","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstminimumvertexcover()","abstract":[{"text":"The lexicographically first minimum vertex cover: of the smallest vertex covers, the least","type":"text"},{"text":" ","type":"text"},{"text":"by vertex index (the rule of ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumIndependentSet()"},{"text":": of two covers","type":"text"},{"text":" ","type":"text"},{"text":"of one size, the lesser holds the least vertex of their symmetric difference), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" ","type":"text"},{"text":"order; [] for the empty graph. Every vertex with a self-loop is in it; parallel edges count","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMinimumVertexCover()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMinimumVertexCover","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://Covering/documentation/Covering":{"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"titl