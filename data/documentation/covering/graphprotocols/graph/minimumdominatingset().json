{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Each connected component is solved alone; a vertex adjacent to all the others of its","type":"text"},{"text":" ","type":"text"},{"text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated","type":"text"},{"text":" ","type":"text"},{"text":"vertex with one possible dominator gets it, and a vertex whose undominated closed","type":"text"},{"text":" ","type":"text"},{"text":"neighbourhood lies in another’s is ruled out (for the lexicographic pass only in favour of","type":"text"},{"text":" ","type":"text"},{"text":"a lesser vertex, which keeps the least set; this leaf rule settles paths and many trees","type":"text"},{"text":" ","type":"text"},{"text":"outright). The search branches on the most-coverage dominator of an undominated vertex","type":"text"},{"text":" ","type":"text"},{"text":"with the fewest left and prunes on the budget, on the largest coverages, and on a greedy","type":"text"},{"text":" ","type":"text"},{"text":"2-packing (vertices with no dominator in common, each needing its own; on trees the largest","type":"text"},{"text":" ","type":"text"},{"text":"2-packing is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one","type":"text"},{"text":" ","type":"text"},{"text":"smaller; the least set of γ vertices is then decided vertex by vertex in index order","type":"text"},{"text":" ","type":"text"},{"text":"against a witness, each decision searching only the part of the problem the vertex","type":"text"},{"text":" ","type":"text"},{"text":"touches. Sparse components keep O(n + m) words of state; dense ones (mean degree d with d²","type":"text"},{"text":" ","type":"text"},{"text":"above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words. Exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"component size in the worst case.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()"},"metadata":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1846"},"roleHeading":"Instance Method","symbolKind":"method","modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","extendedModule":"GraphProtocols","title":"minimumDominatingSet()"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of","type":"text"},{"text":" ","type":"text"},{"text":"the smallest such sets it is the lexicographically least by vertex index (the rule of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maximumIndependentSet()"},{"text":"), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges do not matter; isolated vertices are in it.","type":"text"}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","role":"symbol","abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of"},{"type":"text","text":" "},{"type":"text","text":"the smallest such sets it is the lexicographically least by vertex index (the rule of"},{"type":"text","text":" "},{"code":"maximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}],"title":"minimumDominatingSet()","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"G