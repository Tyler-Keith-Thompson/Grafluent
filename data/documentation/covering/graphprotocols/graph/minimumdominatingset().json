{"sections":[],"metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1764"},"modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"title":"minimumDominatingSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"symbolKind":"method","roleHeading":"Instance Method","role":"symbol","extendedModule":"GraphProtocols"},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Each connected component is solved alone; a vertex adjacent to all the others of its"},{"type":"text","text":" "},{"type":"text","text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated"},{"type":"text","text":" "},{"type":"text","text":"vertex with one possible dominator gets it, and a vertex whose undominated closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees"},{"type":"text","text":" "},{"type":"text","text":"outright). The search branches on the most-coverage dominator of an undominated vertex with"},{"type":"text","text":" "},{"type":"text","text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing"},{"type":"text","text":" "},{"type":"text","text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing"},{"type":"text","text":" "},{"type":"text","text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the"},{"type":"text","text":" "},{"type":"text","text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones"},{"type":"text","text":" "},{"type":"text","text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words."},{"type":"text","text":" "},{"type":"text","text":"Exponential in the component size in the worst case; the search does not check for task"},{"type":"text","text":" "},{"type":"text","text":"cancellation."}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"abstract":[],"title":"Graph","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"title":"Vertex","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"role":"symbol"},"doc://Covering/documentation/Covering":{"abstract":[],"kind":"symbol","url":"\/documentation\/covering","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","role":"collection","title":"Covering"},"doc://Covering/documentation/Covering/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","role":"collection","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"role":"symbol","type":"topic","title":"minimumDominatingSet()","abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"type":"text","text":"."}]}}}