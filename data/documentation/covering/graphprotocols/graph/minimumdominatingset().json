or the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"url":"\/documentation\/graphprotocols\/graph\/vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"url":"\/documentation\/covering\/graphprotocols\/graph","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"Graph","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"role":"symbol","title":"minimumDominatingSet()","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":".