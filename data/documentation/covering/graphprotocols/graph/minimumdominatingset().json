{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"symbolKind":"method","title":"minimumDominatingSet()","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1764","fileName":"ExactCovering.swift"},"extendedModule":"GraphProtocols"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connected component is solved alone; a vertex adjacent to all the others of its"},{"type":"text","text":" "},{"type":"text","text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated"},{"type":"text","text":" "},{"type":"text","text":"vertex with one possible dominator gets it, and a vertex whose undominated closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees"},{"type":"text","text":" "},{"type":"text","text":"outright). The search branches on the most-coverage dominator of an undominated vertex with"},{"type":"text","text":" "},{"type":"text","text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing"},{"type":"text","text":" "},{"type":"text","text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing"},{"type":"text","text":" "},{"type":"text","text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the"},{"type":"text","text":" "},{"type":"text","text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones"},{"type":"text","text":" "},{"type":"text","text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words."},{"type":"text","text":" "},{"type":"text","text":"Exponential in the component size in the worst case; the search does not check for task"},{"type":"text","text":" "},{"type":"text","text":"cancellation."}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()"},"abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"]}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"kind":"symbol","title":"Vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","type":"topic","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"Graph","abstract":[]},"doc://Covering/documentation/Covering":{"identifier":"doc:\/\/Covering\/documentation\/Covering","title":"Covering","role":"collection","abstract":[],"type":"topic","url":"\/documentation\/covering","kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","role":"symbol","type":"topic","title":"minimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()"}}}