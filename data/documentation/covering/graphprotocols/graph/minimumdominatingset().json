nd":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"title":"minimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of"},{"type":"text","text":" "},{"type":"text","text":"the smallest such sets it is the lexicographically least by vertex index (the rule of"},{"type":"text","text":" "},{"code":"maximumIndependentSet()","type":"codeVoice"},{"type":"text","text":"), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}],"kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/covering\/graphprotocols","kind":"symbol","abstract":[],"role":"collection"}}}