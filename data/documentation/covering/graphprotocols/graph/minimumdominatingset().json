{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"extendedModule":"GraphProtocols","role":"symbol","externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1846","fileName":"ExactCovering.swift"},"title":"minimumDominatingSet()","roleHeading":"Instance Method"},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"kind":"symbol","abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of","type":"text"},{"text":" ","type":"text"},{"text":"the smallest such sets it is the lexicographically least by vertex index (the rule of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"maximumIndependentSet()"},{"text":"), in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges do not matter; isolated vertices are in it.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Each connected component is solved alone; a vertex adjacent to all the others of its","type":"text"},{"text":" ","type":"text"},{"text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated","type":"text"},{"text":" ","type":"text"},{"text":"vertex with one possible dominator gets it, and a vertex whose undominated closed","type":"text"},{"text":" ","type":"text"},{"text":"neighbourhood lies in another’s is ruled out (for the lexicographic pass only in favour of","type":"text"},{"text":" ","type":"text"},{"text":"a lesser vertex, which keeps the least set; this leaf rule settles paths and many trees","type":"text"},{"text":" ","type":"text"},{"text":"outright). The search branches on the most-coverage dominator of an undominated vertex","type":"text"},{"text":" ","type":"text"},{"text":"with the fewest left and prunes on the budget, on the largest coverages, and on a greedy","type":"text"},{"text":" ","type":"text"},{"text":"2-packing (vertices with no dominator in common, each needing its own; on trees the largest","type":"text"},{"text":" ","type":"text"},{"text":"2-packing is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one","type":"text"},{"text":" ","type":"text"},{"text":"smaller; the least set of γ vertices is then decided vertex by vertex in index order","type":"text"},{"text":" ","type":"text"},{"text":"against a witness, each decision searching only the part of the problem the vertex","type":"text"},{"text":" ","type":"text"},{"text":"touches. Sparse components keep O(n + m) words of state; dense ones (mean degree d with d²","type":"text"},{"text":" ","type":"text"},{"text":"above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words. Exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"component size in the worst case.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","type":"topic","title":"Vertex","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"title":"minimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of"},{"type":"text","text":" "},{"type":"text","text":"the smallest such sets it is the lexicographically least by vertex index (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}],"kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","role":"collection","title":"GraphProtocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","url":"\/documentation\/covering\/graphprotocols","abstract":[],"kind":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"title":"Graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","url":"\/documentation\/covering\/graphprotocols\/graph","abstract":[],"kind":"symbol"},"doc://Covering/documentation/Covering":{"role":"collection","kind":"symbol","type":"topic","title":"Covering","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering","url":"\/documentation\/covering"}}}