{"metadata":{"extendedModule":"GraphProtocols","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"roleHeading":"Instance Method","role":"symbol","externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","title":"minimumDominatingSet()","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1764","fileName":"ExactCovering.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Each connected component is solved alone; a vertex adjacent to all the others of its"},{"type":"text","text":" "},{"type":"text","text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated"},{"type":"text","text":" "},{"type":"text","text":"vertex with one possible dominator gets it, and a vertex whose undominated closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees"},{"type":"text","text":" "},{"type":"text","text":"outright). The search branches on the most-coverage dominator of an undominated vertex with"},{"type":"text","text":" "},{"type":"text","text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing"},{"type":"text","text":" "},{"type":"text","text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing"},{"type":"text","text":" "},{"type":"text","text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the"},{"type":"text","text":" "},{"type":"text","text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones"},{"type":"text","text":" "},{"type":"text","text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words."},{"type":"text","text":" "},{"type":"text","text":"Exponential in the component size in the worst case; the search does not check for task"},{"type":"text","text":" "},{"type":"text","text":"cancellation."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumDominatingSet()"},{"type":"text","text":"."}],"role":"symbol","title":"minimumDominatingSet()","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"type":"topic","abstract":[],"role":"symbol","title":"Vertex","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","title":"GraphProtocols","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"kind":"symbol","role":"collection"},"doc://Covering/documentation/Covering":{"url":"\/documentation\/covering","title":"Covering","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","kind":"symbol","abstract":[],"role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"abstract":[],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"}}}