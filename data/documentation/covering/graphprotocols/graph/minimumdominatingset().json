{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"role":"symbol","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1689","fileName":"ExactCovering.swift"},"title":"minimumDominatingSet()"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()"},"abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Each connected component is solved alone; a vertex adjacent to all the others of its"},{"type":"text","text":" "},{"type":"text","text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated"},{"type":"text","text":" "},{"type":"text","text":"vertex with one possible dominator gets it, and a vertex whose undominated closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees"},{"type":"text","text":" "},{"type":"text","text":"outright). The search branches on the most-coverage dominator of an undominated vertex with"},{"type":"text","text":" "},{"type":"text","text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing"},{"type":"text","text":" "},{"type":"text","text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing"},{"type":"text","text":" "},{"type":"text","text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the"},{"type":"text","text":" "},{"type":"text","text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones"},{"type":"text","text":" "},{"type":"text","text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words."},{"type":"text","text":" "},{"type":"text","text":"Exponential in the component size in the worst case; the search does not check for task"},{"type":"text","text":" "},{"type":"text","text":"cancellation."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Covering/documentation/Covering":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"type":"topic","title":"Covering","url":"\/documentation\/covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"minimumDominatingSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","type":"topic","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","kind":"symbol","role":"collection","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","kind":"symbol","role":"symbol","title":"Graph"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"kind":"symbol","role":"symbol","title":"Vertex"}}}