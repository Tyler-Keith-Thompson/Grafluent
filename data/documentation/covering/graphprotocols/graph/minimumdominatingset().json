{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()"},"metadata":{"extendedModule":"GraphProtocols","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1764"},"modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"role":"symbol","symbolKind":"method","externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","title":"minimumDominatingSet()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Each connected component is solved alone; a vertex adjacent to all the others of its","type":"text"},{"text":" ","type":"text"},{"text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated","type":"text"},{"text":" ","type":"text"},{"text":"vertex with one possible dominator gets it, and a vertex whose undominated closed","type":"text"},{"text":" ","type":"text"},{"text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees","type":"text"},{"text":" ","type":"text"},{"text":"outright). The search branches on the most-coverage dominator of an undominated vertex with","type":"text"},{"text":" ","type":"text"},{"text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing","type":"text"},{"text":" ","type":"text"},{"text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing","type":"text"},{"text":" ","type":"text"},{"text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the","type":"text"},{"text":" ","type":"text"},{"text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones","type":"text"},{"text":" ","type":"text"},{"text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words.","type":"text"},{"text":" ","type":"text"},{"text":"Exponential in the component size in the worst case; the search does not check for task","type":"text"},{"text":" ","type":"text"},{"text":"cancellation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"]}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph","preciseIdentifier":"s:14GraphProtocols0A0P"}],"url":"\/documentation\/covering\/graphprotocols\/graph","abstract":[],"title":"Graph","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols":{"title":"GraphProtocols","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","type":"topic","url":"\/documentation\/covering\/graphprotocols","role":"collection","abstract":[]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","title":"minimumDominatingSet()","abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","title":"Vertex","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"role":"symbol","abstract":[]},"doc://Covering/documentation/Covering":{"abstract":[],"url":"\/documentation\/covering","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","title":"Covering","kind":"symbol","role":"collection"}}}