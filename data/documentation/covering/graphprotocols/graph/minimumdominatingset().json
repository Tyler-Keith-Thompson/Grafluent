{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumDominatingSet()"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Each connected component is solved alone; a vertex adjacent to all the others of its","type":"text"},{"text":" ","type":"text"},{"text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated","type":"text"},{"text":" ","type":"text"},{"text":"vertex with one possible dominator gets it, and a vertex whose undominated closed","type":"text"},{"text":" ","type":"text"},{"text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees","type":"text"},{"text":" ","type":"text"},{"text":"outright). The search branches on the most-coverage dominator of an undominated vertex with","type":"text"},{"text":" ","type":"text"},{"text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing","type":"text"},{"text":" ","type":"text"},{"text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing","type":"text"},{"text":" ","type":"text"},{"text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the","type":"text"},{"text":" ","type":"text"},{"text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones","type":"text"},{"text":" ","type":"text"},{"text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words.","type":"text"},{"text":" ","type":"text"},{"text":"Exponential in the component size in the worst case; the search does not check for task","type":"text"},{"text":" ","type":"text"},{"text":"cancellation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","symbolKind":"method","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1689"},"title":"minimumDominatingSet()","role":"symbol"},"kind":"symbol","references":{"doc://Covering/documentation/Covering":{"type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"url":"\/documentation\/covering","kind":"symbol","role":"collection","title":"Covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","title":"Graph","kind":"symbol","role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumDominatingSet()"},{"type":"text","text":"."}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","kind":"symbol","role":"symbol","title":"minimumDominatingSet()"},"doc://Covering/documentation/Covering/GraphProtocols":{"type":"topic","url":"\/documentation\/covering\/graphprotocols","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","title":"GraphProtocols","kind":"symbol","role":"collection"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","kind":"symbol","role":"symbol","title":"Vertex"}}}