cumentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","kind":"symbol","role":"symbol","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"title":"Graph","abstract":[],"url":"\/documentation\/covering\/graphprotocols\/graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"type":"topic","kind":"symbol","role":"symbol","title":"Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Covering/documentation/Covering":{"title":"Covering","url":"\/documentation\/covering","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"kind":"symbol","role":"collection","type":"topic"}}}