{"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connected component is solved alone; a vertex adjacent to all the others of its"},{"type":"text","text":" "},{"type":"text","text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated"},{"type":"text","text":" "},{"type":"text","text":"vertex with one possible dominator gets it, and a vertex whose undominated closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood lies in another’s is ruled out (for the lexicographic pass only in favour of"},{"type":"text","text":" "},{"type":"text","text":"a lesser vertex, which keeps the least set; this leaf rule settles paths and many trees"},{"type":"text","text":" "},{"type":"text","text":"outright). The search branches on the most-coverage dominator of an undominated vertex"},{"type":"text","text":" "},{"type":"text","text":"with the fewest left and prunes on the budget, on the largest coverages, and on a greedy"},{"type":"text","text":" "},{"type":"text","text":"2-packing (vertices with no dominator in common, each needing its own; on trees the largest"},{"type":"text","text":" "},{"type":"text","text":"2-packing is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one"},{"type":"text","text":" "},{"type":"text","text":"smaller; the least set of γ vertices is then decided vertex by vertex in index order"},{"type":"text","text":" "},{"type":"text","text":"against a witness, each decision searching only the part of the problem the vertex"},{"type":"text","text":" "},{"type":"text","text":"touches. Sparse components keep O(n + m) words of state; dense ones (mean degree d with d²"},{"type":"text","text":" "},{"type":"text","text":"above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words. Exponential in the"},{"type":"text","text":" "},{"type":"text","text":"component size in the worst case."}]}]}],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"]}],"abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of"},{"type":"text","text":" "},{"type":"text","text":"the smallest such sets it is the lexicographically least by vertex index (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdenti