{"metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","role":"symbol","symbolKind":"method","extendedModule":"GraphProtocols","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1764","fileName":"ExactCovering.swift"},"title":"minimumDominatingSet()","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":"]"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Each connected component is solved alone; a vertex adjacent to all the others of its","type":"text"},{"text":" ","type":"text"},{"text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated","type":"text"},{"text":" ","type":"text"},{"text":"vertex with one possible dominator gets it, and a vertex whose undominated closed","type":"text"},{"text":" ","type":"text"},{"text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees","type":"text"},{"text":" ","type":"text"},{"text":"outright). The search branches on the most-coverage dominator of an undominated vertex with","type":"text"},{"text":" ","type":"text"},{"text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing","type":"text"},{"text":" ","type":"text"},{"text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing","type":"text"},{"text":" ","type":"text"},{"text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the","type":"text"},{"text":" ","type":"text"},{"text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones","type":"text"},{"text":" ","type":"text"},{"text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words.","type":"text"},{"text":" ","type":"text"},{"text":"Exponential in the component size in the worst case; the search does not check for task","type":"text"},{"text":" ","type":"text"},{"text":"cancellation.","type":"text"}]}]}],"abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends","type":"text"},{"text":" ","type":"text"},{"text":"on the search; for one fixed by a rule, see ","type":"text"},{"code":"lexicographicallyFirstMinimumDominatingSet()","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","interfaceLanguage":"swift"},"references":{"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"title":"Vertex","abstract":[],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","type":"topic","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","role":"symbol","abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no"},{"type":"text","text":" "},{"type":"text","text":"smaller set is; in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, [] for the empty graph. Self-loops and parallel edges do"},{"type":"text","text":" "},{"type":"text","text":"not matter; isolated vertices are in it. Deterministic, but which minimum set it is depends"},{"type":"text","text":" "},{"type":"text","text":"on the search; for one fixed by a rule, see "},{"type":"codeVoice","code":"lexicographicallyFirstMinimumDominatingSet()"},{"type":"text","text":"."}],"identifier":"doc:\/\/Co