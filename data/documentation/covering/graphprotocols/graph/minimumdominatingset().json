mumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":"]"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each connected component is solved alone; a vertex adjacent to all the others of its"},{"type":"text","text":" "},{"type":"text","text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated"},{"type":"text","text":" "},{"type":"text","text":"vertex with one possible dominator gets it, and a vertex whose undominated closed"},{"type":"text","text":" "},{"type":"text","text":"neighbourhood lies in another’s is ruled out (a leaf rule that settles paths and many trees"},{"type":"text","text":" "},{"type":"text","text":"outright). The search branches on the most-coverage dominator of an undominated vertex with"},{"type":"text","text":" "},{"type":"text","text":"the fewest left and prunes on the budget, on the largest coverages, and on a greedy 2-packing"},{"type":"text","text":" "},{"type":"text","text":"(vertices with no dominator in common, each needing its own; on trees the largest 2-packing"},{"type":"text","text":" "},{"type":"text","text":"is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one smaller, and the"},{"type":"text","text":" "},{"type":"text","text":"last set found is the answer. Sparse components keep O(n + m) words of state; dense ones"},{"type":"text","text":" "},{"type":"text","text":"(mean degree d with d² above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words."},{"type":"text","text":" "},{"type":"text","text":"Exponential in the component size in the worst case; the search does not check for task"},{"type":"text","text":" "},{"type":"text","text":"cancellation."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"title":"Graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","type":"topic","role":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"kind":"symbol","abstract":[]},"doc://Covering/documentation/Covering":{"type":"topic","kind":"symbol","url":"\/documentation\/covering","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering","role":"collection","title":"Covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"type":"topic","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and no","type":"text"},{"text":" ","type":"text"},{"text":"smaller set is; in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order, [] for the empty graph. Self-loops and parallel edges do","type":"text"},{"text":" ","type":"text"},{"text":"not matter; isolated vertices are