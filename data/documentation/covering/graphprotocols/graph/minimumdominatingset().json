{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"minimumDominatingSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"text":"]","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Each connected component is solved alone; a vertex adjacent to all the others of its","type":"text"},{"text":" ","type":"text"},{"text":"component answers alone. Otherwise branch and reduce: after every choice, an undominated","type":"text"},{"text":" ","type":"text"},{"text":"vertex with one possible dominator gets it, and a vertex whose undominated closed","type":"text"},{"text":" ","type":"text"},{"text":"neighbourhood lies in another’s is ruled out (for the lexicographic pass only in favour of","type":"text"},{"text":" ","type":"text"},{"text":"a lesser vertex, which keeps the least set; this leaf rule settles paths and many trees","type":"text"},{"text":" ","type":"text"},{"text":"outright). The search branches on the most-coverage dominator of an undominated vertex","type":"text"},{"text":" ","type":"text"},{"text":"with the fewest left and prunes on the budget, on the largest coverages, and on a greedy","type":"text"},{"text":" ","type":"text"},{"text":"2-packing (vertices with no dominator in common, each needing its own; on trees the largest","type":"text"},{"text":" ","type":"text"},{"text":"2-packing is γ, Meir and Moon 1975). γ comes from a greedy descent and decisions one","type":"text"},{"text":" ","type":"text"},{"text":"smaller; the least set of γ vertices is then decided vertex by vertex in index order","type":"text"},{"text":" ","type":"text"},{"text":"against a witness, each decision searching only the part of the problem the vertex","type":"text"},{"text":" ","type":"text"},{"text":"touches. Sparse components keep O(n + m) words of state; dense ones (mean degree d with d²","type":"text"},{"text":" ","type":"text"},{"text":"above c ⌈c \/ 64⌉) use bitset closed neighbourhoods, under 2m words. Exponential in the","type":"text"},{"text":" ","type":"text"},{"text":"component size in the worst case.","type":"text"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","title":"minimumDominatingSet()","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P8CoveringE20minimumDominatingSetSay6VertexQzGyF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1846","fileName":"ExactCovering.swift"},"extendedModule":"GraphProtocols","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"symbolKind":"method"},"sections":[],"abstract":[{"text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of","type":"text"},{"text":" ","type":"text"},{"text":"the smallest such sets it is the lexicographically least by vertex index (the rule of","type":"text"},{"text":" ","type":"text"},{"code":"maximumIndependentSet()","type":"codeVoice"},{"text":"), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Self-loops and","type":"text"},{"text":" ","type":"text"},{"text":"parallel edges do not matter; isolated vertices are in it.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()"]}],"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"abstract":[],"type":"topic","title":"Graph","url":"\/documentation\/covering\/graphprotocols\/graph","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols":{"kind":"symbol","title":"GraphProtocols","url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","type":"topic","role":"collection","abstract":[]},"doc://Covering/documentation/Covering":{"kind":"symbol","title":"Covering","url":"\/documentation\/covering","identifier":"doc:\/\/Covering\/documentation\/Covering","type":"topic","role":"collection","abstract":[]},"doc://Covering/documentation/Covering/GraphProtocols/Graph/minimumDominatingSet()":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"minimumDominatingSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/minimumdominatingset()","type":"topic","role":"symbol","title":"minimumDominatingSet()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/minimumDominatingSet()","abstract":[{"type":"text","text":"A minimum dominating set (exact): every vertex is in it or adjacent to one in it, and of"},{"type":"text","text":" "},{"type":"text","text":"the smallest such sets it is the lexicographically least by vertex index (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"), in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Self-loops and"},{"type":"text","text":" "},{"type":"text","text":"parallel edges do not matter; isolated vertices are in it."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"type":"topic","title":"Vertex","url":"\/documentation\/graphprotocols\/graph\/vertex","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"role":"symbol"}}}