{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()"]}],"abstract":[{"type":"text","text":"The lexicographically first maximum independent set: of all the largest ones, the least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"type":"text","text":", so on a loop-free graph this is that clique of the"},{"type":"text","text":" "},{"type":"text","text":"complement). A vertex with a self-loop is never in it; parallel edges count once."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone, since the rule"},{"type":"text","text":" "},{"type":"text","text":"composes across components. A bipartite component costs O(m √n), as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":", whose core pass in index order already gives the least set. A"},{"type":"text","text":" "},{"type":"text","text":"complete component takes its least vertex. Any other component of c vertices is decided"},{"type":"text","text":" "},{"type":"text","text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by"},{"type":"text","text":" "},{"type":"text","text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such"},{"type":"text","text":" "},{"type":"text","text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete handed"},{"type":"text","text":" "},{"type":"text","text":"to the cases above. Each decision the witness cannot answer is one solve of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"‘s kind on what is left of the vertex’s component. So trees with"},{"type":"text","text":" "},{"type":"text","text":"few extra edges, long paths and cycles cost O(c (c + m)) at worst and O(c + m) when the rules"},{"type":"text","text":" "},{"type":"text","text":"settle them, but a component the rules do not settle can cost up to c exponential searches,"},{"type":"text","text":" "},{"type":"text","text":"far more than "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":". Memory O(n + m + k² \/ 64) words for a kernel"},{"type":"text","text":" "},{"type":"text","text":"component of k vertices. The search does not check for task cancellation."}]}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE43lexicographicallyFirstMaximumIndependentSetSay6VertexQzGyF","roleHeading":"Instance Method","title":"lexicographicallyFirstMaximumIndependentSet()","extendedModule":"GraphProtocols","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumIndependentSet","kind":"identifier"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"symbolKind":"method","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1694"},"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()"},"references":{"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"abstract":[],"title":"Graph","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"abstract":[],"title":"Vertex","kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/graph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"role":"symbol"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMaximumIndependentSet()":{"abstract":[{"type":"text","text":"The lexicographically first maximum independent set: of all the largest ones, the least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference (the rule of"},{"type":"text","text":" "},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"type":"text","text":", so on a loop-free graph this is that clique of the"},{"type":"text","text":" "},{"type":"text","text":"complement). A vertex with a self-loop is never in it; parallel edges count once."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","role":"symbol","title":"lexicographicallyFirstMaximumIndependentSet()"},"doc://Covering/documentation/Covering":{"abstract":[],"kind":"symbol","url":"\/documentation\/covering","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering","role":"collection","title":"Covering"},"doc://Covering/documentation/Covering/GraphProtocols":{"abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/covering\/graphprotocols","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","role":"collection","title":"GraphProtocols"}}}