{"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"abstract":[{"text":"The lexicographically first maximum independent set: of all the largest ones, the least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser holds the least vertex of their symmetric difference (the rule of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lexicographicallyFirstMaximumClique()"},{"text":", so on a loop-free graph this is that clique of the","type":"text"},{"text":" ","type":"text"},{"text":"complement). A vertex with a self-loop is never in it; parallel edges count once.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()"},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"externalID":"s:14GraphProtocols0A0P8CoveringE43lexicographicallyFirstMaximumIndependentSetSay6VertexQzGyF","modules":[{"relatedModules":["GraphProtocols"],"name":"Covering"}],"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"extendedModule":"GraphProtocols","role":"symbol","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1694"},"title":"lexicographicallyFirstMaximumIndependentSet()"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone, since the rule"},{"type":"text","text":" "},{"type":"text","text":"composes across components. A bipartite component costs O(m √n), as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":", whose core pass in index order already gives the least set. A"},{"type":"text","text":" "},{"type":"text","text":"complete component takes its least vertex. Any other component of c vertices is decided"},{"type":"text","text":" "},{"type":"text","text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by"},{"type":"text","text":" "},{"type":"text","text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such"},{"type":"text","text":" "},{"type":"text","text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete handed"},{"type":"text","text":" "},{"type":"text","text":"to the cases above. Each decision the witness cannot answer is one solve of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"‘s kind on what is left of the vertex’s component. So trees with"},{"type":"text","text":" "},{"type":"text","text":"few extra edges, long paths and cycles cost O(c (c + m)) at worst and O(c + m) when the rules"},{"type":"text","text":" "},{"type":"text","text":"settle them, but a component the rules do not settle can cost up to c exponential searches,"},{"type":"text","text":" "},{"type":"text","text":"far more than "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":". Memory O(n + m + k² \/ 64) words for a kernel"},{"type":"text","text":" "},{"type":"text","text":"component of k vertices. The search does not check for task cancellation."}]}]}],"references":{"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","kind":"symbol","title":"GraphProtocols","abstract":[],"role":"collection","type":"topic","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMaximumIndependentSet()":{"kind":"symbol","type":"topic","abstract":[{"text":"The lexicographically first maximum independent set: of all the largest ones, the least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser holds the least vertex of their symmetric difference (the rule of","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":", so on a loop-free graph this is that clique of the","type":"text"},{"text":" ","type":"text"},{"text":"complement). A vertex with a self-loop is never in it; parallel edges count once.","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()","title":"lexicographicallyFirstMaximumIndependentSet()","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"title":"Vertex","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","kind":"symbol","title":"Graph","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols0A0P"}],"role":"symbol","type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"},"doc://Covering/documentation/Covering":{"abstract":[],"url":"\/documentation\/covering","type":"topic","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering","role":"collection","title":"Covering"}}}