{"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","interfaceLanguage":"swift"},"metadata":{"title":"lexicographicallyFirstMaximumIndependentSet()","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1694"},"externalID":"s:14GraphProtocols0A0P8CoveringE43lexicographicallyFirstMaximumIndependentSetSay6VertexQzGyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"roleHeading":"Instance Method","extendedModule":"GraphProtocols","modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"symbolKind":"method","role":"symbol"},"kind":"symbol","sections":[],"abstract":[{"text":"The lexicographically first maximum independent set: of all the largest ones, the least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser holds the least vertex of their symmetric difference (the rule of","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":", so on a loop-free graph this is that clique of the","type":"text"},{"text":" ","type":"text"},{"text":"complement). A vertex with a self-loop is never in it; parallel edges count once.","type":"text"}],"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"kind":"text","text":"]"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Looped vertices are removed and each connected component solved alone, since the rule"},{"type":"text","text":" "},{"type":"text","text":"composes across components. A bipartite component costs O(m √n), as in"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":", whose core pass in index order already gives the least set. A"},{"type":"text","text":" "},{"type":"text","text":"complete component takes its least vertex. Any other component of c vertices is decided"},{"type":"text","text":" "},{"type":"text","text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by"},{"type":"text","text":" "},{"type":"text","text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such"},{"type":"text","text":" "},{"type":"text","text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete handed"},{"type":"text","text":" "},{"type":"text","text":"to the cases above. Each decision the witness cannot answer is one solve of"},{"type":"text","text":" "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":"‘s kind on what is left of the vertex’s component. So trees with"},{"type":"text","text":" "},{"type":"text","text":"few extra edges, long paths and cycles cost O(c (c + m)) at worst and O(c + m) when the rules"},{"type":"text","text":" "},{"type":"text","text":"settle them, but a component the rules do not settle can cost up to c exponential searches,"},{"type":"text","text":" "},{"type":"text","text":"far more than "},{"type":"codeVoice","code":"maximumIndependentSet()"},{"type":"text","text":". Memory O(n + m + k² \/ 64) words for a kernel"},{"type":"text","text":" "},{"type":"text","text":"component of k vertices. The search does not check for task cancellation."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Covering/documentation/Covering/GraphProtocols":{"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","abstract":[],"type":"topic","kind":"symbol","title":"GraphProtocols","url":"\/documentation\/covering\/graphprotocols","role":"collection"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols0A0P","text":"Graph","kind":"identifier"}],"title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"role":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"title":"Vertex","abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","kind":"symbol","url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMaximumIndependentSet()":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"title":"lexicographicallyFirstMaximumIndependentSet()","abstract":[{"type":"text","text":"The lexicographically first maximum independent set: of all the largest ones, the least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"text":"lesser holds the least vertex of their symmetric difference (the rule of","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":", so on a loop-free graph this is that clique of the","type":"text"},{"text":" ","type":"text"},{"text":"complement). A vertex with a self-loop is never in it; parallel edges count once.","type":"text"}],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","kind":"symbol","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()","type":"topic"},"doc://Covering/documentation/Covering":{"identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"type":"topic","kind":"symbol","title":"Covering","url":"\/documentation\/covering","role":"collection"}}}