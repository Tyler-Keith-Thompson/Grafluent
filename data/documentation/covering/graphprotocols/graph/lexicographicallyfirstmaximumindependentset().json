{"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Instance Method","extendedModule":"GraphProtocols","symbolKind":"method","remoteSource":{"fileName":"ExactCovering.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Covering\/ExactCovering.swift#L1644"},"modules":[{"name":"Covering","relatedModules":["GraphProtocols"]}],"externalID":"s:14GraphProtocols0A0P8CoveringE43lexicographicallyFirstMaximumIndependentSetSay6VertexQzGyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"title":"lexicographicallyFirstMaximumIndependentSet()"},"variants":[{"paths":["\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Covering\/documentation\/Covering","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph"]]},"abstract":[{"type":"text","text":"The lexicographically first maximum independent set: of all the largest ones, the least by"},{"type":"text","text":" "},{"type":"text","text":"vertex index, in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order; [] for the empty graph. Of two sets of one size, the"},{"type":"text","text":" "},{"type":"text","text":"lesser holds the least vertex of their symmetric difference (the rule of"},{"type":"text","text":" "},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"type":"text","text":", so on a loop-free graph this is that clique of the"},{"type":"text","text":" "},{"type":"text","text":"complement). A vertex with a self-loop is never in it; parallel edges count once."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicographicallyFirstMaximumIndependentSet","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex"},{"text":"]","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Looped vertices are removed and each connected component solved alone, since the rule","type":"text"},{"text":" ","type":"text"},{"text":"composes across components. A bipartite component costs O(m √n), as in","type":"text"},{"text":" ","type":"text"},{"code":"maximumIndependentSet()","type":"codeVoice"},{"text":", whose core pass in index order already gives the least set. A","type":"text"},{"text":" ","type":"text"},{"text":"complete component takes its least vertex. Any other component of c vertices is decided","type":"text"},{"text":" ","type":"text"},{"text":"vertex by vertex in index order against a witness maximum set, shrunk between decisions by","type":"text"},{"text":" ","type":"text"},{"text":"rules that keep the least set (an isolated vertex is taken; so is a simplicial vertex, such","type":"text"},{"text":" ","type":"text"},{"text":"as a leaf, less than all its neighbours), with pieces that turn bipartite or complete handed","type":"text"},{"text":" ","type":"text"},{"text":"to the cases above. Each decision the witness cannot answer is one solve of","type":"text"},{"text":" ","type":"text"},{"code":"maximumIndependentSet()","type":"codeVoice"},{"text":"‘s kind on what is left of the vertex’s component. So trees with","type":"text"},{"text":" ","type":"text"},{"text":"few extra edges, long paths and cycles cost O(c (c + m)) at worst and O(c + m) when the rules","type":"text"},{"text":" ","type":"text"},{"text":"settle them, but a component the rules do not settle can cost up to c exponential searches,","type":"text"},{"text":" ","type":"text"},{"text":"far more than ","type":"text"},{"code":"maximumIndependentSet()","type":"codeVoice"},{"text":". Memory O(n + m + k² \/ 64) words for a kernel","type":"text"},{"text":" ","type":"text"},{"text":"component of k vertices. The search does not check for task cancellation.","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://Covering/documentation/Covering":{"role":"collection","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering","abstract":[],"type":"topic","title":"Covering","url":"\/documentation\/covering"},"doc://Covering/documentation/Covering/GraphProtocols/Graph/lexicographicallyFirstMaximumIndependentSet()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph\/lexicographicallyFirstMaximumIndependentSet()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicographicallyFirstMaximumIndependentSet"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa"},{"kind":"text","text":"]"}],"abstract":[{"text":"The lexicographically first maximum independent set: of all the largest ones, the least by","type":"text"},{"text":" ","type":"text"},{"text":"vertex index, in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order; [] for the empty graph. Of two sets of one size, the","type":"text"},{"text":" ","type":"text"},{"text":"lesser holds the least vertex of their symmetric difference (the rule of","type":"text"},{"text":" ","type":"text"},{"code":"lexicographicallyFirstMaximumClique()","type":"codeVoice"},{"text":", so on a loop-free graph this is that clique of the","type":"text"},{"text":" ","type":"text"},{"text":"complement). A vertex with a self-loop is never in it; parallel edges count once.","type":"text"}],"type":"topic","title":"lexicographicallyFirstMaximumIndependentSet()","url":"\/documentation\/covering\/graphprotocols\/graph\/lexicographicallyfirstmaximumindependentset()"},"doc://Covering/documentation/Covering/GraphProtocols":{"url":"\/documentation\/covering\/graphprotocols","type":"topic","abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols","kind":"symbol","role":"collection","title":"GraphProtocols"},"doc://Covering/documentation/Covering/GraphProtocols/Graph":{"url":"\/documentation\/covering\/graphprotocols\/graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"type":"topic","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14GraphProtocols0A0P","kind":"identifier","text":"Graph"}],"abstract":[],"identifier":"doc:\/\/Covering\/documentation\/Covering\/GraphProtocols\/Graph","kind":"symbol","role":"symbol","title":"Graph"},"doc://GraphProtocols/documentation/GraphProtocols/Graph/Vertex":{"url":"\/documentation\/graphprotocols\/graph\/vertex","type":"topic","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph\/Vertex","abstract":[],"kind":"symbol","role":"symbol","title":"Vertex"}}}