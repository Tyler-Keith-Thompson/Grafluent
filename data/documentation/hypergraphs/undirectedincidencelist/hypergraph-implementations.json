): the connected components of "},{"type":"codeVoice","code":"lineGraph(s:)"},{"type":"text","text":", as positions, without building"},{"type":"text","text":" "},{"type":"text","text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]]"}],"title":"sConnectedComponents(s:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/sConnectedComponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/isConnected":{"abstract":[{"text":"Whether there is exactly one connected component: false with no vertices (the library’s","type":"text"},{"text":" ","type":"text"},{"text":"rule; XGI raises). O(n + p α(n)).","type":"text"}],"title":"isConnected","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/isConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb"