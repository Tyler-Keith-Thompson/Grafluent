text":"’s set of hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"the dual is always defined; ","type":"text"},{"code":"dual().dual()","type":"codeVoice"},{"text":" is this hypergraph with its vertices relabeled","type":"text"},{"text":" ","type":"text"},{"text":"to their indices and its positions kept.","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/dual()","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/dual()","role":"symbol","type":"topic","title":"dual()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/cliqueExpansion()":{"title":"cliqueExpansion()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/cliqueExpansion()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedAdjacencyList","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"type