tices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"title":"connectedComponents()","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/connectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]]"}],"role":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/connectedcomponents()","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/rank":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/rank","type":"topic","abstract":[{"text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m).","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rank","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"rank","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/rank"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/neighbors(of:)":{"abstract":[{"text":"The vertices that share a hyperedge with ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":", each once, in vertex-index order, never","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":" itself (XGI’s ","type":"text"},{"type":"codeVoice","code":"nodes.neighbors"},{"text":").","type":"text"}],"title":"neighbors(of:)","type":"topic","identifier":"doc:\/\/Hypergraphs\/doc