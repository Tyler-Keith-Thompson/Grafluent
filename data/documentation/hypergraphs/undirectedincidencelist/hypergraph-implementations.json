 ","type":"text"},{"text":"edge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":"–","type":"text"},{"type":"codeVoice","code":"q"},{"text":" (","type":"text"},{"type":"codeVoice","code":"p < q"},{"text":") when the two hyperedges share at least ","type":"text"},{"type":"codeVoice","code":"s"},{"text":" members. An empty","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge, or one sharing fewer than ","type":"text"},{"type":"codeVoice","code":"s"},{"text":" members with every other, is isolated. Edges ascend","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"type":"codeVoice","code":"(p, q)"},{"text":".","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/lineGraph(s:)","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/connectedComponents()":{"type":"topic","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/connectedcomponents()","title":"connectedComponents()","abstract":[{"text":"The connected components: two vertices are together when a chain of hyperedges joins them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are ordered by their least vertex index and list their vertices in index order;","type":"text"},{"text":" ","type":"text"},{"text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no","type":"text"},{"text":" ","type":"text"},{"text":"components.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]]"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/connectedComponents()"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/incidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/incidenceGraphView","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraphView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"IncidenceGraphView","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"incidenceGraphView","abstract":[{"type":"text","text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the"},{"type":"text","text":" "},{"type":"text","text":"Levi graph), as a lazy "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":": vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"each incidence is an edge. Graph algorithms reach a hypergraph through it."}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/incidencegraphview","role":"symbol","kind":"symbol","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList":{"abstract":[{"text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a","type":"text"},{"text":" ","type":"text"},{"text":"row per vertex of its memberships. The undirected counterpart of ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":".","type":"text"}],"title":"UndirectedIncidenceList","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"