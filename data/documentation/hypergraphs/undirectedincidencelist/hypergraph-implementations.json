 share a hyperedge with "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", each once, in vertex-index order, never"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" itself (XGI’s "},{"type":"codeVoice","code":"nodes.neighbors"},{"type":"text","text":")."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/neighbors(of:)","title":"neighbors(of:)"},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","role":"collection","url":"\/documentation\/hypergraphs","type":"topic","title":"Hypergraphs","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/degreeHistogram()":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/degreehistogram()","kind":"symbol","role":"symbol","title":"degreeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/degreeHistogram()","abstract":[{"text":"Element ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" counts the vertices of degree ","type":"text"},{"code":"d","type":"codeVoice"},{"text":", up to the greatest degree; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no","type":"text"},{"text":" ","type":"text"},{"text":"vertices (NetworkX’s ","type":"text"},{"code":"degree_histogram","type":"codeVoice"},{"text":" shape). O(n).","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/incidenceGraph":{"role":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/incidencegraph","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/incidenceGraph","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraph"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","kind":"typeIdentifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"incidenceGraph","abstract":[{"type":"text","text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the"},{"type":"text","text":" "},{"type":"text","text":"Levi graph), as a lazy "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":": vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"each incidence is an edge, XGI’s "},{"type":"codeVoice","code":"to_bipartite_graph"},{"type":"text","text":" numbering. Graph algorithms reach a"},{"type":"text","text":" "},{"type":"text","text":"hypergraph through it."}],"type":"topic","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList":{"type":"topic","url":"\/documentation\/hypergraphs\/undirectedincidencelist","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","abstract":[{"type":"text","text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a"},{"type":"text","text":" "},{"type":"text","text":"row per vertex of its memberships. The undirected counterpart of "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", named as"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":" is. ("},{"type":"codeVoice","code":"Inc