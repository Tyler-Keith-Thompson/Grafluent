ypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/cliqueexpansion()","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/dual()":{"role":"symbol","title":"dual()","abstract":[{"text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph’s positions, in order, and its hyperedge ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"’s set of hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"the dual is always defined; ","type":"text"},{"code":"dual().dual()","type":"codeVoice"},{"text":" is this hypergraph with its vertices relabeled","type":"text"},{"text":" ","type":"text"},{"text":"to their indices and its positions kept.","type":"text"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/dual()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/dual()"}}}