":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/hyperedgeSizeHistogram()":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/hyperedgesizehistogram()","type":"topic","abstract":[{"text":"Element ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" counts the hyperedges of size ","type":"text"},{"code":"k","type":"codeVoice"},{"text":", up to the rank; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"O(m).","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hyperedgeSizeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"]"}],"title":"hyperedgeSizeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/hyperedgeSizeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/isUniform(size:)":{"abstract":[{"type":"text","text":"Whether every hyperedge has exactly "},{"type":"codeVoice","code":"size"},{"type":"text","text":" members (Berge’s k-uniform). Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges count (XGI’s "},{"type":"codeVoice","code":"is_uniform"},{"type":"text","text":" ignores singletons); vacuously true with no"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. O(m)."}],"title":"isUniform(size:)","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/isUniform(size:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUniform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"role":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/isuniform(size:)","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/degreeHistogram()":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/degreehistogram()","type":"topic","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices of degree "},{"type":"codeVoice","code":"d"},{"type":"text","text":", up to the greatest degree; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"vertices (NetworkX’s "},{"type":"codeVoice","code":"degree_histogram"},{"type":"text","text":" shape). O(n)."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"degreeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/degreeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs