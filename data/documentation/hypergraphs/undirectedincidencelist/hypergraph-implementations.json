stract":[{"text":"The hyperedge s-components (Aksoy et al. 2020; HyperNetX’s ","type":"text"},{"type":"codeVoice","code":"s_connected_components"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"edges=True"},{"text":"): the connected components of ","type":"text"},{"type":"codeVoice","code":"lineGraph(s:)"},{"text":", as positions, without building","type":"text"},{"text":" ","type":"text"},{"text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own","type":"text"},{"text":" ","type":"text"},{"text":"component, and components are ordered by their least position, each ascending. The vertex","type":"text"},{"text":" ","type":"text"},{"text":"s-components are ","type":"text"},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"text":".","type":"text"}],"title":"sConnectedComponents(s:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]]"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/sconnectedcomponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/hyperedgeSizeHistogram()":{"type":"topic","title":"hyperedgeSizeHistogram()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedgeSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"text":"Element ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" counts the hyperedges of size ","type":"text"},{"code":"k","type":"codeVoice"},{"text":", up to the rank; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"O(m).","type":"text"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/hyperedgesizehistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/hyperedgeSizeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/lineGraph(s:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/lineGraph(s:)","type":"topic","title":"lineGraph(s:)","abstract":[{"type":"text","text":"The s-line graph (Aksoy et al. 2020; XGI’s "},{"type":"codeVoice","code":"to_line_graph(H, s)"},{"type":"text","text":", HyperNetX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"get_linegraph"},{"type":"text","text":"): every position "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" as a vertex, in order, and an edge "},{"type":"codeVoice","code":"p"},{"type":"text","text":"–"},{"type":"codeVoice","code":"q"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"p < q"},{"type":"text","text":") when the two hyperedges share at least "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members. An empty hyperedge, or one"},{"type":"text","text":" "},{"type":"text","text":"sharing fewer than "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members with every other, is isolated. Edges ascend by "},{"type":"codeVoice","code":"(p, q)"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"exte