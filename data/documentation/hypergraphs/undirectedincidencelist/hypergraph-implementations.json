nd an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/dual()"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/rank":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/rank","type":"topic","abstract":[{"text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m).","type":"text"}],"title":"rank","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rank"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/rank"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/cliqueExpansion()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/cliqueExpansion()","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/cliqueexpansion()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UndirectedAdjacencyList","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The clique expansion (XGI’s "},{"code":"to_graph","type":"codeVoice"},{"type":"text","text":", Berge’s 2-section): every vertex, isolated ones"},{"type":"text","text":" "},{"type":"text","text":"included, in vertex-index order, and an edge between every two vertices that share a"},{"type":"text","text":" "},{"type":"text","text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower."},{"type":"text","text":" "},{"type":"text","text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members"},{"type":"text","text":" "},{"type":"text","text":"is k(k − 1)\/2 edges."}],"title":"cliqueExpansion()","kind":"symbol","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/isConnected":{"type":"topic","title":"isConnected","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"kind":"symbol","abstract":[{"type":"text","text":"Whether there is exactly one connected component: false with no vertices (the library’s"},{"type":"text","text":" "},{"type":"text","text":"rule; XGI raises). O(n + p α(n))."}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/isconnected","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/isConnected"}}}