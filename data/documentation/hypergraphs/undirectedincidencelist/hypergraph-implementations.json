 ones included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order, and an edge between every two vertices that share a hyperedge, once,"},{"type":"text","text":" "},{"type":"text","text":"with no self-loops. Edges ascend by (index of u, index of v), u the lower. Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members is k(k − 1)\/2"},{"type":"text","text":" "},{"type":"text","text":"edges."}]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/degreeHistogram()":{"kind":"symbol","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices of degree "},{"type":"codeVoice","code":"d"},{"type":"text","text":", up to the greatest degree; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"vertices. O(n)."}],"title":"degreeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/degreeHistogram()","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/degreehistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/isConnected":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/isConnected","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/isconnected","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Whether there is exactly one connected component: false with no vertices. O(n + p α(n))."}],"title":"isConnected"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/isUniform(size:)":{"kind":"symbol","abstract":[{"text":"Whether every hyperedge has exactly ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" members (Berge’s k-uniform). Singletons and","type":"text"},{"text":" ","type":"text"},{"text":"empty hyperedges count; vacuously true with no hyperedges. O(m).","type":"text"}],"title":"isUniform(size:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/isUniform(size:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUniform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/isuniform(size:)"},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs","url":"\/documentation\/hypergraphs","abstract":[],"kind":"symbol","type":"topic","role":"collection"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/connectedComponents()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/connectedComponents()","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/connectedcomponents()","type":"topic","role":"symbol","title":"connectedComponents()","abstract":[{"type":"text","text":"The connected components: two vertices are together when a chain of hyperedges joins them."},{"type":"text","text":" "},{"type":"text","text":"Components are ordered by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/incidenceGraphView":{"kind":"symbol","abstract":[{"text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the","type":"text"},{"text":" ","type":"text"},{"text":"Levi graph), as a lazy ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":": vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":", ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"each incidence is an edge. Graph algorithms reach a hypergraph through it.","type":"text"}],"title":"incidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/incidenceGraphView","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraphView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"IncidenceGraphView","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/incidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/lineGraph(s:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineGraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/lineGraph(s:)","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/linegraph(s:)","type":"topic","role":"symbol","abstract":[{"text":"The s-line graph (Aksoy et al. 2020): every position ","type":"text"},{"code":"0..<m","type":"codeVoice"},{"text":" as a vertex, in order, and an","type":"text"},{"text":" ","type":"text"},{"text":"edge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":"–","type":"text"},{"code":"q","type":"codeVoice"},{"text":" (","type":"text"},{"code":"p < q","type":"codeVoice"},{"text":") when the two hyperedges share at least ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" members. An empty","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge, or one sharing fewer than ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" members with every other, is isolated. Edges ascend","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"(p, q)","type":"codeVoice"},{"text":".","type":"text"}],"title":"lineGraph(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/dual()":{"kind":"symbol","abstract":[{"text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph’s positions, in order, and its hyperedge ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" is vertex ","type":"text"},{"type":"codeVoice","code":"i"},{"text":"’s set of hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"the dual is always defined; ","type":"text"},{"type":"codeVoice","code":"dual().dual()"},{"text":" is this hypergraph with its vertices relabeled","type":"text"},{"text":" ","type":"text"},{"text":"to their indices and its positions kept.","type":"text"}],"title":"dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/dual()","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","kind":"typeIdentifier","text":"UndirectedIncidenceList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/dual()"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/sConnectedComponents(s:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]]"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/sConnectedComponents(s:)","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/sconnectedcomponents(s:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020): the connected components of "},{"code":"lineGraph(s:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as positions, without building it. Singletons are kept, an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"code":"dual().sConnectedComponents(s:)","type":"codeVoice"},{"type":"text","text":"."}],"title":"sConnectedComponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/rank":{"kind":"symbol","abstract":[{"text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m).","type":"text"}],"title":"rank","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/rank","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rank","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/rank"}}}