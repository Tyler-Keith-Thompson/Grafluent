{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/isUniform(size:)":{"role":"symbol","kind":"symbol","title":"isUniform(size:)","abstract":[{"text":"Whether every hyperedge has exactly ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" members (Berge’s k-uniform). Singletons and","type":"text"},{"text":" ","type":"text"},{"text":"empty hyperedges count; vacuously true with no hyperedges. O(m).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUniform","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/isUniform(size:)","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/isuniform(size:)"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/incidenceGraphView":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/incidencegraphview","abstract":[{"type":"text","text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the"},{"type":"text","text":" "},{"type":"text","text":"Levi graph), as a lazy "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":": vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"each incidence is an edge. Graph algorithms reach a hypergraph through it."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraphView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","text":"IncidenceGraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","kind":"symbol","type":"topic","title":"incidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/incidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/cliqueExpansion()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UndirectedAdjacencyList","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/cliqueExpansion()","abstract":[{"type":"text","text":"The clique expansion (Berge’s 2-section): every vertex, isolated ones included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order, and an edge between every two vertices that share a hyperedge, once,"},{"type":"text","text":" "},{"type":"text","text":"with no self-loops. Edges ascend by (index of u, index of v), u the lower. Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members is k(k − 1)\/2"},{"type":"text","text":" "},{"type":"text","text":"edges."}],"title":"cliqueExpansion()","type":"topic","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/cliqueexpansion()","kind":"symbol","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/connectedComponents()":{"abstract":[{"type":"text","text":"The connected components: two vertices are together when a chain of hyperedges joins them."},{"type":"text","text":" "},{"type":"text","text":"Components are ordered by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"title":"connectedComponents()","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]]"}],"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/connectedcomponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/connectedComponents()"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/rank":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/rank","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rank"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m)."}],"title":"rank","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/rank","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/sConnectedComponents(s:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":"]]","kind":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/sConnectedComponents(s:)","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020): the connected components of "},{"type":"codeVoice","code":"lineGraph(s:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as positions, without building it. Singletons are kept, an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}],"title":"sConnectedComponents(s:)","kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/sconnectedcomponents(s:)","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/isConnected":{"role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/isconnected","type":"topic","title":"isConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/isConnected","abstract":[{"type":"text","text":"Whether there is exactly one connected component: false with no vertices. O(n + p α(n))."}]},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","abstract":[],"type":"topic","kind":"symbol","role":"collection","title":"Hypergraphs","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","navigatorTitle":[{"text":"UndirectedIncidenceList","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a"},{"type":"text","text":" "},{"type":"text","text":"row per vertex of its memberships. The undirected counterpart of "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"UndirectedIncidenceList","url":"\/documentation\/hypergraphs\/undirectedincidencelist"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/hyperedgeSizeHistogram()":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/hyperedgesizehistogram()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedgeSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"k"},{"type":"text","text":" counts the hyperedges of size "},{"type":"codeVoice","code":"k"},{"type":"text","text":", up to the rank; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no hyperedges."},{"type":"text","text":" "},{"type":"text","text":"O(m)."}],"kind":"symbol","title":"hyperedgeSizeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/hyperedgeSizeHistogram()","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/dual()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","kind":"typeIdentifier","text":"UndirectedIncidenceList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/dual()","abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges."},{"type":"text","text":" "},{"type":"text","text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so"},{"type":"text","text":" "},{"type":"text","text":"the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this hypergraph with its vertices relabeled"},{"type":"text","text":" "},{"type":"text","text":"to their indices and its positions kept."}],"title":"dual()","type":"topic","kind":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/dual()","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/lineGraph(s:)":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/linegraph(s:)","abstract":[{"type":"text","text":"The s-line graph (Aksoy et al. 2020): every position "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" as a vertex, in order, and an"},{"type":"text","text":" "},{"type":"text","text":"edge "},{"type":"codeVoice","code":"p"},{"type":"text","text":"–"},{"type":"codeVoice","code":"q"},{"type":"text","text":" ("},{"type":"codeVoice","code":"p < q"},{"type":"text","text":") when the two hyperedges share at least "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members. An empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge, or one sharing fewer than "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members with every other, is isolated. Edges ascend"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"(p, q)"},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","text":"UndirectedAdjacencyList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","kind":"symbol","type":"topic","title":"lineGraph(s:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/lineGraph(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/neighbors(of:)":{"url":"\/documentation\/hypergraphs\/undirectedincidencelist\/neighbors(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neighbors","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":"]","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The vertices that share a hyperedge with "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":", each once, in vertex-index order, never"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertex"},{"type":"text","text":" itself."}],"kind":"symbol","title":"neighbors(of:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/neighbors(of:)","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/degreeHistogram()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"degreeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/degreeHistogram()","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices of degree "},{"type":"codeVoice","code":"d"},{"type":"text","text":", up to the greatest degree; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"vertices. O(n)."}],"title":"degreeHistogram()","kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/degreehistogram()","role":"symbol"}}}