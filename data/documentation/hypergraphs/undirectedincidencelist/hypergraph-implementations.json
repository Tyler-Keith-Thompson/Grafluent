oc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/cliqueExpansion()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedAdjacencyList","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/cliqueexpansion()","title":"cliqueExpansion()","abstract":[{"type":"text","text":"The clique expansion (XGI’s "},{"code":"to_graph","type":"codeVoice"},{"type":"text","text":", Berge’s 2-section): every vertex, isolated ones"},{"type":"text","text":" "},{"type":"text","text":"included, in vertex-index order, and an edge between every two vertices that share a"},{"type":"text","text":" "},{"type":"text","text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower."},{"type":"text","text":" "},{"type":"text","text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members"},{"type":"text","text":" "},{"type":"text","text":"is k(k − 1)\/2 edges."}],"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/cliqueExpansion()","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/incidenceGraphView":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraphView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"IncidenceGraphView","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"incidenceG