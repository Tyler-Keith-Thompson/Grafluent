type":"text","text":"vertices it has. Every vertex-space read hashes its vertex once; index-space reads and the"},{"type":"text","text":" "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms hash none."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Hyperedges can be appended but not removed. Equality ignores the order of the vertices and of"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps from the vertices and the hyperedges to values can be attached ("},{"code":"PropertyGraph","type":"codeVoice"},{"type":"text","text":"): a"},{"type":"text","text":" "},{"type":"text","text":"vertex map is read by vertex index or by vertex, an edge map by hyperedge position."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/hypergraphs\/undirectedincidencelist"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList"},"metadata":{"symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"Hypergraphs"}],"externalID":"s:11Hypergraphs23UndirectedIncidenceListV","remoteSource":{"fileName":"UndirectedIncidenceList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/UndirectedIncidenceList.swift#L26"},"navigatorTitle":[{"text":"UndirectedIncidenceList","kind":"identifier"}],"role":"symbol","title":"UndirectedIncidenceList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"identifier"}]},"references":{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/init(_:)":{"kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP","text":"Hyper