{"abstract":[{"type":"text","text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a"},{"type":"text","text":" "},{"type":"text","text":"row per vertex of its memberships. The undirected counterpart of "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList"},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"title":"UndirectedIncidenceList","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"identifier"}],"role":"symbol","remoteSource":{"fileName":"UndirectedIncidenceList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/UndirectedIncidenceList.swift#L26"},"symbolKind":"struct","externalID":"s:11Hypergraphs23UndirectedIncidenceListV","modules":[{"name":"Hypergraphs"}],"navigatorTitle":[{"kind":"identifier","text":"UndirectedIncidenceList"}],"roleHeading":"Structure"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/undirectedincidencelist"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The vertices are any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values, kept in an ","type":"text"},{"code":"OrderedSet","type":"codeVoice"},{"text":" whose element ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":": the vertices listed first, then new members by first appearance. A hyperedge is a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included; repeated hyperedges are kept, each at its","type":"text"},{"text":" ","type":"text"},{"text":"own position ","type":"text"},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"text":", and a member listed twice is stored once. Members are stored","type":"text"},{"text":" ","type":"text"},{"text":"in vertex-index order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is compressed sparse rows: the members of every hyperedge in one array, and for every"},{"type":"text","text":" "},{"type":"text","text":"vertex its incidence numbers and, beside them, its hyperedge positions, in rows of shared"},{"type":"text","text":" "},{"type":"text","text":"pools. "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" are stored "},{"type":"codeVoice","code":"ArraySlice<Int>"},{"type":"text","text":" rows"},{"type":"text","text":" "},{"type":"text","text":"read without hashing, and the hypergraph makes a constant number of allocations however many"},{"type":"text","text":" "},{"type":"text","text":"vertices it has. Every vertex-space read hashes its vertex once; index-space reads and the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms hash none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hyperedges can be appended but not removed. Equality ignores the order of the vertices and of"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges."}]},{"type":"paragraph","inlineContent":[{"text":"Maps from the vertices and the hyperedges to values can be attached (","type":"text"},{"code":"PropertyGraph","type":"codeVoice"},{"text":"): a","type":"text"},{"text":" ","type":"text"},{"text":"vertex map is read by vertex index or by vertex, an edge map by hyperedge position.","type":"text"}]}]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init()","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(hyperedges:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(vertices:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(vertices:hyperedges:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/degree(checked:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/incidentHyperedges(checked:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/insert(_:)","doc:\/\/Hyp