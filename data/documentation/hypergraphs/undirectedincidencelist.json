{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/undirectedincidencelist"]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The vertices are any ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" values, kept in an ","type":"text"},{"code":"OrderedSet","type":"codeVoice"},{"text":" whose element ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":": the vertices listed first, then new members by first appearance, as ","type":"text"},{"code":"LabeledGraph","type":"codeVoice"},{"text":" ","type":"text"},{"text":"assigns them. A hyperedge is a set of vertices of any size, the empty set included; repeated","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges are kept, each at its own position ","type":"text"},{"code":"0..<hyperedgeCount","type":"codeVoice"},{"text":", and a member listed twice","type":"text"},{"text":" ","type":"text"},{"text":"is stored once. Members are stored in vertex-index order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Storage is compressed sparse rows: the members of every hyperedge in one array, and for every","type":"text"},{"text":" ","type":"text"},{"text":"vertex its incidence numbers and, beside them, its hyperedge positions, in rows of shared","type":"text"},{"text":" ","type":"text"},{"text":"pools. So ","type":"text"},{"type":"codeVoice","code":"memberIndices"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"text":" are stored ","type":"text"},{"type":"codeVoice","code":"ArraySlice<Int>"},{"text":" rows","type":"text"},{"text":" ","type":"text"},{"text":"read without hashing, and the","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph makes a constant number of allocations however many vertices it has. Every","type":"text"},{"text":" ","type":"text"},{"text":"vertex-space read hashes its vertex once; index-space reads and the ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" algorithms","type":"text"},{"text":" ","type":"text"},{"text":"hash none.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Hyperedges can be appended but not removed (removal, and with it a decision on positions, is","type":"text"},{"text":" ","type":"text"},{"text":"left for later). Equality ignores the order of the vertices and of the hyperedges.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init()","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(hyperedges:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(vertices:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(vertices:hyperedges:)"]},{"title":"Instance