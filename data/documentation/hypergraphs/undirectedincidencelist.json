":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"The vertices are any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" values, kept in an ","type":"text"},{"type":"codeVoice","code":"OrderedSet"},{"text":" whose element ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" is vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":": the vertices listed first, then new members by first appearance. A hyperedge is a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included; repeated hyperedges are kept, each at its","type":"text"},{"text":" ","type":"text"},{"text":"own position ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":", and a member listed twice is stored once. Members are stored","type":"text"},{"text":" ","type":"text"},{"text":"in vertex-index order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storage is compressed sparse rows: the members of every hyperedge in one array, and for every"},{"type":"text","text":" "},{"type":"text","text":"vertex its incidence numbers and, beside them, its hyperedge positions, in rows of shared"},{"type":"text","text":" "},{"type":"text","text":"pools. "},{"code":"memberIndices","type":"codeVoice"},{"type":"text","text":" and "},{"code":"incidentHyperedges(ofIndex:)","type":"codeVoice"},{"type":"text","text":" are stored "},{"code":"ArraySlice<Int>","typ