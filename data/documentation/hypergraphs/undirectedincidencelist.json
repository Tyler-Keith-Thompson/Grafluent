ons","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Hashable-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Hypergraph-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Hypergraph-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"metadata":{"symbolKind":"struct","title":"UndirectedIncidenceList","externalID":"s:11Hypergraphs23UndirectedIncidenceListV","navigatorTitle":[{"kind":"identifier","text":"UndirectedIncidenceList"}],"modules":[{"name":"Hypergraphs"}],"remoteSource":{"fileName":"UndirectedIncidenceList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/UndirectedIncidenceList.swift#L27"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"}],"roleHeading":"Structure","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"abstract":[{"type":"text","text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a"},{"type":"text","text":" "},{"type":"text","text":"row per vertex of its memberships. The undirected counterpart of "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", named as"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"type":"text","text":" is. ("},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", the bit-matrix representation, is the"},{"type":"text","text":" "},{"type":"text","text":"undirected one of its pair, because “oriented incidence matrix” is the established name of the"},{"type":"text","text":" "},{"type":"text","text":"other.)"}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/undirectedincidencelist"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices are any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values, kept in an "},{"type":"codeVoice","code":"OrderedSet"},{"type":"text","text":" whose element "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":": the vertices listed first, then new members by first appearance, as "},{"type":"codeVoice","code":"LabeledGraph"},{"type":"text","text":" "},{"type":"text","text":"assigns them. A hyperedge is a set of vertices of any size, the empty set included; repeated"},{"type":"text","text":" "},{"type":"text","text":"hyperedges are kept, each at its own position "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":", and a member listed twice"},{"type":"text","text":" "},{"type":"text","text":"is stored once. Members are stored in vertex-index order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is compressed sparse rows: the members of every hyperedge in one array, and for every"},{"type":"text","text":" "},{"type":"text","text":"vertex its incidence numbers and, beside them, its hyperedge positions, in rows of shared"},{"type":"text","text":" "},{"type":"text","text":"pools. So "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" are stored "},{"type":"codeVoice","code":"ArraySlice<Int>"},{"type":"text","text":" rows"},{"type":"text","text":" "},{"type":"text","text":"read without hashing, and the"},{"type":"text","text":" "},{"type":"text","text":"hypergraph makes a constant number of allocations however many vertices it has. Every"},{"type":"text","text":" "},{"type":"text","text":"vertex-space read hashes its vertex once; index-space reads and the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms"},{"type":"text","text":" "},{"type":"text","text":"hash none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hyperedges can be appended but not removed (removal, and with it a decision on positions, is"},{"type":"text","text":" "},{"type":"text","text":"left for later). Equality ignores the order of the vertices and of the hyperedges."}]}],"kind":"content"}],"kind":"symbol","references":{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/Equatable-Implementations":{"title":"Equatable Implementations","kind":"article","type":"topic","abstract":[],"ident