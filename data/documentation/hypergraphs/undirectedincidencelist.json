{"abstract":[{"text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a","type":"text"},{"text":" ","type":"text"},{"text":"row per vertex of its memberships. The undirected counterpart of ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"role":"symbol","roleHeading":"Structure","symbolKind":"struct","externalID":"s:11Hypergraphs23UndirectedIncidenceListV","title":"UndirectedIncidenceList","remoteSource":{"fileName":"UndirectedIncidenceList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/UndirectedIncidenceList.swift#L26"},"modules":[{"name":"Hypergraphs"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"}],"navigatorTitle":[{"text":"UndirectedIncidenceList","kind":"identifier"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/hypergraphs\/undirectedincidencelist"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","interfaceLanguage":"swift"},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"