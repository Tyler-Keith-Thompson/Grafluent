" algorithms"},{"type":"text","text":" "},{"type":"text","text":"hash none."}]},{"type":"paragraph","inlineContent":[{"text":"Hyperedges can be appended but not removed (removal, and with it a decision on positions, is","type":"text"},{"text":" ","type":"text"},{"text":"left for later). Equality ignores the order of the vertices and of the hyperedges.","type":"text"}]}]}],"abstract":[{"text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a","type":"text"},{"text":" ","type":"text"},{"text":"row per vertex of its memberships. The undirected counterpart of ","type":"text"},{"type":"codeVoice","code":"IncidenceList"},{"text":", named as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UndirectedAdjacencyList"},{"text":" is. (","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":", the bit-matrix representation, is the","type":"text"},{"text":" ","type":"text"},{"text":"undirected one of its pair, because “oriented incidence matrix” is the established name of the","type":"text"},{"text":" ","type":"text"},{"text":"other.)","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/undirectedincidencelist"]}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"kind":"symbol","references":{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/reserveCapacity(vertexCount:hyperedgeCount:incidenceCount:)":{"title":"reserveCapacity(vertexCount:hyper