\/documentation\/Hypergraphs\/UndirectedIncidenceList\/CustomStringConvertible-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Decodable-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Encodable-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Equatable-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Hashable-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Hypergraph-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Hypergraph-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices are any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values, kept in an "},{"type":"codeVoice","code":"OrderedSet"},{"type":"text","text":" whose element "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":": the vertices listed first, then new members by first appearance, as "},{"type":"codeVoice","code":"LabeledGraph"},{"type":"text","text":" "},{"type":"text","text":"assigns them. A hyperedge is a set of vertices of any size, the empty set included; repeated"},{"type":"text","text":" "},{"type":"text","text":"hyperedges are kept, each at its own position "},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"type":"text","text":", and a member listed twice"},{"type":"text","text":" "},{"type":"text","text":"is stored once. Members are stored in vertex-index order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is compressed sparse rows: the members of every hyperedge in one array, and for every"},{"type":"text","text":" "},{"type":"text","text":"vertex its incidence numbers and, beside them, its hyperedge positions, in rows of shared"},{"type":"text","text":" "},{"type":"text","text":"pools. So "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" are stored "},{"type":"codeVoice","code":"ArraySlice<Int>"},{"type":"text","text":" rows"},{"type":"text","text":" "},{"type":"text","text":"read without hashing, and the"},{"type":"text","text":" "},{"type":"text","text":"hypergraph makes a constant number of allocations however many vertices it has. Every"},{"type":"text","text":" "},{"type":"text","text":"vertex-space read hashes its vertex once; index-space reads and the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms"},{"type":"text","text":" "},{"type":"text","text":"hash none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hyperedges can be appended but not removed (removal, and with it a decision on positions, is"},{"type":"text","text":" "},{"type":"text","text":"left for later). Equality ignores the order of the vertices and of the hyperedges."}]}],"kind":"content"}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/init(_:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/init(