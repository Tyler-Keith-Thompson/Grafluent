ype":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms hash none."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hyperedges can be appended but not removed. Equality ignores the order of the vertices and of"},{"type":"text","text":" "},{"type":"text","text":"the hyperedges."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Maps from the vertices and the hyperedges to values can be attached ("},{"type":"codeVoice","code":"PropertyGraph"},{"type":"text","text":"): a"},{"type":"text","text":" "},{"type":"text","text":"vertex map is read by vertex index or by vertex, an edge map by hyperedge position."}]}]}],"abstract":[{"type":"text","text":"An undirected hypergraph stored as an incidence list: a row per hyperedge of its members and a"},{"type":"text","text":" "},{"type":"text","text":"row per vertex of its memberships. The undirected counterpart of "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"UndirectedIncidenceList"}],"roleHeading":"Structure","remoteSource":{"fileName":"UndirectedIncidenceList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/UndirectedIncidenceList.swift#L26"},"externalID":"s:11Hypergraphs23UndirectedIncidenceListV","title":"UndirectedIncidenceList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"}],"modules":[{"name":"Hypergraphs"}],"role":"symbol"},"references":{"doc://Hypergraphs/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/Hypergraphs\/s8CopyableP","title":"Swift.Copyable"},"doc://Hypergraphs/SE":{"type":"unresolvable","title":"Swift.Encodable","identifier":"doc:\/\/Hypergraphs\/SE"},"doc://Hypergraphs/SQ":{"type":"unresolvable","identifier":