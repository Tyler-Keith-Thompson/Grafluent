"text","text":"pools. So "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" and "},{"type":"codeVoice","code":"incidentHyperedges(ofIndex:)"},{"type":"text","text":" are stored "},{"type":"codeVoice","code":"ArraySlice<Int>"},{"type":"text","text":" rows"},{"type":"text","text":" "},{"type":"text","text":"read without hashing, and the"},{"type":"text","text":" "},{"type":"text","text":"hypergraph makes a constant number of allocations however many vertices it has. Every"},{"type":"text","text":" "},{"type":"text","text":"vertex-space read hashes its vertex once; index-space reads and the "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms"},{"type":"text","text":" "},{"type":"text","text":"hash none."}],"type":"paragraph"},{"inlineContent":[{"text":"Hyperedges can be appended but not removed (removal, and with it a decision on positions, is","type":"text"},{"text":" ","type":"text"},{"text":"left for later). Equality ignores the order of the vertices and of the hyperedges.","type":"text"}],"type":"paragraph"}]}],"metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"}],"remoteSource":{"fileName":"UndirectedIncidenceList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/UndirectedIncidenceList.swift#L27"},"roleHeading":"Structure","role":"symbol","modules":[{"name":"Hypergraphs"}],"navigatorTitle":[{"text":"UndirectedIncidenceList","kind":"identifier"}],"title":"UndirectedIncidenceList","externalID":"s:11Hypergraphs23UndirectedIncidenceListV"},"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/CustomDebugStringConvertible-Implementations":{"role":"collectionGroup","url":"\/documentation\/hypergra