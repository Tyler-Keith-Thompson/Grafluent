ype":"text"},{"text":" ","type":"text"},{"text":"pools. So ","type":"text"},{"code":"memberIndices","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"incidentHyperedges(ofIndex:)","type":"codeVoice"},{"text":" are stored ","type":"text"},{"code":"ArraySlice<Int>","type":"codeVoice"},{"text":" rows","type":"text"},{"text":" ","type":"text"},{"text":"read without hashing, and the","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph makes a constant number of allocations however many vertices it has. Every","type":"text"},{"text":" ","type":"text"},{"text":"vertex-space read hashes its vertex once; index-space reads and the ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" algorithms","type":"text"},{"text":" ","type":"text"},{"text":"hash none.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Hyperedges can be appended but not removed (removal, and with it a decision on positions, is","type":"text"},{"text":" ","type":"text"},{"text":"left for later). Equality ignores the order of the vertices and of the hyperedges.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/undirectedincidencelist"]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/CustomDebugStringConvertible-Implementations":{"title":"CustomDebugStringConvertible Implementations","url":"\/documentation\/hypergraphs\/undirectedinc