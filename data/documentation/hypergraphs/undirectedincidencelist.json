hs\/UndirectedIncidenceList\/Hypergraph-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/PropertyGraph-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"sections":[],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndirectedIncidenceList"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"The vertices are any ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" values, kept in an ","type":"text"},{"type":"codeVoice","code":"OrderedSet"},{"text":" whose element ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" is vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":": the vertices listed first, then new members by first appearance, as ","type":"text"},{"type":"codeVoice","code":"LabeledGraph"},{"text":" ","type":"text"},{"text":"assigns them. A hyperedge is a set of vertices of any size, the empty set included; repeated","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges are kept, each at its own position ","type":"text"},{"type":"codeVoice","code":"0..<hyperedgeCount"},{"text":", and a member listed twice","type":"text"},{"text":" ","type":"text"},{"text":"is stored once. Members are stored in vertex-index order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storage is compressed sparse rows: the members of every hyperedge in one array, and for every"},{"type":"text","text":" "},{"type":"text","text":"vertex its incidence numbers and, beside them, its hyperedge positions, in rows of shared"},{"type":"text","text":" "},{"type":"text","text":"pools. So "},{"code":"memberIndices","type":"codeVoice"},{"type":"text","text":" and "},{"code":"incidentHyperedges(ofIndex:)","type":"codeVoice"},{"type":"text","text":" are stored "},{"code":"ArraySlice<Int>","type":"codeVoice"},{"type":"text","text":" rows"},{"type":"text","text":" "},{"type":"text","text":"read without hashing, and the"},{"type":"text","text":" "},{"type":"text","text":"hypergraph makes a constant number of allocations however many vertices it has. Every"},{"type":"text","text":" "},{"type":"text","text":"vertex-space read hashes its vertex once; index-space reads and the "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" algorithms"},{"type":"text","text":" "},{"type":"text","text":"hash none."}],"type":"paragraph"},{"inlineContent":[{"text":"Hyperedges can be appended but not removed (removal, and with it a decision on positions, is","type":"text"},{"text":" ","type":"text"},{"text":"left for later). Equality ignores the order of the vertices and of the hyperedges.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Maps from the vertices and the hyperedges to values can be attached ("},{"code":"PropertyGraph","type":"codeVoice"},{"type":"text","text":"): a"},{"type":"text","text":" "},{"type":"text","text":"vertex map is read by vertex index or by vertex, an edge map by hyperedge position."}],"type":"paragraph"}]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/Equatable-Implementations":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Equatable-Implementations","kind":"article","type":"topic","title":"Equatable Implementations","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/equatable-implementations","role":"collectionGroup","abstract":[]},"doc://Hypergraphs/s9EscapableP":{"type":"unresolvable","title":"Swift.Escapable","identifier":"doc:\/\/Hypergraphs\/s9EscapableP"},"doc://GraphProtocols/documentation/GraphProtocols/PropertyGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PropertyGraph","kind":"identifier"}],"type":"topic","title":"PropertyGraph","role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","url":"\/documentation\/graphprotocols\/propertygraph","navigatorTitle":[{"text":"PropertyGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A graph that keeps maps from its vertices and edges to values: the BGL "},{"type":"emphasis","inlineContent":[{"type":"text","text":"PropertyGraph"}]},{"type":"text","text":" "},{"type":"text","text":"concept (“a graph that has some property associated with each vertex or edge”), with LEMON’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"NodeMap"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ArcMap"},{"type":"text","text":" attached to the graph and kept in step by it. The graph owns the values"},{"type":"text","text":" "},{"type":"text","text":"and the caller holds a small handle, "},{"type":"codeVoice","code":"VertexMap<Value>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"EdgeMap<Value>"},{"type":"text","text":"."}]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/Encodable-Implementations":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/Encodable-Implementations","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/encodable-implementations","kind":"article","role":"collectionGroup","title":"Encodable Implementations","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/UndirectedIncidenceList/reserveCapacity(vertexCount:hyperedgeCount:incidenceCount:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reserveCapacity","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"hyperedgeCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"incidenceCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/undirectedincidencelist\/reservecapacity(vertexcount:hyperedgecount:incidencecount:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/UndirectedIncidenceList\/reserveCapacity(vertexCount:hyperedgeCount:incidenceCount:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Vertex"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"role":"symbol","title":"reserveCapacity(verte