{"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"title":"DirectedIncidenceGraphView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"modules":[{"name":"Hypergraphs"}],"role":"symbol","externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","symbolKind":"struct","roleHeading":"Structure"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","text":"DirectedHypergraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Positions "},{"type":"codeVoice","code":"0 ..< P_s"},{"type":"text","text":" are the source incidences, hyperedge by hyperedge in index order and"},{"type":"text","text":" "},{"type":"text","text":"within one in "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":" order, and "},{"type":"codeVoice","code":"P_s + q"},{"type":"text","text":" is target incidence "},{"type":"codeVoice","code":"q"},{"type":"text","text":", in the same order. A"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array is indexed by edge position. A view is a snapshot, so its own positions"},{"type":"text","text":" "},{"type":"text","text":"never change, but they are valid for the hypergraph only until its next mutation: the view of"},{"type":"text","text":" "},{"type":"text","text":"the mutated hypergraph numbers the incidences afresh (on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", inserting"},{"type":"text","text":" "},{"type":"text","text":"one cell shifts every later incidence by one)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every index member reads the base’s rows, shifted where they hold hyperedges:"},{"type":"text","text":" "},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" plus n, and of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"type":"text","text":"; "},{"type":"codeVoice","code":"predecessorIndices"},{"type":"text","text":" is "},{"type":"codeVoice","code":"inHyperedgeIndices"},{"type":"text","text":" plus n, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":". Graph algorithms therefore run on the view without hashing a vertex. The view"},{"type":"text","text":" "},{"type":"text","text":"does not offer "},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"type":"text","text":", whose contract needs edge positions in row order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Costs are as for "},{"code":"IncidenceGraphView","type":"codeVoice"},{"type":"text","text":": O(1) reads on "},{"code":"IncidenceList","type":"codeVoice"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"code":"edges[q]","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"code":"outEdges","type":"codeVoice"},{"type":"text","text":" or "},{"code":"inEdges","type":"codeVoice"},{"type":"text","text":" is computed from "},{"code":"_memberRank","type":"codeVoice"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/init(base:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edg