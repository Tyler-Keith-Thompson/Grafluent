odeVoice","code":"q"},{"text":", in the","type":"text"},{"text":" ","type":"text"},{"text":"same order. A per-incidence array is indexed by edge position. A view is a snapshot, so its own","type":"text"},{"text":" ","type":"text"},{"text":"positions never change, but they are valid for the hypergraph only until its next mutation:","type":"text"},{"text":" ","type":"text"},{"text":"the view of the mutated hypergraph numbers the incidences afresh (on ","type":"text"},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"inserting one cell shifts every later incidence by one).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"The LabeledGraph law."}],"type":"strong"},{"text":" Every index member reads the base’s rows, shifted where they hold","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges: ","type":"text"},{"code":"successorIndices(ofIndex: i)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"outHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"text":" plus n, and","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" it is ","type":"text"},{"code":"targetIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"predecessorIndices","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"inHyperedgeIndices","type":"codeVoice"},{"text":" plus n, or ","type":"text"},{"code":"sourceIndices","type":"codeVoice"},{"text":". So graph algorithms run on the view without","type":"text"},{"text":" ","type":"text"},{"text":"hashing a vertex. The view does not offer ","type":"text"},{"code":"_withSuccessorIndexRows","type":"codeVoice"},{"text":", whose contract needs edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in row order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Costs."}]},{"type":"text","text":" As for "},{"type":"codeVoice","code":"IncidenceGraphView"},{"type":"text","text":": O(1) reads on "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", and a vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":" is computed from "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/directedincidencegraphview"]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/outDegree(ofIndex:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/outDegree(ofIndex:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outDegree"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outdegree(ofindex:)","type":"topic","abstract":[],"kind":"symbol","title":"outDegree(ofIndex:)"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/inDegree(of:)":{"k