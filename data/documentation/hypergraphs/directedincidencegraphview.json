{"kind":"symbol","metadata":{"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"roleHeading":"Structure","role":"symbol","title":"DirectedIncidenceGraphView","externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"remoteSource":{"fileName":"DirectedIncidenceGraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedIncidenceGraphView.swift#L41"},"modules":[{"name":"Hypergraphs"}]},"abstract":[{"text":"A directed hypergraph’s incidence graph, read lazily from its storage: a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"0 ..< n + m"},{"text":" whose vertex ","type":"text"},{"type":"codeVoice","code":"i < n"},{"text":" is the hypergraph’s vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" and whose vertex ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" is hyperedge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", with an arc ","type":"text"},{"type":"codeVoice","code":"i → n + p"},{"text":" for each source","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" of ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"n + p → j"},{"text":" for each target ","type":"text"},{"type":"codeVoice","code":"j"},{"text":". A vertex on both sides of ","type":"text"},{"type":"codeVoice","code":"p"},{"text":" gives the 2-cycle","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"i → n + p → i"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","kind":"typeIdentifier","text":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positions "},{"type":"codeVoice","code":"0 ..< P_s"},{"type":"text","text":" are the source incidences, hyperedge by hyperedge in index order and"},{"type":"text","text":" "},{"type":"text","text":"within one in "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":" order, and "},{"type":"codeVoice","code":"P_s + q"},{"type":"text","text":" is target incidence "},{"type":"codeVoice","code":"q"},{"type":"text","text":", in the same order. A"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array is indexed by edge position. A view is a snapshot, so its own positions"},{"type":"text","text":" "},{"type":"text","text":"never change, but they are valid for the hypergraph only until its next mutation: the view of"},{"type":"text","text":" "},{"type":"text","text":"the mutated hypergraph numbers the incidences afresh (on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", inserting"},{"type":"text","text":" "},{"type":"text","text":"one cell shifts every later incidence by one)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every index member reads the base’s rows, shifted where they hold hyperedges:"},{"type":"text","text":" "},{"code":"successorIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"outHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" plus n, and of "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"code":"targetIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"type":"text","text":"; "},{"code":"predecessorIndices","type":"codeVoice"},{"type":"text","text":" is "},{"code":"inHyperedgeIndices","type":"codeVoice"},{"type":"text","text":" plus n, or"},{"type":"text","text":" "},{"code":"sourceIndices","type":"codeVoice"},{"type":"text","text":". Graph algorithms therefore run on the view without hashing a vertex. The view"},{"type":"text","text":" "},{"type":"text","text":"does not offer "},{"code":"_withSuccessorIndexRows","type":"codeVoice"},{"type":"text","text":", whose contract needs edge positions in row order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Costs are as for "},{"type":"codeVoice","code":"IncidenceGraphView"},{"type":"text","text":": O(1) reads on "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":" is computed from "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":"."}]}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"topicSections":[{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/init(base:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertices"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\