type":"text"},{"text":" ","type":"text"},{"text":"order and within one in ","type":"text"},{"code":"sourceIndices","type":"codeVoice"},{"text":" order, and ","type":"text"},{"code":"P_s + q","type":"codeVoice"},{"text":" is target incidence ","type":"text"},{"code":"q","type":"codeVoice"},{"text":", in the","type":"text"},{"text":" ","type":"text"},{"text":"same order. A per-incidence array is indexed by edge position. A view is a snapshot, so its own","type":"text"},{"text":" ","type":"text"},{"text":"positions never change, but they are valid for the hypergraph only until its next mutation:","type":"text"},{"text":" ","type":"text"},{"text":"the view of the mutated hypergraph numbers the incidences afresh (on ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"inserting one cell shifts every later incidence by one).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"The LabeledGraph law."}],"type":"strong"},{"text":" Every index member reads the base’s rows, shifted where they hold","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges: ","type":"text"},{"code":"successorIndices(ofIndex: i)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"outHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"text":" plus n, and","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" it is ","type":"text"},{"code":"targetIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"predecessorIndices","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"inHyperedgeIndices","type":"codeVoice"},{"text":" plus n, or ","type":"text"},{"code":"sourceIndices","type":"codeVoice"},{"text":". So graph algorithms run on the view without","type":"text"},{"text":" ","type":"text"},{"text":"hashing a vertex. The view does not offer ","type":"text"},{"code":"_withSuccessorIndexRows","type":"codeVoice"},{"text":", whose contract needs edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in row order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Costs."}],"type":"strong"},{"text":" As for ","type":"text"},{"code":"IncidenceGraphView","type":"codeVoice"},{"text":": O(1) reads on ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":", which stores its","type":"text"},{"text":" ","type":"text"},{"text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":", and a vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"inEdges","type":"codeVoice"},{"text":" is computed from ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":", O(d·⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"A directed hypergraph’s incidence graph, read lazily from its storage: a","type":"text"},{"text":" ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an arc ","type":"text"},{"code":"i → n + p","type":"codeVoice"},{"text":" for each