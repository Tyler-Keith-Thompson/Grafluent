cidence by one)."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The LabeledGraph law.","type":"text"}],"type":"strong"},{"text":" Every index member reads the base’s rows, shifted where they hold","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges: ","type":"text"},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"text":" plus n, and","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" it is ","type":"text"},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"predecessorIndices"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"inHyperedgeIndices"},{"text":" plus n, or ","type":"text"},{"type":"codeVoice","code":"sourceIndices"},{"text":". So graph algorithms run on the view without","type":"text"},{"text":" ","type":"text"},{"text":"hashing a vertex. The view does not offer ","type":"text"},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"text":", whose contract needs edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in row order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Costs."}]},{"type":"text","text":" As for "},{"type":"codeVoice","code":"IncidenceGraphView"},{"type":"text","text":": O(1) reads on "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", and a vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":" is computed from "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":"."}]}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/directedincidencegraphview"]}],"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"remot