{"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","text":"DirectedHypergraph","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges."}],"type":"strong"},{"type":"text","text":" Positions "},{"code":"0 ..< P_s","type":"codeVoice"},{"type":"text","text":" are the source incidences, hyperedge by hyperedge in index"},{"type":"text","text":" "},{"type":"text","text":"order and within one in "},{"code":"sourceIndices","type":"codeVoice"},{"type":"text","text":" order, and "},{"code":"P_s + q","type":"codeVoice"},{"type":"text","text":" is target incidence "},{"code":"q","type":"codeVoice"},{"type":"text","text":", in the"},{"type":"text","text":" "},{"type":"text","text":"same order. A per-incidence array is indexed by edge position. A view is a snapshot, so its own"},{"type":"text","text":" "},{"type":"text","text":"positions never change, but they are valid for the hypergraph only until its next mutation:"},{"type":"text","text":" "},{"type":"text","text":"the view of the mutated hypergraph numbers the incidences afresh (on "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"inserting one cell shifts every later incidence by one)."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The LabeledGraph law."}]},{"type":"text","text":" Every index member reads the base’s rows, shifted where they hold"},{"type":"text","text":" "},{"type":"text","text":"hyperedges: "},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" plus n, and"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is "},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"type":"text","text":"; "},{"type":"codeVoice","code":"predecessorIndices"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"inHyperedgeIndices"},{"type":"text","text":" plus n, or "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":". So graph algorithms run on the view without"},{"type":"text","text":" "},{"type":"text","text":"hashing a vertex. The view does not offer "},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"type":"text","text":", whose contract needs edge"},{"type":"text","text":" "},{"type":"text","text":"positions in row order."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Costs."}]},{"type":"text","text":" As for "},{"type":"codeVoice","code":"IncidenceGraphView"},{"type":"text","text":": O(1) reads on "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", and a vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":" is computed from "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":"."}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/directedincidencegraphview"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/init(base:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertices"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/