s on ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":", which stores its","type":"text"},{"text":" ","type":"text"},{"text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":", and a vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"inEdges","type":"codeVoice"},{"text":" is computed from ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":", O(d·⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/hypergraphs\/directedincidencegraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","modules":[{"name":"Hypergraphs"}],"roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedIncidenceGraphView.swift#L42","fileName":"DirectedIncidenceGraphView.swift"},"symbolKind":"struct","title":"DirectedIncidenceGraphView"},"sections":[],"abstract":[{"text":"A directed hypergraph’s incidence graph, read lazily from its storage: a","type":"text"},{"text":" ","type":"text"