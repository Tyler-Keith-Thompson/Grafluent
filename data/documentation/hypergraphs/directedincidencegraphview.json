pe":"text","text":" "},{"type":"text","text":"never change, but they are valid for the hypergraph only until its next mutation: the view of"},{"type":"text","text":" "},{"type":"text","text":"the mutated hypergraph numbers the incidences afresh (on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", inserting"},{"type":"text","text":" "},{"type":"text","text":"one cell shifts every later incidence by one)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every index member reads the base’s rows, shifted where they hold hyperedges:"},{"type":"text","text":" "},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" plus n, and of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"type":"text","text":"; "},{"type":"codeVoice","code":"predecessorIndices"},{"type":"text","text":" is "},{"type":"codeVoice","code":"inHyperedgeIndices"},{"type":"text","text":" plus n, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":". Graph algorithms therefore run on the view without hashing a vertex. The view"},{"type":"text","text":" "},{"type":"text","text":"does not offer "},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"type":"text","text":", whose contract needs edge positions in row order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Costs are as for "},{"code":"IncidenceGraphView","type":"codeVoice"},{"type":"text","text":": O(1) reads on "},{"code":"IncidenceList","type":"codeVoice"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"code":"edges[q]","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"code":"outEdges","type":"codeVoice"},{"type":"text","text":" or "},{"code":"inEdges","type":"codeVoice"},{"type":"text","text":" is computed from "},{"code":"_memberRank","type":"codeVoice"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/directedincidencegraphview"]}],"sections":[],"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"metadata":{"roleHeading":"Structure","title":"DirectedIncidenceGraphView","role":"symbol","modules":[{"name":"Hypergraphs"}],"externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedIncidenceGraphView.swift#L41","fileName":"DirectedIncidenceGraphView.swift"}},"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"A directed hypergraph’s inci