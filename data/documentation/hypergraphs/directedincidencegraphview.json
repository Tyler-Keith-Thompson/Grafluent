agraph"},{"inlineContent":[{"text":"Costs are as for ","type":"text"},{"type":"codeVoice","code":"IncidenceGraphView"},{"text":": O(1) reads on ","type":"text"},{"type":"codeVoice","code":"IncidenceList"},{"text":", which stores its","type":"text"},{"text":" ","type":"text"},{"text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), ","type":"text"},{"type":"codeVoice","code":"edges[q]"},{"text":" ","type":"text"},{"text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on ","type":"text"},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s ","type":"text"},{"type":"codeVoice","code":"outEdges"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"inEdges"},{"text":" is computed from ","type":"text"},{"type":"codeVoice","code":"_memberRank"},{"text":", O(d·⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"references":{"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/vertexIndex(of:)":{"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/vertexindex(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertexIndex"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","abstract":[],"title":"vertexIndex(of:)","role":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexIndex(of:)"},"doc://Hypergraphs/documentation/Hypergraphs/Dire