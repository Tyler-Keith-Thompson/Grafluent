oice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"inHyperedgeIndices","type":"codeVoice"},{"text":" plus n, or ","type":"text"},{"code":"sourceIndices","type":"codeVoice"},{"text":". So graph algorithms run on the view without","type":"text"},{"text":" ","type":"text"},{"text":"hashing a vertex. The view does not offer ","type":"text"},{"code":"_withSuccessorIndexRows","type":"codeVoice"},{"text":", whose contract needs edge","type":"text"},{"text":" ","type":"text"},{"text":"positions in row order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Costs."}]},{"text":" As for ","type":"text"},{"code":"IncidenceGraphView","type":"codeVoice"},{"text":": O(1) reads on ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":", which stores its","type":"text"},{"text":" ","type":"text"},{"text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":", and a vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"inEdges","type":"codeVoice"},{"text":" is computed from ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":", O(d·⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":".","type":"text"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/directedincidencegraphview"]}],"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/