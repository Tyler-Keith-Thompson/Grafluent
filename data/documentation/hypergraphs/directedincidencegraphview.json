..< P_s","type":"codeVoice"},{"text":" are the source incidences, hyperedge by hyperedge in index order and","type":"text"},{"text":" ","type":"text"},{"text":"within one in ","type":"text"},{"code":"sourceIndices","type":"codeVoice"},{"text":" order, and ","type":"text"},{"code":"P_s + q","type":"codeVoice"},{"text":" is target incidence ","type":"text"},{"code":"q","type":"codeVoice"},{"text":", in the same order. A","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array is indexed by edge position. A view is a snapshot, so its own positions","type":"text"},{"text":" ","type":"text"},{"text":"never change, but they are valid for the hypergraph only until its next mutation: the view of","type":"text"},{"text":" ","type":"text"},{"text":"the mutated hypergraph numbers the incidences afresh (on ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":", inserting","type":"text"},{"text":" ","type":"text"},{"text":"one cell shifts every later incidence by one).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every index member reads the base’s rows, shifted where they hold hyperedges:","type":"text"},{"text":" ","type":"text"},{"code":"successorIndices(ofIndex: i)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"outHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"text":" plus n, and of ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" it is","type":"text"},{"text":" ","type":"text"},{"code":"targetIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"predecessorIndices","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"inHyperedgeIndices","type":"codeVoice"},{"text":" plus n, or","type":"text"},{"text":" ","type":"text"},{"code":"sourceIndices","type":"codeVoice"},{"text":". Graph algorithms therefore run on the view without hashing a vertex. The view","type":"text"},{"text":" ","type":"text"},{"text":"does not offer ","type":"text"},{"code":"_withSuccessorIndexRows","type":"codeVoice"},{"text":", whose contract needs edge positions in row order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Costs are as for "},{"type":"codeVoice","code":"IncidenceGraphView"},{"type":"text","text":": O(1) reads on "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":" is computed from "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/target(checkedEdgeAt:)":{"title":"target(checkedEdgeAt:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"target","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checkedEdgeAt","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"EdgeNotFound","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12EdgeNotFoundV"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","abstract":[{"type":"codeVoice","code":"target(ofEdgeAt: pos