h-Implementations","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/DirectedGraph-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","text":"DirectedHypergraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positions "},{"type":"codeVoice","code":"0 ..< P_s"},{"type":"text","text":" are the source incidences, hyperedge by hyperedge in index order and"},{"type":"text","text":" "},{"type":"text","text":"within one in "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":" order, and "},{"type":"codeVoice","code":"P_s + q"},{"type":"text","text":" is target incidence "},{"type":"codeVoice","code":"q"},{"type":"text","text":", in the same order. A"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array is indexed by edge position. A view is a snapshot, so its own positions"},{"type":"text","text":" "},{"type":"text","text":"never change, but they are valid for the hypergraph only until its next mutation: the view of"},{"type":"text","text":" "},{"type":"text","text":"the mutated hypergraph numbers the incidences afresh (on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", inserting"},{"type":"text","text":" "},{"type":"text","text":"one cell shifts every later incidence by one)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every index member reads the base’s rows, shifted where they hold hyperedges:"},{"type":"text","text":" "},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" plus n, and of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"type":"text","text":"; "},{"type":"codeVoice","code":"predecessorIndices"},{"type":"text","text":" is "},{"type":"codeVoice","code":"inHyperedgeIndices"},{"type":"text","text":" plus n, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":". Graph algorithms therefore run on the view without hashing a vertex. The view"},{"type":"text","text":" "},{"type":"text","text":"does not offer "},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"type":"text","text":", whose contract needs edge positions in row order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Costs are as for "},{"type":"codeVoice","code":"IncidenceGraphView"},{"type":"text","text":": O(1) reads on "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":" is computed from "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":"."}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"Hypergraphs"}],"role":"symbol","externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"remoteSource":{"fileName":"DirectedIncidenceGraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedIncidenceGraphView.swift#L41"},"title":"DirectedIncidenceGraphView","navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"roleHeading":"Structure","symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"references":{"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/BidirectionalDirectedGraph-Implementations":{"type":"topic","title":"BidirectionalDirectedGraph Implementations","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/BidirectionalDirectedGraph-Implementations","kind":"article","role":"collectionGroup","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/bidirectionaldirectedgraph-implementations","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/source(checkedEdgeAt:)":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/source(checkedEdgeAt:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","te