{"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedIncidenceGraphView.swift#L41","fileName":"DirectedIncidenceGraphView.swift"},"externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","title":"DirectedIncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"role":"symbol","modules":[{"name":"Hypergraphs"}],"symbolKind":"struct"},"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","text":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Positions "},{"type":"codeVoice","code":"0 ..< P_s"},{"type":"text","text":" are the source incidences, hyperedge by hyperedge in index order and"},{"type":"text","text":" "},{"type":"text","text":"within one in "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":" order, and "},{"type":"codeVoice","code":"P_s + q"},{"type":"text","text":" is target incidence "},{"type":"codeVoice","code":"q"},{"type":"text","text":", in the same order. A"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array is indexed by edge position. A view is a snapshot, so its own positions"},{"type":"text","text":" "},{"type":"text","text":"never change, but they are valid for the hypergraph only until its next mutation: the view of"},{"type":"text","text":" "},{"type":"text","text":"the mutated hypergraph numbers the incidences afresh (on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", inserting"},{"type":"text","text":" "},{"type":"text","text":"one cell shifts every later incidence by one)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every index member reads the base’s rows, shifted where they hold hyperedges:"},{"type":"text","text":" "},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" plus n, and of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"type":"text","text":"; "},{"type":"codeVoice","code":"predecessorIndices"},{"type":"text","text":" is "},{"type":"codeVoice","code":"inHyperedgeIndices"},{"type":"text","text":" plus n, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":". Graph algorithms therefore run on the view without hashing a vertex. The view"},{"type":"text","text":" "},{"type":"text","text":"does not offer "},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"type":"text","text":", whose contract needs edge positions in row order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Costs are as for "},{"code":"IncidenceGraphView","type":"codeVoice"},{"type":"text","text":": O(1) reads on "},{"code":"IncidenceList","type":"codeVoice"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"code":"edges[q]","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"text","text":"vertex’s "},{"code":"outEdges","type":"codeVoice"},{"type":"text","text":" or "},{"code":"inEdges","type":"codeVoice"},{"type":"text","text":" is computed from "},{"code":"_memberRank","type":"codeVoice"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/directedincidencegraphview"]}],"kind":"symbol","topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/init(base:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertices"],"anchor":"Instance-Properties"},{"generated":true,