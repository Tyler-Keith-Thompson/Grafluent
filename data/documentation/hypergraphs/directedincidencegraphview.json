{"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedIncidenceGraphView.swift#L41","fileName":"DirectedIncidenceGraphView.swift"},"modules":[{"name":"Hypergraphs"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"title":"DirectedIncidenceGraphView","roleHeading":"Structure","role":"symbol","externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"symbolKind":"struct"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","kind":"typeIdentifier","text":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positions "},{"type":"codeVoice","code":"0 ..< P_s"},{"type":"text","text":" are the source incidences, hyperedge by hyperedge in index order and"},{"type":"text","text":" "},{"type":"text","text":"within one in "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":" order, and "},{"type":"codeVoice","code":"P_s + q"},{"type":"text","text":" is target incidence "},{"type":"codeVoice","code":"q"},{"type":"text","text":", in the same order. A"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array is indexed by edge position. A view is a snapshot, so its own positions"},{"type":"text","text":" "},{"type":"text","text":"never change, but they are valid for the hypergraph only until its next mutation: the view of"},{"type":"text","text":" "},{"type":"text","text":"the mutated hypergraph numbers the incidences afresh (on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", inserting"},{"type":"text","text":" "},{"type":"text","text":"one cell shifts every later incidence by one)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every index member reads the base’s rows, shifted where they hold hyperedges:"},{"type":"text","text":" "},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" plus n, and of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"type":"text","text":"; "},{"type":"codeVoice","code":"predecessorIndices"},{"type":"text","text":" is "},{"type":"codeVoice","code":"inHyperedgeIndices"},{"type":"text","text":" plus n, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":". Graph algorithms therefore run on the view without hashing a vertex. The view"},{"type":"text","text":" "},{"type":"text","text":"does not offer "},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"type":"text","text":", whose contract needs edge positions in row order."}]},{"type":"paragraph","inlineContent":[{"text":"Costs are as for ","type":"text"},{"code":"IncidenceGraphView","type":"codeVoice"},{"text":": O(1) reads on ","type":"text"},{"code":"IncidenceList","type":"codeVoice"},{"text":", which stores its","type":"text"},{"text":" ","type":"text"},{"text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"text":"vertex’s ","type":"text"},{"code":"outEdges","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"inEdges","type":"codeVoice"},{"text":" is computed from ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":", O(d·⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/init(base:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/vertexCount","doc:\/\/Hypergrap