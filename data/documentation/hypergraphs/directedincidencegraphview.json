{"sections":[],"abstract":[{"text":"A directed hypergraph’s incidence graph, read lazily from its storage: a","type":"text"},{"text":" ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an arc ","type":"text"},{"code":"i → n + p","type":"codeVoice"},{"text":" for each source","type":"text"},{"text":" ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" of ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"n + p → j","type":"codeVoice"},{"text":" for each target ","type":"text"},{"code":"j","type":"codeVoice"},{"text":". A vertex on both sides of ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" gives the 2-cycle","type":"text"},{"text":" ","type":"text"},{"code":"i → n + p → i","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","text":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","kind":"typeIdentifier"}]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges.","type":"text"}]},{"type":"text","text":" Positions "},{"type":"codeVoice","code":"0 ..< P_s"},{"type":"text","text":" are the source incidences, hyperedge by hyperedge in index"},{"type":"text","text":" "},{"type":"text","text":"order and within one in "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":" order, and "},{"type":"codeVoice","code":"P_s + q"},{"type":"text","text":" is target incidence "},{"type":"codeVoice","code":"q"},{"type":"text","text":", in the"},{"type":"text","text":" "},{"type":"text","text":"same order. A per-incidence array is indexed by edge position. A view is a snapshot, so its own"},{"type":"text","text":" "},{"type":"text","text":"positions never change, but they are valid for the hypergraph only until its next mutation:"},{"type":"text","text":" "},{"type":"text","text":"the view of the mutated hypergraph numbers the incidences afresh (on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"inserting one cell shifts every later incidence by one)."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"The LabeledGraph law."}],"type":"strong"},{"type":"text","text":" Every index member reads the base’s rows, shifted where they hold"},{"type":"text","text":" "},{"type":"text","text":"hyperedges: "},{"type":"codeVoice","code":"successorIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"outHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" plus n, and"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is "},{"type":"codeVoice","code":"targetIndices(ofHyperedgeAt: p)"},{"type":"text","text":"; "},{"type":"codeVoice","code":"predecessorIndices"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"inHyperedgeIndices"},{"type":"text","text":" plus n, or "},{"type":"codeVoice","code":"sourceIndices"},{"type":"text","text":". So graph algorithms run on the view without"},{"type":"text","text":" "},{"type":"text","text":"hashing a vertex. The view does not offer "},{"type":"codeVoice","code":"_withSuccessorIndexRows"},{"type":"text","text":", whose contract needs edge"},{"type":"text","text":" "},{"type":"text","text":"positions in row order."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Costs.","type":"text"}]},{"type":"text","text":" As for "},{"type":"codeVoice","code":"IncidenceGraphView"},{"type":"text","text":": O(1) reads on "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":", which stores its"},{"type":"text","text":" "},{"type":"text","text":"incidences; on another base a hyperedge’s incidence numbers are a range, O(1), "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" "},{"type":"text","text":"binary-searches and selects by rank, O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":", and a vertex’s "},{"type":"codeVoice","code":"outEdges"},{"type":"text","text":" or "},{"type":"codeVoice","code":"inEdges"},{"type":"text","text":" is computed from "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":", O(d·⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"modules":[{"name":"Hypergraphs"}],"externalID":"s:11Hypergraphs26DirectedIncidenceGraphViewV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedIncidenceGraphVie