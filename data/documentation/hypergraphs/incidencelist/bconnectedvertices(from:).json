{"metadata":{"role":"symbol","title":"bConnectedVertices(from:)","roleHeading":"Instance Method","extendedModule":"GraphProtocols","symbolKind":"method","remoteSource":{"fileName":"DirectedHypergraphAlgorithms.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L318"},"externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF::SYNTHESIZED::s:11Hypergraphs13IncidenceListV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)"},"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"B-connection here is path-based, as B-Visit computes it: "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":" "},{"type":"text","text":"when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is "},{"type":"codeVoice","code":"source"},{"type":"text","text":", or some hyperedge with "},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets is entered along a path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" (it has a source, and all its sources are B-connected). So "},{"type":"strong","inlineContent":[{"text":"a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no sources never fires","type":"text"}]},{"type":"text","text":": no path enters it, and B-Visit scans only the forward stars of"},{"type":"text","text":" "},{"type":"text","text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it"},{"type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}],"type":"paragraph"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"source","type":"codeVoice"},{"text":" is a vertex.","type":"text"}]}],"type":"aside","style":"note"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(n + m + p): one counter per hyperedge and one queue; one hash.","type":"text"}]}],"type":"aside","style":"note"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)"]}],"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"code":"source","type":"codeVoice"},{"type":"text","text":", "},{"code":"source","type":"codeVoice"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"code":"b_visit","type":"codeVoice"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList"]]},"references":{"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","url":"\/documentation\/hypergraphs","title":"Hypergraphs","kind":"symbol","role":"collection","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"kind":"symbol","abstract":[{"type":"text","text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"’s storage. Unprefixed, as "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" is the directed one of its"},{"type":"text","text":" "},{"type":"text","text":"pair. ("},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":" is the matrix form; "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" is undirected, because"},{"type":"text","text":" "},{"type":"text","text":"“oriented incidence matrix” is the established name.)"}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceList"}],"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList","role":"symbol","title":"IncidenceList","url":"\/documentation\/hypergraphs\/incidencelist","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceList"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/Vertex":{"url":"\/documentation\/graphprotocols\/directedhypergraph\/vertex","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"abstract":[],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","title":"Vertex","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/bConnectedVertices(from:)":{"type":"topic","role":"symbol","title":"bConnectedVertices(from:)","abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"code":"b_visit","type":"codeVoice"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","url":"\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)"}}}