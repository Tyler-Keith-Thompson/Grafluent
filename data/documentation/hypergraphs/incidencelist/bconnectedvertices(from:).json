{"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"B-connection here is path-based, as B-Visit computes it: "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is B-connected to "},{"code":"source","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"when "},{"code":"v","type":"codeVoice"},{"type":"text","text":" is "},{"code":"source","type":"codeVoice"},{"type":"text","text":", or some hyperedge with "},{"code":"v","type":"codeVoice"},{"type":"text","text":" among its targets is entered along a path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"code":"source","type":"codeVoice"},{"type":"text","text":" (it has a source, and all its sources are B-connected). So "},{"inlineContent":[{"text":"a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no sources never fires","type":"text"}],"type":"strong"},{"type":"text","text":": no path enters it, and B-Visit scans only the forward stars of"},{"type":"text","text":" "},{"type":"text","text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it"},{"type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" is a vertex."}]}],"name":"Precondition","style":"note"},{"type":"aside","content":[{"inlineContent":[{"text":"O(n + m + p): one counter per hyperedge and one queue; one hash.","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList"]]},"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"metadata":{"title":"bConnectedVertices(from:)","extendedModule":"GraphProtocols","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L383","fileName":"DirectedHypergraphAlgorithms.swift"},"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF::SYNTHESIZED::s:11Hypergraphs13IncidenceListV","modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}],"role":"symbol","roleHeading":"Instance Method"},"references":{"doc://Hypergraphs/documentation/Hypergraphs":{"title":"Hypergraphs","role":"collection","abstract":[],"url":"\/documentation\/hypergraphs","type":"topic","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/Vertex":{"role":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph\/vertex","title":"Vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"role":"symbol","url":"\/documentation\/hypergraphs\/incidencelist","title":"IncidenceList","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceList"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"IncidenceList"}],"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList","abstract":[{"type":"text","text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of"},{"type":"text","text":" "},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":"’s storage. Unprefixed, as "},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":" is the directed one of its"},{"type":"text","text":" "},{"type":"text","text":"pair. ("},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":" is the matrix form; "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":" is undirected, because"},{"type":"text","text":" "},{"type":"text","text":"“oriented incidence matrix” is the established name.)"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/bConnectedVertices(from:)":{"role":"symbol","url":"\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)","title":"bConnectedVertices(from:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"code":"b_visit","type":"codeVoice"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","type":"topic"}}}