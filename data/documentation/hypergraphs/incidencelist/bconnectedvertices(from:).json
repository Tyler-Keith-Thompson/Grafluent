{"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF::SYNTHESIZED::s:11Hypergraphs13IncidenceListV","remoteSource":{"fileName":"DirectedHypergraphAlgorithms.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L382"},"extendedModule":"GraphProtocols","title":"bConnectedVertices(from:)","roleHeading":"Instance Method"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"B-connection here is path-based, as B-Visit computes it: ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is B-connected to ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", or some hyperedge with ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" among its targets is entered along a path","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" (it has a source, and all its sources are B-connected). So ","type":"text"},{"inlineContent":[{"type":"text","text":"a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no sources never fires"}],"type":"strong"},{"text":": no path enters it, and B-Visit scans only the forward stars of","type":"text"},{"text":" ","type":"text"},{"text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it","type":"text"},{"text":" ","type":"text"},{"text":"vacuously from any start; Gallo et al.’s visit and halp do not.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" is a vertex."}]}],"type":"aside","style":"note","name":"Precondition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m + p): one counter per hyperedge and one queue; one hash."}]}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"abstract":[{"type":"text","text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"’s storage. Unprefixed, as "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" is the directed one of its"},{"type":"text","text":" "},{"type":"text","text":"pair. ("},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":" is the matrix form; "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" is undirected, because"},{"type":"text","text":" "},{"type":"text","text":"“oriented incidence matrix” is the established name.)"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceList"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList","title":"IncidenceList","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"IncidenceList"}],"url":"\/documentation\/hypergraphs\/incidencelist"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/bConnectedVertices(from:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"type":"codeVoice","code":"b_visit"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"url":"\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"type":"topic","title":"bConnectedVertices(from:)"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs","role":"collection","type":"topic","url":"\/documentation\/hypergraphs"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/Vertex":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph\/vertex","type":"topic","abstract":[],"role":"symbol","title":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex"}}}