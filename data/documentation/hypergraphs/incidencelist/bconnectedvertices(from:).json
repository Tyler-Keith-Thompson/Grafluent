-Visit (halp’s ","type":"text"},{"type":"codeVoice","code":"b_visit"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex"},{"text":"]","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"B-connection here is path-based, as B-Visit computes it: ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is B-connected to ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", or some hyperedge with ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" among its targets is entered along a path","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" (it has a source, and all its sources are B-connected). So ","type":"text"},{"type":"strong","inlineContent":[{"text":"a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no sources never fires","type":"text"}]},{"text":": no path enters it, and B-Visit scans only the forward stars of","type":"text"},{"text":" ","type":"text"},{"text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it","type":"text"},{"text":" ","type":"text"},{"text":"vacuously from any start; Gallo et al.’s visit and halp do not.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" is a vertex."}]}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n + m + p): one counter per hyperedge and one queue; one hash."}],"type":"paragraph"}],"style":"note","name":"Complexity"}]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"type":"topic","title":"IncidenceList","navigatorTitle":[{"text":"IncidenceList","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList","abstract":[{"type":"text","text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"’s storage. Unprefixed, as "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" is the directed one of its"},{"type":"text","text":" "},{"type":"text","text":"pair. ("},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":" is the matrix form; "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" is undirected, because"},{"type":"text","text":" "},{"type":"text","text":"“oriented incidence matrix” is the established name.)"}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencelist","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceList","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/Vertex":{"fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"title":"Vertex","type":"topic","role":"symbol","abstract":[],"url":"\/documentation\/graphprotocols\/directedhypergraph\/vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","title":"Hypergraphs","url":"\/documentation\/hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/bConnectedVertices(from:)":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","role":"symbol","abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph