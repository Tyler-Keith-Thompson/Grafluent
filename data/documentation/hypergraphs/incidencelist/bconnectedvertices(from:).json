{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"type":"codeVoice","code":"b_visit"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"B-connection here is path-based, as B-Visit computes it: "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":" "},{"type":"text","text":"when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is "},{"type":"codeVoice","code":"source"},{"type":"text","text":", or some hyperedge with "},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets is entered along a path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" (it has a source, and all its sources are B-connected). So "},{"type":"strong","inlineContent":[{"text":"a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no sources never fires","type":"text"}]},{"type":"text","text":": no path enters it, and B-Visit scans only the forward stars of"},{"type":"text","text":" "},{"type":"text","text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it"},{"type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" is a vertex."}]}],"name":"Precondition","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(n + m + p): one counter per hyperedge and one queue; one hash.","type":"text"}]}],"name":"Complexity","style":"note","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)"]}],"sections":[],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"symbolKind":"method","modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF::SYNTHESIZED