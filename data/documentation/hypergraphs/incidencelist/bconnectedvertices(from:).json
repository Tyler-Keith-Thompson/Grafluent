{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"B-connection here is path-based, as B-Visit computes it: "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":" "},{"type":"text","text":"when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is "},{"type":"codeVoice","code":"source"},{"type":"text","text":", or some hyperedge with "},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets is entered along a path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" (it has a source, and all its sources are B-connected). So "},{"inlineContent":[{"type":"text","text":"a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no sources never fires"}],"type":"strong"},{"type":"text","text":": no path enters it, and B-Visit scans only the forward stars of"},{"type":"text","text":" "},{"type":"text","text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it"},{"type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" is a vertex."}],"type":"paragraph"}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(n + m + p): one counter per hyperedge and one queue; one hash."}],"type":"paragraph"}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","interfaceLanguage":"swift"},"metadata":{"symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}],"remoteSource":{"fileName":"DirectedHypergraphAlgorithms.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L382"},"externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF::SYNTHESIZED::s:11Hypergraphs13IncidenceListV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"role":"symbol","title":"bConnectedVertices(from:)","extendedModule":"GraphProtocols"},"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList"]]},"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"url":"\/documentation\/hypergraphs\/incidencelist","abstract":[{"text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":"’s storage. Unprefixed, as ","type":"text"},{"type":"codeVoice","code":"AdjacencyList"},{"text":" is the directed one of its","type":"text"},{"text":" ","type":"text"},{"text":"pair. (","type":"text"},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"text":" is the matrix form; ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":" is undirected, because","type":"text"},{"text":" ",