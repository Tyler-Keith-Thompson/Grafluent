{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"B-connection here is path-based, as B-Visit computes it: "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":" "},{"type":"text","text":"when "},{"type":"codeVoice","code":"v"},{"type":"text","text":" is "},{"type":"codeVoice","code":"source"},{"type":"text","text":", or some hyperedge with "},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets is entered along a path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" (it has a source, and all its sources are B-connected). So "},{"type":"strong","inlineContent":[{"text":"a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no sources never fires","type":"text"}]},{"type":"text","text":": no path enters it, and B-Visit scans only the forward stars of"},{"type":"text","text":" "},{"type":"text","text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it"},{"type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}],"type":"paragraph"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" is a vertex."}]}],"name":"Precondition"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(n + m + p): one counter per hyperedge and one queue; one hash.","type":"text"}]}],"name":"Complexity"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/bConnectedVertices(from:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/hypergraphs\/incidencelist\/bconnectedvertices(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"symbolKind":"method","remoteSource":{"fileName":"DirectedHypergraphAlgorithms.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L382"},"roleHeading":"Instance Method","role":"symbol","externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF::SYNTHESIZED::s:11Hypergraphs13IncidenceListV","title":"bConnectedVertices(from:)","modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}],"extendedModule":"GraphProtocols"},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList"]]},"sections":[],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/bConnectedVertices(from:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"code":"source","type":"codeVoice"},{"type":"text","text":", "},{"code":"source","type":"codeVo