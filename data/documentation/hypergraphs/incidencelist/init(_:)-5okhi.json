y be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"code":"DiHypergraph","type":"codeVoice"},{"type":"text","text":" allows both)."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","kind":"symbol","type":"topic","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","title":"DirectedHypergraph","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/init(_:)-5okhi":{"role":"symbol","title":"init(_:)","abstract":[{"type":"text","text":"A copy of any directed hypergraph: its vertices in order and its hyperedges at their"},{"type":"text","text":" "},{"type":"text","text":"positions. Converting an "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":" returns it unchanged."}],"url":"\/documentation\/hypergraphs\/incidencelist\/init(_:)-5okhi","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"DirectedHypergraph","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">)"}],"conformance":{"constraints":[{"code":"Vertex","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/init(_:)-5okhi","type":"topic","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"type":"topic","url":"\/documentation\/hypergraph