rtices in order and its hyperedges at their"},{"type":"text","text":" "},{"type":"text","text":"positions. Converting an "},{"type":"codeVoice","code":"IncidenceList"},{"type":"text","text":" returns it unchanged."}],"title":"init(_:)"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"kind":"symbol","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"type":"topic","url":"\/documentation\/graphprotocols\/directedhypergraph","title":"DirectedHypergraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","abstract":[],"title":"Hypergraphs","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","url":"\/documentation\/hypergraphs","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"navigatorTitle":[{"text":"IncidenceList","kind":