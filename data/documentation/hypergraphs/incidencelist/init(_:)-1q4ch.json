:"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"kind":"symbol","title":"Hypergraphs","type":"topic","role":"collection","url":"\/documentation\/hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{