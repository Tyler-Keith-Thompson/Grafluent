 a directed graph and a directed"},{"type":"text","text":" "},{"type":"text","text":"hypergraph: read as a hypergraph."}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","abstract":[],"kind":"symbol","type":"topic","title":"Hypergraphs","role":"collection","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList","type":"topic","abstract":[{"type":"text","text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":"’s storage. Unprefixed, as "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":" is the directed one of its"},{"type":"text","text":" "},{"type":"text","text":"pair. ("},{"type":"codeVoice","code":"OrientedIncidenceMatrix"},{"type":"text","text":" is the matrix form; "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" is undirected, because"},{"type":"text","text":" "},{"type":"text","text":"“oriented incidence matrix” is the established name.)"}],"title":"IncidenceList","navigatorTitle":[{"text":"IncidenceList","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceList","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencelist"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","type":"topic","title":"Vertex","abstract":[],"role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/vertex"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"url":"\/documentation\/graphprotocols\/directedhypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"code":"DiHypergraph","type":"codeVoice"},{"type":"text","text":" allows both)."}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","title":"DirectedHypergraph","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"}}}