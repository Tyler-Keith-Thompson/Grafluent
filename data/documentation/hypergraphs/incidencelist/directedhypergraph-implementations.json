mentation\/hypergraphs\/incidencelist\/incidencegraph","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraph"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV","kind":"typeIdentifier","text":"DirectedIncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The directed hypergraph’s incidence graph as a lazy "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", an arc from each source to its hyperedge"},{"type":"text","text":" "},{"type":"text","text":"and from the hyperedge to each target (XGI’s directed "},{"type":"codeVoice","code":"to_bipartite_graph"},{"type":"text","text":"). Plain directed"},{"type":"text","text":" "},{"type":"text","text":"reachability, Gallo et al.’s “connected”, is "},{"type":"codeVoice","code":"descendants(of:)"},{"type":"text","text":" on it restricted to"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/incidenceGraph","title":"incidenceGraph"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/outDegreeHistogram()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outDegreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","type":"topic","title":"outDegreeHistogram()","i