graphs\/incidencelist\/isstronglyconnected","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isStronglyConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/isStronglyConnected","abstract":[{"type":"text","text":"Whether there is exactly one strongly connected component; false with no vertices."}],"title":"isStronglyConnected"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/dual()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11Hypergraphs13IncidenceListV","kind":"typeIdentifier","text":"IncidenceList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","title":"dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/dual()","url":"\/documentation\/hypergraphs\/incidencelist\/dual()","kind":"symbol","abstract":[{"type":"text","text":"The dual: the transpose of each plane (SimpleDirectedHypergraphs.jl’s convention, and"},{"type":"text","text":" "},{"code":"OrientedIncidenceMatrix.transposed()","type":"codeVoice"},{"type":"text","text":"). Its vertices are this hypergraph’s positions, in"},{"type":"text","text":" "},{"type":"text","text":"order, and its hyperedge "},{"code":"i","type":"codeVoice"},{"type":"text","text":" has sources "},{"code":"outHyperedges(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" and targets"},{"type":"text","text":" "},{"code":"inHyperedges(