ge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", an arc from each source to its hyperedge"},{"type":"text","text":" "},{"type":"text","text":"and from the hyperedge to each target (XGI’s directed "},{"code":"to_bipartite_graph","type":"codeVoice"},{"type":"text","text":"). Plain directed"},{"type":"text","text":" "},{"type":"text","text":"reachability, Gallo et al.’s “connected”, is "},{"code":"descendants(of:)","type":"codeVoice"},{"type":"text","text":" on it restricted to"},{"type":"text","text":" "},{"code":"0 ..< n","type":"codeVoice"},{"type":"text","text":"."}]},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs","title":"Hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/isBConnected(from:to:)":{"url":"\/documentation\/hypergraphs\/incidencelist\/isbconnected(from:to:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/isBConnected(from:to:)","title":"isBConnected(from:to:)","type":"topic","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"target"},{"type":"text","text":" is B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":": B-Visit from "},{"type":"codeVoice","code":"source"},{"type":"text","text":", stopping at "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBConnected","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{