,"type":"codeVoice"},{"text":" and ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" are together when each reaches the other","type":"text"},{"text":" ","type":"text"},{"text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the","type":"text"},{"text":" ","type":"text"},{"text":"incidence graph). They are the strong components of ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" restricted to the","type":"text"},{"text":" ","type":"text"},{"text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection","type":"text"},{"text":" ","type":"text"},{"text":"(SimpleDirectedHypergraphs.jl’s ","type":"text"},{"code":"get_strongly_connected_components","type":"codeVoice"},{"text":") is a different,","type":"text"},{"text":" ","type":"text"},{"text":"finer relation.","type":"text"}],"url":"\/documentation\/hypergraphs\/incidencelist\/stronglyconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]]"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/stronglyConnectedComponents()","title":"stronglyConnectedComponents()","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceList/isBFHypergraph":{"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencelist\/isbfhypergraph","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList\/isBFHypergraph","a