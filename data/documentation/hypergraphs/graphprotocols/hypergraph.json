":"]]","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","kind":"symbol","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020; HyperNetX’s "},{"type":"codeVoice","code":"s_connected_components"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges=True"},{"type":"text","text":"): the connected components of "},{"code":"lineGraph(s:)","type":"codeVoice"},{"type":"text","text":", as positions, without building"},{"type":"text","text":" "},{"type":"text","text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"code":"dual().sConnectedComponents(s:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","title":"sConnectedComponents(s:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isConnected":{"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isConnected","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isConnected","abstract":[{"type":"text","text":"Whether there is exactly one connected component: false with no vertices (the library’s"},{"type":"text","text":" "},{"type":"text","text":"rule; XGI raises). O(n + p α(n))."}],"title":"isConnected","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isconnected"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/incidenceGraph":{"type":"topic","role":"symbol","title":"incidenceGraph","abstract":[{"text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the","type":"text"},{"text":" ","type":"text"},{"text":"Levi graph), as a lazy ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":": vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"type":"codeVoice","code":"i"},{"text":", ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" is hyperedge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"each incidence is an edge, XGI’s ","type":"text"},{"type":"codeVoice","code":"to_bipartite_graph"},{"text":" numbering. Graph algorithms reach a","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph through it.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraph"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","kind":"typeIdentifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/incidenceGraph","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraph","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UndirectedAdjacencyList","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier"