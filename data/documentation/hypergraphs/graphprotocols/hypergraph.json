itle":"isUniform(size:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","abstract":[{"type":"text","text":"The clique expansion (Berge’s 2-section): every vertex, isolated ones included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order, and an edge between every two vertices that share a hyperedge, once,"},{"type":"text","text":" "},{"type":"text","text":"with no self-loops. Edges ascend by (index of u, index of v), u the lower. Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members is k(k − 1)\/2"},{"type":"text","text":" "},{"type":"text","text":"edges."}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","text":"UndirectedAdjacencyList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"cliqueExpansion()","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"type":"topic","role":"collection","abstract":[],"kind":"symbol","title":"GraphProtocols","url":"\/documentation\/hypergraphs\/graphprotocols","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/lineGraph(s:)":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The s-line graph (Aksoy et al. 2020): every position "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" as a vertex, in order, and an"},{"type":"text","text":" "},{"type":"text","text":"edge "},{"type":"codeVoice","code":"p"},{"type":"text","text":"–"},{"type":"codeVoice","code":"q"},{"type":"text","text":" ("},{"type":"codeVoice","code":"p < q"},{"type":"text","text":") when the two hyperedges share at least "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members. An empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge, or one sharing fewer than "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members with every other, is isolated. Edges ascend"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"(p, q)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/lineGraph(s:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/linegraph(s:)","title":"lineGraph(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/sConnectedComponents(s:)":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020): the connected components of "},{"type":"codeVoice","code":"lineGraph(s:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as positions, without building it. Singletons are kept, an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","title":"sConnectedComponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/incidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/incidenceGraphView","type":"topic","abstract":[{"text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the","type":"text"},{"text":" ","type":"text"},{"text":"Levi graph), as a lazy ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":": vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":", ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"each incidence is an edge. Graph algorithms reach a hypergraph through it.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraphview","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraphView"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","kind":"typeIdentifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"incidenceGraphView","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"dual()","role":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","kind":"symbol","abstract":[{"text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph’s positions, in order, and its hyperedge ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"’s set of hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"the dual is always defined; ","type":"text"},{"code":"dual().dual()","type":"codeVoice"},{"text":" is this hypergraph with its vertices relabeled","type":"text"},{"text":" ","type":"text"},{"text":"to their indices and its positions kept.","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/rank":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m)."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/rank","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rank","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"rank","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/rank","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The connected components: two vertices are together when a chain of hyperedges joins them."},{"type":"text","text":" "},{"type":"text","text":"Components are ordered by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"