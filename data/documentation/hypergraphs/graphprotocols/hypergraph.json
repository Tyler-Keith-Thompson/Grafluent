:"text","text":" itself."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","role":"symbol","title":"dual()","kind":"symbol","abstract":[{"text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph’s positions, in order, and its hyperedge ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"’s set of hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"the dual is always defined; ","type":"text"},{"code":"dual().dual()","type":"codeVoice"},{"text":" is this hypergraph with its vertices relabeled","type":"text"},{"text":" ","type":"text"},{"text":"to their indices and its positions kept.","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"title":"GraphProtocols","role":"collection","url":"\/documentation\/hypergraphs\/graphprotocols","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","kind":"symbol","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/incidenceGraphView":{"title":"incidenceGraphView","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraphView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"IncidenceGraphView","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/incidenceGraphView","abstract":[{"text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the","type":"text"},{"text":" ","type":"text"},{"text":"Levi graph), as a lazy ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":": vertex index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" is vertex ","type":"text"},{"type":"codeVoice","code":"i"},{"text":", ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" is hyperedge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"each incidence is an edge. Graph algorithms reach a hypergraph through it.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/connectedcomponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","type":"topic","title":"connectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":"]]","kind":"text"}],"role":"symbol","abstract":[{"text":"The connected components: two vertices are together when a chain of hyperedges joins them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are ordered by their least vertex index and list their vertices in index order;","type":"text"},{"text":" ","type":"text"},{"text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no","type":"text"},{"text":" ","type":"text"},{"text":"components.","type":"text"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"title":"cliqueExpansion()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","kind":"symbol","role":"symbol","abstract":[{"text":"The clique expansion (Berge’s 2-section): every vertex, isolated ones included, in","type":"text"},{"text":" ","type":"text"},{"text":"vertex-index order, and an edge between every two vertices that share a hyperedge, once,","type":"text"},{"text":" ","type":"text"},{"text":"with no self-loops. Edges ascend by (index of u, index of v), u the lower. Singletons and","type":"text"},{"text":" ","type":"text"},{"text":"empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members is k(k − 1)\/2","type":"text"},{"text":" ","type":"text"},{"text":"edges.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph":{"title":"Hypergraph","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP","text":"Hypergraph","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs":{"title":"Hypergraphs","role":"collection","url":"\/documentation\/hypergraphs","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","abstract":[],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isUniform(size:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","abstract":[{"text":"Whether every hyperedge has exactly ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" members (Berge’s k-uniform). Singletons and","type":"text"},{"text":" ","type":"text"},{"text":"empty hyperedges count; vacuously true with no hyperedges. O(m).","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUniform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"isUniform(size:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/sConnectedComponents(s:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)","type":"topic","title":"sConnectedComponents(s:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]]"}],"role":"symbol","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020): the connected components of "},{"type":"codeVoice","code":"lineGraph(s:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as positions, without building it. Singletons are kept, an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}],"kind":"symbol"}}}