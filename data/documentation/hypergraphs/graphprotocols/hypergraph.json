 "},{"type":"codeVoice","code":"get_linegraph"},{"type":"text","text":"): every position "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" as a vertex, in order, and an edge "},{"type":"codeVoice","code":"p"},{"type":"text","text":"–"},{"type":"codeVoice","code":"q"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"p < q"},{"type":"text","text":") when the two hyperedges share at least "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members. An empty hyperedge, or one"},{"type":"text","text":" "},{"type":"text","text":"sharing fewer than "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members with every other, is isolated. Edges ascend by "},{"type":"codeVoice","code":"(p, q)"},{"type":"text","text":"."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isConnected":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isconnected","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"type":"topic","kind":"symbol","title":"isConnected","abstract":[{"type":"text","text":"Whether there is exactly one connected component: false with no vertices (the library’s"},{"type":"text","text":" "},{"type":"text","text":"rule; XGI raises). O(n + p α(n))."}],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/rank":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/rank","abstract":[{"type":"text","text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m)."}],"kind":"symbol","role":"symbol","title":"rank","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rank"},{