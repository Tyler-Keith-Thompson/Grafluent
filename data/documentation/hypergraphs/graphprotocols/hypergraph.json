otocols/Hypergraph":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph","kind":"symbol","type":"topic","title":"Hypergraph","abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP","kind":"identifier"}],"navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","kind":"symbol","type":"topic","title":"dual()","abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges."},{"type":"text","text":" "},{"type":"text","text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so"},{"type":"text","text":" "},{"type":"text","text":"the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this hypergraph with its vertices relabeled"},{"type":"text","text":" "},{"type":"text","text":"to their indices and its positions kept."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseId