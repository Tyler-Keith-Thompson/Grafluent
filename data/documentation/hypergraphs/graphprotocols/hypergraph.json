 reach a hypergraph through it."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"abstract":[],"type":"topic","role":"collection","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","url":"\/documentation\/hypergraphs\/graphprotocols","title":"GraphProtocols","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/hyperedgeSizeHistogram()":{"abstract":[{"text":"Element ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" counts the hyperedges of size ","type":"text"},{"type":"codeVoice","code":"k"},{"text":", up to the rank; ","type":"text"},{"type":"codeVoice","code":"[]"},{"text":" with no hyperedges.","type":"text"},{"text":" ","type":"text"},{"text":"O(m).","type":"text"}],"kind":"symbol","type":"topic","title":"hyperedgeSizeHistogram()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/hyperedgesizehistogram()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedgeSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/hyperedgeSizeHistogram()"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","url":"\/documentation\/graphprotocols\/hypergraph","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989)."}],"title":"Hypergraph","kind":"symbol","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"abstract":[{"type":"text","text":"The clique expansion (Berge’s 2-section): every vertex, isolated ones included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order, and an edge between every two vertices that share a hyperedge, once,"},{"type":"text","text":" "},{"type":"text","text":"with no self-loops. Edges ascend by (index of u, index of v), u the lower. Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members is k(k − 1)\/2"},{"type":"text","text":" "},{"type":"text","text":"edges."}],"kind":"symbol","type":"topic","title":"cliqueExpansion()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","text":"UndirectedAdjacencyList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","type":"topic","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","role":"collection","kind":"symbol","title":"Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph":{"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preci