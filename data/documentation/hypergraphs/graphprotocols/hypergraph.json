 et al. 2020): the connected components of "},{"type":"codeVoice","code":"lineGraph(s:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as positions, without building it. Singletons are kept, an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"code":"dual().sConnectedComponents(s:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]]"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","title":"sConnectedComponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isUniform(size:)":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUniform","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether every hyperedge has exactly "},{"type":"codeVoice","code":"size"},{"type":"text","text":" members (Berge’s k-uniform). Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges count; vacuously true with no hyperedges. O(m)."}],"title":"isUniform(size:)","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/connectedcomponents()","kind":"symbol","type":"topic","title":"connectedComponents()","abstract":[{"type":"text","text":"The connected components: two vertices are together when a chain of hyperedges joins them."},{"type":"text","text":" "},{"type":"text","text":"Components are ordered by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"role":"symbol"}}}