":"text"},{"code":"Graph","type":"codeVoice"},{"text":": vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":", ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"each incidence is an edge, XGI’s ","type":"text"},{"code":"to_bipartite_graph","type":"codeVoice"},{"text":" numbering. Graph algorithms reach a","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph through it.","type":"text"}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraphView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","text":"IncidenceGraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/neighbors(of:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neighbors","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/neighbors(of:)","title":"neighbors(of:)","role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/n