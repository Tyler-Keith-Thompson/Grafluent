idenceGraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"incidenceGraphView","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/lineGraph(s:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineGraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"title":"lineGraph(s:)","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/linegraph(s:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/lineGraph(s:)","kind":"symbol","abstract":[{"text":"The s-line graph (Aksoy et al. 2020): every position ","type":"text"},{"type":"codeVoice","code":"0..<m"},{"text":" as a vertex, in order, and an","type":"text"},{"text":" ","type":"text"},{"text":"edge ","type":"text"},{"type":"codeVoice","code":"p"},{"type":"text","text":"–"},{"code":"q","type":"codeVoice"},{"type":"text","text":" ("},{"code":"p < q","type":"codeVoice"},{"type":"text","text":") when the two hyperedges share at least "},{"code":"s","type":"codeVoice"},{"type":"text","text":" members. An empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge, or one sharing fewer than "},{"code":"s","type":"codeVoice"},{"type":"text","text":" members with every other, is isolated. Edges ascend"},{"type":"text","text":" "},{"type":"text","text":"by "},{"code":"(p, q)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"role":"collection","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","type":"topic","kind":"symbol","title":"Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","type":"topic","abstract":[{"type":"text","text":"The clique expansion (Berge’s 2-section): every vertex, isolated ones included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order, and an edge between every two vertices that share a hyperedge, once,"},{"type":"text","text":" "},{"type":"text","text":"with no self-loops. Edges ascend by (index of u, index of v), u the lower. Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members is k(k − 1)\/2"},{"type":"text","text":" "},{"type":"text","text":"edges."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"title":"cliqueExpansion()","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/rank":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifi