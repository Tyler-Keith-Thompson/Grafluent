abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges."},{"type":"text","text":" "},{"type":"text","text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so"},{"type":"text","text":" "},{"type":"text","text":"the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this hypergraph with its vertices relabeled"},{"type":"text","text":" "},{"type":"text","text":"to their indices and its positions kept."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","text":"UndirectedIncidenceList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"dual()","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/hyperedgeSizeHistogram()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedgeSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"hyperedgeSizeHistogram()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/hyperedgesizehistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphPro