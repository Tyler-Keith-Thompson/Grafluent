graph/sConnectedComponents(s:)":{"role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)","type":"topic","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020): the connected components of "},{"code":"lineGraph(s:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as positions, without building it. Singletons are kept, an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]]"}],"title":"sConnectedComponents(s:)","kind":"symbol"}}}