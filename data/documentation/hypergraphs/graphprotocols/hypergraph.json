ed by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/connectedcomponents()","role":"symbol","type":"topic","title":"connectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"kind":"text","text":"]]"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","url":"\/documentation\/hypergraphs\/graphprotocols","role":"collection","type":"topic","title":"GraphProtocols"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/incidenceGraphView":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraphView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","title":"incidenceGraphView","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraphview","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/incidenceGraphView","type":"topic","abstract":[{"type":"text","text":"The hypergraph’s incidence graph, Berge’s bipartite graph of