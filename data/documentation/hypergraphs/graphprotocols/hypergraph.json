rgraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"title":"dual()","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","kind":"typeIdentifier","text":"UndirectedIncidenceList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*), the transpose of the incidence: its vertices are this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges."},{"type":"text","text":" "},{"type":"text","text":"An isolated vertex becomes an empty hyperedge, and an empty hyperedge an isolated vertex, so"},{"type":"text","text":" "},{"type":"text","text":"the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this hypergraph with its vertices relabeled"},{"type":"text","text":" "},{"type":"text","text":"to their indices and its positions kept."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","title":"GraphProtocols","url":"\/documentation\/hypergraphs\/graphpro