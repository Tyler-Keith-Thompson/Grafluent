ges. O(m).","type":"text"}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","type":"topic","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","url":"\/documentation\/hypergraphs","title":"Hypergraphs","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBFHypergraph","kind":"symbol","role":"symbol","title":"isBFHypergraph","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbfhypergraph","abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target or exactly one source: a BF-graph. Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/incidenceGraphView":{"type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraphView","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/incidenceGraphView","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/incidencegraphview","abstract":[{"type":"text","text":"The directed hypergraph’s incidence graph as a lazy "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", an arc from each source to its hyperedge"},{"type":"text","text":" "},{"type":"text","text":"and from the hyperedge to each target (XGI’s directed "},{"type":"codeVoice","code":"to_bipartite_graph"},{"type":"text","text":"). Plain directed"},{"type":"text","text":" "},{"type":"text","text":"reachability, Gallo et al.’s “connected”, is "},{"type":"codeVoice","code":"descendants(of:)"},{"type":"text","text":" on it restricted to"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":"."}],"title":"incidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isStronglyConnected":{"title":"isStronglyConnected","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isStronglyConnected","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isstronglyconnected","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether there is exactly one strongly connected component; false with no vertices."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isStronglyConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/bConnectedVertices(from:)":{"type":"topic","title":"bConnectedVertices(from:)","abstract":[{"type":"text","text":"Every vertex B-connected to "},{"code":"source","type":"codeVoice"},{"type":"text","text":", "},{"code":"source","type":"codeVoice"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"code":"b_visit","type":"codeVoice"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/outDegreeHistogram()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outDegreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/outDegreeHistogram()","kind":"symbol","role":"symbol","title":"outDegreeHistogram()","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/outdegreehistogram()","type":"topic","abstract":[{"text":"Element ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" counts the vertices with ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" out-hyperedges; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no vertices. O(n).","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/dual()":{"type":"topic","title":"dual()","abstract":[{"type":"text","text":"The dual: the transpose of each plane (SimpleDirectedHypergraphs.jl’s convention, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"OrientedIncidenceMatrix.transposed()"},{"type":"text","text":"). Its vertices are this hypergraph’s positions, in"},{"type":"text","text":" "},{"type":"text","text":"order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" has sources "},{"type":"codeVoice","code":"outHyperedges(ofIndex: i)"},{"type":"text","text":" and targets"},{"type":"text","text":" "},{"type":"codeVoice","code":"inHyperedges(ofIndex: i)"},{"type":"text","text":". An isolated vertex becomes the empty hyperedge "},{"type":"codeVoice","code":"{} → {}"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"back."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/dual()","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/dual()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11Hypergraphs13IncidenceListV","kind":"typeIdentifier","text":"IncidenceList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFConnected(from:to:)":{"type":"topic","title":"isFConnected(from:to:)","abstract":[{"text":"Whether there is an F-path from ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"target","type":"codeVoice"},{"text":": one whose symmetric image is a B-path","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", so every target of a hyperedge it uses must lead on to ","type":"text"},{"code":"target","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"F-Visit from ","type":"text"},{"code":"target","type":"codeVoice"},{"text":", stopping at ","type":"text"},{"code":"source","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfconnected(from:to:)","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFConnected(from:to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFConnected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/directedhypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"title":"DirectedHypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBConnected(from:to:)":{"type":"topic","title":"isBConnected(from:to:)","abstract":[{"text":"Whether ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" is B-connected to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":": B-Visit from ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", stopping at ","type":"text"},{"code":"target","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbconnected(from:to:)","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBConnected(from:to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBConnected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isWeaklyConnected":{"type":"topic","title":"isWeaklyConnected","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isWeaklyConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isWeaklyConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether there is exactly one weakly connected component; false with no vertices."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isweaklyconnected","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/weaklyConnectedComponents()":{"type":"topic","title":"weaklyConnectedComponents()","abstract":[{"type":"text","text":"The weakly connected components: vertices joined through either side of a chain of"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. Ordered by least vertex index, each in index order; an isolated vertex is alone."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/weaklyconnectedcomponents()","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/weaklyConnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weaklyConnectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]]"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBHypergraph":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBHypergraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether every hyperedge has exactly one target: a B-graph (Gallo et al.‘s backward","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph; halp’s ","type":"text"},{"type":"codeVoice","code":"is_B_hypergraph"},{"text":"). Vacuously true with no hyperedges. O(m).","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBHypergraph","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbhypergraph","role":"symbol","title":"isBHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/stronglyConnectedComponents()":{"type":"topic","title":"stronglyConnectedComponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":"]]","kind":"text"}],"abstract":[{"type":"text","text":"The strongly connected components: "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" are together when each reaches the other"},{"type":"text","text":" "},{"type":"text","text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the"},{"type":"text","text":" "},{"type":"text","text":"incidence graph). They are the strong components of "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" restricted to the"},{"type":"text","text":" "},{"type":"text","text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection"},{"type":"text","text":" "},{"type":"text","text":"(SimpleDirectedHypergraphs.jl’s "},{"type":"codeVoice","code":"get_strongly_connected_components"},{"type":"text","text":") is a different,"},{"type":"text","text":" "},{"type":"text","text":"finer relation."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()","role":"symbol","kind":"symbol"}}}