"text":"() -> ","kind":"text"},{"text":"AdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule0aB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/fConnectedVertices(to:)":{"title":"fConnectedVertices(to:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Every vertex "},{"code":"s","type":"codeVoice"},{"type":"text","text":" such that "},{"code":"target","type":"codeVoice"},{"type":"text","text":" is F-connected to "},{"code":"s","type":"codeVoice"},{"type":"text","text":", "},{"code":"target","type":"codeVoice"},{"type":"text","text":" included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order. Gallo et al.: “the F-Visit must start from the destination of the"},{"type":"text","text":" "},{"type":"text","text":"F-paths to retain a linear time complexity”; it is B-Visit on the symmetric image, so it"},{"type":"text","text":" "},{"type":"text","text":"equals "},{"code":"reversed.bConnectedVertices(from: target)","type":"codeVoice"},{"type":"text","text":" (halp’s "},{"code":"f_visit","type":"codeVoice"},{"type":"text","text":"), and a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no targets never fires."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/fconnectedvertices(to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6V