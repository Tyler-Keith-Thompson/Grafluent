s ","type":"text"},{"code":"b_visit","type":"codeVoice"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","title":"bConnectedVertices(from:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"title":"isBFHypergraph","abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target or exactly one source: a BF-graph. Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBFHypergraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBFHypergraph","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbfhypergraph","type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFHypergraph":{"title":"isFHypergraph","kind":"symbol","abstract":[{"text":"Whether every hyperedge has exactly one source: an F-graph (forward hypergraph). Vacuously","type":"text"},{"text":" ","type":"text"},{"text":"true with no hyperedges. O(m).","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFHypergraph","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kin