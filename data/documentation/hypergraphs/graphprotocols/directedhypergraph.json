to its hyperedge","type":"text"},{"text":" ","type":"text"},{"text":"and from the hyperedge to each target. Plain directed reachability, Gallo et al.’s","type":"text"},{"text":" ","type":"text"},{"text":"“connected”, is ","type":"text"},{"code":"descendants(of:)","type":"codeVoice"},{"text":" on it restricted to ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraphView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV","text":"DirectedIncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/incidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/cliqueExpansion()":{"title":"cliqueExpansion()","kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/cliqueexpansion()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule0aB0V","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The directed clique expansion: every vertex, isolated ones included, in vertex-index order,"},{"type":"text","text":" "},{"type":"text","text":"and an arc "},{"type":"codeVoice","code":"u → v"},{"type":"text","text":" when some hyperedge has "},{"type":"codeVoice","code":"u"},{"type":"text","text":" among its sources and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets,"},{"type":"text","text":" "},{"type":"codeVoice","code":"u ≠ v"},{"type":"text","text":", once per pair. Arcs ascend by (index of u, index of v). A hyperedge with an empty"},{"type":"text","text":" "},{"type":"text","text":"side adds none."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/cliqueExpansion()","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/targetSizeHistogram()":{"type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/targetsizehistogram()","title":"targetSizeHistogram()","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"k"},{"type":"text","text":" counts the hyperedges with "},{"type":"codeVoice","code":"k"},{"type":"text","text":" targets; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no hyperedges. O(m)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"targetSizeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"]"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/targetSizeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFConnected(from:to:)":{"title":"isFConnected(from:to:)","kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfconnected(from:to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFConnected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","pr