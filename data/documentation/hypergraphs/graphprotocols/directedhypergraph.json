","type":"codeVoice"},{"text":" with no","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges. O(m).","type":"text"}],"title":"sourceSizeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/sourceSizeHistogram()","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFHypergraph":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfhypergraph","title":"isFHypergraph","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFHypergraph","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Whether every hyperedge has exactly one source: an F-graph (forward hypergraph). Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/stronglyConnectedComponents()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()","type":"topic","title":"stronglyConnectedComponents()","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]]"}],"abstract":[{"type":"text","text":"The strongly connected components: "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" are together when each reaches the other"},{"type":"text","text":" "},{"type":"text","text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the"},{"type":"text","text":" "},{"type":"text","text":"incidence graph). They are the strong components of "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" restricted to the"},{"type":"text","text":" "},{"type":"text","text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection"},{"type":"text","text":" "},{"type":"text","text":"(SimpleDirectedHypergraphs.jl’s "},{"type":"codeVoice","code":"get_strongly_connected_components"},{"type":"text","text":") is a different,"},{"type":"text","text":" "},{"type":"text","text":"finer relation."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/targetSizeHistogram()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"targetSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/targetsizehistogram()","title":"targetSizeHistogram()","abstract":[{"text":"Element ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" counts the hyperedges with ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" targets (XGI’s ","type":"text"},{"type":"codeVoice","code":"head_size"},{"text":"); ","type":"text"},{"type":"codeVoice","code":"[]"},{"text":" with no","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges. O(m).","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/targetSizeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/dual()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/dual()","type":"topic","title":"dual()","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/dual()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11Hypergraphs13IncidenceListV","kind":"typeIdentifier","text":"IncidenceList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP10HyperedgesQa","kind":"typeIdentifier","text":"Hyperedges"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier","text":"Index"},{"kind":"text","text":">"}],"abstract":[{"text":"The dual: the transpose of each plane (SimpleDirectedHypergraphs.jl’s convention, and","type":"text"},{"text":" ","type":"text"},{"code":"OrientedIncidenceMatrix.transposed()","type":"codeVoice"},{"text":"). Its vertices are this hypergraph’s positions, in","type":"text"},{"text":" ","type":"text"},{"text":"order, and its hyperedge ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" has sources ","type":"text"},{"code":"outHyperedges(ofIndex: i)","type":"codeVoice"},{"text":" and targets","type":"text"},{"text":" ","type":"text"},{"code":"inHyperedges(ofIndex: i)","type":"codeVoice"},{"text":". An isolated vertex becomes the empty hyperedge ","type":"text"},{"code":"{} → {}","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"back.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/incidenceGraphView":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraphView","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV","text":"DirectedIncidenceGraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/incidencegraphview","title":"incidenceGraphView","abstract":[{"type":"text","text":"The directed hypergraph’s incidence graph as a lazy "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", an arc from each source to its hyperedge"},{"type":"text","text":" "},{"type":"text","text":"and from the hyperedge to each target (XGI’s directed "},{"type":"codeVoice","code":"to_bipartite_graph"},{"type":"text","text":"). Plain directed"},{"type":"text","text":" "},{"type":"text","text":"reachability, Gallo et al.’s “connected”, is "},{"type":"codeVoice","code":"descendants(of:)"},{"type":"text","text":" on it restricted to"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/incidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbfhypergraph","type":"topic","title":"isBFHypergraph","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBFHypergraph","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target or exactly one source: a BF-graph. Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"abstract":[],"url":"\/documentation\/hypergraphs\/graphprotocols","role":"collection","kind":"symbol","title":"GraphProtocols","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isWeaklyConnected":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isWeaklyConnected","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isweaklyconnected","title":"isWeaklyConnected","abstract":[{"type":"text","text":"Whether there is exactly one weakly connected component; false with no vertices."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isWeaklyConnected"},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","kind":"symbol","role":"collection","abstract":[],"title":"Hypergraphs","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/outDegreeHistogram()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/outdegreehistogram()","type":"topic","title":"outDegreeHistogram()","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/outDegreeHistogram()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outDegreeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices with "},{"type":"codeVoice","code":"d"},{"type":"text","text":" out-hyperedges; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no vertices. O(n)."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/weaklyConnectedComponents()":{"title":"weaklyConnectedComponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/weaklyConnectedComponents()","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weaklyConnectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"abstract":[{"type":"text","text":"The weakly connected components: vertices joined through either side of a chain of"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. Ordered by least vertex index, each in index order; an isolated vertex is alone."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/weaklyconnectedcomponents()","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFConnected(from:to:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfconnected(from:to:)","title":"isFConnected(from:to:)","type":"topic","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFConnected(from:to:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFConnected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether there is an F-path from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":": one whose symmetric image is a B-path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"target"},{"type":"text","text":" to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", so every target of a hyperedge it uses must lead on to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"F-Visit from "},{"type":"codeVoice","code":"target"},{"type":"text","text":", stopping at "},{"type":"codeVoice","code":"source"},{"type":"text","text":"."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isStronglyConnected":{"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isStronglyConnected","type":"topic","title":"isStronglyConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isStronglyConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether there is exactly one strongly connected component; false with no vertices.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isstronglyconnected","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"url":"\/documentation\/graphprotocols\/directedhypergraph","type":"topic","title":"DirectedHypergraph","role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"code":"DiHypergraph","type":"codeVoice"},{"type":"text","text":" allows both)."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/fConnectedVertices(to:)":{"title":"fConnectedVertices(to:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/fConnectedVertices(to:)","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"Every vertex "},{"type":"codeVoice","code":"s"},{"type":"text","text":" such that "},{"type":"codeVoice","code":"target"},{"type":"text","text":" is F-connected to "},{"type":"codeVoice","code":"s"},{"type":"text","text":", "},{"type":"codeVoice","code":"target"},{"type":"text","text":" included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order. Gallo et al.: “the F-Visit must start from the destination of the"},{"type":"text","text":" "},{"type":"text","text":"F-paths to retain a linear time complexity”; it is B-Visit on the symmetric image, so it"},{"type":"text","text":" "},{"type":"text","text":"equals "},{"type":"codeVoice","code":"reversed.bConnectedVertices(from: target)"},{"type":"text","text":" (halp’s "},{"type":"codeVoice","code":"f_visit"},{"type":"text","text":"), and a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no targets never fires."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/fconnectedvertices(to:)","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/bConnectedVertices(from:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","type":"topic","title":"bConnectedVertices(from:)","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"type":"codeVoice","code":"b_visit"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}]}}}