mbol","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices with "},{"type":"codeVoice","code":"d"},{"type":"text","text":" out-hyperedges; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no vertices. O(n)."}],"title":"outDegreeHistogram()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outDegreeHistogram"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":"]"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/outDegreeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFConnected(from:to:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFConnected(from:to:)","type":"topic","abstract":[{"type":"text","text":"Whether there is an F-path from "},{"type":"codeVoice","code":"source"},{"type":"text","text":" to "},{"type":"codeVoice","code":"target"},{"type":"text","text":": one whose symmetric image is a B-path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"target"},{"type":"text","text":" to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", so every target of a hyperedge it uses must lead on to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"F-Visit from "},{"type":"codeVoice","code":"target"},{"type":"text","text":", stopping at "},{"type":"codeVoice","code":"source"},{"type":"text","text":"."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfconnected(from:to:)","role":"symbol","kind":"symbol","title":"isFConnected(from:to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFConnected","kind":"identif