","text":"(SimpleDirectedHypergraphs.jl’s "},{"code":"get_strongly_connected_components","type":"codeVoice"},{"type":"text","text":") is a different,"},{"type":"text","text":" "},{"type":"text","text":"finer relation."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]]"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","type":"topic","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/targetSizeHistogram()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/targetsizehistogram()","abstract":[{"text":"Element ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" counts the hyperedges with ","type":"text"},{"code":"k","type":"codeVoice"},{"text":" targets (XGI’s ","type":"text"},{"code":"head_size","type":"codeVoice"},{"text":"); ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges. O(m).","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"targetSizeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"title":"targetSizeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/targetSizeHistogram()","kind":"symbol","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtoco