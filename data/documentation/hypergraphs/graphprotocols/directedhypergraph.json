/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","kind":"symbol","abstract":[{"text":"The strongly connected components: ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" are together when each reaches the other","type":"text"},{"text":" ","type":"text"},{"text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the","type":"text"},{"text":" ","type":"text"},{"text":"incidence graph). They are the strong components of ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" restricted to the","type":"text"},{"text":" ","type":"text"},{"text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection","type":"text"},{"text":" ","type":"text"},{"text":"(SimpleDirectedHypergraphs.jl’s ","type":"text"},{"code":"get_strongly_connected_components","type":"codeVoice"},{"text":") is a different,","type":"text"},{"text":" ","type":"text"},{"text":"finer relation.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()","title":"stronglyConnectedComponents()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols":{"abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","type":"topic","title":"GraphProtocols","url":"\/documentation\/hypergraphs\/graphprotocols","role":"collection","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFHypergraph":{"type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isFHypergraph","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFHypergraph","url":"\/documentation\/hypergraphs\/