eVoice","code":"s"},{"text":", ","type":"text"},{"type":"codeVoice","code":"target"},{"text":" included, in","type":"text"},{"text":" ","type":"text"},{"text":"vertex-index order. Gallo et al.: “the F-Visit must start from the destination of the","type":"text"},{"text":" ","type":"text"},{"text":"F-paths to retain a linear time complexity”; it is B-Visit on the symmetric image, so it","type":"text"},{"text":" ","type":"text"},{"text":"equals ","type":"text"},{"type":"codeVoice","code":"reversed.bConnectedVertices(from: target)"},{"text":" (halp’s ","type":"text"},{"type":"codeVoice","code":"f_visit"},{"text":"), and a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no targets never fires.","type":"text"}],"title":"fConnectedVertices(to:)","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/fconnectedvertices(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph":{"title":"DirectedHypergraph","abstract":[],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"type":"t