graphs/GraphProtocols/DirectedHypergraph/isFConnected(from:to:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFConnected(from:to:)","title":"isFConnected(from:to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFConnected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol","role":"symbol","abstract":[{"text":"Whether there is an F-path from ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"target","type":"codeVoice"},{"text":": one whose symmetric image is a B-path","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from "},{"type":"codeVoice","code":"target"},{"type":"text","text":" to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", so every target of a hyperedge it uses must lead on to "},{"type":"codeVoice","code":"target"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"F-Visit from "},{"type":"codeVoice","code":"target"},{"type":"text","text":", stopping at "},{"type":"codeVoice","code":"source"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfconnected(from:to:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"identifier":"doc: