keyword"},{"text":" ","kind":"text"},{"text":"targetSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/cliqueExpansion()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule0aB0V","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"title":"cliqueExpansion()","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/cliqueExpansion()","abstract":[{"type":"text","text":"The directed clique expansion (SimpleDirectedHypergraphs.jl’s "},{"type":"codeVoice","code":"TwoSectionView"},{"type":"text","text":"): every"},{"type":"text","text":" "},{"type":"text","text":"vertex, isolated ones included, in vertex-index order, and an arc "},{"type":"codeVoice","code":"u → v"},{"type":"text","text":" when some"},{"type":"text","text":" "},{"type":"text","text":"hyperedge has "},{"type":"codeVoice","code":"u"},{"type":"text","text":" among its sources and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets, "},{"type":"codeVoice","code":"u ≠ v"},{"type":"text","text":", once per pair."},{"type":"text","text":" "},{"type":"text","text":"Arcs ascend by (index of u, index of v). A hyperedge with an empty side adds none."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/cliqueexpansion()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBConnected(from:to:)"