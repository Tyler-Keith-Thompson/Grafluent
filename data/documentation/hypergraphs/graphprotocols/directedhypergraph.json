 dual: the transpose of each plane. Its vertices are this hypergraph’s positions, in"},{"type":"text","text":" "},{"type":"text","text":"order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" has sources "},{"type":"codeVoice","code":"outHyperedges(ofIndex: i)"},{"type":"text","text":" and targets"},{"type":"text","text":" "},{"type":"codeVoice","code":"inHyperedges(ofIndex: i)"},{"type":"text","text":". An isolated vertex becomes the empty hyperedge "},{"type":"codeVoice","code":"{} → {}"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"back."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"IncidenceList","preciseIdentifier":"s:11Hypergraphs13IncidenceListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP10HyperedgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/dual()"}}}