{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)"},"abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"code":"b_visit","type":"codeVoice"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L382","fileName":"DirectedHypergraphAlgorithms.swift"},"externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF","roleHeading":"Instance Method","symbolKind":"method","extendedModule":"GraphProtocols","modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}],"role":"symbol","title":"bConnectedVertices(from:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},