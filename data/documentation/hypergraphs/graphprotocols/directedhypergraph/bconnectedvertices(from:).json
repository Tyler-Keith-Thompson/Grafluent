{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)"},"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.’s B-Visit. A hyperedge fires once every one of its sources has been reached, and then"},{"type":"text","text":" "},{"type":"text","text":"reaches all its targets. On a directed graph read as a hypergraph this is reachability."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Instance Method","externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF","title":"bConnectedVertices(from:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]"}],"remoteSource":{"fileName":"DirectedHypergraphAlgorithms.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L311