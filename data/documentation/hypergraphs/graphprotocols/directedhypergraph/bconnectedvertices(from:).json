type":"codeVoice"},{"text":" (it has a source, and all its sources are B-connected). So ","type":"text"},{"inlineContent":[{"type":"text","text":"a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no sources never fires"}],"type":"strong"},{"text":": no path enters it, and B-Visit scans only the forward stars of","type":"text"},{"text":" ","type":"text"},{"text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it","type":"text"},{"text":" ","type":"text"},{"text":"vacuously from any start; Gallo et al.’s visit and halp do not.","type":"text"}]},{"type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"code":"source","type":"codeVoice"},{"type":"text","text":" is a vertex."}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m + p): one counter per hyperedge and one queue; one hash."}]}],"style":"note"}]}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph":{"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP","text":"DirectedHypergraph","kind":"identifier"}],"abstract":[],"title":"DirectedHypergraph","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/Vertex":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind