d all its sources are B-connected). So "},{"type":"strong","inlineContent":[{"text":"a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no sources never fires","type":"text"}]},{"type":"text","text":": no path enters it, and B-Visit scans only the forward stars of"},{"type":"text","text":" "},{"type":"text","text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it"},{"type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}],"type":"paragraph"},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"source","type":"codeVoice"},{"text":" is a vertex.","type":"text"}]}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n + m + p): one counter per hyperedge and one queue; one hash."}],"type":"paragraph"}]}]}],"metadata":{"roleHeading":"Instance Method","role":"symbol","modules":[{"relatedModules":["GraphProtocols"],"name":"Hypergraphs"}],"externalID":"s:14GraphProtocols18DirectedHypergraphP11HypergraphsE18bConnectedVertices4fromSay6VertexQzGAH_tF","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/DirectedHypergraphAlgorithms.swift#L383","fileName":"DirectedHypergraphAlgorithms.swift"},"extendedModule":"GraphProtocols","title":"bConnectedVertices(from:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"te