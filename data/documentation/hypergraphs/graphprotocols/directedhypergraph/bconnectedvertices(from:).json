{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":"]","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"B-connection here is path-based, as B-Visit computes it: ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is B-connected to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", or some hyperedge with ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" among its targets is entered along a path","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" (it has a source, and all its sources are B-connected). So ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no sources never fires"}]},{"text":": no path enters it, and B-Visit scans only the forward stars of","type":"text"},{"text":" ","type":"text"},{"text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it","type":"text"},{"text":" ","type":"text"},{"text":"vacuously from any start; Gallo et al.’s visit and halp do not.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" is a vertex."}]}],"type":"aside","style":"note","name":"Precondition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n + m + p): one counter per hyperedge and one queue; one hash."}]}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"code":"source","type":"codeVoice"},{"type":"text","text":", "},{"code":"source","type":"codeVoice"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"code":"b_visit","type":"codeVoice"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)"]}],"metadata":{"role":"sy