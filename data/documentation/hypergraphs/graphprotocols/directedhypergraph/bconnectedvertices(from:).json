type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"source","type":"codeVoice"},{"text":" is a vertex.","type":"text"}]}],"type":"aside","name":"Precondition"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(n + m + p): one counter per hyperedge and one queue; one hash.","type":"text"}]}],"type":"aside","name":"Complexity"}]}],"abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"code":"b_visit","type":"codeVoice"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"references":{"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","type":"topic","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","url":"\/documentation\/hypergraphs","title":"Hypergraphs","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph\/Vertex","abstract":[],"url":"\/documentation\/graphprotocols\/directedhypergraph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"role":"symbol","kind":"symbol","type":"topic","title":"Vertex"},"doc://Hypergraphs/docu