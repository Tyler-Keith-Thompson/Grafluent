ind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"B-connection here is path-based, as B-Visit computes it: ","type":"text"},{"code":"v","type":"codeVoice"},{"type":"text","text":" is B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":" "},{"text":"when ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", or some hyperedge with ","type":"text"},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets is entered along a path"},{"type":"text","text":" "},{"type":"text","text":"from "},{"code":"source","type":"codeVoice"},{"text":" (it has a source, and all its sources are B-connected). So ","type":"text"},{"inlineContent":[{"text":"a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no sources never fires","type":"text"}],"type":"strong"},{"text":": no path enters it, and B-Visit scans only the forward stars of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reached vertices. The recursive reading (“every source is B-connected”) would fire it"},{"type":"text","text":" "},{"type":"text","text":"vacuously from any start; Gallo et al.’s visit and halp do not."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"source"},{"type":"text","text":" is a vertex."}],"type":"paragraph"}],"style":"note","name":"Precondition"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(n + m + p): one counter per hyperedge and one queue; one hash."}],"type":"paragraph"}],"style":"note","name":"Complexity"}]}],"variants":[{"paths":["\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"bConnectedVertices(from:)","roleH