/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"Edge position ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is incidence number ","type":"text"},{"code":"q","type":"codeVoice"},{"text":": the incidences hyperedge by hyperedge, in index","type":"text"},{"text":" ","type":"text"},{"text":"order, and within a hyperedge in ","type":"text"},{"code":"memberIndices","type":"codeVoice"},{"text":" order. So ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(i, n + p)","type":"codeVoice"},{"text":", the rows of the hyperedge side are contiguous ranges, and a","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view is","type":"text"},{"text":" ","type":"text"},{"text":"a snapshot, so its own positions never change, but they are valid for the hypergraph only until","type":"text"},{"text":" ","type":"text"},{"text":"its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", inserting one cell shifts every later incidence by one), and a per-incidence","type":"text"},{"text":" ","type":"text"},{"text":"array must be rebuilt for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every index member reads the base’s rows: "},{"type":"codeVoice","code":"neighborIndices(ofIndex: i)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" shifted by n, and of "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt: p)"},{"type":"text","text":". "},{"type":"codeVoice","code":"Traversal"},{"type":"text","text":", "},{"type":"codeVoice","code":"Connectivity"},{"type":"text","text":", "},{"type":"codeVoice","code":"ShortestPaths"},{"type":"text","text":" and the rest"},{"type":"text","text":" "},{"type":"text","text":"therefore run on the view without hashing a vertex. "},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"type":"text","text":" writes the view’s"},{"type":"text","text":" "},{"type":"text","text":"rows out once per call from the base’s "},{"type":"codeVoice","code":"_withIncidenceRows"},{"type":"text","text":", in O(n + m + p), for whole-graph"},{"type":"text","text":" "},{"type":"text","text":"algorithms (components, bridges, cut vertices)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view keeps each hyperedge’s first incidence number, so a hyperedge’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"range, O(1). On "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":", which stores its incidences, every read is O(1) plus"},{"type":"text","text":" "},{"type":"text","text":"the row. On any other base, "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"type":"text","text":" binary-search the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge and find the member by its rank ("},{"type":"codeVoice","code":"_memberIndex(atRank:…)"},{"type":"text","text":"), O(log m + ⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" and O(log m + k) by default, and a vertex’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" finds its place in"},{"type":"text","text":" "},{"type":"text","text":"each of its hyperedges: O(d·⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", which counts bits, and O(Σ k) over"},{"type":"text","text":" "},{"type":"text","text":"them on a base without a faster "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)"},{"type":"text","text":" gives the bipartite structure,"},{"type":"text","text":" "},{"type":"text","text":"and the view’s components restricted to "},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" are the hypergraph’s."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"metadata":{"title":"IncidenceGraphView","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphV