{"topicSections":[{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"],"generated":true,"title":"Type Aliases","anchor":"Type-Aliases"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:11Hypergraphs18IncidenceGraphViewV","title":"IncidenceGraphView","roleHeading":"Structure","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L50","fileName":"IncidenceGraphView.swift"},"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"modules":[{"name":"Hypergraphs"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"symbolKind":"struct"},"kind":"symbol","identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","interfaceLanguage":"swift"},"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP","text":"Hypergraph","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges.","type":"text"}]},{"type":"text","text":" Edge position "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is incidence number "},{"type":"codeVoice","code":"q"},{"type":"text","text":": the incidences hyperedge by hyperedge, in"},{"type":"text","text":" "},{"type":"text","text":"index order, and within a hyperedge in "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" order. So "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(i, n + p)"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view"},{"type":"text","text":" "},{"type":"text","text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only"},{"type":"text","text":" "},{"type":"text","text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array must be rebuilt for it."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The LabeledGraph law.","type":"text"}],"type":"strong"},{"type":"text","text":" Every index member reads the base’s rows:"},{"type":"text","text":" "},{"code":"neighborIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"incidentHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" shifted by n, and of"},{"type":"text","text":" "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" it is "},{"code":"memberIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"type":"text","text":". So "},{"code":"Traversal","type":"codeVoice"},{"type":"text","text":", "},{"code":"Connectivity","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"ShortestPaths","type":"codeVoice"},{"type":"text","text":" and the rest run on the view without hashing a vertex. "},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"writes the view’s rows out once per call from the base’s "},{"code":"_withIncidenceRows","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an"},{"type":"text","text":" "},{"type":"text","text":"adjacency-list copy’s speed on every base."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Costs."}]},{"type":"text","text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" is a range, O(1). On "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":", which stores its incidences,"},{"type":"text","text":" "},{"type":"text","text":"every read is O(1) plus the row. On any other base, "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"type":"text","text":" "},{"type":"text","text":"binary-search the hyperedge and find the member by its rank ("},{"type":"codeVoice","code":"_memberIndex(atRank:…)"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" and O(log m + k) by default, and a vertex’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which counts bits, and O(Σ k) over them on a base without a faster "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BipartiteGraph(h.incidenceGraph, left: 0 ..< h.vertexCount)"},{"type":"text","text":" gives the bipartite structure,"},{"type":"text","text":" "},{"type":"text","text":"and the view’s components restricted to "},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" are the hypergraph’s."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Hypergraphs/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/Hypergraphs\/s16SendableMetatypeP","type":"unresolvable"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/init(base:)":{"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview\/init(base:)","role":"symbol","abstract":[{"type":"text","text":"The view of "},{"type":"codeVoice","code":"base"},{"type":"text","text":"."}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"base"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":")"}],"title":"init(base:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/degree(ofIndex:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","url":"\/documentation\/hypergraphs\/incidencegraphview\/degree(ofindex:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degree","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"tex