iew\/vertices"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"],"title":"Type Aliases"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"],"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Edge position ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is incidence number ","type":"text"},{"code":"q","type":"codeVoice"},{"text":": the incidences hyperedge by hyperedge, in index","type":"text"},{"text":" ","type":"text"},{"text":"order, and within a hyperedge in ","type":"text"},{"code":"memberIndices","type":"codeVoice"},{"text":" order. So ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(i, n + p)","type":"codeVoice"},{"text":", the rows of the hyperedge side are contiguous ranges, and a","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view is","type":"text"},{"text":" ","type":"text"},{"text":"a snapshot, so its own positions never change, but they are valid for the hypergraph only until","type":"text"},{"text":" ","type":"text"},{"text":"its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", inserting one cell shifts every later incidence by one), and a per-incidence","type":"text"},{"text":" ","type":"text"},{"text":"array must be rebuilt for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every index member reads the base’s rows: ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex: i)"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentHyperedgeIndices(ofIndex: i)"},{"text":" shifted by n, and of ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" it is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt: p)"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Traversal"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Connectivity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ShortestPaths"},{"text":" and the rest","type":"text"},{"text":" ","type":"text"},{"text":"therefore run on the view without hashing a vertex. ","type":"text"},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"text":" writes the view’s","type":"text"},{"text":" ","type":"text"},{"text":"rows out once per call from the base’s ","type":"text"},{"type":"codeVoice","code":"_withIncidenceRows"},{"text":", in O(n + m + p), for whole-graph","type":"text"},{"text":" ","type":"text"},{"text":"algorithms (components, bridges, cut vertices).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The view keeps each hyperedge’s first incidence number, so a hyperedge’s ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"range, O(1). On ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":", which stores its incidences, every read is O(1) plus","type":"text"},{"text":" ","type":"text"},{"text":"the row. On any other base, ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"text":" binary-search the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge and find the member by its rank (","type":"text"},{"code":"_memberIndex(atRank:…)","type":"codeVoice"},{"text":"), O(log m + ⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":" and O(log m + k) by default, and a vertex’s ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" finds its place in","type":"text"},{"text":" ","type":"text"},{"text":"each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", which counts bits, and O(Σ k) over","type":"text"},{"text":" ","type":"text"},{"text":"them on a base without a faster ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)","type":"codeVoice"},{"type":"text","text":" gives the bipartite structure,"},{"type":"text","text":" "},{"type":"text","text":"and the view’s components restricted to "},{"code":"0 ..< n","type":"codeVoice"},{"type":"text","text":" are the hypergraph’s."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"title":"Conforms To"}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertexIndexBound":{"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/vertexindexbound","type":"topic","title":"vertexIndexBound","abstract":[],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexIndexBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/contains(_:)":{"role":"symbol","type":"topic","title":"contains(_:)","url":"\/documentation\/hypergraphs\/incidencegraphview\/contains(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/incidentEdgeIndices(ofIndex:)":{"role":"symbol","type":"topic","title":"incidentEdgeIndices(ofIndex:)","url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeind