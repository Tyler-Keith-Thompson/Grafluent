{"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"externalID":"s:11Hypergraphs18IncidenceGraphViewV","symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"Hypergraphs"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L50","fileName":"IncidenceGraphView.swift"},"title":"IncidenceGraphView"},"kind":"symbol","topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"]},{"generated":true,"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP","text":"Hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"}],"platforms":["Linux"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges.","type":"text"}]},{"type":"text","text":" Edge position "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is incidence number "},{"code":"q","type":"codeVoice"},{"type":"text","text":": the incidences hyperedge by hyperedge, in"},{"type":"text","text":" "},{"type":"text","text":"index order, and within a hyperedge in "},{"code":"memberIndices","type":"codeVoice"},{"type":"text","text":" order. So "},{"code":"edges[q]","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"UndirectedEdge(i, n + p)","type":"codeVoice"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view"},{"type":"text","text":" "},{"type":"text","text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only"},{"type":"text","text":" "},{"type":"text","text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array must be rebuilt for it."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"The LabeledGraph law.","type":"text"}]},{"type":"text","text":" Every index member reads the base’s rows:"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighborIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"incidentHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" shifted by n, and of"},{"type":"text","text":" "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt: p)"},{"type":"text","text":". So "},{"type":"codeVoice","code":"Traversal"},{"type":"text","text":", "},{"type":"codeVoice","code":"Connectivity"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ShortestPaths"},{"type":"text","text":" and the rest run on the view without hashing a vertex. "},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"type":"text","text":" "},{"type":"text","text":"writes the view’s rows out once per call from the base’s "},{"type":"codeVoice","code":"_withIncidenceRows"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an"},{"type":"text","text":" "},{"type":"text","text":"adjacency-list copy’s speed on every base."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Costs."}],"type":"strong"},{"type":"text","text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s"},{"type":"text","text":" "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" is a range, O(1). On "},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":", which stores its incidences,"},{"type":"text","text":" "},{"type":"text","text":"every read is O(1) plus the row. On any other base, "},{"code":"edges[q]","type":"codeVoice"},{"type":"text","text":" and "},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"binary-search the hyperedge and find the member by its rank ("},{"code":"_memberIndex(atRank:…)","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"O(log m + ⌈n\/64⌉) on "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":" and O(log m + k) by default, and a vertex’s"},{"type":"text","text":" "},{"code":"incidentEdges","type":"codeVoice"},{"type":"text","text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which counts bits, and O(Σ k) over them on a base without a faster "},{"code":"_memberRank","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"type":"codeVoice","code":"0 ..< n"},{"text":" are the hypergraph’s.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencegraphview"]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertexIndex(of:)":{"url":"\/documentation\/hypergraphs\/incidencegraphview\/vertexindex(of:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexIndex","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"vertexIndex(of:)","abstract":[],"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/oppositeVertex(to:acrossEdgeAt:)":{"title":"oppositeVertex(to:acrossEdgeAt:)","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/oppositevertex(to:acrossedgeat:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"oppositeVertex","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","prec