{"kind":"symbol","abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0 ..< n + m"},{"text":" whose vertex ","type":"text"},{"type":"codeVoice","code":"i < n"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" and whose vertex ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", with an edge ","type":"text"},{"type":"codeVoice","code":"{i, n + p}"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"]},{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"]},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP","text":"Hypergraph","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges."}],"type":"strong"},{"type":"text","text":" Edge position "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is incidence number "},{"type":"codeVoice","code":"q"},{"type":"text","text":": the incidences hyperedge by hyperedge, in"},{"type":"text","text":" "},{"type":"text","text":"index order, and within a hyperedge in "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" order. So "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(i, n + p)"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view"},{"type":"text","text":" "},{"type":"text","text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only"},{"type":"text","text":" "},{"type":"text","text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array must be rebuilt for it."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"The LabeledGraph law.","type":"text"}]},{"type":"text","text":" Every index member reads the base’s rows:"},{"type":"text","text":" "},{"type":"codeVoice","code":"neighborIndices(ofIndex: i)"},{"type":"text","text":" is "},{"type":"codeVoice","code":"incidentHyperedgeIndices(ofIndex: i)"},{"type":"text","text":" shifted by n, and of"},{"type":"text","text":" "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" it is "},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt: p)"},{"type":"text","text":". So "},{"type":"codeVoice","code":"Traversal"},{"type":"text","text":", "},{"type":"codeVoice","code":"Connectivity"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ShortestPaths"},{"type":"text","text":" and the rest run on the view without hashing a vertex. "},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"type":"text","text":" "},{"type":"text","text":"writes the view’s rows out once per call from the base’s "},{"type":"codeVoice","code":"_withIncidenceRows"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an"},{"type":"text","text":" "},{"type":"text","text":"adjacency-list copy’s speed on every base."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Costs."}]},{"type":"text","text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" is a range, O(1). On "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":", which stores its incidences,"},{"type":"text","text":" "},{"type":"text","text":"every read is O(1) plus the row. On any other base, "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"type":"text","text":" "},{"type":"text","text":"binary-search the hyperedge and find the member by its rank ("},{"type":"codeVoice","code":"_memberIndex(atRank:…)"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" and O(log m + k) by default, and a vertex’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which counts bits, and O(Σ k) over them on a base without a faster "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"BipartiteGraph(h.incidenceGraph, left: 0 ..< h.vertexCount)","type":"codeVoice"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" are the hypergraph’s.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"metadata":{"roleHeading":"Structure","title":"IncidenceGraphView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"externalID":"s:11Hypergraphs18IncidenceGraphViewV","modules":[{"name":"Hypergraphs"}],"role":"symbol","symbolKind":"struct","remoteSource":{"fileName":"IncidenceGraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L50"},"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Hypergraphs/s16SendableMetatypeP":{"identifier":"doc:\/\/Hypergraphs\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/contains(_:)":{"kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/hypergraphs\/incidencegraphview\/contains(_:)","role":"symbol","title":"contains(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/init(base:)":{"abstract":[{"type":"text","text":"The view of "},{"type":"codeVoice","code":"base"},{"type":"text","text":"."}],"title":"init(base:)","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"base","kind":"externalParam"},{"text":"