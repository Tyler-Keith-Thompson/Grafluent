hView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"],"title":"Type Aliases","anchor":"Type-Aliases"},{"generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","text":"Hypergraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Edge position ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is incidence number ","type":"text"},{"code":"q","type":"codeVoice"},{"text":": the incidences hyperedge by hyperedge, in index","type":"text"},{"text":" ","type":"text"},{"text":"order, and within a hyperedge in ","type":"text"},{"code":"memberIndices","type":"codeVoice"},{"text":" order. So ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(i, n + p)","type":"codeVoice"},{"text":", the rows of the hyperedge side are contiguous ranges, and a","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view is","type":"text"},{"text":" ","type":"text"},{"text":"a snapshot, so its own positions never change, but they are valid for the hypergraph only until","type":"text"},{"text":" ","type":"text"},{"text":"its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", inserting one cell shifts every later incidence by one), and a per-incidence","type":"text"},{"text":" ","type":"text"},{"text":"array must be rebuilt for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every index member reads the base’s rows: "},{"code":"neighborIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"incidentHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" shifted by n, and of "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"code":"memberIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"type":"text","text":". "},{"code":"Traversal","type":"codeVoice"},{"type":"text","text":", "},{"code":"Connectivity","type":"codeVoice"},{"type":"text","text":", "},{"code":"ShortestPaths","type":"codeVoice"},{"type":"text","text":" and the rest"},{"type":"text","text":" "},{"type":"text","text":"therefore run on the view without hashing a vertex. "},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"type":"text","text":" writes the view’s"},{"type":"text","text":" "},{"type":"text","text":"rows out once per call from the base’s "},{"code":"_withIncidenceRows","type":"codeVoice"},{"type":"text","text":", in O(n + m + p), for whole-graph"},{"type":"text","text":" "},{"type":"text","text":"algorithms (components, bridges, cut vertices)."}],"type":"paragraph"},{"inlineContent":[{"text":"The view keeps each hyperedge’s first incidence number, so a hyperedge’s ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"range, O(1). On ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":", which stores its incidences, every read is O(1) plus","type":"text"},{"text":" ","type":"text"},{"text":"the row. On any other base, ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"text":" binary-search the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge and find the member by its rank (","type":"text"},{"code":"_memberIndex(atRank:…)","type":"codeVoice"},{"text":"), O(log m + ⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":" and O(log m + k) by default, and a vertex’s ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" finds its place in","type":"text"},{"text":" ","type":"text"},{"text":"each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", which counts bits, and O(Σ k) over","type":"text"},{"text":" ","type":"text"},{"text":"them on a base without a faster ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)"},{"type":"text","text":" gives the bipartite structure,"},{"type":"text","text":" "},{"type":"text","text":"and the view’s components restricted to "},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" are the hypergraph’s."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencegraphview"]}],"kind":"symbol","sections":[],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/init(base:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)","url":"\/documentation\/hypergraphs\/incidencegraphview\/init(base:)","role":"symbol","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"base","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"init(base:)","abstract":[{"text":"The view of ","type":"text"},{"code":"base","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","url":"\/documentation\/hypergraphs","title":"Hypergraphs","role":"collection","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Graph-Implementations":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations","kind":"article","title":"Graph Implementations","type":"topic","abstract":[],"role":"collectionGroup","url":"\/documentation\/hypergraphs\/incidencegraphview\/graph-implementations"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/edgeCount":{"url":"\/documentation\/hypergraphs\/incidencegraphview\/edgecount","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/Incidenc