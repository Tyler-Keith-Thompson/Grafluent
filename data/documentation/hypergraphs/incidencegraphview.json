{"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L48","fileName":"IncidenceGraphView.swift"},"symbolKind":"struct","externalID":"s:11Hypergraphs18IncidenceGraphViewV","modules":[{"name":"Hypergraphs"}],"role":"symbol","title":"IncidenceGraphView","roleHeading":"Structure","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"]},{"anchor":"Type-Aliases","title":"Type Aliases","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencegraphview"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP","kind":"typeIdentifier","text":"Hypergraph"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Edge position "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is incidence number "},{"type":"codeVoice","code":"q"},{"type":"text","text":": the incidences hyperedge by hyperedge, in index"},{"type":"text","text":" "},{"type":"text","text":"order, and within a hyperedge in "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" order. So "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(i, n + p)"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view is"},{"type":"text","text":" "},{"type":"text","text":"a snapshot, so its own positions never change, but they are valid for the hypergraph only until"},{"type":"text","text":" "},{"type":"text","text":"its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a per-incidence"},{"type":"text","text":" "},{"type":"text","text":"array must be rebuilt for it."}],"type":"paragraph"},{"inlineContent":[{"text":"Every index member reads the base’s rows: ","type":"text"},{"code":"neighborIndices(ofIndex: i)","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"incidentHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"text":" shifted by n, and of ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" it is","type":"text"},{"text":" ","type":"text"},{"code":"memberIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Traversal","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Connectivity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ShortestPaths","type":"codeVoice"},{"text":" and the rest","type":"text"},{"text":" ","type":"text"},{"text":"therefore run on the view without hashing a vertex. ","type":"text"},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"text":" writes the view’s","type":"text"},{"text":" ","type":"text"},{"text":"rows out once per call from the base’s ","type":"text"},{"code":"_withIncidenceRows","type":"codeVoice"},{"text":", in O(n + m + p), for whole-graph","type":"text"},{"text":" ","type":"text"},{"text":"algorithms (components, bridges, cut vertices).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view keeps each hyperedge’s first incidence number, so a hyperedge’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"range, O(1). On "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":", which stores its incidences, every read is O(1) plus"},{"type":"text","text":" "},{"type":"text","text":"the row. On any other base, "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"type":"text","text":" binary-search the"},{"type":"text","text":" "},{"type":"text","text":"hyperedge and find the member by its rank ("},{"type":"codeVoice","code":"_memberIndex(atRank:…)"},{"type":"text","text":"), O(log m + ⌈n\/64⌉) on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" and O(log m + k) by default, and a vertex’s "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" finds its place in"},{"type":"text","text":" "},{"type":"text","text":"each of its hyperedges: O(d·⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", which counts bits, and O(Σ k) over"},{"type":"text","text":" "},{"type":"text","text":"them on a base without a faster "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)"},{"type":"text","text":" gives the bipartite structure,"},{"type":"text","text":" "},{"type":"text","text":"and the view’s components restricted to "},{"type":"codeVoice","code":"0 ..< n"},{"type":"text","text":" are the hypergraph’s."}],"type":"paragraph"}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertexIndexBound":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","url":"\/documentation\/hypergraphs\/incidencegraphview\/vertexindexbound","role":"symbol","type":"topic","title":"vertexIndexBound","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexIndexBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/neighbors(of:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"neighbors"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"IncidenceGraphView","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Neighbors","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV9NeighborsV"}],"kind":"symbol","title":"neighbors(of:)","url":"\/documentation\/hypergraphs\/incidencegraphview\/neighbors(of:)","role":"symbol","identifier":"doc:\/\/Hypergraphs\/doc