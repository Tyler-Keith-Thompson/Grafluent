phs\/incidencegraphview\/neighbors","title":"IncidenceGraphView.Neighbors","abstract":[{"type":"text","text":"The neighbors of one vertex of the view: a vertex’s hyperedge indices shifted by n, or a"},{"type":"text","text":" "},{"type":"text","text":"hyperedge’s member indices, read from the base without boxing."}],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Neighbors","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Neighbors","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/init(base:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"base"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":")"}],"title":"init(base:)","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/init(base:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)","abstract":[{"type":"text","text":"The view of "},{"type":"codeVoice","code":"base"},{"type":"text","text":"."}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertices":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertices","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sn","text":"Range","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"vertices","type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/vertices","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices","abstract":[{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":". O(1)."}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"title":"Hypergraph","type":"topic","role":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/edgeIndex(of:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"edgeIndex"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"edgeIndex(of:)","type":"topic","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","abstract":[],"url":"\/documentation\/hypergraphs\/incidencegraphview\