\/Hypergraphs\/IncidenceGraphView\/vertices"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP","kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Edges.","type":"text"}],"type":"strong"},{"text":" Edge position ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is incidence number ","type":"text"},{"code":"q","type":"codeVoice"},{"text":": the incidences hyperedge by hyperedge, in","type":"text"},{"text":" ","type":"text"},{"text":"index order, and within a hyperedge in ","type":"text"},{"code":"memberIndices","type":"codeVoice"},{"text":" order. So ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(i, n + p)","type":"codeVoice"},{"text":", the rows of the hyperedge side are contiguous ranges, and a","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view","type":"text"},{"text":" ","type":"text"},{"text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only","type":"text"},{"text":" ","type":"text"},{"text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", inserting one cell shifts every later incidence by one), and a","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array must be rebuilt for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The LabeledGraph law."}],"type":"strong"},{"text":" Every index member reads the base’s rows:","type":"text"},{"text":" ","type":"text"},{"code":"neighborIndices(ofIndex: i)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"incidentHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"text":" shifted by n, and of","type":"text"},{"text":" ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" it is ","type":"text"},{"code":"memberIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"text":". So ","type":"text"},{"code":"Traversal","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Connectivity","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"ShortestPaths","type":"codeVoice"},{"text":" and the rest run on the view without hashing a vertex. ","type":"text"},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"text":" ","type":"text"},{"text":"writes the view’s rows out once per call from the base’s ","type":"text"},{"code":"_withIncidenceRows","type":"codeVoice"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an","type":"text"},{"text":" ","type":"text"},{"text":"adjacency-list copy’s speed on every base.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Costs."}],"type":"strong"},{"text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" is a range, O(1). On ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":", which stores its incidences,","type":"text"},{"text":" ","type":"text"},{"text":"every read is O(1) plus the row. On any other base, ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binary-search the hyperedge and find the member by its rank (","type":"text"},{"code":"_memberIndex(atRank:…)","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"O(log m + ⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":" and O(log m + k) by default, and a vertex’s","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which counts bits, and O(Σ k) over them on a base without a faster ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)","type":"codeVoice"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" are the hypergraph’s.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/edgeCount":{"title":"edgeCount","type":"topic","abstract":[{"type":"text","text":"The number of incidences. O(1)."}],"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/edgecount","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertexIndexBound":{"type":"topic","title":"vertexIndexBound","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertexIndexBound"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"?"}],"abstract":[],"url":"\/documentation\/hypergraphs\/incidencegraphview\/vertexindexbound","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Graph-Implemen