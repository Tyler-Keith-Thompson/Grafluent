f vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol"},"doc://Hypergraphs/s8SendableP":{"identifier":"doc:\/\/Hypergraphs\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/neighbors(of:)":{"url":"\/documentation\/hypergraphs\/incidencegraphview\/neighbors(of:)","title":"neighbors(of:)","type":"topic","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"neighbors"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","kind":"typeIdentifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">."},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV9NeighborsV","kind":"typeIdentifier","text":"Neighbors"}],"abstract":[{"type":"text","text":"The base’s rows: a vertex’s hyperedge indices shifted by n, or a hyperedge’s members."}]