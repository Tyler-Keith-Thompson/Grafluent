{"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0 ..< n + m"},{"text":" whose vertex ","type":"text"},{"type":"codeVoice","code":"i < n"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" and whose vertex ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", with an edge ","type":"text"},{"type":"codeVoice","code":"{i, n + p}"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\