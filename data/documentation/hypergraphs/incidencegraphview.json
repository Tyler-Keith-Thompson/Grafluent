 a","type":"text"},{"text":" ","type":"text"},{"text":"stored or computed row, or a contiguous range. Random access,","type":"text"},{"text":" ","type":"text"},{"text":"O(1) per element.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"IncidentEdgeIndices"}],"navigatorTitle":[{"kind":"identifier","text":"IncidentEdgeIndices"}],"type":"topic","title":"IncidenceGraphView.IncidentEdgeIndices","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/incidentEdges(of:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","abstract":[{"text":"The incidence numbers at ","type":"text"},{"type":"codeVoice","code":"vertex"},{"text":": a hyperedge’s range, O(1); a vertex’s stored row on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":", O(1), or its computed row on another base (O(d·⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":").","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedges(of:)","role":"symbol","title":"incidentEdges(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidentEdges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"IncidenceGraphView","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"IncidentEdgeIndices","preciseIdentifier":"s:11Hypergraphs18In