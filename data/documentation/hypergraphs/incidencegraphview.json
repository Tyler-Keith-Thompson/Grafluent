{"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencegraphview"]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"s:11Hypergraphs18IncidenceGraphViewV","remoteSource":{"fileName":"IncidenceGraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L50"},"symbolKind":"struct","title":"IncidenceGraphView","modules":[{"name":"Hypergraphs"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"role":"symbol"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"],"anchor":"Type-Aliases","generated":true,"title":"Type Aliases"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Edges."}],"type":"strong"},{"type":"text","text":" Edge position "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is incidence number "},{"code":"q","type":"codeVoice"},{"type":"text","text":": the incidences hyperedge by hyperedge, in"},{"type":"text","text":" "},{"type":"text","text":"index order, and within a hyperedge in "},{"code":"memberIndices","type":"codeVoice"},{"type":"text","text":" order. So "},{"code":"edges[q]","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"UndirectedEdge(i, n + p)","type":"codeVoice"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view"},{"type":"text","text":" "},{"type":"text","text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only"},{"type":"text","text":" "},{"type":"text","text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array must be rebuilt for it."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The LabeledGraph law.","type":"text"}],"type":"strong"},{"text":" Every index member reads the base’s rows:","type":"text"},{"text":" ","type":"text"},{"code":"neighborIndices(ofIndex: i)","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"incidentHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"text":" shifted by n, and of","type":"text"},{"text":" ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" it is ","type":"text"},{"code":"memberIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"text":". So ","type":"text"},{"code":"Traversal","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Connectivity","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"ShortestPaths","type":"codeVoice"},{"text":" and the rest run on the view without hashing a vertex. ","type":"text"},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"text":" ","type":"text"},{"text":"writes the view’s rows out once per call from the base’s ","type":"text"},{"code":"_withIncidenceRows","type":"codeVoice"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an","type":"text"},{"text":" ","type":"text"},{"text":"adjacency-list copy’s speed on every base.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Costs.","type":"text"}]},{"type":"text","text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" is a range, O(1). On "},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"type":"text","text":", which stores its incidences,"},{"type":"text","text":" "},{"type":"text","text":"every read is O(1) plus the row. On any other base, "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"type":"text","text":" "},{"type":"text","text":"binary-search the hyperedge and find the member by its rank ("},{"type":"codeVoice","code":"_memberIndex(atRank:…)"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"O(log m + ⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":" and O(log m + k) by default, and a vertex’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidentEdges"},{"type":"text","text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which counts bits, and O(Σ k) over them on a base without a faster "},{"type":"codeVoice","code":"_memberRank"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"BipartiteGraph(h.incidenceGraph, left: 0 ..< h.vertexCount)","type":"codeVoice"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" are the hypergraph’s.","type":"text"}]}]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/incidentEdgeIndices(ofIndex:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidentEdgeIndices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","text":"IncidenceGraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV19IncidentEdgeIndicesV","text":"IncidentEdgeIndices","kind":"typeIdentifier"}],"type":"topic","abstract":[],"title":"incidentEdgeIndices(ofIndex:)","url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices(ofindex:)","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/incidentEdges(of:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"incide