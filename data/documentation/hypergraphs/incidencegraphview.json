hs\/IncidenceGraphView\/Vertex"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo"}],"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"Hypergraphs"}],"externalID":"s:11Hypergraphs18IncidenceGraphViewV","remoteSource":{"fileName":"IncidenceGraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L48"},"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"symbolKind":"struct"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hypergraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edge position "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is incidence number "},{"type":"codeVoice","code":"q"},{"type":"text","text":": the incidences hyperedge by hyperedge, in index"},{"type":"text","text":" "},{"type":"text","text":"order, and within a hyperedge in "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" order. So "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(i, n + p)"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view is"},{"type":"text","text":" "},{"type":"text","text":"a snapshot, so its own positions never change, but they are valid for the hypergraph only until"},{"type":"text","text":" "},{"type":"text","text":"its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a per-incidence"},{"type":"text","text":" "},{"type":"text","text":"array must be rebuilt for it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every index member reads the base’s rows: "},{"code":"neighborIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"incidentHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" shifted by n, and of "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" it is"},{"type":"text","text":" "},{"code":"memberIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"type":"text","text":". "},{"code":"Traversal","type":"codeVoice"},{"type":"text","text":", "},{"code":"Connectivity","type":"codeVoice"},{"type":"text","text":", "},{"code":"ShortestPaths","type":"codeVoice"},{"type":"text","text":" and the rest"},{"type":"text","text":" "},{"type":"text","text":"therefore run on the view without hashing a vertex. "},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"type":"text","text":" writes the view’s"},{"type":"text","text":" "},{"type":"text","text":"rows out once per call from the base’s "},{"code":"_withIncidenceRows","type":"codeVoice"},{"type":"text","text":", in O(n + m + p), for whole-graph"},{"type":"text","text":" "},{"type":"text","text":"algorithms (components, bridges, cut vertices)."}]},{"type":"paragraph","inlineContent":[{"text":"The view keeps each hyperedge’s first incidence number, so a hyperedge’s ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"range, O(1). On ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":", which stores its incidences, every read is O(1) plus","type":"text"},{"text":" ","type":"text"},{"text":"the row. On any other base, ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"text":" binary-search the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge and find the member by its rank (","type":"text"},{"code":"_memberIndex(atRank:…)","type":"codeVoice"},{"text":"), O(log m + ⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":" and O(log m + k) by default, and a vertex’s ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" finds its place in","type":"text"},{"text":" ","type":"text"},{"text":"each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", which counts bits, and O(Σ k) over","type":"text"},{"text":" ","type":"text"},{"text":"them on a base without a faster ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)","type":"codeVoice"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" are the hypergraph’s.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Vertex":{"abstract":[],"navigatorTitle":[{"text":"Vertex","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex","type":"topic","kind":"symbol","title":"IncidenceGraphView.Vertex","url":"\/documentation\/hypergraphs\/incidencegraphview\/vertex","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/IncidentEdgeIndices":{"kind":"symbol","abstract":[{"type":"text","text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a"},{"type":"text","text":" "},{"type":"text","text":"stored or computed row, or a contiguous range. Random access,"},{"type":"text","text":" "},{"type":"text","text":"O(1) per element."}],"title":"IncidenceGraphView.IncidentEdgeIndices","role":"symbol","navigatorTitle":[{"text":"IncidentEdgeIndices","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"IncidentEdgeIndices","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct":{"title":"I