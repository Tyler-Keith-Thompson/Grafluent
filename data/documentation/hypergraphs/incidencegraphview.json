text"},{"text":" ","type":"text"},{"text":"O(1) per element.","type":"text"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","title":"IncidenceGraphView.IncidentEdgeIndices","role":"symbol","navigatorTitle":[{"text":"IncidentEdgeIndices","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","title":"Hypergraph","kind":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"type":"text","text":", 1989)."}],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/init(base:)":{"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/init(base:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)","abstract":[{"text":"The view of ","type":"text"},{"code":"base","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","title":"init(base:)","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"base","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Graph-Implementations":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGr