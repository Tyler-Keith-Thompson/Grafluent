{"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"topicSections":[{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"],"generated":true,"anchor":"Type-Aliases","title":"Type Aliases"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"sections":[],"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Edges.","type":"text"}]},{"type":"text","text":" Edge position "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is incidence number "},{"type":"codeVoice","code":"q"},{"type":"text","text":": the incidences hyperedge by hyperedge, in"},{"type":"text","text":" "},{"type":"text","text":"index order, and within a hyperedge in "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" order. So "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(i, n + p)"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view"},{"type":"text","text":" "},{"type":"text","text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only"},{"type":"text","text":" "},{"type":"text","text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array must be rebuilt for it."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The LabeledGraph law.","type":"text"}],"type":"strong"},{"type":"text","text":" Every index member reads the base’s rows:"},{"type":"text","text":" "},{"code":"neighborIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" is "},{"code":"incidentHyperedgeIndices(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" shifted by n, and of"},{"type":"text","text":" "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" it is "},{"code":"memberIndices(ofHyperedgeAt: p)","type":"codeVoice"},{"type":"text","text":". So "},{"code":"Traversal","type":"codeVoice"},{"type":"text","text":", "},{"code":"Connectivity","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"ShortestPaths","type":"codeVoice"},{"type":"text","text":" and the rest run on the view without hashing a vertex. "},{"code":"_withIncidentIndexRows","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"writes the view’s rows out once per call from the base’s "},{"code":"_withIncidenceRows","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"text","text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an"},{"type":"text","text":" "},{"type":"text","text":"adjacency-list copy’s speed on every base."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Costs.","type":"text"}],"type":"strong"},{"text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" is a range, O(1). On ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":", which stores its incidences,","type":"text"},{"text":" ","type":"text"},{"text":"every read is O(1) plus the row. On any other base, ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binary-search the hyperedge and find the member by its rank (","type":"text"},{"code":"_memberIndex(atRank:…)","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"O(log m + ⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":" and O(log m + k) by default, and a vertex’s","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which counts bits, and O(Σ k) over them on a base without a faster ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"BipartiteGraph(h.incidenceGraph, left: 0 ..< h.vertexCount)"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"type":"codeVoice","code":"0 ..< n"},{"text":" are the hypergraph’s.","type":"text"}]}]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"title":"IncidenceGraphView","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"modules":[{"name":"Hypergraphs"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/Inciden