{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"metadata":{"symbolKind":"struct","remoteSource":{"fileName":"IncidenceGraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L48"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"Hypergraphs"}],"role":"symbol","externalID":"s:11Hypergraphs18IncidenceGraphViewV","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"title":"IncidenceGraphView"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","text":"Hypergraph","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Edge position "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is incidence number "},{"type":"codeVoice","code":"q"},{"type":"text","text":": the incidences hyperedge by hyperedge, in index"},{"type":"text","text":" "},{"type":"text","text":"order, and within a hyperedge in "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" order. So "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(i, n + p)"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view is"},{"type":"text","text":" "},{"type":"text","text":"a snapshot, so its own positions never change, but they are valid for the hypergraph only until"},{"type":"text","text":" "},{"type":"text","text":"its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a per-incidence"},{"type":"text","text":" "},{"type":"text","text":"array must be rebuilt for it."}],"type":"paragraph"},{"inlineContent":[{"text":"Every index member reads the base’s rows: ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex: i)"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentHyperedgeIndices(ofIndex: i)"},{"text":" shifted by n, and of ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" it is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt: p)"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Traversal"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Connectivity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ShortestPaths"},{"text":" and the rest","type":"text"},{"text":" ","type":"text"},{"text":"therefore run on the view without hashing a vertex. ","type":"text"},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"text":" writes the view’s","type":"text"},{"text":" ","type":"text"},{"text":"rows out once per call from the base’s ","type":"text"},{"type":"codeVoice","code":"_withIncidenceRows"},{"text":", in O(n + m + p), for whole-graph","type":"text"},{"text":" ","type":"text"},{"text":"algorithms (components, bridges, cut vertices).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The view keeps each hyperedge’s first incidence number, so a hyperedge’s ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"text":"range, O(1). On ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":", which stores its incidences, every read is O(1) plus","type":"text"},{"text":" ","type":"text"},{"text":"the row. On any other base, ","type":"text"},{"type":"codeVoice","code":"edges[q]"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"text":" binary-search the","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge and find the member by its rank (","type":"text"},{"type":"codeVoice","code":"_memberIndex(atRank:…)"},{"text":"), O(log m + ⌈n\/64⌉) on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":" and O(log m + k) by default, and a vertex’s ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" finds its place in","type":"text"},{"text":" ","type":"text"},{"text":"each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":", which counts bits, and O(Σ k) over","type":"text"},{"text":" ","type":"text"},{"text":"them on a base without a faster ","type":"text"},{"type":"codeVoice","code":"_memberRank"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"type":"codeVoice","code":"0 ..< n"},{"text":" are the hypergraph’s.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hype