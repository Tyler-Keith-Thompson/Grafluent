{"metadata":{"modules":[{"name":"Hypergraphs"}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"role":"symbol","externalID":"s:11Hypergraphs18IncidenceGraphViewV","symbolKind":"struct","roleHeading":"Structure","title":"IncidenceGraphView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"remoteSource":{"fileName":"IncidenceGraphView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L50"}},"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"topicSections":[{"title":"Structures","generated":true,"anchor":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"]},{"title":"Type Aliases","generated":true,"anchor":"Type-Aliases","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","text":"Hypergraph","preciseIdentifier":"s:14GraphProtocols10HypergraphP"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"inlineContent":[{"text":"Edges.","type":"text"}],"type":"strong"},{"text":" Edge position ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is incidence number ","type":"text"},{"code":"q","type":"codeVoice"},{"text":": the incidences hyperedge by hyperedge, in","type":"text"},{"text":" ","type":"text"},{"text":"index order, and within a hyperedge in ","type":"text"},{"code":"memberIndices","type":"codeVoice"},{"text":" order. So ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedEdge(i, n + p)","type":"codeVoice"},{"text":", the rows of the hyperedge side are contiguous ranges, and a","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view","type":"text"},{"text":" ","type":"text"},{"text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only","type":"text"},{"text":" ","type":"text"},{"text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on","type":"text"},{"text":" ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":", inserting one cell shifts every later incidence by one), and a","type":"text"},{"text":" ","type":"text"},{"text":"per-incidence array must be rebuilt for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"The LabeledGraph law."}],"type":"strong"},{"text":" Every index member reads the base’s rows:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex: i)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"incidentHyperedgeIndices(ofIndex: i)"},{"text":" shifted by n, and of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" it is ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt: p)"},{"text":". So ","type":"text"},{"type":"codeVoice","code":"Traversal"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Connectivity"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ShortestPaths"},{"text":" and the rest run on the view without hashing a vertex. ","type":"text"},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"text":" ","type":"text"},{"text":"writes the view’s rows out once per call from the base’s ","type":"text"},{"type":"codeVoice","code":"_withIncidenceRows"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an","type":"text"},{"text":" ","type":"text"},{"text":"adjacency-list copy’s speed on every base.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Costs."}],"type":"strong"},{"text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" is a range, O(1). On ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":", which stores its incidences,","type":"text"},{"text":" ","type":"text"},{"text":"every read is O(1) plus the row. On any other base, ","type":"text"},{"code":"edges[q]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"endpointIndices(ofEdgeAt:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"binary-search the hyperedge and find the member by its rank (","type":"text"},{"code":"_memberIndex(atRank:…)","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"O(log m + ⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":" and O(log m + k) by default, and a vertex’s","type":"text"},{"text":" ","type":"text"},{"code":"incidentEdges","type":"codeVoice"},{"text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"code":"IncidenceMatrix","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which counts bits, and O(Σ k) over them on a base without a faster ","type":"text"},{"code":"_memberRank","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"BipartiteGraph(h.incidenceGraph, left: 0 ..< h.vertexCount)","type":"codeVoice"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" are the hypergraph’s.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencegraphview"]}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"kind":"relationships"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/endpointIndices(ofEdgeAt:)":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"endpointIndices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofEdgeAt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> (u"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", v"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/endpointindices(ofedgeat:)","title":"endpointIndices(ofEdgeAt:)","abstract":[{"type":"text","text":"The incidence’s vertex index and n plus its hyperedge index, without hashing: two loads on"},{"type":"text","text":" "},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":", a binary search and a walk of the hyperedge’s members otherwise."}]},"doc://Hypergraphs