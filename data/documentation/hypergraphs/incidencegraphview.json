 graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertex(atIndex:)":{"abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"vertex"},{"kind":"text","text":"("},{"kind":"externalParam","text":"atIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview\/vertex(atindex:)","kind":"symbol","title":"vertex(atIndex:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/init(base:)":{"url":"\/documentation\/hypergraphs\/incidencegraphview\/init(base:)","abstract":[{"text":"The view of ","type":"text"},{"type":"codeVoice","code":"base"},{"text":".","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"base"},{"kind":"text","text":": "},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(base:)","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)","type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/neighbors(of:)":{"title":"neighbors(of:)","abstract":[{"text":"The base’s rows: a vertex’s hyperedge indices shifted by n, or a hyperedge’s members.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neighbors","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","