{"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"kind":"symbol","topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/init(base:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/base","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edges-swift.property","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexCount","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertices"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(_:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/contains(edge:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/degree(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/edgeIndex(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/endpointIndices(ofEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdgeIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/incidentEdges(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighborIndices(ofIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/neighbors(of:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/oppositeVertex(to:acrossEdgeAt:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertex(atIndex:)","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndex(of:)"]},{"generated":true,"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdges","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/NeighborIndices","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Vertex"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Graph-Implementations"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hypergraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Edges."}]},{"type":"text","text":" Edge position "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is incidence number "},{"type":"codeVoice","code":"q"},{"type":"text","text":": the incidences hyperedge by hyperedge, in"},{"type":"text","text":" "},{"type":"text","text":"index order, and within a hyperedge in "},{"type":"codeVoice","code":"memberIndices"},{"type":"text","text":" order. So "},{"type":"codeVoice","code":"edges[q]"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UndirectedEdge(i, n + p)"},{"type":"text","text":", the rows of the hyperedge side are contiguous ranges, and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array (a weight of a vertex in a hyperedge) is indexed by edge position. A view"},{"type":"text","text":" "},{"type":"text","text":"is a snapshot, so its own positions never change, but they are valid for the hypergraph only"},{"type":"text","text":" "},{"type":"text","text":"until its next mutation: the view of the mutated hypergraph numbers the incidences afresh (on"},{"type":"text","text":" "},{"type":"codeVoice","code":"IncidenceMatrix"},{"type":"text","text":", inserting one cell shifts every later incidence by one), and a"},{"type":"text","text":" "},{"type":"text","text":"per-incidence array must be rebuilt for it."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The LabeledGraph law."}],"type":"strong"},{"text":" Every index member reads the base’s rows:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"neighborIndices(ofIndex: i)"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"incidentHyperedgeIndices(ofIndex: i)"},{"text":" shifted by n, and of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" it is ","type":"text"},{"type":"codeVoice","code":"memberIndices(ofHyperedgeAt: p)"},{"text":". So ","type":"text"},{"type":"codeVoice","code":"Traversal"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Connectivity"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ShortestPaths"},{"text":" and the rest run on the view without hashing a vertex. ","type":"text"},{"type":"codeVoice","code":"_withIncidentIndexRows"},{"text":" ","type":"text"},{"text":"writes the view’s rows out once per call from the base’s ","type":"text"},{"type":"codeVoice","code":"_withIncidenceRows"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"O(n + m + p), so whole-graph algorithms (components, bridges, cut vertices) run at an","type":"text"},{"text":" ","type":"text"},{"text":"adjacency-list copy’s speed on every base.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Costs."}],"type":"strong"},{"text":" The view keeps each hyperedge’s first incidence number, so a hyperedge’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" is a range, O(1). On ","type":"text"},{"type":"codeVoice","code":"UndirectedIncidenceList"},{"text":", which stores its incidences,","type":"text"},{"text":" ","type":"text"},{"text":"every read is O(1) plus the row. On any other base, ","type":"text"},{"type":"codeVoice","code":"edges[q]"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"endpointIndices(ofEdgeAt:)"},{"text":" ","type":"text"},{"text":"binary-search the hyperedge and find the member by its rank (","type":"text"},{"type":"codeVoice","code":"_memberIndex(atRank:…)"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"O(log m + ⌈n\/64⌉) on ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":" and O(log m + k) by default, and a vertex’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidentEdges"},{"text":" finds its place in each of its hyperedges: O(d·⌈n\/64⌉) on ","type":"text"},{"type":"codeVoice","code":"IncidenceMatrix"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which counts bits, and O(Σ k) over them on a base without a faster ","type":"text"},{"type":"codeVoice","code":"_memberRank"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"BipartiteGraph(h.incidenceGraphView, left: 0 ..< h.vertexCount)","type":"codeVoice"},{"text":" gives the bipartite structure,","type":"text"},{"text":" ","type":"text"},{"text":"and the view’s components restricted to ","type":"text"},{"code":"0 ..< n","type":"codeVoice"},{"text":" are the hypergraph’s.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencegraphview"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceGraphView.swift#L50","fileName":"IncidenceGraphView.swift"},"modules":[{"name":"Hypergraphs"}],"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"symbolKind":"struct","externalID":"s:11Hypergraphs18IncidenceGraphViewV","role":"symbol","title":"IncidenceGraphView","roleHeading":"Structure"},"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Neighbors":{"abstract":[{"type":"text","text":"The neighbors of one vertex of the view: a vertex’s hyperedge indices shifted by n, or a"},{"type":"text","text":" "},{"type":"text","text":"hyperedge’s member indices, read from the base without boxing."}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/neighbors","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Neighbors"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Neighbors"}],"title":"IncidenceGraphView.Neighbors","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertexIndex(of:)":{"url":"\/documentation\/hypergraphs\/incidencegraphview\/vertexindex(of:)","title":"vertexIndex(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexIndex","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifie