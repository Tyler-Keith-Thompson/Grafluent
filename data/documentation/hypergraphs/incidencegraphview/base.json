":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"url":"\/documentation\/hypergraphs\/incidencegraphview","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","abstract":[],"type":"topic","kind":"symbol","role":"collection","title":"Hypergraphs","url":"\/documentation\/hypergraphs"}}}