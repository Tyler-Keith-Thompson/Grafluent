,"url":"\/documentation\/hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","role":"collection"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"url":"\/documentation\/hypergraphs\/incidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","type":"topic","title":"IncidenceGraphView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"kind":"symbol"}}}