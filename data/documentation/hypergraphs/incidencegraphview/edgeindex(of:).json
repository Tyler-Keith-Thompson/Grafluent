/IncidenceGraphView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"title":"IncidenceGraphView","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","kind":"symbol","type":"topic","role":"collection","abstract":[],"title":"Hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/edgeIndex(of:)":{"title":"edgeIndex(of:)","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"edgeIndex","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text