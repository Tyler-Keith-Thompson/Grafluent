uage":"swift"},"references":{"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","title":"Hypergraphs","role":"collection","kind":"symbol","url":"\/documentation\/hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"url":"\/documentation\/hypergraphs\/incidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","title":"IncidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/kComponents()":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"kComponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/kComponents()","url":"\/documentation\/hypergraphs\/incidencegraphview\/kcomponents()","abstract":[],"type":"topic"},"doc://Connectivity/documentation/Connectivity/KComponents":{"type":"topic","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"url":"\/documentation\/connectivity\/kcomponents","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","title":"KComponents"}}}