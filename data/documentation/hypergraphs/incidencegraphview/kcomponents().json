{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/kComponents()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"]]},"kind":"symbol","sections":[],"abstract":[{"text":"Inherited from ","type":"text"},{"type":"codeVoice","code":"Graph.kComponents()"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview\/kcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF::SYNTHESIZED::s:11Hypergraphs18IncidenceGraphViewV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80","fileName":"KComponents.swift"},"roleHeading":"Instance Method","modules":[{"relatedModules":["GraphProtocols"],"name":"Hypergraphs"}],"title":"kComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"text":"() -> ","kind":"text"},{"text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","extendedModule":"GraphProtocols"},"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/kComponents()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/kComponents()","type":"topic","abstract":[],"kind":"symbol","title":"kComponents()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/kcomponents()"},"doc://Connectivity/documentation/Connectivity/KComponents":{"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","url":"\/documentation\/connectivity\/kcomponents","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}],"title":"KComponents","navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","role":"collection","abstract":[],"kind":"symbol","title":"Hypergraphs","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview","type":"topic","title":"IncidenceGraphView","role":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}]}}}