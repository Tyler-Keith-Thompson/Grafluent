cegraphview\/kcomponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/kComponents()","abstract":[],"role":"symbol","kind":"symbol","title":"kComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","text":"KComponents"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Connectivity/documentation/Connectivity/KComponents":{"navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"title":"KComponents","url":"\/documentation\/connectivity\/kcomponents","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"title":"Hypergraphs","role":"collection","url":"\/documentation\/hypergraphs","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","abstract":[],"kind":"symbol"},"doc: