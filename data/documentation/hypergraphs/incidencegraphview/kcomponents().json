hs\/IncidenceGraphView\/kComponents()","kind":"symbol","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/kcomponents()","role":"symbol","type":"topic","title":"kComponents()"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"url":"\/documentation\/hypergraphs\/incidencegraphview","role":"symbol","type":"topic","title":"IncidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","abstract":[],"url":"\/documentation\/hypergraphs","role":"collection","type":"topic","title":"Hypergraphs"},"doc://Connectivity/documentation/Connectivity/KComponents":{"url":"\/documentation\/connectivity\/kcomponents","abstract":[{"type":"text","text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,"},{"type":"text","text":" "},{"type":"text","text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more"},{"type":"text","text":" "},{"type":"text","text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the"},{"type":"text","text":" "},{"type":"text","text":"connected components with an edge, the 2-components the blocks of three or more vertices; every"},{"type":"text","text":" "},{"type":"text","text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k"},{"type":"text","text":" "},{"type":"text","text":"vertices."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","title":"KComponents","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KComponents"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KComponents"}]}}}