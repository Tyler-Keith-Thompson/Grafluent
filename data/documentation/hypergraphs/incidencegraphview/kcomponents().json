{"metadata":{"extendedModule":"GraphProtocols","roleHeading":"Instance Method","title":"kComponents()","modules":[{"name":"Hypergraphs","relatedModules":["GraphProtocols"]}],"role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kComponents"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"KComponents","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Connectivity\/KComponents.swift#L80","fileName":"KComponents.swift"},"externalID":"s:14GraphProtocols0A0P12ConnectivityE11kComponentsAD11KComponentsVyxGyF::SYNTHESIZED::s:11Hypergraphs18IncidenceGraphViewV"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencegraphview\/kcomponents()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Inherited from "},{"code":"Graph.kComponents()","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs","doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/kComponents()"},"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"title":"IncidenceGraphView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"url":"\/documentation\/hypergraphs\/incidencegraphview"},"doc://Connectivity/documentation/Connectivity/KComponents":{"title":"KComponents","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/KComponents","kind":"symbol","url":"\/documentation\/connectivity\/kcomponents","navigatorTitle":[{"text":"KComponents","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KComponents","kind":"identifier"}],"type":"topic","abstract":[{"text":"The k-components of an undirected graph (Moody and White’s cohesive blocking): for each k ≥ 1,","type":"text"},{"text":" ","type":"text"},{"text":"the maximal sets of vertices whose induced subgraph is k-vertex-connected, that is, has more","type":"text"},{"text":" ","type":"text"},{"text":"than k vertices and stays connected after removing any k − 1 of them. The 1-components are the","type":"text"},{"text":" ","type":"text"},{"text":"connected components with an edge, the 2-components the blocks of three or more vertices; every","type":"text"},{"text":" ","type":"text"},{"text":"k-component lies inside a (k − 1)-component. Components at one level may share fewer than k","type":"text"},{"text":" ","type":"text"},{"text":"vertices.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/kComponents()":{"abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/kComponents()","type":"topic","kind":"symbol","title":"kComponents()","url":"\/documentation\/hypergraphs\/incidencegraphview\/kcomponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kComponents","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"KComponents","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity11KComponentsV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"kind":"symbol","url":"\/documentation\/hypergraphs","title":"Hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","abstract":[],"type":"topic","role":"collection"}}}