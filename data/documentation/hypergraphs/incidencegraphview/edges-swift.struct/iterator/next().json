ncidenceGraphView\/Edges-swift.struct\/Iterator\/next()","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct\/iterator\/next()"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct/Iterator":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct\/Iterator","title":"IncidenceGraphView.Edges.Iterator","role":"symbol","abstract":[{"type":"text","text":"Walks the hyperedges in order and each one’s members, so a full pass costs"},{"type":"text","text":" "},{"type":"text","text":"O(m + p) reads of the base (plus its member scans), not a search per edge."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct\/iterator"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct","kind":"symbol","title":"IncidenceGraphView.Edges","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"role":"symbol","abstract":[{"type":"text","text":"Every incidence as an edge, at its incidence number."}],"navigatorTitle":[{"kind":"identifier","text":"Edges"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"title":"Hypergraphs","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","role":"collection","kind":"symbol","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"type":"topic","kind":"symbol","title":"IncidenceGra