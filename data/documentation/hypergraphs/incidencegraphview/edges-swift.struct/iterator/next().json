dered pair {u, v}. "},{"code":"UndirectedEdge(1, 2)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"UndirectedEdge(2, 1)","type":"codeVoice"},{"type":"text","text":" are equal and hash alike."}],"kind":"symbol","navigatorTitle":[{"text":"UndirectedEdge","kind":"identifier"}],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct":{"abstract":[{"type":"text","text":"Every incidence as an edge, at its incidence number."}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}],"type":"topic","title":"IncidenceGraphView.Edges","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","navigatorTitle":[{"text":"Edges","kind":"identifier"}]}}}