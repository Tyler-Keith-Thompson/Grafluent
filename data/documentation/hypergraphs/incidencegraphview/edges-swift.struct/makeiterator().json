{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"abstract":[{"type":"text","text":"Every incidence as an edge, at its incidence number."}],"role":"symbol","title":"IncidenceGraphView.Edges","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"kind":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"role":"symbol","title":"IncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","url":"\/documentation\/hypergraphs\/incidencegraphview","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs","url":"\/documentation\/hypergraphs","kind":"symbol","type":"topic","role":"collection","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct/Iterator":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"navigatorTitle":[{"text":"Iterator","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Walks the hyperedges in order and each one’s members, so a full pass costs"},{"type":"text","text":" "},{"type":"text","text":"O(m + p) reads of the base (plus its member scans), not a search per edge."}],"title":"IncidenceGraphView.Edges.Iterator","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct\/iterator","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct\/Iterator","role":"symbol"}}}