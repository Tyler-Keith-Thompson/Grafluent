 its member scans), not a search per edge.","type":"text"}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"title":"Hypergraphs","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","type":"topic","url":"\/documentation\/hypergraphs","role":"collection","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct":{"kind":"symbol","type":"topic","title":"IncidenceGraphView.Edges","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Edges","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","navigatorTitle":[{"text":"Edges","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct","abstract":[{"type":"text","text":"Every incidence as an edge, at its incidence number."}]}}}