es nothing.","type":"text"}],"type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct/Iterator":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct\/Iterator","abstract":[{"type":"text","text":"Walks the hyperedges in order and each one’s members, so a full pass costs"},{"type":"text","text":" "},{"type":"text","text":"O(m + p) reads of the base (plus its member scans), not a search per edge."}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Iterator","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct\/iterator","title":"IncidenceGraphView.Edges.Iterator","kind":"symbol","navigatorTitle":[{"text":"Iterator","kind":"identifier"}]}}}