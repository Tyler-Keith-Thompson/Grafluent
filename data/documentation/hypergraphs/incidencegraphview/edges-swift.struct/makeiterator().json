ge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct/Iterator":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct\/Iterator","navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"title":"IncidenceGraphView.Edges.Iterator","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Walks the hyperedges in order and each one’s members, so a full pass costs"},{"type":"text","text":" "},{"type":"text","text":"O(m + p) reads of the base (plus its member scans), not a search per edge."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct\/iterator"}}}