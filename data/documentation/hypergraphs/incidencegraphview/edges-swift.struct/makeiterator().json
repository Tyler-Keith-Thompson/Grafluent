ads of the base (plus its member scans), not a search per edge."}],"title":"IncidenceGraphView.Edges.Iterator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct/makeIterator()":{"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct\/makeiterator()","title":"makeIterator()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\