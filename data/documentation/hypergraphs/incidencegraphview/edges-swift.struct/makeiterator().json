ion","url":"\/documentation\/hypergraphs","title":"Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","title":"IncidenceGraphView.Edges","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Every incidence as an edge, at its incidence number."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Edges"}],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","kind":"symbol","type":"topic","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct/Iterator":{"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct\/iterator","abstract":[{"text":"Walks the hyperedges in order and each one’s members, so a full pass costs","type":"text"},{"text":" ","type":"text"},{"text":"O(m + p) reads of the base (plus its member scans), not a search per edge.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"title":"IncidenceGraphView.Edges.Iterator","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct\/Iterator"}}}