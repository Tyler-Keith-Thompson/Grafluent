":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"0 ..< n + m"},{"text":" whose vertex ","type":"text"},{"type":"codeVoice","code":"i < n"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" and whose vertex ","type":"text"},{"type":"codeVoice","code":"n + p"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"type":"codeVoice","code":"p"},{"text":", with an edge ","type":"text"},{"type":"codeVoice","code":"{i, n + p}"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}]}}}