,"doc://Hypergraphs/documentation/Hypergraphs":{"kind":"symbol","role":"collection","type":"topic","title":"Hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"role":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct":{"type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","title":"IncidenceGraphView.Edges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Edges"}],"abstract":[{"type":"text","text":"Every incidence as an edge, at its incidence number."}]}}}