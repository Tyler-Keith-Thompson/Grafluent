 ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Edges-swift.struct":{"role":"symbol","type":"topic","abstract":[{"text":"Every incidence as an edge, at its incidence number.","type":"text"}],"title":"IncidenceGraphView.Edges","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Edges-swift.struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"navigatorTitle":[{"kind":"identifier","text":"Edges"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/edges-swift.struct","kind":"symbol"}}}