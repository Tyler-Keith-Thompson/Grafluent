"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"title":"IncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","url":"\/documentation\/hypergraphs\/incidencegraphview","type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"title":"Hypergraphs","role":"collection","abstract":[],"url":"\/documentation\/hypergraphs","type":"topic","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/vertexIndexBound":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertexIndexBound","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"kind":"symbol","title":"vertexIndexBound","url":"\/documentation\/hypergraphs\/incidencegraphview\/vertexindexbound","abstract":[],"role":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/vertexIndexBound"}}}