ed graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"type":"codeVoice","code":"blocks"},{"type":"text","text":", articulation points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"type":"topic","url":"\/documentation\/connectivity\/blockcuttree","kind":"symbol","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","title":"BlockCutTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlockCutTree"}],"navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs","kind":"symbol","abstract":[],"role":"collection","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"type":"topic","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","abstract":[],"title":"blockCutTree()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"kind":"symbol","title":"IncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","role":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}]}}}