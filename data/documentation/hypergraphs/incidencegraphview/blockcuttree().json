graphs\/incidencegraphview\/blockcuttree()"]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"type":"topic","title":"IncidenceGraphView","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","title":"blockCutTree()","role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"kind":"symbol","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","title":"Hypergraphs","url":"\/documentation\/hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","type":"topic"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlockCutTree"}],"title":"BlockCutTree","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"kind":"symbol","url":"\/documentation\/connectivity\/blockcuttree","abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree, JGraphT’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"BlockCutpointGraph"},{"type":"text","text":"): a node per block and per articulation point, and an edge joining each"},{"type":"text","text":" "},{"type":"text","text":"block to each articulation point it contains. Blocks are numbered as in "},{"type":"codeVoice","code":"blocks"},{"type":"text","text":", articulation"},{"type":"text","text":" "},{"type":"text","text":"points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" ("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge that is not a self-loop; isolated vertices are no node."}],"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree"}}}