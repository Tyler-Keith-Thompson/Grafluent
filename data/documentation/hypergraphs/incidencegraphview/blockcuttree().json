/Hypergraphs\/IncidenceGraphView\/blockCutTree()","role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","kind":"symbol","title":"blockCutTree()","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"url":"\/documentation\/connectivity\/blockcuttree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"code":"blocks","type":"codeVoice"},{"type":"text","text":", articulation points by their place in "},{"code":"articulationPoints","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"role":"symbol","title":"BlockCutTree","kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","type":"topic","abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"role":"collection","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","type":"topic","kind":"symbol","title":"Hypergraphs"}}}