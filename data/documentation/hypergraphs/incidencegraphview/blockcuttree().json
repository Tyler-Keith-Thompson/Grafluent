ethod","title":"blockCutTree()"},"sections":[],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlockCutTree"}],"url":"\/documentation\/connectivity\/blockcuttree","navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","kind":"symbol","abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree, JGraphT’s"},{"type":"text","text":" "},{"code":"BlockCutpointGraph","type":"codeVoice"},{"type":"text","text":"): a node per block and per articulation point, and an edge joining each"},{"type":"text","text":" "},{"type":"text","text":"block to each articulation point it contains. Blocks are numbered as in "},{"code":"blocks","type":"codeVoice"},{"type":"text","text":", articulation"},{"type":"text","text":" "},{"type":"text","text":"points by their place in "},{"code":"articulationPoints","type":"codeVoice"},{"type":"text","text":" ("},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order). It is a forest: one tree per"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge that is not a self-loop; isolated vertices are no node."}],"title":"BlockCutTree","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","role":"symbol","kind":"symbol","abstract":[],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","text":"BlockCutTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","title":"blockCutTree()"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","abstract":[],"kind":"symbol","type":"topic","title":"Hypergraphs","role":"collection","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"}}}