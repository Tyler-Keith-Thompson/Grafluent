tifier"}],"role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"abstract":[{"text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and","type":"text"},{"text":" ","type":"text"},{"text":"per articulation point, and an edge joining each block to each articulation point it contains.","type":"text"},{"text":" ","type":"text"},{"text":"Blocks are numbered as in ","type":"text"},{"code":"blocks","type":"codeVoice"},{"text":", articulation points by their place in ","type":"text"},{"code":"articulationPoints","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order). It is a forest: one tree per connected component with an edge that is not a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop; isolated vertices are no node.","type":"text"}],"url":"\/documentation\/connectivity\/blockcuttree","title":"BlockCutTree","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"type":"topic","abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"url":"\/documentation\/hypergraphs\/incidencegraphview","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","abstract":[],"type":"topic","kind":"symbol","role":"collection","title":"Hypergraphs","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","abstract":[],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","role":"symbol","title":"blockCutTree()","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()"}}}