:{"patch":0,"minor":3,"major":0},"sections":[],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","title":"blockCutTree()","type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs","title":"Hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree, JGraphT’s"},{"type":"text","text":" "},{"code":"BlockCutpointGraph","type":"codeVoice"},{"type":"text","text":"): a node per block and per articulation point, and an edge joining each"},{"type":"text","text":" "},{"type":"text","text":"block to each articulation point it contains. Blocks are numbered as in "},{"code":"blocks","type":"codeVoice"},{"type":"text","text":", articulation"},{"type":"text","text":" "},{"type":"text","text":"points by their place in "},{"code":"articulationPoints","type":"codeVoice"},{"type":"text","text":" ("},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order). It is a forest: one tree per"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge that is not a self-loop; isolated vertices are no node."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"url":"\/documentation\/connectivity\/blockcuttree","type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","kind":"symbol","navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"role":"symbol","title":"BlockCutTree"}}}