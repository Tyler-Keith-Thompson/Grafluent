h.blockCutTree()"},{"text":".","type":"text"}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"type":"topic","role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"title":"IncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"url":"\/documentation\/connectivity\/blockcuttree","abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"type":"codeVoice","code":"blocks"},{"type":"text","text":", articulation points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","type":"topic","title":"BlockCutTree","role":"symbol","navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","title":"blockCutTree()","kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","role":"collection","url":"\/documentation\/hypergraphs","kind":"symbol","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs"}}}