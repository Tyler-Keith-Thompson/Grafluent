:"text","text":">"}]}],"kind":"declarations"}],"references":{"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"type":"topic","title":"BlockCutTree","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree, JGraphT’s"},{"type":"text","text":" "},{"code":"BlockCutpointGraph","type":"codeVoice"},{"type":"text","text":"): a node per block and per articulation point, and an edge joining each"},{"type":"text","text":" "},{"type":"text","text":"block to each articulation point it contains. Blocks are numbered as in "},{"code":"blocks","type":"codeVoice"},{"type":"text","text":", articulation"},{"type":"text","text":" "},{"type":"text","text":"points by their place in "},{"code":"articulationPoints","type":"codeVoice"},{"type":"text","text":" ("},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order). It is a forest: one tree per"},{"type":"text","text":" "},{"type":"text","text":"connected component with an edge that is not a self-loop; isolated vertices are no node."}],"url":"\/documentation\/connectivity\/blockcuttree","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","title":"blockCutTree()","abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12Connectivity12BlockCutTreeV","kind":"typeIdentifier","text":"BlockCutTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","type":"topic","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","url":"\/documentation\/hypergraphs","title":"Hypergraphs","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","url":"\/documentation\/hypergraphs\/incidencegraphview","type":"topic","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView"}}}