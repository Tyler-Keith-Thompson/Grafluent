,"name":"Hypergraphs"}],"symbolKind":"method"},"references":{"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","url":"\/documentation\/connectivity\/blockcuttree","navigatorTitle":[{"kind":"identifier","text":"BlockCutTree"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlockCutTree"}],"abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"type":"codeVoice","code":"blocks"},{"type":"text","text":", articulation points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"title":"BlockCutTree","type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"role":"symbol","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","kind":"symbol","title":"blockCutTree()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","role":"collection","kind":"symbol","abstract":[],"title":"Hypergraphs","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"}}}