mentation\/Hypergraphs\/IncidenceGraphView"]]},"references":{"doc://Hypergraphs/documentation/Hypergraphs":{"title":"Hypergraphs","abstract":[],"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"abstract":[],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"blockCutTree"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","title":"blockCutTree()","kind":"symbol"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"role":"symbol","url":"\/documentation\/connectivity\/blockcuttree","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","title":"BlockCutTree","abstract":[{"text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and","type":"text"},{"text":" ","type":"text"},{"text":"per articulation point, and an edge joining each block to each articulation point it contains.","type":"text"},{"text":" ","type":"text"},{"text":"Blocks are numbered as in ","type":"text"},{"code":"blocks","type":"codeVoice"},{"text":", articulation points by their place in ","type":"text"},{"code":"articulationPoints","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order). It is a forest: one tree per connected component with an edge that is not a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop; isolated vertices are no node.","type":"text"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"title":"IncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview"}}}