{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"abstract":[],"url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","title":"blockCutTree()","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","preciseIdentifier":"s:12Connectivity12BlockCutTreeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"title":"IncidenceGraphView","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"type":"codeVoice","code":"blocks"},{"type":"text","text":", articulation points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"url":"\/documentation\/connectivity\/blockcuttree","role":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","title":"BlockCutTree","navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","kind":"symbol","type":"topic","role":"collection","abstract":[],"title":"Hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"}}}