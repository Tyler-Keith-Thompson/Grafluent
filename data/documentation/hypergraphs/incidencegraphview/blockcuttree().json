graphs\/IncidenceGraphView"]]},"kind":"symbol","references":{"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"url":"\/documentation\/hypergraphs\/incidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","title":"IncidenceGraphView"},"doc://Connectivity/documentation/Connectivity/BlockCutTree":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlockCutTree","kind":"identifier"}],"navigatorTitle":[{"text":"BlockCutTree","kind":"identifier"}],"title":"BlockCutTree","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/BlockCutTree","url":"\/documentation\/connectivity\/blockcuttree","abstract":[{"type":"text","text":"The block–cut tree of an undirected graph (Harary’s block-cutpoint tree): a node per block and"},{"type":"text","text":" "},{"type":"text","text":"per articulation point, and an edge joining each block to each articulation point it contains."},{"type":"text","text":" "},{"type":"text","text":"Blocks are numbered as in "},{"code":"blocks","type":"codeVoice"},{"type":"text","text":", articulation points by their place in "},{"type":"codeVoice","code":"articulationPoints"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order). It is a forest: one tree per connected component with an edge that is not a"},{"type":"text","text":" "},{"type":"text","text":"self-loop; isolated vertices are no node."}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","title":"Hypergraphs","role":"collection","kind":"symbol","url":"\/documentation\/hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/blockCutTree()":{"title":"blockCutTree()","url":"\/documentation\/hypergraphs\/incidencegraphview\/blockcuttree()","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/blockCutTree()","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"blockCutTree","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"BlockCutTree","kind":"typeIdentifier","preciseIdentifier":"s:12Connectivity12BlockCutTreeV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic"}}}