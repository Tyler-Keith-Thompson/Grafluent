ite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/IncidentEdgeIndices":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidentEdgeIndices","kind":"identifier"}],"navigatorTitle":[{"text":"IncidentEdgeIndices","kind":"identifier"}],"abstract":[{"text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a","type":"text"},{"text":" ","type":"text"},{"text":"stored or computed row, or a contiguous range. Random access,","type":"text"},{"text":" ","type":"text"},{"text":"O(1) per element.","type":"text"}],"title":"IncidenceGraphView.IncidentEdgeIndices","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","type":"topic","kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices"}}}