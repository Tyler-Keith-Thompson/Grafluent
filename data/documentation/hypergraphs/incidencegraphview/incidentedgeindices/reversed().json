phs\/documentation\/Hypergraphs\/IncidenceGraphView","abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview","role":"symbol","type":"topic","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}]}}}