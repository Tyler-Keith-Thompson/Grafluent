 or a contiguous range. Random access,"},{"type":"text","text":" "},{"type":"text","text":"O(1) per element."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"IncidentEdgeIndices","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices","title":"IncidenceGraphView.IncidentEdgeIndices","navigatorTitle":[{"text":"IncidentEdgeIndices","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"title":"Hypergraphs","url":"\/documentation\/hypergraphs","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","role":"collection","kind":"symbol","abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/IncidentEdgeIndices/indexed()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices\/indexed()","url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices\/indexed()","abstract":[],"title":"indexed()","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indexed","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:10Algorithms17IndexedCollectionV","text":"IndexedCollection","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}]}}}