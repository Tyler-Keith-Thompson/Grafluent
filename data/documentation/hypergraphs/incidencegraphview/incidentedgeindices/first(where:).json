ypergraphs\/incidencegraphview\/incidentedgeindices","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"IncidentEdgeIndices"}],"role":"symbol","abstract":[{"type":"text","text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a"},{"type":"text","text":" "},{"type":"text","text":"stored or computed row (shifted by a constant), or a contiguous range. Random access,"},{"type":"text","text":" "},{"type":"text","text":"O(1) per element."}],"navigatorTitle":[{"kind":"identifier","text":"IncidentEdgeIndices"}]}}}