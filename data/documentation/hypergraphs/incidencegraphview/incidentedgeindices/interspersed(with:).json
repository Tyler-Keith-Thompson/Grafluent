er","text":"IncidentEdgeIndices"}],"role":"symbol","abstract":[{"type":"text","text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a"},{"type":"text","text":" "},{"type":"text","text":"stored or computed row (shifted by a constant), or a contiguous range. Random access,"},{"type":"text","text":" "},{"type":"text","text":"O(1) per element."}],"navigatorTitle":[{"kind":"identifier","text":"IncidentEdgeIndices"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"title":"Hypergraphs","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","role":"collection","kind":"symbol","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"type":"topic","kind":"symbol","title":"IncidenceGraphView","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"identi