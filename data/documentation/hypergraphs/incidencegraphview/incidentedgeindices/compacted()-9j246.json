\/incidentedgeindices","role":"symbol","abstract":[{"text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a","type":"text"},{"text":" ","type":"text"},{"text":"stored or computed row (shifted by a constant), or a contiguous range. Random access,","type":"text"},{"text":" ","type":"text"},{"text":"O(1) per element.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol","type":"topic","title":"IncidenceGraphView","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","url":"\/documentation\/hypergraphs\/incidencegraphview","role":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}]},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","role":"collection","url":"\/documentation\/hypergraphs",