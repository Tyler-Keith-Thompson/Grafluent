ct":[{"type":"text","text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a"},{"type":"text","text":" "},{"type":"text","text":"stored or computed row, or a contiguous range. Random access,"},{"type":"text","text":" "},{"type":"text","text":"O(1) per element."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidentEdgeIndices"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","url":"\/documentation\/hypergraphs\/incidencegraphview","kind":"symbol","title":"IncidenceGraphView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}]}}}