graphs\/incidencegraphview\/incidentedgeindices\/last","type":"topic","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices\/last","title":"last"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/IncidentEdgeIndices":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"IncidentEdgeIndices"}],"navigatorTitle":[{"kind":"identifier","text":"IncidentEdgeIndices"}],"role":"symbol","title":"IncidenceGraphView.IncidentEdgeIndices","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","kind":"symbol","abstract":[{"type":"text","text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a"},{"type":"text","text":" "},{"type":"text","text":"stored or computed row, or a contiguous range. Random access,"},{"type":"text","text":" "},{"type":"text","text":"O(1) per element."}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices"}}}