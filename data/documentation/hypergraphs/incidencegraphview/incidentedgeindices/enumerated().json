"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/IncidentEdgeIndices":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidentEdgeIndices","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The incidence numbers at one vertex of an incidence graph view, its edge positions: a","type":"text"},{"text":" ","type":"text"},{"text":"stored or computed row, or a contiguous range. Random access,","type":"text"},{"text":" ","type":"text"},{"text":"O(1) per element.","type":"text"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/incidentedgeindices","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/IncidentEdgeIndices","title":"IncidenceGraphView.IncidentEdgeIndices","role":"symbol","navigatorTitle":[{"text":"IncidentEdgeIndices","kind":"identifier"}]}}}