\/documentation\/graphprotocols\/graphgeneration","navigatorTitle":[{"text":"GraphGeneration","kind":"identifier"}],"abstract":[{"text":"A graph’s generation: which state of which graph it is. Every structural mutation (an","type":"text"},{"text":" ","type":"text"},{"text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and","type":"text"},{"text":" ","type":"text"},{"text":"writing attached map values do not. A structure derived from a graph stores the graph’s","type":"text"},{"text":" ","type":"text"},{"code":"generation","type":"codeVoice"},{"text":" and asks ","type":"text"},{"code":"isCurrent(for:)","type":"codeVoice"},{"text":" before it relies on the graph again.","type":"text"}],"title":"GraphGeneration","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"role":"symbol","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an edge "},{"code":"{i, n + p}","type":"codeVoice"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/generation":{"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/generation","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/generation","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"generation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14GraphProtocols0A10GenerationV","kind":"typeIdentifier","text":"GraphGeneration"}],"kind":"symbol","type":"topic","abstract":[],"title":"generation"},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs","title":"Hypergraphs","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"}}}