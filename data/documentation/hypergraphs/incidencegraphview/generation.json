raphProtocols\/documentation\/GraphProtocols\/GraphGeneration","url":"\/documentation\/graphprotocols\/graphgeneration","type":"topic","abstract":[{"type":"text","text":"A graph’s generation: which state of which graph it is. Every structural mutation (an"},{"type":"text","text":" "},{"type":"text","text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and"},{"type":"text","text":" "},{"type":"text","text":"writing attached map values do not. A structure derived from a graph stores the graph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"generation"},{"type":"text","text":" and asks "},{"type":"codeVoice","code":"isCurrent(for:)"},{"type":"text","text":" before it relies on the graph again."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"navigatorTitle":[{"text":"GraphGeneration","kind":"identifier"}],"title":"GraphGeneration"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","url":"\/documentation\/hypergraphs\/incidencegraphview","type":"topic","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"title":"IncidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/generation":{"type":"topic","title":"generation","abstract":[],"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/generation","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"generation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A10GenerationV","text":"GraphGeneration"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/generation"},"doc://Hypergraphs/documentation/Hypergraphs":{"role":"collection","type":"topic","abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","url":"\/documentation\/hypergraphs","title":"Hypergraphs","kind":"symbol"}}}