documentation\/graphprotocols\/graph\/incidentedges","kind":"symbol","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","kind":"symbol","type":"topic","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/hypergraphs","title":"Hypergraphs"}}}