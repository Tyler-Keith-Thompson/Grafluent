xt","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/LazyGraphView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazyGraphView"}],"title":"LazyGraphView","navigatorTitle":[{"kind":"identifier","text":"LazyGraphView"}],"type":"topic","kind":"symbol","url":"\/documentation\/graphprotocols\/lazygraphview","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/LazyGraphView","abstract":[{"type":"text","text":"An undirected graph whose algorithms run step by step: each member returns a sequence of the"},{"type":"text","text":" "},{"type":"text","text":"algorithm’s events, computed as they are pulled. Get one from "},{"type":"codeVoice","code":"Graph.lazy"},{"type":"text","text":"."}]}}}