xt","text":"it loses nothing."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","url":"\/documentation\/hypergraphs\/incidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Neighbors":{"url":"\/documentation\/hypergraphs\/incidencegraphview\/neighbors","navigatorTitle":[{"kind":"identifier","text":"Neighbors"}],"title":"IncidenceGraphView.Neighbors","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Neighbors"}],"kind":"symbol","abstract":[{"text":"The neighbors of one vertex of the view: a vertex’s hyperedge indices shifted by n, or a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge’s member indices, read from the base without boxing.","type":"text"}]}}}