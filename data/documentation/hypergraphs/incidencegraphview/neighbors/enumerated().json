,"role":"symbol","abstract":[{"text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an edge ","type":"text"},{"code":"{i, n + p}","type":"codeVoice"},{"text":" for each incidence. It is bipartite and simple","type":"text"},{"text":" ","type":"text"},{"text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and","type":"text"},{"text":" ","type":"text"},{"text":"it loses nothing.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceGraphView","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview","title":"IncidenceGraphView","navigatorTitle":[{"text":"IncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Neighbors":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors","role":"symbol","type":"topic","abstract":[{"text":"The neighbors of one vertex of the view: a vertex’s hyperedge indices shifted by n, or a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge’s member indices, read from the base without boxing.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Neighbors","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/incidencegraphview\/neighbors","title":"IncidenceGraphView.Neighbors","navigatorTitle":[{"