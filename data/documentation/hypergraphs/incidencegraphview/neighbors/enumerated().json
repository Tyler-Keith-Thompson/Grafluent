\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors","role":"symbol","kind":"symbol","abstract":[{"text":"The neighbors of one vertex of the view: a vertex’s hyperedge indices shifted by n, or a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge’s member indices, read from the base without boxing.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Neighbors","kind":"identifier"}],"navigatorTitle":[{"text":"Neighbors","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/neighbors"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceGraphView"}],"title":"IncidenceGraphView","url":"\/document