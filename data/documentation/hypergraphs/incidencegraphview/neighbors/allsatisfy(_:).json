xt":"IncidenceGraphView"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph’s incidence graph, read lazily from its storage: a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" "},{"type":"text","text":"is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an edge "},{"type":"codeVoice","code":"{i, n + p}"},{"type":"text","text":" for each incidence. It is bipartite and simple"},{"type":"text","text":" "},{"type":"text","text":"(vertices on the left, hyperedges on the right), an empty hyperedge is an isolated vertex, and"},{"type":"text","text":" "},{"type":"text","text":"it loses nothing."}],"navigatorTitle":[{"kind":"identifier","text":"IncidenceGraphView"}],"title":"IncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs/IncidenceGraphView/Neighbors":{"kind":"symbol","abstract":[{"text":"The neighbors of one vertex of the view: a vertex’s hyperedge indices shifted by n, or a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge’s member indices, read from the base without boxing.","type":"text"}],"title":"IncidenceGraphView.Neighbors","navigatorTitle":[{"text":"Neighbors","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/incidencegraphview\/neighbors","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceGraphView\/Neighbors","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Neighbors","kind":"identifier"}]}}}