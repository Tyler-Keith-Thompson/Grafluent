, the target"},{"type":"text","text":" "},{"type":"text","text":"plane the targets and the in-hyperedges, so both stars are stored rows and "},{"type":"codeVoice","code":"reversed"},{"type":"text","text":" swaps the"},{"type":"text","text":" "},{"type":"text","text":"planes in O(1). Every vertex-space read hashes its vertex once; index-space reads and the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" algorithms hash none. Hyperedges can be appended but not removed. Equality"},{"type":"text","text":" "},{"type":"text","text":"ignores the order of the vertices and of the hyperedges."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hypergraphs\/incidencelist"]}],"metadata":{"externalID":"s:11Hypergraphs13IncidenceListV","title":"IncidenceList","remoteSource":{"fileName":"IncidenceList.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceList.swift#L23"},"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"IncidenceList"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceList"}],"roleHeading":"Structure","modules":[{"name":"Hypergraphs"}]},"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation