{"abstract":[{"type":"text","text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of"},{"type":"text","text":" "},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":"’s storage. Unprefixed, as "},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":" is the directed one of its"},{"type":"text","text":" "},{"type":"text","text":"pair. ("},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":" is the matrix form; "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":" is undirected, because"},{"type":"text","text":" "},{"type":"text","text":"“oriented incidence matrix” is the established name.)"}],"relationshipsSections":[{"identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencelist"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"struct","externalID":"s:11Hypergraphs13IncidenceListV","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Hypergraphs\/IncidenceList.swift#L26","fileName":"IncidenceList.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceList","kind":"identifier"}],"ro