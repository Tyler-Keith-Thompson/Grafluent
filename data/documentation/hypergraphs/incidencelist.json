{"kind":"symbol","sections":[],"abstract":[{"text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and","type":"text"},{"text":" ","type":"text"},{"text":"each vertex’s out- and in-hyperedges (its forward and backward stars), as two planes of","type":"text"},{"text":" ","type":"text"},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"text":"’s storage.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:11Hypergraphs13IncidenceListV","title":"IncidenceList","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceList","kind":"identifier"}],"navigatorTitle":[{"text":"IncidenceList","kind":"identifier"}],"modules":[{"name":"Hypergraphs"}],"symbolKind":"struct","roleHeading":"Structure"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/PropertyGraph","doc:\/\/Hypergraphs\/s8CopyableP","doc:\/\/Hypergraphs\/s28CustomDebugStringConvertibleP","doc:\/\/Hypergraphs\/s23CustomStringConvertibleP","doc:\/\/Hypergraphs\/Se","doc:\/\/Hypergraphs\/SE","doc:\/\/Hypergraphs\/SQ","doc:\/\/Hypergraphs\/s9EscapableP","doc:\/\/Hypergraphs\/SH","doc:\/\/Hypergraphs\/s8SendableP","doc:\/\/Hypergraphs\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencelist"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Hypergraphs\/documentation\/Hypergraphs"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"IncidenceList