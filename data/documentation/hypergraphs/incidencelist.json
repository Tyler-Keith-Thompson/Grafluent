{"abstract":[{"type":"text","text":"A directed hypergraph stored as an incidence list: each hyperedge’s sources and targets, and"},{"type":"text","text":" "},{"type":"text","text":"each vertex’s out- and in-hyperedges (Gallo’s forward and backward stars), as two planes of"},{"type":"text","text":" "},{"code":"UndirectedIncidenceList","type":"codeVoice"},{"type":"text","text":"’s storage. Unprefixed, as "},{"code":"AdjacencyList","type":"codeVoice"},{"type":"text","text":" is the directed one of its"},{"type":"text","text":" "},{"type":"text","text":"pair. ("},{"code":"OrientedIncidenceMatrix","type":"codeVoice"},{"type":"text","text":" is the matrix form; "},{"code":"IncidenceMatrix","type":"codeVoice"},{"type":"text","text":" is undirected, because"},{"type":"text","text":" "},{"type":"text","text":"“oriented incidence matrix” is the established name.)"}],"variants":[{"paths":["\/documentation\/hypergraphs\/incidencelist"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/IncidenceList","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"IncidenceList","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vertices are any "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" values, kept in an "},{"type":"codeVoice","code"