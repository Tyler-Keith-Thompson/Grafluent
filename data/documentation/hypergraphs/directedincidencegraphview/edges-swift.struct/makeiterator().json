aphViewV5EdgesV8IteratorV"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","abstract":[],"type":"topic","title":"Hypergraphs","url":"\/documentation\/hypergraphs","role":"collection","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Edges-swift.struct/Iterator":{"abstract":[{"text":"Walks the source sides in hyperedge order, then the target sides, so a full pass","type":"text"},{"text":" ","type":"text"},{"text":"costs O(m + p) reads of the base (plus its member scans), not a search per edge.","type":"text"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/edges-swift.struct\/iterator","kind":"symbol","title":"DirectedIncidenceGraphView.Edges.Iterator","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct\/Iterator","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"navigatorTitle":[{"kind":"identifier","text":"Iterator"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Edges-swift.struct":{"abstract":[{"type":"text","text":"Every incidence as an arc: the source incidences, then the target incidences."}],"navigatorTitle":[{"kind":"identifier","text":"Edges"}],"kind":"symbol","title":"DirectedIncidenceGraphView.Edges","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/edges-swift.struct","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"type":"topic","title":"DirectedIncidenceGraphView","url":"\/documentation\/hypergraphs\/directedincidencegraphview","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}]}}}