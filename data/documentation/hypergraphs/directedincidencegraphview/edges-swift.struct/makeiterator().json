xt":"Edges"}],"kind":"symbol","type":"topic","title":"DirectedIncidenceGraphView.Edges","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Edges"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/edges-swift.struct","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","abstract":[{"text":"Every incidence as an arc: the source incidences, then the target incidences.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","title":"Hypergraphs","kind":"symbol","abstract":[],"role":"collection","url":"\/documentation\/hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Edges-swift.struct/makeIterator()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV"},{"text":"<","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Edges","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV5EdgesV"},{"text":".","kind":"text"},{"text":"Iterator","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV5EdgesV8IteratorV"}],"title":"makeIterator()","type":"topic","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/edges-swift.struct\/makeiterator()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct\/makeIterator()","abstract":[],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"kind":"symbol","type":"topic","title":"DirectedIncidenceGraphView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":" on "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an arc "},{"code":"i → n + p","type":"codeVoice"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"code":"i","type":"codeVoice"},{"type":"text","text":" of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" and "},{"code":"n + p → j","type":"codeVoice"},{"type":"text","text":" for each target "},{"code":"j","type":"codeVoice"},{"type":"text","text":". A vertex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}]}}}