idenceGraphView","kind":"identifier"}],"abstract":[{"text":"A directed hypergraph’s incidence graph, read lazily from its storage: a","type":"text"},{"text":" ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"0 ..< n + m","type":"codeVoice"},{"text":" whose vertex ","type":"text"},{"code":"i < n","type":"codeVoice"},{"text":" is the hypergraph’s vertex","type":"text"},{"text":" ","type":"text"},{"text":"index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" and whose vertex ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" is hyperedge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":", with an arc ","type":"text"},{"code":"i → n + p","type":"codeVoice"},{"text":" for each source","type":"text"},{"text":" ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" of ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"n + p → j","type":"codeVoice"},{"text":" for each target ","type":"text"},{"code":"j","type":"codeVoice"},{"text":". A vertex on both sides of ","type":"text"},{"code":"p","type":"codeVoice"},{"text":" gives the 2-cycle","type":"text"},{"text":" ","type":"text"},{"code":"i → n + p → i","type":"codeVoice"},{"text":".","type":"text"}],"title":"DirectedIncidenceGraphView","navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Edges-swift.struct/makeIterator()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct\/makeIterator()","type":"topic","abstract":[],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/edges-swift.struct\/makeiterator()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"DirectedIncidenceGraphView","preciseIdentifier":"s:11Hypergraphs26D