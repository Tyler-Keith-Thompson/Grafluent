 target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","kind":"symbol","title":"DirectedIncidenceGraphView","url":"\/documentation\/hypergraphs\/directedincidencegraphview"}}}