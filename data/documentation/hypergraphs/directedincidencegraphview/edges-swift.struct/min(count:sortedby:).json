"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Edges-swift.struct":{"abstract":[{"type":"text","text":"Every incidence as an arc: the source incidences, then the target incidences."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Edges"}],"role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/edges-swift.struct","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Edges-swift.struct","navigatorTitle":[{"kind":"identifier","text":"Edges"}],"type":"topic","kind":"symbol","title":"DirectedIncidenceGraphView.Edges"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"role":"collection","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","type":"topic","kind":"symbol","title":"Hypergraphs"}}}