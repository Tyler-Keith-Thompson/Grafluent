."}],"navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"title":"DirectedIncidenceGraphView","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"title":"Hypergraphs","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","role":"collection","kind":"symbol","url":"\/documentation\/hypergraphs"}}}