rtex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","role":"symbol"}}}