xt":"DirectedIncidenceGraphView","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":" on "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an arc "},{"code":"i → n + p","type":"codeVoice"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"code":"i","type":"codeVoice"},{"type":"text","text":" of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" and "},{"code":"n + p → j","type":"codeVoice"},{"type":"text","text":" for each target "},{"code":"j","type":"codeVoice"},{"type":"text","text":". A vertex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}]}}}