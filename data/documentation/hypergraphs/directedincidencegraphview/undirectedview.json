ype":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"role":"symbol","title":"DirectedIncidenceGraphView","url":"\/documentation\/hypergraphs\/directedincidencegraphview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"type":"topic","title":"UndirectedView","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A bidirectional directed graph read as an undirected graph: each arc "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" is the edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" at the arc’s position, so "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" is "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" then "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"degree"},{"type":"text","text":" is the base’s. Two opposite arcs are two parallel edges."}],"navigatorTitle":[{"text":"UndirectedView","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/undirectedview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},