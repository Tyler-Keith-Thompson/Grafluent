tex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"type":"topic","title":"DirectedIncidenceGraphView","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView"},"doc://Connectivity/documentation/Connectivity/DominatorTree":{"kind":"symbol","url":"\/documentation\/connectivity\/dominatortree","abstract":[{"type":"text","text":"The dominator tree of the vertices reachable from a root: "},{"type":"codeVoice","code":"a"},{"type":"text","text":" dominates "},{"type":"codeVoice","code":"b"},{"type":"text","text":" when every path"},{"type":"text","text":" "},{"type":"text","text":"from the root to "},{"type":"codeVoice","code":"b"},{"type":"text","text":" passes through "},{"type":"codeVoice","code":"a"},{"type":"text","text":". Each reachable vertex but the root has an immediate"},{"type":"text","text":" "},{"type":"text","text":"dominator, its closest strict dominator, which is its parent in the tree."}],"type":"topic","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/DominatorTree","role":"symbol","navigatorTitle":[{"text":"DominatorTree","kind":"identifier"}],"title":"DominatorTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DominatorTree","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","abstract":[],"kind":"symbol","type":"topic","title":"Hypergraphs","role":"collection","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"identifier":"doc:\/\/GraphProt