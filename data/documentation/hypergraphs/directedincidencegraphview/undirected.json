ifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/UndirectedView":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/UndirectedView","url":"\/documentation\/graphprotocols\/undirectedview","type":"topic","kind":"symbol","role":"symbol","title":"UndirectedView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndirectedView","kind":"identifier"}],"navigatorTitle":[{"text":"UndirectedView","kind":"identifier"}],"abstract":[{"type":"text","text":"A bidirectional directed graph read as an undirected graph: each arc "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" is the edge"},{"type":"text","text":" "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" at the arc’s position, so "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":" is "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" then "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"degree"},{"type":"text","text":" is the base’s. Two opposite arcs are two parallel edges."}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/undirected":{"title":"undirected","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undirected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UndirectedView","preciseIdentifier":"s:14GraphProtocols14UndirectedViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/undirected","kind":"symbol","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/undirected","abstract":[]}}}