//Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"title":"DirectedIncidenceGraphView","url":"\/documentation\/hypergraphs\/directedincidencegraphview","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"title":"Vertex","kind":"symbol","type":"topic","abstract":[]},"doc://Connectivity/documentation/Connectivity/DominatorTree":{"identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/DominatorTree","role":"symbol","abstract":[{"type":"text","text":"The dominator tree of the vertices reachable from a root: "},{"type":"codeVoice","code":"a"},{"type":"text","text":" dominates "},{"type":"codeVoice","code":"b"},{"type":"text","text":" when every path"},{"type":"text","text":" "},{"type":"text","text":"from the root to "},{"type":"codeVoice","code":"b"},{"type":"text","text":" passes through "},{"type":"codeVoice","code":"a"},{"type":"text","text":". Each reachable vertex but the root has an immediate"},{"type":"text","text":" "},{"type":"text","text":"dominator, its closest strict dominator, which is its parent in the tree."}],"title":"DominatorTree","url":"\/documentation\/connectivity\/dominatortree","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DominatorTree","kind":"identifier"}],"navigatorTitle":[{"text":"DominatorTree","kind":"identifier"}],"type":"topic"}}}