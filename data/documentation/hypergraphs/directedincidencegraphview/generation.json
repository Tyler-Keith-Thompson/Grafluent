ation/Hypergraphs/DirectedIncidenceGraphView":{"url":"\/documentation\/hypergraphs\/directedincidencegraphview","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":" on "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an arc "},{"code":"i → n + p","type":"codeVoice"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"code":"i","type":"codeVoice"},{"type":"text","text":" of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" and "},{"code":"n + p → j","type":"codeVoice"},{"type":"text","text":" for each target "},{"code":"j","type":"codeVoice"},{"type":"text","text":". A vertex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"type":"topic","title":"DirectedIncidenceGraphView","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","abstract":[],"kind":"symbol","type":"topic","title":"Hypergraphs","role":"collection","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/generation":{"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/generation","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"generation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GraphGeneration","preciseIdentifier":"s:14GraphProtocols0A10GenerationV"}],"type":"topic","title":"generation","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/generation"},"doc://GraphProtocols/documentation/GraphProtocols/GraphGeneration":{"url":"\/documentation\/graphprotocols\/graphgeneration","abstract":[{"type":"text","text":"A graph’s generation: which state of which graph it is. Every structural mutation (an"},{"type":"text","text":" "},{"type":"text","text":"insertion, a removal, re-pointing an edge) starts a new generation; reserving capacity and"},{"type":"text","text":" "},{"type":"text","text":"writing attached map values do not. A structure derived from a graph stores the graph’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"generation"},{"type":"text","text":" and asks "},{"type":"codeVoice","code":"isCurrent(for:)"},{"type":"text","text":" before it relies on the graph again."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GraphGeneration","kind":"identifier"}],"navigatorTitle":[{"text":"GraphGeneration","kind":"identifier"}],"type":"topic","title":"GraphGeneration","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/GraphGeneration"}}}