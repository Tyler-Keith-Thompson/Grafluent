raphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges\/count","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges\/count","kind":"symbol","type":"topic","role":"symbol","title":"count","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"abstract":[]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges":{"title":"DirectedIncidenceGraphView.OutEdges","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges","kind":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"abstract":[{"type":"text","text":"The incidence numbers at one vertex of a directed incidence graph view, its edge"},{"type":"text","text":" "},{"type":"text","text":"positions: a stored or computed row (shifted by a constant), or a contiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"type":"codeVoice","code":"InEdges"},{"text":".","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"title":"DirectedIncidenceGraphView","url":"\/documentation\/hypergraphs\/directedincidencegraphview","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","c