ce numbers at one vertex of a directed incidence graph view, its edge"},{"type":"text","text":" "},{"type":"text","text":"positions: a stored or computed row (shifted by a constant), or a contiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"type":"codeVoice","code":"InEdges"},{"type":"text","text":"."}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutEdges"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OutEdges"}],"title":"DirectedIncidenceGraphView.OutEdges","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges/last":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges\/last","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"last"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:ST7ElementQa"},{"kind":"text","text":"?"}],"title":"last","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges\/last","role":"symbol","abstract":[]}}}