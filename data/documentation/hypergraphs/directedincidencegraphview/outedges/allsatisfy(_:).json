ment. Also the view’s "},{"type":"codeVoice","code":"InEdges"},{"type":"text","text":"."}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutEdges"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OutEdges"}],"title":"DirectedIncidenceGraphView.OutEdges","type":"topic"}}}