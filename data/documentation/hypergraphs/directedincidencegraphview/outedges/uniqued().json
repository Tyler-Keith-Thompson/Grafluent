umentation/Hypergraphs/DirectedIncidenceGraphView":{"type":"topic","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":" on "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an arc "},{"code":"i → n + p","type":"codeVoice"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"code":"i","type":"codeVoice"},{"type":"text","text":" of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" and "},{"code":"n + p → j","type":"codeVoice"},{"type":"text","text":" for each target "},{"code":"j","type":"codeVoice"},{"type":"text","text":". A vertex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview","title":"DirectedIncidenceGraphView","navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges":{"role":"symbol","navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","title":"DirectedIncidenceGraphView.OutEdges","abstract":[{"type":"text","text":"The incidence numbers at one vertex of a directed incidence graph view, its edge"},{"type":"text","text":" "},{"type":"text","text":"positions: a stored or computed row (shifted by a constant), or a contiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"type":"codeVoice","code":"InEdges"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}]}}}