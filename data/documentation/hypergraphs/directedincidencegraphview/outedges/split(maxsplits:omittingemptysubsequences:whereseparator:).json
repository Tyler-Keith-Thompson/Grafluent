idenceGraphView.OutEdges","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The incidence numbers at one vertex of a directed incidence graph view, its edge"},{"type":"text","text":" "},{"type":"text","text":"positions: a stored or computed row (shifted by a constant), or a contiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"code":"InEdges","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"kind":"symbol","type":"topic","title":"DirectedIncidenceGraphView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":" on "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an arc "},{"code":"i → n + p","type":"codeVoice"},{"type":"te