/Hypergraphs/DirectedIncidenceGraphView/OutEdges":{"abstract":[{"type":"text","text":"The incidence numbers at one vertex of a directed incidence graph view, its edge"},{"type":"text","text":" "},{"type":"text","text":"positions: a stored or computed row (shifted by a constant), or a contiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"type":"codeVoice","code":"InEdges"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges","title":"DirectedIncidenceGraphView.OutEdges","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges/adjacentPairs()":{"kind":"symbol","abstract":[],"type":"topic","role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges\/adjacentpairs()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges\/adjacentPairs()","title":"adjacentPairs()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjacentPairs"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AdjacentPairsCollection","preciseIdentifier":"s:10Algorithms23AdjacentPairsCollectionV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","abstract":[],"url":"\/documentation\/hypergraphs","role":"collection","type":"topic","title":"Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview","title":"DirectedIncidenceGraphView","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}]}}}