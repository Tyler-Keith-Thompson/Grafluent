"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/directedincidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","title":"DirectedIncidenceGraphView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges":{"abstract":[{"type":"text","text":"The incidence numbers at one vertex of a directed incidence graph view, its edge"},{"type":"text","text":" "},{"type":"text","text":"positions: a stored or computed row (shifted by a constant), or a contiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"type":"codeVoice","code":"InEdges"},{"type":"text","text":"."}],"title":"DirectedIncidenceGraphView.OutEdges","type":"topic","navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges"}}}