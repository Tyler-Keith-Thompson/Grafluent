ntifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"kind":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}],"title":"DirectedIncidenceGraphView.OutEdges","abstract":[{"type":"text","text":"The incidence numbers at one vertex of a directed incidence graph view, its edge"},{"type":"text","text":" "},{"type":"text","text":"positions: a stored or computed row (shifted by a constant), or a contiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"type":"codeVoice","code":"InEdges"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","type":"topic","navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"title":"Hypergraphs","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","role":"collection","kind":"symbol","url":"\/documentation\/hypergraphs"}}}