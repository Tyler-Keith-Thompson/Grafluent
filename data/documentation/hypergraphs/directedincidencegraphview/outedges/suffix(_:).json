:" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview"},"doc://Hypergraphs/documentation/Hypergraphs":{"abstract":[],"role":"collection","url":"\/documentation\/hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","type":"topic","kind":"symbol","title":"Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges/suffix(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"suffix","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"SubSequence","preciseIdentifier":"s:Sl11SubSequenceQa"}],"title":"suffix(_:)","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges\/suffix(_:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges\/suffix(_:)","kind":"symbol","abstract":[],"type":"topic","role":"symbol"}}}