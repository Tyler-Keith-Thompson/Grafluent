tiguous range. Random"},{"type":"text","text":" "},{"type":"text","text":"access, O(1) per element. Also the view’s "},{"code":"InEdges","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"OutEdges","kind":"identifier"}],"role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutEdges","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/OutEdges/keyed(by:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/OutEdges\/keyed(by:)","kind":"symbol","title":"keyed(by:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyed"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">("},{"kind":"externalParam","text":"by"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":"]"}],"abstract":[],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/outedges\/keyed(by:)"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"kind":"symbol","type":"topic","title":"DirectedIncidenceGraphView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedIncidenceGraphView"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":" on "},{"code":"0 ..< n + m","type":"codeVoice"},{"type":"text","text":" whose vertex "},{"code":"i < n","type":"codeVoice"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" and whose vertex "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", with an arc "},{"code":"i → n + p","type":"codeVoice"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"code":"i","type":"codeVoice"},{"type":"text","text":" of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" and "},{"code":"n + p → j","type":"codeVoice"},{"type":"text","text":" for each target "},{"code":"j","type":"codeVoice"},{"type":"text","text":". A vertex on both sides of "},{"code":"p","type":"codeVoice"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"code":"i → n + p → i","type":"codeVoice"},{"type":"text","text":"."}]}}}