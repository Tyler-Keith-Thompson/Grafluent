:"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Vertex":{"abstract":[],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/vertex","kind":"symbol","title":"DirectedIncidenceGraphView.Vertex","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Vertex","type":"topic","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"}],"navigatorTitle":[{"text":"Vertex","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","kind":"symbol","type":"topic","