phs/DirectedIncidenceGraphView/Neighbors":{"abstract":[{"text":"The successors or predecessors of one vertex of the view: a vertex’s out- or","type":"text"},{"text":" ","type":"text"},{"text":"in-hyperedge indices shifted by n, or a hyperedge’s target or source indices, read from","type":"text"},{"text":" ","type":"text"},{"text":"the base without boxing.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Neighbors"}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors","title":"DirectedIncidenceGraphView.Neighbors","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Neighbors"}]},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Neighbors/adjacentPairs()":{"abstract":[],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors\/adjacentpairs()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors\/adjacentPairs()","title":"adjacentPairs()","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"adjacentPairs"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","kind":"typeIdentifier","text":"AdjacentPairsSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs","kind":"symbol","abstract":[],"url":"\/documentation\/hypergraphs","role":"collection","type":"topic","title":"Hypergraphs"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storag