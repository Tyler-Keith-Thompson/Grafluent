ectedIncidenceGraphView\/Neighbors"]]},"variants":[{"paths":["\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors\/adjacentpairs()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Neighbors":{"abstract":[{"type":"text","text":"The successors or predecessors of one vertex of the view: a vertex’s out- or"},{"type":"text","text":" "},{"type":"text","text":"in-hyperedge indices shifted by n, or a hyperedge’s target or source indices, read from"},{"type":"text","text":" "},{"type":"text","text":"the base without boxing."}],"kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Neighbors"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Neighbors"}],"title":"DirectedIncidenceGraphView.Neighbors","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Neighbors/adjacentPairs()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"adjacentPairs","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AdjacentPairsSequence","preciseIdentifier":"s:10Algorithms21AdjacentPairsSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors\/adjacentpairs()","title":"adjacentPairs()","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors\/adjacentPairs()","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView":{"navigatorTitle":[{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"kind":"symbol","title":"DirectedIncidenceGraphView","url":"\/documentation\/hypergraphs\/directedincidencegraphview","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"identifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView","abstract":[{"type":"text","text":"A directed hypergraph’s incidence graph, read lazily from its storage: a"},{"type":"text","text":" "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":" on "},{"type":"codeVoice","code":"0 ..< n + m"},{"type":"text","text":" whose vertex "},{"type":"codeVoice","code":"i < n"},{"type":"text","text":" is the hypergraph’s vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" and whose vertex "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", with an arc "},{"type":"codeVoice","code":"i → n + p"},{"type":"text","text":" for each source"},{"type":"text","text":" "},{"type":"codeVoice","code":"i"},{"type":"text","text":" of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" and "},{"type":"codeVoice","code":"n + p → j"},{"type":"text","text":" for each target "},{"type":"codeVoice","code":"j"},{"type":"text","text":". A vertex on both sides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","kind":"symbol","type":"topic","role":"collection","abstract":[],"title":"Hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"}}}