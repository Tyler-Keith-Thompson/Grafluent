 base without boxing."}],"url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors","type":"topic","title":"DirectedIncidenceGraphView.Neighbors","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Neighbors"}],"navigatorTitle":[{"kind":"identifier","text":"Neighbors"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors"}}}