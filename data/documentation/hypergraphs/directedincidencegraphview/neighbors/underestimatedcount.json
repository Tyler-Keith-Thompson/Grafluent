":"text","text":" "},{"type":"text","text":"the base without boxing."}],"kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Neighbors"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Neighbors"}],"title":"DirectedIncidenceGraphView.Neighbors","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Neighbors/underestimatedCount":{"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors\/underestimatedCount","abstract":[],"title":"underestimatedCount","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors\/underestimatedcount","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"underestimatedCount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","kind":"symbol","type":"topic","role":"collection","abstract":[],"title":"Hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"}}}