ides of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" gives the 2-cycle"},{"type":"text","text":" "},{"type":"codeVoice","code":"i → n + p → i"},{"type":"text","text":"."}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/DirectedIncidenceGraphView/Neighbors":{"abstract":[{"type":"text","text":"The successors or predecessors of one vertex of the view: a vertex’s out- or"},{"type":"text","text":" "},{"type":"text","text":"in-hyperedge indices shifted by n, or a hyperedge’s target or source indices, read from"},{"type":"text","text":" "},{"type":"text","text":"the base without boxing."}],"kind":"symbol","role":"symbol","url":"\/documentation\/hypergraphs\/directedincidencegraphview\/neighbors","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Neighbors"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Neighbors"}],"title":"DirectedIncidenceGraphView.Neighbors","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/DirectedIncidenceGraphView\/Neighbors"},"doc://Hypergraphs/documentation/Hypergraphs":{"url":"\/documentation\/hypergraphs","kind":"symbol","type":"topic","role":"collection","abstract":[],"title":"Hypergraphs","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs"}}}