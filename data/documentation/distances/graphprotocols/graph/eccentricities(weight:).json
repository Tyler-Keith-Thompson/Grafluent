Distances/Eccentricities":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"type":"codeVoice","code":"all_eccentricities"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","type":"topic","url":"\/documentation\/distances\/eccentricities","title":"Eccentricities","navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedView":{"type":"topic","abstract":[{"type":"text","text":"An undirected graph read as a directed graph: each edge "},{"type":"codeVoice","code":"{u, v}"},{"type":"text","text":" is the two arcs "},{"type":"codeVoice","code":"u→v"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"v→u"},{"type":"text","text":", so "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" and "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":" are both "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}],"kind":"symbol","navigatorTitle":[{"text":"DirectedView","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedView","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedview","title":"DirectedView"}}}