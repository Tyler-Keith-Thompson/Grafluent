"symbol","url":"\/documentation\/graphprotocols\/directedview","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedView","abstract":[{"text":"An undirected graph read as a directed graph: each edge ","type":"text"},{"type":"codeVoice","code":"{u, v}"},{"text":" is the two arcs ","type":"text"},{"type":"codeVoice","code":"u→v"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"v→u"},{"type":"text","text":", so "},{"type":"codeVoice","code":"successors"},{"type":"text","text":" and "},{"type":"codeVoice","code":"predecessors"},{"type":"text","text":" are both "},{"type":"codeVoice","code":"neighbors"},{"type":"text","text":", and "},{"type":"codeVoice","code":"edgeCount"},{"type":"text","text":" is twice the"},{"type":"text","text":" "},{"type":"text","text":"base’s."}]},"doc://Distances/documentation/Distances/GraphProtocols/Graph/eccentricities()":{"identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/Graph\/eccentricities()","kind":"symbol","abstract":[{"text":"Every vertex’s eccentricity: the greatest distance, in edges, to another vertex; nil for","type":"text"},{"text":" ","type":"text"},{"text":"every vertex when the graph is not connected. Takes and Kosters’ bounding: as few searches","type":"text"},{"text":" ","type":"text"},{"text":"as the bounds need (a handful on sparse real-world graphs, n on a cycle). O(k(n + m)).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"eccentricities"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Eccentricities","preciseIdentifier":"s:9Distances14EccentricitiesV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedView","preciseIdentifier":"s:14GraphProtocols12DirectedViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":