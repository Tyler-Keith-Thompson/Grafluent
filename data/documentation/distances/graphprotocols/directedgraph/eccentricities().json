le from it. Breadth-first search from every"},{"type":"text","text":" "},{"type":"text","text":"vertex, skipping those reached by a search that missed a vertex (they miss it too)."},{"type":"text","text":" "},{"type":"text","text":"O(n(n + m))."}],"identifier":{"url":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph\/eccentricities()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Distances\/documentation\/Distances","doc:\/\/Distances\/documentation\/Distances\/GraphProtocols","doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph"]]},"references":{"doc://Distances/documentation/Distances/GraphProtocols/DirectedGraph/eccentricities()":{"kind":"symbol","url":"\/documentation\/distances\/graphprotocols\/directedgraph\/eccentricities()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eccentricities","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Eccentricities","kind":"typeIdentifier","preciseIdentifier":"s:9Distances14EccentricitiesV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Every vertex’s eccentricity over out-distances: the greatest distance from it to another"},{"type":"text","text":" "},{"type":"text","text":"vertex; nil when some vertex is not reachable from it. Breadth-first search from every"},{"type":"text","text":" "},{"type":"text","text":"vertex, skipping those reached by a search that missed a vertex (they miss it too)."},{"type":"text","text":" "},{"type":"text","text":"O(n(n + m))."}],"title":"eccentricities()","role":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph\/eccentricities()"},"doc://Distances/documentation/Distances/GraphProtocols/DirectedGraph":{"kind":"symbol","url":"\/documentation\/distan