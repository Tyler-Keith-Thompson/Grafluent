 eccentricity, computed once (Boost’s ","type":"text"},{"code":"all_eccentricities","type":"codeVoice"},{"text":"), with the measures","type":"text"},{"text":" ","type":"text"},{"text":"that follow from them: the radius (the least), the diameter (the greatest), the center and","type":"text"},{"text":" ","type":"text"},{"text":"the periphery (the vertices that attain them). An eccentricity is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", standing for","type":"text"},{"text":" ","type":"text"},{"text":"infinity, when some vertex is not reachable from the vertex; so the diameter is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is not connected (or not strongly connected), and the radius when no vertex","type":"text"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"url":"\/documentation\/distances\/eccentricities","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eccentricities"}],"role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Eccentricities"}],"identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities"},"doc://Distances/documentation/Distances/GraphProtocols/DirectedGraph":{"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/distances\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[],"fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P","kind":"identifier"}],"title":"DirectedGraph","identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph"},"doc://Distances/documentation/Distances/GraphProtocols":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/distances\/graphprotocols","abstract":[],"tit