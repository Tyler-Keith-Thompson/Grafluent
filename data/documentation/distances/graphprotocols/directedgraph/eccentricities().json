ier":{"url":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph\/eccentricities()","interfaceLanguage":"swift"},"abstract":[{"text":"Every vertex’s eccentricity over out-distances: the greatest distance from it to another","type":"text"},{"text":" ","type":"text"},{"text":"vertex; nil when some vertex is not reachable from it. Breadth-first search from every","type":"text"},{"text":" ","type":"text"},{"text":"vertex, skipping those reached by a search that missed a vertex (they miss it too).","type":"text"},{"text":" ","type":"text"},{"text":"O(n(n + m)).","type":"text"}],"references":{"doc://Distances/documentation/Distances/GraphProtocols/DirectedGraph/eccentricities()":{"identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph\/eccentricities()","kind":"symbol","abstract":[{"type":"text","text":"Every vertex’s eccentricity over out-distances: the greatest distance from it to another"},{"type":"text","text":" "},{"type":"text","text":"vertex; nil when some vertex is not reachable from it. Breadth-first search from every"},{"type":"text","text":" "},{"type":"text","text":"vertex, skipping those reached by a search that missed a vertex (they miss it too)."},{"type":"text","text":" "},{"type":"text","text":"O(n(n + m))."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eccentricities"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:9Distances14EccentricitiesV","text":"Eccentricities"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"role":"symbol","title":"eccentricities()","url":"\/documentation\/distances\/graphprotocols\/directedgraph\/eccentricities()","type":"topic"},"doc://Distances/documentation/Distances":{"role":"collection","title":"Distances","type":"topic","kind":"symbol","url