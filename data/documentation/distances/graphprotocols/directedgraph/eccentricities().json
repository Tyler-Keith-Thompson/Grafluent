s":[{"paths":["\/documentation\/distances\/graphprotocols\/directedgraph\/eccentricities()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Every vertex’s eccentricity over out-distances: the greatest distance from it to another"},{"type":"text","text":" "},{"type":"text","text":"vertex; nil when some vertex is not reachable from it. Breadth-first search from every"},{"type":"text","text":" "},{"type":"text","text":"vertex, skipping those reached by a search that missed a vertex (they miss it too)."},{"type":"text","text":" "},{"type":"text","text":"O(n(n + m))."}],"references":{"doc://Distances/documentation/Distances/GraphProtocols/DirectedGraph/eccentricities()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph\/eccentricities()","url":"\/documentation\/distances\/graphprotocols\/directedgraph\/eccentricities()","title":"eccentricities()","abstract":[{"type":"text","text":"Every vertex’s eccentricity over out-distances: the greatest distance from it to another"},{"type":"text","text":" "},{"type":"text","text":"vertex; nil when some vertex is not reachable from it. Breadth-first search from every"},{"type":"text","text":" "},{"type":"text","text":"vertex, skipping those reached by a search that missed a vertex (they miss it too)."},{"type":"text","text":" "},{"type":"text","text":"O(n(n + m))."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eccentricities"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Eccentricities","preciseIdentifier":"s:9Distances14EccentricitiesV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"type":"topic"},"doc://Distances/documentation/Distances/GraphProtocols/DirectedGraph":{"type":"topic","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"role":"symbol","kind":"symbol","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"abstract":[],"identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph","url":"\/documentation\/distances\/graphprotocols\/directedgraph","title":"DirectedGraph"},"doc://Distances/documentation/Distances/GraphProtocols":{"identifier":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols","type":"topic","title":"GraphProtocols","kind":"symbol","url":"\/documentation\/distances\/graphprotocols","role":"collection","abstract":[]},"doc://Distances/documentation/Distances/Eccentricities":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Eccentricities"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eccentricities"}],"abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"type":"codeVoice","code":"all_eccentricities"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"url":"\/documentation\/distances\/eccentricities","ide