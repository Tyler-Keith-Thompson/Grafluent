{"abstract":[{"type":"text","text":"Every vertex’s eccentricity over out-distances: the greatest distance from it to another"},{"type":"text","text":" "},{"type":"text","text":"vertex; nil when some vertex is not reachable from it. Breadth-first search from every"},{"type":"text","text":" "},{"type":"text","text":"vertex, skipping those reached by a search that missed a vertex (they miss it too)."},{"type":"text","text":" "},{"type":"text","text":"O(n(n + m))."}],"kind":"symbol","variants":[{"paths":["\/documentation\/distances\/graphprotocols\/directedgraph\/eccentricities()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Distances\/documentation\/Distances\/GraphProtocols\/DirectedGraph\/eccentricities()","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"fileName":"DirectedMeasures.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/Distances\/DirectedMeasures.swift#L43"},"extendedModule":"GraphProtocols","externalID":"s:14GraphProtocols08DirectedA0P9DistancesE14eccentricitiesAD14EccentricitiesVyxSiGyF","symbolKind":"method","role":"symbol","title":"eccentricities()","modules":[{"relatedModules":["GraphProtocols"],"name":"Distances"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"eccentricities"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Eccentricities","preciseIdentifier":"s:9Distances14EccentricitiesV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eccentricities","kind":"identifier"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/Distances\/documentation\/Distances\/Ec