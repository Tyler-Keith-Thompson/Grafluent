{"text":"?","kind":"text"}],"identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities\/diameter","abstract":[{"type":"text","text":"The greatest eccentricity; nil when some vertex has an unreachable one, or there is no"},{"type":"text","text":" "},{"type":"text","text":"vertex."}]},"doc://Distances/documentation/Distances/Eccentricities":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"type":"codeVoice","code":"all_eccentricities"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","type":"topic","url":"\/documentation\/distances\/eccentricities","title":"Eccentricities","navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}]},"doc://Distances/documentation/Distances":{"abstract":[],"role":"collection","kind":"symbol","title":"Distances","type":"topic","identifier":"doc:\/\/Distances\/documentation\/Distances","url":"\/documentation\/distances"}}}