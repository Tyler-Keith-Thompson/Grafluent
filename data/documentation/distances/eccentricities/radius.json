"text":": "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities\/radius"},"doc://Distances/documentation/Distances/Eccentricities":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Eccentricities"}],"title":"Eccentricities","type":"topic","abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"type":"codeVoice","code":"all_eccentricities"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"url":"\/documentation\/distances\/eccentricities","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eccentricities"}],"identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities"},"doc://Distances/documentation/Distances":{"role":"collection","title":"Distances","type":"topic","kind":"symbol","url":"\/documentation\/distances","abstract":[],"identifier":"doc:\/\/Distances\/documentation\/Distances"}}}