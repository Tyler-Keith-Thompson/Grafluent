ice"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}],"role":"symbol","url":"\/documentation\/distances\/eccentricities"},"doc://Distances/documentation/Distances/Eccentricities/radius":{"abstract":[{"text":"The least eccentricity; nil when every vertex has an unreachable one, or there is no vertex.","type":"text"}],"url":"\/documentation\/distances\/eccentricities\/radius","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities\/radius","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"radius","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","type":"topic","title":"radius","kind":"symbol"},"doc://Distances/documentation/Distances":{"identifier":"doc:\/\/Distances\/documentation\/Distances","type":"topic","kind":"symbol","title":"Distances","abstract":[],"role":"collection","url":"\/documentation\/distances"}}}