","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"url":"\/documentation\/distances\/eccentricities","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","title":"Eccentricities"},"doc://Distances/documentation/Distances":{"type":"topic","role":"collection","kind":"symbol","abstract":[],"identifier":"doc:\/\/Distances\/documentation\/Distances","url":"\/documentation\/distances","title":"Distances"},"doc://Distances/documentation/Distances/Eccentricities/radius":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"radius"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":"?"}],"type":"topic","url":"\/documentation\/distances\/eccentricities\/radius","abstract":[{"text":"The least eccentricity; nil when every vertex has an unreachable one, or there is no vertex.","type":"text"}],"role":"symbol","title":"radius","kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities\/radius"}}}