ext"},{"text":"Distance","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","url":"\/documentation\/distances\/eccentricities\/radius","role":"symbol"},"doc://Distances/documentation/Distances/Eccentricities":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Eccentricities"}],"title":"Eccentricities","url":"\/documentation\/distances\/eccentricities","type":"topic","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eccentricities"}],"abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"code":"all_eccentricities","type":"codeVoice"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}]},"doc://Distances/documentation/Distances":{"title":"Distances","kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances","abstract":[],"role":"collection","url":"\/documentation\/distances","type":"topic"}}}