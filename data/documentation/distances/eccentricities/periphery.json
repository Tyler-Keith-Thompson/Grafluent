,"minor":3,"patch":0},"references":{"doc://Distances/documentation/Distances/Eccentricities":{"type":"topic","abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"code":"all_eccentricities","type":"codeVoice"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"role":"symbol","url":"\/documentation\/distances\/eccentricities","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","title":"Eccentricities","kind":"symbol","navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}]},"doc://Distances/documentation/Distances":{"type":"topic","title":"Distances","role":"collection","identifier":"doc:\/\/Distances\/documentation\/Distances","kind":"symbol","url":"\/documentation\/distances","abstract":[]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"type":"topic","abstract":[],"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"role":"symbol","url":"\/documen