[{"type":"text","text":"The vertices whose eccentricity is the diameter (nil equal to nil), in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order."},{"type":"text","text":" "},{"type":"text","text":"O(n)."}]},"doc://Distances/documentation/Distances/Eccentricities":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Eccentricities"}],"abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"type":"codeVoice","code":"all_eccentricities"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"text":"the periphery (the vertices that attain them). An eccentricity is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", standing for","type":"text"},{"text":" ","type":"text"},{"text":"infinity, when some vertex is not reachable from the vertex; so the diameter is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" exactly","type":"text"},{"text":" ","type":"text"},{"text":"when the graph is not connected (or not strongly connected), and the radius when no vertex","type":"text"},{"text":" ","type":"text"},{"text":"reaches every vertex.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","title":"Eccentricities","url":"\/documentation\/distances\/eccentricities","navigatorTitle":[{"kind":"identifier","text":"Eccentricities"}],"role":"symbol"}}}