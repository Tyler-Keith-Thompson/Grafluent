(n).","type":"text"}],"references":{"doc://Distances/documentation/Distances/Eccentricities":{"kind":"symbol","abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"code":"all_eccentricities","type":"codeVoice"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"url":"\/documentation\/distances\/eccentricities","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities","role":"symbol","title":"Eccentricities","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Eccentricities","kind":"identifier"}],"navigatorTitle":[{"text":"Eccentricities","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph/Vertex":{"abstract":[],"url":"\/documentation\/graphprotocols\/directedgraph\/vertex","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vertex"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"title":"Vertex","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph\/Vertex","role":"symbol","kind":"symbol"},"doc://Distances/documentation/Distances/Eccentric