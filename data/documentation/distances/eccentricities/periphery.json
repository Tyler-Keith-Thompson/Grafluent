,"major":0,"patch":0},"references":{"doc://Distances/documentation/Distances/Eccentricities/periphery":{"kind":"symbol","abstract":[{"text":"The vertices whose eccentricity is the diameter (nil equal to nil), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order.","type":"text"},{"text":" ","type":"text"},{"text":"O(n).","type":"text"}],"title":"periphery","type":"topic","role":"symbol","identifier":"doc:\/\/Distances\/documentation\/Distances\/Eccentricities\/periphery","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"periphery","kind":"identifier"},{"text":": [","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/distances\/eccentricities\/periphery"},"doc://Distances/documentation/Distances/Eccentricities":{"kind":"symbol","abstract":[{"type":"text","text":"Every vertex’s eccentricity, computed once (Boost’s "},{"type":"codeVoice","code":"all_eccentricities"},{"type":"text","text":"), with the measures"},{"type":"text","text":" "},{"type":"text","text":"that follow from them: the radius (the least), the diameter (the greatest), the center and"},{"type":"text","text":" "},{"type":"text","text":"the periphery (the vertices that attain them). An eccentricity is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", standing for"},{"type":"text","text":" "},{"type":"text","text":"infinity, when some vertex is not reachable from the vertex; so the diameter is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" exactly"},{"type":"text","text":" "},{"type":"text","text":"when the graph is not connected (or not strongly connected), and the radius when no vertex"},{"type":"text","text":" "},{"type":"text","text":"reaches every vertex."}],"title":"Eccentricities","type":"topic","role":"symbol","identifier":"doc:\/\/Distances