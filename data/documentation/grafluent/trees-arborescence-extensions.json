stPathTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:5Trees8NotATreeV","text":"NotATree"},{"kind":"text","text":")"}]},"doc://Trees/documentation/Trees/Tree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","kind":"symbol","title":"Tree","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"role":"symbol","url":"\/documentation\/trees\/tree"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","title":"Extensions to Forest","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","isActive":true,"type":"reference"},{"type":"text","text":"."}],"role":"collectionGroup","url":"\/documentation\/grafluent\/trees-forest-extensions"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(checked:_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"VertexNotFound","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"type":"topic","kind":"symbol","title":"lowestCommonAncestor(checked:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(checked:_:)","abstract":[{"code":"lowestCommonAncestor(of: a, b)","type":"codeVoice"},{"type":"text","text":", throwing instead of trapping when either is not a vertex."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"role":"symbol","url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(checked:_:)"},"doc://Trees/documentation/Trees/Forest":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","title":"Forest","abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"role":"symbol","url":"\/documentation\/trees\/forest"},"doc://Trees/documentation/Trees/OrderedTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"role":"symbol","url":"\/documentation\/trees\/orderedtree"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Arborescence/init(_:)":{"title":"init(_:)","type":"topic","url":"\/documentation\/shortestpaths\/trees\/arborescence\/init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence\/init(_:)","kind":"symbol","abstract":[{"type":"text","text":"The shortest-path tree of a one-source search, as an arborescence rooted at the source:"},{"type":"text","text":" "},{"type":"text","text":"every reached vertex, each with its "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":" as parent."}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"ShortestPathTree","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(ofIndex:_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","kind":"symbol","title":"lowestCommonAncestor(ofIndex:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(ofIndex:_:)","abstract":[{"type":"text","text":"The deepest common ancestor of the vertices at indices "},{"code":"a","type":"codeVoice"},{"type":"text","text":" and "},{"code":"b","type":"codeVoice"},{"type":"text","text":", as an index."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"role":"symbol","url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(ofindex:_:)"},"doc://Trees/documentation/Trees/Arborescence":{"role":"symbol","type":"topic","url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-OrderedTree-Extensions":{"role":"collectionGroup","type":"topic","url":"\/documentation\/grafluent\/trees-orderedtree-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","isActive":true},{"type":"text","text":"."}],"title":"Extensions to OrderedTree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-OrderedTree-Extensions","kind":"article"},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","type":"topic","url":"\/documentation\/trees\/rootedtree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"title":"RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"kind":"symbol"},"doc://Connectivity/documentation/Connectivity/Trees/Arborescence/init(_:)":{"title":"init(_:)","type":"topic","