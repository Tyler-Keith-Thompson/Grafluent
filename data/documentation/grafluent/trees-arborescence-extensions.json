gorithms\/Trees\/Arborescence\/lowestCommonAncestor(ofIndex:_:)","url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(ofindex:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://Trees/documentation/Trees/Arborescence":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/arborescence","kind":"symbol","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"url":"\/documentation\/grafluent\/trees-tree-extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documenta