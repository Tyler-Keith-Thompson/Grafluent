ph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"role":"symbol","title":"Forest","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","kind":"symbol","url":"\/documentation\/trees\/arborescence","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/RootedTree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Root