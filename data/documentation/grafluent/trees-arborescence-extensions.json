rtex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","url":"\/documentation\/trees\/rootedtree","role":"symbol","title":"RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"kind":"symbol"},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","url":"\/documentation\/trees\/tree","role":"symbol","title":"Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Arborescence/init(_:)":{"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence\/init(_:)","url":"\/documentation\/shortestpaths\/trees\/arborescence\/init(_:)","title":"init(_:)","role":"symbol","abstract":[{"text":"The shortest-path tree of a one-source search, as an arborescence rooted at the source:","type":"text"},{"text":" ","type":"text"},{"text":"every reached vertex, each with its ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"text":" as parent.","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":