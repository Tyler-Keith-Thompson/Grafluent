rom unchecked input is failable, and a "},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}],"type":"topic"},"doc://Trees/documentation/Trees/Forest":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"title":"Forest","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"code":"trees","type":"codeVoice"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":" says which one a vertex is in."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","url":"\/documentation\/trees\/forest","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}]},"doc://Trees/documentation/Trees/Arborescence":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"url":"\/documentation\/trees\/arborescence","type":"topic","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"co