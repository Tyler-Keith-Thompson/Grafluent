"text":")"}],"kind":"symbol","abstract":[{"type":"text","text":"The shortest-path tree of a one-source search, as "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":" builds it, throwing instead of"},{"type":"text","text":" "},{"type":"text","text":"trapping when the search had several sources: a shortest-path forest is then not a tree."},{"type":"text","text":" "},{"type":"codeVoice","code":"Forest(tree)"},{"type":"text","text":" takes any number of sources. O(n)."}],"role":"symbol","url":"\/documentation\/shortestpaths\/trees\/arborescence\/init(checked:)","type":"topic"},"doc://Trees/documentation/Trees/Forest":{"type":"topic","title":"Forest","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","url":"\/documentation\/trees\/forest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"navigatorTitle":[{"text":"Forest","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(of:_:)":{"title":"lowestCommonAncestor(of:_:)","role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(of:_:)","abstract":[{"text":"The deepest vertex that is an ancestor of both ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", a vertex counting as its own","type":"text"},{"text":" ","type":"text"},{"text":"ancestor (see ","type":"text"},{"type":"codeVoice","code":"RootedTree.lowestCommonAncestor(of:_:)"},{"text":"). O(depth(a) + depth(b)).","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(of:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"title":"Extensions to Forest","type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","url":"\/documentation\/grafluent\/trees-forest-extensions","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},{"type":"text","text":"."}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(checked:_:)":{"title":"lowestCommonAncestor(checked:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(checked:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","kind":"typeIdentifier","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"kind":"symbol","abstract":[{"type":"codeVoice","code":"lowestCommonAncestor(of: a, b)"},{"type":"text","text":", throwing instead of trapping when either is not a vertex."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"role":"symbol","type":"topic","url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(checked:_:)"},"doc://Connectivity/documentation/Connectivity/Trees/Arborescence/init(_:)":{"title":"init(_:)","role":"symbol","type":"topic","abstract":[{"text":"The dominator tree as an arborescence rooted at its root: every vertex the root reaches,","type":"text"},{"text":" ","type":"text"},{"text":"each with its immediate dominator as parent. A post-dominator tree converts the same way:","type":"text"},{"text":" ","type":"text"},{"text":"each vertex that reaches the exit, with its immediate post-dominator as parent.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Trees\/Arborescence\/init(_:)","url":"\/documentation\/connectivity\/trees\/arborescence\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:12Connectivity13DominatorTreeV","text":"DominatorTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">)","kind":"text"}]},"doc://Trees/documentation/Trees/Tree":{"title":"Tree","type":"topic","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","url":"\/documentation\/trees\/tree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"navigatorTitle":[{"kind":"identifier","text":"Tree"}],"kind":"symbol","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}]},"doc://Trees/documentation/Trees/OrderedTree":{"abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"url":"\/documentation\/trees\/orderedtree","role":"symbol","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","kind":"symbol","title":"OrderedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree"},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","kind":"symbol","url":"\/documentation\/trees\/rootedtree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}]}}}