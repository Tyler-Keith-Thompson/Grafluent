"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"kind":"symbol","title":"Tree","url":"\/documentation\/trees\/tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(checked:_:)":{"type":"topic","abstract":[{"type":"codeVoice","code":"lowestCommonAncestor(of: a, b)"},{"type":"text","text":", throwing instead of trapping when either is not a vertex."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"kind":"symbol","url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(checked:_:)","title":"lowestCommonAncestor(checked:_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","kind":"typeIdentifier","text":"VertexNotFound"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(checked:_:)"},"doc://Grafluent/documentation/Grafluent/Extensions":{"abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"kind":"article","title":"Extensions Across Modules","url":"\/documentation\/grafluent\/extensions","role