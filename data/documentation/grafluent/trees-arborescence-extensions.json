ex that reaches the exit, with its immediate post-dominator as parent.","type":"text"}],"kind":"symbol"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent. As a ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"topic","url":"\/documentation\/trees\/arborescence"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(of:_:)":{"title":"lowestCommonAncestor(of:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"role":"symbol","abstract":[{"text":"The deepest vertex that is an ancestor of both ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", a vertex counting