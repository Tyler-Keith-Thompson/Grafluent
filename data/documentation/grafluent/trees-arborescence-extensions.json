rs "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/rootedtree","title":"RootedTree"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(ofIndex:_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"a","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"b","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"type":"text","text":"The deepest common ancestor of the vertices at indices "},{"code":"a","type":"codeVoice"},{"type":"text","text":" and "},{"code":"b","type":"codeVoice"},{"type":"text","text":", as an index."},{"type":"text","text":" "},{"text":"O(depth(a) + depth(b)).","type":"text"}],"title":"lowestCommonAncestor(ofIndex:_:)","type":"topic","url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(ofindex:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(ofIndex:_:)","role":"symbol"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","title":"Grafluent","role":"collection","type":"topic","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"