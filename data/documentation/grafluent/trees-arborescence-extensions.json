{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"kind":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"url":"\/documentation\/trees\/rootedtree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"topic","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"title":"Extensions to Tree","url":"\/documentation\/grafluent\/trees-tree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic","kind":"article"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(checked:_:)":{"url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(checked:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV","text":"VertexNotFound","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(checked:_:)","type":"topic","abstract":[{"type":"codeVoice","code":"lowestCommonAncestor(of: a, b)"},{"type":"text","text":", throwing instead of trapping when either is not a vertex."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"kind":"symbol","role":"symbol","title":"lowestCommonAncestor(checked:_:)"},"doc://Connectivity/documentation/Connectivity/Trees/Arborescence/init(_:)":{"url":"\/documentation\/connectivity\/trees\/arborescence\/init(_:)","title":"init(_:)","identifier":"doc:\/\/Connectivity\/documentation\/Connectivity\/Trees\/Arborescence\/init(_:)","role":"symbol","abstract":[{"type":"text","text":"The dominator tree as an arborescence rooted at its root: every vertex the root reaches,"},{"type":"text","text":" "},{"type":"text","text":"each with its immediate dominator as parent. A post-dominator tree converts the same way:"},{"type":"text","text":" "},{"type":"text","text":"each vertex that reaches the exit, with its immediate post-dominator as parent."}],"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:12Connectivity13DominatorTreeV","text":"DominatorTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(ofIndex:_:)":{"url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(ofindex:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ofIndex"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(ofIndex:_:)","abstract":[{"type":"text","text":"The deepest common ancestor of the vertices at indices "},{"type":"codeVoice","code":"a"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"type":"text","text":", as an index."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"type":"topic","kind":"symbol","role":"symbol","title":"lowestCommonAncestor(ofIndex:_:)"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Arborescence/init(_:)":{"title":"init(_:)","url":"\/documentation\/shortestpaths\/trees\/arborescence\/init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence\/init(_:)","role":"symbol","abstract":[{"type":"text","text":"The shortest-path tree of a one-source search, as an arborescence rooted at the source:"},{"type":"text","text":" "},{"type":"text","text":"every reached vertex, each with its "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":" as parent."}],"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"ShortestPathTree","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Arborescence/lowestCommonAncestor(of:_:)":{"url":"\/documentation\/treealgorithms\/trees\/arborescence\/lowestcommonancestor(of:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Arborescence\/lowestCommonAncestor(of:_:)","type":"topic","abstract":[{"type":"text","text":"The deepest vertex that is an ancestor of both "},{"code":"a","type":"codeVoice"},{"type":"text","text":" and "},{"code":"b","type":"codeVoice"},{"type":"text","text":", a vertex counting as its own"},{"type":"text","text":" "},{"type":"text","text":"ancestor (see "},{"code":"RootedTree.lowestCommonAncestor(of:_:)","type":"codeVoice"},{"type":"text","text":"). O(depth(a) + depth(b))."}],"kind":"symbol","role":"symbol","title":"lowestCommonAncestor(of:_:)"},"doc://Trees/documentation/Trees/Forest":{"title":"Forest","url":"\/documentation\/trees\/forest","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","role":"symbol","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Extensions":{"url":"\/documentation\/grafluent\/extensions","title":"Extensions Across Modules","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","role":"collectionGroup","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"type":"topic","kind":"article"},"doc://Grafluent/documentation/Grafluent":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent","title":"Grafluent","role":"collection","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"kind":"symbol","type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"url":"\/documentation\/grafluent\/trees-forest-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},{"type":"text","text":"."}],"kind":"article","role":"collectionGroup","title":"Extensions to Forest"},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Arborescence/init(_:in:)":{"title":"init(_:in:)","url":"\/documentation\/spanningtrees\/trees\/arborescence\/init(_:in:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Arborescence\/init(_:in:)","role":"symbol","abstract":[{"type":"text","text":"The spanning arborescence a branching is, over the graph it came from; nil unless the"},{"type":"text","text":" "},{"type":"text","text":"branching has "},{"type":"codeVoice","code":"graph.vertexCount − 1"},{"type":"text","text":" edges, so that one root reaches every vertex (and"},{"type":"text","text":" "},{"type":"text","text":"nil for a graph with no vertices)."}],"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Branching","preciseIdentifier":"s:13SpanningTrees9BranchingV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":")"}],"kind":"symbol"},"doc://Trees/documentation/Trees/Arborescence":{"url":"\/documentation\/trees\/arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Arborescence/init(checked:)":{"title":"init(checked:)","url":"\/documentation\/shortestpaths\/trees\/arborescence\/init(checked:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Arborescence\/init(checked:)","role":"symbol","abstract":[{"type":"text","text":"The shortest-path tree of a one-source search, as "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":" builds it, throwing instead of"},{"type":"text","text":" "},{"type":"text","text":"trapping when the search had several sources: a shortest-path forest is then not a tree."},{"type":"text","text":" "},{"type":"codeVoice","code":"Forest(tree)"},{"type":"text","text":" takes any number of sources. O(n)."}],"type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ShortestPathTree","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NotATree","preciseIdentifier":"s:5Trees8NotATreeV"},{"kind":"text","text":")"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-OrderedT