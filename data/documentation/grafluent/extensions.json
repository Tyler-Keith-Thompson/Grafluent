:{"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","isActive":true},{"type":"text","text":"."}],"title":"Extensions to DirectedHypergraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","role":"collectionGroup","kind":"article","type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"kind":"article","role":"collectionGroup","url":"\/documentation\/grafluent\/trees-arborescence-extensions","title":"Extensions to Arborescence","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","type":"topic"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"BipartiteGraph","kind":"identifier"}],"url":"\/documentation\/bipartitegraphs\/bipartitegraph","title":"BipartiteGraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BipartiteGraph","kind":"identifier"}],"abstract":[{"text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left","type":"text"},{"text":" ","type":"text"},{"text":"endpoint first, so ","type":"text"},{"type":"codeVoice","code":"edges[e].u"},{"text":" is its left end.","type":"text"}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-