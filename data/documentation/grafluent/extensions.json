edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"role":"symbol","title":"Tree","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"kind":"symbol","role":"collection","title":"Grafluent","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"title":"Graph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directedView","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","url":"\/documentation\/graphprotocols\/graph"}}}