cessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}]},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedAcyclicGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":", petgraph’s "},{"code":"acyclic::Acyclic","type":"codeVoice"},{"type":"text","text":")."}],"kind":"symbol","navigatorTitle":[{"text":"DirectedAcyclicGraph","kind":"identifier"}],"role":"symbol","title":"DirectedAcyclicGraph","type":"topic","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"kind":"article","title":"Extensions to MutableDirectedGraph","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-mutabledirectedgraph-extensions"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","abstract":[{"type":"text","text":"Members other modules a