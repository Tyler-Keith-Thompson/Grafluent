ectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions","url":"\/documentation\/grafluent\/directedacyclicgraphmodule-directedacyclicgraph-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","kind":"article","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","title":"Extensions to RootedTree","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"type":"text","text":"."}]},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"kind":"symbol","role":"symbol","title":"BipartiteGraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"type":"topic","abstract":[{"type":"text","text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so"},{"type":"text","text":" "},{"type":"text","text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left"},{"type":"text","text":" "},{"type":"text","text":"endpoint first, so "},{"type":"codeVoice","code":"edges[e].u"},{"type":"text","text":" is its left end."}],"url":"\/documentation\/bipartitegraphs\/bipartitegraph","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"title":"BidirectionalDirectedGraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph"},"doc://Trees/documentation/Trees/Forest":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","url":"\/documentation\/trees\/forest","title":"Forest","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"title":"MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"kind":"article","role":"collectionGroup","title":"Extensions to Tree","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/trees-tree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions","kind":"article","url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","title":"Extensions to BipartiteGraph","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","type":"reference","isActive":true