"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"Extensions to MutableGraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"title":"DirectedHypergraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","kind":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph"},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"acyclic::Acyclic"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedAcyclicGraph"}],"title":"DirectedAcyclicGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedAcyclicGraph"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"kind":"article","role":"collectionGroup","url":"\/documentation\/grafluent\/trees-tree-extensions","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","title":"Extensions to Tree"},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"title":"Tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"topic","kind":"symbol","url":"\/documentation\/trees\/tree"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence"},"doc://Trees/documentation/Trees/RootedTree":{"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"title":"RootedTree","role":"symbol","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"topic","kind":"symbol","url":"\/documentation\/trees\/rootedtree"},"doc://Grafluent/documentation/Grafluent":{"abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"title":"Grafluent","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"title":"Extensions to RootedTree","kind":"article","role":"collectionGroup","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"abstract":[{"text":"An undirected graph that generic code can fill: the undirected counterpart of","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept, ","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":"), with the","type":"text"},{"text":" ","type":"text"},{"text":"members a reader needs to build a graph by key.","type":"text"}],"fragments":[{"kind