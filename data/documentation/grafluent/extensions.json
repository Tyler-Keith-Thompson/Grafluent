rs other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"},{"type":"text","text":"."}],"type":"topic","role":"collectionGroup"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"title":"Extensions to Forest","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/trees-forest-extensions","type":"topic"},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"title":"DirectedAcyclicGraph","role":"symbol","kind":"symbol","nav