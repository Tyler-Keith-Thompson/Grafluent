{"metadata":{"modules":[{"name":"Grafluent"}],"role":"collectionGroup","title":"Extensions Across Modules"},"sections":[],"abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"topicSections":[{"anchor":"GraphProtocols","title":"GraphProtocols","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions"]},{"anchor":"DirectedAcyclicGraphModule","title":"DirectedAcyclicGraphModule","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"]},{"anchor":"Trees","title":"Trees","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"]},{"anchor":"BipartiteGraphs","title":"BipartiteGraphs","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A type’s own page lists only the members of its own module. Each page here collects the"},{"type":"text","text":" "},{"type":"text","text":"members that every other module adds to one type."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluent\/extensions"]}],"kind":"article","references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"title":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"title":"Extensions to BidirectionalDirectedGraph","type":"topic","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"title":"Extensions to RootedTree","type":"topic","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/trees-rootedtree-extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"type":"topic","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"url":"\/documentation\/bipartitegraphs\/bipartitegraph","role":"symbol","abstract":[{"type":"text","text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so"},{"type":"text","text":" "},{"type":"text","text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left"},{"type":"text","text":" "},{"type":"text","text":"endpoint first, so "},{"code":"edges[e].u","type":"codeVoice"},{"type":"text","text":" is its left end."}],"title":"BipartiteGraph","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","type":"topic","kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"Extensions to BipartiteGraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"title":"BidirectionalDirectedGraph","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"kind":"symbol","abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"type":"codeVoice","code":"BidirectionalGraph"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","url":"\/documentation\/grafluent\/trees-arborescence-extensions","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference"},{"text":".","type":"text"}],"kind":"article","title":"Extensions to Arborescence"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"title":"Extensions to Tree","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/trees-tree-extensions","type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","kind":"article"},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","title":"Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"type":"codeVoice","code":"Tree"},{"text":" cannot be mutated.","type":"text"}],"url":"\/documentation\/trees\/tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"type":"topic"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/arborescence","role":"symbol","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","type":"topic","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","type":"reference","isActive":true},{"type":"text","text":"."}],"title":"Extensions to DirectedHypergraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","type":"topic","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true},{"type":"text","text":"."}],"title":"Extensions to DirectedGraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions"},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"role":"symbol","url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedAcyclicGraph"}],"kind":"symbol","abstract":[{"text":"A directed graph with no directed cycle, which keeps a topological order of its vertices","type":"text"},{"text":" ","type":"text"},{"text":"current as it changes (JGraphT’s ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"acyclic::Acyclic","type":"codeVoice"},{"text":").","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedAcyclicGraph"}],"title":"DirectedAcyclicGraph","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"},"doc://Grafluent/documentation/Grafluent/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions":{"title":"Extensions to DirectedAcyclicGraph","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/directedacyclicgraphmodule-directedacyclicgraph-extensions","type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"type":"topic","title":"Hypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"url":"\/documentation\/graphprotocols\/hypergraph","role":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"url":"\/documentation\/trees\/rootedtree","role":"symbol","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"kind":"symbol","title":"RootedTree"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"type":"topic","title":"Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","type":"topic","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},{"type":"text","text":"."}],"title":"Extensions to Graph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Hypergraph-Extensions":{"title":"Extensions to Hypergraph","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","kind":"article"},"doc://Grafluent/documentation/Grafluent":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent","role":"collection","title":"Grafluent","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"kind":"symbol"}}}