t":"(","type":"text"},{"type":"codeVoice","code":"add_vertex"},{"text":", ","type":"text"},{"type":"codeVoice","code":"add_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_vertex"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableGraph-Extensions":{"role":"collectionGroup","kind":"article","type":"topic","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"},{"text":".","type":"text"}],"title":"Extensions to MutableGraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","type":"topic","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","title":"Extensions to DirectedGraph","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","type":"topic","kind":"symbol","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","title":"DirectedAcyclicGraph","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedAcyclicGraph"}],"abstract":[{"text":"A directed graph with no directed cycle, which keeps a topological order of its vertices","type":"text"},{"text":" ","type":"text"},{"text":"current as it changes (JGraphT’s ","type":"text"},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"text":", petgraph’s ","type":"text"},{"type":"codeVoice","code":"acyclic::Acyclic"},{"text":").","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedAcyclicGraph"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"url":"\/documentation\/grafluent\/trees-tree-extensions","type":"topic","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","title":"Extensions to Tree","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"title":"Hypergraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"title":"DirectedHypergraph"},"doc://Grafluent/documentation/Grafluent":{"role":"collection","kind":"symbol","url":"\/documentation\/grafluent","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"title":"Grafluent"},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"url":"\/documentation\/graphprotocols\/mutablegraph","type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","title":"MutableGraph","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}],"abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept, "},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":" and "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":"), with the"},{"type":"text","text":" "},{"type":"text","text":"members a reader needs to build a graph by key."}],"navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}]},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"role":"collectionGroup","kind":"article","type":"topic","url":"\/documentation\/grafluent\/trees-arborescence-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference"},{"type":"text","text":"."}],"title":"Extensions to Arborescence"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","typ