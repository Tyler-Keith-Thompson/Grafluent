ype is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graph"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"type":"text","text":", "},{"code":"add_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_vertex","type":"codeVoice"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"title":"MutableDirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","url":"\/documentation\/graphprotocols\/mutabledirectedgraph"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"type":"text","text":"."}],"title":"Extensions to Arborescence","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescen