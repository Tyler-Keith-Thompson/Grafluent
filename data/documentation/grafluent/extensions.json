t","text":" says which one a vertex is in."}],"title":"Forest","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","title":"Extensions to RootedTree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"type":"text","text":"."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"type":"topic","title":"BidirectionalDirectedGraph","abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"code":"BidirectionalGraph","type":"codeVoice"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" because in-adjacency usually costs extra storage, and many algorithms only","type":"text"},{"text":" ","type":"text"},{"text":"go forward.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","title":"DirectedGraph","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}]},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/trees\/tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"type":"topic","title":"Tree","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"type":"codeVoice","code":"Tree"},{"text":" cannot be mutated.","type":"text"}]},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","navigatorTitle":[{"kind":"identifier","text":"DirectedAcyclicGraph"}],"kind":"symbol","title":"DirectedAcyclicGraph","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedAcyclicGraph"}],"type":"topic","abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"acyclic::Acyclic"},{"type":"text","text":")."}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"type":"topic","title":"Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Hypergraphs","type":"text"}]},{"text":", 1989). Not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidenceGraphView"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"type":"topic","title":"Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","role":"collectionGroup","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","type":"topic","title":"Extensions to Graph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","isActive":true},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","isActive":true},{"text":".","type":"text"}],"title":"Extensions to DirectedHypergraph","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","kind":"article"},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","kind":"symbol","title":"Grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","role":"collection","type":"topic","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"identifier":"doc:\/\/GraphProtocols\/doc