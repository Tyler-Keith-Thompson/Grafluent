ion/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"fragments":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedAcyclicGraph","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"MutableDirectedGraph","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols015MutableDirectedA0P"}],"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","abstract":[{"text":"A directed graph with no directed cycle, which keeps a topological order of its vertices","type":"text"},{"text":" ","type":"text"},{"text":"current as it changes (JGraphT’s ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":", petgraph’s ","type":"text"},{"code":"acyclic::Acyclic","type":"codeVoice"},{"text":").","type":"text"}],"title":"DirectedAcyclicGraph","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"type":"text","text":"."}],"title":"Extensions to BidirectionalDirectedGraph","kind":"article","type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions"},"doc://Grafluent/documentation/Grafluent/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions":{"title":"Extensions to D