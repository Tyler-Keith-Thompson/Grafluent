text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}]},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","type":"reference"},{"text":".","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions","title":"Extensions to BipartiteGraph"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/hypergraph","identifier":"doc:\/\/GraphProtocols\/documen