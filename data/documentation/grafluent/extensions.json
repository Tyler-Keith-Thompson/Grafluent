er":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","role":"collectionGroup","kind":"article"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"url":"\/documentation\/grafluent\/trees-arborescence-extensions","kind":"article","title":"Extensions to Arborescence","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"type":"text","text":"."}],"role":"collectionGroup"}}}