no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","type":"topic","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","role":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","url":"\/documentation\/grafluent\/trees-tree-extensions","title":"Extensions to Tree","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","isActive":true},{"type":"text","text":"."}],"type":"topic","role":"collectionGroup"},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","title":"RootedTree","kind":"symbol","abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"root","type":"codeVoice"},{"text":", ","type":"text"},{"code":"parent(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"depth(of:)","type":"codeVoice"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"code":"preorder","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"url":"\/documentation\/trees\/rootedtree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","title":"Graph","type":"topic","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directed","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","role":"symbol","kind":"symbol","abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent (NetworkX ","type":"text"},{"code":"is_arborescence","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Edmonds). A ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":": ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}]},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"type":"topic","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","role":"symbol","navigatorTitle":[{"text":"DirectedAcyclicGraph","kind":"identifier"}],"kind":"symbol","title":"DirectedAcyclicGraph","abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":", petgraph’s "},{"code":"acyclic::Acyclic","type":"codeVoice"},{"type":"text","text":")."}],"url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedAcyclicGraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MutableGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","url":"\/documentation\/graphprotocols\/mutablegraph","title":"MutableGraph","type":"topic","abstract":[{"text":"An undirected graph that generic code can fill: the undirected counterpart of","type":"text"},{"text":" ","type":"text"},{"type":"code