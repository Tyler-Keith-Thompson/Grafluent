fier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://Trees/documentation/Trees/RootedTree":{"title":"RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/trees\/rootedtree","role":"symbol","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"title":"Extensions to Arborescence","type":"topic","kind":"article","url":"\/documentation\/grafluent\/trees-arborescence-extensions","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions"},"doc://Grafluent/documentation/Grafluent/Multigraphs-DirectedPseudograph-Extensions":{"role":"collectionGroup","url":"\/documentation\/graf