{"abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A type’s own page lists only the members of its own module. Each page here collects the"},{"type":"text","text":" "},{"type":"text","text":"members that every other module adds to one type."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"metadata":{"role":"collectionGroup","title":"Extensions Across Modules","modules":[{"name":"Grafluent"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluent\/extensions"]}],"topicSections":[{"title":"GraphProtocols","anchor":"GraphProtocols","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions"]},{"title":"DirectedAcyclicGraphModule","anchor":"DirectedAcyclicGraphModule","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"]},{"title":"Trees","anchor":"Trees","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"]},{"title":"BipartiteGraphs","anchor":"BipartiteGraphs","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"]}],"references":{"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","role":"collection","title":"Grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","kind":"symbol","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true},{"text":".","type":"text"}],"role":"collectionGroup","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","title":"Extensions to DirectedGraph"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","abstract":[{"text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left","type":"text"},{"text":" ","type":"text"},{"text":"endpoint first, so ","type":"text"},{"code":"edges[e].u","type":"codeVoice"},{"text":" is its left end.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/bipartitegraphs\/bipartitegraph","role":"symbol","title":"BipartiteGraph","fragments":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"}