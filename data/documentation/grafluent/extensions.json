ch page here collects the"},{"type":"text","text":" "},{"type":"text","text":"members that every other module adds to one type."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluent\/extensions"]}],"metadata":{"modules":[{"name":"Grafluent"}],"role":"collectionGroup","title":"Extensions Across Modules"},"references":{"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableGraph-Extensions":{"type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","kind":"article","role":"collectionGroup","title":"Extensions to MutableGraph","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions"},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","title":"RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"url":"\/documentation\/trees\/rootedtree","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","type":"reference"},{"type":"text","text":"."}],"role":"collectionGroup","title":"Extensions to Forest","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","url":"\/documentation\/grafluent\/trees-forest-extensions","kind":"article"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Hypergraph-Extensions":{"type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","title":"Extensions to Hypergraph","url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"type":"topic","abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"type":"codeVoice","code":"BidirectionalGraph"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","title":"BidirectionalDirectedGraph"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"type":"topic","abstract":[{"text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left","type":"text"},{"text":" ","type":"text"},{"text":"endpoint first, so ","type":"text"},{"type":"codeVoice","code":"edges[e].u"},{"text":" is its left end.","type":"text"}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"kind":"symbol","role":"symbol","url":"\/documentation\/bipartitegraphs\/bipartitegraph","title":"BipartiteGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"type":"topic","navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"text":"one, and no type is both. ","type":"text"},{"type":"codeVoice","code":"directed"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"role":"symbol","title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","isActive":true,"type":"reference"},{"type":"text","text":"."}],"role":"collectionGroup","title":"Extensions to BidirectionalDirectedGraph","identifier":"doc: