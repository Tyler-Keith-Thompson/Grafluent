{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A type’s own page lists only the members of its own module. Each page here collects the"},{"type":"text","text":" "},{"type":"text","text":"members that every other module adds to one type."}]}],"kind":"content"}],"metadata":{"title":"Extensions Across Modules","modules":[{"name":"Grafluent"}],"role":"collectionGroup"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions"],"title":"GraphProtocols","anchor":"GraphProtocols"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"],"title":"DirectedAcyclicGraphModule","anchor":"DirectedAcyclicGraphModule"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"],"title":"Trees","anchor":"Trees"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"],"title":"BipartiteGraphs","anchor":"BipartiteGraphs"}],"variants":[{"traits":