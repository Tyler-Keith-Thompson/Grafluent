e":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},{"type":"text","text":"."}],"type":"topic","kind":"article","title":"Extensions to DirectedHypergraph","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"type":"topic","title":"DirectedGraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"url":"\/documentation\/grafluent\/trees-arborescence-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","title":"Extensions to Arborescence","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true,"type":"reference"},{"type":"text","text":"."}],"kind":"article"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","kind":"article","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"reference","isActive":true},{"text":".","type":"text"}],"title":"Extensions to Graph","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"url":"\/documentation\/grafluent\/trees-forest-extensions","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","isActive":true,"type":"reference"},{"type":"text","text":"."}],"title":"Extensions to Forest","type":"topic"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"},{"type":"text","text":"."}],"title":"Extensions to MutableGraph","type":"topic"},"doc://Trees/documentation/Trees/RootedTree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"url":"\/documentation\/trees\/rootedtree","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","role":"symbol","abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"root"},{"text":", ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"depth(of:)"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"type":"codeVoice","code":"preorder"},{"text":".","type":"text"}],"title":"RootedTree","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","role":"symbol","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}],"type":"topic","title":"DirectedHypergraph","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","role":"symbol","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraphView","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"type":"topic","title":"Hypergraph","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}]},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions","url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","kind":"article","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic","title":"Extensions to BipartiteGraph"}}}