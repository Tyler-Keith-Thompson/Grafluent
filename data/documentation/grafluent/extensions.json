e":"add_vertex"},{"text":", ","type":"text"},{"type":"codeVoice","code":"add_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_vertex"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"title":"MutableDirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","role":"symbol","type":"topic","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"type":"text","text":"."}],"title":"Extensions to BidirectionalDirectedGraph","role":"collectionGroup","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"te