"type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","isActive":true},{"type":"text","text":"."}],"role":"collectionGroup","kind":"article","title":"Extensions to Graph","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"title":"Extensions to BidirectionalDirectedGraph","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","type":"topic","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","kind":"article","role":"collectionGroup"},"doc://Trees/documentation/Trees/Tree":{"title":"Tree","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","role":"symbol","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","t