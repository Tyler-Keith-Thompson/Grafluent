 step: each member returns a sequence of the"},{"type":"text","text":" "},{"type":"text","text":"algorithm’s events, computed as they are pulled. Get one from "},{"type":"codeVoice","code":"Graph.lazy"},{"type":"text","text":"."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"LazyGraphView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazyGraphView"}],"kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"url":"\/documentation\/trees\/orderedtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","type":"topic","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"title":"OrderedTree"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"url":"\/documentation\/graphprotocols\/hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","type":"topic","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"text"