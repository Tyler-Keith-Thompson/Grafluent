{"sections":[],"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A type’s own page lists only the members of its own module. Each page here collects the"},{"type":"text","text":" "},{"type":"text","text":"members that every other module adds to one type."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"topicSections":[{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions"],"title":"GraphProtocols","anchor":"GraphProtocols"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"],"title":"DirectedAcyclicGraphModule","anchor":"DirectedAcyclicGraphModule"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"],"title":"Trees","anchor":"Trees"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"],"title":"BipartiteGraphs","anchor":"BipartiteGraphs"}],"variants":[{"paths":["\/documentation\/grafluent\/extensions"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"metadata":{"role":"collectionGroup","title":"Extensions Across Modules","modules":[{"name":"Grafluent"}]},"references":{"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"kind":"article","url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","role":"collectionGroup","title":"Extensions to DirectedHypergraph","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"kind":"article","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","role":"collectionGroup","title":"Extensions to BidirectionalDirectedGraph","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","isActive":true},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent":{"abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"url":"\/documentation\/grafluent","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","title":"Grafluent","role":"collection","kind":"symbol"},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":", petgraph’s "},{"code":"acyclic::Acyclic","type":"codeVoice"},{"type":"text","text":")."}],"url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","type":"topic","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","title":"DirectedAcyclicGraph","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedAcyclicGraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedAcyclicGraph"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directedView","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"url":"\/documentation\/graphprotocols\/graph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","title":"Graph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"kind":"symbol"},"doc://Trees/documentation/Trees/Arborescence":{"kind":"symbol","url":"\/documentation\/trees\/arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","role":"symbol","title":"Arborescence","type":"topic","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"text":"Hypergraphs","type":"text"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","type":"topic","url":"\/documentation\/graphprotocols\/hypergraph","title":"Hypergraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions","type":"topic","url":"\/documentation\/grafluent\/directedacyclicgraphmodule-directedacyclicgraph-extensions","title":"Extensions to DirectedAcyclicGraph","role":"collectionGroup","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"kind":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","role":"symbol","title":"DirectedHypergraph","type":"topic","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"kind":"article","url":"\/documentation\/grafluent\/trees-arborescence-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","role":"collectionGroup","title":"Extensions to Arborescence","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableGraph-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","title":"Extensions to MutableGraph","role":"collectionGroup","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"kind":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","role":"symbol","title":"MutableDirectedGraph","type":"topic","abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":", ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_vertex","type":"codeVoice"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}]},"doc://Trees/documentation/Trees/RootedTree":{"kind":"symbol","url":"\/documentation\/trees\/rootedtree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","role":"symbol","title":"RootedTree","type":"topic","abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"root","type":"codeVoice"},{"text":", ","type":"text"},{"code":"parent(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"depth(of:)","type":"codeVoice"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"code":"preorder","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"