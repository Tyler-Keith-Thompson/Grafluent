text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"title":"Arborescence"}}}