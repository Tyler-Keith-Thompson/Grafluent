xt":"<","kind":"text"},{"text":"Vertex","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so"},{"type":"text","text":" "},{"type":"text","text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left"},{"type":"text","text":" "},{"type":"text","text":"endpoint first, so "},{"type":"codeVoice","code":"edges[e].u"},{"text":" is its left end.","type":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","kind":"article","title":"Extensions to DirectedHypergraph","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","type":"reference","isActive":true},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"role":"collectionGroup","kind":"article","title":"Extensions to Graph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","type":"topic"},"doc://Trees/documentation/Trees/Tree":{"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","url":"\/documentation\/trees\/tree","kind":"symbol","fragments":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Vertex"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"}],"title":"Tree","type":"topic","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","kind":"article","title":"Extensions to RootedTree","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"role":"collectionGroup","kind":"article","title":"Extensions to Tree","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","type":"topic","url":"\/documentation\/grafluent\/trees-tree-extensions"},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"role":"collectionGroup","kind":"article","title":"Extensions to BipartiteGraph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph"},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions","url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","type":"topic"},"doc://Grafluent/documentation/Grafluent/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions":{"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions","url":"\/documentation\/grafluent\/directedacyclicgraphmodule-directedacyclicgraph-extensions","kind":"article","title":"Extensions to DirectedAcyclicGraph","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","isActive":true},{"type":"text","text":"."}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"DirectedHypergraph","type":"topic","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}]}}}