{"kind":"article","sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A type’s own page lists only the members of its own module. Each page here collects the","type":"text"},{"text":" ","type":"text"},{"text":"members that every other module adds to one type.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluent\/extensions"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"Grafluent"}],"title":"Extensions Across Modules","role":"collectionGroup"},"abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"topicSections":[{"title":"GraphProtocols","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions"],"anchor":"GraphProtocols"},{"title":"DirectedAcyclicGraphModule","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"],"anchor":"DirectedAcyclicGraphModule"},{"title":"Trees","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/G