{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A type’s own page lists only the members of its own module. Each page here collects the","type":"text"},{"text":" ","type":"text"},{"text":"members that every other module adds to one type.","type":"text"}]}]}],"metadata":{"role":"collectionGroup","modules":[{"name":"Grafluent"}],"title":"Extensions Across Modules"},"kind":"article","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluent\/extensions"]}],"identifier":{"url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"topicSections":[{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions"],"anchor":"GraphProtocols","title":"GraphProtocols"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"],"anchor":"DirectedAcyclicGraphModule","title":"DirectedAcyclicGraphModule"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"],"anchor":"Trees","title":"Trees"},{"identifiers":["doc:\/\/Gr