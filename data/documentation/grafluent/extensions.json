{"kind":"article","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"variants":[{"paths":["\/documentation\/grafluent\/extensions"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"topicSections":[{"anchor":"GraphProtocols","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions"],"title":"GraphProtocols"},{"anchor":"DirectedAcyclicGraphModule","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"],"title":"DirectedAcyclicGraphModule"},{"anchor":"Trees","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"],"title":"Trees"},{"anchor":"BipartiteGraphs","identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"],"title":"BipartiteGraphs"}],"metadata":{"modules":[{"name":"Grafluent"}],"role":"collectionGroup","title":"Extensions Across Modules"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A type’s own page lists only the members of its own module. Each page here collects the"},{"type":"text","text":" "},{"type":"text","text":"members that every other module adds to one type."}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","title":"Extensions to RootedTree","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"url":"\/documentation\/graphprotocols\/directedhypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"title":"DirectedHypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"title":"Hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"},"doc://Trees/documentation/Trees/Arborescence":{"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent (NetworkX ","type":"text"},{"code":"is_arborescence","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Edmonds). A ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":": ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence","kind":"symbol","url":"\/documentation\/trees\/arborescence"},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","isActive":true},{"type":"text","text":"."}],"kind":"article","type":"topic","title":"Extensions to BipartiteGraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Bipa