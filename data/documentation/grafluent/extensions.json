raph"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"kind":"symbol"},"doc://Trees/documentation/Trees/Tree":{"title":"Tree","url":"\/documentation\/trees\/tree","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","role":"symbol","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"kind":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"url":"\/documentation\/trees\/rootedtree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"topic","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree"},"doc://Trees/documentation/Trees/Forest":{"title":"Forest","url":"\/documentation\/trees\/forest","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","role":"symbol","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"title":"Extensions to Tree","url":"\/documentation\/grafluent\/trees-tree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic","kind":"article"},"doc://AdjacencyListModule/documentation/AdjacencyListModule/AdjacencyList":{"title":"AdjacencyList","url":"\/documentation\/adjacencylistmodule\/adjacencylist","identifier":"doc:\/\/AdjacencyListModule\/documentation\/AdjacencyListModule\/AdjacencyList","role":"symbol","abstract":[{"text":"A directed graph stored as out- and in-adjacency lists.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"AdjacencyList","kind":"identifier"}],"fragments":[{"tex