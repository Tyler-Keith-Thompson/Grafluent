eyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazyDirectedGraphView"}],"navigatorTitle":[{"kind":"identifier","text":"LazyDirectedGraphView"}],"url":"\/documentation\/graphprotocols\/lazydirectedgraphview","type":"topic"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"kind":"symbol","title":"Arborescence","url":"\/documentation\/trees\/arborescence","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}]},"doc://Multigraphs/documentation/Multigraphs/DirectedPseudograph":{"title":"DirectedPseudograph","role":"symbol","kind":"symbol","identifier":"doc:\/\/Multigraphs\/documentation\/Multigraphs\/DirectedPseudograph","abstract":[{"type":"text","text":"A directed graph that allows parallel edges and self-loops."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedPseudograph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedPseudograph","kind":"identifier"}],"url":"\/documentation\/multigraphs\/directedpseudograph","type":"topic"},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"kind":"symbol","title":"Tree","url":"\/documentation\/trees\/tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}]}}}