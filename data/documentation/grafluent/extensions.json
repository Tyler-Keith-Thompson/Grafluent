{"sections":[],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"A type’s own page lists only the members of its own module. Each page here collects the","type":"text"},{"text":" ","type":"text"},{"text":"members that every other module adds to one type.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent"]]},"topicSections":[{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions"],"anchor":"GraphProtocols","title":"GraphProtocols"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions"],"anchor":"DirectedAcyclicGraphModule","title":"DirectedAcyclicGraphModule"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"],"anchor":"Trees","title":"Trees"},{"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"],"anchor":"BipartiteGraphs","title":"BipartiteGraphs"}],"variants":[{"paths":["\/documentation\/grafluent\/extensions"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Extensions Across Modules","role":"collectionGroup","modules":[{"name":"Grafluent"}]},"abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"identifier":{"url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","interfaceLanguage":"swift"},"references":{"doc://Trees/documentation/Trees/Tree":{"navigatorTitle":[{"text":"Tree","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"role":"symbol","type":"topic","title":"Tree","url":"\/documentation\/trees\/tree","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"root","type":"codeVoice"},{"text":", ","type":"text"},{"code":"parent(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"depth(of:)","type":"codeVoice"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"code":"preorder","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"url":"\/documentation\/trees\/rootedtree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","title":"RootedTree","kind":"symbol"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","role":"collection","type":"topic","title":"Grafluent","url":"\/documentation\/grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph"},{"type":"text","text":"."}],"type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","title":"Extensions to Graph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"title":"DirectedHypergraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"type":"topic","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions":{"type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","isActive":true,"type":"reference"},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/directedacyclicgraphmodule-directedacyclicgraph-extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions","title":"Extensions to DirectedAcyclicGraph","kind":"article"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true},{"text":".","type":"text"}],"type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/trees-arborescence-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","kind":"article","title":"Extensions to Arborescence"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph"},{"type":"text","text":"."}],"type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","kind":"article","title":"Extensions to DirectedGraph"},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"type":"topic","abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"acyclic::Acyclic"},{"type":"text","text":")."}],"navigatorTitle":[{"kind":"identifier","text":"DirectedAcyclicGraph"}],"url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedAcyclicGraph"}],"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","title":"DirectedAcyclicGraph","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"title":"Hypergraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","role":"collectionGroup","title":"Extensions to DirectedHypergraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"kind":"symbol","title":"BipartiteGraph","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BipartiteGraph","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so"},{"type":"text","text":" "},{"type":"text","text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left"},{"type":"text","text":" "},{"type":"text","text":"endpoint first, so "},{"code":"edges[e].u","type":"codeVoice"},{"type":"text","text":" is its left end."}],"url":"\/documentation\/bipartitegraphs\/bipartitegraph","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","navigatorTitle":[{"text":"BipartiteGraph","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"kind":"article","role":"collectionGroup","type":"topic","title":"Extensions to Tree","url":"\/documentation\/grafluent\/trees-tree-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"title":"BidirectionalDirectedGraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"type":"text","text":"."}],"type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","title":"Extensions to BidirectionalDirectedGraph"},"doc://Trees/documentation/Trees/Arborescence":{"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"role":"symbol","type":"topic","title":"Arborescence","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"title":"Extensions to BipartiteGraph","kind":"article","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph"},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/trees-rootedtree-extensions","role":"collectionGroup","title":"Extensions to RootedTree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","kind":"article"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Hypergraph-Extensions":{"type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","title":"Extensions to Hypergraph","kind":"article"}}}