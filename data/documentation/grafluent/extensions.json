ode":"BidirectionalDirectedGraph"},{"text":": ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"title":"Arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"role":"symbol","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"text":", 1989). Not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidenceGraph"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"title":"Hypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Hypergraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","isActive":true},{"type":"text","text":"."}],"title":"Extensions to Hypergraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","role":"collectionGroup","type":"topic","kind":"article"},"doc://Grafluent/documentation/Grafluent/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions","role":"collectionGroup","kind":"article","title":"Extensions to DirectedAcyclicGraph","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/directedacyclicgraphmodule-directedacyclicgraph-extensions"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"topic","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"title":"BidirectionalDirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","