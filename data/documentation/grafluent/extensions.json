":"topic"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Hypergraph-Extensions":{"kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","isActive":true},{"text":".","type":"text"}],"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","type":"topic","title":"Extensions to Hypergraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"kind":"article","title":"Extensions to BidirectionalDirectedGraph","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","type":"topic"},"doc://Trees/documentation/Trees/Tree":{"type":"topic","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","role":"symbol","title":"Tree","kind":"symbol","url":"\/documentation\/trees\/tree"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","type":"reference","isActive":true},{"text":".","type":"text"}],"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","type":"topic","title":"Extensions to DirectedGraph"},"doc://Trees/documentation/Trees/RootedTree":{"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"type":"topic","url":"\/documentation\/trees\/rootedtree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"kind":"symbol","abstract":[{"text":"An undirected graph that generic code can fill: the undirected counterpart of","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept, ","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":"), with the","type":"text"},{"text":" ","type":"text"},{"text":"members a reader needs to build a graph by key.","type":"text"}],"role":"symbol","url":"\/documentation\/graphprotocols\/mutablegraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}],"type":"topic","title":"MutableGraph"},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph"},{"type":"text","text":"."}],"kind":"article","title":"Extensions to BipartiteGraph","type":"topic","url":"\/documentation\/grafluent\/bipartitegraphs-bipartitegraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/BipartiteGraphs-BipartiteGraph-Extensions","role":"collectionGroup"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"kind":"symbol","title":"BidirectionalDirectedGraph","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"code":"BidirectionalGraph","type":"codeVoice"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":" because in-adjacency usually costs extra storage, and many algorithms only","type":"text"},{"text":" ","type":"text"},{"text":"go forward.","type":"text"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"topic"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"role":"collection","url":"\/documentation\/grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","title":"Grafluent"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"kind":"symbol","title":"BipartiteGraph","navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"abstract":[{"text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left","type":"text"},{"text":" ","type":"text"},{"text":"endpoint first, so ","type":"text"},{"code":"edges[e].u","type":"codeVoice"},{"text":" is its left end.","type":"text"}],"identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","url":"\/documentation\/bipartitegraphs\/bipartitegraph","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","title":"Graph","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"url":"\/documentation\/graphprotocols\/graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","isActive":true},{"type":"text","text":"."}],"kind":"article","title":"Extensions to Tree","type":"topic","url":"\/documentation\/grafluent\/trees-tree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","role":"collectionGroup"},"doc://Grafluent/documentation/Grafluent/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions":{"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/DirectedAcyclicGraphModule-DirectedAcyclicGraph-Extensions","role":"collectionGroup","title":"Extensions to DirectedAcyclicGraph","url":"\/documentation\/grafluent\/directedacyclicgraphmodule-directedacyclicgraph-extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","kind":"article","title":"Extensions to Arborescence","url":"\/documentation\/grafluent\/trees-arborescence-extensions"},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":", petgraph’s "},{"code":"acyclic::Acyclic","type":"codeVoice"},{"type":"text","text":")."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedAcyclicGraph"}],"title":"DirectedAcyclicGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedAcyclicGraph"}],"type":"topic","url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"kind":"symbol","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"role":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"type":"topic","title":"DirectedHypergraph"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"type":"topic","url":"\/documentation\/trees\/arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","role":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","isActive":true},{"type":"text","text":"."}],"role":"collectionGroup","kind":"article","title":"Extensions to Graph","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"kind":"article","title":"Extensions to DirectedHypergraph","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"kind":"symbol","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"text":"Hypergraphs","type":"text"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"role":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"type":"topic","title":"Hypergraph"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"kind":"symbol","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"role":"symbol","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"type":"topic","title":"MutableDirectedGraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"role":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","title":"DirectedGraph"}}}