:"text"},{"code":"add_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_edge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"remove_vertex","type":"codeVoice"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","url":"\/documentation\/graphprotocols\/mutabledirectedgraph"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"title":"BipartiteGraph","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","navigatorTitle":[{"kind":"identifier","text":"BipartiteGraph"}],"url":"\/documentation\/bipartitegraphs\/bipartitegraph","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BipartiteGraph"}],"abstract":[{"text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so","type":"text"},{"text":" ","type":"text"},{"text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left","type":"text"},{"text":" ","type":"text"},{"text":"endpoint first, so ","type":"text"},{"code":"edges[e].u","type":"codeVoice"},{"text":" is its left end.","type":"text"}],"kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"t