/documentation\/trees\/tree","type":"topic","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"role":"symbol","title":"Tree"},"doc://Trees/documentation/Trees/Forest":{"type":"topic","kind":"symbol","url":"\/documentation\/trees\/forest","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"type":"codeVoice","code":"trees"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":" says which one a vertex is in.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"role":"symbol","title":"Forest"},"doc://Grafluent/documentation/Grafluent/BipartiteGraphs-BipartiteGraph-Extensions":{"title":"Extensions to BipartiteGraph","role":"collectionGroup","kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph"},{"text":".","type":"text"}],"type":"topic","url":"\/documentati