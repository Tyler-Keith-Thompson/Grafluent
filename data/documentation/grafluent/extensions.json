xt"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"abstract":[{"text":"An undirected graph that generic code can fill: the undirected counterpart of","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept, ","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":"), with the","type":"text"},{"text":" ","type":"text"},{"text":"members a reader needs to build a graph by key.","type":"text"}],"navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}],"title":"MutableGraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/mutablegraph"},"doc://Trees/documentation/Trees/Tree":{"kind":"symbol","role":"symbol","title":"Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"navigatorTitle":[{"text":"Tree","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"url":"\/documentation\/trees\/tree","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"role":"collectionGroup","title":"Extensions to MutableDirectedGraph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},{"type":"text","text":"."}],"kind":"article","type":"topic","url":"\/documentation\/grafluent\/graphprotocols-mutabledirectedgraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"type":"topic","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","title":"Extensions to DirectedGraph","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableGraph-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"},{"text":".","type":"text"}],"title":"Extensions to MutableGraph","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directedView","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph"},"doc://Trees/documentation/Trees/Arborescence":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","title":"Arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent (NetworkX ","type":"text"},{"type":"codeVoice","code":"is_arborescence"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Edmonds). A ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":": ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"type":"topic","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","title":"Extensions to DirectedHypergraph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","isActive":true},{"type":"text","text":"."}]},"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"kind":"symbol","role":"symbol","title":"DirectedAcyclicGraph","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedAcyclicGraph","kind":"identifier"}],"navigatorTitle":[{"text":"DirectedAcyclicGraph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph","abstract":[{"type":"text","text":"A directed graph with no directed cycle, which keeps a topological order of its vertices"},{"type":"text","text":" "},{"type":"text","text":"current as it changes (JGraphT’s "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":", petgraph’s "},{"type":"codeVoice","code":"acyclic::Acyclic"},{"text":").","type":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"type":"topic","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","title":"Extensions to BidirectionalDirectedGraph","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","title":"DirectedHypergraph","role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}]},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","url":"\/documentation\/trees\/rootedtree","title":"RootedTree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"abstract":[{"text":"A directed graph: a finite set of vertices and a finite collection of directed edges between","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph"},"doc://Grafluent/documentation/Grafluent":{"abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"title":"Grafluent","kind":"symbol","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","role":"collection","url":"\/documentation\/grafluent"}}}