ype":"text"},{"code":"add_edge","type":"codeVoice"},{"text":"), with the","type":"text"},{"text":" ","type":"text"},{"text":"members a reader needs to build a graph by key.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","url":"\/documentation\/graphprotocols\/mutablegraph","type":"topic","title":"MutableGraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableGraph","kind":"identifier"}],"navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"kind":"article","url":"\/documentation\/grafluent\/trees-forest-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","role":"collectionGroup","title":"Extensions to Forest","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Hypergraph-Extensions":{"kind":"article","url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","role":"collectionGroup","title":"Extensions to Hypergraph","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"},{"text":".","type":"text"}]},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}],"url":"\/documentation\/trees\/tree","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","title":"Tree","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"navigatorTitle":[{"kind":"identifier","text":"Tree"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","type":"topic","title":"Extensions to Graph","role":"collectionGroup","kind":"article"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"kind":"article","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","role":"collectionGroup","title":"Extensions to RootedTree","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/trees-tree-extensions","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","title":"Extensions to Tree","role":"collectionGroup","kind":"article"},"doc://BipartiteGraphs/documentation/BipartiteGraphs/BipartiteGraph":{"kind":"symbol","url":"\/documentation\/bipartitegraphs\/bipartitegraph","identifier":"doc:\/\/BipartiteGraphs\/documentation\/BipartiteGraphs\/BipartiteGraph","role":"symbol","title":"BipartiteGraph","type":"topic","abstract":[{"type":"text","text":"An undirected graph with two fixed sides, every edge joining a left vertex to a right vertex, so"},{"type":"text","text":" "},{"type":"text","text":"no self-loop. Simple: an edge is inserted once, in either orientation. Each edge is stored left"},{"type":"text","text":" "},{"type":"text","text":"endpoint first, so "},{"type":"codeVoice","code":"edges[e].u"},{"type":"text","text":" is its left end."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BipartiteGraph","kind":"identifier"}],"navigatorTitle":[{"text":"BipartiteGraph","kind":"identifier"}]},"doc://Trees/documentation/Trees/Forest":{"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","url":"\/documentation\/trees\/forest","type":"topic","title":"Forest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"navigatorTitle":[{"text":"Forest","kind":"identifier"}],"kind":"symbol"}}}