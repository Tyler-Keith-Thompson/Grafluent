"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"type":"topic","abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX"},{"type":"text","text":" "},{"code":"dfs_labeled_edges","type":"codeVoice"},{"type":"text","text":", forward then reverse). The trivial walk for one vertex. O(n)."}],"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerTour","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Walk","preciseIdentifier":"s:5Walks4WalkV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","title":"eulerTour","kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordCircularLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","type":"topic","title":"reingoldTilfordCircularLayout()","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()","abstract":[{"text":"The tidy drawing bent into a disc (igraph’s ","type":"text"},{"code":"layout_reingold_tilford_circular","type":"codeVoice"},{"text":"): a vertex","type":"text"},{"text":" ","type":"text"},{"text":"at (x, d) in ","type":"text"},{"code":"reingoldTilfordLayout()","type":"codeVoice"},{"text":" goes to d · (cos φ, sin φ), with","type":"text"},{"text":" ","type":"text"},{"text":"φ = 2π · (n − 1)\/n · (x − x₀)\/(x₁ − x₀) for the least and greatest x, x₀ and x₁ (no division","type":"text"},{"text":" ","type":"text"},{"text":"when they are equal). The root is at the origin, and each depth on the circle of that","type":"text"},{"text":" ","type":"text"},{"text":"radius.","type":"text"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"url":"\/documentation\/grafluent\/extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","title":"Extensions Across Modules","kind":"article"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"kind":"article","role":"collectionGroup","type":"topic","title":"Extensions to Tree","url":"\/documentation\/grafluent\/trees-tree-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","type":"topic","title":"reingoldTilfordLayout()","abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(of:_:)":{"abstract":[{"text":"The deepest vertex that is an ancestor of both ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", a vertex counting as its own","type":"text"},{"text":" ","type":"text"},{"text":"ancestor here (NetworkX ","type":"text"},{"type":"codeVoice","code":"lowest_common_ancestor"},{"text":"): ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" when ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" is above ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"(v, v)"},{"text":". It depends on the root. O(depth(a) + depth(b)), allocating nothing; for many","type":"text"},{"text":" ","type":"text"},{"text":"queries, ","type":"text"},{"type":"codeVoice","code":"LowestCommonAncestors"},{"text":" answers each in O(1).","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"title":"lowestCommonAncestor(of:_:)"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(ofIndex:_:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"role":"symbol","type":"topic","title":"lowestCommonAncestor(ofIndex:_:)","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(ofindex:_:)","abstract":[{"text":"The deepest common ancestor of the vertices at indices ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", as an index.","type":"text"},{"text":" ","type":"text"},{"text":"O(depth(a) + depth(b)).","type":"text"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(ofIndex:_:)"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true},{"text":".","type":"text"}],"type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/trees-arborescence-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","kind":"article","title":"Extensions to Arborescence"},"doc://Trees/documentation/Trees/Arborescence":{"navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"role":"symbol","type":"topic","title":"Arborescence","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"}}}