text":"at (x, d) in ","type":"text"},{"code":"reingoldTilfordLayout()","type":"codeVoice"},{"text":" goes to d · (cos φ, sin φ), with","type":"text"},{"text":" ","type":"text"},{"text":"φ = 2π · (n − 1)\/n · (x − x₀)\/(x₁ − x₀) for the least and greatest x, x₀ and x₁ (no division","type":"text"},{"text":" ","type":"text"},{"text":"when they are equal). The root is at the origin, and each depth on the circle of that","type":"text"},{"text":" ","type":"text"},{"text":"radius.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordCircularLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"type":"topic"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","