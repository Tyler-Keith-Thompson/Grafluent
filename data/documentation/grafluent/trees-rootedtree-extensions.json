,{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}]},"doc://Grafluent/documentation/Grafluent/Extensions":{"title":"Extensions Across Modules","type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","url":"\/documentation\/grafluent\/extensions","kind":"article","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}]},"doc://Trees/documentation/Trees/OrderedTree":{"abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"url":"\/documentation\/trees\/orderedtree","role":"symbol","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","kind":"symbol","title":"OrderedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"url":"\/documentation\/graflue