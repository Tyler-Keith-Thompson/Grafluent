pe":"text"},{"type":"codeVoice","code":"is_arborescence"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Edmonds). A ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":": ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}]},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","url":"\/documentation\/trees\/rootedtree","title":"RootedTree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}]},"doc://TreeAlgorithms/do