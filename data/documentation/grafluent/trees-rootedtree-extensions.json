put is failable, and a ","type":"text"},{"type":"codeVoice","code":"Tree"},{"text":" cannot be mutated.","type":"text"}],"url":"\/documentation\/trees\/tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","url":"\/documentation\/grafluent\/trees-arborescence-extensions","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference"},{"text":".","type":"text"}],"kind":"article","title":"Extensions to Arborescence"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"role":"symbol","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerTour"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Walk","preciseIdentifier":"s:5Walks4WalkV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">"}],"kind":"symbol","abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX"},{"type":"text","text":" "},{"type":"codeVoice","code":"dfs_labeled_edges"},{"type":"text","text":", forward then reverse). The trivial walk for one vertex. O(n)."}],"title":"eulerTour","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"title":"Extensions to Tree","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/trees-tree-extensions","type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","kind":"article"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"reingoldTilfordLayout()","abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","kind":"symbol"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"code":"is_arborescence","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": "},{"code":"successors(of:)","type":"codeVoice"},{"type":"text","text":" are the children, "},{"code":"predecessors(of:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/trees\/arborescence","role":"symbol","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent","role":"collection","title":"Grafluent","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(ofIndex:_:)":{"role":"symbol","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(ofindex:_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"kind":"symbol","abstract":[{"type":"text","text":"The deepest common ancestor of the vertices at indices "},{"type":"codeVoice","code":"a"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"type":"text","text":", as an index."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"title":"lowestCommonAncestor(ofIndex:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(ofIndex:_:)"},"doc://Grafluent/documentation/Grafluent/Extensions":{"title":"Extensions Across Modules","type":"topic","kind":"article","url":"\/documentation\/grafluent\/extensions","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordCircularLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"reingoldTilfordCircularLayout()","abstract":[{"type":"text","text":"The tidy drawing bent into a disc (igraph’s "},{"code":"layout_reingold_tilford_circular","type":"codeVoice"},{"type":"text","text":"): a vertex"},{"type":"text","text":" "},{"type":"text","text":"at (x, d) in "},{"code":"reingoldTilfordLayout()","type":"codeVoice"},{"type":"text","text":" goes to d · (cos φ, sin φ), with"},{"type":"text","text":" "},{"type":"text","text":"φ = 2π · (n − 1)\/n · (x − x₀)\/(x₁ − x₀) for the least and greatest x, x₀ and x₁ (no division"},{"type":"text","text":" "},{"type":"text","text":"when they are equal). The root is at the origin, and each depth on the circle of that"},{"type":"text","text":" "},{"type":"text","text":"radius."}],"type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()","role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","kind":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"url":"\/documentation\/trees\/rootedtree","role":"symbol","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"kind":"symbol","title":"RootedTree"}}}