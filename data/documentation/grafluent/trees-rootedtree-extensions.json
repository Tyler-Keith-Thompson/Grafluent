":"codeVoice","code":"a"},{"type":"text","text":" is above "},{"type":"codeVoice","code":"b"},{"type":"text","text":", and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"codeVoice","code":"(v, v)"},{"type":"text","text":". It depends on the root. O(depth(a) + depth(b)), allocating nothing; for many"},{"type":"text","text":" "},{"type":"text","text":"queries, "},{"type":"codeVoice","code":"LowestCommonAncestors"},{"type":"text","text":" answers each in O(1)."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","title":"lowestCommonAncestor(of:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","role":"symbol","kind":"symbol","title":"eulerTour","abstract":[{"text":"The closed walk from the root that goes down each child edge, in ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" order,","type":"text"},{"text":" ","type":"text"},{"text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dfs_labeled_edges"},{"text":", forward then reverse). The trivial walk for one vertex. O(n).","type":"text"}],"url":"\/documentation\/treealgorithms\/trees\/rootedtree