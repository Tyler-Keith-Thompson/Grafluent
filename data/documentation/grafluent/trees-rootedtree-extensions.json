Param"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The deepest common ancestor of the vertices at indices "},{"type":"codeVoice","code":"a"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"type":"text","text":", as an index."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(ofIndex:_:)","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"title":"Extensions to Arborescence","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/trees-arborescence-extensions","type":"topic","role":"collectionGroup"},"doc://Trees/documentation/Trees/Forest":{"type":"topic","title":"Forest","role":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"url":"\/documentation\/trees\/forest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"type":"codeVoice","code":"trees"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":" says which one a vertex is in.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"type":"topic","title":"Extensions to Forest","role":"collectionGroup","url":"\/documentation\/grafluent\/trees-forest-extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"type":"topic","title":"reingoldTilfordCircularLayout()","role":"symbol","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordCircularLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The tidy drawing bent into a disc."}],"kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"reingoldTilfordLayout()","type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"kind":"symbol","role":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","title":"RootedTree","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"url":"\/documentation\/trees\/rootedtree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","kind":"symbol"},"doc://Trees/documentation/Trees/Arborescence":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"role":"symbol","title":"Arborescence","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text