tract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent. As a ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(of:_:)":{"title":"lowestCommonAncestor(of:_:)","type":"topic","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","abstract":[{"type":"text","text":"The deepest vertex that is an ancestor of both "},{"type":"codeVoice","code":"a"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"type":"text","text":", a vertex counting as its own"},{"type":"text","text":" "},{"type":"text","text":"ancestor. This is "},{"type":"codeVoice","code":"a"},{"type":"text","text":" when "},{"type":"codeVoice","code":"a"},{"type":"text","text":" is above "},{"type":"codeVoice","code":"b"},{"type":"text","text":", and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" for "},{"type":"codeVoice","code":"(v, v)"},{"type":"text","text":". It depends on the root."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b)) with no allocation. For many queries, "},{"type":"codeVoice","code":"LowestCommonAncestors"},{"type":"text","text":" "},{"type":"text","text":"answers each in O(1)."}],"kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"title":"OrderedTree","type":"topic","url":"\/documentation\/trees\/orderedtree","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","role":"collection","url":"\/documentation\/grafluent","title":"Grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}]},"doc://Trees/documentation/Trees/Tree":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"navigatorTitle":[{"text":"Tree","kind":"identifier"}],"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"title":"Tree","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","url":"\/documentation\/trees\/tree"},"doc://Grafluent/documentation/Grafluent/Extensions":{"role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"title":"Extensions Across Modules","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","url":"\/documentation\/grafluent\/extensions"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","isActive":true},{"type":"text","text":"."}],"title":"Extensions to Tree","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","url":"\/documentation\/grafluent\/trees-tree-extensions"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"kind":"symbol","title":"reingoldTilfordLayout()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","role":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()"},"doc://Trees/documentation/Trees/RootedTree":{"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","type":"topic","url":"\/documentation\/trees\/rootedtree","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"title":"Extensions to Arborescence","type":"topic","url":"\/documentation\/grafluent\/trees-arborescence-extensions","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActiv