peIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"kind":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"kind":"symbol","url":"\/documentation\/trees\/rootedtree","abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"root"},{"text":", ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"depth(of:)"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"type":"codeVoice","code":"preorder"},{"text":".","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}],"navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"title":"OrderedTree","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","url":"\/documentation\/trees\/orderedtree"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerTour"},{"kind":"text","text":": "},{"preciseIdentifier":"s:5Walks4WalkV","kind":"typeIdentifier","text":"Walk"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text"