eVoice"},{"type":"text","text":"): "},{"code":"a","type":"codeVoice"},{"type":"text","text":" when "},{"code":"a","type":"codeVoice"},{"type":"text","text":" is above "},{"code":"b","type":"codeVoice"},{"type":"text","text":", and "},{"code":"v","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"code":"(v, v)","type":"codeVoice"},{"type":"text","text":". It depends on the root. O(depth(a) + depth(b)), allocating nothing; for many"},{"type":"text","text":" "},{"type":"text","text":"queries, "},{"code":"LowestCommonAncestors","type":"codeVoice"},{"type":"text","text":" answers each in O(1)."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"title":"lowestCommonAncestor(of:_:)","role":"symbol","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","kind":"symbol","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)"},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"title":"Tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"topic","kind":"symbol","url":"\/documentation\/trees\/tree"},"doc://Trees/documentation/Trees/RootedTree":{"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"title":"RootedTree","role":"symbol","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"topic","kind":"symbol","url":"\/documentation\/trees\/rootedtree"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"type":"text","text":"."}],"title":"Extensions to Arborescence","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","type":"topic","kind":"article","url":"\/documentation\/grafluent\/trees-arborescence-extensions"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"role":"symbol","url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence"},"doc://Grafluent/documentation/Grafluent/Extensions":{"url":"\/documentation\/grafluent\/extensions","title":"Extensions Across Modules","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","role":"collectionGroup","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"kind":"article","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerTour"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Walk","preciseIdentifier":"s:5Walks4WalkV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":