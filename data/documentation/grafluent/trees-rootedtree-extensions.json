bol","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"abstract":[{"type":"text","text":"The deepest vertex that is an ancestor of both "},{"type":"codeVoice","code":"a"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"type":"text","text":", a vertex counting as its own"},{"type":"text","text":" "},{"type":"text","text":"ancestor. This is "},{"type":"codeVoice","code":"a"},{"type":"text","text":" when "},{"type":"codeVoice","code":"a"},{"type":"text","text":" is above "},{"type":"codeVoice","code":"b"},{"type":"text","text":", and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" for "},{"type":"codeVoice","code":"(v, v)"},{"type":"text","text":". It depends on the root."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b)) with no allocation. For many queries, "},{"type":"codeVoice","code":"LowestCommonAncestors"},{"type":"text","text":" "},{"type":"text","text":"answers each in O(1)."}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","title":"Extensions Across Modules","role":"collectionGroup","url":"\/documentation\/grafluent\/extensions","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"type":"topic","title"