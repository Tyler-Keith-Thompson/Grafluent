\/trees\/rootedtree\/lowestcommonancestor(of:_:)","title":"lowestCommonAncestor(of:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","abstract":[{"text":"The deepest vertex that is an ancestor of both ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", a vertex counting as its own","type":"text"},{"text":" ","type":"text"},{"text":"ancestor. This is ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" when ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" is above ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"(v, v)"},{"text":". It depends on the root.","type":"text"},{"text":" ","type":"text"},{"text":"O(depth(a) + depth(b)) with no allocation. For many queries, ","type":"text"},{"type":"codeVoice","code":"LowestCommonAncestors"},{"text":" ","type":"text"},{"text":"answers each in O(1).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"kind":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordCircularLayout"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","kind":"symbol","title":"reingoldTilfordCircularLayout()","abstract":[{"type":"text","text":"The tidy drawing bent into a disc."}],"role":"symbol","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()"},"doc://Trees/documentation/Trees/Arborescence":{"role":"symbol","type":"topic","url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"role":"symbol","url":"\/documentation\/trees\/orderedtree"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"role":"symbol","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","title":"reingoldTilfordLayout()","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","type":"topic","url":"\/documentation\/trees\/rootedtree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"title":"RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"kind":"symbol"}}}