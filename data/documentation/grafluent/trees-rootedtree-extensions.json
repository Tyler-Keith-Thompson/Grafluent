tices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","url":"\/documentation\/trees\/rootedtree","role":"symbol","title":"RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"kind":"symbol"},"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","title":"Forest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}]},"doc://Trees/documentation/Trees/OrderedTree":{"url":"\/documentation\/trees\/orderedtree","kind":"symbol","type":"topic","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"role":"collectionGroup","title":"Extensions to Tree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","kind":"article","url":"\/documentation\/grafluent\/trees-tree-extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(ofIndex:_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"title":"lowestCommonAncestor(ofIndex:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(ofIndex:_:)","kind":"symbol","abstract":[{"text":"The deepest common ancestor of the vertices at indices ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", as an index.","type":"text"},{"text":" ",