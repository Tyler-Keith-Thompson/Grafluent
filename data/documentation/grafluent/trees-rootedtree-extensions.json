le"},"doc://Trees/documentation/Trees/OrderedTree":{"url":"\/documentation\/trees\/orderedtree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"title":"OrderedTree","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-OrderedTree-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-OrderedTree-Extensions","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/grafluent\/trees-orderedtree-extensions","title":"Extensions to OrderedTree","role":"collectionGroup"},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","role":"collection","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","title":"Grafluent","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"url":"\/documentation\/grafluent\/trees-forest-extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","type":"reference"},{"type":"text","text":"."}],"type":"topic","kind":"article","title":"Extensions to Forest"},"doc://Trees/documentation/Trees/RootedTree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","kind":"symbol","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/trees\/rootedtree","title":"RootedTree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"title":"reingoldTilfordCircularLayout()","abstract":[{"type":"text","text":"The tidy drawing bent into a disc."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordCircularLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree. The walk has 2n − 1 vertices and lists each edge"},{"type":"text","text":" "},{"type":"text","text":"position twice. The trivial walk for one vertex. O(n)."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerTour"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Walks4WalkV","text":"Walk"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":">"}],"title":"eulerTour","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","type":"topic","role":"symbol"},"doc://Trees/documentation/Trees/Arborescence":{"url":"\/documentation\/trees\/arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","title":"Arborescence","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}]}}}