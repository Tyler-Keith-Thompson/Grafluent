"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", a vertex counting as its own","type":"text"},{"text":" ","type":"text"},{"text":"ancestor. This is ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" when ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" is above ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"(v, v)"},{"text":". It depends on the root.","type":"text"},{"text":" ","type":"text"},{"text":"O(depth(a) + depth(b)) with no allocation. For many queries, ","type":"text"},{"type":"codeVoice","code":"LowestCommonAncestors"},{"text":" ","type":"text"},{"text":"answers each in O(1).","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","title":"reingoldTilfordLayout()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"role":"symbol","kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"title":"eulerTour","abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree. The walk has 2n − 1 vertices and lists each edge"},{"type":"text","text":" "},{"type":"text","text":"position twice. The trivial walk for one vertex. O(n)."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerTour","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Walks4WalkV","text":"Walk","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Trees/documentation/Trees/OrderedTree":{"kind":"symbol","type":"topic","role":"symbol","title":"OrderedTree","url":"\/documentation\/trees\/orderedtree","navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}]},"doc://Grafluent/documentation/Grafluent/Extensions":{"kind":"article","url":"\/documentation\/grafluent\/extensions","title":"Extensions Across Modules","type":"topic","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"type":"topic","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","abstract":[{"text":"The tidy drawing bent into a disc.","type":"text"}],"title":"reingoldTilfordCircularLayout()","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordCircularLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"role":"symbol","kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(ofIndex:_:)":{"title":"lowestCommonAncestor(ofIndex:_:)","abstract":[{"type":"text","text":"The deepest common ancestor of the vertices at indices "},{"type":"codeVoice","code":"a"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"