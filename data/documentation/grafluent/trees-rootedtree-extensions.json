on order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"role":"collectionGroup","type":"topic","title":"Extensions to Arborescence","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","url":"\/documentation\/grafluent\/trees-arborescence-extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","role":"symbol","title":"eulerTour","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerTour","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Walk","kind":"typeIdentifier","preciseIdentifier":"s:5Walks4WalkV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX"},{"type":"text","text":" "},{"code":"dfs_labeled_edges","type":"codeVoice"},{"type":"text","text":", forward then reverse). The trivial walk for one vertex. O(n)."}],"type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(ofIndex:_:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(ofIndex:_:)","type":"topic","title":"lowestCommonAncestor(ofIndex:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ofIndex","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"abstract":[{"text":"The deepest common ancestor of the vertices at indices ","type":"text"},{"type":"codeVoice","code":"a"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"b"},{"text":", as an index.","type":"text"},{"text":" ","type":"text"},{"text":"O(depth(a) + depth(b)).","type":"text"}],"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(ofindex:_:)"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","type":"topic","title":"Extensions to Forest","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/trees-forest-extensions"},"doc://Grafluent/documentation/Grafluent/Extensions":{"role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","type":"topic","title":"Extensions Across Modules","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"url":"\/documentation\/grafluent\/extensions"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(of:_:)":{"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","role":"symbol","title":"lowestCommonAncestor(of:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"kind":"symbol","abstract":[{"text":"The deepest vertex that is an ancestor of both ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", a vertex counting as its own","type":"text"},{"text":" ","type":"text"},{"text":"ancestor here (NetworkX ","type":"text"},{"code":"lowest_common_ancestor","type":"codeVoice"},{"text":"): ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" when ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" is above ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"code":"(v, v)","type":"codeVoice"},{"text":". It depends on the root. O(depth(a) + depth(b)), allocating nothing; for many","type":"text"},{"text":" ","type":"text"},{"text":"queries, ","type":"text"},{"code":"LowestCommonAncestors","type":"codeVoice"},{"text":" answers each in O(1).","type":"text"}],"type":"topic"},"doc://Trees/documentation/Trees/Tree":{"role":"symbol","kind":"symbol","title":"Tree","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"url":"\/documentation\/trees\/tree","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"navigatorTitle":[{"text":"Tree","kind":"identifier"}]},"doc://Trees/documentation/Trees/Arborescence":{"role":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"url":"\/documentation\/trees\/arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"role":"collectionGroup","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","title":"Extensions to Tree","kind":"article","url":"\/documentation\/grafluent\/trees-tree-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"type":"text","text":"."}]},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","type":"topic","title":"reingoldTilfordLayout()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()","role":"symbol","title":"reingoldTilfordCircularLayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordCircularLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"The tidy drawing bent into a disc (igraph’s "},{"code":"layout_reingold_tilford_circular","type":"codeVoice"},{"type":"text","text":"): a vertex"},{"type":"text","text":" "},{"type":"text","text":"at (x, d) in "},{"code":"reingoldTilfordLayout()","type":"codeVoice"},{"type":"text","text":" goes to d · (cos φ, sin φ), with"},{"type":"text","text":" "},{"type":"text","text":"φ = 2π · (n − 1)\/n · (x − x₀)\/(x₁ − x₀) for the least and greatest x, x₀ and x₁ (no division"},{"type":"text","text":" "},{"type":"text","text":"when they are equal). The root is at the origin, and each depth on the circle of that"},{"type":"text","text":" "},{"type":"text","text":"radius."}],"type":"topic"}}}