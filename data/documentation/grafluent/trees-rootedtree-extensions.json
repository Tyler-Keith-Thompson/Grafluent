dex:_:)","abstract":[{"type":"text","text":"The deepest common ancestor of the vertices at indices "},{"code":"a","type":"codeVoice"},{"type":"text","text":" and "},{"code":"b","type":"codeVoice"},{"type":"text","text":", as an index."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b))."}],"role":"symbol","title":"lowestCommonAncestor(ofIndex:_:)"},"doc://Trees/documentation/Trees/Forest":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"type":"topic","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"code":"trees","type":"codeVoice"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":" says which one a vertex is in."}],"url":"\/documentation\/trees\/forest","title":"Forest"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/grafluent\/trees-arborescence-extensions","title":"Extensions to Arborescence"},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code"