fluent\/trees-tree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","role":"collectionGroup"},"doc://Grafluent/documentation/Grafluent/Extensions":{"kind":"article","title":"Extensions Across Modules","role":"collectionGroup","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"url":"\/documentation\/grafluent\/extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX"},{"type":"text","text":" "},{"code":"dfs_labeled_edges","type":"codeVoice"},{"type":"text","text":", forward then reverse). The trivial walk for one vertex. O(n)."}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerTour","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Walks4WalkV","text":"Walk","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"eulerTour","type":"topic","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","role":"symbol"},"doc://Trees/documentation/Trees/Tree":{"type":"topic","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","role":"symbol","title":"Tree","kind":"symbol","url":"\/documentation\/trees\/tree"},"doc://Trees/documentation/Trees/RootedTree":{"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"type":"topic","url":"\/documentation\/trees\/rootedtree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","role":"symbol"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordCircularLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"The tidy drawing bent into a disc (igraph’s "},{"code":"layout_reingold_tilford_circular","type":"codeVoice"},{"type":"text","text":"): a vertex"},{"type":"text","text":" "},{"type":"text","text":"at (x, d) in "},{"code":"reingoldTilfordLayout()","type":"codeVoice"},{"type":"text","text":" goes to d · (cos φ, sin φ), with"},{"type":"text","text":" "},{"type":"text","text":"φ = 2π · (n − 1)\/n · (x − x₀)\/(x₁ − x₀) for the least and greatest x, x₀ and x₁ (no division"},{"type":"text","text":" "},{"type":"text","text":"when they are equal). The root is at the origin, and each depth on the circle of that"},{"type":"text","text":" "},{"type":"text","text":"radius."}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()","title":"reingoldTilfordCircularLayout()"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"role":"collection","url":"\/documentation\/grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","title":"Grafluent"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","kind":"arti