","type":"codeVoice"},{"type":"text","text":" and "},{"code":"b","type":"codeVoice"},{"type":"text","text":", a vertex counting as its own"},{"type":"text","text":" "},{"type":"text","text":"ancestor here (NetworkX "},{"code":"lowest_common_ancestor","type":"codeVoice"},{"type":"text","text":"): "},{"code":"a","type":"codeVoice"},{"type":"text","text":" when "},{"code":"a","type":"codeVoice"},{"type":"text","text":" is above "},{"code":"b","type":"codeVoice"},{"type":"text","text":", and "},{"code":"v","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"code":"(v, v)","type":"codeVoice"},{"type":"text","text":". It depends on the root. O(depth(a) + depth(b)), allocating nothing; for many"},{"type":"text","text":" "},{"type":"text","text":"queries, "},{"code":"LowestCommonAncestors","type":"codeVoice"},{"type":"text","text":" answers each in O(1)."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","title":"lowestCommonAncestor(of:_:)","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","type":"topic","title":"eulerTour","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX"},{"type":"text","text":" "},{"code":"dfs_labeled_edges","type":"codeVoice"},{"type":"text","text":", forward then reverse). The trivial walk for one vertex. O(n)."}],"fragments":[{"kind":"keyword","text":"var"},{"kind"