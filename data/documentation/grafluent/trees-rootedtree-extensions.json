e":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"root","type":"codeVoice"},{"text":", ","type":"text"},{"code":"parent(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"depth(of:)","type":"codeVoice"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"code":"preorder","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"role":"symbol","title":"RootedTree","type":"topic","url":"\/documentation\/trees\/rootedtree"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","kind":"symbol","url":"\/documentation\/trees\/arborescence","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/Tree":{"url":"\/documentation\/trees\/tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"role":"symbol","title":"Tree","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(checked:_:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lowestCommonAncestor"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"VertexNotFound","preciseIdentifier":"s:14GraphProtocols14VertexNotFoundV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Vertex"}],"type":"topic","title":"lowestCommonAncestor(checked:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(checked:_:)","abstract":[{"code":"lowestCommonAncestor(of: a, b)","type":"codeVoice"},{"text":", throwing instead of trapping when either is not a vertex","type":"text"},{"text":" ","type":"text"},{"text":"(README Principle 6). O(depth(a) + depth(b)).","type":"text"}],"role":"symbol","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(checked:_:)"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordCircularLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Drawing","kind":"typeIdentifier","preciseIdentifier":"s:12GraphDrawing0B0V"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The tidy drawing bent into a disc (igraph’s "},{"code":"layout_reingold_tilford_circular","type":"codeVoice"},{"type":"text","text":"): a vertex"},{"type":"text","text":" "},{"type":"text","text":"at (x, d) in "},{"code":"reingoldTilfordLayout()","type":"codeVoice"},{"type":"text","text":" goes to d · (cos φ, sin φ), with"},{"type":"text","text":" "},{"type":"text","text":"φ = 2π · (n − 1)\/n · (x − x₀)\/(x₁ − x₀) for the least and greatest x, x₀ and x₁ (no division"},{"type":"text","text":" "},{"type":"text","text":"when they are equal). The root is at the origin, and each depth on the circle of that"},{"type":"text","text":" "},{"type":"text","text":"radius."}],"kind":"symbol","role":"symbol","title":"reingoldTilfordCircularLayout()","type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()"}}}