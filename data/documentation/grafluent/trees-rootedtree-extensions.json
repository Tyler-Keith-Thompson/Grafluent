fier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","title":"Extensions Across Modules","kind":"article","type":"topic","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"url":"\/documentation\/grafluent\/extensions"},"doc://Trees/documentation/Trees/Forest":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"role":"symbol","url":"\/documentation\/trees\/forest","kind":"symbol","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"navigatorTitle":[{"text":"Forest","kind":"identifier"}],"title":"Forest"},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"url":"\/documentation\/trees\/tree","kind":"symbol","role":"symbol","title":"Tree"},"doc://Grafluent/documentation/Grafluent":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"url":"\/documentation\/grafluent","kind":"symbol","role":"collection","title":"Grafluent"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"title":"reingoldTilfordLayout()","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordLayout"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:12GraphDrawing0B0V","kind":"typeIdentifier","text":"Drawing"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","role":"symbol","abstract":[{"type":"text","text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker"},{"type":"text","text":" "},{"type":"text","text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form."}]},"doc://Trees/documentation/Trees/OrderedTree":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree","kind":"symbol","type":"topic","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"url":"\/documentation\/trees\/orderedtree"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(of:_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","kind":"symbol","abstract":[{"type":"text","text":"The deepest vertex that is an ancestor of both "},{"type":"codeVoice","code":"a"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"type":"text","text":", a vertex counting as its own"},{"type":"text","text":" "},{"type":"text","text":"ancestor. This is "},{"type":"codeVoice","code":"a"},{"type":"text","text":" when "},{"type":"codeVoice","code":"a"},{"type":"text","text":" is above "},{"type":"codeVoice","code":"b"},{"type":"text","text":", and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" for "},{"type":"codeVoice","code":"(v, v)"},{"type":"text","text":". It depends on the root."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b)) with no allocation. For many queries, "},{"type":"codeVoice","code":"LowestCommonAncestors"},{"type":"text","text":" "},{"type":"text","text":"answers each in O(1)."}],"type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","title":"lowestCommonAncestor(of:_:)"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"title":"reingoldTilfordCircularLayout()","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyw