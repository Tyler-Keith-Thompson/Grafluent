workX ","type":"text"},{"code":"is_arborescence","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Edmonds). A ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":": ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"url":"\/documentation\/trees\/arborescence","kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerTour","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Walks4WalkV","text":"Walk","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","abstract":[{"text":"The closed walk from the root that goes down each child edge, in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order,","type":"text"},{"text":" ","type":"text"},{"text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"dfs_labeled_edges","type":"codeVoice"},{"text":", forward then reverse). The trivial walk for