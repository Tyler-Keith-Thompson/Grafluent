":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"role":"symbol","type":"topic","title":"eulerTour","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","abstract":[{"type":"text","text":"The closed walk from the root that goes down each child edge, in "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" order,"},{"type":"text","text":" "},{"type":"text","text":"and back up it after that subtree. The walk has 2n − 1 vertices and lists each edge"},{"type":"text","text":" "},{"type":"text","text":"position twice. The trivial walk for one vertex. O(n)."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"eulerTour"},{"kind":"text","text":": "},{"preciseIdentifier":"s:5Walks4WalkV","kind":"typeIdentifier","text":"Walk"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">"}],"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"kind":"article","title":"Extensions to Forest","type":"topic","url":"\/documentation\/grafluent\/trees-forest-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"role":"symbol","type":"topic","title":"reingoldTilfordLayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12GraphDrawing0B0V","text":"Drawing","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"url":"\/documentation\/grafluent\/trees-tree-extensions","type":"topic","title":"Extensions to Tree","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"role":"collectionGroup"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/lowestCommonAncestor(of:_:)":{"role":"symbol","type":"topic","title":"lowestCommonAncestor(of:_:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/lowestCommonAncestor(of:_:)","kind":"symbol","abstract":[{"text":"The deepest vertex that is an ancestor of both ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", a vertex counting as its own","type":"text"},{"text":" ","type":"text"},{"text":"ancestor. This is ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" when ","type":"text"},{"code":"a","type":"codeVoice"},{"text":" is above ","type":"text"},{"code":"b","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"(v, v)","type":"codeVoice"},{"text":". It depends on the root.","type":"text"},{"text":" ","type":"text"},{"text":"O(depth(a) + depth(b)) with no allocation. For many queries, ","type":"text"},{"code":"LowestCommonAncestors","type":"codeVoice"},{"text":" ","type":"text"},{"text":"answers each in O(1).","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)"},"doc://Trees/documentation/Trees/Tree":{"url":"\/documentation\/trees\/tree","type":"topic","title":"Tree","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}],"role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}]},"doc://Trees/documentation/Trees/OrderedTree":{"role":"symbol","type":"topic","title":"OrderedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","kind":"symbol","abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}],"navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"url":"\/documentation\/trees\/orderedtree"}}}