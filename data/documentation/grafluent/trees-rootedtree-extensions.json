ce"},{"type":"text","text":" and "},{"code":"b","type":"codeVoice"},{"type":"text","text":", a vertex counting as its own"},{"type":"text","text":" "},{"type":"text","text":"ancestor. This is "},{"code":"a","type":"codeVoice"},{"type":"text","text":" when "},{"code":"a","type":"codeVoice"},{"type":"text","text":" is above "},{"code":"b","type":"codeVoice"},{"type":"text","text":", and "},{"code":"v","type":"codeVoice"},{"type":"text","text":" for "},{"code":"(v, v)","type":"codeVoice"},{"type":"text","text":". It depends on the root."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b)) with no allocation. For many queries, "},{"code":"LowestCommonAncestors","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"answers each in O(1)."}],"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordLayout()":{"url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordlayout()","abstract":[{"text":"The tidy drawing of the tree: Reingold and Tilford’s layered tree drawing as Walker","type":"text"},{"text":" ","type":"text"},{"text":"refined it, in Buchheim, Jünger and Leipert’s linear-time form.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordLayout()","role":"symbol","type":"topic","title":"reingoldTilfordLayout()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reingoldTilfordLayout","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]},"doc://Trees/documentation/Trees/Forest":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"ke