ting as its own"},{"type":"text","text":" "},{"type":"text","text":"ancestor. This is "},{"code":"a","type":"codeVoice"},{"type":"text","text":" when "},{"code":"a","type":"codeVoice"},{"type":"text","text":" is above "},{"code":"b","type":"codeVoice"},{"type":"text","text":", and "},{"code":"v","type":"codeVoice"},{"type":"text","text":" for "},{"code":"(v, v)","type":"codeVoice"},{"type":"text","text":". It depends on the root."},{"type":"text","text":" "},{"type":"text","text":"O(depth(a) + depth(b)) with no allocation. For many queries, "},{"code":"LowestCommonAncestors","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"answers each in O(1)."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lowestCommonAncestor","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"}],"url":"\/documentation\/treealgorithms\/trees\/rootedtree\/lowestcommonancestor(of:_:)","type":"topic","role":"symbol","title":"lowestCommonAncestor(of:_:)"},"doc://GraphDrawing/documentation/GraphDrawing/Trees/RootedTree/reingoldTilfordCircularLayout()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reingoldTilfordCircularLayout"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Drawing","preciseIdentifier":"s:12GraphDrawing0B0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","url":"\/documentation\/graphdrawing\/trees\/rootedtree\/reingoldtilfordcircularlayout()","identifier":"doc:\/\/GraphDrawing\/documentation\/GraphDrawing\/Trees\/RootedTree\/reingoldTilfordCircularLayout()","abstract":[{"type":"text","text":"The tidy drawing bent into