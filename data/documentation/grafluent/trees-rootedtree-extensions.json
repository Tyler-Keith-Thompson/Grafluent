":"text"}],"role":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/RootedTree/eulerTour":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/RootedTree\/eulerTour","url":"\/documentation\/treealgorithms\/trees\/rootedtree\/eulertour","abstract":[{"text":"The closed walk from the root that goes down each child edge, in ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" order,","type":"text"},{"text":" ","type":"text"},{"text":"and back up it after that subtree: 2n − 1 vertices, each edge position twice (NetworkX","type":"text"},{"text":" ","type":"text"},{"code":"dfs_labeled_edges","type":"codeVoice"},{"text":", forward then reverse). The trivial walk for one vertex. O(n).","type":"text"}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"eulerTour","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Walk","preciseIdentifier":"s:5Walks4WalkV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"eulerTour"}}}