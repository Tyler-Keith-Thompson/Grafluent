"}],"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"role":"symbol","kind":"symbol","title":"Tree"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/diameter()":{"url":"\/documentation\/treealgorithms\/trees\/tree\/diameter()","title":"diameter()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diameter","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"abstract":[{"text":"The greatest number of edges between two vertices; 0 for one vertex. O(n).","type":"text"}],"role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/diameter()","type":"topic"},"doc://NamedGraphs/documentation/NamedGraphs/Trees/Tree/binomialTree(order:)":{"role":"symbol","abstract":[{"text":"The binomial tree as a tree, numbered as ","type":"text"},{"type":"codeVoice","code":"binomialTree(order:)"},{"text":" on the representations,","type":"text"},{"text":" ","type":"text"},{"text":"with its edges in the same sorted order. Uses the dense layout with no vertex dictionary.","type":"text"},{"text":" ","type":"text"},{"text":"O(n).","type":"text"}],"identifier":"doc:\/\/NamedGraphs\/documentation\/NamedGraphs\/Trees\/Tree\/binomialTree(order:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind"