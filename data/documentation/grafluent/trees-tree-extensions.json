:" cannot be mutated."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"url":"\/documentation\/trees\/tree","kind":"symbol","role":"symbol","title":"Tree"},"doc://NamedGraphs/documentation/NamedGraphs/Trees/Tree/star(vertexCount:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"star","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Tree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees4TreeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","title":"star(vertexCount:)","role":"symbol","abstract":[{"type":"text","text":"The star on "},{"code":"0..<vertexCount","type":"codeVoice"},{"type":"text","text":" as a tree: hub 0, edge k is 0–(k + 1). O(n)."}],"url":"\/documentation\/namedgraphs\/trees\/tree\/star(vertexcount:)","identifier":"doc:\/\/NamedGraphs\/documentation\/NamedGraphs\/Trees\/Tree\/star(vertexCount:)"},"doc://RandomGraphs/documentation/RandomGraphs/Trees/Tree/random(vertexCount:using:)":{"title":"random(vertexCount:using:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"random"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Ra