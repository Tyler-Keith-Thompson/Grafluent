tices of least eccentricity, in ","type":"text"},{"type":"codeVoice","code":"vertices"},{"text":" order. There is one, or two adjacent","type":"text"},{"text":" ","type":"text"},{"text":"ones. O(n).","type":"text"}],"url":"\/documentation\/treealgorithms\/trees\/tree\/center()","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/center()","role":"symbol","title":"center()","type":"topic","kind":"symbol"},"doc://NamedGraphs/documentation/NamedGraphs/Trees/Tree/star(vertexCount:)":{"url":"\/documentation\/namedgraphs\/trees\/tree\/star(vertexcount:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"star","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Tree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees4TreeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"star(vertexCount:)","abstract":[{"type":"text","text":"The star on "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":" as a tree: hub 0, edge k is 0–(k + 1). O(n)."}],"kind":"symbol","identifier":"doc:\/\/NamedGraphs\/documentation\/NamedGraphs\/Trees\/Tree\/star(vertexCount:)","type":"topic","role":"symbol"},"doc://RandomGraphs/documentation/RandomGraphs/Trees/Tree/random(vertexCount:using:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"random"},{"kind":"text","text":"("},{"kind":"externalParam","text":"vertexCount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":