ary, as "},{"type":"codeVoice","code":"Tree.path(vertexCount:)"},{"type":"text","text":" is. O(n)."}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/diameterPath(weight:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"diameterPath"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> (path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:5Walks4PathV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">, distance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AdditiveArithmetic","preciseIdentifier":"s:s18AdditiveArithmeticP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"}],"kind":"symbol","abstract":[{"text":"A longest path by weighted distance, chosen as ","type":"text"},{"type":"codeVoice","code":"diameterPath()"},{"text":" chooses, and its weight","type":"text"},{"text":" ","type":"text"},{"text":"summed along the path (with floating point, it can differ from ","type":"text"},{"type":"codeVoice","code":"diameter(weight:)"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"last digit, the sums being taken in another order). O(n).","type":"text"}],"title":"diameterPath(weight:)","type":"topic","url":"\/docume