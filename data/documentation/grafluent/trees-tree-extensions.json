ifier","text":"center"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"externalParam","text":"weight"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"title":"center(weight:)","url":"\/documentation\/treealgorithms\/trees\/tree\/center(weight:)","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/center(weight:)","kind":"symbol","type":"topic","role":"symbol"},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","role":"collection","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","title":"Grafluent","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"kind":"symbol"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/diameter(weight:)":{"title":"diameter(weight:)","abstract":[{"text":"The greatest weighted distance between two vertices. O(n).","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/diameter(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diameter","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"}],"url":"\/documentation\/treealgorithms\/trees\/tree\/diameter(weight:)"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"url":"\/documentation\/grafluent\/trees-forest-extensions