","title":"Tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"url":"\/documentation\/trees\/tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","title":"Extensions Across Modules","role":"collectionGroup","url":"\/documentation\/grafluent\/extensions","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"doc://Trees/documentation/Trees/Forest":{"type":"topic","title":"Forest","role":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"url":"\/documentation\/trees\/forest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"type":"codeVoice","code":"trees"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":" says which one a vertex is in.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","kind":"symbol"},"doc://NamedGraphs/documentation/Name