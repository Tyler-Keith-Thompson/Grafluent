xCount","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Tree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees4TreeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"code":"random(vertexCount:using:)","type":"codeVoice"},{"text":" with the system’s random number generator.","type":"text"}]},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"title":"Extensions to Arborescence","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/trees-arborescence-extensions","type":"topic","role":"collectionGroup"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"type":"topic","role":"collectionGroup","title":"Extensions to RootedTree","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"reference"},{"text":".","type":"text"}],"kind":"article"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/centroid()":{"type":"topic","title":"centroid()","role":"symbol","url":"\/documentation\/treealgorithms\/trees\/tree\/centroid()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"centroid","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The vertices whose removal leaves no component of more than n\/2 vertices (Jordan’s","type":"text"},{"text":" ","type":"text"},{"text":"centroid), in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order. There is one, or two adjacent ones. Edge weights are","type":"text"},{"text":" ","type":"text"},{"text":"ignored. O(n).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/centroid()"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/centroidDecomposition()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/centroidDecomposition()","url":"\/documentation\/treealgorithms\/trees\/tree\/centroiddecomposition()","type":"topic","title":"centroidDecomposition()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"centroidDecomposition","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"RootedTree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees10RootedTreeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"The centroid decomposition: the rooted tree on the same vertices whose root is the"},{"type":"text","text":" "},{"type":"text","text":"centroid (the first in "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order when there are two), whose root’s children are"},{"type":"text","text":" "},{"type":"text","text":"the centroids, chosen the same way, of the components left when it is removed, and so on."},{"type":"text","text":" "},{"type":"text","text":"Its edges are not the tree’s: one (parent, child) per vertex but the root, in vertex"},{"type":"text","text":" "},{"type":"text","text":"order, so "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" is in vertex order. Height at most ⌊log₂ n⌋. O(n log n)."}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/diameter()":{"type":"topic","title":"diameter()","r