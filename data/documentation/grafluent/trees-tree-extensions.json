e":"collectionGroup","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/centroidDecomposition()":{"title":"centroidDecomposition()","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The centroid decomposition: the rooted tree on the same vertices whose root is the"},{"type":"text","text":" "},{"type":"text","text":"centroid (the first in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order when there are two), whose root’s children are"},{"type":"text","text":" "},{"type":"text","text":"the centroids, chosen the same way, of the components left when it is removed, and so on."},{"type":"text","text":" "},{"type":"text","text":"Its edges are not the tree’s: one (parent, child) per vertex but the root, in vertex"},{"type":"text","text":" "},{"type":"text","text":"order, so "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" is in vertex order. Height at most ⌊log₂ n⌋. O(n log n)."}],"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/centroidDecomposition()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"centroidDecomposition"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Trees10RootedTreeV","text":"RootedTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"url":"\/documentation\/treealgorithms\/trees\/tree\/centroiddecomposition()","type":"topic"},"doc://Trees/documentation/Trees/Forest":{"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"kind":"symbol","title":"Forest","url":"\/documentation\/trees\/forest","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}]},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"kind":"symbol","title":"Tree","url":"\/documentation\/trees\/tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}]},"doc://Trees/documentation/Trees/RootedTree":{"abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"kind":"symbol","title":"RootedTree","url":"\/documentation\/trees\/rootedtree","role":"symbol","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}]}}}