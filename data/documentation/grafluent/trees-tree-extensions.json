ifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Tree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees4TreeV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","kind":"symbol","abstract":[{"text":"The balanced tree as a tree: edge k joins vertex k + 1 to its parent k\/r, numbered as","type":"text"},{"text":" ","type":"text"},{"code":"balancedTree(branchingFactor:height:)","type":"codeVoice"},{"text":" on the representations. Uses the dense layout with","type":"text"},{"text":" ","type":"text"},{"text":"no vertex dictionary. O(n).","type":"text"}],"identifier":"doc:\/\/NamedGraphs\/documentation\/NamedGraphs\/Trees\/Tree\/balancedTree(branchingFactor:height:)","url":"\/documentation\/namedgraphs\/trees\/tree\/balancedtree(branchingfactor:height:)","title":"balancedTree(branchingFactor:height:)"},"doc://RandomGraphs/documentation/RandomGraphs/Trees/Tree/random(vertexCount:using:)":{"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"random","kind":"identifier"},{"text":"(","kind":"text"},{"text":"vertexCount","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SG","text":"RandomNumberGenerator","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:5Trees4TreeV","text":"Tree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"A uniformly random labeled tree on "},{"type":"codeVoice","code":"0..<vertexCount"},{"type":"text","text":": a Prüfe