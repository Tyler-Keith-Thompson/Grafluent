text"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"url":"\/documentation\/trees\/tree","navigatorTitle":[{"kind":"identifier","text":"Tree"}]},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","role":"symbol","kind":"symbol","abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent (NetworkX ","type":"text"},{"code":"is_arborescence","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Edmonds). A ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":": ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/centroidDecomposition()":{"abstract":[{"text":"The centroid decomposition: the rooted tree on the same vertices whose root is the","type":"text"},{"text":" ","type":"text"},{"text":"centroid (the first in ","type":"text"},{"code":"vertices","type":"codeVoice"},{"text":" order when there are two), whose root’s children are","type":"text"},{"text":" ","type":"text"},{"text":"the centroids, chosen the same way, of the components left when it is removed, and so on.","type":"te