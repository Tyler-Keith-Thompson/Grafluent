text":")"}],"abstract":[{"type":"text","text":"A longest path by weighted distance, chosen as "},{"type":"codeVoice","code":"diameterPath()"},{"type":"text","text":" chooses, and its weight"},{"type":"text","text":" "},{"type":"text","text":"summed along the path. With floating-point weights the sum can differ from"},{"type":"text","text":" "},{"type":"codeVoice","code":"diameter(weight:)"},{"type":"text","text":" in the last digit because it adds in a different order. O(n)."}],"role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/diameterPath(weight:)","type":"topic"},"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"Forest"},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"url":"\/documentation\/grafluent\/trees-forest-extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","type":"topic","role":"collectionGroup","kind":"article","title":"Extensions to Forest"},"doc://NamedGraphs/documentation/NamedGraphs/Trees/Tree/path(vertexCount