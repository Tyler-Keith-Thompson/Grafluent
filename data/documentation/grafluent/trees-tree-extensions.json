ch vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","type":"text"},{"text":" ","type":"text"},{"text":"have the same root and every vertex has the same children in the same order, which is the","type":"text"},{"text":" ","type":"text"},{"text":"identity being an ordered-tree isomorphism between them.","type":"text"}],"url":"\/documentation\/trees\/orderedtree","role":"symbol","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","kind":"symbol","title":"OrderedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/Tree/diameterPath(weight:)":{"type":"topic","title":"diameterPath(weight:)","role":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/Tree\/diameterPath(weight:)","url":"\/documentation\/treealgorithms\/trees\/tree\/diameterpath(weight:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diameterPath","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"weight","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":") -> (path","kind":"text"},{"text":": ","kind":"text"},{"text":"Path","kind":"typeIdentifier","preciseIdentifier":"s:5Walks4PathV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, distance","kind":"text"},{"text":": ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","abstract":[{"