":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"kind":"symbol","title":"DirectedHypergraph","url":"\/documentation\/graphprotocols\/directedhypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UndirectedIncidenceList","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","type":"topic","abstract":[{"text":"The dual hypergraph (Berge’s H*, XGI’s and HyperNetX’s ","type":"text"},{"code":"dual()","type":"codeVoice"},{"text":"), the transpose of the","type":"text"},{"text":" ","type":"text"},{"text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge an isolated vertex, so the dual is always defined; ","type":"text"},{"code":"dual().dual()","type":"codeVoice"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph with its vertices relabeled to their indices and its positions kept.","type":"text"}],"kind":"symbol","title":"dual()","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","abstract":[{"text":"The connected components: two vertices are together when a chain of hyperedges joins them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are ordered by their least vertex index and list their vertices in index order;","type":"text"},{"text":" ","type":"text"},{"text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no","type":"text"},{"text":" ","type":"text"},{"text":"components.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/connectedcomponents()","role":"symbol","title":"connectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]]"}]}}}