ype":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/neighbors(of:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The vertices that share a hyperedge with "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":", each once, in vertex-index order, never"},{"type":"text","text":" "},{"code":"vertex","type":"codeVoice"},{"type":"text","text":" itself (XGI’s "},{"code":"nodes.neighbors","type":"codeVoice"},{"type":"text","text":")."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"neighbors"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"title":"neighbors(of:)","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/neighbors(of:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/neighbors(of:)"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","kind":"article","role":"collectionGroup","title":"Extensions to Graph","abstract":[{"type":"text","text":"Members other modules add to "},{"