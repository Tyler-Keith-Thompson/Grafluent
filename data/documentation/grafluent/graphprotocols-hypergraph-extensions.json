xt","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","role":"symbol","type":"topic","kind":"symbol","title":"dual()"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"kind":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","title":"DirectedGraph","url":"\/documentation\/graphprotocols\/directedgraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/sConnectedComponents(s:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)","role":"symbol","title":"sConnectedComponents(s:)","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020; HyperNetX’s "},{"type":"codeVoice","code":"s_connected_components"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges=True"},{"type":"text","text":"): the connected components of "},{"type":"codeVoice","code":"lineGraph(s:)"},{"type":"text","text":", as positions, without building"},{"type":"text","text":" "},{"type":"text","text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"role":"collectionGroup","kind":"article","type":"topic","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"reference"},{"type":"text","text":"."}],"title":"Extensions to Graph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"text":"The clique expansion (XGI’s ","type":"text"},{"type":"codeVoice","code":"to_graph"},{"text":", Berge’s 2-section): every vertex, isolated ones","type":"text"},{"text":" ","type":"text"},{"text":"included, in vertex-index order, and an edge between every two vertices that share a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower.","type":"text"},{"text":" ","type":"text"},{"text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members","type":"text"},{"text":" ","type":"text"},{"text":"is k(k − 1)\/2 edges.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","role":"symbol","type":"topic","kind":"symbol","title":"cliqueExpansion()"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","type":"topic","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","title":"Extensions to BidirectionalDirectedGraph","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"reference"},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-mutabledirectedgraph-extensions","title":"Extensions to MutableDirectedGraph","role":"collectionGroup","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]]"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/connectedcomponents()","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The connected components: two vertices are together when a chain of hyperedges joins them."},{"type":"text","text":" "},{"type":"text","text":"Components are ordered by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"title":"connectedComponents()"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"title":"DirectedHypergraph"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"title":"Hypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/degreeHistogram()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/degreeHistogram()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices of degree "},{"type":"codeVoice","code":"d"},{"type":"text","text":", up to the greatest degree; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"vertices (NetworkX’s "},{"type":"codeVoice","code":"degree_histogram"},{"type":"text","text":" shape). O(n)."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/degreehistogram()","role":"symbol","type":"topic","kind":"symbol","title":"degreeHistogram()"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"type":"topic","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"title":"BidirectionalDirectedGraph"}}}