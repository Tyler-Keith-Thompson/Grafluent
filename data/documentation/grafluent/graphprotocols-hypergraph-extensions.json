xtensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","title":"Extensions to Graph","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","isActive":true},{"type":"text","text":"."}],"kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/degreeHistogram()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"degreeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/degreeHistogram()","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices of degree "},{"type":"codeVoice","code":"d"},{"type":"text","text":", up to the greatest degree; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"vertices (NetworkX’s "},{"type":"codeVoice","code":"degree_histogram"},{"type":"text","text":" shape). O(n)."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/degreehistogram()","title":"degreeHistogram()"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"kind":"text","text":">"}],"url":"\/documentation\/graphprotocols\/hypergraph","role":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","title":"Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"kind":"symbol","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/sConnectedComponents(s:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":"]]"}],"kind":"symbol","title":"sConnectedComponents(s:)","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020; HyperNetX’s "},{"code":"s_connected_components","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":"edges=True","type":"codeVoice"},{"type":"text","text":"): the connected components of "},{"code":"lineGraph(s:)","type":"codeVoice"},{"type":"text","text":", as positions, without building"},{"type":"text","text":" "},{"type":"text","text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"code":"dual().sConnectedComponents(s:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)","role":"symbol"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","title":"Grafluent","role":"collection","type":"topic","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"url":"\/documentation\/grafluent"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","title":"BidirectionalDirectedGraph","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols08DirectedA0P6VertexQa"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","text":"DirectedGraph","preciseIdentifier":"s:14GraphProtocols08DirectedA0P"}],"type":"topic","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The clique expansion (XGI’s "},{"type":"codeVoice","code":"to_graph"},{"type":"text","text":", Berge’s 2-section): every vertex, isolated ones"},{"type":"text","text":" "},{"type":"text","text":"included, in vertex-index order, and an edge between every two vertices that share a"},{"type":"text","text":" "},{"type":"text","text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower."},{"type":"text","text":" "},{"type":"text","text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members"},{"type":"text","text":" "},{"type":"text","text":"is k(k − 1)\/2 edges."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","title":"cliqueExpansion()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"kind":"text","text":"]]"}],"kind":"symbol","abstract":[{"text":"The connected components: two vertices are together when a chain of hyperedges joins them.","type":"text"},{"text":" ","type":"text"},{"text":"Components are ordered by their least vertex index and list their vertices in index order;","type":"text"},{"text":" ","type":"text"},{"text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no","type":"text"},{"text":" ","type":"text"},{"text":"components.","type":"text"}],"title":"connectedComponents()","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/connectedcomponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","kind":"symbol","title":"DirectedHypergraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an","type":"text"},{"text":" ","type":"text"},{"text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino","type":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}]},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}],"url":"\/documentation\/graphprotocols\/directedhypergraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","type":"topic","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","type":"reference","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","title":"Extensions to DirectedHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/lineGraph(s:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/lineGraph(s:)","type":"topic","role":"symbol","abstract":[{"text":"The s-line graph (Aksoy et al. 2020; XGI’s ","type":"text"},{"code":"to_line_graph(H, s)","type":"codeVoice"},{"text":", HyperNetX’s","type":"text"},{"text":" ","type":"text"},{"code":"get_linegraph","type":"codeVoice"},{"text":"): every position ","type":"text"},{"code":"0..<m","type":"codeVoice"},{"text":" as a vertex, in order, and an edge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":"–","type":"text"},{"code":"q","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"p < q","type":"codeVoice"},{"text":") when the two hyperedges share at least ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" members. An empty hyperedge, or one","type":"text"},{"text":" ","type":"text"},{"text":"sharing fewer than ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" members with every other, is isolated. Edges ascend by ","type":"text"},{"code":"(p, q)","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/linegraph(s:)","title":"lineGraph(s:)"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","title":"Extensions to BidirectionalDirectedGraph","role":"collectionGroup","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"UndirectedIncidenceList","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">"}],"kind":"symbol","title":"dual()","abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*, XGI’s and HyperNetX’s "},{"type":"codeVoice","code":"dual()"},{"type":"text","text":"), the transpose of the"},{"type":"text","text":" "},{"type":"text","text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","role":"symbol"}}}