text","text":", "},{"code":"remove_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_vertex","type":"codeVoice"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"MutableDirectedGraph","url":"\/documentation\/graphprotocols\/mutabledirectedgraph"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"type":"topic","abstract":[{"text":"A directed graph that also answers in-neighborhoods: Boost’s ","type":"text"},{"type":"codeVoice","code":"BidirectionalGraph"},{"text":". Kept apart","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","title":"BidirectionalDirectedGraph"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"identifier":"doc:\/\/Grafluent\/documentation\/Graflue