tocols\/hypergraph\/sconnectedcomponents(s:)","kind":"symbol","title":"sConnectedComponents(s:)","abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020; HyperNetX’s "},{"type":"codeVoice","code":"s_connected_components"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"edges=True"},{"type":"text","text":"): the connected components of "},{"type":"codeVoice","code":"lineGraph(s:)"},{"type":"text","text":", as positions, without building"},{"type":"text","text":" "},{"type":"text","text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]]","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/lineGraph(s:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/lineGraph(s:)","title":"lineGraph(s:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineGraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text