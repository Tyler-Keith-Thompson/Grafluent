ectionGroup","title":"Extensions to MutableGraph","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"kind":"symbol","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"role":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"type":"topic","title":"DirectedHypergraph"},"doc://Grafluent/documentation/Grafluent/Extensions":{"kind":"article","title":"Extensions Across Modules","role":"collectionGroup","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"url":"\/documentation\/grafluent\/extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/rank":{"abstract":[{"type":"text","text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m)."}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rank","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}],"title":"rank","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/rank","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/rank","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"text":"The clique expansion (XGI’s ","type":"text"},{"type":"codeVoice","code":"to_graph"},{"text":", Berge’s 2-section): every vertex, isolated ones","type":"text"},{"text":" ","type":"text"},{"text":"included, in vertex-index order, and an edge between every two vertices that share a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower.","type":"text"},{"text":" ","type":"text"},{"text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members","type":"text"},{"text":" ","type":"text"},{"text":"is k(k − 1)\/2 edges.","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","role":"symbol","title":"cliqueExpansion()","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isUniform(size:)":{"abstract":[{"type":"text","text":"Whether every hyperedge has exactly "},{"type":"codeVoice","code":"size"},{"type":"text","text":" members (Berge’s k-uniform). Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges count (XGI’s "},{"type":"codeVoice","code":"is_uniform"},{"type":"text","text":" ignores singletons); vacuously true with no"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. O(m)."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUniform","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isUniform(size:)","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","role":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","type":"reference","isActive":true},{"text":".","type":"text"}],"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","type":"topic","title":"Extensions to DirectedGraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/sConnectedComponents(s:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa","text":"Index"},{"kind":"text","text":"]]"}],"abstract":[{"type":"text","text":"The hyperedge s-components (Aksoy et al. 2020; HyperNetX’s "},{"code":"s_connected_components","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"code":"edges=True","type":"codeVoice"},{"type":"text","text":"): the connected components of "},{"code":"lineGraph(s:)","type":"codeVoice"},{"type":"text","text":", as positions, without building"},{"type":"text","text":" "},{"type":"text","text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"code":"dual().sConnectedComponents(s:)","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)","role":"symbol","kind":"symbol","title":"sConnectedComponents(s:)","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"abstract":[{"text":"The dual hypergraph (Berge’s H*, XGI’s and HyperNetX’s ","type":"text"},{"code":"dual()","type":"codeVoice"},{"text":"), the transpose of the","type":"text"},{"text":" ","type":"text"},{"text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge an isolated vertex, so the dual is always defined; ","type":"text"},{"code":"dual().dual()","type":"codeVoice"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph with its vertices relabeled to their indices and its positions kept.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"dual()","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","role":"symbol"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"role":"collection","url":"\/documentation\/grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","title":"Grafluent"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"kind":"article","title":"Extensions to MutableDirectedGraph"