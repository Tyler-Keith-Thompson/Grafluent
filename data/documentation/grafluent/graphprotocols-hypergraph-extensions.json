–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"title":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","role":"symbol","type":"topic","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"url":"\/documentation\/graphprotocols\/mutablegraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept, "},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":" and "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":"), with the"},{"type":"text","text":" "},{"type":"text","text":"members a reader needs to build a graph by key."}],"title":"MutableGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableGraph","kind":"identifier"}],"navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/neighbors(of:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/neighbors(of:)","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/neighbors(of:)","abstract":[{"text":"The vertices that share a hyperedge with ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":", each once, in vertex-index order, never","type":"text"},{"text":" ","type":"text"},{"code":"vertex","type":"codeVoice"},{"text":" itself (XGI’s ","type":"text"},{"code":"nodes.neighbors","type":"codeVoice"},{"text":").","type":"text"}],"title":"neighbors(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neighbors","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/incidenceGraph":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraph","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","text":"IncidenceGraphView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraph","abstract":[{"text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the","type":"text"},{"text":" ","type":"text"},{"text":"Levi graph), as a lazy ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":": vertex index ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" is vertex ","type":"text"},{"code":"i","type":"codeVoice"},{"text":", ","type":"text"},{"code":"n + p","type":"codeVoice"},{"text":" is hyperedge ","type":"text"},{"code":"p","ty