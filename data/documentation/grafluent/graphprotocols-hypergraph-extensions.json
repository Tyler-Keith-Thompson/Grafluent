"text":" "},{"type":"text","text":"hyperedges. O(m)."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)","title":"isUniform(size:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isUniform","kind":"identifier"},{"text":"(","kind":"text"},{"text":"size","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","title":"dual()","abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*, XGI’s and HyperNetX’s "},{"type":"codeVoice","code":"dual()"},{"type":"text","text":"), the transpose of the"},{"type":"text","text":" "},{"type":"text","text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}],"navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"text","text":" (Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept, "},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":" and "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":"), with the"},{"type":"text","text":" "},{"type":"text","text":"members a reader needs to build a graph by key."}],"title":"MutableGraph","kind":"symbol","url":"\/documentation\/graphprotocols\/mutablegraph","type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/hyperedgeSizeHistogram()":{"abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"k"},{"type":"text","text":" counts the hyperedges of size "},{"type":"codeVoice","code":"k"},{"type":"text","text":", up to the rank; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no hyperedges."},{"type":"text","text":" "},{"type":"text","text":"O(m)."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/hyperedgesizehistogram()","title":"hyperedgeSizeHistogram()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedgeSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/hyperedgeSizeHistogram()","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","title":"Hypergraph","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"kind":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/connectedComponents()","title":"connectedComponents()","abstract":[{"type":"text","text":"The connected components: two vertices are together when a chain of hyperedges joins them."},{"type":"text","text":" "},{"type":"text","text":"Components are ordered by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/connectedcomponents()","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]]"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/incidenceGraph":{"abstract":[{"type":"text","text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the"},{"type":"text","text":" "},{"type":"text","text":"Levi graph), as a lazy "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":": vertex index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"each incidence is an edge, XGI’s "},{"type":"codeVoice","code":"to_bipartite_graph"},{"type":"text","text":" numbering. Graph algorithms reach a"},{"type":"text","text":" "},{"type":"text","text":"hypergraph through it."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraph","title":"incidenceGraph","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraph"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","kind":"typeIdentifier","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/incidenceGraph","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directed"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","title":"Graph","navigatorTitle":[{"text":"Graph","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","isActive":true},{"type":"text","text":"."}],"kind":"article","type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions","title":"Extensions to MutableGraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","title":"cliqueExpansion()","abstract":[{"type":"text","text":"The clique expansion (XGI’s "},{"type":"codeVoice","code":"to_graph"},{"type":"text","text":", Berge’s 2-section): every vertex, isolated ones"},{"type":"text","text":" "},{"type":"text","text":"included, in vertex-index order, and an edge between every two vertices that share a"},{"type":"text","text":" "},{"type":"text","text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower."},{"type":"text","text":" "},{"type":"text","text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members"},{"type":"text","text":" "},{"type":"text","text":"is k(k − 1)\/2 edges."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedAdjacencyList","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","isActive":true,