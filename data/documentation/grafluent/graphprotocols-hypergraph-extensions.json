rgraphs"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidenceGraph"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/degreeHistogram()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/degreeHistogram()","abstract":[{"type":"text","text":"Element "},{"code":"d","type":"codeVoice"},{"type":"text","text":" counts the vertices of degree "},{"code":"d","type":"codeVoice"},{"type":"text","text":", up to the greatest degree; "},{"code":"[]","type":"codeVoice"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"vertices (NetworkX’s "},{"code":"degree_histogram","type":"codeVoice"},{"type":"text","text":" shape). O(n)."}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/degreehistogram()","role":"symbol","title":"degreeHistogram()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true},{"text":".","type":"text"}],"role":"collectionGroup","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","title":"Extensions to DirectedGraph"},"doc://Hypergraphs/documentation/Hypergraphs