d","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isConnected","role":"symbol","kind":"symbol","type":"topic"},"doc://Grafluent/documentation/Grafluent/Extensions":{"url":"\/documentation\/grafluent\/extensions","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"title":"Extensions Across Modules","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","role":"collectionGroup","kind":"article","type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directed","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","kind":"symbol","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isUniform(size:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","abstract":[{"type":"text","text":"Whether every hyperedge has exactly "},{"type":"codeVoice","code":"size"},{"type":"text","text":" members (Berge’s k-uniform). Singletons and"},{"type":"text","text":" "},{"type":"text","t