ery other, is isolated. Edges ascend by ","type":"text"},{"type":"codeVoice","code":"(p, q)"},{"text":".","type":"text"}],"title":"lineGraph(s:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}],"role":"symbol","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"type":"text","text":"."}],"title":"Extensions to BidirectionalDirectedGraph","role":"collectionGroup","kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/rank":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"rank"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/rank","abstract":[{"type":"text","text":"The greatest hyperedge size (Berge’