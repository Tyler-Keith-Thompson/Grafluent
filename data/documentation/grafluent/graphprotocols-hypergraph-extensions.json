s\/GraphProtocols\/Hypergraph\/incidenceGraph","abstract":[{"type":"text","text":"The hypergraph’s incidence graph, Berge’s bipartite graph of vertices and hyperedges (the"},{"type":"text","text":" "},{"type":"text","text":"Levi graph), as a lazy "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":": vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" is vertex "},{"code":"i","type":"codeVoice"},{"type":"text","text":", "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"each incidence is an edge, XGI’s "},{"code":"to_bipartite_graph","type":"codeVoice"},{"type":"text","text":" numbering. Graph algorithms reach a"},{"type":"text","text":" "},{"type":"text","text":"hypergraph through it."}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/incidencegraph","role":"symbol","title":"incidenceGraph","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"incidenceGraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs18IncidenceGraphViewV","text":"IncidenceGraphView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"> { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isUniform(size:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUniform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)","identifier":"d