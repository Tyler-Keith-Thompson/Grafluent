text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"title":"Hypergraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","role":"collectionGroup","title":"Extensions to DirectedHypergraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","kind":"article"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"type":"topic","role":"symbol","url":"\/documentation\/graphproto