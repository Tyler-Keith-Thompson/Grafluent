:", as positions, without building"},{"type":"text","text":" "},{"type":"text","text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own"},{"type":"text","text":" "},{"type":"text","text":"component, and components are ordered by their least position, each ascending. The vertex"},{"type":"text","text":" "},{"type":"text","text":"s-components are "},{"type":"codeVoice","code":"dual().sConnectedComponents(s:)"},{"type":"text","text":"."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/degreeHistogram()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/degreehistogram()","kind":"symbol","title":"degreeHistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/degreeHistogram()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","abstract":[{"text":"Element ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" counts the vertices of degree ","type":"text"},{"code":"d","type":"codeVoice"},{"text":", up to the greatest degree; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no","type":"text"},{"text":" ","type":"text"},{"text":"vertices (NetworkX’s ","type":"text"},{"code":"degree_histogram","type":"codeVoice"},{"text":" shape). O(n).","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedGraph"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedgraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedGraph"}],"type":"topic","title":"DirectedGra