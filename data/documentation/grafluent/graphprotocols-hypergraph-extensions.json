ered by their least vertex index and list their vertices in index order;","type":"text"},{"text":" ","type":"text"},{"text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no","type":"text"},{"text":" ","type":"text"},{"text":"components.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]]","kind":"text"}]},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","kind":"article","url":"\/documentation\/grafluent\/extensions","title":"Extensions Across Modules","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"abstract":[{"text":"An undirected graph that generic code can fill: the undirected counterpart of","type":"text"},{"text":" ","type":"text"},{"code":"MutableDirectedGraph","type":"codeVoice"},{"text":" (Boost’s ","type":"text"},{"code":"MutableGraph","type":"codeVoice"},{"text":" concept, ","type":"text"},{"code":"add_vertex","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"add_edge","type":"codeVoice"},{"text":"), with the","type":"text"},{"text":" ","type":"text"},{"text":"members a reader needs to build a graph by key.","type":"text"}],"navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}],"title":"MutableGraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableGraph","kind":"identifier"}],"u