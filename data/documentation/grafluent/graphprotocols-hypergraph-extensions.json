the"},{"type":"text","text":" "},{"type":"text","text":"Levi graph), as a lazy "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":": vertex index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" is vertex "},{"code":"i","type":"codeVoice"},{"type":"text","text":", "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"each incidence is an edge, XGI’s "},{"code":"to_bipartite_graph","type":"codeVoice"},{"type":"text","text":" numbering. Graph algorithms reach a"},{"type":"text","text":" "},{"type":"text","text":"hypergraph through it."}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"code":"BidirectionalGraph","type":"codeVoice"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"kind":"symbol","navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"role":"symbol","title":"BidirectionalDirectedGraph","type":"topic","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph"},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"kind":"symbol","role":"collection","title":"Grafluent","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"d