ype":"text","text":"The s-line graph (Aksoy et al. 2020; XGI’s "},{"type":"codeVoice","code":"to_line_graph(H, s)"},{"type":"text","text":", HyperNetX’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"get_linegraph"},{"type":"text","text":"): every position "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" as a vertex, in order, and an edge "},{"type":"codeVoice","code":"p"},{"type":"text","text":"–"},{"type":"codeVoice","code":"q"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"p < q"},{"type":"text","text":") when the two hyperedges share at least "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members. An empty hyperedge, or one"},{"type":"text","text":" "},{"type":"text","text":"sharing fewer than "},{"type":"codeVoice","code":"s"},{"type":"text","text":" members with every other, is isolated. Edges ascend by "},{"type":"codeVoice","code":"(p, q)"},{"type":"text","text":"."}],"title":"lineGraph(s:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/linegraph(s:)","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/lineGraph(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"abstract":[{"text":"The clique expansion (XGI’s ","type":"text"},{"code":"to_graph","type":"codeVoice"},{"text":", Berge’s 2-section): every vertex, isolated ones","type":"text"},{"text":" ","type":"text"},{"text":"included, in vertex-index order, and an edge between every two vertices that share a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower.","type":"text"},{"text":" ","type":"text"},{"text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members","type":"text"},{"text":" ","type":"text"},{"text":"is k(k − 1)\/2 edges.","type":"text"}],"role":"symbol","title":"cliqueExpansion()"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"code":"DiHypergraph","type":"codeVoice"},{"type":"text","text":" allows both)."}],"navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"title":"DirectedHypergraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableGraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-mutablegraph-extensions","type":"topic","kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","title":"Extensions to MutableGraph"},"doc://Grafluent/documentation/Grafluent":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent","type":"topic","kind":"symbol","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"role":"collection","title":"Grafluent"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/sConnectedComponents(s:)":{"role":"symbol","abstract":[{"text":"The hyperedge s-components (Aksoy et al. 2020; HyperNetX’s ","type":"text"},{"code":"s_connected_components","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"code":"edges=True","type":"codeVoice"},{"text":"): the connected components of ","type":"text"},{"code":"lineGraph(s:)","type":"codeVoice"},{"text":", as positions, without building","type":"text"},{"text":" ","type":"text"},{"text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own","type":"text"},{"text":" ","type":"text"},{"text":"component, and components are ordered by their least position, each ascending. The vertex","type":"text"},{"text":" ","type":"text"},{"text":"s-components are ","type":"text"},{"code":"dual().sConnectedComponents(s:)","type":"codeVoice"},{"text":".","type":"text"}],"title":"sConnectedComponents(s:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sConnectedComponents","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Index","preciseIdentifier":"s:Sl5IndexQa","kind":"typeIdentifier"},{"text":"]]","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/sconnectedcomponents(s:)","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/sConnectedComponents(s:)"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},{"text":".","type":"text"}],"