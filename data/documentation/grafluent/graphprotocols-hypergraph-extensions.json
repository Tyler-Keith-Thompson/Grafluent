e":"s_connected_components","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"code":"edges=True","type":"codeVoice"},{"text":"): the connected components of ","type":"text"},{"code":"lineGraph(s:)","type":"codeVoice"},{"text":", as positions, without building","type":"text"},{"text":" ","type":"text"},{"text":"it. Singletons are kept (HyperNetX drops them by default), an empty hyperedge is its own","type":"text"},{"text":" ","type":"text"},{"text":"component, and components are ordered by their least position, each ascending. The vertex","type":"text"},{"text":" ","type":"text"},{"text":"s-components are ","type":"text"},{"code":"dual().sConnectedComponents(s:)","type":"codeVoice"},{"text":".","type":"text"}],"title":"sConnectedComponents(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"kind":"symbol","title":"dual()","abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*, XGI’s and HyperNetX’s "},{"code":"dual()","type":"codeVoice"},{"type":"text","text":"), the transpose of the"},{"type":"text","text":" "},{"type":"text","text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge "},{"code":"i","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"code":"i","type":"codeVoice"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"code":"dual().dual()","type":"codeVoice"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","role":"symbo