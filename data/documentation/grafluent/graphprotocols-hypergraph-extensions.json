ite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"text":"Hypergraphs","type":"text"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","type":"topic","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","role":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedGraph":{"title":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","role":"symbol","abstract":[{"type":"text","text":"A directed graph: a finite set of vertices and a finite collection of directed edges between"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedgraph","navigatorTitle":[{"text":"DirectedGraph","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-mutabledirectedgraph-extensions","type":"topic","title":"Extensions to MutableDirectedGraph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","isActive":true},{"type":"text","text":"."}],"role":"collectionGroup"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*, XGI’s and HyperNetX’s "},{"code":"dual()","type":"codeVoice"},{"type":"text","text":"), the transpose of the"},{"type":"text","text":" "},{"type":"text","text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge "},{"code":"i","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"code":"i","type":"codeVoice"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"code":"dual().dual()","type":"codeVoice"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","text":"UndirectedIncidenceList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic","title":"dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","role":"symbol","kind":"symbol","title":"cliqueExpansion()","abstract":[{"text":"The clique expansion (XGI’s ","type":"text"},{"type":"codeVoice","code":"to_graph"},{"text":", Berge’s 2-section): every vertex, isolated ones","type":"text"},{"text":" ","type":"text"},{"text":"included, in vertex-index order, and an edge between every two vertices that share a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower.","type":"text"},{"text":" ","type":"text"},{"text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members","type":"text"},{"text":" ","type":"text"},{"text":"is k(k − 1)\/2 edges.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa"},{"text":">","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isUniform(size:)":{"abstract":[{"type":"text","text":"Whether every hyperedge has exactly "},{"type":"codeVoice","code":"size"},{"type":"text","text":" members (Berge’s k-uniform). Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges count (XGI’s "},{"type":"codeVoice","code":"is_uniform"},{"type":"text","text":" ignores singletons); vacuously true with no"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. O(m)."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUniform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","type":"topic","title":"isUniform(size:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","url":"\/documentation\/graphprotocols\/graph","title":"Graph","type":"topic","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"code":"DirectedGraph","type":"codeVoice"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"code":"directed","type":"codeVoice"},{"type":"text","text":" views it as one when an algorithm needs arcs."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"role":"symbol","title":"BidirectionalDirectedGraph","kind":"symbol","abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"title":"Extensions to DirectedHypergraph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedHypergraph-Extensions","type":"topic","url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","kind":"article","role":"collectionGroup"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/rank":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/rank","role":"symbol","kind":"symbol","title":"rank","abstract":[{"text":"The greatest hyperedge size (Berge’s rank), 0 with no hyperedges. O(m).","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/rank","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rank","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}]},"doc://GraphProtocols/documentation/