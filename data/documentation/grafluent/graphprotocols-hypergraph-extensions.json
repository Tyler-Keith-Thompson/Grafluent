xt","text":"Hypergraphs"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"code":"incidenceGraph","type":"codeVoice"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"title":"Hypergraph","type":"topic"},"doc://Grafluent/documentation/Grafluent":{"role":"collection","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"type":"topic","kind":"symbol","title":"Grafluent"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isConnected":{"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isConnected","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isconnected","kind":"symbol","role":"symbol","abstract":[{"text":"Whether there is exactly one connected component: false with no vertices (the library’s","type":"text"},{"text":" ","type":"text"},{"text":"rule; XGI raises). O(n + p α(n)).","type":"text"}],"title":"isConnected"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"type":"topic","fr