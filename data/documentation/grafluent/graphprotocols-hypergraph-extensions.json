 "},{"type":"text","text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"title":"dual()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV","text":"UndirectedIncidenceList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/sConnectedComponents(s:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sConnectedComponents"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa","text":"Hyperedges"},{"kind":"text","text":"."},{"kind":"typeIdentifier","