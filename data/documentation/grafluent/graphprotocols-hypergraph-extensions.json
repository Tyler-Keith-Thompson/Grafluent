itle":"Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/cliqueExpansion()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/cliqueExpansion()","abstract":[{"text":"The clique expansion (XGI’s ","type":"text"},{"type":"codeVoice","code":"to_graph"},{"text":", Berge’s 2-section): every vertex, isolated ones","type":"text"},{"text":" ","type":"text"},{"text":"included, in vertex-index order, and an edge between every two vertices that share a","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge, once, with no self-loops. Edges ascend by (index of u, index of v), u the lower.","type":"text"},{"text":" ","type":"text"},{"text":"Singletons and empty hyperedges add no edge. Lossy and quadratic: one hyperedge of k members","type":"text"},{"text":" ","type":"text"},{"text":"is k(k − 1)\/2 edges.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/cliqueexpansion()","role":"symbol","title":"cliqueExpansion()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedHypergraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-directedhypergraph-extensions","role":"