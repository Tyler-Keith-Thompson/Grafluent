type":"codeVoice","code":"add_vertex"},{"type":"text","text":" and "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":"), with the"},{"type":"text","text":" "},{"type":"text","text":"members a reader needs to build a graph by key."}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableGraph","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","role":"symbol","navigatorTitle":[{"text":"MutableGraph","kind":"identifier"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/dual()":{"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()","abstract":[{"type":"text","text":"The dual hypergraph (Berge’s H*, XGI’s and HyperNetX’s "},{"type":"codeVoice","code":"dual()"},{"type":"text","text":"), the transpose of the"},{"type":"text","text":" "},{"type":"text","text":"incidence: its vertices are this hypergraph’s positions, in order, and its hyperedge "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":"’s set of hyperedges. An isolated vertex becomes an empty hyperedge, and an empty"},{"type":"text","text":" "},{"type":"text","text":"hyperedge an isolated vertex, so the dual is always defined; "},{"type":"codeVoice","code":"dual().dual()"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"hypergraph with its vertices relabeled to their indices and its positions kept."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"UndirectedIncidenceList","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs23UndirectedIncidenceListV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"