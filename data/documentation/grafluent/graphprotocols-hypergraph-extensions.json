nt","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","title":"isUniform(size:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/degreeHistogram()":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices of degree "},{"type":"codeVoice","code":"d"},{"type":"text","text":", up to the greatest degree; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"vertices (NetworkX’s "},{"type":"codeVoice","code":"degree_histogram"},{"type":"text","text":" shape). O(n)."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"degreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"degreeHistogram()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/degreehistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/degreeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/connectedComponents()":{"role":"symbol","abstract":[{"type":"text","text":"The connected components: two vertices are together when a chain of hyperedges joins them."},{"type":"text","text":" "},{"type":"text","text":"Components are ordered by their least vertex index and list their vertices in index order;"},{"type":"text","text":" "},{"type":"text","text":"an isolated vertex is alone, and an empty hyperedge joins nothing. No vertices, no"},{"type":"text","text":" "},{"type":"text","text":"components."}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph