ionaldirectedgraph-extensions","kind":"article","role":"collectionGroup","title":"Extensions to BidirectionalDirectedGraph","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph"},{"text":".","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/lineGraph(s:)":{"role":"symbol","abstract":[{"type":"text","text":"The s-line graph (Aksoy et al. 2020; XGI’s "},{"code":"to_line_graph(H, s)","type":"codeVoice"},{"type":"text","text":", HyperNetX’s"},{"type":"text","text":" "},{"code":"get_linegraph","type":"codeVoice"},{"type":"text","text":"): every position "},{"code":"0..<m","type":"codeVoice"},{"type":"text","text":" as a vertex, in order, and an edge "},{"code":"p","type":"codeVoice"},{"type":"text","text":"–"},{"code":"q","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"p < q","type":"codeVoice"},{"type":"text","text":") when the two hyperedges share at least "},{"code":"s","type":"codeVoice"},{"type":"text","text":" members. An empty hyperedge, or one"},{"type":"text","text":" "},{"type":"text","text":"sharing fewer than "},{"code":"s","type":"codeVoice"},{"type":"text","text":" members with every other, is isolated. Edges ascend by "},{"code":"(p, q)","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/linegraph(s:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lineGraph"},{"kind":"text","text":"("},{"kind":"externalParam","text":"s"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V","kind":"typeIdentifier","text":"UndirectedAdjacencyList"},{"kind":"text","text":"<"},{"kin