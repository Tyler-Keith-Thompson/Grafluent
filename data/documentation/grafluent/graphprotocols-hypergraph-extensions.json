:"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","kind":"symbol","title":"Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/graphprotocols\/graph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/degreeHistogram()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/degreeHistogram()","kind":"symbol","role":"symbol","title":"degreeHistogram()","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/degreehistogram()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"degreeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"abstract":[{"text":"Element ","type":"text"},{"type":"codeVoice","code":"d"},{"text":" counts the vertices of degree ","type":"text"},{"type":"codeVoice","code":"d"},{"text":", up to the greatest degree; ","type":"text"},{"type":"codeVoice","code":"[]"},{"text":" with no","type":"text"},{"text":" ","type":"text"},{"text":"vertices (NetworkX’s ","ty