:"codeVoice"},{"type":"text","text":", "},{"code":"remove_edge","type":"codeVoice"},{"type":"text","text":", "},{"code":"remove_vertex","type":"codeVoice"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"code":"DirectedAcyclicGraph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"title":"MutableDirectedGraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/lineGraph(s:)":{"title":"lineGraph(s:)","url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/linegraph(s:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lineGraph","kind":"identifier"},{"text":"(","kind":"text"},{"text":"s","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":") -> ","kind":"text"},{"text":"UndirectedAdjacencyList","kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule010UndirectedaB0V"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Hyperedges","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP10HyperedgesQa"},{"text":".","kind":"text"},{"text":"Index","kind":"typeIdentifier","preciseIdentifier":"s:Sl5IndexQa"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"text":"The s-line graph (Aksoy et al. 2020; XGI’s ","type":"text"},{"code":"to_line_graph(H, s)","type":"codeVoice"},{"text":", HyperNetX’s","type":"text"},{"text":" ","type":"text"},{"code":"get_linegraph","type":"codeVoice"},{"text":"): every position ","type":"text"},{"code":"0..<m","type":"codeVoice"},{"text":" as a vertex, in order, and an edge ","type":"text"},{"code":"p","type":"codeVoice"},{"text":"–","type":"text"},{"code":"q","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"p < q","type":"codeVoice"},{"text":") when the two hyperedges share at least ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" members. An empty hyperedge, or one","type":"text"},{"text":" ","type":"text"},{"text":"sharing fewer than ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" members with every other, is isolated. Edges ascend by ","type":"text"},{"code":"(p, q)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/lineGraph(s:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/isUniform(size:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/isuniform(size:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/isUniform(size:)","abstract":[{"type":"text","text":"Whether every hyperedge has exactly "},{"type":"codeVoice","code":"size"},{"type":"text","text":" members (Berge’s k-uniform). Singletons and"},{"type":"text","text":" "},{"type":"text","text":"empty hyperedges count (XGI’s "},{"type":"codeVoice","code":"is_uniform"},{"type":"text","text":" ignores singletons); vacuously true with no"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. O(m)."}],"type":"topic","title":"isUniform(size:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isUniform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Exten