e":"text"},{"text":" ","type":"text"},{"text":"hypergraph with its vertices relabeled to their indices and its positions kept.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/dual()"},"doc://Grafluent/documentation/Grafluent":{"kind":"symbol","role":"collection","type":"topic","title":"Grafluent","url":"\/documentation\/grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"url":"\/documentation\/grafluent\/extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","title":"Extensions Across Modules","kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/hyperedgeSizeHistogram()":{"type":"topic","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"k"},{"type":"text","text":" counts the hyperedges of size "},{"type":"codeVoice","code":"k"},{"type":"text","text":", up to the rank; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no hyperedges."},{"type":"text","text":" "},{"type":"text","text":"O(m)."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/hypergraph\/hyperedgesizehistogram()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hyperedgeSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/Hypergraph\/hyperedgeSizeHistogram()","title":"hyperedgeSizeHistogram()","kind":"symbol"},"do