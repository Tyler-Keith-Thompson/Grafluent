bol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}],"url":"\/documentation\/graphprotocols\/mutablegraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"kind":"symbol","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","title":"MutableDirectedGraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/Hypergraph/degreeHistogram()":{"role":"symbol","abstract":[{"text":"Element ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" counts the vertices of degree ","type":"text"},{"code":"d","type":"codeVoice"},{"text":", up to the greatest degree; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no","type":"