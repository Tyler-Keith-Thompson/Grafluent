phProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"isBConnected(from:to:)"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"url":"\/documentation\/grafluent\/extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","title":"Extensions Across Modules","kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/cliqueExpansion()":{"type":"topic","abstract":[{"type":"text","text":"The directed clique expansion (SimpleDirectedHypergraphs.jl’s "},{"type":"codeVoice","code":"TwoSectionView"},{"type":"text","text":"): every"},{"type":"text","text":" "},{"type":"text","text":"vertex, isolated ones included, in vertex-index order, and an arc "},{"type":"codeVoice","code":"u → v"},{"type":"text","text":" when some"},{"type":"text","text":" "},{"type":"text","text":"hyperedge has "},{"type":"codeVoice","code":"u"},{"type":"text","text":" among its sources and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" among its targets, "},{"type":"codeVoice","code":"u ≠ v"},{"type":"text","text":", once per pair."},{"type":"text","text":" "},{"type":"text","text":"Arcs ascend by (index of u, index of v). A hyperedge with an empty side adds none."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/cliqueexpansion()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cliqueExpansion","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:19AdjacencyListModule0aB0V","text":"AdjacencyList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/cliqueExpansion()","title":"cliqueExpansion()","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Hypergraphs"}]},{"type":"text","text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"title":"Hypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/fConnectedVertices(to:)":{"typ