,"text":", 1989). Not a "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"type":"codeVoice","code":"Hypergraphs"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"type":"topic","url":"\/documentation\/graphprotocols\/hypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","title":"Hypergraph","role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/cliqueExpansion()":{"role":"symbol","type":"topic","abstract":[{"text":"The directed clique expansion (SimpleDirectedHypergraphs.jl’s ","type":"text"},{"type":"codeVoice","code":"TwoSectionView"},{"text":"): every","type":"text"},{"text":" ","type":"text"},{"text":"vertex, isolated ones included, in vertex-index order, and an arc ","type":"text"},{"type":"codeVoice","code":"u → v"},{"text":" when some","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge has ","type":"text"},{"type":"codeVoice","code":"u"},{"text":" among its sources and ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" among its targets, ","type":"text"},{"type":"codeVoice","code":"u ≠ v"},{"text":", once per pair.","type":"text"},{"text":" ","type":"text"},{"text":"Arcs ascend by (index of u, index of v). A hyperedge with an empty side adds none.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:19AdjacencyListModule0aB0V","kind":"typeIdentifier","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"cliqueExpansion()","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/cliqueexpansion()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/cliqueExpansion()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/incidenceGraph":{"title":"incidenceGraph","role":"symbol","abstract":[{"type":"text","text":"The directed hypergraph’s incidence graph as a lazy "},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"type":"text","text":": vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"code":"i","type":"codeVoice"},{"type":"text","text":" is vertex "},{"code":"i","type":"codeVoice"},{"type":"text","text":", "},{"code":"n + p","type":"codeVoice"},{"type":"text","text":" is hyperedge "},{"code":"p","type":"codeVoice"},{"type":"text","text":", an arc from each source to its hyperedge"},{"type":"text","text":" "},{"type":"text","text":"and from the hyperedge to each target (XGI’s directed "},{"code":"to_bipartite_graph","type":"codeVoice"},{"type":"text","text":"). Plain directed"},{"type":"text","text":" "},{"type":"text","text":"reachability, Gallo et al.’s “connected”, is "},{"code":"descendants(of:)","type":"codeVoice"},{"type":"text","text":" on it restricted to"},{"type":"text","text":" "},{"code":"0 ..< n","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/incidencegraph","kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraph","kind