hProtocols-Hypergraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions","title":"Extensions to Hypergraph","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","isActive":true},{"type":"text","text":"."}],"kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/inDegreeHistogram()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inDegreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/indegreehistogram()","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/inDegreeHistogram()","title":"inDegreeHistogram()","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices with "},{"type":"codeVoice","code":"d"},{"type":"text","text":" in-hyperedges; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no vertices. O(n)."}],"kind":"symbol","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/stronglyConnectedComponents()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","kind":"symbol","title":"stronglyConnectedComponents()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":"]]","kind":"text"}],"type":"topic","abstract":[{"text":"The strongly connected components: ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" are together when each reaches the other","type":"text"},{"text":" ","type":"text"},{"text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the","type":"text"},{"text":" ","type":"text"},{"text":"incidence graph). They are the strong components of ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" restricted to the","type":"text"},{"text":" ","type":"text"},{"text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection","type":"text"},{"text":" ","type":"text"},{"text":"(SimpleDirectedHypergraphs.jl’s ","type":"text"},{"code":"get_strongly_connected_components","type":"codeVoice"},{"text":") is a different,","type":"text"},{"text":" ","type":"text"},{"text":"finer relation.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/dual()":{"kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/dual()","title":"dual()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs13IncidenceListV","text":"IncidenceList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP10HyperedgesQa","text":"Hyperedges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5IndexQa","text":"Index","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","abstract":[{"text":"The dual: the transpose of each plane (SimpleDirectedHypergraphs.jl’s convention, and","type":"text"},{"text":" ","type":"text"},{"code":"OrientedIncidenceMatrix.transposed()","type":"codeVoice"},{"text":"). Its vertices are this hypergraph’s positions, in","type":"text"},{"text":" ","type":"text"},{"text":"order, and its hyperedge ","type":"text"},{"code":"i","type":"codeVoice"},{"text":" has sources ","type":"text"},{"code":"outHyperedges(ofIndex: i)","type":"codeVoice"},{"text":" and targets","type":"text"},{"text":" ","type":"text"},{"code":"inHyperedges(ofIndex: i)","type":"codeVoice"},{"text":". An isolated vertex becomes the empty hyperedge ","type":"text"},{"code":"{} → {}","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"back.","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/dual()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isStronglyConnected":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isStronglyConnected","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"kind":"symbol","title":"isStronglyConnected","abstract":[{"text":"Whether there is exactly one strongly connected component; false with no vertices.","type":"text"}],"type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isstronglyconnected","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isStronglyConnected","role":"symbol"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions","url":"