onnected component; false with no vertices."}],"type":"topic","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isweaklyconnected"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"role":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbfhypergraph","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBFHypergraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target or exactly one source: a BF-graph. Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}],"title":"isBFHypergraph","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBFHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/bConnectedVertices(from:)":{"role":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]"}],"title":"bConnectedVertices(from:)","abstract":[{"text":"Every vertex B-connected to ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" included, in vertex-index order: Gallo et","type":"text"},{"text":" ","type":"text"},{"text":"al.‘s B-Visit (halp’s ","type":"text"},{"type":"codeVoice","code":"b_visit"},{"text":"). A hyperedge fires once every one of its sources has been","type":"text"},{"text":" ","type":"text"},{"text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is","type":"text"},{"text":" ","type":"text"},{"text":"reachability.","type":"text"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/cliqueExpansion()":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:19AdjacencyListModule0aB0V","kind":"typeIdentifier","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"title":"cliqueExpansion()","abstract":[{"text":"The directed clique expansion (SimpleDirectedHypergraphs.jl’s ","type":"text"},{"type":"codeVoice","code":"TwoSectionView"},{"text":"): every","type":"text"},{"text":" ","type":"text"},{"text":"vertex, isolated ones included, in vertex-index order, and an arc ","type":"text"},{"type":"codeVoice","code":"u → v"},{"text":" when some","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge has ","type":"text"},{"type":"codeVoice","code":"u"},{"text":" among its sources and ","type":"text"},{"type":"codeVoice","code":"v"},{"text":" among its targets, ","type":"text"},{"type":"codeVoice","code":"u ≠ v"},{"text":", once per pair.","type":"text"},{"text":" ","type":"text"},{"text":"Arcs ascend by (index of u, index of v). A hyperedge with an empty side adds none.","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/cliqueexpansion()","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/cliqueExpansion()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/weaklyConnectedComponents()":{"role":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/weaklyconnectedcomponents()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"weaklyConnectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]]"}],"abstract":[{"type":"text","text":"The weakly connected components: vertices joined through either side of a chain of"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. Ordered by least vertex index, each in index order; an isolated vertex is alone."}],"title":"weaklyConnectedComponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/weaklyConnectedComponents()"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-BidirectionalDirectedGraph-Extensions":{"title":"Extensions to BidirectionalDirectedGraph","url":"\/documentation\/grafluent\/graphprotocols-bidirectionaldirectedgraph-extensions","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-BidirectionalDirectedGraph-Extensions"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"title":"Extensions to MutableDirectedGraph","url":"\/documentation\/grafluent\/graphprotocols-mutabledirectedgraph-extensions","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/stronglyConnectedComponents()":{"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stronglyConnectedComponents","kind":"identifier"},{"text":"() -> [[","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":"]]","kind":"text"}],"title":"stronglyConnectedComponents()","abstract":[{"type":"text","text":"The strongly connected components: "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" are together when each reaches the other"},{"type":"text","text":" "},{"type":"text","text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the"},{"type":"text","text":" "},{"type":"text","text":"incidence graph). They are the strong components of "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" restricted to the"},{"type":"text","text":" "},{"type":"text","text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection"},{"type":"text","text":" "},{"type":"text","text":"(SimpleDirectedHypergraphs.jl’s "},{"