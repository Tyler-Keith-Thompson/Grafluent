\/grafluent\/extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"title":"Extensions Across Modules"},"doc://Grafluent/documentation/Grafluent":{"role":"collection","kind":"symbol","url":"\/documentation\/grafluent","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"title":"Grafluent"},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hypergraph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Hypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/hypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"text":", 1989). Not a ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"code":"Hypergraphs","type":"codeVoice"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"code":"incidenceGraph","type":"codeVoice"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}],"title":"Hypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBHypergraph":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbhypergraph","type":"topic","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBHypergraph","title":"isBHypergraph","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBHypergraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"Whether every hyperedge has exactly one target: a B-graph (Gallo et al.‘s backward","type":"text"},{"text":" ","type":"text"},{"text":"hypergraph; halp’s ","type":"text"},{"code":"is_B_hypergraph","type":"codeVoice"},{"text":"). Vacuously true with no hyperedges. O(m).","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/directedhypergraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}]},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"type":"text","text":" allows both)."}],"title":"DirectedHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/outDegreeHistogram()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/outDegreeHistogram()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"outDegreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"Element ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" counts the vertices with ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" out-hyperedges; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no vertices. O(n).","type":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/outdegreehistogram()","role":"symbol","type":"topic","kind":"symbol","title":"outDegreeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/inDegreeHistogram()":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/indegreehistogram()","type":"topic","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/inDegreeHistogram()","title":"inDegreeHistogram()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inDegreeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"Element "},{"code":"d","type":"codeVoice"},{"type":"text","text":" counts the vertices with "},{"code":"d","type":"codeVoice"},{"type":"text","text":" in-hyperedges; "},{"code":"[]","type":"code