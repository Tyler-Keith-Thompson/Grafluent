er":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBHypergraph","title":"isBHypergraph","abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target: a B-graph (Gallo et al.‘s backward"},{"type":"text","text":" "},{"type":"text","text":"hypergraph; halp’s "},{"type":"codeVoice","code":"is_B_hypergraph"},{"type":"text","text":"). Vacuously true with no hyperedges. O(m)."}],"kind":"symbol","type":"topic"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","title":"Extensions to DirectedGraph","role":"collectionGroup","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true},{"text":".","type":"text"}],"kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBFHypergraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbfhypergraph","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBFHypergraph","title":"isBFHypergraph","abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target or exactly one source: a BF-graph. Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}],"kind":"symbol","type":"topic"},"doc://Grafluent/documentation/Grafluent/Extensions":{"kind":"article","url":"\/documentation\/grafluent\/extensions","title":"Extensions Across Modules","role":"collectionGroup","type":"topic","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/incidenceGraph":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"incidenceGraph","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DirectedIncidenceGraphView","kind":"typeIdentifier","preciseIdentifier":"s:11Hypergraphs26DirectedIncidenceGraphViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/incidencegraph","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/incidenceGraph","title":"incidenceGraph","abstract":[{"type":"text","text":"The directed hypergraph’s incidence graph as a lazy "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": vertex"},{"type":"text","text":" "},{"type":"text","text":"index "},{"type":"codeVoice","code":"i"},{"type":"text","text":" is vertex "},{"type":"codeVoice","code":"i"},{"type":"text","text":", "},{"type":"codeVoice","code":"n + p"},{"type":"text","text":" is hyperedge "},{"type":"codeVoice","code":"p"},{"type":"text","text":", an arc from each source to its hyperedge"},{"type":"text","text":" "},{"type":"text","text":"and from the hyperedge to each target (XGI’s directed "},{"type":"codeVoice","code":"to_bipartite_graph"},{"type":"text","text":"). Plain directed"},{"type":"text","text":" "},{"type":"text","text":"reachability, Gallo et al.’s “connected”, is "},{"type":"codeVoice","code":"descendants(of:)"},{"type":"text","text