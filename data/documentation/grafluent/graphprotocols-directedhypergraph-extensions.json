","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]"}],"title":"bConnectedVertices(from:)","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"role":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/dual()":{"role":"symbol","abstract":[{"type":"text","text":"The dual: the transpose of each plane (SimpleDirectedHypergraphs.jl’s convention, and"},{"type":"text","text":" "},{"code":"OrientedIncidenceMatrix.transposed()","type":"codeVoice"},{"type":"text","text":"). Its vertices are this hypergraph’s positions, in"},{"type":"text","text":" "},{"type":"text","text":"order, and its hyperedge "},{"code":"i","type":"codeVoice"},{"type":"text","text":" has sources "},{"code":"outHyperedges(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" and targets"},{"type":"text","text":" "},{"code":"inHyperedges(ofIndex: i)","type":"codeVoice"},{"type":"text"