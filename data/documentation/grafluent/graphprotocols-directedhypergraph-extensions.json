ype":"text"},{"text":" ","type":"text"},{"text":"and Nguyen, “Directed hypergraphs and applications”, ","type":"text"},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint","type":"text"},{"text":" ","type":"text"},{"text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a","type":"text"},{"text":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/graphprotocols\/directedhypergraph","role":"symbol","kind":"symbol","title":"DirectedHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBConnected(from:to:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbconnected(from:to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBConnected","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"target","kind":"internalParam"},{"text":": ","k