cumentation\/graphprotocols\/directedgraph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedGraph","kind":"identifier"}],"title":"DirectedGraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","kind":"symbol"},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/bidirectionaldirectedgraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"navigatorTitle":[{"kind":"identifier","text":"BidirectionalDirectedGraph"}],"title":"BidirectionalDirectedGraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBHypergraph":{"type":"topic","abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target: a B-graph (Gallo et al.‘s backward"},{"type":"text","text":" "},{"type":"text","text":"hypergraph; halp’s "},{"type":"codeVoice","code":"is_B_hypergraph"},{"type":"text","text":"). Vacuously true with no hyperedges. O(m)."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbhypergraph","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBHypergraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","pr