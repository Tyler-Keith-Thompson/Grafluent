graph\/fConnectedVertices(to:)","kind":"symbol","role":"symbol","title":"fConnectedVertices(to:)","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/fconnectedvertices(to:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"target","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"Every vertex "},{"type":"codeVoice","code":"s"},{"type":"text","text":" such that "},{"type":"codeVoice","code":"target"},{"type":"text","text":" is F-connected to "},{"type":"codeVoice","code":"s"},{"type":"text","text":", "},{"type":"codeVoice","code":"target"},{"type":"text","text":" included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order. Gallo et al.: “the F-Visit must start from the destination of the"},{"type":"text","text":" "},{"type":"text","text":"F-paths to retain a linear time complexity”; it is B-Visit on the symmetric image, so it"},{"type":"text","text":" "},{"type":"text","text":"equals "},{"type":"codeVoice","code":"reversed.bConnectedVertices(from: target)"},{"type":"text","text":" (halp’s "},{"type":"codeVoice","code":"f_visit"},{"type":"text","text":")."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/outDegreeHistogram()":{"title":"outDegreeHistogram()","kind":"symbol","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/outDegreeHistogram()","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/outdegreehistogram()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"outDegreeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"d"},{"type":"text","text":" counts the vertices with "},{"type":"codeVoice","code":"d"},{"type":"text","text":" out-hyperedges; "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no vertices. O(n)."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/bConnectedVertices(from:)":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)","kind":"symbol","role":"symbol","title":"bConnectedVertices(from:)","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":" "},{"kind":"internalParam","text":"source"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets; a hyperedge with no sources never fires. On a"},{"type":"text","text":" "},{"type":"text","text":"directed graph read as a hypergraph this is reachability."}]},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"role":"symbol","kind":"symbol","title":"Graph","abstract":[{"text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges","type":"text"},{"text":" ","type":"text"},{"text":"between them. Kept apart from ","type":"text"},{"code":"DirectedGraph","type":"codeVoice"},{"text":": an undirected graph is not a symmetric directed","type":"text"},{"text":" ","type":"text"},{"text":"one, and no type is both. ","type":"text"},{"code":"directed","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols0A0P6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"type":"topic","url":"\/documentation\/graphprotocols\/graph"},"doc://Grafluent/documentation/Grafluent":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","kind":"symbol","role":"collection","title":"Grafluent","url":"\/documentation\/grafluent","type":"topic","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"role":"symbol","kind":"symbol","title":"Hypergraph","abstract":[{"type":"text","text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a"},{"type":"text","text":" "},{"type":"text","text":"set of vertices of any size, the empty set included (Berge, "},{"inlineContent":[{"type":"text","text":"Hypergraphs"}],"type":"emphasis"},{"type":"text","text":", 1989). Not a "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and no shared parent with one: a hyperedge is not an edge. The "},{"code":"Hypergraphs","type":"codeVoice"},{"type":"text","text":" module’s"},{"type":"text","text":" "},{"code":"incidenceGraph","type":"codeVoice"},{"type":"text","text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is"},{"type":"text","text":" "},{"type":"text","text":"how the graph algorithms reach it."}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols10HypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"url":"\/documentation\/graphprotocols\/hypergraph","type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"title":"isBFHypergraph","kind":"symbol","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBFHypergraph","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbfhypergraph","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isBFHypergraph"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target or exactly one source: a BF-graph. Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}]}}}