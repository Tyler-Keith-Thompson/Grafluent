ext":" ","type":"text"},{"text":"self-loop (XGI’s ","type":"text"},{"code":"DiHypergraph","type":"codeVoice"},{"text":" allows both).","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedHypergraph"}],"navigatorTitle":[{"kind":"identifier","text":"DirectedHypergraph"}],"title":"DirectedHypergraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/stronglyConnectedComponents()":{"type":"topic","abstract":[{"type":"text","text":"The strongly connected components: "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" are together when each reaches the other"},{"type":"text","text":" "},{"type":"text","text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the"},{"type":"text","text":" "},{"type":"text","text":"incidence graph). They are the strong components of "},{"type":"codeVoice","code":"incidenceGraph"},{"type":"text","text":" restricted to the"},{"type":"text","text":" "},{"type":"text","text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection"},{"type":"text","text":" "},{"type":"text","text":"(SimpleDirectedHypergraphs.jl’s "},{"type":"codeVoice","code":"get_strongly_connected_components"},{"type":"text","text":") is a different,"},{"type":"text","text":" "},{"type":"text","text":"finer relation."}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]]"}],"title":"stronglyConnectedComponents()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","kind":"symbol"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/dual()":{"abstract":[{"type":"text","text":"The dual: the transpose of each plane (SimpleDirectedHypergraphs.jl’s convention, and"},{"type":"text","text":" "},{"code":"OrientedIncidenceMatrix.transposed()","type":"codeVoice"},{"type":"text","text":"). Its vertices are this hypergraph’s positions, in"},{"type":"text","text":" "},{"type":"text","text":"order, and its hyperedge "},{"code":"i","type":"codeVoice"},{"type":"text","text":" has sources "},{"code":"outHyperedges(ofIndex: i)","type":"codeVoice"},{"type":"text","text":" and targets"},{"type":"text","text":" "},{"code":"inHyperedges(ofIndex: i)","type":"codeVoice"},{"type":"text","text":". An isolated vertex becomes the empty hyperedge "},{"code":"{} → {}","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"back."}],"type":"topic","role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/dual()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/dual()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dual","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11Hypergraphs13IncidenceListV","text":"IncidenceList","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP10HyperedgesQa","text":"Hyperedges","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sl5