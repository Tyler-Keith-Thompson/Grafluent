-Extensions","role":"collectionGroup","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","type":"topic","title":"Extensions to Graph","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","isActive":true},{"type":"text","text":"."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/fConnectedVertices(to:)":{"role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/fconnectedvertices(to:)","title":"fConnectedVertices(to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/fConnectedVertices(to:)","kind":"symbol","abstract":[{"type":"text","text":"Every vertex "},{"code":"s","type":"codeVoice"},{"type":"text","text":" such that "},{"code":"target","type":"codeVoice"},{"type":"text","text":" is F-connected to "},{"code":"s","type":"codeVoice"},{"type":"text","text":", "},{"code":"target","type":"codeVoice"},{"type":"text","text":" included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order. Gallo et al.: “the F-Visit must start from the destination of the"},{"type":"text","text":" "},{"type":"text","text":"F-paths to retain a linear time complexity”; it is B-Visit on the symmetric image, so it"},{"type":"text","text":" "},{"type":"text","text":"equals "},{"code":"reversed.bConnectedVertices(from: target)","type":"codeVoice"},{"type":"text","text":" (halp’s "},{"code":"f_visit","type":"codeVoice"},{"type":"text","text":"), and a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no targets never fires."}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedHypergraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph","role":"symbol","navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/directedhypergraph","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedHypergraph","kind":"identifier"}],"type":"topic","title":"DirectedHypergraph","abstract":[{"type":"text","text":"A directed hypergraph: a finite set of vertices and a finite collection of hyperedges, each an"},{"type":"text","text":" "},{"type":"text","text":"ordered pair of vertex sets, its sources (tail) and its targets (head). Gallo, Longo, Pallottino"},{"type":"text","text":" "},{"type":"text","text":"and Nguyen, “Directed hypergraphs and applications”, "},{"inlineContent":[{"text":"Discrete Applied Mathematics","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"code":"DiHypergraph","type":"codeVoice"},{"type":"text","text":" allows both)."}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isWeaklyConnected":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isweaklyconnected","role":"symbol","abstr