e":"u","type":"codeVoice"},{"type":"text","text":" among its sources and "},{"code":"v","type":"codeVoice"},{"type":"text","text":" among its targets, "},{"code":"u ≠ v","type":"codeVoice"},{"type":"text","text":", once per pair."},{"type":"text","text":" "},{"type":"text","text":"Arcs ascend by (index of u, index of v). A hyperedge with an empty side adds none."}],"title":"cliqueExpansion()","kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/cliqueExpansion()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule0aB0V","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/cliqueexpansion()"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Graph-Extensions":{"type":"topic","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Graph-Extensions","url":"\/documentation\/grafluent\/graphprotocols-graph-extensions","title":"Extensions to Graph","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","type":"reference","isActive":true},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-Hypergraph-Extensions":{"abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph"},{"type":"text","text":"."}],"title":"Extensions to Hypergraph","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-Hypergraph-Extensions","type":"topic","role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-hypergraph-extensions"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/targetSizeHistogram()":{"type":"topic","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/targetSizeHistogram()","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/targetsizehistogram()","title":"targetSizeHistogram()","abstract":[{"text":"Element ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" counts the hyperedges with ","type":"text"},{"type":"codeVoice","code":"k"},{"text":" targets (XGI’s ","type":"text"},{"type":"codeVoice","code":"head_size"},{"text":"); ","type":"text"},{"type":"codeVoice","code":"[]"},{"text":" with no","type":"text"},{"text":" ","type":"text"},{"text":"hyperedges. O(m).","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"targetSizeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"]"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/stronglyConnectedComponents()":{"abstract":[{"type":"text","text":"The strongly connected components: "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" are together when each reaches the other"},{"type":"text","text":" "},{"type":"text","text":"along source → hyperedge → target steps (Gallo et al.‘s “connected”: a path in the"},{"type":"text","text":" "},{"type":"text","text":"incidence graph). They are the strong components of "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" restricted to the"},{"type":"text","text":" "},{"type":"text","text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection"},{"type":"text","text":" "},{"type":"text","text":"(SimpleDirectedHypergraphs.jl’s "},{"type":"codeVoice","code":"get_strongly_connected_components"},{"type":"text","text":") is a different,"},{"type":"text","text":" "},{"type":"text","text":"finer relation."}],"title":"stronglyConnectedComponents()","kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":"]]"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/fConnectedVertices(to:)":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/fConnectedVertices(to:)","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/fconnectedvertices(to:)","title":"fConnectedVertices(to:)","abstract":[{"text":"Every vertex ","type":"text"},{"code":"s","type":"codeVoice"},{"text":" such that ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" is F-connected to ","type":"text"},{"code":"s","type":"codeVoice"},{"text":", ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" included, in","type":"text"},{"text":" ","type":"text"},{"text":"vertex-index order. Gallo et al.: “the F-Visit must start from the destination of the","type":"text"},{"text":" ","type":"text"},{"text":"F-paths to retain a linear time complexity”; it is B-Visit on the symmetric image, so it","type":"text"},{"text":" ","type":"text"},{"text":"equals ","type":"text"},{"code":"reversed.bConnectedVertices(from: target)","type":"codeVoice"},{"text":" (halp’s ","type":"text"},{"code":"f_visit","type":"codeVoice"},{"text":"), and a hyperedge with","type":"text"},{"text":" ","type":"text"},{"text":"no targets never fires.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/BidirectionalDirectedGraph":{"abstract":[{"type":"text","text":"A directed graph that also answers in-neighborhoods: Boost’s "},{"type":"codeVoice","code":"BidirectionalGraph"},{"type":"text","text":". Kept apart"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":" because in-adjacency usually costs extra storage, and many algorithms only"},{"type":"text","text":" "},{"type":"text","text":"go forward."}],"navigatorTitle":[{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"title":"BidirectionalDirectedGraph","kind":"symbol","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/BidirectionalDirectedGraph","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BidirectionalDirectedGraph","kind":"identifier"}],"url":"\/documen