ation\/GraphProtocols\/BidirectionalDirectedGraph"},{"text":".","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/fConnectedVertices(to:)":{"abstract":[{"type":"text","text":"Every vertex "},{"type":"codeVoice","code":"s"},{"type":"text","text":" such that "},{"type":"codeVoice","code":"target"},{"type":"text","text":" is F-connected to "},{"type":"codeVoice","code":"s"},{"type":"text","text":", "},{"type":"codeVoice","code":"target"},{"type":"text","text":" included, in"},{"type":"text","text":" "},{"type":"text","text":"vertex-index order. Gallo et al.: “the F-Visit must start from the destination of the"},{"type":"text","text":" "},{"type":"text","text":"F-paths to retain a linear time complexity”; it is B-Visit on the symmetric image, so it"},{"type":"text","text":" "},{"type":"text","text":"equals "},{"type":"codeVoice","code":"reversed.bConnectedVertices(from: target)"},{"type":"text","text":" (halp’s "},{"type":"codeVoice","code":"f_visit"},{"type":"text","text":"), and a hyperedge with"},{"type":"text","text":" "},{"type":"text","text":"no targets never fires."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":"]"}],"title":"fConnectedVertices(to:)","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/fconnectedvertices(to:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/Grap