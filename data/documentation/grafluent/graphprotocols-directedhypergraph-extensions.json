o type is both. ","type":"text"},{"code":"directedView","type":"codeVoice"},{"text":" views it as one when an algorithm needs arcs.","type":"text"}],"navigatorTitle":[{"text":"Graph","kind":"identifier"}],"title":"Graph","kind":"symbol","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Graph","kind":"identifier"}],"url":"\/documentation\/graphprotocols\/graph"},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableDirectedGraph"}],"title":"MutableDirectedGraph","abstract":[{"type":"text","text":"A bidirectional directed graph that generic code can mutate: Boost’s "},{"type":"codeVoice","code":"MutableGraph"},{"type":"text","text":" concept"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"add_vertex"},{"type":"text","text":", "},{"type":"codeVoice","code":"add_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_edge"},{"type":"text","text":", "},{"type":"codeVoice","code":"remove_vertex"},{"type":"text","text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as "},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"can own any of the mutable representations as its base and still run at the base’s speed."}],"kind":"symbol","type":"topic","url":"\/documentation\/graphprotocols\/mutabledirectedgraph","navigatorTitle":[{"kind":"identifier","text":"MutableDirectedGraph"}],"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/sourceSizeHistogram()":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sourceSizeHistogram","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"]","kind":"text"}],"title":"sourceSizeHistogram()","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"k"},{"type":"text","text":" counts the hyperedges with "},{"type":"codeVoice","code":"k"},{"type":"text","text":" sources (XGI’s "},{"type":"codeVoice","code":"tail_size"},{"type":"text","text":"); "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. O(m)."}],"kind":"symbol","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/sourcesizehistogram()","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/sourceSizeHistogram()"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFHypergraph":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFHypergraph","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfhypergraph","title":"isFHypergraph","abstract":[{"text":"Whether every hyperedge has exactly one source: an F-graph (forward hypergraph). Vacuously","type":"text"},{"text":" ","type":"text"},{"text":"true with no hyperedges. O(m).","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/bConnectedVertices(from:)":{"type":"topic","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","title":"bConnectedVertices(from:)","abstract":[{"type":"text","text":"Every vertex B-connected to "},{"type":"codeVoice","code":"source"},{"type":"text","text":", "},{"type":"codeVoice","code":"source"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"type":"codeVoice","code":"b_visit"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bConnectedVertices","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":") -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Vertex","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"text":"]","kind":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFConnected(from:to:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFConnected"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfconnected(from:to:)","title":"isFConnected(from:to:)","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFConnected(from:to:)","abstract":[{"text":"Whether there is an F-path from ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"target","type":"codeVoice"},{"text":": one whose symmetric image is a B-path","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"source","type":"codeVoice"},{"text":", so every target of a hyperedge it uses must lead on to ","type":"text"},{"code":"target","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"F-Visit from ","type":"text"},{"code":"target","type":"codeVoice"},{"text":", stopping at ","type":"text"},{"code":"source","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isWeaklyConnected":{"type":"topic","role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isWeaklyConnected","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isweaklyconnected","title":"isWeaklyConnected","abstract":[{"text":"Whether there is exactly one weakly connected component; false with no vertices.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isWeaklyConnected"},{"kind":"text","text":": "},{"kind":"typeIdentifier","pr