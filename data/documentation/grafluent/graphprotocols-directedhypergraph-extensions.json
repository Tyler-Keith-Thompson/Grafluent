:{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/stronglyconnectedcomponents()","kind":"symbol","title":"stronglyConnectedComponents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stronglyConnectedComponents"},{"kind":"text","text":"() -> [["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":"]]"}],"abstract":[{"type":"text","text":"The strongly connected components: "},{"type":"codeVoice","code":"u"},{"type":"text","text":" and "},{"type":"codeVoice","code":"v"},{"type":"text","text":" are together when each reaches the other"},{"type":"text","text":" "},{"type":"text","text":"along source → hyperedge → target steps (Gallo et al.’s “connected”: a path in the"},{"type":"text","text":" "},{"type":"text","text":"incidence graph). They are the strong components of "},{"type":"codeVoice","code":"incidenceGraphView"},{"type":"text","text":" restricted to the"},{"type":"text","text":" "},{"type":"text","text":"vertices, ordered by least vertex index, each in index order. Mutual B-connection is a"},{"type":"text","text":" "},{"type":"text","text":"different, finer relation."}],"role":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/stronglyConnectedComponents()","type":"topic"}}}