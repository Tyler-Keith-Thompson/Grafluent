/directedhypergraph\/cliqueexpansion()","role":"symbol","abstract":[{"text":"The directed clique expansion (SimpleDirectedHypergraphs.jl’s ","type":"text"},{"code":"TwoSectionView","type":"codeVoice"},{"text":"): every","type":"text"},{"text":" ","type":"text"},{"text":"vertex, isolated ones included, in vertex-index order, and an arc ","type":"text"},{"code":"u → v","type":"codeVoice"},{"text":" when some","type":"text"},{"text":" ","type":"text"},{"text":"hyperedge has ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" among its sources and ","type":"text"},{"code":"v","type":"codeVoice"},{"text":" among its targets, ","type":"text"},{"code":"u ≠ v","type":"codeVoice"},{"text":", once per pair.","type":"text"},{"text":" ","type":"text"},{"text":"Arcs ascend by (index of u, index of v). A hyperedge with an empty side adds none.","type":"text"}],"title":"cliqueExpansion()","type":"topic","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/cliqueExpansion()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cliqueExpansion"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:19AdjacencyListModule0aB0V","text":"AdjacencyList"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa","text":"Vertex"},{"kind":"text","text":">"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableGraph":{"url":"\/documentation\/graphprotocols\/mutablegraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MutableGraph"}],"abstract":[{"type":"text","text":"An undirected graph that generic code can fill: the undirected counterpart of"},{"type":"text","text":" "},{"code":"MutableDirectedGraph","type":"codeVoice"},{"type":"text","text":" (Boost’s "},{"code":"MutableGraph","type":"codeVoice"},{"type":"text","text":" concept, "},{"code":"add_vertex","type":"codeVoice"},{"type":"text","text":" and "},{"code":"add_edge","type":"codeVoice"},{"type":"text","text":"), with the"},{"type":"text","text":" "},{"type":"text","text":"members a reader needs to build a graph by key."}],"title":"MutableGraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableGraph","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MutableGraph"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isFHypergraph":{"role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isfhypergraph","title":"isFHypergraph","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isFHypergraph","kind":"symbol","abstract":[{"text":"Whether every hyperedge has exactly one source: an F-graph (forward hypergraph). Vacuously","type":"text"},{"text":" ","type":"text"},{"text":"true with no hyperedges. O(m).","type":"text"}],"type":"topic"},"doc://GraphProtocols/documentation/GraphProtocols/Graph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Graph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Graph"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/graph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Graph"}],"type":"topic","title":"Graph","abstract":[{"type":"text","text":"An undirected graph: a finite set of vertices and a finite collection of undirected edges"},{"type":"text","text":" "},{"type":"text","text":"between them. Kept apart from "},{"type":"codeVoice","code":"DirectedGraph"},{"type":"text","text":": an undirected graph is not a symmetric directed"},{"type":"text","text":" "},{"type":"text","text":"one, and no type is both. "},{"type":"codeVoice","code":"directedView"},{"type":"text","text":" views it as one when an algorithm needs arcs."}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-MutableDirectedGraph-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-MutableDirectedGraph-Extensions","role":"collectionGroup","kind":"article","url":"\/documentation\/grafluent\/graphprotocols-mutabledirectedgraph-extensions","type":"topic","title":"Extensions to MutableDirectedGraph","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","type":"reference"},{"text":".","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/inDegreeHistogram()":{"role":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/indegreehistogram()","title":"inDegreeHistogram()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inDegreeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/inDegreeHistogram()","kind":"symbol","abstract":[{"text":"Element ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" counts the vertices with ","type":"text"},{"code":"d","type":"codeVoice"},{"text":" in-hyperedges; ","type":"text"},{"code":"[]","type":"codeVoice"},{"text":" with no vertices. O(n).","type":"text"}],"type":"topic"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/isBFHypergraph":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/isBFHypergraph","role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/isbfhypergraph","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isBFHypergraph","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"type":"topic","title":"isBFHypergraph","abstract":[{"type":"text","text":"Whether every hyperedge has exactly one target or exactly one source: a BF-graph. Vacuously"},{"type":"text","text":" "},{"type":"text","text":"true with no hyperedges. O(m)."}]},"doc://GraphProtocols/documentation/GraphProtocols/Hypergraph":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/Hypergraph","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Hypergraph"}],"kind":"symbol","url":"\/documentation\/graphprotocols\/hypergraph","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Hypergraph"}],"type":"topic","title":"Hypergraph","abstract":[{"text":"An undirected hypergraph: a finite set of vertices and a finite collection of hyperedges, each a","type":"text"},{"text":" ","type":"text"},{"text":"set of vertices of any size, the empty set included (Berge, ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Hypergraphs","type":"text"}]},{"text":", 1989). Not a ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and no shared parent with one: a hyperedge is not an edge. The ","type":"text"},{"type":"codeVoice","code":"Hypergraphs"},{"text":" module’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"incidenceGraphView"},{"text":" reads a hypergraph as its bipartite incidence graph (the Levi graph), which is","type":"text"},{"text":" ","type":"text"},{"text":"how the graph algorithms reach it.","type":"text"}]},"doc://GraphProtocols/documentation/GraphProtocols/MutableDirectedGraph":{"url":"\/documentation\/graphprotocols\/mutabledirectedgraph","role":"symbol","navigatorTitle":[{"text":"MutableDirectedGraph","kind":"identifier"}],"abstract":[{"text":"A bidirectional directed graph that generic code can mutate: Boost’s ","type":"text"},{"type":"codeVoice","code":"MutableGraph"},{"text":" concept","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"add_vertex"},{"text":", ","type":"text"},{"type":"codeVoice","code":"add_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_edge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"remove_vertex"},{"text":"), for a directed representation. It exists so that a wrapper which adds a rule, such as ","type":"text"},{"type":"codeVoice","code":"DirectedAcyclicGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"can own any of the mutable representations as its base and still run at the base’s speed.","type":"text"}],"title":"MutableDirectedGraph","type":"topic","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/MutableDirectedGraph","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MutableDirectedGraph","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true},{"type":"text","text":"."}],"title":"Extensions to DirectedGraph","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions","kind":"article"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/dual()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/dual()","role":"symbol","kind":"symbol","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/dual()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dual"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"IncidenceList","preciseIdentifier":"s:11Hypergraphs13IncidenceListV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Hyperedges","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP10HyperedgesQa"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Index","preciseIdentifier":"s:Sl5IndexQa"},{"kind":"text","text":">"}],"type":"topic","title":"dual()","abstract":[{"text":"The dual: the transpose of each plane (SimpleDirectedHypergraphs.jl’s convention, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"OrientedIncidenceMatrix.transposed()"},{"text":"). Its vertices are this hypergraph’s positions, in","type":"text"},{"text":" ","type":"text"},{"text":"order, and its hyperedge ","type":"text"},{"type":"codeVoice","code":"i"},{"text":" has sources ","type":"text"},{"type":"codeVoice","code":"outHyperedges(ofIndex: i)"},{"text":" and targets","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"inHyperedges(ofIndex: i)"},{"text":". An isolated vertex becomes the empty hyperedge ","type":"text"},{"type":"codeVoice","code":"{} → {}"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"back.","type":"text"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/bConnectedVertices(from:)":{"url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","kind":"symbol","title":"bConnectedVertices(from:)","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)","role"