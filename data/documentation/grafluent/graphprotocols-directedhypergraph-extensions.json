ergraphs and applications”, "},{"inlineContent":[{"type":"text","text":"Discrete Applied Mathematics"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"text","text":"42(2–3):177–201, 1993, define a hyperarc as “an ordered pair … of (possibly empty) disjoint"},{"type":"text","text":" "},{"type":"text","text":"subsets”; here either side may be empty and a vertex may be on both, the hypergraph form of a"},{"type":"text","text":" "},{"type":"text","text":"self-loop (XGI’s "},{"type":"codeVoice","code":"DiHypergraph"},{"text":" allows both).","type":"text"}],"navigatorTitle":[{"text":"DirectedHypergraph","kind":"identifier"}],"title":"DirectedHypergraph","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedHypergraph"},"doc://Grafluent/documentation/Grafluent/GraphProtocols-DirectedGraph-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/graphprotocols-directedgraph-extensions","type":"topic","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedGraph","isActive":true},{"type":"text","text":"."}],"title":"Extensions to DirectedGraph","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/GraphProtocols-DirectedGraph-Extensions"},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/targetSizeHistogram()":{"identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/targetSizeHistogram()","type":"topic","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/targetsizehistogram()","kind":"symbol","abstract":[{"type":"text","text":"Element "},{"type":"codeVoice","code":"k"},{"type":"text","text":" counts the hyperedges with "},{"type":"codeVoice","code":"k"},{"type":"text","text":" targets (XGI’s "},{"type":"codeVoice","code":"head_size"},{"type":"text","text":"); "},{"type":"codeVoice","code":"[]"},{"type":"text","text":" with no"},{"type":"text","text":" "},{"type":"text","text":"hyperedges. O(m)."}],"title":"targetSizeHistogram()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"targetSizeHistogram"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"]"}]},"doc://Hypergraphs/documentation/Hypergraphs/GraphProtocols/DirectedHypergraph/bConnectedVertices(from:)":{"type":"topic","title":"bConnectedVertices(from:)","abstract":[{"type":"text","text":"Every vertex B-connected to "},{"code":"source","type":"codeVoice"},{"type":"text","text":", "},{"code":"source","type":"codeVoice"},{"type":"text","text":" included, in vertex-index order: Gallo et"},{"type":"text","text":" "},{"type":"text","text":"al.‘s B-Visit (halp’s "},{"code":"b_visit","type":"codeVoice"},{"type":"text","text":"). A hyperedge fires once every one of its sources has been"},{"type":"text","text":" "},{"type":"text","text":"reached, and then reaches all its targets. On a directed graph read as a hypergraph this is"},{"type":"text","text":" "},{"type":"text","text":"reachability."}],"kind":"symbol","identifier":"doc:\/\/Hypergraphs\/documentation\/Hypergraphs\/GraphProtocols\/DirectedHypergraph\/bConnectedVertices(from:)","url":"\/documentation\/hypergraphs\/graphprotocols\/directedhypergraph\/bconnectedvertices(from:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bConnectedVertices"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIdentifier":"s:14GraphProtocols18DirectedHypergraphP6VertexQa"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Vertex","preciseIde