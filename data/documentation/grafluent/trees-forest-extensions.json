 "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","url":"\/documentation\/trees\/rootedtree","role":"symbol","title":"RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"role":"collectionGroup","title":"Extensions to Tree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","kind":"article","url":"\/documentation\/grafluent\/trees-tree-extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","role":"collectionGroup","title":"Extensions Across Modules","url":"\/documentation\/grafluent\/extensions","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","kind":"article"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/documentation\/trees\/arborescence","role":"symbol","title":"Arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"url":"\/documentation\/grafluent\/trees-arborescence-extensions","kind":"article","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","title":"Extensions to Arborescence","role":"collectionGroup"},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)","url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)","title":"init(_:in:)","role":"symbol","abstract":[{"text":"The spanning forest as a ","type":"text"},{"code":"Forest","type":"codeVoice"},{"text":" of the graph it came from.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-OrderedTree-Extensions":{"url":"\/documentation\/grafluent\/trees-orderedtree-extensions","kind":"article","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-OrderedTree-Extensions","title":"Extensions to OrderedTree","role":"collectionGroup"},"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"type":"codeVoice","code":"trees"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"component(of:)"},{"type":"text","text":" says which one a vertex is in."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","title":"Forest","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"ShortestPathTree","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"role":"symbol","title":"init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","kind":"symbol","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"type":"topic"},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","url":"\/documentation\/trees\/tree","role":"symbol","title":"Tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"url":"\/documentation\/trees\/orderedtree","kind":"symbol","type":"topic","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"url":"\/documentation\/grafluent\/trees-rootedtree-extensions","kind":"article","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","title":"Extensions to RootedTree","role":"collectionGroup"}}}