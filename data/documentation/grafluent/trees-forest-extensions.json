)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","role":"collectionGroup","kind":"article","url":"\/documentation\/grafluent\/extensions","type":"topic","title":"Extensions Across Modules","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}]},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","kind":"symbol","title":"Grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","role":"collection","type":"topic","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}]},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","role":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/trees\/tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"type":"topic","title":"Tree","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"type":"codeVoice","code":"Tree"},{"text":" cannot be mutated.","type":"text"}]},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","kind":"symbol","title":"init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}],"type":"topic","abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"code":"Arborescence(_:)","type":"codeVoice"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"type":"text","text":". The tree holds a copy of its graph, so none is passed, unlike"},{"type":"text","text":" "},{"code":"Forest(_:in:)","type":"codeVoice"},{"type":"text","text":" for a spanning forest. O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<k","type":"codeVoice"},{"type":"text","text":" in order."}]},"doc://Trees/documentation/Trees/Arborescence":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"kind":"symbol","url":"\/documentation\/trees\/arborescence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}],"type":"topic","title":"Arborescence","abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent (NetworkX ","type":"text"},{"code":"is_arborescence","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"Edmonds). A ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":": ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the parent (zero or one), and each edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"url":"\/documentation\/grafluent\/trees-tree-extensions","kind":"article","title":"Extensions to Tree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","role":"collectionGroup","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference"},{"text":".","type":"text"}]},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"url":"\/documentation\/grafluent\/trees-arborescence-extensions","kind":"article","title":"Extensions to Arborescence","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","role":"collectionGroup","type":"topic","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference"},{"text":".","type":"text"}]},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)","kind":"symbol","title":"init(_:in:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"The spanning forest as a "},{"type":"codeVoice","code":"Forest"},{"type":"text","text":" of the graph it came from: every vertex of "},{"type":"codeVoice","code":"graph"},{"type":"text","text":", in"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order (an isolated vertex is a one-vertex tree), and the forest’s edges, in"},{"type":"text","text":" "},{"type":"codeVoice","code":"forest.edges"},{"type":"text","text":" order, each as "},{"type":"codeVoice","code":"graph.edges"},{"type":"text","text":" holds it. The edge at position k is"},{"type":"text","text":" "},{"type":"codeVoice","code":"graph.edges[forest.edges[k]]"},{"type":"text","text":". SpanningForest keeps no copy of the graph, so it is passed"},{"type":"text","text":" "},{"type":"text","text":"here; NetworkX’s "},{"type":"codeVoice","code":"minimum_spanning_tree"},{"type":"text","text":" returns this graph directly. O(n) expected: each"},{"type":"text","text":" "},{"type":"text","text":"vertex and each edge end is hashed once, unless the vertices are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<n"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"order, when nothing is."}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","title":"Extensions to RootedTree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","kind":"article","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"type":"text","text":"."}],"type":"topic"},"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"code":"trees","type":"codeVoice"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":" says which one a vertex is in."}],"title":"Forest","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}]}}}