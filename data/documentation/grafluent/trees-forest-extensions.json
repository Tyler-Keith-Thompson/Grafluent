nt(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","title":"Extensions Across Modules","url":"\/documentation\/grafluent\/extensions","role":"collectionGroup"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","type":"topic","url":"\/documentation\/grafluent\/trees-arborescence-extensions","title":"Extensions to Arborescence","kind":"article"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","url":"\/