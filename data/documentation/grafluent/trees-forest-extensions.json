{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions"},"kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},{"text":".","type":"text"}],"sections":[],"metadata":{"title":"Extensions to Forest","role":"collectionGroup","modules":[{"name":"Grafluent"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"anchor":"ShortestPaths","title":"ShortestPaths","identifiers":["doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)"]},{"anchor":"SpanningTrees","title":"SpanningTrees","identifiers":["doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)"]}],"seeAlsoSections":[{"anchor":"Trees","title":"Trees","generated":true,"identifiers":["doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-OrderedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/grafluent\/trees-forest-extensions"]}],"hierarchy":{"paths":[["doc:\/\/Grafluent\/documentation\/Grafluent","doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions"]]},"references":{"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"kind":"symbol","abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"title":"init(_:)","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","role":"symbol","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","text":"ShortestPathTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}]},"doc://Grafluent/documentation/Grafluent":{"abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"kind":"symbol","title":"Grafluent","url":"\/documentation\/grafluent","role":"collection","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"doc://Trees/documentation/Trees/Tree":{"abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked inpu