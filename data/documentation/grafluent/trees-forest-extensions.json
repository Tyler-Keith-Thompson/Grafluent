dge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". The tree holds a copy of its graph, so none is passed, unlike"},{"type":"text","text":" "},{"type":"codeVoice","code":"Forest(_:in:)"},{"type":"text","text":" for a spanning forest. O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}]},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"preciseIdentifier":"s:13SpanningTrees0A6ForestV","kind":"typeIdentifier","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":")"}],"title":"init(_:in:)","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)","url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)","abstract":[{"type":"text","text":"The spanning forest as a "},{"code":"Forest","type":"codeVoice"},{"type":"text","text":" of the graph it came from: every vertex of "},{"code":"graph","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (an isolated vertex is a one-vertex tree), and the forest’s edges, in"},{"type":"text","text":" "},{"code":"forest.edges","type":"codeVoice"},{"type":"text","text":" order, each as "},{"code":"graph.edges","type":"codeVoice"},{"type":"text","text":" holds it. The edge at position k is"},{"type":"text","text":" "},{"code":"graph.edges[forest.edges[k]]","type":"codeVoice"},{"type":"text","text":". SpanningForest keeps no copy of the graph, so it is passed"},{"type":"text","text":" "},{"type":"text","text":"here; NetworkX’s "},{"code":"minimum_spanning_tree","type":"codeVoice"},{"type":"text","text":" returns this graph directly. O(n) expected: each"},{"type":"text","text":" "},{"type":"text","text":"vertex and each edge end is hashed once, unless the vertices are the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"order, when nothing is."}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","kind":"article","type":"topic","abstract":[{"type":"text","text":"Members other modules add to "},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"reference"},{"type":"text","text":"."}],"role":"collectionGroup","title":"Extensions to RootedTree"},"doc://Trees/documentation/Trees/Arborescence":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","cod