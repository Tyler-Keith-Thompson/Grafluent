ract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"type":"topic","title":"init(_:)","role":"symbol","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)"},"doc://Grafluent/documentation/Grafluent":{"abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"role":"collection","kind":"symbol","type":"topic","title":"Grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent"},"doc://Trees/documentation/Trees/OrderedTree":{"type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","url":"\/documentation\/trees\/orderedtree","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"abstract":[{"text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a","type":"text"},{"text":" ","type":"text"},{"text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they","typ