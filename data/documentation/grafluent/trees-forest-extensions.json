peIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}]},"doc://Grafluent/documentation/Grafluent":{"title":"Grafluent","type":"topic","role":"collection","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent","kind":"symbol","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}]},"doc://Trees/documentation/Trees/RootedTree":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","kind":"symbol","url":"\/documentation\/trees\/rootedtree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":