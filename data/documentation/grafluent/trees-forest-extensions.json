on/Trees/Tree":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","kind":"symbol","title":"Tree","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"type":"codeVoice","code":"Tree"},{"type":"text","text":" cannot be mutated."}],"role":"symbol","url":"\/documentation\/trees\/tree"},"doc://Grafluent/documentation/Grafluent/Trees-OrderedTree-Extensions":{"role":"collectionGroup","type":"topic","url":"\/documentation\/grafluent\/trees-orderedtree-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","isActive":true},{"type":"text","text":"."}],"title":"Extensions to OrderedTree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-OrderedTree-Extensions","kind":"article"},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":")"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)","title":"init(_:in:)","abstract":[{"text":"The spanning forest as a ","type":"text"},{"code":"Forest","type":"codeVoice"},{"text":" of the graph it came from.","type":"text"}],"role":"symbol","url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"role":"collectionGroup","type":"topic","url":"\/documentation\/grafluent\/trees-tree-extensions","title":"Extensions to Tree","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","kind":"article"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"type":"topic","kind":"article","title":"Extensions to RootedTree","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","isActive":true},{"type":"text","text":"."}],"role":"collectionGroup","url":"\/documentation\/grafluent\/trees-rootedtree-extensions"},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","type":"topic","url":"\/documentation\/trees\/rootedtree","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"title":"RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Extensions":{"role":"collectionGroup","url":"\/documentation\/grafluent\/extensions","type":"topic","title":"Extensions Across Modules","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","kind":"article"},"doc://Trees/documentation/Trees/Forest":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","title":"Forest","abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"role":"symbol","url":"\/documentation\/trees\/forest"},"doc://Grafluent/documentation/Grafluent":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","title":"Grafluent","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"url":"\/documentation\/grafluent","role":"collection","kind":"symbol"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"role":"symbol","type":"topic","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"title":"init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}],"kind":"symbol"},"doc://Trees/documentation/Trees/OrderedTree":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"role":"symbol","url":"\/documentation\/trees\/orderedtree"},"doc://Trees/documentation/Trees/Arborescence":{"role":"symbol","type":"topic","url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","title":"Arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"kind":"symbol"}}}