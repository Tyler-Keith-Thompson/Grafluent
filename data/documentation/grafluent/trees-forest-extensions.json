],"abstract":[{"text":"The shortest-path forest of a search from any number of sources, with the edges’","type":"text"},{"text":" ","type":"text"},{"text":"directions and the roots dropped: every reached vertex, in the tree’s index order as","type":"text"},{"text":" ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":" lists them (unreached ones left out), and one edge (parent, child) per","type":"text"},{"text":" ","type":"text"},{"text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k","type":"text"},{"text":" ","type":"text"},{"text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays","type":"text"},{"text":" ","type":"text"},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"text":". The tree holds a copy of its graph, so none is passed, unlike","type":"text"},{"text":" ","type":"text"},{"code":"Forest(_:in:)","type":"codeVoice"},{"text":" for a spanning forest. O(n); the vertices are hashed once, into the","type":"text"},{"text":" ","type":"text"},{"text":"forest’s lookup table, unless they are the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<k","type":"codeVoice"},{"text":" in order.","type":"text"}],"kind":"symbol","role":"symbol","title":"init(_:)","type":"topic","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)"},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"kind":"symbol","role":"collection","title":"Grafluent","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"kind":"article","role":"collectionGroup","title":"Extensions to Tree","type":"topic","url":"\/documentation\/grafluent\/trees-tree-extensions"},"doc://Trees/documentation/Trees/Tree":{"url":"\/documentation\/trees\/tree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}],"abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"role":"symbol","title":"Tree","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence"},{"type":"text","text":"."}],"kind":"article","role":"collectionGroup","title":"Extensions to Arborescence","type":"topic","url":"\/documentation\/grafluent\/trees-arborescence-extensions"},"doc://Trees/documentation/Trees/RootedTree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"code":"Graph","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"root","type":"codeVoice"},{"text":", ","type":"text"},{"code":"parent(of:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"depth(of:)","type":"codeVoice"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"code":"children(of:)","type":"codeVoice"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"code":"preorder","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"role":"symbol","title":"RootedTree","type":"topic","url":"\/documentation\/trees\/rootedtree"},"doc://Grafluent/documentation/Grafluent/Extensions":{"kind":"article","title":"Extensions Across Modules","type":"topic","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","role":"collectionGroup","url":"\/documentation\/grafluent\/extensions"},"doc://Trees/documentation/Trees/Arborescence":{"title":"Arborescence","kind":"symbol","url":"\/documentation\/trees\/arborescence","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent (NetworkX "},{"type":"codeVoice","code":"is_arborescence"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"Edmonds). A "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":": "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" "},{"type":"text","text":"the parent (zero or one), and each edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","type":"reference"},{"text":".","type":"text"}],"kind":"article","role":"collectionGroup","title":"Extensions to RootedTree","type":"topic","url":"\/documentation\/grafluent\/trees-rootedtree-extensions"},"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"role":"symbol","title":"Forest","type":"topic","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"SpanningForest","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"The spanning forest as a "},{"code":"Forest","type":"codeVoice"},{"type":"text","text":" of the graph it came from: every vertex of "},{"code":"graph","type":"codeVoice"},{"type":"text","text":", in"},{"type":"text","text":" "},{"code":"vertices","type":"codeVoice"},{"type":"text","text":" order (an isolated vertex is a one-vertex tree), and the forest’s edges, in"},{"type":"text","text":" "},{"code":"forest.edges","type":"codeVoice"},{"type":"text","text":" order, each as "},{"code":"graph.edges","type":"codeVoice"},{"type":"text","text":" holds it. The edge at position k is"},{"type":"text","text":" "},{"code":"graph.edges[forest.edges[k]]","type":"codeVoice"},{"type":"text","text":". SpanningForest keeps no copy of the graph, so it is passed"},{"type":"text","text":" "},{"type":"text","text":"here; NetworkX’s "},{"code":"minimum_spanning_tree","type":"codeVoice"},{"type":"text","text":" returns this graph directly. O(n) expected: each"},{"type":"text","text":" "},{"type":"text","text":"vertex and each edge end is hashed once, unless the vertices are the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<n","type":"codeVoice"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"order, when nothing is."}],"kind":"symbol","role":"symbol","title":"init(_:in:)","type":"topic","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)"}}}