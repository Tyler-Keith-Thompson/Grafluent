:\/\/Trees\/documentation\/Trees\/Forest","title":"Forest","url":"\/documentation\/trees\/forest","kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}]},"doc://Grafluent/documentation/Grafluent/Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","title":"Extensions Across Modules","url":"\/documentation\/grafluent\/extensions","kind":"article","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"The members each module adds to types declared in another module, by extended type."}]},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"code":"Arborescence(_:)","type":"codeVoice"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"code":"Int","type":"codeVoice"},{"type":"text","text":"s "},{"code":"0..<k","type":"codeVoice"},{"type":"text","text":" in order."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}],"identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","title":"init(_:)"},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"SpanningForest","kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"The spanning forest as a ","type":"text"},{"code":"Forest","type":"codeVoice"},{"text":" of the graph it came from.","type":"text"}],"identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)","url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)","title":"init(_:in:)","role":"symbol","kind