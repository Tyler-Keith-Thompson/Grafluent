ldren(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree"},"doc://Grafluent/documentation/Grafluent/Trees-OrderedTree-Extensions":{"url":"\/documentation\/grafluent\/trees-orderedtree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-OrderedTree-Extensions","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic","kind":"article","role":"collectionGroup","title":"Extensions to OrderedTree"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"title":"Extensions to Tree","url":"\/documentation\/grafluent\/trees-tree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","role":"collectionGroup","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic","kind":"article"},"doc://Trees/documentation/Trees/Arborescence":{"url":"\/documentation\/trees\/arborescence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"title":"Extensions to RootedTree","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"type":"text","text":"."}],"type":"topic","kind":"article"},"doc://Grafluent/documentation/Grafluent":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","url":"\/documentation\/grafluent","title":"Grafluent","role":"collection","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"kind":"symbol","type":"topic"},"doc://Grafluent/documentation/Grafluent/Extensions":{"url":"\/documentation\/grafluent\/extensions","title":"Extensions Across Modules","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","role":"collectionGroup","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"type":"topic","kind":"article"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"title":"Extensions to Arborescence","url":"\/documentation\/grafluent\/trees-arborescence-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","role":"collectionGroup","abstract":[{"type":"