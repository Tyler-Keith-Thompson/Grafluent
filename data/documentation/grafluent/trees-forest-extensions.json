{"text":"The shortest-path forest of a search from any number of sources, with the edges’","type":"text"},{"text":" ","type":"text"},{"text":"directions and the roots dropped: every reached vertex, in the tree’s index order as","type":"text"},{"text":" ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":" lists them (unreached ones left out), and one edge (parent, child) per","type":"text"},{"text":" ","type":"text"},{"text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k","type":"text"},{"text":" ","type":"text"},{"text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays","type":"text"},{"text":" ","type":"text"},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"text":". O(n); the vertices are hashed once, into the","type":"text"},{"text":" ","type":"text"},{"text":"forest’s lookup table, unless they are the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<k","type":"codeVoice"},{"text":" in order.","type":"text"}],"url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","role":"symbol","kind":"symbol","type":"topic","title":"init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"ShortestPathTree","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}]},"doc://Trees/documentation/Trees/OrderedTree":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}],"abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"role":"symbol","type":"topic","url":"\/documentation\/trees\/orderedtree","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree"},"doc://Trees/documentation/Trees/RootedTree":{"abstract":[{"text":"A tree with a root: an undirected ","type":"text"},{"type":"codeVoice","code":"Graph"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"root"},{"text":", ","type":"text"},{"type":"codeVoice","code":"parent(of:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"depth(of:)"},{"text":", and the queries tree algorithms start from. The vertices, edges and their","type":"text"},{"text":" ","type":"text"},{"text":"positions are the tree’s; the root orders ","type":"text"},{"type":"codeVoice","code":"children(of:)"},{"text":" (each vertex’s incident edges in","type":"text"},{"text":" ","type":"text"},{"text":"position order, without the edge to its parent) and so ","type":"text"},{"type":"codeVoice","code":"preorder"},{"text":".","type":"text"}],"url":"\/documentation\/trees\/rootedtree","role":"symbol","kind":"symbol","type":"topic","title":"RootedTree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"navigatorTitle":[{"text":"RootedTree","kind":"identifier"}]},"do