entifier","text":"Arborescence"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent. As a ","type":"text"},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"successors(of:)"},{"text":" are the children, ","type":"text"},{"type":"codeVoice","code":"predecessors(of:)"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"topic","url":"\/documentation\/trees\/arborescence"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","text":"ShortestPathTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"abstract":[{"text":"The shortest-path forest of a search from any number of sources, with the edges’","type":"text"},{"text":" ","type":"text"},{"text":"directions and the roots dropped: every reached vertex, in the tree’s index order as","type":"text"},{"text":" ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":" lists them (unreached ones left out), and one edge (parent, child) per","type":"text"},{"text":" ","type":"text"},{"text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k","type":"text"},{"text":" ","type":"text"},{"text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays","type":"text"},{"text":" ","type":"text"},{"code":"tree.parentEdge(of:)","type":"codeVoice"},{"text":". O(n); the vertices are hashed once, into the","type":"text"},{"text":" ","type":"text"},{"text":"forest’s lookup table, unless they are the ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":"s ","type":"text"},{"code":"0..<k","type":"codeVoice"},{"text":" in order.","type":"text"}],"type":"topic","url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","title":"init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","role":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"title":"Extensions to Arborescence","role":"collectionGroup","kind":"article","abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","type":"topic","url":"\/documentation\/grafluent\/trees-arborescence-extensions"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"title":"Extensions to Tree","role":"collectionGroup","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","type":"topic","url":"\/documentation\/grafluent\/trees-tree-extensions"},"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","type"