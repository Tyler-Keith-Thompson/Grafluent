umentation/Trees/Tree":{"url":"\/documentation\/trees\/tree","role":"symbol","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"topic","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"code":"Tree","type":"codeVoice"},{"text":" cannot be mutated.","type":"text"}],"title":"Tree","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}]},"doc://Grafluent/documentation/Grafluent/ExtensionsAcrossModules":{"url":"\/documentation\/grafluent\/extensionsacrossmodules","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/ExtensionsAcrossModules","type":"topic","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"title":"Extensions Across Modules"},"doc://SpanningTrees/documentation/SpanningTrees/Trees/Forest/init(_:in:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"W"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:13SpanningTrees0A6ForestV","text":"SpanningForest"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"W"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":")"}],"title":"init(_:in:)","type":"topic","abstract":[{"type":"text","text":"The spanning forest as a "},{"code":"Forest","type":"codeVoice"},{"type":"text","text":" of the graph it came from."}],"kind":"symbol","url":"\/documentation\/spanningtrees\/trees\/forest\/init(_:in:)","identifier":"doc:\/\/SpanningTrees\/documentation\/SpanningTrees\/Trees\/Forest\/init(_:in:)"},"doc://Trees/documentation/Trees/Arborescence":{"abstract":[{"text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex","type":"text"},{"text":" ","type":"text"},{"text":"but the root has exactly one incoming edge, from its parent. As a ","type":"text"},{"code":"BidirectionalDirectedGraph","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"successors(of:)","type":"codeVoice"},{"text":" are the children, ","type":"text"},{"code":"predecessors(of:)","type":"codeVoice"},{"text":" is the parent (zero or one), and each","type":"text"},{"text":" ","type":"text"},{"text":"edge is ","type":"text"},{"code":"DirectedEdge(from: parent, to: child)","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","type":"topic","title":"Arborescence","url":"\/documentation\/trees\/arborescence","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Arborescence"}]},"doc://Trees/documentation/Trees/OrderedTree":{"url":"\/documentation\/trees\/orderedtree","role":"symbol","kind":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}],"type":"topic","title":"OrderedTree","navigatorTitle":[{"kind":"identifier","text":"OrderedTree"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedTree"}]},"doc://Grafluent/documentation/Grafluent":{"role":"collection","title":"Grafluent","type":"topic","abstract":[{"text":"A generic, high-performance graph library for Swift.","type":"text"}],"kind":"symbol","url":"\/documentation\/grafluent","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"G","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Distance","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"ShortestPathTree","kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV"},{"text":"<","kind":"text"},{"text":"G","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Distance","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"abstract":[{"type":"text","text":"The shortest-path forest of a search from any number of sources, with the edges’"},{"type":"text","text":" "},{"type":"text","text":"directions and the roots dropped: every reached vertex, in the tree’s index order as"},{"type":"text","text":" "},{"type":"codeVoice","code":"Arborescence(_:)"},{"type":"text","text":" lists them (unreached ones left out), and one edge (parent, child) per"},{"type":"text","text":" "},{"type":"text","text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k"},{"type":"text","text":" "},{"type":"text","text":"joins the k-th listed vertex with a parent to its parent; the graph’s edge stays"},{"type":"text","text":" "},{"type":"codeVoice","code":"tree.parentEdge(of:)"},{"type":"text","text":". O(n); the vertices are hashed once, into the"},{"type":"text","text":" "},{"type":"text","text":"forest’s lookup table, unless they are the "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s "},{"type":"codeVoice","code":"0..<k"},{"type":"text","text":" in order."}],"role":"symbol","type":"topic","title":"init(_:)","kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","title":"Extensions to RootedTree","type":"topic","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","kind":"article"},"doc://Trees/documentation/Trees/Forest":{"abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"type":"codeVoice","code":"trees"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"component(of:)"},{"text":" says which one a vertex is in.","type":"text"}],"role":"symbol","title":"Forest","type":"topic","url":"\/documentation\/trees\/forest","navigatorTitle":[{"kind":"identifier","text":"Forest"}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Forest"}]},"doc://Trees/documentation/Trees/RootedTree":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RootedTree"}],"title":"RootedTree","type":"topic","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"code":"Graph","type":"codeVoice"},{"type":"text","text":" with "},{"code":"root","type":"codeVoice"},{"type":"text","text":", "},{"code":"parent(of:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"depth(of:)","type":"codeVoice"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"code":"children(of:)","type":"codeVoice"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"code":"preorder","type":"codeVoice"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"RootedTree"}],"kind":"symbol","url":"\/documentation\/trees\/rootedtree","identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","title":"Extensions to Arborescence","type":"topic","url":"\/documentation\/grafluent\/trees-arborescence-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","kind":"article"},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference"},{"text":".","type":"text"}],"role":"collectionGroup","title":"Extensions to Tree","type":"topic","url":"\/documentation\/grafluent\