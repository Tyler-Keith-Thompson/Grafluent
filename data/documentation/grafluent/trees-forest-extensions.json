ot has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","title":"Arborescence","navigatorTitle":[{"kind":"identifier","text":"Arborescence"}]},"doc://Grafluent/documentation/Grafluent/Trees-Tree-Extensions":{"url":"\/documentation\/grafluent\/trees-tree-extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","type":"topic","title":"Extensions to Tree","abstract":[{"type":"text","text":"Members other modules add to "},{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","type":"reference","isActive":true},{"type":"text","text":"."}],"kind":"article"},"doc://Grafluent/documentation/Grafluent":{"url":"\/documentation\/grafluent","role":"collection","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent","type":"topic","title":"Grafluent","abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"kind":"symbol"},"doc://Grafluent/documentation/Grafluent/Extensions":{"url":"\/documentation\/grafluent\/extensions","role":"collectionGroup","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","type":"topic","title":"Extensions Across Modules","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"kind":"article"},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","kind":"symbol","abstract":[{"text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly","type":"text"},{"text":" ","type":"text"},{"text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer","type":"text"},{"text":" ","type":"text"},{"text":"from unchecked input is failable, and a ","type":"text"},{"type":"codeVoice","code":"Tree"},{"text":" cannot be mutated.","type":"text"}],"type":"topic","url":"\/documentation\/trees\/tree","title":"Tree","navigatorTitle":[{"text":"Tree","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tree","kind":"identifier"}]},"doc://ShortestPaths/documentation/ShortestPaths/Trees/Forest/init(_:)":{"url":"\/documentation\/shortestpaths\/trees\/forest\/init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"G"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Distance"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:13ShortestPaths0A8PathTreeV","text":"ShortestPathTree"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"G"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Distance"},{"kind":"text","text":">)"}],"role":"symbol","identifier":"doc:\/\/ShortestPaths\/documentation\/ShortestPaths\/Trees\/Forest\/init(_:)","type":"topic","abstract":[{"text":"The shortest-path forest of a search from any number of sources, with the edges’","type":"text"},{"text":" ","type":"text"},{"text":"directions and the roots dropped: every reached vertex, in the tree’s index order as","type":"text"},{"text":" ","type":"text"},{"code":"Arborescence(_:)","type":"codeVoice"},{"text":" lists them (unreached ones left out), and one edge (parent, child) per","type":"text"},{"text":" ","type":"text"},{"text":"reached vertex with a parent, in that order. Edge positions are the forest’s own: edge k","type":"text"},{"text":" ","type":"text"},{"text":"joins the k-th listed v