iseIdentifier":"s:SG","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Pseudograph","preciseIdentifier":"s:11Multigraphs11PseudographV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/Pseudograph\/configurationModel(degreeSequence:using:)","url":"\/documentation\/randomgraphs\/multigraphs\/pseudograph\/configurationmodel(degreesequence:using:)","role":"symbol","abstract":[{"type":"text","text":"A random pseudograph with these degrees, by the configuration model: vertex i gets"},{"type":"text","text":" "},{"type":"codeVoice","code":"degreeSequence[i]"},{"type":"text","text":" stubs, the stubs are shuffled, and the k-th stub of the first half is"},{"type":"text","text":" "},{"type":"text","text":"paired with the k-th of the second half. Every pairing of the stubs is equally likely, so"},{"type":"text","text":" "},{"type":"text","text":"self-loops and parallel edges occur; a self-loop counts 2 toward its vertex’s degree, and"},{"type":"text","text":" "},{"type":"text","text":"every vertex has exactly its degree. The edges are at positions "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" in pairing order,"},{"type":"text","text":" "},{"type":"text","text":"each written (first-half end, second-half end). The shuffle is Fisher–Yates, i from the"},{"type":"text","text":" "},{"type":"text","text":"last stub down to 1 swapped with "},{"type":"codeVoice","code":"below(i + 1)"},{"type":"text","text":"."}]}}}