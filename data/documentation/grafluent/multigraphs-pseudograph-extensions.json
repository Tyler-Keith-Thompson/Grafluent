op counts 2 toward its vertex’s degree, and"},{"type":"text","text":" "},{"type":"text","text":"every vertex has exactly its degree. The edges are at positions "},{"type":"codeVoice","code":"0..<m"},{"type":"text","text":" in pairing order,"},{"type":"text","text":" "},{"type":"text","text":"each written (first-half end, second-half end). The shuffle is Fisher–Yates, i from the"},{"type":"text","text":" "},{"type":"text","text":"last stub down to 1 swapped with "},{"type":"codeVoice","code":"below(i + 1)"},{"type":"text","text":"."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"configurationModel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"degreeSequence","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Collection","kind":"typeIdentifier","preciseIdentifier":"s:Sl"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, ","kind":"text"},{"text":"using","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomNumberGenerator","kind":"typeIdentifier","preciseIdentifier":"s:SG"},{"text":") -> ","kind":"text"},{"text":"Pseudograph","kind":"typeIdentifier","preciseIdentifier":"s:11Multigraphs11PseudographV"},{"text":"<","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol"}}}