). The shuffle is Fisher–Yates, i from the","type":"text"},{"text":" ","type":"text"},{"text":"last stub down to 1 swapped with ","type":"text"},{"code":"below(i + 1)","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"configurationModel"},{"kind":"text","text":"("},{"kind":"externalParam","text":"degreeSequence"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Collection","preciseIdentifier":"s:Sl"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"using"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RandomNumberGenerator","preciseIdentifier":"s:SG"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Pseudograph","preciseIdentifier":"s:11Multigraphs11PseudographV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">"}],"identifier":"doc:\/\/RandomGraphs\/documentation\/RandomGraphs\/Multigraphs\/Pseudograph\/configurationModel(degreeSequence:using:)","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/randomgraphs\/multigraphs\/pseudograph\/configurationmodel(degreesequence:using:)","title":"configurationModel(degreeSequence:using:)"}}}