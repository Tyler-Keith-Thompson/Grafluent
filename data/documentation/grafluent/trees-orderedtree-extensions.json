act":[{"type":"text","text":"The tree edit distance to "},{"type":"codeVoice","code":"other"},{"type":"text","text":" at the given costs: the least total cost of deleting"},{"type":"text","text":" "},{"type":"text","text":"vertices of this tree, inserting vertices of "},{"type":"codeVoice","code":"other"},{"type":"text","text":" and substituting one for the other"},{"type":"text","text":" "},{"type":"text","text":"that turns this tree into "},{"type":"codeVoice","code":"other"},{"type":"text","text":". Deleting a vertex makes its children children of its"},{"type":"text","text":" "},{"type":"text","text":"parent, in its place in the order; inserting is the reverse. Equivalently, the least cost"},{"type":"text","text":" "},{"type":"text","text":"of a mapping between the trees that keeps ancestry and sibling order, with unmapped"},{"type":"text","text":" "},{"type":"text","text":"vertices deleted or inserted."}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Extensions":{"type":"topic","role":"collectionGroup","title":"Extensions Across Modules","url":"\/documentation\/grafluent\/extensions","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Extensions","kind":"article"}}}