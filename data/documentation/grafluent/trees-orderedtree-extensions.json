fluent/documentation/Grafluent/Trees-Tree-Extensions":{"kind":"article","role":"collectionGroup","title":"Extensions to Tree","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree"},{"type":"text","text":"."}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Tree-Extensions","url":"\/documentation\/grafluent\/trees-tree-extensions","type":"topic"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/OrderedTree/treeEditDistance(to:)":{"type":"topic","abstract":[{"type":"text","text":"The tree edit distance to "},{"type":"codeVoice","code":"other"},{"type":"text","text":" at unit costs: the fewest vertex deletions and"},{"type":"text","text":" "},{"type":"text","text":"insertions that turn this tree’s shape into "},{"type":"codeVoice","code":"other"},{"type":"text","text":"’s, substitution being free. Zero"},{"type":"text","text":" "},{"type":"text","text":"exactly when the two have the same shape as ordered trees."}],"title":"treeEditDistance(to:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/OrderedTree\/treeEditDistance(to:)","url":"\/documentation\/treealgorithms\/trees\/orderedtree\/treeeditdistance(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treeEditDistance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Other","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Trees11OrderedTreeV","text":"OrderedTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/OrderedTree/treeEditDistance(to:substitutionCost:deletionCost:insertionCost:)":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/OrderedTree\/treeEditDistance(to:substitutionCost:deletionCost:insertionCost:)","title":"treeEditDistance(to:substitutionCost:deletionCost:insertionCost:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treeEditDistance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Other","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Cost","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:5Trees11OrderedTreeV","text":"OrderedTree","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"substitutionCost","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"deletionCost","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"insertionCost","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Other","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Cost","kind":"typeIdentifier"}],"url":"\/documentation\/treealgorithms\/trees\/orderedtree\/treeeditdistance(to:substitutioncost:deletioncost:insertioncost:)","abstract":[{"type":"text","text":"The tree edit distance to "},{"type":"codeVoice","code":"other"},{"type":"text","text":" at the given costs: the least total cost of deleting"},{"type":"text","text":" "},{"type":"text","text":"vertices of this tree, inserting vertices of "},{"type":"codeVoice","code":"other"},{"type":"text","text":" and substituting one for the other"},{"type":"text","text":" "},{"type":"text","text":"that turns this tree into "},{"type":"codeVoice","code":"other"},{"type":"text","text":". Deleting a vertex makes its children children of its"},{"type":"text","text":" "},{"type":"text","text":"parent, in its place in the order; inserting is the reverse. Equivalently, the least cost"},{"type":"text","text":" "},{"type":"text","text":"of a mapping between the trees that keeps ancestry and sibling order, with unmapped"},{"type":"text","text":" "},{"type":"text","text":"vertices deleted or inserted."}],"type":"topic"},"doc://Trees/documentation/Trees/RootedTree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree","navigatorTitle":[{"text":"RootedTree","kind":"identifier"}],"title":"RootedTree","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootedTree","kind":"identifier"}],"url":"\/documentation\/trees\/rootedtree","type":"topic","abstract":[{"type":"text","text":"A tree with a root: an undirected "},{"type":"codeVoice","code":"Graph"},{"type":"text","text":" with "},{"type":"codeVoice","code":"root"},{"type":"text","text":", "},{"type":"codeVoice","code":"parent(of:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"depth(of:)"},{"type":"text","text":", and the queries tree algorithms start from. The vertices, edges and their"},{"type":"text","text":" "},{"type":"text","text":"positions are the tree’s; the root orders "},{"type":"codeVoice","code":"children(of:)"},{"type":"text","text":" (each vertex’s incident edges in"},{"type":"text","text":" "},{"type":"text","text":"position order, without the edge to its parent) and so "},{"type":"codeVoice","code":"preorder"},{"type":"text","text":"."}]},"doc://Trees/documentation/Trees/OrderedTree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","navigatorTitle":[{"text":"OrderedTree","kind":"identifier"}],"title":"OrderedTree","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}],"url":"\/documentation\/trees\/orderedtree","type":"topic","abstract":[{"type":"text","text":"An ordered tree (plane tree): a rooted tree in which the children of each vertex form a"},{"type":"text","text":" "},{"type":"text","text":"sequence, first to last. The order is part of the value: two ordered trees are equal when they"},{"type":"text","text":" "},{"type":"text","text":"have the same root and every vertex has the same children in the same order, which is the"},{"type":"text","text":" "},{"type":"text","text":"identity being an ordered-tree isomorphism between them."}]},"doc://Grafluent/documentation/Grafluent/Trees-RootedTree-Extensions":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-RootedTree-Extensions","title":"Extensions to RootedTree","kind":"article","role":"collectionGroup","url":"\/documentation\/grafluent\/trees-rootedtree-extensions","abstract":[{"type":"text","text":"Members other modules add to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/RootedTree"},{"type":"text","text":"."}],"type":"topic"},"doc://Grafluent/documentation/Grafluent/Trees-Arborescence-Extensions":{"kind":"article","role":"collectionGroup","title":"Extensions to Arborescence","abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Arborescence-Extensions","url":"\/documentation\/grafluent\/trees-arborescence-extensions","type":"topic"},"doc://Trees/documentation/Trees/Tree":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Tree","navigatorTitle":[{"kind":"identifier","text":"Tree"}],"title":"Tree","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tree"}],"url":"\/documentation\/trees\/tree","abstract":[{"type":"text","text":"A tree: a connected, acyclic undirected graph with at least one vertex, so it has exactly"},{"type":"text","text":" "},{"type":"text","text":"n − 1 edges, no self-loop and no parallel edges. The invariant is the type: every initializer"},{"type":"text","text":" "},{"type":"text","text":"from unchecked input is failable, and a "},{"code":"Tree","type":"codeVoice"},{"type":"text","text":" cannot be mutated."}],"type":"topic"},"doc://Grafluent/documentation/Grafluent":{"abstract":[{"type":"text","text":"A generic, high-performance graph library for Swift."}],"title":"Grafluent","kind":"symbol","url":"\/documentation\/grafluent","role":"collection","type":"topic","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent"},"doc://Trees/documentation/Trees/Forest":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Forest","kind":"identifier"}],"title":"Forest","abstract":[{"type":"text","text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an"},{"type":"text","text":" "},{"type":"text","text":"isolated vertex is a one-vertex tree). "},{"code":"trees","type":"codeVoice"},{"type":"text","text":" lists them by least vertex, and"},{"type":"text","text":" "},{"code":"component(of:)","type":"codeVoice"},{"type":"text","text":" says which one a vertex is in."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","url":"\/documentation\/trees\/forest","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}]},"doc://Trees/documentation/Trees/Arborescence":{"identifier":"doc:\/\/Trees\/documentation\/Trees\/Arborescence","navigatorTitle":[{"text":"Arborescence","kind":"identifier"}],"title":"Arborescence","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Arborescence","kind":"identifier"}],"url":"\/documentation\/trees\/arborescence","type":"topic","abstract":[{"type":"text","text":"An arborescence: a directed tree whose edges all point away from its root, so every vertex"},{"type":"text","text":" "},{"type":"text","text":"but the root has exactly one incoming edge, from its parent. As a "},{"type":"codeVoice","code":"BidirectionalDirectedGraph"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"successors(of:)"},{"type":"text","text":" are the children, "},{"type":"codeVoice","code":"predecessors(of:)"},{"type":"text","text":" is the parent (zero or one), and each"},{"type":"text","text":" "},{"type":"text","text":"edge is "},{"type":"codeVoice","code":"DirectedEdge(from: parent, to: child)"},{"type":"text","text":"."}]},"doc://Grafluent/documentation/Grafluent/ExtensionsAcrossModules":{"identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/ExtensionsAcrossModules","title":"Extensions Across Modules","kind":"article","role":"collectionGroup","type":"topic","abstract":[{"text":"The members each module adds to types declared in another module, by extended type.","type":"text"}],"url":"\/documentation\/grafluent\/extensionsacrossmodules"}}}