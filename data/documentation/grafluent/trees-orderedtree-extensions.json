e for the other"},{"type":"text","text":" "},{"type":"text","text":"that turns this tree into "},{"type":"codeVoice","code":"other"},{"type":"text","text":". Deleting a vertex makes its children children of its"},{"type":"text","text":" "},{"type":"text","text":"parent, in its place in the order; inserting is the reverse. Equivalently, the least cost"},{"type":"text","text":" "},{"type":"text","text":"of a mapping between the trees that keeps ancestry and sibling order, with unmapped"},{"type":"text","text":" "},{"type":"text","text":"vertices deleted or inserted."}],"role":"symbol","title":"treeEditDistance(to:substitutionCost:deletionCost:insertionCost:)","type":"topic","url":"\/documentation\/treealgorithms\/trees\/orderedtree\/treeeditdistance(to:substitutioncost:deletioncost:insertioncost:)","kind":"symbol","identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/OrderedTree\/treeEditDistance(to:substitutionCost:deletionCost:insertionCost:)"},"doc://Trees/documentation/Trees/Forest":{"url":"\/documentation\/trees\/forest","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Forest","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest","kind":"symbol","type":"topic","title":"Forest","abstract":[{"text":"A forest: an acyclic undirected graph, possibly empty, so a disjoint union of trees (an","type":"text"},{"text":" ","type":"text"},{"text":"isolated vertex is a one-vertex tree). ","type":"text"},{"code":"trees","type":"codeVoice"},{"text":" lists them by least vertex, and","type":"text"},{"text":" ","type":"text"},{"code":"component(of:)","type":"codeVoice"},{"text":" says which one a vertex is in.","type":"text"}],"navigatorTitle":[{"text":"Forest","kind":"identifier"}]},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/OrderedTree/treeEditDistance(to:)":{"url":"\/documentation\/treealgorithms\/trees\/orderedtree\/treeeditdistance(to:)","fragments":[{"text":"func