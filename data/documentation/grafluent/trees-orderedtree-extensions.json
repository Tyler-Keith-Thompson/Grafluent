ty being an ordered-tree isomorphism between them."}],"identifier":"doc:\/\/Trees\/documentation\/Trees\/OrderedTree","title":"OrderedTree","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedTree","kind":"identifier"}]},"doc://Grafluent/documentation/Grafluent/Trees-Forest-Extensions":{"abstract":[{"text":"Members other modules add to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Trees\/documentation\/Trees\/Forest"},{"text":".","type":"text"}],"url":"\/documentation\/grafluent\/trees-forest-extensions","identifier":"doc:\/\/Grafluent\/documentation\/Grafluent\/Trees-Forest-Extensions","role":"collectionGroup","title":"Extensions to Forest","type":"topic","kind":"article"},"doc://TreeAlgorithms/documentation/TreeAlgorithms/Trees/OrderedTree/treeEditDistance(to:)":{"identifier":"doc:\/\/TreeAlgorithms\/documentation\/TreeAlgorithms\/Trees\/OrderedTree\/treeEditDistance(to:)","url":"\/documentation\/treealgorithms\/trees\/orderedtree\/treeeditdistance(to:)","title":"treeEditDistance(to:)","role":"symbol","abstract":[{"type":"text","text":"The tree edit distance to "},{"type":"codeVoice","code":"other"},{"type":"text","text":" at unit costs: the fewest vertex deletions and"},{"type":"text","text":" "},{"type":"text","text":"insertions that turn this tree’s shape into "},{"type":"codeVoice","code":"other"},{"type":"text","text":"’s, substitution being free. Zero"},{"type":"text","text":" "},{"type":"text","text":"exactly when the two have the same shape as ordered trees."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"treeEditDistance","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Other","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"OrderedTree","kind":"typeIdentifier","preciseIdentifier":"s:5Trees11OrderedTreeV"},{"text":"<","kind":"text"},{"text":"Other","