{"abstract":[{"type":"text","text":"Inserts "},{"type":"codeVoice","code":"edge"},{"type":"text","text":", unless it would close a cycle, inserting either endpoint that is not already"},{"type":"text","text":" "},{"type":"text","text":"a vertex, source first. A new source whose target is already a vertex is placed first in the"},{"type":"text","text":" "},{"type":"text","text":"order; any other new endpoint is placed last. So an edge with a new endpoint always goes"},{"type":"text","text":" "},{"type":"text","text":"forward and never reorders. A self-loop is rejected before anything is inserted."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph\/insert(edge:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DirectedEdge","kind":"typeIdentifier","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV","identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge"},{"text":"<","kind":"text"},{"text":"DirectedAcyclicGraph","kind":"typeIdentifier","preciseIdentifier":"s:26DirectedAcyclicGraphModule0abC0V","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"},{"text":"<","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Vertex","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"AcyclicEdgeError","kind":"typeIdentifier","preciseIdentifier":"s:26DirectedAcyclicGraphModule0B9EdgeErrorO","identifier":"doc:\/\/DirectedAcyclicGraphModule