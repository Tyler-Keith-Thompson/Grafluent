xt":"The edge’s position: a new one, or on "},{"type":"codeVoice","code":"AdjacencyList"},{"type":"text","text":", which is simple, the"},{"type":"text","text":" "},{"type":"text","text":"existing edge’s."}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"When the source is already placed before the target, the cost is two array reads plus the","type":"text"},{"text":" ","type":"text"},{"text":"base’s insertion. Otherwise Pearce and Kelly’s reordering runs, O(‖δ‖ + δ log δ) for the δ","type":"text"},{"text":" ","type":"text"},{"text":"vertices it visits between the endpoints’ places; see the type’s documentation. A rejection","type":"text"},{"text":" ","type":"text"},{"text":"allocates nothing once the reordering’s scratch has grown.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"AcyclicEdgeError.selfLoop","type":"codeVoice"},{"type":"text","text":" for a self-loop, and "},{"code":".cycle","type":"codeVoice"},{"type":"text","text":" when the edge would"},{"type":"text","text":" "},{"type":"text","text":"close a cycle; then nothing changes, and "},{"code":"bidirectionalShortestPath(from: edge.target, to: edge.source)","type":"codeVoice"},{"type":"text","text":" (Traversal) is a path the edge would close. "},{"code":"try?","type":"codeVoice"},{"type":"text","text":" turns a rejection"},{"type":"text","text":" "},{"type":"text","text":"into "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"Throws","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph\/insert(edge:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph\/insert(edge:)"},"metadata":{"external