 endpoint that is not already"},{"type":"text","text":" "},{"type":"text","text":"a vertex, source first. A new source whose target is already a vertex is placed first in the"},{"type":"text","text":" "},{"type":"text","text":"order; any other new endpoint is placed last. So an edge with a new endpoint always goes"},{"type":"text","text":" "},{"type":"text","text":"forward and never reorders. A self-loop is rejected before anything is inserted."}],"sections":[],"metadata":{"symbolKind":"method","extendedModule":"DirectedAcyclicGraphModule","role":"symbol","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Base"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"MutableDirectedGraph"},{"text":".","type":"text"}]},"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph+Mutation.swift#L35","fileName":"DirectedAcyclicGraph+Mutation.swift"},"title":"insert(edge:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"externalParam","text":"edge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"DirectedEdge","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"DirectedAcyclicGraph","preciseIdentifier":"s:26DirectedAcyclicGraphModule0abC0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"Vertex"},{"kind":"text","text":">) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"AcyclicEdgeError","preciseIdentifier":"s:26DirectedAcyclicGraphModule0B9EdgeErrorO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"DirectedAcyclicGraph","prec