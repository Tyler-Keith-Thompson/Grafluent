n the edge would"},{"type":"text","text":" "},{"type":"text","text":"close a cycle; then nothing changes, and "},{"type":"codeVoice","code":"bidirectionalShortestPath(from: edge.target, to: edge.source)"},{"type":"text","text":" (Traversal) is a path the edge would close. "},{"type":"codeVoice","code":"try?"},{"type":"text","text":" turns a rejection"},{"type":"text","text":" "},{"type":"text","text":"into "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"type":"aside","name":"Throws"}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph\/insert(edge:)"]}],"references":{"doc://DirectedAcyclicGraphModule/documentation/DirectedAcyclicGraphModule/DirectedAcyclicGraph":{"identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","type":"topic","title":"DirectedAcyclicGraph","abstract":[{"type":"text","text":"A directed graph with no directed cycle that keeps a topological order of its vertices as it"},{"type":"text","text":" "},{"type":"text","text":"changes."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DirectedAcyclicGraph","kind":"identifier"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"DirectedAcyclicGraph","kind":"identifier"}],"url":"\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph"},"doc://GraphProtocols/documentation/GraphProtocols/DirectedEdge":{"identifier":"doc:\/\/GraphProtocols\/documentation\/GraphProtocols\/DirectedEdge","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectedEdge"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectedEdge"}],"abstract":[{"text":"An edge of a directed graph: the ordered pair (source, target), directed from ","type":"text"},{"type":"codeVoice","code":"source"},{"text":" to ","type":"text"},{"type