":"text"},{"text":" ","type":"text"},{"text":"order; any other new endpoint is placed last. So an edge with a new endpoint always goes","type":"text"},{"text":" ","type":"text"},{"text":"forward and never reorders. A self-loop is rejected before anything is inserted.","type":"text"}],"variants":[{"paths":["\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph\/insert(edge:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule","doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph\/insert(edge:)","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph+Mutation.swift#L35","fileName":"DirectedAcyclicGraph+Mutation.swift"},"roleHeading":"Instance Method","modules":[{"name":"DirectedAcyclicGraphModule"}],"symbolKind":"method","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Base","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"MutableDirectedGraph","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"externalID":"s:26DirectedAcyclicGraphModule0abC0V6insert4edge5Edges_5IndexQZ0C9Protocols0A4EdgeVy6VertexQzG_tAA0bJ5ErrorOYKF","role":"symbol","extendedModule":"DirectedAcyclicGraphModule","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"edge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DirectedEdge","preciseIdentifier":"s:14GraphProtocols12DirectedEdgeV","kind":"typeIdentifier"},{"te