{"abstract":[{"text":"The transitive closure, not reflexive.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitiveClosure"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","text":"DirectedAcyclicGraph","preciseIdentifier":"s:26DirectedAcyclicGraphModule0abC0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A copy of the graph in which, for each vertex u in topological order, an edge u→w is"},{"type":"text","text":" "},{"type":"text","text":"appended for each vertex w reachable from u that is not already a successor, in topological"},{"type":"text","text":" "},{"type":"text","text":"order of w. Existing edges, parallel copies included, keep their positions, and the"},{"type":"text","text":" "},{"type":"text","text":"topological order is unchanged."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(n · m \/ 64 + n + output) time and n² \/ 8 bytes of scratch.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Grafluent\/blob\/main\/Sources\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph+Algorithms.swift#L78","fileName":"DirectedAcyclicGraph+Algorithms.swift"},"extendedModule":"DirectedAcyclicGraphModule","roleHeading":"Instance Method","conformance":{"constraints":[{"type":"codeVoice","code":"Base"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"MutableDirectedGraph"},{"type":"te