{"abstract":[{"type":"text","text":"The transitive reduction."}],"variants":[{"paths":["\/documentation\/directedacyclicgraphmodule\/directedacyclicgraph\/transitivereduction()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitiveReduction"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/DirectedAcyclicGraphModule\/documentation\/DirectedAcyclicGraphModule\/DirectedAcyclicGraph","preciseIdentifier":"s:26DirectedAcyclicGraphModule0abC0V","text":"DirectedAcyclicGraph"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The edge u→w is kept exactly when no path of two or more edges leads from u to w, and of"},{"type":"text","text":" "},{"type":"text","text":"parallel copies only the first in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order is kept. The result is a new graph with the"},{"type":"text","text":" "},{"type":"text","text":"vertices in "},{"type":"codeVoice","code":"vertices"},{"type":"text","text":" order, the kept edges in "},{"type":"codeVoice","code":"edges"},{"type":"text","text":" order at fresh positions (a"},{"type":"text","text":" "},{"type":"codeVoice","code":"StableDirectedGraph"},{"type":"text","text":" is compacted), and the same topological order."}],"type":"paragraph"},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(n · m \/ 64 + n + m) time and n² \/ 8 bytes of scratch."}]}],"type":"aside"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"DirectedAcyclicGraphModule"}],"externalID":"s:26Direct