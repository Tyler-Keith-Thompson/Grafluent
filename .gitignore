# Agent worktrees are checkouts of this same repo.
.claude/worktrees/

# Bazel
/bazel-*
/user.bazelrc
# Remote cache diagnostics (user.bazelrc writes them).
/bazel-remote-grpc.log
/execution_log.binpb.zst
.cache/

# SwiftPM
.build/
.swiftpm/
# The root package is a library, so its resolution is not committed; swift/Package.resolved
# pins Bazel's dependencies and is.
/Package.resolved

# DocC: the umbrella's extension index, written by scripts/extensions.py at doc-build time.
/Sources/Grafluent/Grafluent.docc/Extensions/

# Xcode (generated from the Bazel graph by `just generate`)
/Grafluent.xcodeproj/
xcuserdata/

# macOS
.DS_Store

# Fuzzing (see Fuzz/README.md): the corpus is a local cache; a crash becomes a test, then goes.
/Fuzz/Corpus/
/Fuzz/Crashes/
/Differential/Failures/

# Python
__pycache__/
